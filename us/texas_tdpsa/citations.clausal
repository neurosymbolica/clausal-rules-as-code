citation(us_tx_bc_541_002_a_3, [label-'Tex. Bus. & Com. Code Sec. 541.002(a)(3) (is [quotation omitted]; Sec. 541.107 exception not formalised)', ref-'Tex. Bus. & Com. Code ch. 541, document tx-bc-ch541-2026-11-16-pdf-save#s541_002_a_3']).

