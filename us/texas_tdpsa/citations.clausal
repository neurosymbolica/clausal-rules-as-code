% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for us/texas_tdpsa.
%
% Instrument: Tex. Bus. & Com. Code ch. 541 (Texas Data Privacy and
% Security Act). Pinned text: document
% tx-bc-ch541-2026-11-16-pdf-save, the current chapter saved to PDF
% from the Texas statutes website on 2026-11-16 and extracted as text (a
% secondary copy, not the official printed code; no 'current through'
% line was read). Every section quoted here was [quotation omitted]
% [quotation omitted].
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys label and ref only:
%   citation(Key, [label-'...', ref-'...']).
% Records carry a label and a link; quotations of the statute are omitted,
% see the linked Texas Statutes (Texas Legislature Online) page for the text.
%
% Keys are the canonical lexicon keys (_lexicon/citations.yaml). The key
% sba_small_business_size_determination is the TARGET of the
% cross_reference_unresolved referral for the outside fact
% small_business_as_defined_by_sba: it is recorded so the cite(...) term
% resolves, and it is never computed or applied here.
%
% PROVENANCE: every operative clause opens its body with implements(Key),
% Key one recorded below.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

% implements(Key): the provenance marker. It succeeds for every recorded key
% and fails for a key not recorded here.
implements(Key) :-
    citation(Key, _).

% ---- Sec. 541.002(a): the persons to whom the chapter applies ------------
citation(us_tx_bc_541_002_a, [label-'Tex. Bus. & Com. Code Sec. 541.002(a) (applicability: the chapter applies only to a person meeting (1) to (3))', ref-'Tex. Bus. & Com. Code ch. 541, document tx-bc-ch541-2026-11-16-pdf-save#s541_002_a']).

