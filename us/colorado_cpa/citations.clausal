% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for us/colorado_cpa.
%
% Pinned texts:
%   - [quotation omitted] to 6-1-1315, browser save
%     of the Colorado Legal Resources (Lexis Advance) section pages made on
%     2026-11-16 (a SECONDARY copy, not the official printed C.R.S.;
%     document co-crs-6-1-1301-1315-2026-11-16-save, sha256
%     ff763b24e90b7cf2149bc10953dda706b1c45efbdb27b844bf7041752f65a8c3);
%   - the [quotation omitted] version 12259, in
%     force from 2025-12-01 (document co-ccr-904-3-v12259, sha256
%     58a420766c48437ba48debf17156e146392e5af5e7daa3398fec39f9808b3ce5).
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys label and ref only:
%   citation(Key, [label-'...', ref-'...']).
% Records carry a label and a link; quotations of the statute are omitted,
% see the linked Colorado Secretary of State (Colorado Revised Statutes) page for the text.
%
% Keys returned in answers are the CANONICAL lexicon keys of the order's
% citation vocabulary. The other keys (definitions, subsection chapeaux,
% the publisher's note, Rule 5.07(A)) are recorded for provenance markers
% only and are NEVER returned in a result.
%
% PROVENANCE: every operative clause opens its body with implements(Key),
% Key the provision for THAT condition or value.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

% ---- definitions, C.R.S. 6-1-1303 (read for meaning; never returned) ----
citation(us_co_crs_6_1_1303_6, [label-'C.R.S. 6-1-1303(6) definition of consumer', ref-'co-crs-6-1-1301-1315-2026-11-16-save#s6_1_1303_6']).
