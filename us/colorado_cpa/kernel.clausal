% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% kernel.clausal -- the SHARED FLOOR for us/colorado_cpa (deontic family).
% DAG root of the determination-slices layout. It holds ONLY the
% predicates that more than one file calls, and the order's input check.
% Exception: the scaffold writes the order's input check
% colorado_cpa_input_problems/2 here, exported, for every slice to import.
% deontic family: STATUS is a modal vocabulary (who is covered, by when a
% duty falls due); the order never says a duty was broken or met.
%
% Source: [quotation omitted]), (1)(b) and (2)
% (coverage), 6-1-1306(1)(a)(IV)(B), (2)(a), (2)(b) and (3)(b) (opt-out,
% response and appeal periods), 6-1-1311(1)(d)(II) (cure period); and the
% [quotation omitted], Rules 5.07(F), 5.08(A) and
% 5.08(A)(3). Pinned texts: co-crs-6-1-1301-1315-2026-11-16-save and
% co-ccr-904-3-v12259 (see citations.clausal).
%
% Atoms and data terms need NO declaration and NO import. The comment
% block below only RECORDS the result terms so every file spells them alike.
%
% Result terms.
%   colorado_cpa_verdict(Status, Citations) -- the facade verdict of the
%     slice colorado_cpa.clausal: Status is the RESULT of
%     applicability_status/3 (in_scope | biometric_only_scope |
%     out_of_scope | exempt_entity, or a status compound), Citations the
%     flat list of cite(Key) terms of the step that decided ([] when the
%     answer is not final).
%   The nine contract queries give two outputs: the answer itself (an atom
%     of the contract, ONE date(Year, Month, Day) term of three bare
%     integers, or a status compound) and a flat list of cite(Key).
%   Status compounds (never written bare):
%     indeterminate([Key])  -- exactly one missing key, the first in
%       root_exports order;
%     needs_legal_review(open_textured(Key, cite(CitationKey)),
%       [inputs_relied_on([Key-unsure])]) -- an unsure judgement;
%     input_problems(Problems) -- the problems of step (0), in order.
%   Problem terms: unknown_key(Key), wrong_type(Key), duplicate_key(Key);
%     wrong_type(received_date | appeal_received_date |
%     notice_received_date | reference_date | list_added_date) for a date
%     argument; wrong_type(profile) for a profile that is not an attribute
%     list.
%
% Shared predicates (beyond the input check):
%   query_problems(Profile, NamedDates, Problems) -- step (0) of every
%     query: the profile problems, then wrong_type(Name) for each
%     Name-Date pair, in signature order, whose Date is not a ground
%     date(Year, Month, Day) of a real Gregorian day, year 2000 to 2100.
%   date_plus_days(Date, Days, Result) -- Date plus Days calendar days
%     (reading (4): the day of the event is not counted; no roll).
%   date_plus_months_same_day(Date, Months, Result) -- the same day number
%     Months calendar months later, else the last day of that month
%     (reading (4), open question Q9). NOT kit deadline_months_after/3,
%     which counts from the day after the anchor to the period's end.
%   date_earlier(First, Second), date_on_or_earlier(First, Second) --
%     chronological order by the sign of days_between/3.
%   date_later_of(First, Second, Later) -- one solution, equal dates too.
% Dates are carried as the native date(Year, Month, Day) term and shifted
% with library(datetime) (timedelta/3, date_add/3, days_between/3).
% These helpers apply no statutory figure: each period and fixed date is a
% constant of the slice, whose operative clauses carry the markers.
% =====================================================================

:- module(kernel, [
    colorado_cpa_input_problems/2,
    query_problems/3,
    date_plus_days/3,
    date_plus_months_same_day/3,
    date_earlier/2,
    date_on_or_earlier/2,
    date_later_of/3
]).

:- use_module(library(clpz)).
:- use_module(library(reif), [memberd_t/3]).
:- use_module(library(datetime), [date_add/3, timedelta/3, days_between/3]).
:- use_module(kit/deadline_lib, [month_last_day/3]).

% ---- input checks: the problems a profile has, if any -----------
% colorado_cpa_input_problems(Profile, Problems): Problems = [] means the profile can be
% judged. Written from the order's typed input contract
% (input_contract.types.profile: attribute_list).
% Each public query calls this check first: it gives its normal answer only when
% Problems = [], and when Problems is not [] it gives the answer the order states for
% a profile with input problems.
% It gives exactly one answer for every Profile, and the answer is ground except for a
% Key named as given:
% - a Profile that is not an attribute list [attribute(Key, Value), ...] gives [wrong_type(profile)]:
%   an unbound Profile, a partial list, a list holding an unbound item or an item that is
%   not attribute(_, _);
% - a Key that is not an atom (a number, a string, a compound term, an unbound variable)
%   is a key outside the contract: unknown_key(Key), Key as given;
% - otherwise, for each contract key in the contract's key order, duplicate_key(Key) when
%   the key occurs more than once in Profile (whatever its values: none of them is read,
%   so it is never also wrong_type(Key)), else wrong_type(Key) when its one value is
%   outside its type; then unknown_key(Key) for each key outside the contract, in the
%   order of its first occurrence in Profile. Each key is named once. An absent key is
%   not a problem.
% Every step is complementary clauses: exactly one clause holds for each input.
colorado_cpa_input_problems(Profile, Problems) :-
    attribute_list_t(Profile, IsAttributeList),
    profile_problems(IsAttributeList, Profile, Problems).

profile_problems(false, _, [wrong_type(profile)]).
profile_problems(true, Profile, Problems) :-
    Keys = [entity_category, colorado_link_for_general_duties, consumer_count, revenue_or_discount_from_sale, processes_biometric_data, colorado_link_for_minors_duties, extension_reasonably_necessary, extension_notice_given_within_initial_period, appeal_extension_reasonably_necessary, appeal_extension_notice_given_within_initial_period, action_enforces_minors_duties, cure_deemed_possible, cured_within_cure_period, processes_for_targeted_advertising_or_sale],
    unknown_keys(Profile, Keys, UnknownKeyProblems),
    key_problems(Keys, Profile, UnknownKeyProblems, Problems).

% The contract: each key and the type of its value.
key_type(entity_category, entity_category).
key_type(colorado_link_for_general_duties, judgement).
key_type(consumer_count, non_negative_integer).
key_type(revenue_or_discount_from_sale, boolean).
key_type(processes_biometric_data, boolean).
key_type(colorado_link_for_minors_duties, judgement).
key_type(extension_reasonably_necessary, judgement).
key_type(extension_notice_given_within_initial_period, boolean).
key_type(appeal_extension_reasonably_necessary, judgement).
key_type(appeal_extension_notice_given_within_initial_period, boolean).
key_type(action_enforces_minors_duties, boolean).
key_type(cure_deemed_possible, boolean).
key_type(cured_within_cure_period, boolean).
key_type(processes_for_targeted_advertising_or_sale, boolean).

% attribute_list_t(Term, T): T is true when Term is a list of attribute(Key, Value)
% items, whatever each Key is; false for anything else, an unbound Term or item included.
attribute_list_t(Term, false) :-
    var(Term).
attribute_list_t(Term, true) :-
    Term == [].
attribute_list_t(Term, T) :-
    nonvar(Term),
    Term = [Element|Elements],
    attribute_t(Element, ElementIsAttribute),
    attribute_list_t(Elements, ElementsAreAttributes),
    truth_and(ElementIsAttribute, ElementsAreAttributes, T).
attribute_list_t(Term, false) :-
    nonvar(Term),
    Term \== [],
    Term \= [_|_].

attribute_t(Element, false) :-
    var(Element).
attribute_t(Element, true) :-
    nonvar(Element),
    Element = attribute(_, _).
attribute_t(Element, false) :-
    nonvar(Element),
    Element \= attribute(_, _).

% Unknown keys, in profile order, each once: Known grows by each key named. A key is
% known when it is identical (==) to one in Known, so an unbound Key is never bound:
% the same variable twice is one unknown key, two different variables are two.
unknown_keys([], _, []).
unknown_keys([attribute(Key, _)|Elements], Known, Problems) :-
    known_t(Key, Known, IsKnown),
    name_unknown_key(IsKnown, Key, Known, Elements, Problems).

known_t(_, [], false).
known_t(Key, [Known|_], true) :-
    Known == Key.
known_t(Key, [Known|Knowns], T) :-
    Known \== Key,
    known_t(Key, Knowns, T).

name_unknown_key(true, _, Known, Elements, Problems) :-
    unknown_keys(Elements, Known, Problems).
name_unknown_key(false, Key, Known, Elements, [unknown_key(Key)|Problems]) :-
    unknown_keys(Elements, [Key|Known], Problems).

% Contract keys, in contract order: duplicate_key(Key) when the key occurs more than once
% (none of its values is read), else wrong_type(Key) when its one value is outside the
% key's type. An absent key has no value to check.
key_problems([], _, Problems, Problems).
key_problems([Key|Keys], Profile, LaterProblems, Problems) :-
    key_type(Key, Type),
    key_occurrences(Profile, Key, Occurrences),
    key_problems(Keys, Profile, LaterProblems, KeyProblems),
    name_key_problem(Occurrences, Key, Type, Profile, KeyProblems, Problems).

% key_occurrences(Elements, Key, Occurrences): none, one or many items give Key.
key_occurrences([], _, none).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey == Key,
    key_occurrences(Elements, Key, RestOccurrences),
    one_more_occurrence(RestOccurrences, Occurrences).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey \== Key,
    key_occurrences(Elements, Key, Occurrences).

one_more_occurrence(none, one).
one_more_occurrence(one, many).
one_more_occurrence(many, many).

name_key_problem(none, _, _, _, Problems, Problems).
name_key_problem(many, Key, _, _, Problems, [duplicate_key(Key)|Problems]).
name_key_problem(one, Key, Type, Profile, KeyProblems, Problems) :-
    values_in_type_t(Profile, Key, Type, InType),
    name_wrong_type(InType, Key, KeyProblems, Problems).

name_wrong_type(true, _, Problems, Problems).
name_wrong_type(false, Key, Problems, [wrong_type(Key)|Problems]).

% values_in_type_t(Elements, Key, Type, T): T is true when every value Elements gives Key is
% in Type (true when Elements gives Key none).
values_in_type_t([], _, _, true).
values_in_type_t([attribute(ElementKey, Value)|Elements], Key, Type, T) :-
    ElementKey == Key,
    value_in_type_t(Type, Value, ValueInType),
    values_in_type_t(Elements, Key, Type, RestInType),
    truth_and(ValueInType, RestInType, T).
values_in_type_t([attribute(ElementKey, _)|Elements], Key, Type, T) :-
    ElementKey \== Key,
    values_in_type_t(Elements, Key, Type, T).

% A value with an unbound part is outside every type; a ground one is checked.
value_in_type_t(Type, Value, T) :-
    term_variables(Value, Variables),
    ground_value_in_type_t(Variables, Type, Value, T).

ground_value_in_type_t([_|_], _, _, false).
ground_value_in_type_t([], Type, Value, T) :-
    in_type_t(Type, Value, T).

% in_type_t(Type, Value, T): one clause per type, for a ground Value.
in_type_t(entity_category, Value, T) :-
    in_type_t(enum([financial_institution_or_affiliate_subject_to_glba, air_carrier, national_securities_association, none_of_the_exempt_categories]), Value, T).

in_type_t(judgement, Value, T) :-
    in_type_t(one_of([boolean, enum([unsure])]), Value, T).

in_type_t(boolean, Value, T) :-
    memberd_t(Value, [true, false], T).

in_type_t(enum(Values), Value, T) :-
    memberd_t(Value, Values, T).

in_type_t(one_of(Types), Value, T) :-
    in_some_type_t(Types, Value, T).

in_type_t(non_negative_integer, Value, T) :-
    non_negative_integer_t(Value, T).

truth_and(true, T, T).
truth_and(false, _, false).

% in_some_type_t(Types, Value, T): T is true when Value is in at least one of Types.
in_some_type_t([], _, false).
in_some_type_t([Type|Types], Value, T) :-
    in_type_t(Type, Value, InType),
    in_some_type_t(Types, Value, InAnother),
    truth_or(InType, InAnother, T).

truth_or(true, _, true).
truth_or(false, T, T).

% integer_t(Value, T): for a ground Value, T is true when it is an integer and false when it is a
% float, an atom or a compound term.
integer_t(Value, true) :-
    integer(Value).
integer_t(Value, false) :-
    float(Value).
integer_t(Value, false) :-
    atom(Value).
integer_t(Value, false) :-
    compound(Value).

% non_negative_integer_t(Value, T): for a ground Value, T is true when it is an integer of 0 or
% more.
non_negative_integer_t(Value, T) :-
    integer_t(Value, IsInteger),
    not_below_zero_t(IsInteger, Value, T).

not_below_zero_t(false, _, false).
not_below_zero_t(true, Value, true) :-
    Value >= 0.
not_below_zero_t(true, Value, false) :-
    Value < 0.

% ---- step (0) of every query: profile problems, then date problems --------
% query_problems(Profile, NamedDates, Problems): the problems of the input check for
% Profile, followed by wrong_type(Name) for each Name-Date pair of NamedDates (given in
% the order of the query's signature) whose Date is not a ground date(Year, Month, Day)
% of a real Gregorian day with a year from 2000 to 2100 inclusive. Exactly one answer.
query_problems(Profile, NamedDates, Problems) :-
    colorado_cpa_input_problems(Profile, ProfileProblems),
    date_argument_problems(NamedDates, DateProblems),
    append(ProfileProblems, DateProblems, Problems).

date_argument_problems([], []).
date_argument_problems([Name-Date|NamedDates], Problems) :-
    date_term_valid_t(Date, IsValid),
    date_argument_problems(NamedDates, LaterProblems),
    name_date_problem(IsValid, Name, LaterProblems, Problems).

name_date_problem(true, _, Problems, Problems).
name_date_problem(false, Name, Problems, [wrong_type(Name)|Problems]).

% The year range of the date arguments (an ADDED check of the order, not a statutory
% figure).
earliest_accepted_year(2000).
latest_accepted_year(2100).

% date_term_valid_t(Term, T): T is true when Term is a ground date(Year, Month, Day) of
% three integers naming a real Gregorian day with an accepted year; false otherwise, an
% unbound Term or field included.
date_term_valid_t(Term, false) :-
    term_variables(Term, [_|_]).
date_term_valid_t(Term, T) :-
    term_variables(Term, []),
    Term = date(Year, Month, Day),
    date_fields_valid_t(Year, Month, Day, T).
date_term_valid_t(Term, false) :-
    term_variables(Term, []),
    Term \= date(_, _, _).

date_fields_valid_t(Year, Month, Day, T) :-
    integer_t(Year, YearIsInteger),
    integer_t(Month, MonthIsInteger),
    integer_t(Day, DayIsInteger),
    truth_and(YearIsInteger, MonthIsInteger, YearAndMonthAreIntegers),
    truth_and(YearAndMonthAreIntegers, DayIsInteger, FieldsAreIntegers),
    integer_fields_valid_t(FieldsAreIntegers, Year, Month, Day, T).

integer_fields_valid_t(false, _, _, _, false).
integer_fields_valid_t(true, Year, Month, Day, T) :-
    earliest_accepted_year(EarliestYear),
    latest_accepted_year(LatestYear),
    closed_range_t(EarliestYear, LatestYear, Year, YearInRange),
    closed_range_t(1, 12, Month, MonthInRange),
    truth_and(YearInRange, MonthInRange, YearAndMonthInRange),
    day_valid_t(YearAndMonthInRange, Year, Month, Day, T).

day_valid_t(false, _, _, _, false).
day_valid_t(true, Year, Month, Day, T) :-
    month_last_day(Year, Month, LastDay),
    closed_range_t(1, LastDay, Day, T).

% closed_range_t(Low, High, Value, T): for integers with Low =< High, T is true when
% Low =< Value =< High.
closed_range_t(Low, High, Value, true) :-
    Value >= Low,
    Value =< High.
closed_range_t(Low, _, Value, false) :-
    Value < Low.
closed_range_t(_, High, Value, false) :-
    Value > High.

% ---- calendar arithmetic on native dates ----------------------------
% date_plus_days(Date, Days, Result): Result is Days calendar days after Date; the day of
% Date itself is not counted and no weekend or holiday moves the result (reading (4)).
date_plus_days(Date, Days, Result) :-
    timedelta(Days, 0, Period),
    date_add(Date, Period, Result).

% date_plus_months_same_day(Date, Months, Result): the day with Date's day number in the
% calendar month Months after Date's month, or the last day of that month when it has no
% such day (reading (4), open question Q9).
date_plus_months_same_day(date(Year, Month, Day), Months, date(NewYear, NewMonth, NewDay)) :-
    MonthIndex #= Year * 12 + Month - 1 + Months,
    NewYear #= MonthIndex // 12,
    NewMonth #= MonthIndex mod 12 + 1,
    month_last_day(NewYear, NewMonth, LastDay),
    NewDay #= min(Day, LastDay).

% date_earlier(First, Second): First is strictly before Second.
date_earlier(First, Second) :-
    days_between(Second, First, ElapsedDays),
    ElapsedDays #> 0.

% date_on_or_earlier(First, Second): First is Second or before it. With date_earlier/2
% swapped it makes complementary guards: date_earlier(A, B) or date_on_or_earlier(B, A).
date_on_or_earlier(First, Second) :-
    days_between(Second, First, ElapsedDays),
    ElapsedDays #>= 0.

% date_later_of(First, Second, Later): the later of the two dates; one solution when they
% are equal.
date_later_of(First, Second, Second) :-
    date_earlier(First, Second).
date_later_of(First, Second, First) :-
    date_on_or_earlier(Second, First).

test(a_well_formed_profile_and_date_have_no_problem) :-
    query_problems([attribute(consumer_count, 5)], [received_date-date(2026, 1, 1)], []).
test(a_day_missing_from_a_common_year_is_wrong_type) :-
    query_problems([], [received_date-date(2027, 2, 29)], [wrong_type(received_date)]).
test(a_leap_day_is_a_real_day) :-
    query_problems([], [received_date-date(2028, 2, 29)], []).
test(a_year_before_two_thousand_is_wrong_type) :-
    query_problems([], [list_added_date-date(1999, 12, 31)], [wrong_type(list_added_date)]).
test(an_unbound_date_is_wrong_type) :-
    query_problems([], [reference_date-_], [wrong_type(reference_date)]).
test(date_problems_follow_profile_problems_in_signature_order) :-
    query_problems(nonsense, [notice_received_date-date(2026, 13, 1), reference_date-x], [wrong_type(profile), wrong_type(notice_received_date), wrong_type(reference_date)]).
test(forty_five_days_cross_a_month_end) :-
    date_plus_days(date(2026, 1, 1), 45, date(2026, 2, 15)).
test(six_months_keep_the_day_number) :-
    date_plus_months_same_day(date(2024, 3, 15), 6, date(2024, 9, 15)).
test(six_months_clamp_to_a_leap_day) :-
    date_plus_months_same_day(date(2027, 8, 31), 6, date(2028, 2, 29)).
test(six_months_clamp_to_the_end_of_a_common_february) :-
    date_plus_months_same_day(date(2026, 8, 31), 6, date(2027, 2, 28)).
test(the_day_before_is_earlier) :-
    date_earlier(date(2025, 9, 30), date(2025, 10, 1)).
test(the_same_day_is_not_earlier, fail) :-
    date_earlier(date(2025, 10, 1), date(2025, 10, 1)).
test(the_same_day_is_on_or_earlier) :-
    date_on_or_earlier(date(2025, 10, 1), date(2025, 10, 1)).
test(equal_dates_give_one_later_date) :-
    findall(Later, date_later_of(date(2024, 7, 1), date(2024, 7, 1), Later), Laters),
    Laters == [date(2024, 7, 1)].

:- end_module(kernel).
