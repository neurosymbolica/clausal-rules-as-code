% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for us/virginia_vcdpa.
%
% Source of record: the pinned unit text of the Consumer Data Protection
% Act, Code of Virginia Title 59.1 chapter 53, from the Virginia LIS web
% copy (law.lis.virginia.gov) fetched 2026-11-16. The document is
% va-code-59-1-ch53-2026-11-16-lis-copy, sha256
% 62c62e78b55d4eb681b9de8ce2d5cdde04862e58fff66191c79b52934164065b.
% This is a secondary copy, not the printed Code, and it carries no
% in-force-as-of line (open question Q13).
%
% citation/2 record form: a FACT, the key an atom, and the second argument
% a pair list with keys exactly label, ref, verbatim, in that order. Each
% verbatim is the pinned unit text, an apostrophe written twice.
%
% The seven keys cited in answers are the canonical lexicon keys:
%   us_va_code_59_1_576_a, us_va_code_59_1_576_b,
%   us_va_code_59_1_577_b_1, us_va_code_59_1_577_b_2,
%   us_va_code_59_1_577_c, us_va_code_59_1_584_b, us_va_code_59_1_584_c.
%
% The following keys are recorded for units the order relies on but
% DEFERS. They are never returned in a result:
%   - the 59.1-575 definitions (consumer, personal data, sale of personal
%     data, nonprofit organization, institution of higher education),
%     which the caller applies when it states its facts;
%   - the lead-in of 59.1-577(B).
%
% PROVENANCE: every operative clause opens its body with implements(Key).
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

implements(Key) :-
    citation(Key, _).

% ---- deferred units: definitions of Va. Code 59.1-575 ----------------

citation(us_va_code_59_1_575_consumer, [label-'Va. Code 59.1-575 definition of consumer', ref-'https://law.lis.virginia.gov/vacode/title59.1/chapter53/section59.1-575/', verbatim-'"Consumer" means a natural person who is a resident of the Commonwealth acting only in an individual or household context. It does not include a natural person acting in a commercial or employment context.']).

citation(us_va_code_59_1_575_personal_data, [label-'Va. Code 59.1-575 definition of personal data', ref-'https://law.lis.virginia.gov/vacode/title59.1/chapter53/section59.1-575/', verbatim-'"Personal data" means any information that is linked or reasonably linkable to an identified or identifiable natural person. "Personal data" does not include de-identified data or publicly available information.']).

citation(us_va_code_59_1_575_sale_of_personal_data, [label-'Va. Code 59.1-575 definition of sale of personal data', ref-'https://law.lis.virginia.gov/vacode/title59.1/chapter53/section59.1-575/', verbatim-'"Sale of personal data" means the exchange of personal data for monetary consideration by the controller to a third party. "Sale of personal data" does not include:']).

citation(us_va_code_59_1_575_nonprofit_organization, [label-'Va. Code 59.1-575 definition of nonprofit organization', ref-'https://law.lis.virginia.gov/vacode/title59.1/chapter53/section59.1-575/', verbatim-'"Nonprofit organization" means any corporation organized under the Virginia Nonstock Corporation Act (§ 13.1-801 et seq.) or any organization exempt from taxation under § 501(c)(3), 501(c)(6), or 501(c)(12) of the Internal Revenue Code, any political organization, any organization exempt from taxation under § 501(c)(4) of the Internal Revenue Code that is identified in § 52-41 , and any subsidiary or affiliate of entities organized pursuant to Chapter 9.1 (§ 56-231.15 et seq.) of Title 56.']).

citation(us_va_code_59_1_575_institution_of_higher_education, [label-'Va. Code 59.1-575 definition of institution of higher education', ref-'https://law.lis.virginia.gov/vacode/title59.1/chapter53/section59.1-575/', verbatim-'"Institution of higher education" means a public institution and private institution of higher education, as those terms are defined in § 23.1-100 .']).

% ---- applicability: Va. Code 59.1-576 --------------------------------

citation(us_va_code_59_1_576_a, [label-'Va. Code 59.1-576(A) (persons to which the chapter applies; thresholds of 100,000 consumers, or 25,000 consumers and over 50 percent of gross revenue from sale)', ref-'https://law.lis.virginia.gov/vacode/title59.1/chapter53/section59.1-576/', verbatim-'A. This chapter applies to persons that conduct business in the Commonwealth or produce products or services that are targeted to residents of the Commonwealth and that (i) during a calendar year, control or process personal data of at least 100,000 consumers or (ii) control or process personal data of at least 25,000 consumers and derive over 50 percent of gross revenue from the sale of personal data.']).

citation(us_va_code_59_1_576_b, [label-'Va. Code 59.1-576(B) (exempt persons: public bodies, GLBA financial institutions, HIPAA covered entities and business associates, nonprofit organizations, institutions of higher education)', ref-'https://law.lis.virginia.gov/vacode/title59.1/chapter53/section59.1-576/', verbatim-'B. This chapter shall not apply to any (i) body, authority, board, bureau, commission, district, or agency of the Commonwealth or of any political subdivision of the Commonwealth; (ii) financial institution or data subject to Title V of the federal Gramm-Leach-Bliley Act (15 U.S.C. § 6801 et seq.); (iii) covered entity or business associate governed by the privacy, security, and breach notification rules issued by the U.S. Department of Health and Human Services, 45 C.F.R. Parts 160 and 164 established pursuant to HIPAA, and the Health Information Technology for Economic and Clinical Health Act (P.L. 111-5); (iv) nonprofit organization; or (v) institution of higher education.']).

% ---- consumer requests and appeals: Va. Code 59.1-577 ----------------

citation(us_va_code_59_1_577_b, [label-'Va. Code 59.1-577(B) lead-in (compliance with consumer requests, except as otherwise provided)', ref-'https://law.lis.virginia.gov/vacode/title59.1/chapter53/section59.1-577/', verbatim-'B. Except as otherwise provided in this chapter, a controller shall comply with a request by a consumer to exercise the consumer rights authorized pursuant to subsection A as follows:']).

citation(us_va_code_59_1_577_b_1, [label-'Va. Code 59.1-577(B)(1) (response within 45 days of receipt; one extension by 45 additional days)', ref-'https://law.lis.virginia.gov/vacode/title59.1/chapter53/section59.1-577/', verbatim-'1. A controller shall respond to the consumer without undue delay, but in all cases within 45 days of receipt of the request submitted pursuant to the methods described in subsection A. The response period may be extended once by 45 additional days when reasonably necessary, taking into account the complexity and number of the consumer''s requests, so long as the controller informs the consumer of any such extension within the initial 45-day response period, together with the reason for the extension.']).

citation(us_va_code_59_1_577_b_2, [label-'Va. Code 59.1-577(B)(2) (notice of a decline to act at the latest within 45 days of receipt)', ref-'https://law.lis.virginia.gov/vacode/title59.1/chapter53/section59.1-577/', verbatim-'2. If a controller declines to take action regarding the consumer''s request, the controller shall inform the consumer without undue delay, but in all cases and at the latest within 45 days of receipt of the request, of the justification for declining to take action and instructions for how to appeal the decision pursuant to subsection C.']).

citation(us_va_code_59_1_577_c, [label-'Va. Code 59.1-577(C) (written answer to an appeal within 60 days of receipt)', ref-'https://law.lis.virginia.gov/vacode/title59.1/chapter53/section59.1-577/', verbatim-'Within 60 days of receipt of an appeal, a controller shall inform the consumer in writing of any action taken or not taken in response to the appeal, including a written explanation of the reasons for the decisions.']).

% ---- enforcement: Va. Code 59.1-584 ----------------------------------

citation(us_va_code_59_1_584_b, [label-'Va. Code 59.1-584(B) (30 days'' written notice and cure period before any action)', ref-'https://law.lis.virginia.gov/vacode/title59.1/chapter53/section59.1-584/', verbatim-'B. Prior to initiating any action under this chapter, the Attorney General shall provide a controller or processor 30 days'' written notice identifying the specific provisions of this chapter the Attorney General alleges have been or are being violated. If within the 30-day period the controller or processor cures the noticed violation and provides the Attorney General an express written statement that the alleged violations have been cured and that no further violations shall occur, no action shall be initiated against the controller or processor.']).

citation(us_va_code_59_1_584_c, [label-'Va. Code 59.1-584(C) (action after the cure period; civil penalties of up to $7,500 for each violation)', ref-'https://law.lis.virginia.gov/vacode/title59.1/chapter53/section59.1-584/', verbatim-'C. If a controller or processor continues to violate this chapter following the cure period in subsection B or breaches an express written statement provided to the Attorney General under that subsection, the Attorney General may initiate an action in the name of the Commonwealth and may seek an injunction to restrain any violations of this chapter and civil penalties of up to $7,500 for each violation under this chapter.']).

% ---- tests ---------------------------------------------------------
test(every_answer_key_is_recorded) :-
    implements(us_va_code_59_1_576_a),
    implements(us_va_code_59_1_576_b),
    implements(us_va_code_59_1_577_b_1),
    implements(us_va_code_59_1_577_b_2),
    implements(us_va_code_59_1_577_c),
    implements(us_va_code_59_1_584_b),
    implements(us_va_code_59_1_584_c).
test(a_shortened_key_is_not_recorded, fail) :-
    implements(va_576_a).

:- end_module(citations).
