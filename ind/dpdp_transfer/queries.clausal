% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% queries.clausal -- QUERY layer for ind/dpdp_transfer.
% A TOP-LAYER consumer: it imports the determination slice's PUBLIC
% predicates it calls, and nothing else.
%
% Source: Digital Personal Data Protection Act 2023 s 16(1) and s 16(2);
% Digital Personal Data Protection Rules 2025 rule 15 and rule 1(4).
% MeitY website copies fetched 2026-11-13; drafter's reading, not a lawyer's.
%
% THE CALLED CONTRACT:
%   restriction_status(Restriction, Profile, Result, Citations)
%     the order's one query: the input check first, then the ladder of
%     Restriction (notified_destination | foreign_state_requirements,
%     host-supplied, never checked). Exactly one solution.
%   dpdp_transfer_input_problems(Profile, Problems)
%     the input check, re-exported from the kernel as the scaffold wrote it.
%
% QUERY TYPES served (with the slice's decide/status/checklist):
%   #2 eligibility    restriction_status/4 and the slice's
%                     decide_dpdp_transfer/2 give the verdict;
%                     dpdp_transfer_checklist/2 gives the cited checklist.
%   #7 justification  every checklist item carries cite(Key)
%                     (dpdp_transfer_checklist/2).
%   #16 what-if       dpdp_transfer_what_if/4: one key overridden, then
%                     the whole ladder re-decided.
%
% The what-if overrides an ATTRIBUTE LIST, not a dict, so it uses the local
% plumbing attribute_override/4 (query_combinators' override_key/4 reads a
% dict). Noted in NOTES.md as a kit candidate.
%
% RESULT ATOMS, the five PROFILE KEY atoms, the two RESTRICTION atoms and
% the judgement value unsure are exported so the package root carries them
% (root_exports); they are data, never called as queries. The RESULT
% CONSTRUCTORS are exported and declared with constructors/1: a
% constructor is data and has no clauses.
% =====================================================================

:- module(queries, [
    restriction_status/4,
    dpdp_transfer_profile_keys/1,
    dpdp_transfer_input_problems/2,
    dpdp_transfer_what_if/4,
    restricted_see_notification/0,
    requirements_apply_see_order/0,
    not_restricted/0,
    not_in_force/0,
    notified_destination/0,
    foreign_state_requirements/0,
    section_16_in_force_on_reference_date/0,
    destination_restricted_by_notification/0,
    reference_date/0,
    recipient_is_foreign_state_or_its_entity/0,
    foreign_state_requirements_specified/0,
    unsure/0,
    indeterminate/1,
    needs_legal_review/2,
    open_textured/2,
    inputs_relied_on/1,
    provenance/2,
    input_problems/1,
    unknown_key/1,
    wrong_type/1,
    duplicate_key/1
]).

:- use_module(ind/dpdp_transfer/kernel, [dpdp_transfer_input_problems/2]).
:- use_module(ind/dpdp_transfer/dpdp_transfer, [decide_dpdp_transfer/2, dpdp_transfer_status/2]).

% ---- result constructors (data; no clauses, never called as queries) --
:- constructors([
    indeterminate(missing_keys),
    needs_legal_review(reason, context),
    open_textured(input, citation),
    inputs_relied_on(pairs),
    provenance(clause, citations),
    input_problems(problems),
    unknown_key(key),
    wrong_type(key),
    duplicate_key(key)
]).

% ---- the called contract ---------------------------------------------
% restriction_status/4: the slice decides (input check first, then the
% ladder of Restriction); this clause only unpacks the slice verdict.
restriction_status(Restriction, Profile, Result, Citations) :-
    decide_dpdp_transfer(restriction_request(Restriction, Profile),
                         dpdp_transfer_verdict(Result, Citations)).

% ---- schema of profile keys: the input contract's keys, in its order --
dpdp_transfer_profile_keys([section_16_in_force_on_reference_date, destination_restricted_by_notification, reference_date, recipient_is_foreign_state_or_its_entity, foreign_state_requirements_specified]).

% ---- #16 what-if: one key overridden, the ladder re-decided ----------
dpdp_transfer_what_if(restriction_request(Restriction, Profile), OverriddenKey, NewValue, NewStatus) :-
    attribute_override(Profile, OverriddenKey, NewValue, Hypothesis),
    dpdp_transfer_status(restriction_request(Restriction, Hypothesis), NewStatus).

% attribute_override(Profile, Key, Value, Hypothesis): every attribute of Key
% is dropped and attribute(Key, Value) is added at the end (list plumbing).
attribute_override([], OverriddenKey, NewValue, [attribute(OverriddenKey, NewValue)]).
attribute_override([attribute(ElementKey, _)|Elements], OverriddenKey, NewValue, Hypothesis) :-
    ElementKey == OverriddenKey,
    attribute_override(Elements, OverriddenKey, NewValue, Hypothesis).
attribute_override([attribute(ElementKey, ElementValue)|Elements],
                   OverriddenKey,
                   NewValue,
                   [attribute(ElementKey, ElementValue)|Hypothesis]) :-
    ElementKey \== OverriddenKey,
    attribute_override(Elements, OverriddenKey, NewValue, Hypothesis).

% ---- result atoms (data; exported for the package root) --------------
restricted_see_notification.
requirements_apply_see_order.
not_restricted.
not_in_force.

% ---- restriction atoms (host-supplied argument values; data) ---------
notified_destination.
foreign_state_requirements.

% ---- profile key atoms, in contract order (data) ---------------------
section_16_in_force_on_reference_date.
destination_restricted_by_notification.
reference_date.
recipient_is_foreign_state_or_its_entity.
foreign_state_requirements_specified.

% ---- the judgement value besides true and false (data) ---------------
unsure.

% ---- tests ------------------------------------------------------------
test(restriction_status_gives_one_answer) :-
    findall(Result-Citations,
            restriction_status(notified_destination,
                               [attribute(section_16_in_force_on_reference_date, true),
                                attribute(destination_restricted_by_notification, true)],
                               Result,
                               Citations),
            Answers),
    Answers == [restricted_see_notification-[cite(in_dpdp_act_2023_s_16_1)]].
test(restriction_status_input_problems_first) :-
    findall(Result-Citations,
            restriction_status(foreign_state_requirements, not_a_list, Result, Citations),
            Answers),
    Answers == [input_problems([wrong_type(profile)])-[]].
test(what_if_flips_the_notification) :-
    findall(Status,
            dpdp_transfer_what_if(restriction_request(notified_destination,
                                                      [attribute(section_16_in_force_on_reference_date, true),
                                                       attribute(destination_restricted_by_notification, false)]),
                                  destination_restricted_by_notification,
                                  true,
                                  Status),
            Statuses),
    Statuses == [restricted_see_notification].
test(what_if_supplies_an_absent_key) :-
    findall(Status,
            dpdp_transfer_what_if(restriction_request(foreign_state_requirements,
                                                      [attribute(section_16_in_force_on_reference_date, true),
                                                       attribute(recipient_is_foreign_state_or_its_entity, true),
                                                       attribute(foreign_state_requirements_specified, true)]),
                                  reference_date,
                                  date(2027, 5, 12),
                                  Status),
            Statuses),
    Statuses == [not_in_force].
test(input_check_called_directly_on_a_well_formed_profile) :-
    dpdp_transfer_input_problems([attribute(section_16_in_force_on_reference_date, true),
                                  attribute(reference_date, date(2027, 5, 13))],
                                 Problems),
    Problems == [].

:- end_module(queries).
