% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% kernel.clausal -- the SHARED FLOOR for ind/dpdp_notice_consent (deontic family).
% DAG root of the determination-slices layout. It holds ONLY the
% predicates that two or more files call:
%   - dpdp_notice_consent_input_problems/2, the order's typed input check
%     (INTERFACE - THE INPUT CHECK), written by the scaffold from the order's
%     input contract and imported by the slice, the queries and the facade;
%   - key_state/3, the presence-then-value reading of one profile key with
%     profile_get/3 (INTERFACE - THE PROFILE AND THE ATOMS), used by the slice
%     ladders and by the facade;
%   - relied_pairs/3 and referral/5, the construction of
%     needs_legal_review(open_textured(KEY, cite(CITATION)), [inputs_relied_on(PAIRS)])
%     under THE PAIRS RULE (INTERFACE - THE STATUSES), used by every ladder that
%     refers an unsure judgement.
%
% Sources: Digital Personal Data Protection Act, 2023 (No. 22 of 2023),
% ss 2, 4, 5, 6 and 7, and Digital Personal Data Protection Rules, 2025
% (G.S.R. 846(E)), rules 1, 3, 4 and 5 and the First and Second Schedules,
% MeitY website PDF copies fetched 2026-11-13 (not India Code, not compared
% with the gazette). The input check and the referral builder decide no
% statutory condition: they carry no implements/1 marker. The open-textured
% judgements they hand over are the caller's (s 2(i), s 4(2), s 6(1), s 6(6),
% s 7).
%
% Atoms and data terms need NO declaration and NO import. The comment block
% below RECORDS the result terms so every file spells them alike.
%
% Result terms. Each PROFILE query of the order (consent_ground/3,
% legitimate_use_ground/3, consent_notice/3, withdrawal_effect/3,
% consent_manager_status/3) gives two outputs, RESULT and CITATIONS:
%   RESULT    one final atom of its query (lawful_on_consent,
%             not_lawful_on_consent, lawful_on_legitimate_use,
%             not_lawful_on_legitimate_use, notice_with_request_required,
%             notice_with_request_required_before_rule_3,
%             notice_for_earlier_consent_required,
%             notice_for_earlier_consent_required_before_rule_3, not_required,
%             cease_processing_required,
%             processing_may_continue_without_consent,
%             may_act_as_consent_manager, may_not_act_as_consent_manager,
%             not_in_force), or one status compound:
%               input_problems(PROBLEMS)  PROBLEMS the non-empty list of
%                   duplicate_key(KEY), wrong_type(KEY), unknown_key(KEY);
%               indeterminate([KEY])      exactly one missing key;
%               needs_legal_review(open_textured(KEY, cite(CITATIONKEY)),
%                                  [inputs_relied_on(PAIRS)])
%                   PAIRS the KEY-VALUE pairs of the present judgement keys
%                   of the query's PAIRS LIST, in root_exports order.
%             The bare atom indeterminate is never written.
%   CITATIONS a set-like list of cite(KEY); [] for every status compound.
% provision_lists(TOPIC, ITEMS): ITEMS a list of content_item(NAME, cite(KEY)).
% The facade's verdict term (one slice):
%   dpdp_notice_consent_verdict(status, citations)
%   status eligible | ineligible | indeterminate (mapped from consent_ground),
%   citations the consent_ground CITATIONS, [] when indeterminate.
% The facade checklist row: item(RequirementId, Status, cite(Key)).
% =====================================================================

:- module(kernel, [
    dpdp_notice_consent_input_problems/2,
    key_state/3,
    relied_pairs/3,
    referral/5
]).

:- use_module(library(reif), [memberd_t/3]).
:- use_module(formalize_lib, [profile_get/3, profile_lacks/2]).

% ---- reading one key: absent, or value(Value) --------------------
% key_state(Profile, Key, State): State is absent when Key is not in Profile and
% value(Value) when it is. Called only on a profile the input check passed, so a
% contract key occurs at most once and exactly one clause holds.
key_state(Profile, Key, absent) :-
    profile_lacks(Profile, Key).
key_state(Profile, Key, value(Value)) :-
    profile_get(Profile, Key, Value).

% ---- THE PAIRS RULE ------------------------------------------------
% relied_pairs(Profile, PairsListKeys, Pairs): the Key-Value pairs of the keys of
% PairsListKeys (given in root_exports order) that are present in Profile, the
% unsure ones included, in that order.
relied_pairs(_, [], []).
relied_pairs(Profile, [Key|Keys], Pairs) :-
    key_state(Profile, Key, State),
    relied_pairs(Profile, Keys, LaterPairs),
    add_relied_pair(State, Key, LaterPairs, Pairs).

add_relied_pair(absent, _, Pairs, Pairs).
add_relied_pair(value(Value), Key, Pairs, [Key-Value|Pairs]).

% referral(Key, CitationKey, Profile, PairsListKeys, Result): the referral of the
% unsure judgement Key, cited by CitationKey, with the pairs of the query's
% PAIRS LIST.
referral(Key,
         CitationKey,
         Profile,
         PairsListKeys,
         needs_legal_review(open_textured(Key, cite(CitationKey)),
                            [inputs_relied_on(Pairs)])) :-
    relied_pairs(Profile, PairsListKeys, Pairs).

% ---- input checks: the problems a profile has, if any -----------
% dpdp_notice_consent_input_problems(Profile, Problems): Problems = [] means the profile can be
% judged. Written from the order's typed input contract
% (input_contract.types.profile: attribute_list).
% Each public query calls this check first: it gives its normal answer only when
% Problems = [], and when Problems is not [] it gives the answer the order states for
% a profile with input problems.
% It gives exactly one answer for every Profile, and the answer is ground except for a
% Key named as given:
% - a Profile that is not an attribute list [attribute(Key, Value), ...] gives [wrong_type(profile)]:
%   an unbound Profile, a partial list, a list holding an unbound item or an item that is
%   not attribute(_, _);
% - a Key that is not an atom (a number, a string, a compound term, an unbound variable)
%   is a key outside the contract: unknown_key(Key), Key as given;
% - otherwise, for each contract key in the contract's key order, duplicate_key(Key) when
%   the key occurs more than once in Profile (whatever its values: none of them is read,
%   so it is never also wrong_type(Key)), else wrong_type(Key) when its one value is
%   outside its type; then unknown_key(Key) for each key outside the contract, in the
%   order of its first occurrence in Profile. Each key is named once. An absent key is
%   not a problem.
% Every step is complementary clauses: exactly one clause holds for each input.
dpdp_notice_consent_input_problems(Profile, Problems) :-
    attribute_list_t(Profile, IsAttributeList),
    profile_problems(IsAttributeList, Profile, Problems).

profile_problems(false, _, [wrong_type(profile)]).
profile_problems(true, Profile, Problems) :-
    Keys = [sections_4_to_7_in_force, section_6_9_in_force, question_date, acts_as_data_fiduciary, lawful_purpose, consent_given, consent_withdrawn, consent_meets_section_6_1, legitimate_use_clause, legitimate_use_conditions_met, notice_occasion, processing_required_or_authorised_by_law, registered_with_board_as_consent_manager, consent_manager_registration_suspended_or_cancelled],
    unknown_keys(Profile, Keys, UnknownKeyProblems),
    key_problems(Keys, Profile, UnknownKeyProblems, Problems).

% The contract: each key and the type of its value.
key_type(sections_4_to_7_in_force, boolean).
key_type(section_6_9_in_force, boolean).
key_type(question_date, date).
key_type(acts_as_data_fiduciary, judgement).
key_type(lawful_purpose, judgement).
key_type(consent_given, boolean).
key_type(consent_withdrawn, boolean).
key_type(consent_meets_section_6_1, judgement).
key_type(legitimate_use_clause, legitimate_use_clause_value).
key_type(legitimate_use_conditions_met, judgement).
key_type(notice_occasion, notice_occasion_value).
key_type(processing_required_or_authorised_by_law, judgement).
key_type(registered_with_board_as_consent_manager, boolean).
key_type(consent_manager_registration_suspended_or_cancelled, boolean).

% attribute_list_t(Term, T): T is true when Term is a list of attribute(Key, Value)
% items, whatever each Key is; false for anything else, an unbound Term or item included.
attribute_list_t(Term, false) :-
    var(Term).
attribute_list_t(Term, true) :-
    Term == [].
attribute_list_t(Term, T) :-
    nonvar(Term),
    Term = [Element|Elements],
    attribute_t(Element, ElementIsAttribute),
    attribute_list_t(Elements, ElementsAreAttributes),
    truth_and(ElementIsAttribute, ElementsAreAttributes, T).
attribute_list_t(Term, false) :-
    nonvar(Term),
    Term \== [],
    Term \= [_|_].

attribute_t(Element, false) :-
    var(Element).
attribute_t(Element, true) :-
    nonvar(Element),
    Element = attribute(_, _).
attribute_t(Element, false) :-
    nonvar(Element),
    Element \= attribute(_, _).

% Unknown keys, in profile order, each once: Known grows by each key named. A key is
% known when it is identical (==) to one in Known, so an unbound Key is never bound:
% the same variable twice is one unknown key, two different variables are two.
unknown_keys([], _, []).
unknown_keys([attribute(Key, _)|Elements], Known, Problems) :-
    known_t(Key, Known, IsKnown),
    name_unknown_key(IsKnown, Key, Known, Elements, Problems).

known_t(_, [], false).
known_t(Key, [Known|_], true) :-
    Known == Key.
known_t(Key, [Known|Knowns], T) :-
    Known \== Key,
    known_t(Key, Knowns, T).

name_unknown_key(true, _, Known, Elements, Problems) :-
    unknown_keys(Elements, Known, Problems).
name_unknown_key(false, Key, Known, Elements, [unknown_key(Key)|Problems]) :-
    unknown_keys(Elements, [Key|Known], Problems).

% Contract keys, in contract order: duplicate_key(Key) when the key occurs more than once
% (none of its values is read), else wrong_type(Key) when its one value is outside the
% key's type. An absent key has no value to check.
key_problems([], _, Problems, Problems).
key_problems([Key|Keys], Profile, LaterProblems, Problems) :-
    key_type(Key, Type),
    key_occurrences(Profile, Key, Occurrences),
    key_problems(Keys, Profile, LaterProblems, KeyProblems),
    name_key_problem(Occurrences, Key, Type, Profile, KeyProblems, Problems).

% key_occurrences(Elements, Key, Occurrences): none, one or many items give Key.
key_occurrences([], _, none).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey == Key,
    key_occurrences(Elements, Key, RestOccurrences),
    one_more_occurrence(RestOccurrences, Occurrences).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey \== Key,
    key_occurrences(Elements, Key, Occurrences).

one_more_occurrence(none, one).
one_more_occurrence(one, many).
one_more_occurrence(many, many).

name_key_problem(none, _, _, _, Problems, Problems).
name_key_problem(many, Key, _, _, Problems, [duplicate_key(Key)|Problems]).
name_key_problem(one, Key, Type, Profile, KeyProblems, Problems) :-
    values_in_type_t(Profile, Key, Type, InType),
    name_wrong_type(InType, Key, KeyProblems, Problems).

name_wrong_type(true, _, Problems, Problems).
name_wrong_type(false, Key, Problems, [wrong_type(Key)|Problems]).

% values_in_type_t(Elements, Key, Type, T): T is true when every value Elements gives Key is
% in Type (true when Elements gives Key none).
values_in_type_t([], _, _, true).
values_in_type_t([attribute(ElementKey, Value)|Elements], Key, Type, T) :-
    ElementKey == Key,
    value_in_type_t(Type, Value, ValueInType),
    values_in_type_t(Elements, Key, Type, RestInType),
    truth_and(ValueInType, RestInType, T).
values_in_type_t([attribute(ElementKey, _)|Elements], Key, Type, T) :-
    ElementKey \== Key,
    values_in_type_t(Elements, Key, Type, T).

% A value with an unbound part is outside every type; a ground one is checked.
value_in_type_t(Type, Value, T) :-
    term_variables(Value, Variables),
    ground_value_in_type_t(Variables, Type, Value, T).

ground_value_in_type_t([_|_], _, _, false).
ground_value_in_type_t([], Type, Value, T) :-
    in_type_t(Type, Value, T).

% in_type_t(Type, Value, T): one clause per type, for a ground Value.
in_type_t(judgement, Value, T) :-
    in_type_t(one_of([boolean, enum([unsure])]), Value, T).

in_type_t(legitimate_use_clause_value, Value, T) :-
    in_type_t(enum([voluntarily_provided_for_specified_purpose, state_subsidy_benefit_service_certificate_licence_or_permit, state_function_or_sovereignty_integrity_or_security, legal_obligation_to_disclose_to_state, compliance_with_judgment_decree_or_order, medical_emergency, epidemic_outbreak_or_public_health_threat, disaster_or_breakdown_of_public_order, employment_purposes, no_listed_use]), Value, T).

in_type_t(notice_occasion_value, Value, T) :-
    in_type_t(enum([request_for_consent, consent_given_before_commencement, no_notice_occasion]), Value, T).

in_type_t(boolean, Value, T) :-
    memberd_t(Value, [true, false], T).

in_type_t(date, Value, T) :-
    calendar_date_t(Value, T).

in_type_t(enum(Values), Value, T) :-
    memberd_t(Value, Values, T).

in_type_t(one_of(Types), Value, T) :-
    in_some_type_t(Types, Value, T).

truth_and(true, T, T).
truth_and(false, _, false).

% in_some_type_t(Types, Value, T): T is true when Value is in at least one of Types.
in_some_type_t([], _, false).
in_some_type_t([Type|Types], Value, T) :-
    in_type_t(Type, Value, InType),
    in_some_type_t(Types, Value, InAnother),
    truth_or(InType, InAnother, T).

truth_or(true, _, true).
truth_or(false, T, T).

% integer_t(Value, T): for a ground Value, T is true when it is an integer and false when it is a
% float, an atom or a compound term.
integer_t(Value, true) :-
    integer(Value).
integer_t(Value, false) :-
    float(Value).
integer_t(Value, false) :-
    atom(Value).
integer_t(Value, false) :-
    compound(Value).

% calendar_date_t(Value, T): T is true when Value is date(Year, Month, DayNumber), three
% integers that name a real day of the Gregorian calendar with Year from 1 to 9999
% (INTERFACE - THE PROFILE AND THE ATOMS, the date key).
calendar_date_t(date(Year, Month, DayNumber), T) :-
    integer_t(Year, YearIsInteger),
    integer_t(Month, MonthIsInteger),
    integer_t(DayNumber, DayNumberIsInteger),
    truth_and(YearIsInteger, MonthIsInteger, YearAndMonthAreIntegers),
    truth_and(YearAndMonthAreIntegers, DayNumberIsInteger, AllAreIntegers),
    calendar_day_t(AllAreIntegers, Year, Month, DayNumber, T).
calendar_date_t(Value, false) :-
    Value \= date(_, _, _).

calendar_day_t(false, _, _, _, false).
calendar_day_t(true, Year, Month, DayNumber, T) :-
    between_t(1, 9999, Year, IsYear),
    year_in_range_day_t(IsYear, Year, Month, DayNumber, T).

year_in_range_day_t(false, _, _, _, false).
year_in_range_day_t(true, Year, Month, DayNumber, T) :-
    between_t(1, 12, Month, IsMonth),
    day_of_month_t(IsMonth, Year, Month, DayNumber, T).

day_of_month_t(false, _, _, _, false).
day_of_month_t(true, Year, Month, DayNumber, T) :-
    month_length(Year, Month, Length),
    between_t(1, Length, DayNumber, T).

between_t(Lowest, Highest, Number, true) :-
    Number >= Lowest,
    Number =< Highest.
between_t(Lowest, _, Number, false) :-
    Number < Lowest.
between_t(_, Highest, Number, false) :-
    Number > Highest.

month_length(_, 1, 31).
month_length(Year, 2, Length) :-
    leap_year_t(Year, IsLeapYear),
    february_length(IsLeapYear, Length).
month_length(_, 3, 31).
month_length(_, 4, 30).
month_length(_, 5, 31).
month_length(_, 6, 30).
month_length(_, 7, 31).
month_length(_, 8, 31).
month_length(_, 9, 30).
month_length(_, 10, 31).
month_length(_, 11, 30).
month_length(_, 12, 31).

february_length(true, 29).
february_length(false, 28).

% The remainders are computed first and compared one at a time.
leap_year_t(Year, IsLeapYear) :-
    FourYearRemainder is Year mod 4,
    CenturyRemainder is Year mod 100,
    FourCenturyRemainder is Year mod 400,
    gregorian_leap_year_t(FourYearRemainder, CenturyRemainder, FourCenturyRemainder,
                          IsLeapYear).

gregorian_leap_year_t(_, _, 0, true).
gregorian_leap_year_t(0, CenturyRemainder, _, true) :-
    CenturyRemainder =\= 0.
gregorian_leap_year_t(_, 0, FourCenturyRemainder, false) :-
    FourCenturyRemainder =\= 0.
gregorian_leap_year_t(FourYearRemainder, _, _, false) :-
    FourYearRemainder =\= 0.

% ---- tests ---------------------------------------------------------
test(a_well_formed_profile_has_no_problem) :-
    dpdp_notice_consent_input_problems([attribute(consent_given, true),
                                        attribute(lawful_purpose, unsure)],
                                       []).
test(a_non_list_is_not_a_profile) :-
    dpdp_notice_consent_input_problems(nothing, [wrong_type(profile)]).
test(a_crisp_key_given_unsure_is_wrong_type) :-
    dpdp_notice_consent_input_problems([attribute(consent_given, unsure)],
                                       [wrong_type(consent_given)]).
test(a_duplicate_key_is_not_also_wrong_type) :-
    dpdp_notice_consent_input_problems([attribute(consent_given, maybe),
                                        attribute(consent_given, true)],
                                       [duplicate_key(consent_given)]).
test(an_unknown_key_is_named_once) :-
    dpdp_notice_consent_input_problems([attribute(colour, red),
                                        attribute(colour, blue)],
                                       [unknown_key(colour)]).
test(an_absent_key_reads_as_absent) :-
    key_state([attribute(consent_given, true)], lawful_purpose, absent).
test(a_present_key_reads_its_value) :-
    key_state([attribute(consent_given, true)], consent_given, value(true)).
test(a_referral_carries_the_present_judgements_in_order) :-
    referral(lawful_purpose,
             in_dpdp_act_2023_s_4_2,
             [attribute(consent_meets_section_6_1, false),
              attribute(lawful_purpose, unsure)],
             [lawful_purpose, consent_meets_section_6_1],
             Result),
    Result == needs_legal_review(open_textured(lawful_purpose,
                                               cite(in_dpdp_act_2023_s_4_2)),
                                 [inputs_relied_on([lawful_purpose-unsure,
                                                    consent_meets_section_6_1-false])]).

:- end_module(kernel).
