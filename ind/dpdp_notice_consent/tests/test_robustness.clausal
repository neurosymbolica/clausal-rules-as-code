% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_robustness.clausal -- ROBUSTNESS of the input check dpdp_notice_consent_input_problems/2 for a
% PROFILE that is an attribute list [attribute(Key, Value), ...]: an empty list, a
% value that is not a list, an unknown key and a value outside its type each get exactly
% one answer. Written by the scaffold from the order's typed input contract
% (input_contract.types.profile: attribute_list), not by the producer;
% do not edit or delete.
% Run: python -m clausal.testing ind/dpdp_notice_consent/tests/test_robustness.clausal
% =====================================================================
:- module(test_robustness, []).
:- use_module(ind/dpdp_notice_consent/queries, [dpdp_notice_consent_input_problems/2]).

test(an_empty_attribute_list_gets_exactly_one_answer) :-
    findall(Problems, dpdp_notice_consent_input_problems([], Problems), Answers),
    Answers == [[]].

test(a_profile_that_is_not_a_list_gets_one_non_empty_answer) :-
    findall(Problems, dpdp_notice_consent_input_problems(not_a_profile, Problems), Answers),
    Answers = [[_|_]].

test(an_unknown_key_is_named) :-
    findall(Problems, dpdp_notice_consent_input_problems([attribute(not_a_key_of_the_contract, true)], Problems), Answers),
    Answers = [Problems],
    memberchk(unknown_key(not_a_key_of_the_contract), Problems).

test(a_value_outside_the_type_of_sections_4_to_7_in_force_is_named) :-
    findall(Problems, dpdp_notice_consent_input_problems([attribute(sections_4_to_7_in_force, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(sections_4_to_7_in_force), Problems).

test(a_value_outside_the_type_of_question_date_is_named) :-
    findall(Problems, dpdp_notice_consent_input_problems([attribute(question_date, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(question_date), Problems).

test(a_value_outside_the_type_of_acts_as_data_fiduciary_is_named) :-
    findall(Problems, dpdp_notice_consent_input_problems([attribute(acts_as_data_fiduciary, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(acts_as_data_fiduciary), Problems).

test(a_value_outside_the_type_of_legitimate_use_clause_is_named) :-
    findall(Problems, dpdp_notice_consent_input_problems([attribute(legitimate_use_clause, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(legitimate_use_clause), Problems).

:- end_module(test_robustness).
