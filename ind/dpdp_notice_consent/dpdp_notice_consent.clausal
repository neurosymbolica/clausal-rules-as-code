% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% dpdp_notice_consent.clausal -- the dpdp_notice_consent DETERMINATION for
% ind/dpdp_notice_consent, self-contained top to bottom: its statutory VALUE
% facts, its ladders (one per query of the order), its fixed provision lists,
% its checklist, its verdict assembly and its per-rule tests.
%
% Sources: Digital Personal Data Protection Act, 2023 (No. 22 of 2023),
% ss 2(g), 2(i), 4, 5, 6 and 7, and Digital Personal Data Protection Rules,
% 2025 (G.S.R. 846(E), English half only), rules 1(4), 3, 4 and 5 and the
% First and Second Schedules, MeitY website PDF copies fetched 2026-11-13
% (not India Code, not compared with the gazette).
%
% Queries (INTERFACE - THE CALLED CONTRACT): consent_ground/3,
% legitimate_use_ground/3, consent_notice/3, withdrawal_effect/3,
% consent_manager_status/3 (PROFILE, RESULT, CITATIONS), and
% provision_lists/2 (TOPIC, ITEMS). Every query yields exactly ONE solution.
% Each ladder takes the steps of THE LIMBS in order: input problems; the
% in-force key; the settling values; the first missing key;
% the unsure judgements; the final answer.
%
% Open-textured judgements (s 2(i), s 4(2), s 6(1), s 6(6), s 7) are the
% caller's: an unsure value is referred, never decided.
% =====================================================================

:- module(dpdp_notice_consent, [
    consent_ground/3,
    legitimate_use_ground/3,
    consent_notice/3,
    withdrawal_effect/3,
    consent_manager_status/3,
    provision_lists/2,
    decide_dpdp_notice_consent/2,
    dpdp_notice_consent_status/2,
    dpdp_notice_consent_checklist/2,
    dpdp_notice_consent_decision_resolvable/1,
    dpdp_notice_consent_status_values/1
]).

:- use_module(ind/dpdp_notice_consent/kernel, [
    dpdp_notice_consent_input_problems/2,
    key_state/3,
    referral/5
]).
:- use_module(ind/dpdp_notice_consent/citations, [implements/1]).

% ---- statutory VALUE facts owned by this determination ---------------
% The day rule 3 starts under the main reading (reading (3), Q2): eighteen
% months after the Gazette header date of 13 November 2025, CALCULATED by the
% drafter from rule 1(4).
rule_3_commencement(date(2027, 5, 13), cite(in_dpdp_rules_2025_r_1_4)).

% The clause of s 7 each legitimate_use_clause atom names (reading (7)).
legitimate_use_clause_citation(voluntarily_provided_for_specified_purpose, cite(in_dpdp_act_2023_s_7_a)).
legitimate_use_clause_citation(state_subsidy_benefit_service_certificate_licence_or_permit, cite(in_dpdp_act_2023_s_7_b)).
legitimate_use_clause_citation(state_function_or_sovereignty_integrity_or_security, cite(in_dpdp_act_2023_s_7_c)).
legitimate_use_clause_citation(legal_obligation_to_disclose_to_state, cite(in_dpdp_act_2023_s_7_d)).
legitimate_use_clause_citation(compliance_with_judgment_decree_or_order, cite(in_dpdp_act_2023_s_7_e)).
legitimate_use_clause_citation(medical_emergency, cite(in_dpdp_act_2023_s_7_f)).
legitimate_use_clause_citation(epidemic_outbreak_or_public_health_threat, cite(in_dpdp_act_2023_s_7_g)).
legitimate_use_clause_citation(disaster_or_breakdown_of_public_order, cite(in_dpdp_act_2023_s_7_h)).
legitimate_use_clause_citation(employment_purposes, cite(in_dpdp_act_2023_s_7_i)).

% The verdict vocabulary of the facade as a ground table.
dpdp_notice_consent_status_values([eligible, ineligible, indeterminate]).

% ---- ladder plumbing (decides nothing statutory: no marker) -----------
% settled_t(Profile, KeyValuePairs, Truth): Truth is true when some key of the
% list is present with its settling value, false otherwise.
settled_t(_, [], false).
settled_t(Profile, [KeyName-Settling|Remaining], Truth) :-
    key_state(Profile, KeyName, State),
    settling_state_t(State, Settling, Matches),
    settled_remaining(Matches, Profile, Remaining, Truth).

settling_state_t(State, Settling, true) :-
    State == value(Settling).
settling_state_t(State, Settling, false) :-
    State \== value(Settling).

settled_remaining(true, _, _, true).
settled_remaining(false, Profile, Remaining, Truth) :-
    settled_t(Profile, Remaining, Truth).

% first_absent_key(Profile, KeyNames, Outcome): absent(KeyName) for the first
% absent key of the list, none when every key is present.
first_absent_key(_, [], none).
first_absent_key(Profile, [KeyName|KeyNames], Outcome) :-
    key_state(Profile, KeyName, State),
    absent_outcome(State, KeyName, Profile, KeyNames, Outcome).

absent_outcome(absent, KeyName, _, _, absent(KeyName)).
absent_outcome(value(_), _, Profile, KeyNames, Outcome) :-
    first_absent_key(Profile, KeyNames, Outcome).

% first_unsure_key(Profile, KeyNames, Outcome): unsure(KeyName) for the first
% key of the list given unsure, none when no key is unsure.
first_unsure_key(_, [], none).
first_unsure_key(Profile, [KeyName|KeyNames], Outcome) :-
    key_state(Profile, KeyName, State),
    unsure_outcome(State, KeyName, Profile, KeyNames, Outcome).

unsure_outcome(absent, _, Profile, KeyNames, Outcome) :-
    first_unsure_key(Profile, KeyNames, Outcome).
unsure_outcome(value(unsure), KeyName, _, _, unsure(KeyName)).
unsure_outcome(value(Value), _, Profile, KeyNames, Outcome) :-
    dif(Value, unsure),
    first_unsure_key(Profile, KeyNames, Outcome).

% ---- rule 1(4): is rule 3 in force on the question date? -------------
rule_3_timing(QuestionDate, before_rule_3) :-
    implements(in_dpdp_rules_2025_r_1_4),
    rule_3_commencement(StartDate, _),
    QuestionDate @< StartDate.
rule_3_timing(QuestionDate, rule_3_in_force) :-
    implements(in_dpdp_rules_2025_r_1_4),
    rule_3_commencement(StartDate, _),
    QuestionDate @>= StartDate.

% =====================================================================
% (A) CONSENT_GROUND: s 4(1)(a), s 4(2), s 6(1), s 6(4)
% =====================================================================
consent_ground(Profile, Result, Citations) :-
    dpdp_notice_consent_input_problems(Profile, Problems),
    consent_ground_checked(Problems, Profile, Result, Citations).

consent_ground_checked([Problem|Problems], _, input_problems([Problem|Problems]), []).
consent_ground_checked([], Profile, Result, Citations) :-
    key_state(Profile, sections_4_to_7_in_force, InForce),
    consent_ground_in_force(InForce, Profile, Result, Citations).

consent_ground_in_force(absent, _, indeterminate([sections_4_to_7_in_force]), []).
consent_ground_in_force(value(false), _, not_in_force, [cite(in_dpdp_act_2023_s_4_1)]) :-
    implements(in_dpdp_act_2023_s_4_1).
consent_ground_in_force(value(true), Profile, Result, Citations) :-
    implements(in_dpdp_act_2023_s_4_1),
    settled_t(Profile,
              [lawful_purpose-false,
               consent_given-false,
               consent_withdrawn-true,
               consent_meets_section_6_1-false],
              Settled),
    consent_ground_settled(Settled, Profile, Result, Citations).

% Steps 3 to 6: a forbidden purpose, no consent, a withdrawn consent or a
% consent failing s 6(1) each settle the answer.
consent_ground_settled(true,
                       _,
                       not_lawful_on_consent,
                       [cite(in_dpdp_act_2023_s_4_1),
                        cite(in_dpdp_act_2023_s_4_1_a),
                        cite(in_dpdp_act_2023_s_4_2),
                        cite(in_dpdp_act_2023_s_6_1),
                        cite(in_dpdp_act_2023_s_6_4)]) :-
    implements(in_dpdp_act_2023_s_4_1_a).
consent_ground_settled(false, Profile, Result, Citations) :-
    first_absent_key(Profile,
                     [lawful_purpose,
                      consent_given,
                      consent_withdrawn,
                      consent_meets_section_6_1],
                     Absent),
    consent_ground_open(Absent, Profile, Result, Citations).

consent_ground_open(absent(KeyName), _, indeterminate([KeyName]), []).
consent_ground_open(none, Profile, Result, Citations) :-
    first_unsure_key(Profile, [lawful_purpose, consent_meets_section_6_1], Unsure),
    consent_ground_resolved(Unsure, Profile, Result, Citations).

consent_ground_resolved(unsure(lawful_purpose), Profile, Result, []) :-
    implements(in_dpdp_act_2023_s_4_2),
    referral(lawful_purpose,
             in_dpdp_act_2023_s_4_2,
             Profile,
             [lawful_purpose, consent_meets_section_6_1],
             Result).
consent_ground_resolved(unsure(consent_meets_section_6_1), Profile, Result, []) :-
    implements(in_dpdp_act_2023_s_6_1),
    referral(consent_meets_section_6_1,
             in_dpdp_act_2023_s_6_1,
             Profile,
             [lawful_purpose, consent_meets_section_6_1],
             Result).
% A consent given before the Act commenced counts as consent_given (s 5(2)(b),
% reading (6), Q8).
consent_ground_resolved(none,
                        _,
                        lawful_on_consent,
                        [cite(in_dpdp_act_2023_s_4_1),
                         cite(in_dpdp_act_2023_s_4_1_a),
                         cite(in_dpdp_act_2023_s_6_1)]) :-
    implements(in_dpdp_act_2023_s_4_1_a),
    implements(in_dpdp_act_2023_s_5_2_b).

% =====================================================================
% (B) LEGITIMATE_USE_GROUND: s 4(1)(b), s 4(2), s 7
% =====================================================================
legitimate_use_ground(Profile, Result, Citations) :-
    dpdp_notice_consent_input_problems(Profile, Problems),
    legitimate_use_checked(Problems, Profile, Result, Citations).

legitimate_use_checked([Problem|Problems], _, input_problems([Problem|Problems]), []).
legitimate_use_checked([], Profile, Result, Citations) :-
    key_state(Profile, sections_4_to_7_in_force, InForce),
    legitimate_use_in_force(InForce, Profile, Result, Citations).

legitimate_use_in_force(absent, _, indeterminate([sections_4_to_7_in_force]), []).
legitimate_use_in_force(value(false), _, not_in_force, [cite(in_dpdp_act_2023_s_4_1)]) :-
    implements(in_dpdp_act_2023_s_4_1).
legitimate_use_in_force(value(true), Profile, Result, Citations) :-
    implements(in_dpdp_act_2023_s_4_1),
    settled_t(Profile,
              [lawful_purpose-false,
               legitimate_use_clause-no_listed_use,
               legitimate_use_conditions_met-false],
              Settled),
    legitimate_use_settled(Settled, Profile, Result, Citations).

% Steps 3 to 5: the same answer and citations whichever settles it.
legitimate_use_settled(true,
                       _,
                       not_lawful_on_legitimate_use,
                       [cite(in_dpdp_act_2023_s_4_1),
                        cite(in_dpdp_act_2023_s_4_1_b),
                        cite(in_dpdp_act_2023_s_4_2),
                        cite(in_dpdp_act_2023_s_7)]) :-
    implements(in_dpdp_act_2023_s_7).
legitimate_use_settled(false, Profile, Result, Citations) :-
    first_absent_key(Profile,
                     [lawful_purpose,
                      legitimate_use_clause,
                      legitimate_use_conditions_met],
                     Absent),
    legitimate_use_open(Absent, Profile, Result, Citations).

legitimate_use_open(absent(KeyName), _, indeterminate([KeyName]), []).
legitimate_use_open(none, Profile, Result, Citations) :-
    first_unsure_key(Profile, [lawful_purpose, legitimate_use_conditions_met], Unsure),
    legitimate_use_resolved(Unsure, Profile, Result, Citations).

legitimate_use_resolved(unsure(lawful_purpose), Profile, Result, []) :-
    implements(in_dpdp_act_2023_s_4_2),
    referral(lawful_purpose,
             in_dpdp_act_2023_s_4_2,
             Profile,
             [lawful_purpose, legitimate_use_conditions_met],
             Result).
legitimate_use_resolved(unsure(legitimate_use_conditions_met), Profile, Result, []) :-
    implements(in_dpdp_act_2023_s_7),
    referral(legitimate_use_conditions_met,
             in_dpdp_act_2023_s_7,
             Profile,
             [lawful_purpose, legitimate_use_conditions_met],
             Result).
% 'certain legitimate uses' are the uses of s 7 (s 2(d)).
legitimate_use_resolved(none,
                        Profile,
                        lawful_on_legitimate_use,
                        [cite(in_dpdp_act_2023_s_4_1_b),
                         cite(in_dpdp_act_2023_s_7),
                         ClauseCitation]) :-
    implements(in_dpdp_act_2023_s_4_1_b),
    implements(in_dpdp_act_2023_s_2_d),
    key_state(Profile, legitimate_use_clause, value(Clause)),
    legitimate_use_clause_citation(Clause, ClauseCitation).

% =====================================================================
% (C) CONSENT_NOTICE: s 2(i), s 5(1), s 5(2)(a), s 5(3), rule 1(4), rule 3
% =====================================================================
consent_notice(Profile, Result, Citations) :-
    dpdp_notice_consent_input_problems(Profile, Problems),
    consent_notice_checked(Problems, Profile, Result, Citations).

consent_notice_checked([Problem|Problems], _, input_problems([Problem|Problems]), []).
consent_notice_checked([], Profile, Result, Citations) :-
    key_state(Profile, sections_4_to_7_in_force, InForce),
    consent_notice_in_force(InForce, Profile, Result, Citations).

consent_notice_in_force(absent, _, indeterminate([sections_4_to_7_in_force]), []).
consent_notice_in_force(value(false),
                        _,
                        not_in_force,
                        [cite(in_dpdp_act_2023_s_5_1),
                         cite(in_dpdp_act_2023_s_5_2_a)]) :-
    implements(in_dpdp_act_2023_s_5_1).
consent_notice_in_force(value(true), Profile, Result, Citations) :-
    implements(in_dpdp_act_2023_s_5_1),
    settled_t(Profile,
              [acts_as_data_fiduciary-false,
               notice_occasion-no_notice_occasion],
              Settled),
    consent_notice_settled(Settled, Profile, Result, Citations).

% Steps 3 and 4: not the Data Fiduciary, or neither occasion of s 5.
consent_notice_settled(true,
                       _,
                       not_required,
                       [cite(in_dpdp_act_2023_s_2_i),
                        cite(in_dpdp_act_2023_s_5_1),
                        cite(in_dpdp_act_2023_s_5_2_a)]) :-
    implements(in_dpdp_act_2023_s_2_i).
consent_notice_settled(false, Profile, Result, Citations) :-
    first_absent_key(Profile,
                     [acts_as_data_fiduciary,
                      notice_occasion,
                      question_date],
                     Absent),
    consent_notice_open(Absent, Profile, Result, Citations).

consent_notice_open(absent(KeyName), _, indeterminate([KeyName]), []).
consent_notice_open(none, Profile, Result, Citations) :-
    first_unsure_key(Profile, [acts_as_data_fiduciary], Unsure),
    consent_notice_resolved(Unsure, Profile, Result, Citations).

consent_notice_resolved(unsure(acts_as_data_fiduciary), Profile, Result, []) :-
    implements(in_dpdp_act_2023_s_2_i),
    referral(acts_as_data_fiduciary,
             in_dpdp_act_2023_s_2_i,
             Profile,
             [acts_as_data_fiduciary],
             Result).
consent_notice_resolved(none, Profile, Result, Citations) :-
    key_state(Profile, notice_occasion, value(Occasion)),
    key_state(Profile, question_date, value(QuestionDate)),
    rule_3_timing(QuestionDate, Timing),
    consent_notice_owed(Occasion, Timing, Result, Citations).

% Steps 9 to 12: the occasion and whether rule 3 is yet in force.
consent_notice_owed(request_for_consent,
                    before_rule_3,
                    notice_with_request_required_before_rule_3,
                    [cite(in_dpdp_act_2023_s_5_1),
                     cite(in_dpdp_act_2023_s_5_3),
                     cite(in_dpdp_rules_2025_r_1_4)]) :-
    implements(in_dpdp_act_2023_s_5_1).
consent_notice_owed(request_for_consent,
                    rule_3_in_force,
                    notice_with_request_required,
                    [cite(in_dpdp_act_2023_s_5_1),
                     cite(in_dpdp_act_2023_s_5_3),
                     cite(in_dpdp_rules_2025_r_3)]) :-
    implements(in_dpdp_rules_2025_r_3).
consent_notice_owed(consent_given_before_commencement,
                    before_rule_3,
                    notice_for_earlier_consent_required_before_rule_3,
                    [cite(in_dpdp_act_2023_s_5_2),
                     cite(in_dpdp_act_2023_s_5_2_a),
                     cite(in_dpdp_act_2023_s_5_3),
                     cite(in_dpdp_rules_2025_r_1_4)]) :-
    implements(in_dpdp_act_2023_s_5_2_a).
consent_notice_owed(consent_given_before_commencement,
                    rule_3_in_force,
                    notice_for_earlier_consent_required,
                    [cite(in_dpdp_act_2023_s_5_2),
                     cite(in_dpdp_act_2023_s_5_2_a),
                     cite(in_dpdp_act_2023_s_5_3),
                     cite(in_dpdp_rules_2025_r_3)]) :-
    implements(in_dpdp_rules_2025_r_3).

% =====================================================================
% (D) WITHDRAWAL_EFFECT: s 2(i), s 6(4), s 6(5), s 6(6)
% =====================================================================
withdrawal_effect(Profile, Result, Citations) :-
    dpdp_notice_consent_input_problems(Profile, Problems),
    withdrawal_checked(Problems, Profile, Result, Citations).

withdrawal_checked([Problem|Problems], _, input_problems([Problem|Problems]), []).
withdrawal_checked([], Profile, Result, Citations) :-
    key_state(Profile, sections_4_to_7_in_force, InForce),
    withdrawal_in_force(InForce, Profile, Result, Citations).

withdrawal_in_force(absent, _, indeterminate([sections_4_to_7_in_force]), []).
withdrawal_in_force(value(false), _, not_in_force, [cite(in_dpdp_act_2023_s_6_6)]) :-
    implements(in_dpdp_act_2023_s_6_6).
withdrawal_in_force(value(true), Profile, Result, Citations) :-
    implements(in_dpdp_act_2023_s_6_6),
    settled_t(Profile,
              [acts_as_data_fiduciary-false,
               consent_withdrawn-false],
              Settled),
    withdrawal_settled(Settled, Profile, Result, Citations).

% Steps 3 and 4: not the Data Fiduciary, or no withdrawal.
withdrawal_settled(true,
                   _,
                   not_required,
                   [cite(in_dpdp_act_2023_s_2_i),
                    cite(in_dpdp_act_2023_s_6_4),
                    cite(in_dpdp_act_2023_s_6_6)]) :-
    implements(in_dpdp_act_2023_s_6_4).
withdrawal_settled(false, Profile, Result, Citations) :-
    first_absent_key(Profile,
                     [acts_as_data_fiduciary,
                      consent_withdrawn,
                      processing_required_or_authorised_by_law],
                     Absent),
    withdrawal_open(Absent, Profile, Result, Citations).

withdrawal_open(absent(KeyName), _, indeterminate([KeyName]), []).
withdrawal_open(none, Profile, Result, Citations) :-
    first_unsure_key(Profile,
                     [acts_as_data_fiduciary,
                      processing_required_or_authorised_by_law],
                     Unsure),
    withdrawal_resolved(Unsure, Profile, Result, Citations).

withdrawal_resolved(unsure(acts_as_data_fiduciary), Profile, Result, []) :-
    implements(in_dpdp_act_2023_s_2_i),
    referral(acts_as_data_fiduciary,
             in_dpdp_act_2023_s_2_i,
             Profile,
             [acts_as_data_fiduciary, processing_required_or_authorised_by_law],
             Result).
withdrawal_resolved(unsure(processing_required_or_authorised_by_law), Profile, Result, []) :-
    implements(in_dpdp_act_2023_s_6_6),
    referral(processing_required_or_authorised_by_law,
             in_dpdp_act_2023_s_6_6,
             Profile,
             [acts_as_data_fiduciary, processing_required_or_authorised_by_law],
             Result).
withdrawal_resolved(none, Profile, Result, Citations) :-
    key_state(Profile, processing_required_or_authorised_by_law, value(Processing)),
    withdrawal_after(Processing, Result, Citations).

withdrawal_after(true,
                 processing_may_continue_without_consent,
                 [cite(in_dpdp_act_2023_s_6_6)]) :-
    implements(in_dpdp_act_2023_s_6_6).
withdrawal_after(false,
                 cease_processing_required,
                 [cite(in_dpdp_act_2023_s_6_4),
                  cite(in_dpdp_act_2023_s_6_5),
                  cite(in_dpdp_act_2023_s_6_6)]) :-
    implements(in_dpdp_act_2023_s_6_6).

% =====================================================================
% (E) CONSENT_MANAGER_STATUS: s 2(g), s 6(7) to (9), rule 4(2)(a), (3), (5)(a)
% =====================================================================
consent_manager_status(Profile, Result, Citations) :-
    dpdp_notice_consent_input_problems(Profile, Problems),
    consent_manager_checked(Problems, Profile, Result, Citations).

consent_manager_checked([Problem|Problems], _, input_problems([Problem|Problems]), []).
consent_manager_checked([], Profile, Result, Citations) :-
    key_state(Profile, section_6_9_in_force, InForce),
    consent_manager_in_force(InForce, Profile, Result, Citations).

consent_manager_in_force(absent, _, indeterminate([section_6_9_in_force]), []).
consent_manager_in_force(value(false), _, not_in_force, [cite(in_dpdp_act_2023_s_6_9)]) :-
    implements(in_dpdp_act_2023_s_6_9).
consent_manager_in_force(value(true), Profile, Result, Citations) :-
    implements(in_dpdp_act_2023_s_6_9),
    settled_t(Profile,
              [registered_with_board_as_consent_manager-false,
               consent_manager_registration_suspended_or_cancelled-true],
              Settled),
    consent_manager_settled(Settled, Profile, Result, Citations).

% Steps 3 and 4: not registered, or the registration suspended or cancelled.
consent_manager_settled(true,
                        _,
                        may_not_act_as_consent_manager,
                        [cite(in_dpdp_act_2023_s_2_g),
                         cite(in_dpdp_act_2023_s_6_9),
                         cite(in_dpdp_rules_2025_r_4_5_a)]) :-
    implements(in_dpdp_act_2023_s_2_g).
consent_manager_settled(false, Profile, Result, Citations) :-
    first_absent_key(Profile,
                     [registered_with_board_as_consent_manager,
                      consent_manager_registration_suspended_or_cancelled],
                     Absent),
    consent_manager_open(Absent, Result, Citations).

consent_manager_open(absent(KeyName), indeterminate([KeyName]), []).
consent_manager_open(none,
                     may_act_as_consent_manager,
                     [cite(in_dpdp_act_2023_s_2_g),
                      cite(in_dpdp_act_2023_s_6_7),
                      cite(in_dpdp_act_2023_s_6_8),
                      cite(in_dpdp_act_2023_s_6_9),
                      cite(in_dpdp_rules_2025_r_4_2_a),
                      cite(in_dpdp_rules_2025_r_4_3)]) :-
    implements(in_dpdp_rules_2025_r_4_2_a).

% =====================================================================
% (F) PROVISION_LISTS: fixed lists in the order of the text (reading (13))
% =====================================================================
provision_lists(notice_with_request,
                [content_item(personal_data_and_proposed_purpose, cite(in_dpdp_act_2023_s_5_1_i)),
                 content_item(manner_to_withdraw_consent_and_seek_grievance_redressal, cite(in_dpdp_act_2023_s_5_1_ii)),
                 content_item(manner_to_complain_to_board, cite(in_dpdp_act_2023_s_5_1_iii)),
                 content_item(option_of_english_or_eighth_schedule_language, cite(in_dpdp_act_2023_s_5_3))]) :-
    implements(in_dpdp_act_2023_s_5_1).
provision_lists(notice_for_earlier_consent,
                [content_item(personal_data_and_purpose_processed, cite(in_dpdp_act_2023_s_5_2_a_i)),
                 content_item(manner_to_withdraw_consent_and_seek_grievance_redressal, cite(in_dpdp_act_2023_s_5_2_a_ii)),
                 content_item(manner_to_complain_to_board, cite(in_dpdp_act_2023_s_5_2_a_iii)),
                 content_item(option_of_english_or_eighth_schedule_language, cite(in_dpdp_act_2023_s_5_3))]) :-
    implements(in_dpdp_act_2023_s_5_2_a).
provision_lists(rule_3_notice,
                [content_item(understandable_independently_of_other_information, cite(in_dpdp_rules_2025_r_3_a)),
                 content_item(fair_account_in_clear_and_plain_language, cite(in_dpdp_rules_2025_r_3_b)),
                 content_item(itemised_description_of_personal_data, cite(in_dpdp_rules_2025_r_3_b_i)),
                 content_item(specified_purposes_and_goods_services_or_uses, cite(in_dpdp_rules_2025_r_3_b_ii)),
                 content_item(link_and_means_to_withdraw_consent, cite(in_dpdp_rules_2025_r_3_c_i)),
                 content_item(link_and_means_to_exercise_rights, cite(in_dpdp_rules_2025_r_3_c_ii)),
                 content_item(link_and_means_to_complain_to_board, cite(in_dpdp_rules_2025_r_3_c_iii))]) :-
    implements(in_dpdp_rules_2025_r_3).
provision_lists(consent_request,
                [content_item(request_in_clear_and_plain_language, cite(in_dpdp_act_2023_s_6_3)),
                 content_item(option_of_english_or_eighth_schedule_language, cite(in_dpdp_act_2023_s_6_3)),
                 content_item(contact_of_data_protection_officer_or_authorised_person, cite(in_dpdp_act_2023_s_6_3))]) :-
    implements(in_dpdp_act_2023_s_6_3).
provision_lists(legitimate_uses,
                [content_item(voluntarily_provided_for_specified_purpose, cite(in_dpdp_act_2023_s_7_a)),
                 content_item(state_subsidy_benefit_service_certificate_licence_or_permit, cite(in_dpdp_act_2023_s_7_b)),
                 content_item(state_function_or_sovereignty_integrity_or_security, cite(in_dpdp_act_2023_s_7_c)),
                 content_item(legal_obligation_to_disclose_to_state, cite(in_dpdp_act_2023_s_7_d)),
                 content_item(compliance_with_judgment_decree_or_order, cite(in_dpdp_act_2023_s_7_e)),
                 content_item(medical_emergency, cite(in_dpdp_act_2023_s_7_f)),
                 content_item(epidemic_outbreak_or_public_health_threat, cite(in_dpdp_act_2023_s_7_g)),
                 content_item(disaster_or_breakdown_of_public_order, cite(in_dpdp_act_2023_s_7_h)),
                 content_item(employment_purposes, cite(in_dpdp_act_2023_s_7_i))]) :-
    implements(in_dpdp_act_2023_s_7).
provision_lists(state_use_standards,
                [content_item(lawful_manner, cite(in_dpdp_rules_2025_sch_2_a)),
                 content_item(for_specified_uses_or_purposes, cite(in_dpdp_rules_2025_sch_2_b)),
                 content_item(limited_to_necessary_personal_data, cite(in_dpdp_rules_2025_sch_2_c)),
                 content_item(completeness_accuracy_and_consistency, cite(in_dpdp_rules_2025_sch_2_d)),
                 content_item(retention_only_while_required, cite(in_dpdp_rules_2025_sch_2_e)),
                 content_item(reasonable_security_safeguards, cite(in_dpdp_rules_2025_sch_2_f)),
                 content_item(intimation_to_data_principal, cite(in_dpdp_rules_2025_sch_2_g)),
                 content_item(business_contact_for_questions, cite(in_dpdp_rules_2025_sch_2_g_i)),
                 content_item(link_and_means_to_exercise_rights, cite(in_dpdp_rules_2025_sch_2_g_ii)),
                 content_item(consistent_with_other_applicable_standards, cite(in_dpdp_rules_2025_sch_2_g_iii)),
                 content_item(accountability_for_observance, cite(in_dpdp_rules_2025_sch_2_h))]) :-
    implements(in_dpdp_rules_2025_r_5_1).
provision_lists(consent_manager_conditions,
                [content_item(company_incorporated_in_india, cite(in_dpdp_rules_2025_sch_1_parta_1)),
                 content_item(sufficient_technical_operational_and_financial_capacity, cite(in_dpdp_rules_2025_sch_1_parta_2)),
                 content_item(sound_financial_condition_and_management, cite(in_dpdp_rules_2025_sch_1_parta_3)),
                 content_item(net_worth_not_less_than_two_crore_rupees, cite(in_dpdp_rules_2025_sch_1_parta_4)),
                 content_item(adequate_business_volume_capital_structure_and_earning_prospects, cite(in_dpdp_rules_2025_sch_1_parta_5)),
                 content_item(directors_and_management_of_fairness_and_integrity, cite(in_dpdp_rules_2025_sch_1_parta_6)),
                 content_item(articles_require_conflict_of_interest_obligations, cite(in_dpdp_rules_2025_sch_1_parta_7)),
                 content_item(operations_in_interests_of_data_principals, cite(in_dpdp_rules_2025_sch_1_parta_8)),
                 content_item(platform_certified_consistent_with_board_standards, cite(in_dpdp_rules_2025_sch_1_parta_9_a)),
                 content_item(measures_certified_for_standards_and_publication_obligations, cite(in_dpdp_rules_2025_sch_1_parta_9_b))]) :-
    implements(in_dpdp_rules_2025_r_4_2_a).
provision_lists(consent_manager_obligations,
                [content_item(enable_consent_directly_or_through_another_fiduciary, cite(in_dpdp_rules_2025_sch_1_partb_1)),
                 content_item(contents_not_readable_by_consent_manager, cite(in_dpdp_rules_2025_sch_1_partb_2)),
                 content_item(record_of_consents_given_denied_or_withdrawn, cite(in_dpdp_rules_2025_sch_1_partb_3_a)),
                 content_item(record_of_notices_preceding_or_accompanying_requests, cite(in_dpdp_rules_2025_sch_1_partb_3_b)),
                 content_item(record_of_sharing_with_transferee_fiduciary, cite(in_dpdp_rules_2025_sch_1_partb_3_c)),
                 content_item(give_data_principal_access_to_record, cite(in_dpdp_rules_2025_sch_1_partb_4_a)),
                 content_item(record_information_in_machine_readable_form_on_request, cite(in_dpdp_rules_2025_sch_1_partb_4_b)),
                 content_item(keep_record_at_least_seven_years, cite(in_dpdp_rules_2025_sch_1_partb_4_c)),
                 content_item(website_or_app_as_primary_means, cite(in_dpdp_rules_2025_sch_1_partb_5)),
                 content_item(no_sub_contracting_or_assignment, cite(in_dpdp_rules_2025_sch_1_partb_6)),
                 content_item(reasonable_security_safeguards, cite(in_dpdp_rules_2025_sch_1_partb_7)),
                 content_item(act_in_fiduciary_capacity, cite(in_dpdp_rules_2025_sch_1_partb_8)),
                 content_item(avoid_conflict_of_interest_with_fiduciaries, cite(in_dpdp_rules_2025_sch_1_partb_9)),
                 content_item(measures_against_conflict_of_interest_of_management, cite(in_dpdp_rules_2025_sch_1_partb_10)),
                 content_item(publish_promoters_directors_and_management, cite(in_dpdp_rules_2025_sch_1_partb_11_a)),
                 content_item(publish_shareholders_above_two_per_cent, cite(in_dpdp_rules_2025_sch_1_partb_11_b)),
                 content_item(publish_bodies_corporate_where_management_holds_above_two_per_cent, cite(in_dpdp_rules_2025_sch_1_partb_11_c)),
                 content_item(publish_other_information_board_directs, cite(in_dpdp_rules_2025_sch_1_partb_11_d)),
                 content_item(audit_technical_and_organisational_controls, cite(in_dpdp_rules_2025_sch_1_partb_12_a)),
                 content_item(audit_continued_fulfilment_of_conditions, cite(in_dpdp_rules_2025_sch_1_partb_12_b)),
                 content_item(audit_adherence_to_obligations, cite(in_dpdp_rules_2025_sch_1_partb_12_c)),
                 content_item(no_transfer_of_control_without_board_approval, cite(in_dpdp_rules_2025_sch_1_partb_13))]) :-
    implements(in_dpdp_rules_2025_r_4_3).

% =====================================================================
% FACADE: verdict (eligible / ineligible / indeterminate) mapped from
% consent_ground, its status projection and its cited checklist.
% =====================================================================
decide_dpdp_notice_consent(Profile, dpdp_notice_consent_verdict(Status, Citations)) :-
    consent_ground(Profile, Result, GroundCitations),
    verdict_status(Result, GroundCitations, Status, Citations).

verdict_status(lawful_on_consent, Citations, eligible, Citations).
verdict_status(not_lawful_on_consent, Citations, ineligible, Citations).
verdict_status(not_in_force, Citations, ineligible, Citations).
verdict_status(indeterminate(_), _, indeterminate, []).
verdict_status(needs_legal_review(_, _), _, indeterminate, []).
verdict_status(input_problems(_), _, indeterminate, []).

dpdp_notice_consent_status(Profile, Status) :-
    decide_dpdp_notice_consent(Profile, dpdp_notice_consent_verdict(Status, _Citations)).

% The checklist: one item(RequirementId, Status, cite(Key)) row per condition
% of the consent ground; Status met, unmet(KeyName) or unknown([KeyName]).
dpdp_notice_consent_checklist(Profile, Items) :-
    dpdp_notice_consent_input_problems(Profile, Problems),
    checklist_checked(Problems, Profile, Items).

checklist_checked([Problem|Problems],
                  _,
                  [item(well_formed_profile,
                        unmet(input_problems([Problem|Problems])),
                        cite(in_dpdp_act_2023_s_4_1))]).
checklist_checked([], Profile, Items) :-
    maplist(checklist_row(Profile),
            [sections_4_to_7_in_force,
             lawful_purpose,
             consent_given,
             consent_not_withdrawn,
             consent_meets_section_6_1],
            Items).

checklist_row(Profile,
              sections_4_to_7_in_force,
              item(sections_4_to_7_in_force, Status, cite(in_dpdp_act_2023_s_4_1))) :-
    implements(in_dpdp_act_2023_s_4_1),
    wanted_value_status(Profile, sections_4_to_7_in_force, true, Status).
checklist_row(Profile,
              lawful_purpose,
              item(lawful_purpose, Status, cite(in_dpdp_act_2023_s_4_2))) :-
    implements(in_dpdp_act_2023_s_4_2),
    wanted_value_status(Profile, lawful_purpose, true, Status).
checklist_row(Profile,
              consent_given,
              item(consent_given, Status, cite(in_dpdp_act_2023_s_4_1_a))) :-
    implements(in_dpdp_act_2023_s_4_1_a),
    wanted_value_status(Profile, consent_given, true, Status).
checklist_row(Profile,
              consent_not_withdrawn,
              item(consent_not_withdrawn, Status, cite(in_dpdp_act_2023_s_6_4))) :-
    implements(in_dpdp_act_2023_s_6_4),
    wanted_value_status(Profile, consent_withdrawn, false, Status).
checklist_row(Profile,
              consent_meets_section_6_1,
              item(consent_meets_section_6_1, Status, cite(in_dpdp_act_2023_s_6_1))) :-
    implements(in_dpdp_act_2023_s_6_1),
    wanted_value_status(Profile, consent_meets_section_6_1, true, Status).

wanted_value_status(Profile, KeyName, Wanted, Status) :-
    key_state(Profile, KeyName, State),
    state_status(State, KeyName, Wanted, Status).

state_status(absent, KeyName, _, unknown([KeyName])).
state_status(value(Value), _, Wanted, met) :-
    Value == Wanted.
state_status(value(Value), KeyName, Wanted, unknown([KeyName])) :-
    Value \== Wanted,
    Value == unsure.
state_status(value(Value), KeyName, Wanted, unmet(KeyName)) :-
    Value \== Wanted,
    Value \== unsure.

dpdp_notice_consent_decision_resolvable(Profile) :-
    decide_dpdp_notice_consent(Profile, _Verdict).

% =====================================================================
% TESTS
% =====================================================================
full_consent_profile([attribute(sections_4_to_7_in_force, true),
                      attribute(lawful_purpose, true),
                      attribute(consent_given, true),
                      attribute(consent_withdrawn, false),
                      attribute(consent_meets_section_6_1, true)]).

test(consent_ground_lawful_once) :-
    full_consent_profile(Profile),
    findall(Result-Citations, consent_ground(Profile, Result, Citations), Answers),
    Answers == [lawful_on_consent-[cite(in_dpdp_act_2023_s_4_1),
                                   cite(in_dpdp_act_2023_s_4_1_a),
                                   cite(in_dpdp_act_2023_s_6_1)]].
test(consent_ground_lawful_is_not_refused, fail) :-
    full_consent_profile(Profile),
    consent_ground(Profile, not_lawful_on_consent, _).
test(consent_ground_false_judgement_settles_with_keys_absent) :-
    findall(Result,
            consent_ground([attribute(sections_4_to_7_in_force, true),
                            attribute(consent_meets_section_6_1, false)],
                           Result,
                           _),
            Answers),
    Answers == [not_lawful_on_consent].
test(consent_ground_names_first_missing_key) :-
    consent_ground([attribute(sections_4_to_7_in_force, true),
                    attribute(consent_given, true)],
                   indeterminate([lawful_purpose]),
                   []).
test(consent_ground_missing_in_force_first) :-
    consent_ground([], indeterminate([sections_4_to_7_in_force]), []).
test(consent_ground_not_in_force) :-
    consent_ground([attribute(sections_4_to_7_in_force, false)],
                   not_in_force,
                   [cite(in_dpdp_act_2023_s_4_1)]).
test(consent_ground_refers_unsure_lawful_purpose) :-
    consent_ground([attribute(sections_4_to_7_in_force, true),
                    attribute(lawful_purpose, unsure),
                    attribute(consent_given, true),
                    attribute(consent_withdrawn, false),
                    attribute(consent_meets_section_6_1, true)],
                   Result,
                   Citations),
    Result == needs_legal_review(open_textured(lawful_purpose,
                                               cite(in_dpdp_act_2023_s_4_2)),
                                 [inputs_relied_on([lawful_purpose-unsure,
                                                    consent_meets_section_6_1-true])]),
    Citations == [].
test(consent_ground_missing_before_referral) :-
    consent_ground([attribute(sections_4_to_7_in_force, true),
                    attribute(lawful_purpose, unsure),
                    attribute(consent_given, true)],
                   indeterminate([consent_withdrawn]),
                   []).
test(consent_ground_reports_input_problems) :-
    consent_ground([attribute(consent_given, unsure)],
                   input_problems([wrong_type(consent_given)]),
                   []).

test(legitimate_use_cites_named_clause) :-
    findall(Result-Citations,
            legitimate_use_ground([attribute(sections_4_to_7_in_force, true),
                                   attribute(lawful_purpose, true),
                                   attribute(legitimate_use_clause, medical_emergency),
                                   attribute(legitimate_use_conditions_met, true)],
                                  Result,
                                  Citations),
            Answers),
    Answers == [lawful_on_legitimate_use-[cite(in_dpdp_act_2023_s_4_1_b),
                                          cite(in_dpdp_act_2023_s_7),
                                          cite(in_dpdp_act_2023_s_7_f)]].
test(legitimate_use_false_conditions_settle_without_clause) :-
    legitimate_use_ground([attribute(sections_4_to_7_in_force, true),
                           attribute(legitimate_use_conditions_met, false)],
                          not_lawful_on_legitimate_use,
                          _).
test(legitimate_use_no_listed_use) :-
    legitimate_use_ground([attribute(sections_4_to_7_in_force, true),
                           attribute(legitimate_use_clause, no_listed_use)],
                          not_lawful_on_legitimate_use,
                          _).
test(legitimate_use_no_listed_use_is_not_lawful, fail) :-
    legitimate_use_ground([attribute(sections_4_to_7_in_force, true),
                           attribute(legitimate_use_clause, no_listed_use)],
                          lawful_on_legitimate_use,
                          _).
test(legitimate_use_refers_unsure_conditions) :-
    legitimate_use_ground([attribute(sections_4_to_7_in_force, true),
                           attribute(lawful_purpose, true),
                           attribute(legitimate_use_clause, employment_purposes),
                           attribute(legitimate_use_conditions_met, unsure)],
                          needs_legal_review(open_textured(legitimate_use_conditions_met,
                                                           cite(in_dpdp_act_2023_s_7)),
                                             [inputs_relied_on([lawful_purpose-true,
                                                                legitimate_use_conditions_met-unsure])]),
                          []).

test(notice_request_day_before_rule_3) :-
    findall(Result,
            consent_notice([attribute(sections_4_to_7_in_force, true),
                            attribute(acts_as_data_fiduciary, true),
                            attribute(notice_occasion, request_for_consent),
                            attribute(question_date, date(2027, 5, 12))],
                           Result,
                           _),
            Answers),
    Answers == [notice_with_request_required_before_rule_3].
test(notice_request_on_rule_3_day) :-
    consent_notice([attribute(sections_4_to_7_in_force, true),
                    attribute(acts_as_data_fiduciary, true),
                    attribute(notice_occasion, request_for_consent),
                    attribute(question_date, date(2027, 5, 13))],
                   notice_with_request_required,
                   [cite(in_dpdp_act_2023_s_5_1),
                    cite(in_dpdp_act_2023_s_5_3),
                    cite(in_dpdp_rules_2025_r_3)]).
test(notice_earlier_consent_after_rule_3) :-
    consent_notice([attribute(sections_4_to_7_in_force, true),
                    attribute(acts_as_data_fiduciary, true),
                    attribute(notice_occasion, consent_given_before_commencement),
                    attribute(question_date, date(2027, 6, 1))],
                   notice_for_earlier_consent_required,
                   _).
test(notice_not_required_for_processor) :-
    consent_notice([attribute(sections_4_to_7_in_force, true),
                    attribute(acts_as_data_fiduciary, false)],
                   not_required,
                   _).
test(notice_unsure_fiduciary_names_date_first) :-
    consent_notice([attribute(sections_4_to_7_in_force, true),
                    attribute(acts_as_data_fiduciary, unsure),
                    attribute(notice_occasion, request_for_consent)],
                   indeterminate([question_date]),
                   []).
test(notice_unsure_fiduciary_referred) :-
    consent_notice([attribute(sections_4_to_7_in_force, true),
                    attribute(acts_as_data_fiduciary, unsure),
                    attribute(notice_occasion, request_for_consent),
                    attribute(question_date, date(2027, 6, 1))],
                   needs_legal_review(open_textured(acts_as_data_fiduciary,
                                                    cite(in_dpdp_act_2023_s_2_i)),
                                      [inputs_relied_on([acts_as_data_fiduciary-unsure])]),
                   []).

test(withdrawal_none_needs_no_cessation) :-
    withdrawal_effect([attribute(sections_4_to_7_in_force, true),
                       attribute(consent_withdrawn, false)],
                      not_required,
                      _).
test(withdrawal_cease_required) :-
    findall(Result,
            withdrawal_effect([attribute(sections_4_to_7_in_force, true),
                               attribute(acts_as_data_fiduciary, true),
                               attribute(consent_withdrawn, true),
                               attribute(processing_required_or_authorised_by_law, false)],
                              Result,
                              _),
            Answers),
    Answers == [cease_processing_required].
test(withdrawal_processing_may_continue) :-
    withdrawal_effect([attribute(sections_4_to_7_in_force, true),
                       attribute(acts_as_data_fiduciary, true),
                       attribute(consent_withdrawn, true),
                       attribute(processing_required_or_authorised_by_law, true)],
                      processing_may_continue_without_consent,
                      [cite(in_dpdp_act_2023_s_6_6)]).
test(withdrawal_refers_unsure_law) :-
    withdrawal_effect([attribute(sections_4_to_7_in_force, true),
                       attribute(acts_as_data_fiduciary, true),
                       attribute(consent_withdrawn, true),
                       attribute(processing_required_or_authorised_by_law, unsure)],
                      needs_legal_review(open_textured(processing_required_or_authorised_by_law,
                                                       cite(in_dpdp_act_2023_s_6_6)),
                                         [inputs_relied_on([acts_as_data_fiduciary-true,
                                                            processing_required_or_authorised_by_law-unsure])]),
                      []).

test(manager_suspended_settles_without_registration_key) :-
    consent_manager_status([attribute(section_6_9_in_force, true),
                            attribute(consent_manager_registration_suspended_or_cancelled, true)],
                           may_not_act_as_consent_manager,
                           _).
test(manager_registered_may_act) :-
    findall(Result,
            consent_manager_status([attribute(section_6_9_in_force, true),
                                    attribute(registered_with_board_as_consent_manager, true),
                                    attribute(consent_manager_registration_suspended_or_cancelled, false)],
                                   Result,
                                   _),
            Answers),
    Answers == [may_act_as_consent_manager].
test(manager_reads_its_own_in_force_key) :-
    consent_manager_status([attribute(sections_4_to_7_in_force, true)],
                           indeterminate([section_6_9_in_force]),
                           []).

test(legitimate_uses_list_has_nine_items_once) :-
    findall(Items, provision_lists(legitimate_uses, Items), Answers),
    Answers = [Items],
    length(Items, 9).
test(obligations_list_has_twenty_two_items) :-
    provision_lists(consent_manager_obligations, Items),
    length(Items, 22).
test(standards_list_has_eleven_items) :-
    provision_lists(state_use_standards, Items),
    length(Items, 11).

test(facade_eligible_on_consent) :-
    full_consent_profile(Profile),
    dpdp_notice_consent_status(Profile, eligible).
test(facade_indeterminate_on_missing_key) :-
    dpdp_notice_consent_status([], indeterminate).
test(checklist_rows_are_cited) :-
    full_consent_profile(Profile),
    dpdp_notice_consent_checklist(Profile, Items),
    length(Items, 5),
    member(item(consent_not_withdrawn, met, cite(in_dpdp_act_2023_s_6_4)), Items).

:- end_module(dpdp_notice_consent).
