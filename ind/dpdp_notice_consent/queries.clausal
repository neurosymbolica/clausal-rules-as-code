    no_sub_contracting_or_assignment/0,
    act_in_fiduciary_capacity/0,
    avoid_conflict_of_interest_with_fiduciaries/0,
    measures_against_conflict_of_interest_of_management/0,
    publish_promoters_directors_and_management/0,
    publish_shareholders_above_two_per_cent/0,
    publish_bodies_corporate_where_management_holds_above_two_per_cent/0,
