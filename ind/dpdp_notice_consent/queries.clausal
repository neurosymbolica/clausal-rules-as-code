    audit_adherence_to_obligations/0,
    no_transfer_of_control_without_board_approval/0,
    lawful_on_consent/0,
    not_lawful_on_consent/0,
    not_in_force/0,
    lawful_on_legitimate_use/0,
    not_lawful_on_legitimate_use/0,
    notice_with_request_required/0,
    notice_with_request_required_before_rule_3/0,
    notice_for_earlier_consent_required/0,
    notice_for_earlier_consent_required_before_rule_3/0,
    not_required/0,
    cease_processing_required/0,
    processing_may_continue_without_consent/0,
    may_act_as_consent_manager/0,
    may_not_act_as_consent_manager/0,
    indeterminate/1,
    needs_legal_review/2,
    open_textured/2,
    inputs_relied_on/1,
    content_item/2,
    input_problems/1,
    unknown_key/1,
    wrong_type/1,
    duplicate_key/1,
    date/3
]).

:- use_module(ind/dpdp_notice_consent/kernel, [dpdp_notice_consent_input_problems/2]).
:- use_module(ind/dpdp_notice_consent/citations, [citation/2]).
:- use_module(ind/dpdp_notice_consent/dpdp_notice_consent, [dpdp_notice_consent_status/2]).

% The result constructors: data, never called as queries, no clauses.
:- constructors([
    indeterminate(missing_keys),
    needs_legal_review(reason, context),
    open_textured(input, citation),
    inputs_relied_on(pairs),
    content_item(name, citation),
    input_problems(problems),
    unknown_key(key),
    wrong_type(key),
    duplicate_key(key)
]).

% date/3: the input date form of question_date, date(Year, Month, Day) with
% three integers. Data shape only; the input check tests the calendar day.
date(Year, Month, Day) :-
    integer(Year),
    integer(Month),
    integer(Day).

% The keys of the order's typed input contract, in its order.
dpdp_notice_consent_profile_keys([
    sections_4_to_7_in_force,
    section_6_9_in_force,
    question_date,
    acts_as_data_fiduciary,
    lawful_purpose,
    consent_given,
    consent_withdrawn,
    consent_meets_section_6_1,
    legitimate_use_clause,
    legitimate_use_conditions_met,
    notice_occasion,
    processing_required_or_authorised_by_law,
    registered_with_board_as_consent_manager,
    consent_manager_registration_suspended_or_cancelled
]).

% #16 what-if: re-evaluate the facade status with one key hypothetically
% overridden. The hypothesis goes through the same input check and ladder.
dpdp_notice_consent_what_if(Profile, OverriddenKey, NewValue, NewStatus) :-
    override_attribute(Profile, OverriddenKey, NewValue, Hypothesis),
    dpdp_notice_consent_status(Hypothesis, NewStatus).

% override_attribute(Attributes, Key, Value, Hypothesis): every
% attribute(Key, _) is dropped and attribute(Key, Value) is added at the end;
% the other attributes keep their order. Profile plumbing, no marker.
override_attribute([], Key, Value, [attribute(Key, Value)]).
override_attribute([attribute(ElementKey, ElementValue)|Elements],
                   Key,
                   Value,
                   [attribute(ElementKey, ElementValue)|Hypothesis]) :-
    ElementKey \== Key,
    override_attribute(Elements, Key, Value, Hypothesis).
override_attribute([attribute(ElementKey, _)|Elements], Key, Value, Hypothesis) :-
    ElementKey == Key,
    override_attribute(Elements, Key, Value, Hypothesis).

% provenance(CitationKey, PinnedUnit): the pinned unit a recorded citation
% key cites. One solution for a recorded key (its record holds one ref
% pair); none for a key the citations module does not record.
provenance(CitationKey, PinnedUnit) :-
    citation(CitationKey, Pairs),
    member(ref-PinnedUnit, Pairs).

