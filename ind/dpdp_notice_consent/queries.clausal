    compliance_with_judgment_decree_or_order/0,
    medical_emergency/0,
    epidemic_outbreak_or_public_health_threat/0,
    disaster_or_breakdown_of_public_order/0,
    employment_purposes/0,
    no_listed_use/0,
    request_for_consent/0,
    consent_given_before_commencement/0,
    no_notice_occasion/0,
    notice_with_request/0,
    notice_for_earlier_consent/0,
    rule_3_notice/0,
    consent_request/0,
    legitimate_uses/0,
    state_use_standards/0,
    consent_manager_conditions/0,
    consent_manager_obligations/0,
    personal_data_and_proposed_purpose/0,
    manner_to_withdraw_consent_and_seek_grievance_redressal/0,
    manner_to_complain_to_board/0,
    option_of_english_or_eighth_schedule_language/0,
    personal_data_and_purpose_processed/0,
    understandable_independently_of_other_information/0,
    fair_account_in_clear_and_plain_language/0,
    itemised_description_of_personal_data/0,
    specified_purposes_and_goods_services_or_uses/0,
    link_and_means_to_withdraw_consent/0,
    link_and_means_to_exercise_rights/0,
    link_and_means_to_complain_to_board/0,
    request_in_clear_and_plain_language/0,
    contact_of_data_protection_officer_or_authorised_person/0,
    lawful_manner/0,
