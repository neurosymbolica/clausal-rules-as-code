% ---- Rules, First Schedule Part B: obligations of Consent Managers ---------
citation(in_dpdp_rules_2025_sch_1_partb_1, [
    label-'Digital Personal Data Protection Rules 2025 First Schedule Part B item 1 enabling consent through the platform',
    ref-'in-dpdp-rules-2025-meity-pdf#sch1_partB_1',
    verbatim-'The Consent Manager shall enable a Data Principal using its platform to give consent to the processing of her personal data by a Data Fiduciary onboarded onto such platform'
]).
citation(in_dpdp_rules_2025_sch_1_partb_2, [
    label-'Digital Personal Data Protection Rules 2025 First Schedule Part B item 2 contents not readable by the Consent Manager',
    ref-'in-dpdp-rules-2025-meity-pdf#sch1_partB_2',
    verbatim-'The Consent Manager shall ensure that the manner of making available the personal data or its sharing is such that the contents thereof are not readable by it'
]).
citation(in_dpdp_rules_2025_sch_1_partb_3_a, [
    label-'Digital Personal Data Protection Rules 2025 First Schedule Part B item 3(a) record of consents given, denied or withdrawn',
