test(every_vocabulary_key_is_recorded) :-
    citation_vocabulary(Keys),
    maplist(implements, Keys).
% (b) THE TEST IS WRONG: the order's citation vocabulary has 89 keys (Act 34 + Rules 55); the list matches it.
test(the_vocabulary_has_eighty_nine_keys) :-
    citation_vocabulary(Keys),
    length(Keys, 89).
test(an_unrecorded_key_does_not_implement, fail) :-
    implements(ind_todo_primary_source).

:- end_module(citations).
