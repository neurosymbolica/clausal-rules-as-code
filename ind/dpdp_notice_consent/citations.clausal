% ---- Act, section 2: definitions ------------------------------------
citation(in_dpdp_act_2023_s_2_d, [
    label-'Digital Personal Data Protection Act 2023 s 2(d) definition of certain legitimate uses',
    ref-'in-dpdp-act-2023-meity-pdf#s2_d',
    verbatim-'means the uses referred to in section 7'
]).
citation(in_dpdp_act_2023_s_2_g, [
    label-'Digital Personal Data Protection Act 2023 s 2(g) definition of Consent Manager',
    ref-'in-dpdp-act-2023-meity-pdf#s2_g',
    verbatim-'a person registered with the Board, who acts as a single point of contact to enable a Data Principal to give, manage, review and withdraw her consent through an accessible, transparent and interoperable platform'
]).
citation(in_dpdp_act_2023_s_2_i, [
    label-'Digital Personal Data Protection Act 2023 s 2(i) definition of Data Fiduciary',
    ref-'in-dpdp-act-2023-meity-pdf#s2_i',
    verbatim-'any person who alone or in conjunction with other persons determines the purpose and means of processing of personal data'
]).

% ---- Act, section 4: grounds for processing ---------------------------
citation(in_dpdp_act_2023_s_4_1, [
    label-'Digital Personal Data Protection Act 2023 s 4(1) processing only in accordance with the Act and for a lawful purpose',
    ref-'in-dpdp-act-2023-meity-pdf#s4_1',
    verbatim-'A person may process the personal data of a Data Principal only in accordance with the provisions of this Act and for a lawful purpose'
]).
citation(in_dpdp_act_2023_s_4_1_a, [
    label-'Digital Personal Data Protection Act 2023 s 4(1)(a) ground of consent',
    ref-'in-dpdp-act-2023-meity-pdf#s4_1_a',
    verbatim-'for which the Data Principal has given her consent'
]).
citation(in_dpdp_act_2023_s_4_1_b, [
    label-'Digital Personal Data Protection Act 2023 s 4(1)(b) ground of certain legitimate uses',
    ref-'in-dpdp-act-2023-meity-pdf#s4_1_b',
    verbatim-'for certain legitimate uses'
]).
citation(in_dpdp_act_2023_s_4_2, [
    label-'Digital Personal Data Protection Act 2023 s 4(2) definition of lawful purpose',
    ref-'in-dpdp-act-2023-meity-pdf#s4_2',
    verbatim-'means any purpose which is not expressly forbidden by law'
]).

% ---- Act, section 5: notice -------------------------------------------
citation(in_dpdp_act_2023_s_5_1, [
    label-'Digital Personal Data Protection Act 2023 s 5(1) notice accompanying or preceding a request for consent',
    ref-'in-dpdp-act-2023-meity-pdf#s5_1',
    verbatim-'Every request made to a Data Principal under section 6 for consent shall be accompanied or preceded by a notice given by the Data Fiduciary to the Data Principal'
]).
citation(in_dpdp_act_2023_s_5_1_i, [
    label-'Digital Personal Data Protection Act 2023 s 5(1)(i) notice content: personal data and proposed purpose',
    ref-'in-dpdp-act-2023-meity-pdf#s5_1_i',
    verbatim-'the personal data and the purpose for which the same is proposed to be processed'
]).
citation(in_dpdp_act_2023_s_5_1_ii, [
    label-'Digital Personal Data Protection Act 2023 s 5(1)(ii) notice content: manner of exercising rights under s 6(4) and s 13',
    ref-'in-dpdp-act-2023-meity-pdf#s5_1_ii',
    verbatim-'the manner in which she may exercise her rights under sub-section (4) of section 6 and section 13'
]).
citation(in_dpdp_act_2023_s_5_1_iii, [
    label-'Digital Personal Data Protection Act 2023 s 5(1)(iii) notice content: manner of complaint to the Board',
    ref-'in-dpdp-act-2023-meity-pdf#s5_1_iii',
    verbatim-'the manner in which the Data Principal may make a complaint to the Board'
]).
citation(in_dpdp_act_2023_s_5_2, [
    label-'Digital Personal Data Protection Act 2023 s 5(2) consent given before commencement',
    ref-'in-dpdp-act-2023-meity-pdf#s5_2',
    verbatim-'Where a Data Principal has given her consent for the processing of her personal data before the date of commencement of this Act'
]).
citation(in_dpdp_act_2023_s_5_2_a, [
    label-'Digital Personal Data Protection Act 2023 s 5(2)(a) notice for a consent given before commencement',
    ref-'in-dpdp-act-2023-meity-pdf#s5_2_a',
    verbatim-'the Data Fiduciary shall, as soon as it is reasonably practicable, give to the Data Principal a notice informing her'
]).
citation(in_dpdp_act_2023_s_5_2_a_i, [
    label-'Digital Personal Data Protection Act 2023 s 5(2)(a)(i) notice content: personal data and purpose processed',
    ref-'in-dpdp-act-2023-meity-pdf#s5_2_a_i',
    verbatim-'the personal data and the purpose for which the same has been processed'
]).
citation(in_dpdp_act_2023_s_5_2_a_ii, [
    label-'Digital Personal Data Protection Act 2023 s 5(2)(a)(ii) notice content: manner of exercising rights under s 6(4) and s 13',
    ref-'in-dpdp-act-2023-meity-pdf#s5_2_a_ii',
    verbatim-'the manner in which she may exercise her rights under sub-section (4) of section 6 and section 13'
]).
citation(in_dpdp_act_2023_s_5_2_a_iii, [
    label-'Digital Personal Data Protection Act 2023 s 5(2)(a)(iii) notice content: manner of complaint to the Board',
    ref-'in-dpdp-act-2023-meity-pdf#s5_2_a_iii',
    verbatim-'the manner in which the Data Principal may make a complaint to the Board'
]).
citation(in_dpdp_act_2023_s_5_2_b, [
    label-'Digital Personal Data Protection Act 2023 s 5(2)(b) continued processing on a consent given before commencement',
    ref-'in-dpdp-act-2023-meity-pdf#s5_2_b',
    verbatim-'the Data Fiduciary may continue to process the personal data until and unless the Data Principal withdraws her consent'
]).
citation(in_dpdp_act_2023_s_5_3, [
    label-'Digital Personal Data Protection Act 2023 s 5(3) option of English or an Eighth Schedule language for the notice',
    ref-'in-dpdp-act-2023-meity-pdf#s5_3',
    verbatim-'The Data Fiduciary shall give the Data Principal the option to access the contents of the notice referred to in sub-sections (1) and (2) in English or any language specified in the Eighth Schedule to the Constitution'
]).

% ---- Act, section 6: consent ------------------------------------------
citation(in_dpdp_act_2023_s_6_1, [
    label-'Digital Personal Data Protection Act 2023 s 6(1) qualities and limits of consent',
    ref-'in-dpdp-act-2023-meity-pdf#s6_1',
    verbatim-'The consent given by the Data Principal shall be free, specific, informed, unconditional and unambiguous with a clear affirmative action'
]).
citation(in_dpdp_act_2023_s_6_3, [
    label-'Digital Personal Data Protection Act 2023 s 6(3) presentation of a request for consent',
    ref-'in-dpdp-act-2023-meity-pdf#s6_3',
    verbatim-'Every request for consent under the provisions of this Act or the rules made thereunder shall be presented to the Data Principal in a clear and plain language'
]).
citation(in_dpdp_act_2023_s_6_4, [
    label-'Digital Personal Data Protection Act 2023 s 6(4) right to withdraw consent',
    ref-'in-dpdp-act-2023-meity-pdf#s6_4',
    verbatim-'such Data Principal shall have the right to withdraw her consent at any time'
]).
citation(in_dpdp_act_2023_s_6_5, [
    label-'Digital Personal Data Protection Act 2023 s 6(5) consequences of withdrawal and earlier processing',
    ref-'in-dpdp-act-2023-meity-pdf#s6_5',
    verbatim-'such withdrawal shall not affect the legality of processing of the personal data based on consent before its withdrawal'
]).
citation(in_dpdp_act_2023_s_6_6, [
    label-'Digital Personal Data Protection Act 2023 s 6(6) cessation of processing after withdrawal',
    ref-'in-dpdp-act-2023-meity-pdf#s6_6',
    verbatim-'the Data Fiduciary shall, within a reasonable time, cease and cause its Data Processors to cease processing the personal data of such Data Principal'
]).
citation(in_dpdp_act_2023_s_6_7, [
    label-'Digital Personal Data Protection Act 2023 s 6(7) consent through a Consent Manager',
    ref-'in-dpdp-act-2023-meity-pdf#s6_7',
    verbatim-'The Data Principal may give, manage, review or withdraw her consent to the Data Fiduciary through a Consent Manager'
]).
citation(in_dpdp_act_2023_s_6_8, [
    label-'Digital Personal Data Protection Act 2023 s 6(8) accountability of the Consent Manager',
    ref-'in-dpdp-act-2023-meity-pdf#s6_8',
    verbatim-'The Consent Manager shall be accountable to the Data Principal and shall act on her behalf'
]).
citation(in_dpdp_act_2023_s_6_9, [
    label-'Digital Personal Data Protection Act 2023 s 6(9) registration of Consent Managers with the Board',
    ref-'in-dpdp-act-2023-meity-pdf#s6_9',
    verbatim-'Every Consent Manager shall be registered with the Board'
]).

% ---- Act, section 7: certain legitimate uses ---------------------------
citation(in_dpdp_act_2023_s_7, [
    label-'Digital Personal Data Protection Act 2023 s 7 certain legitimate uses (lead-in, closed list)',
    ref-'in-dpdp-act-2023-meity-pdf#s7',
    verbatim-'A Data Fiduciary may process personal data of a Data Principal for any of following uses'
]).
citation(in_dpdp_act_2023_s_7_a, [
    label-'Digital Personal Data Protection Act 2023 s 7(a) personal data voluntarily provided for the specified purpose',
    ref-'in-dpdp-act-2023-meity-pdf#s7_a',
    verbatim-'for the specified purpose for which the Data Principal has voluntarily provided her personal data to the Data Fiduciary'
]).
citation(in_dpdp_act_2023_s_7_b, [
    label-'Digital Personal Data Protection Act 2023 s 7(b) State subsidy, benefit, service, certificate, licence or permit',
    ref-'in-dpdp-act-2023-meity-pdf#s7_b',
    verbatim-'for the State and any of its instrumentalities to provide or issue to the Data Principal such subsidy, benefit, service, certificate, licence or permit as may be prescribed'
]).
citation(in_dpdp_act_2023_s_7_c, [
    label-'Digital Personal Data Protection Act 2023 s 7(c) State functions, sovereignty and integrity, security of the State',
    ref-'in-dpdp-act-2023-meity-pdf#s7_c',
    verbatim-'for the performance by the State or any of its instrumentalities of any function under any law for the time being in force in India'
]).
citation(in_dpdp_act_2023_s_7_d, [
    label-'Digital Personal Data Protection Act 2023 s 7(d) legal obligation to disclose information to the State',
    ref-'in-dpdp-act-2023-meity-pdf#s7_d',
    verbatim-'for fulfilling any obligation under any law for the time being in force in India on any person to disclose any information to the State or any of its instrumentalities'
]).
citation(in_dpdp_act_2023_s_7_e, [
    label-'Digital Personal Data Protection Act 2023 s 7(e) compliance with a judgment, decree or order',
    ref-'in-dpdp-act-2023-meity-pdf#s7_e',
    verbatim-'for compliance with any judgment or decree or order issued under any law for the time being in force in India'
]).
citation(in_dpdp_act_2023_s_7_f, [
    label-'Digital Personal Data Protection Act 2023 s 7(f) medical emergency',
    ref-'in-dpdp-act-2023-meity-pdf#s7_f',
    verbatim-'for responding to a medical emergency involving a threat to the life or immediate threat to the health of the Data Principal or any other individual'
]).
citation(in_dpdp_act_2023_s_7_g, [
    label-'Digital Personal Data Protection Act 2023 s 7(g) epidemic, outbreak of disease or threat to public health',
    ref-'in-dpdp-act-2023-meity-pdf#s7_g',
    verbatim-'for taking measures to provide medical treatment or health services to any individual during an epidemic, outbreak of disease, or any other threat to public health'
]).
citation(in_dpdp_act_2023_s_7_h, [
    label-'Digital Personal Data Protection Act 2023 s 7(h) disaster or breakdown of public order, with its Explanation',
    ref-'in-dpdp-act-2023-meity-pdf#s7_h',
    verbatim-'for taking measures to ensure safety of, or provide assistance or services to, any individual during any disaster, or any breakdown of public order'
]).
citation(in_dpdp_act_2023_s_7_i, [
    label-'Digital Personal Data Protection Act 2023 s 7(i) purposes of employment',
    ref-'in-dpdp-act-2023-meity-pdf#s7_i',
    verbatim-'for the purposes of employment or those related to safeguarding the employer from loss or liability'
]).

% ---- Rules, rule 1: commencement ---------------------------------------
citation(in_dpdp_rules_2025_r_1_4, [
    label-'Digital Personal Data Protection Rules 2025 rule 1(4) commencement of rules 3, 5 to 16, 22 and 23',
    ref-'in-dpdp-rules-2025-meity-pdf#r1_4',
    verbatim-'Rules 3, 5 to 16, 22 and 23 shall come into force eighteen months after the date of publication of this Gazette'
]).

% ---- Rules, rule 3: notice ------------------------------------------------
citation(in_dpdp_rules_2025_r_3, [
    label-'Digital Personal Data Protection Rules 2025 rule 3 notice given by Data Fiduciary to Data Principal',
    ref-'in-dpdp-rules-2025-meity-pdf#r3',
    verbatim-'The notice given by the Data Fiduciary to the Data Principal shall'
]).
citation(in_dpdp_rules_2025_r_3_a, [
    label-'Digital Personal Data Protection Rules 2025 rule 3(a) notice understandable independently',
    ref-'in-dpdp-rules-2025-meity-pdf#r3_a',
    verbatim-'be presented and be understandable independently of any other information that has been, is or may be made available by such Data Fiduciary'
]).
citation(in_dpdp_rules_2025_r_3_b, [
    label-'Digital Personal Data Protection Rules 2025 rule 3(b) fair account in clear and plain language',
    ref-'in-dpdp-rules-2025-meity-pdf#r3_b',
    verbatim-'give, in clear and plain language, a fair account of the details necessary to enable the Data Principal to give specific and informed consent for the processing of her personal data'
]).
citation(in_dpdp_rules_2025_r_3_b_i, [
    label-'Digital Personal Data Protection Rules 2025 rule 3(b)(i) itemised description of personal data',
    ref-'in-dpdp-rules-2025-meity-pdf#r3_b_i',
    verbatim-'an itemised description of such personal data'
]).
citation(in_dpdp_rules_2025_r_3_b_ii, [
    label-'Digital Personal Data Protection Rules 2025 rule 3(b)(ii) specified purposes and goods, services or uses',
    ref-'in-dpdp-rules-2025-meity-pdf#r3_b_ii',
    verbatim-'the specified purpose or purposes of, and specific description of the goods or services to be provided or uses to be enabled by, such processing'
]).
citation(in_dpdp_rules_2025_r_3_c_i, [
    label-'Digital Personal Data Protection Rules 2025 rule 3(c)(i) link and means to withdraw consent',
    ref-'in-dpdp-rules-2025-meity-pdf#r3_c_i',
    verbatim-'withdraw her consent, with the ease of doing so being comparable to that with which such consent was given'
]).
citation(in_dpdp_rules_2025_r_3_c_ii, [
    label-'Digital Personal Data Protection Rules 2025 rule 3(c)(ii) link and means to exercise rights',
    ref-'in-dpdp-rules-2025-meity-pdf#r3_c_ii',
    verbatim-'exercise her rights under the Act'
]).
citation(in_dpdp_rules_2025_r_3_c_iii, [
    label-'Digital Personal Data Protection Rules 2025 rule 3(c)(iii) link and means to complain to the Board',
    ref-'in-dpdp-rules-2025-meity-pdf#r3_c_iii',
    verbatim-'make a complaint to the Board'
]).

% ---- Rules, rule 4: Consent Managers --------------------------------------
citation(in_dpdp_rules_2025_r_4_2_a, [
    label-'Digital Personal Data Protection Rules 2025 rule 4(2)(a) registration of a Consent Manager by the Board',
    ref-'in-dpdp-rules-2025-meity-pdf#r4_2_a',
    verbatim-'is satisfied, register the applicant as a Consent Manager, under intimation to the applicant, and publish on its website the particulars of such Consent Manager'
]).
citation(in_dpdp_rules_2025_r_4_3, [
    label-'Digital Personal Data Protection Rules 2025 rule 4(3) obligations of a Consent Manager',
    ref-'in-dpdp-rules-2025-meity-pdf#r4_3',
    verbatim-'The Consent Manager shall have obligations as specified in Part B of First Schedule'
]).
citation(in_dpdp_rules_2025_r_4_5_a, [
