    verbatim-'Notices preceding or accompanying requests for consent'
]).
citation(in_dpdp_rules_2025_sch_1_partb_3_c, [
    label-'Digital Personal Data Protection Rules 2025 First Schedule Part B item 3(c) record of sharing with a transferee Data Fiduciary',
