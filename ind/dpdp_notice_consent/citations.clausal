% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for ind/dpdp_notice_consent.
%
% Sources: the Digital Personal Data Protection Act, 2023 (No. 22 of 2023),
% MeitY website PDF
% https://www.meity.gov.in/static/uploads/2024/06/2bf1f0e9f04e6fb4f8fef35e82c42aa5.pdf,
% and the Digital Personal Data Protection Rules, 2025, G.S.R. 846(E)
% (English half only), MeitY website PDF
% https://www.meity.gov.in/static/uploads/2025/11/53450e6e5dc0bfa85ebd78686cadad39.pdf,
% both fetched 2026-11-13, text extracts converted by
% _tools/provisions/india_to_akn.py (MeitY copy, not India Code, not compared
% with the gazette). Each verbatim is an exact substring of the pinned unit
% text named in its ref.
%
% Keys follow the canonical lexicon (_lexicon/citations.yaml). The keys of
% citation_vocabulary/1 are the ONLY keys a RESULT may return. Three further
% keys (in_dpdp_act_2023_s_2_d, in_dpdp_act_2023_s_5_2_b,
% in_dpdp_rules_2025_r_5_1) are recorded for provenance markers only and are
% never returned in a result.
%
% PROVENANCE: every operative clause opens its body with implements(Key).
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1,
    citation_vocabulary/1
]).

implements(Key) :-
    citation(Key, _).

% citation_vocabulary(Keys): the citation keys a RESULT may return.
