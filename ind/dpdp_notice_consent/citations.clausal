    ref-'in-dpdp-rules-2025-meity-pdf#r4_5_a',
    verbatim-'suspend or cancel the registration of such Consent Manager'
]).

% ---- Rules, rule 5: State processing standards ----------------------------
citation(in_dpdp_rules_2025_r_5_1, [
    label-'Digital Personal Data Protection Rules 2025 rule 5(1) processing following the Second Schedule standards',
    ref-'in-dpdp-rules-2025-meity-pdf#r5_1',
    verbatim-'Processing the personal data of a Data Principal under this rule shall be done following the standards specified in Second Schedule'
]).

% ---- Rules, Second Schedule -------------------------------------------
citation(in_dpdp_rules_2025_sch_2_a, [
    label-'Digital Personal Data Protection Rules 2025 Second Schedule item (a) lawful manner',
    ref-'in-dpdp-rules-2025-meity-pdf#sch2_a',
    verbatim-'Processing is carried out in a lawful manner'
]).
citation(in_dpdp_rules_2025_sch_2_b, [
    label-'Digital Personal Data Protection Rules 2025 Second Schedule item (b) for the specified uses or purposes',
    ref-'in-dpdp-rules-2025-meity-pdf#sch2_b',
    verbatim-'Processing is done for the uses specified in clause (b) of section 7 of the Act'
]).
citation(in_dpdp_rules_2025_sch_2_c, [
    label-'Digital Personal Data Protection Rules 2025 Second Schedule item (c) limited to necessary personal data',
    ref-'in-dpdp-rules-2025-meity-pdf#sch2_c',
    verbatim-'Processing is limited to such personal data as is necessary for such uses or achieving such purposes'
]).
citation(in_dpdp_rules_2025_sch_2_d, [
    label-'Digital Personal Data Protection Rules 2025 Second Schedule item (d) completeness, accuracy and consistency',
    ref-'in-dpdp-rules-2025-meity-pdf#sch2_d',
    verbatim-'Processing is done while making reasonable efforts to ensure the completeness, accuracy and consistency of personal data'
]).
citation(in_dpdp_rules_2025_sch_2_e, [
    label-'Digital Personal Data Protection Rules 2025 Second Schedule item (e) retention only while required',
    ref-'in-dpdp-rules-2025-meity-pdf#sch2_e',
    verbatim-'Personal data is retained till required for such uses or achieving such purposes'
]).
citation(in_dpdp_rules_2025_sch_2_f, [
    label-'Digital Personal Data Protection Rules 2025 Second Schedule item (f) reasonable security safeguards',
    ref-'in-dpdp-rules-2025-meity-pdf#sch2_f',
