% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for ind/dpdp_research_state_processing.
%
% Instruments: Digital Personal Data Protection Act, 2023 (No. 22 of 2023)
% and Digital Personal Data Protection Rules, 2025 (G.S.R. 846(E)), English
% text. Pinned unit text of the MeitY website PDFs fetched 2026-11-13
% (MeitY copy, not India Code, not compared with the gazette).
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order. Every
% key here is status: verified in citations-sources.yaml; its verbatim is
% an exact substring of the pinned unit text.
%
% The keys are the canonical lexicon keys (_lexicon/citations.yaml); the
% nineteen of them are the citation_vocabulary/1 list, the ONLY atoms a
% RESULT may cite. A clause cites a key with a cite(Key) term (data, no
% import). Every operative clause opens its body with implements(Key).
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1,
    citation_vocabulary/1
]).

citation(in_dpdp_act_2023_s_7_b, [label-'Digital Personal Data Protection Act 2023 s 7(b) (State and instrumentalities: subsidy, benefit, service, certificate, licence or permit)', ref-'https://www.meity.gov.in/static/uploads/2024/06/2bf1f0e9f04e6fb4f8fef35e82c42aa5.pdf (MeitY copy), unit s7_b', verbatim-'for the State and any of its instrumentalities to provide or issue to the Data Principal such subsidy, benefit, service, certificate, licence or permit as may be prescribed, where']).

citation(in_dpdp_act_2023_s_17_2, [label-'Digital Personal Data Protection Act 2023 s 17(2) lead-in (the Act shall not apply)', ref-'https://www.meity.gov.in/static/uploads/2024/06/2bf1f0e9f04e6fb4f8fef35e82c42aa5.pdf (MeitY copy), unit s17_2', verbatim-'The provisions of this Act shall not apply in respect of the processing of personal data']).

citation(in_dpdp_act_2023_s_17_2_b, [label-'Digital Personal Data Protection Act 2023 s 17(2)(b) (research, archiving or statistical purposes)', ref-'https://www.meity.gov.in/static/uploads/2024/06/2bf1f0e9f04e6fb4f8fef35e82c42aa5.pdf (MeitY copy), unit s17_2_b', verbatim-'necessary for research, archiving or statistical purposes if the personal data is not to be used to take any decision specific to a Data Principal and such processing is carried on in accordance with such standards as may be prescribed.']).

citation(in_dpdp_act_2023_s_17_4, [label-'Digital Personal Data Protection Act 2023 s 17(4) (processing by the State or an instrumentality: s 8(7), s 12(3) and s 12(2) not to apply)', ref-'https://www.meity.gov.in/static/uploads/2024/06/2bf1f0e9f04e6fb4f8fef35e82c42aa5.pdf (MeitY copy), unit s17_4', verbatim-'In respect of processing by the State or any instrumentality of the State, the provisions of sub-section (7) of section 8 and sub-section (3) of section 12 and, where such processing is for a purpose that does not include making of a decision that affects the Data Principal, sub-section (2) of section 12 shall not apply.']).

citation(in_dpdp_rules_2025_r_1_4, [label-'Digital Personal Data Protection Rules 2025 rule 1(4) (commencement of rules 3, 5 to 16, 22 and 23)', ref-'https://www.meity.gov.in/static/uploads/2025/11/53450e6e5dc0bfa85ebd78686cadad39.pdf (MeitY copy), unit r1_4', verbatim-'Rules 3, 5 to 16, 22 and 23 shall come into force eighteen months after the date of publication of this Gazette.']).

citation(in_dpdp_rules_2025_r_5_1, [label-'Digital Personal Data Protection Rules 2025 rule 5(1) (State processing to follow the Second Schedule standards)', ref-'https://www.meity.gov.in/static/uploads/2025/11/53450e6e5dc0bfa85ebd78686cadad39.pdf (MeitY copy), unit r5_1', verbatim-'Processing the personal data of a Data Principal under this rule shall be done following the standards specified in Second Schedule.']).

citation(in_dpdp_rules_2025_r_16, [label-'Digital Personal Data Protection Rules 2025 rule 16 (exemption from Act for research, archiving or statistical purposes)', ref-'https://www.meity.gov.in/static/uploads/2025/11/53450e6e5dc0bfa85ebd78686cadad39.pdf (MeitY copy), unit r16', verbatim-'The provisions of the Act shall not apply to the processing of personal data necessary for research, archiving or statistical purposes if it is carried on in accordance with the standards specified in Second Schedule.']).

citation(in_dpdp_rules_2025_sch_2, [label-'Digital Personal Data Protection Rules 2025 Second Schedule, heading and lead-in (appropriate technical and organisational measures)', ref-'https://www.meity.gov.in/static/uploads/2025/11/53450e6e5dc0bfa85ebd78686cadad39.pdf (MeitY copy), unit sch2', verbatim-'Implementation of appropriate technical and organisational measures to ensure effective observance of the following, in accordance with applicable law, for the processing of personal data, namely:']).

citation(in_dpdp_rules_2025_sch_2_a, [label-'Digital Personal Data Protection Rules 2025 Second Schedule item (a) (lawful manner)', ref-'https://www.meity.gov.in/static/uploads/2025/11/53450e6e5dc0bfa85ebd78686cadad39.pdf (MeitY copy), unit sch2_a', verbatim-'Processing is carried out in a lawful manner;']).

citation(in_dpdp_rules_2025_sch_2_b, [label-'Digital Personal Data Protection Rules 2025 Second Schedule item (b) (processing for the s 7(b) uses or the s 17(2)(b) purposes)', ref-'https://www.meity.gov.in/static/uploads/2025/11/53450e6e5dc0bfa85ebd78686cadad39.pdf (MeitY copy), unit sch2_b', verbatim-'Processing is done for the uses specified in clause (b) of section 7 of the Act or for the purposes specified in clause (b) of sub-section (2) of section 17 of the Act, as the case may be;']).

citation(in_dpdp_rules_2025_sch_2_c, [label-'Digital Personal Data Protection Rules 2025 Second Schedule item (c) (limited to necessary personal data)', ref-'https://www.meity.gov.in/static/uploads/2025/11/53450e6e5dc0bfa85ebd78686cadad39.pdf (MeitY copy), unit sch2_c', verbatim-'Processing is limited to such personal data as is necessary for such uses or achieving such purposes, as the case may be;']).

citation(in_dpdp_rules_2025_sch_2_d, [label-'Digital Personal Data Protection Rules 2025 Second Schedule item (d) (completeness, accuracy and consistency)', ref-'https://www.meity.gov.in/static/uploads/2025/11/53450e6e5dc0bfa85ebd78686cadad39.pdf (MeitY copy), unit sch2_d', verbatim-'Processing is done while making reasonable efforts to ensure the completeness, accuracy and consistency of personal data;']).

citation(in_dpdp_rules_2025_sch_2_e, [label-'Digital Personal Data Protection Rules 2025 Second Schedule item (e) (retention till required)', ref-'https://www.meity.gov.in/static/uploads/2025/11/53450e6e5dc0bfa85ebd78686cadad39.pdf (MeitY copy), unit sch2_e', verbatim-'Personal data is retained till required for such uses or achieving such purposes, as the case may be, or for compliance with any law for the time being in force;']).

citation(in_dpdp_rules_2025_sch_2_f, [label-'Digital Personal Data Protection Rules 2025 Second Schedule item (f) (reasonable security safeguards)', ref-'https://www.meity.gov.in/static/uploads/2025/11/53450e6e5dc0bfa85ebd78686cadad39.pdf (MeitY copy), unit sch2_f', verbatim-'Reasonable security safeguards to prevent personal data breach to protect personal data in the possession or under control of the Data Fiduciary, including in respect of any processing undertaken by it or on its behalf by a Data Processor;']).

citation(in_dpdp_rules_2025_sch_2_g, [label-'Digital Personal Data Protection Rules 2025 Second Schedule item (g) (intimation to the Data Principal for s 7(b) processing)', ref-'https://www.meity.gov.in/static/uploads/2025/11/53450e6e5dc0bfa85ebd78686cadad39.pdf (MeitY copy), unit sch2_g', verbatim-'Where processing is to be done under clause (b) of section 7 of the Act, the same is undertaken while giving the Data Principal an intimation in respect of the same and']).

citation(in_dpdp_rules_2025_sch_2_g_i, [label-'Digital Personal Data Protection Rules 2025 Second Schedule item (g)(i) (business contact information)', ref-'https://www.meity.gov.in/static/uploads/2025/11/53450e6e5dc0bfa85ebd78686cadad39.pdf (MeitY copy), unit sch2_g_i', verbatim-'giving the business contact information of a person who is able to answer on behalf of the Data Fiduciary the questions of the Data Principal about the processing of her personal data;']).

citation(in_dpdp_rules_2025_sch_2_g_ii, [label-'Digital Personal Data Protection Rules 2025 Second Schedule item (g)(ii) (communication link and means to exercise rights)', ref-'https://www.meity.gov.in/static/uploads/2025/11/53450e6e5dc0bfa85ebd78686cadad39.pdf (MeitY copy), unit sch2_g_ii', verbatim-'specifying the particular communication link for accessing the website or app, or both, of such Data Fiduciary, and a description of other means, if any, using which such Data Principal may exercise her rights under the Act; and']).

citation(in_dpdp_rules_2025_sch_2_g_iii, [label-'Digital Personal Data Protection Rules 2025 Second Schedule item (g)(iii) (consistency with other applicable standards)', ref-'https://www.meity.gov.in/static/uploads/2025/11/53450e6e5dc0bfa85ebd78686cadad39.pdf (MeitY copy), unit sch2_g_iii', verbatim-'is carried on in a manner consistent with such other standards as may be applicable to the processing of such personal data under policy issued by the Central Government or any law for the time being in force; and']).

citation(in_dpdp_rules_2025_sch_2_h, [label-'Digital Personal Data Protection Rules 2025 Second Schedule item (h) (accountability for effective observance)', ref-'https://www.meity.gov.in/static/uploads/2025/11/53450e6e5dc0bfa85ebd78686cadad39.pdf (MeitY copy), unit sch2_h', verbatim-'Accountability of the person who alone or in conjunction with other persons determines the purpose and means of processing of personal data, for effective observance of these standards.']).

% The canonical citation vocabulary of the three queries: the only keys a
% RESULT may cite.
citation_vocabulary([
    in_dpdp_act_2023_s_7_b,
    in_dpdp_act_2023_s_17_2,
    in_dpdp_act_2023_s_17_2_b,
    in_dpdp_act_2023_s_17_4,
    in_dpdp_rules_2025_r_1_4,
    in_dpdp_rules_2025_r_5_1,
    in_dpdp_rules_2025_r_16,
    in_dpdp_rules_2025_sch_2,
    in_dpdp_rules_2025_sch_2_a,
    in_dpdp_rules_2025_sch_2_b,
    in_dpdp_rules_2025_sch_2_c,
    in_dpdp_rules_2025_sch_2_d,
    in_dpdp_rules_2025_sch_2_e,
    in_dpdp_rules_2025_sch_2_f,
    in_dpdp_rules_2025_sch_2_g,
    in_dpdp_rules_2025_sch_2_g_i,
    in_dpdp_rules_2025_sch_2_g_ii,
    in_dpdp_rules_2025_sch_2_g_iii,
    in_dpdp_rules_2025_sch_2_h
]).

% Provenance marker: succeeds for every recorded key, fails for any other.
implements(Key) :-
    citation(Key, _).

test(every_vocabulary_key_is_recorded) :-
    citation_vocabulary(Keys),
    maplist(implements, Keys).
test(the_vocabulary_has_nineteen_keys) :-
    citation_vocabulary(Keys),
    length(Keys, 19).
test(an_unrecorded_key_is_not_implemented, fail) :-
    implements(in_dpdp_rules_2025_r_5).

:- end_module(citations).
