% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for ind/dpdp_security_retention.
%
% Instruments (pinned unit text; MeitY website PDFs fetched 2026-11-13, converted
% by _tools/provisions/india_to_akn.py; MeitY copy, not India Code, not compared
% with the gazette; the Rules from their English half only):
%   in-dpdp-act-2023-meity-pdf    Digital Personal Data Protection Act, 2023
%                                 (No. 22 of 2023)
%   in-dpdp-rules-2025-meity-pdf  Digital Personal Data Protection Rules, 2025,
%                                 G.S.R. 846(E)
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order. Every key
% below is `status: verified` in citations-sources.yaml: its verbatim is an
% exact substring of the pinned unit text. ref is the pinned unit id.
%
% The keys are the CANONICAL lexicon keys of the order's citation vocabulary;
% no other spelling is used. Pinned units with no limb (s 2 lead-in, (j), (k),
% (t), (u), (x), (za); s 8(1), (2), (4), (6), (9), (10) and the Illustrations;
% rule 1(1) to (3); rule 6(2); the rule 8(3) Illustration; the Third Schedule
% Note; the Seventh Schedule root) get no key: no clause decides them.
%
% PROVENANCE: every operative clause opens its body with implements(Key).
% implements/1 succeeds for every recorded key and fails for any other.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

implements(Key) :-
    citation(Key, _).

% ---- DPDP Act 2023, s 2 (definitions) --------------------------------
citation(in_dpdp_act_2023_s_2_i, [label-'Digital Personal Data Protection Act 2023 s 2(i) definition of Data Fiduciary', ref-'in-dpdp-act-2023-meity-pdf#s2_i', verbatim-'means any person who alone or in conjunction with other persons determines the purpose and means of processing of personal data']).

% ---- DPDP Act 2023, s 8 (general obligations of Data Fiduciary) -------
citation(in_dpdp_act_2023_s_8_3, [label-'Digital Personal Data Protection Act 2023 s 8(3) completeness, accuracy and consistency', ref-'in-dpdp-act-2023-meity-pdf#s8_3', verbatim-'Where personal data processed by a Data Fiduciary is likely to be']).
citation(in_dpdp_act_2023_s_8_3_a, [label-'Digital Personal Data Protection Act 2023 s 8(3)(a) likely used to make a decision affecting the Data Principal', ref-'in-dpdp-act-2023-meity-pdf#s8_3_a', verbatim-'used to make a decision that affects the Data Principal']).
citation(in_dpdp_act_2023_s_8_3_b, [label-'Digital Personal Data Protection Act 2023 s 8(3)(b) likely disclosed to another Data Fiduciary', ref-'in-dpdp-act-2023-meity-pdf#s8_3_b', verbatim-'disclosed to another Data Fiduciary']).
citation(in_dpdp_act_2023_s_8_5, [label-'Digital Personal Data Protection Act 2023 s 8(5) reasonable security safeguards', ref-'in-dpdp-act-2023-meity-pdf#s8_5', verbatim-'A Data Fiduciary shall protect personal data in its possession or under its control, including in respect of any processing undertaken by it or on its behalf by a Data Processor, by taking reasonable security safeguards to prevent personal data breach.']).
citation(in_dpdp_act_2023_s_8_7, [label-'Digital Personal Data Protection Act 2023 s 8(7) erasure, unless retention is necessary for compliance with law', ref-'in-dpdp-act-2023-meity-pdf#s8_7', verbatim-'A Data Fiduciary shall, unless retention is necessary for compliance with any law for the time being in force,']).
citation(in_dpdp_act_2023_s_8_7_a, [label-'Digital Personal Data Protection Act 2023 s 8(7)(a) erasure on withdrawal of consent or end of specified purpose', ref-'in-dpdp-act-2023-meity-pdf#s8_7_a', verbatim-'erase personal data, upon the Data Principal withdrawing her consent or as soon as it is reasonable to assume that the specified purpose is no longer being served, whichever is earlier']).
citation(in_dpdp_act_2023_s_8_7_b, [label-'Digital Personal Data Protection Act 2023 s 8(7)(b) causing the Data Processor to erase', ref-'in-dpdp-act-2023-meity-pdf#s8_7_b', verbatim-'cause its Data Processor to erase any personal data that was made available by the Data Fiduciary for processing to such Data Processor']).
citation(in_dpdp_act_2023_s_8_8, [label-'Digital Personal Data Protection Act 2023 s 8(8) purpose deemed no longer served', ref-'in-dpdp-act-2023-meity-pdf#s8_8', verbatim-'The purpose referred to in clause (a) of sub-section (7) shall be deemed to no longer be served, if the Data Principal does not']).
citation(in_dpdp_act_2023_s_8_8_a, [label-'Digital Personal Data Protection Act 2023 s 8(8)(a) not approaching the Data Fiduciary for the specified purpose', ref-'in-dpdp-act-2023-meity-pdf#s8_8_a', verbatim-'approach the Data Fiduciary for the performance of the specified purpose']).
citation(in_dpdp_act_2023_s_8_8_b, [label-'Digital Personal Data Protection Act 2023 s 8(8)(b) not exercising rights in relation to the processing', ref-'in-dpdp-act-2023-meity-pdf#s8_8_b', verbatim-'exercise any of her rights in relation to such processing']).
citation(in_dpdp_act_2023_s_8_11, [label-'Digital Personal Data Protection Act 2023 s 8(11) meaning of not having approached the Data Fiduciary', ref-'in-dpdp-act-2023-meity-pdf#s8_11', verbatim-'a Data Principal shall be considered as not having approached the Data Fiduciary for the performance of the specified purpose, in any period during which she has not initiated contact with the Data Fiduciary for such performance, in person or by way of communication in electronic or physical form']).

% ---- DPDP Rules 2025, rule 1 (commencement) ---------------------------
citation(in_dpdp_rules_2025_r_1_4, [label-'Digital Personal Data Protection Rules 2025 rule 1(4) commencement of rules 3, 5 to 16, 22 and 23', ref-'in-dpdp-rules-2025-meity-pdf#r1_4', verbatim-'Rules 3, 5 to 16, 22 and 23 shall come into force eighteen months after the date of publication of this Gazette.']).

% ---- DPDP Rules 2025, rule 6 (reasonable security safeguards) ---------
citation(in_dpdp_rules_2025_r_6_1, [label-'Digital Personal Data Protection Rules 2025 rule 6(1) minimum reasonable security safeguards', ref-'in-dpdp-rules-2025-meity-pdf#r6_1', verbatim-'which shall include, at the minimum']).
citation(in_dpdp_rules_2025_r_6_1_a, [label-'Digital Personal Data Protection Rules 2025 rule 6(1)(a) data security measures', ref-'in-dpdp-rules-2025-meity-pdf#r6_1_a', verbatim-'appropriate data security measures, such as securing of personal data through encryption, obfuscation, masking or the use of virtual tokens mapped to that personal data']).
citation(in_dpdp_rules_2025_r_6_1_b, [label-'Digital Personal Data Protection Rules 2025 rule 6(1)(b) access control for computer resources', ref-'in-dpdp-rules-2025-meity-pdf#r6_1_b', verbatim-'appropriate measures to control access to the computer resources used by such Data Fiduciary or such a Data Processor, wherever applicable']).
citation(in_dpdp_rules_2025_r_6_1_c, [label-'Digital Personal Data Protection Rules 2025 rule 6(1)(c) visibility through logs, monitoring and review', ref-'in-dpdp-rules-2025-meity-pdf#r6_1_c', verbatim-'visibility on the accessing of such personal data, through appropriate logs, monitoring and review']).
citation(in_dpdp_rules_2025_r_6_1_d, [label-'Digital Personal Data Protection Rules 2025 rule 6(1)(d) continued processing measures', ref-'in-dpdp-rules-2025-meity-pdf#r6_1_d', verbatim-'reasonable measures for continued processing in the event of confidentiality, integrity or availability of such personal data being compromised']).
citation(in_dpdp_rules_2025_r_6_1_e, [label-'Digital Personal Data Protection Rules 2025 rule 6(1)(e) one-year retention of logs and personal data', ref-'in-dpdp-rules-2025-meity-pdf#r6_1_e', verbatim-'retain such logs and personal data for a period of one year, unless compliance with any law for the time being in force requires otherwise']).
citation(in_dpdp_rules_2025_r_6_1_f, [label-'Digital Personal Data Protection Rules 2025 rule 6(1)(f) Data Processor contract provision on safeguards', ref-'in-dpdp-rules-2025-meity-pdf#r6_1_f', verbatim-'appropriate provision in the contract entered into between such Data Fiduciary and such a Data Processor, wherever applicable, for taking reasonable security safeguards']).
citation(in_dpdp_rules_2025_r_6_1_g, [label-'Digital Personal Data Protection Rules 2025 rule 6(1)(g) technical and organisational measures for safeguards', ref-'in-dpdp-rules-2025-meity-pdf#r6_1_g', verbatim-'appropriate technical and organisational measures to ensure effective observance of security safeguards']).

% ---- DPDP Rules 2025, rule 8 (deemed end of purpose; retention) -------
citation(in_dpdp_rules_2025_r_8_1, [label-'Digital Personal Data Protection Rules 2025 rule 8(1) erasure after the Third Schedule time period', ref-'in-dpdp-rules-2025-meity-pdf#r8_1', verbatim-'shall erase such personal data, unless its retention is necessary for compliance with any law for the time being in force']).
citation(in_dpdp_rules_2025_r_8_2, [label-'Digital Personal Data Protection Rules 2025 rule 8(2) notice forty-eight hours before erasure', ref-'in-dpdp-rules-2025-meity-pdf#r8_2', verbatim-'the Data Fiduciary shall inform the Data Principal that such personal data shall be erased upon completion of such period']).
citation(in_dpdp_rules_2025_r_8_3, [label-'Digital Personal Data Protection Rules 2025 rule 8(3) minimum one-year retention of personal data and logs', ref-'in-dpdp-rules-2025-meity-pdf#r8_3', verbatim-'such personal data, associated traffic data and other logs of the processing for a minimum period of one year from the date of such processing']).

% ---- DPDP Rules 2025, Third Schedule [See rule 8(1)] ------------------
citation(in_dpdp_rules_2025_sch_3, [label-'Digital Personal Data Protection Rules 2025 Third Schedule', ref-'in-dpdp-rules-2025-meity-pdf#sch3', verbatim-'THIRD SCHEDULE [See rule 8(1)]']).
citation(in_dpdp_rules_2025_sch_3_1, [label-'Digital Personal Data Protection Rules 2025 Third Schedule item 1 e-commerce entity, not less than two crore registered users', ref-'in-dpdp-rules-2025-meity-pdf#sch3_1', verbatim-'commerce entity having not less than two crore registered users in India']).
citation(in_dpdp_rules_2025_sch_3_1_a, [label-'Digital Personal Data Protection Rules 2025 Third Schedule item 1(a) excepted purpose: access to user account', ref-'in-dpdp-rules-2025-meity-pdf#sch3_1_a', verbatim-'Enabling the Data Principal to access her user account']).
citation(in_dpdp_rules_2025_sch_3_1_b, [label-'Digital Personal Data Protection Rules 2025 Third Schedule item 1(b) excepted purpose: access to virtual token, with the column (4) time period', ref-'in-dpdp-rules-2025-meity-pdf#sch3_1_b', verbatim-'Enabling the Data Principal to access any virtual token that is issued by or on behalf of the Data Fiduciary']).
citation(in_dpdp_rules_2025_sch_3_2, [label-'Digital Personal Data Protection Rules 2025 Third Schedule item 2 online gaming intermediary, not less than fifty lakh registered users', ref-'in-dpdp-rules-2025-meity-pdf#sch3_2', verbatim-'online gaming intermediary having not less than fifty lakh registered users in India']).
citation(in_dpdp_rules_2025_sch_3_2_a, [label-'Digital Personal Data Protection Rules 2025 Third Schedule item 2(a) excepted purpose: access to user account', ref-'in-dpdp-rules-2025-meity-pdf#sch3_2_a', verbatim-'Enabling the Data Principal to access her user account']).
citation(in_dpdp_rules_2025_sch_3_2_b, [label-'Digital Personal Data Protection Rules 2025 Third Schedule item 2(b) excepted purpose: access to virtual token, with the column (4) time period', ref-'in-dpdp-rules-2025-meity-pdf#sch3_2_b', verbatim-'Enabling the Data Principal to access any virtual token that is issued by or on behalf of the Data Fiduciary']).
citation(in_dpdp_rules_2025_sch_3_3, [label-'Digital Personal Data Protection Rules 2025 Third Schedule item 3 social media intermediary, not less than two crore registered users', ref-'in-dpdp-rules-2025-meity-pdf#sch3_3', verbatim-'social media intermediary having not less than two crore registered users in India']).
citation(in_dpdp_rules_2025_sch_3_3_a, [label-'Digital Personal Data Protection Rules 2025 Third Schedule item 3(a) excepted purpose: access to user account', ref-'in-dpdp-rules-2025-meity-pdf#sch3_3_a', verbatim-'Enabling the Data Principal to access her user account']).
citation(in_dpdp_rules_2025_sch_3_3_b, [label-'Digital Personal Data Protection Rules 2025 Third Schedule item 3(b) excepted purpose: access to virtual token, with the column (4) time period', ref-'in-dpdp-rules-2025-meity-pdf#sch3_3_b', verbatim-'Enabling the Data Principal to access any virtual token that is issued by or on behalf of the Data Fiduciary']).

% ---- DPDP Rules 2025, Seventh Schedule [See rule 23(1) and 8(3)] ------
citation(in_dpdp_rules_2025_sch_7_1, [label-'Digital Personal Data Protection Rules 2025 Seventh Schedule item 1 State use for sovereignty, integrity or security', ref-'in-dpdp-rules-2025-meity-pdf#sch7_1', verbatim-'Use, by the State or any of its instrumentalities, of personal data of a Data Principal in the interest of sovereignty and integrity of India or security of the State.']).
citation(in_dpdp_rules_2025_sch_7_2_i, [label-'Digital Personal Data Protection Rules 2025 Seventh Schedule item 2(i) State use for performance of a function under law', ref-'in-dpdp-rules-2025-meity-pdf#sch7_2_i', verbatim-'performance of any function under any law for the time being in force in India']).
citation(in_dpdp_rules_2025_sch_7_2_ii, [label-'Digital Personal Data Protection Rules 2025 Seventh Schedule item 2(ii) State use for disclosure to fulfil an obligation under law', ref-'in-dpdp-rules-2025-meity-pdf#sch7_2_ii', verbatim-'disclosure of any information for fulfilling any obligation under any law for the time being in force in India']).
citation(in_dpdp_rules_2025_sch_7_3, [label-'Digital Personal Data Protection Rules 2025 Seventh Schedule item 3 assessment for notifying a Significant Data Fiduciary', ref-'in-dpdp-rules-2025-meity-pdf#sch7_3', verbatim-'Carrying out assessment for notifying any Data Fiduciary or class of Data Fiduciaries as Significant Data Fiduciary.']).

:- end_module(citations).
