% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% queries.clausal -- QUERY-COMBINATOR layer for ind/dpdp_security_retention.
% A TOP-LAYER consumer: it imports the determination slice's PUBLIC
% predicates it calls, and nothing else.
%
% dpdp_security_retention_what_if/4      (#16 what-if): override one key -> re-evaluate
% dpdp_security_retention_profile_keys/1: top-level profile key schema
% dpdp_security_retention_input_problems/2: the problems a profile has ([] = none),
%     re-exported as the scaffold wrote it in kernel.clausal
%
% Query types #2 (eligibility: decide_dpdp_security_retention/2 and
% dpdp_security_retention_status/2) and #7 (justification: the cited
% checklist dpdp_security_retention_checklist/2, one item per profile query,
% each carrying its cite(Key) list) are served by the slice
% dpdp_security_retention.clausal and re-exported by the package facade.
%
% The profile is an ATTRIBUTE LIST [attribute(Key, Value), ...], not a dict,
% so the what-if does not use query_combinators' override_key/4 (which
% overrides a dict world): it drops every attribute of the overridden key and
% appends the new one. That is list plumbing with no statutory content, so it
% carries no implements/1 marker.
%
% ROOT EXPORTS. The order's result atoms and result constructors are read by
% the reference scorer as package-root attributes. The result atoms have a
% defining clause at the foot of this file; the result constructors are data
% and have NO clauses: they are declared with constructors/1 and exported.
% =====================================================================

:- module(queries, [
    dpdp_security_retention_profile_keys/1,
    dpdp_security_retention_input_problems/2,
    dpdp_security_retention_what_if/4,
    required_with_rule_6_minimum/0,
    required_minimum_not_prescribed/0,
    not_required/0,
    not_in_force/0,
    required/0,
    erase/0,
    erase_and_cause_data_processor_to_erase/0,
    retain_until_minimum_retention_period_end/0,
    retain_as_required_by_other_law/0,
    not_yet_required/0,
    deemed_no_longer_served/0,
    not_yet_deemed/0,
    not_listed/0,
    indeterminate/1,
    needs_legal_review/2,
    open_textured/2,
    inputs_relied_on/1,
    provenance/2,
    content_item/2,
    input_problems/1,
    unknown_key/1,
    wrong_type/1,
    duplicate_key/1
]).

:- use_module(ind/dpdp_security_retention/kernel, [dpdp_security_retention_input_problems/2]).
:- use_module(ind/dpdp_security_retention/dpdp_security_retention, [dpdp_security_retention_status/2]).

:- constructors([indeterminate(missing_keys), needs_legal_review(reason, context), open_textured(input, citation), inputs_relied_on(pairs), provenance(label, source), content_item(name, citation), input_problems(problems), unknown_key(key), wrong_type(key), duplicate_key(key)]).

% schema of top-level profile keys: the keys of the order's typed input contract, in its order
dpdp_security_retention_profile_keys([section_8_3_in_force, section_8_5_in_force, section_8_7_in_force, section_8_8_in_force, acts_as_data_fiduciary, likely_used_for_decision_affecting_data_principal, likely_disclosed_to_another_data_fiduciary, retention_necessary_for_compliance_with_law, consent_withdrawn, specified_purpose_no_longer_served, assessment_date, last_processing_date, data_made_available_to_data_processor, third_schedule_class, registered_users_in_india, third_schedule_purpose_excepted, last_approached_date]).

% #16 what-if: re-evaluate with one key hypothetically overridden (or added).
% Defined for a ground list profile; one answer.
dpdp_security_retention_what_if(Profile, OverriddenKey, NewValue, NewStatus) :-
    ground(Profile),
    is_list(Profile),
    profile_without_key(Profile, OverriddenKey, RemainingAttributes),
    append(RemainingAttributes, [attribute(OverriddenKey, NewValue)], Hypothesis),
    dpdp_security_retention_status(Hypothesis, NewStatus).

% profile_without_key(Attributes, Key, Remaining): every attribute of Key dropped.
profile_without_key([], _, []).
profile_without_key([attribute(ElementKey, _)|Elements], OverriddenKey, RemainingAttributes) :-
    ElementKey == OverriddenKey,
    profile_without_key(Elements, OverriddenKey, RemainingAttributes).
profile_without_key([attribute(ElementKey, ElementValue)|Elements], OverriddenKey, [attribute(ElementKey, ElementValue)|RemainingAttributes]) :-
    ElementKey \== OverriddenKey,
    profile_without_key(Elements, OverriddenKey, RemainingAttributes).

% ---- root exports: result atoms (defining clauses only) -----------------
required_with_rule_6_minimum.
required_minimum_not_prescribed.
not_required.
not_in_force.
required.
erase.
erase_and_cause_data_processor_to_erase.
retain_until_minimum_retention_period_end.
retain_as_required_by_other_law.
not_yet_required.
deemed_no_longer_served.
not_yet_deemed.
not_listed.

test(what_if_makes_a_processor_a_fiduciary) :-
    findall(Status, dpdp_security_retention_what_if([attribute(section_8_5_in_force, true), attribute(acts_as_data_fiduciary, false), attribute(assessment_date, date(2028, 1, 1))], acts_as_data_fiduciary, true, Status), Statuses),
    Statuses == [section_8_duty_owed].
test(what_if_keeps_one_attribute_per_key) :-
    profile_without_key([attribute(consent_withdrawn, true), attribute(assessment_date, date(2028, 1, 1))], consent_withdrawn, RemainingAttributes),
    RemainingAttributes == [attribute(assessment_date, date(2028, 1, 1))].
test(what_if_on_a_non_list_has_no_answer, fail) :-
    dpdp_security_retention_what_if(not_a_list, consent_withdrawn, true, _).
test(what_if_on_a_list_has_an_answer) :-
    dpdp_security_retention_what_if([], consent_withdrawn, true, section_8_duty_undetermined).
test(root_result_atoms_have_defining_clauses) :-
    required_with_rule_6_minimum,
    not_in_force,
    erase,
    not_listed.

:- end_module(queries).
