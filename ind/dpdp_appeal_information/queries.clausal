% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% queries.clausal -- QUERY-COMBINATOR layer for ind/dpdp_appeal_information.
% A TOP-LAYER consumer: it imports the determination slice's PUBLIC
% predicates it calls, and nothing else.
%
% dpdp_appeal_information_what_if/4      (#16 what-if): override one key -> re-evaluate
% dpdp_appeal_information_profile_keys/1: top-level profile key schema
% dpdp_appeal_information_input_problems/2: the problems a profile has ([] = none)
%
% The domain's declared query types are served by the slice
% dpdp_appeal_information.clausal and re-exported by the package facade:
%   #2 eligibility   decide_dpdp_appeal_information/2 and
%                    dpdp_appeal_information_status/2 (eligible | ineligible |
%                    indeterminate), built from appeal_period/3;
%   #7 justification dpdp_appeal_information_checklist/2, one cite(...) per
%                    item (s 29(1) for standing, s 29(2) for the sixty days).
% The five called queries (appeal_period/3, appeal_filing_requirements/3,
% appeal_disposal_target/3, information_call_status/3,
% non_disclosure_status/3) are the slice's own exports.
%
% WHAT-IF. The profile is an ATTRIBUTE LIST (the order's typed input
% contract), not a dict, so the kit's dict-keyed override_key/4 does not
% apply; attribute_override/4 below drops every attribute of the key and
% appends the hypothetical one. It is list plumbing and decides nothing
% statutory.
%
% RESULT CONSTRUCTORS. The order lists the result terms as public
% constructors (exported, never called as queries). Those with a fixed
% shape are defined by one fact giving the shape the order states; those
% whose every field is free (inputs_relied_on/1, provenance/2,
% unknown_key/1, wrong_type/1, duplicate_key/1) are data only, declared
% with constructors/1 and given no clauses. They decide nothing statutory
% and carry no marker.
% =====================================================================

:- module(queries, [
    dpdp_appeal_information_profile_keys/1,
    dpdp_appeal_information_input_problems/2,
    dpdp_appeal_information_what_if/4,
    in_time/1,
    out_of_time_sufficient_cause_needed/1,
    not_appealable/0,
    not_in_force/0,
    filing_requirements/1,
    not_yet_prescribed/0,
    disposed_within_target/1,
    disposal_target_not_yet_passed/1,
    reasons_in_writing_required/1,
    required_to_furnish_within_specified_period/0,
    required_to_furnish_under_section_36/0,
    not_covered/0,
    disclosure_barred_without_written_permission/0,
    disclosure_permitted_by_written_permission/0,
    not_barred_by_rule_23/0,
    indeterminate/1,
    needs_legal_review/2,
    open_textured/2,
    not_governed_here/1,
    inputs_relied_on/1,
    provenance/2,
    input_problems/1,
    unknown_key/1,
    wrong_type/1,
    duplicate_key/1
]).

:- constructors([inputs_relied_on(pairs), provenance(clause, citations), unknown_key(key), wrong_type(key), duplicate_key(key)]).

:- use_module(ind/dpdp_appeal_information/kernel, [dpdp_appeal_information_input_problems/2]).
:- use_module(ind/dpdp_appeal_information/dpdp_appeal_information, [dpdp_appeal_information_status/2]).

% schema of top-level profile keys: the keys of the order's typed input contract, in its order
dpdp_appeal_information_profile_keys([section_29_in_force_on_filing_date, appeal_against_board_order_or_direction, appellant_aggrieved, order_receipt_date, appeal_filing_date, appeal_disposed_of_within_six_months, reference_date, section_36_in_force_on_call_date, call_date, recipient_kind, call_for_seventh_schedule_purpose, called_through_authorised_person, non_disclosure_required, written_permission_to_disclose]).

% #16 what-if: re-evaluate with one key hypothetically overridden
dpdp_appeal_information_what_if(Profile, OverriddenKey, NewValue, NewStatus) :-
    attribute_override(Profile, OverriddenKey, NewValue, Hypothesis),
    dpdp_appeal_information_status(Hypothesis, NewStatus).

% attribute_override(Profile, Key, Value, Hypothesis): Profile without any
% attribute of Key, then attribute(Key, Value) at the end.
attribute_override(Profile, OverriddenKey, NewValue, Hypothesis) :-
    attributes_without_key(Profile, OverriddenKey, KeptAttributes),
    append(KeptAttributes, [attribute(OverriddenKey, NewValue)], Hypothesis).

attributes_without_key([], _, []).
attributes_without_key([attribute(ElementKey, _)|Elements], OverriddenKey, KeptAttributes) :-
    ElementKey == OverriddenKey,
    attributes_without_key(Elements, OverriddenKey, KeptAttributes).
attributes_without_key([attribute(ElementKey, ElementValue)|Elements], OverriddenKey, [attribute(ElementKey, ElementValue)|KeptAttributes]) :-
    ElementKey \== OverriddenKey,
    attributes_without_key(Elements, OverriddenKey, KeptAttributes).

% ---- result constructors (shapes as INTERFACE - THE LIMBS states) ----

% appeal_period/3
in_time(date(_LastYearNumber, _LastMonthNumber, _LastDayNumber)).
out_of_time_sufficient_cause_needed(date(_LastYearNumber, _LastMonthNumber, _LastDayNumber)).
not_appealable.
not_in_force.

% appeal_filing_requirements/3: the three items, in the scored order.
filing_requirements([digital_form, fee_as_for_trai_act_appeal_unless_reduced_or_waived, fee_paid_by_upi_or_rbi_authorised_payment_system]).
not_yet_prescribed.

% appeal_disposal_target/3
disposed_within_target(date(_TargetYearNumber, _TargetMonthNumber, _TargetDayNumber)).
disposal_target_not_yet_passed(date(_TargetYearNumber, _TargetMonthNumber, _TargetDayNumber)).
reasons_in_writing_required(date(_TargetYearNumber, _TargetMonthNumber, _TargetDayNumber)).

% information_call_status/3
required_to_furnish_within_specified_period.
required_to_furnish_under_section_36.
not_covered.

% non_disclosure_status/3
disclosure_barred_without_written_permission.
disclosure_permitted_by_written_permission.
not_barred_by_rule_23.

% Non-final statuses, every query.
indeterminate([_MissingKey]).
needs_legal_review(_ReviewReason, [inputs_relied_on(_RelyPairs)|_ProvenanceItems]).
open_textured(_UnsureKey, cite(_CitationKey)).
not_governed_here([cite(in_dpdp_rules_2025_r_23_1), cite(in_dpdp_act_2023_s_36)]).
input_problems([_FirstProblem|_OtherProblems]).

:- end_module(queries).
