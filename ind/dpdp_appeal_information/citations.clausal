    verbatim-'every artificial juristic person, not falling within any of the preceding sub-clauses'
]).

citation(in_dpdp_act_2023_s_2_v, [
    label-'Digital Personal Data Protection Act 2023 s 2(v) definition of prescribed',
    ref-'https://www.meity.gov.in/static/uploads/2024/06/2bf1f0e9f04e6fb4f8fef35e82c42aa5.pdf unit in-dpdp-act-2023-meity-pdf#s2_v',
    verbatim-'“prescribed” means prescribed by rules made under this Act'
]).

citation(in_dpdp_act_2023_s_2_z, [
    label-'Digital Personal Data Protection Act 2023 s 2(z) definition of Significant Data Fiduciary',
    ref-'https://www.meity.gov.in/static/uploads/2024/06/2bf1f0e9f04e6fb4f8fef35e82c42aa5.pdf unit in-dpdp-act-2023-meity-pdf#s2_z',
    verbatim-'“Significant Data Fiduciary” means any Data Fiduciary or class of Data Fiduciaries as may be notified by the Central Government under section 10'
]).

citation(in_dpdp_act_2023_s_28_4, [
    label-'Digital Personal Data Protection Act 2023 s 28(4) (Board closes proceedings for insufficient grounds; example of an order)',
    ref-'https://www.meity.gov.in/static/uploads/2024/06/2bf1f0e9f04e6fb4f8fef35e82c42aa5.pdf unit in-dpdp-act-2023-meity-pdf#s28_4',
    verbatim-'In case the Board determines that there are insufficient grounds, it may, for reasons to be recorded in writing, close the proceedings.'
]).

citation(in_dpdp_act_2023_s_28_10, [
    label-'Digital Personal Data Protection Act 2023 s 28(10) (Board interim orders; example of an order)',
    ref-'https://www.meity.gov.in/static/uploads/2024/06/2bf1f0e9f04e6fb4f8fef35e82c42aa5.pdf unit in-dpdp-act-2023-meity-pdf#s28_10',
    verbatim-'During the course of the inquiry, if the Board considers it necessary, it may for reasons to be recorded in writing, issue interim orders after giving the person concerned an opportunity of being heard.'
]).

citation(in_dpdp_act_2023_s_28_11, [
    label-'Digital Personal Data Protection Act 2023 s 28(11) (Board closes proceedings or proceeds under s 33 after inquiry; example of an order)',
    ref-'https://www.meity.gov.in/static/uploads/2024/06/2bf1f0e9f04e6fb4f8fef35e82c42aa5.pdf unit in-dpdp-act-2023-meity-pdf#s28_11',
    verbatim-'On completion of the inquiry and after giving the person concerned an opportunity of being heard, the Board may for reasons to be recorded in writing, either close the proceedings or proceed in accordance with section 33.'
]).

citation(in_dpdp_act_2023_s_28_12, [
    label-'Digital Personal Data Protection Act 2023 s 28(12) (Board warning or costs on a false or frivolous complaint; example of an order)',
    ref-'https://www.meity.gov.in/static/uploads/2024/06/2bf1f0e9f04e6fb4f8fef35e82c42aa5.pdf unit in-dpdp-act-2023-meity-pdf#s28_12',
    verbatim-'At any stage after receipt of a complaint, if the Board is of the opinion that the complaint is false or frivolous, it may issue a warning or impose costs on the complainant.'
]).

citation(in_dpdp_act_2023_s_29, [
    label-'Digital Personal Data Protection Act 2023 s 29 (section number only; marginal note not pinned)',
    ref-'https://www.meity.gov.in/static/uploads/2024/06/2bf1f0e9f04e6fb4f8fef35e82c42aa5.pdf unit in-dpdp-act-2023-meity-pdf#s29',
    verbatim-'29.'
]).

citation(in_dpdp_rules_2025_r_22, [
    label-'Digital Personal Data Protection Rules 2025 rule 22 heading (Appeal to Appellate Tribunal)',
    ref-'https://www.meity.gov.in/static/uploads/2025/11/53450e6e5dc0bfa85ebd78686cadad39.pdf unit in-dpdp-rules-2025-meity-pdf#r22',
    verbatim-'Appeal to Appellate Tribunal'
]).

citation(in_dpdp_rules_2025_r_23, [
    label-'Digital Personal Data Protection Rules 2025 rule 23 heading (Calling for information from Data Fiduciary or intermediary)',
    ref-'https://www.meity.gov.in/static/uploads/2025/11/53450e6e5dc0bfa85ebd78686cadad39.pdf unit in-dpdp-rules-2025-meity-pdf#r23',
    verbatim-'Calling for information from Data Fiduciary or intermediary.'
]).

citation(in_dpdp_rules_2025_r_23_3, [
    label-'Digital Personal Data Protection Rules 2025 rule 23(3) definition of intermediary (meaning in the Information Technology Act 2000)',
    ref-'https://www.meity.gov.in/static/uploads/2025/11/53450e6e5dc0bfa85ebd78686cadad39.pdf unit in-dpdp-rules-2025-meity-pdf#r23_3',
    verbatim-'the expression “intermediary” shall have the same meaning as assigned to it in the Information Technology Act, 2000 (21 of 2000)'
]).

citation(in_dpdp_rules_2025_sch_7, [
    label-'Digital Personal Data Protection Rules 2025 Seventh Schedule heading and column heads',
    ref-'https://www.meity.gov.in/static/uploads/2025/11/53450e6e5dc0bfa85ebd78686cadad39.pdf unit in-dpdp-rules-2025-meity-pdf#sch7',
    verbatim-'SEVENTH SCHEDULE'
]).

:- end_module(citations).
