citation(in_dpdp_act_2023_s_2_s_vi, [
    label-'Digital Personal Data Protection Act 2023 s 2(s)(vi) person includes the State',
    ref-'https://www.meity.gov.in/static/uploads/2024/06/2bf1f0e9f04e6fb4f8fef35e82c42aa5.pdf unit in-dpdp-act-2023-meity-pdf#s2_s_vi',
    verbatim-'the State'
]).

citation(in_dpdp_act_2023_s_2_s_vii, [
    label-'Digital Personal Data Protection Act 2023 s 2(s)(vii) person includes every artificial juristic person',
