% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for ind/dpdp_appeal_information.
%
% Sources: the Digital Personal Data Protection Act, 2023 (No. 22 of 2023)
% and the Digital Personal Data Protection Rules, 2025 (G.S.R. 846(E)),
% English text, both as text extracts of the MeitY website PDFs fetched
% 2026-11-13 (MeitY copy, not India Code, not compared with the gazette).
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% Each verbatim is an exact substring of the pinned unit text named in
% its ref; the matching citations-sources.yaml entry is status: verified.
%
% TWO GROUPS OF KEYS:
% (1) LOAD-BEARING keys: the canonical lexicon keys of the order's
%     citation_vocabulary. These, and only these, are returned in a
%     RESULT or CITATIONS list, always as cite(Key).
% (2) CONTEXT keys: pinned units the readings rely on (definitions in
%     s 2, the s 28 examples of Board orders, the s 29 number, the rule 22
%     and rule 23 headings, rule 23(3) on intermediary, the Seventh
%     Schedule heading). They are recorded so a clause applying them can
%     open with implements(Key); they are NEVER returned in a result.
%
% PROVENANCE: every operative clause opens its body with
% implements(Key), Key a key recorded here. implements/1 succeeds for
% every recorded key and fails for any other, so a misspelt key makes its
% clause fail rather than lie.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

implements(Key) :-
    citation(Key, _).

% ---- (1) LOAD-BEARING keys (citation_vocabulary) --------------------

% s 29(1): who may appeal, and against what (appeal_period).
citation(in_dpdp_act_2023_s_29_1, [
    label-'Digital Personal Data Protection Act 2023 s 29(1) (appeal by any person aggrieved by an order or direction of the Board)',
    ref-'https://www.meity.gov.in/static/uploads/2024/06/2bf1f0e9f04e6fb4f8fef35e82c42aa5.pdf unit in-dpdp-act-2023-meity-pdf#s29_1',
    verbatim-'Any person aggrieved by an order or direction made by the Board under this Act may prefer an appeal before the Appellate Tribunal.'
]).

% s 29(2): the sixty days; form, manner and fee as prescribed
% (appeal_period, appeal_filing_requirements).
citation(in_dpdp_act_2023_s_29_2, [
    label-'Digital Personal Data Protection Act 2023 s 29(2) (sixty days from receipt; form, manner and fee as prescribed)',
    ref-'https://www.meity.gov.in/static/uploads/2024/06/2bf1f0e9f04e6fb4f8fef35e82c42aa5.pdf unit in-dpdp-act-2023-meity-pdf#s29_2',
    verbatim-'Every appeal under sub-section (1) shall be filed within a period of sixty days from the date of receipt of the order or direction appealed against and it shall be in such form and manner and shall be accompanied by such fee as may be prescribed.'
]).

% s 29(3): a late appeal for sufficient cause (appeal_period).
citation(in_dpdp_act_2023_s_29_3, [
    label-'Digital Personal Data Protection Act 2023 s 29(3) (late appeal entertained for sufficient cause)',
    ref-'https://www.meity.gov.in/static/uploads/2024/06/2bf1f0e9f04e6fb4f8fef35e82c42aa5.pdf unit in-dpdp-act-2023-meity-pdf#s29_3',
    verbatim-'The Appellate Tribunal may entertain an appeal after the expiry of the period specified in sub-section (2), if it is satisfied that there was sufficient cause for not preferring the appeal within that period.'
]).

% s 29(6): the six-month endeavour from presentation (appeal_disposal_target).
citation(in_dpdp_act_2023_s_29_6, [
    label-'Digital Personal Data Protection Act 2023 s 29(6) (endeavour to dispose of the appeal within six months of presentation)',
    ref-'https://www.meity.gov.in/static/uploads/2024/06/2bf1f0e9f04e6fb4f8fef35e82c42aa5.pdf unit in-dpdp-act-2023-meity-pdf#s29_6',
    verbatim-'endeavour shall be made by it to dispose of the appeal finally within six months from the date on which the appeal is presented to it'
]).

% s 29(7): reasons in writing where not disposed of within six months
% (appeal_disposal_target).
citation(in_dpdp_act_2023_s_29_7, [
    label-'Digital Personal Data Protection Act 2023 s 29(7) (reasons in writing for not disposing of the appeal within six months)',
    ref-'https://www.meity.gov.in/static/uploads/2024/06/2bf1f0e9f04e6fb4f8fef35e82c42aa5.pdf unit in-dpdp-act-2023-meity-pdf#s29_7',
    verbatim-'the Appellate Tribunal shall record its reasons in writing for not disposing of the appeal within that period'
]).

% s 36: the Central Government's call for information
% (information_call_status, non_disclosure_status).
citation(in_dpdp_act_2023_s_36, [
    label-'Digital Personal Data Protection Act 2023 s 36 (Central Government may require the Board, a Data Fiduciary or an intermediary to furnish information)',
    ref-'https://www.meity.gov.in/static/uploads/2024/06/2bf1f0e9f04e6fb4f8fef35e82c42aa5.pdf unit in-dpdp-act-2023-meity-pdf#s36',
    verbatim-'The Central Government may, for the purposes of this Act, require the Board and any Data Fiduciary or intermediary to furnish such information as it may call for.'
]).

% rule 1(4): rules 22 and 23 start eighteen months after publication
% (read as date(2027, 5, 13), a calculated date, reading (3)).
citation(in_dpdp_rules_2025_r_1_4, [
    label-'Digital Personal Data Protection Rules 2025 rule 1(4) (commencement of rules 22 and 23 eighteen months after publication)',
    ref-'https://www.meity.gov.in/static/uploads/2025/11/53450e6e5dc0bfa85ebd78686cadad39.pdf unit in-dpdp-rules-2025-meity-pdf#r1_4',
    verbatim-'Rules 3, 5 to 16, 22 and 23 shall come into force eighteen months after the date of publication of this Gazette.'
]).

% rule 22(1): the appeal filed in digital form (appeal_filing_requirements).
citation(in_dpdp_rules_2025_r_22_1, [
    label-'Digital Personal Data Protection Rules 2025 rule 22(1) (appeal filed in digital form)',
    ref-'https://www.meity.gov.in/static/uploads/2025/11/53450e6e5dc0bfa85ebd78686cadad39.pdf unit in-dpdp-rules-2025-meity-pdf#r22_1',
    verbatim-'it shall be filed in digital form as the Appellate Tribunal may decide'
]).

% rule 22(2): the fee as for a TRAI Act appeal unless reduced or waived, paid
% by UPI or an RBI-authorised payment system (appeal_filing_requirements).
citation(in_dpdp_rules_2025_r_22_2, [
    label-'Digital Personal Data Protection Rules 2025 rule 22(2) (appeal fee as under the TRAI Act 1997 unless reduced or waived; paid digitally)',
    ref-'https://www.meity.gov.in/static/uploads/2025/11/53450e6e5dc0bfa85ebd78686cadad39.pdf unit in-dpdp-rules-2025-meity-pdf#r22_2',
    verbatim-'unless reduced or waived by the Chairperson of the Appellate Tribunal at her discretion, and the same shall be payable digitally using the Unified Payments Interface or such other payment system authorised by the Reserve Bank of India'
]).

% rule 23(1): a call for a Seventh Schedule purpose through the authorised
% person, within the specified period (information_call_status).
citation(in_dpdp_rules_2025_r_23_1, [
    label-'Digital Personal Data Protection Rules 2025 rule 23(1) (call for information for a Seventh Schedule purpose through the authorised person)',
    ref-'https://www.meity.gov.in/static/uploads/2025/11/53450e6e5dc0bfa85ebd78686cadad39.pdf unit in-dpdp-rules-2025-meity-pdf#r23_1',
    verbatim-'The Central Government may, for such purposes of the Act as are specified in Seventh Schedule, acting through the corresponding authorised person specified in the said Schedule, require any Data Fiduciary or intermediary to furnish such information as may be called for, within the specified period as may be given in such.'
]).

% rule 23(2): non-disclosure of the furnishing without previous written
% permission (non_disclosure_status).
citation(in_dpdp_rules_2025_r_23_2, [
    label-'Digital Personal Data Protection Rules 2025 rule 23(2) (requirement not to disclose the furnishing without previous written permission)',
    ref-'https://www.meity.gov.in/static/uploads/2025/11/53450e6e5dc0bfa85ebd78686cadad39.pdf unit in-dpdp-rules-2025-meity-pdf#r23_2',
    verbatim-'the Central Government may require the Data Fiduciary or intermediary to not disclose such furnishing to affected Data Principal or any other person except with the previous permission, in writing, of the authorised person'
]).

% Seventh Schedule row 1: sovereignty, integrity, security.
citation(in_dpdp_rules_2025_sch_7_1, [
    label-'Digital Personal Data Protection Rules 2025 Seventh Schedule row 1 (State use in the interest of sovereignty and integrity of India or security of the State)',
    ref-'https://www.meity.gov.in/static/uploads/2025/11/53450e6e5dc0bfa85ebd78686cadad39.pdf unit in-dpdp-rules-2025-meity-pdf#sch7_1',
    verbatim-'Use, by the State or any of its instrumentalities, of personal data of a Data Principal in the interest of sovereignty and integrity of India or security of the State.'
]).

% Seventh Schedule row 2: functions and obligations under law.
citation(in_dpdp_rules_2025_sch_7_2, [
    label-'Digital Personal Data Protection Rules 2025 Seventh Schedule row 2 (State use for functions or obligations under law in force in India)',
    ref-'https://www.meity.gov.in/static/uploads/2025/11/53450e6e5dc0bfa85ebd78686cadad39.pdf unit in-dpdp-rules-2025-meity-pdf#sch7_2',
    verbatim-'Use, by the State or any of its instrumentalities, of personal data of a Data Principal for the following purposes, namely'
]).

% Seventh Schedule row 2(i): performance of a function under law.
citation(in_dpdp_rules_2025_sch_7_2_i, [
    label-'Digital Personal Data Protection Rules 2025 Seventh Schedule row 2(i) (performance of any function under any law in force in India)',
    ref-'https://www.meity.gov.in/static/uploads/2025/11/53450e6e5dc0bfa85ebd78686cadad39.pdf unit in-dpdp-rules-2025-meity-pdf#sch7_2_i',
    verbatim-'performance of any function under any law for the time being in force in India'
]).

% Seventh Schedule row 2(ii): disclosure to fulfil an obligation under law.
citation(in_dpdp_rules_2025_sch_7_2_ii, [
    label-'Digital Personal Data Protection Rules 2025 Seventh Schedule row 2(ii) (disclosure of information to fulfil an obligation under any law in force in India)',
    ref-'https://www.meity.gov.in/static/uploads/2025/11/53450e6e5dc0bfa85ebd78686cadad39.pdf unit in-dpdp-rules-2025-meity-pdf#sch7_2_ii',
    verbatim-'disclosure of any information for fulfilling any obligation under any law for the time being in force in India'
]).

% Seventh Schedule row 3: assessment for notifying a Significant Data Fiduciary.
citation(in_dpdp_rules_2025_sch_7_3, [
    label-'Digital Personal Data Protection Rules 2025 Seventh Schedule row 3 (assessment for notifying a Significant Data Fiduciary)',
    ref-'https://www.meity.gov.in/static/uploads/2025/11/53450e6e5dc0bfa85ebd78686cadad39.pdf unit in-dpdp-rules-2025-meity-pdf#sch7_3',
    verbatim-'Carrying out assessment for notifying any Data Fiduciary or class of Data Fiduciaries as Significant Data Fiduciary.'
]).

% ---- (2) CONTEXT keys (relied on by readings; never returned) -------

citation(in_dpdp_act_2023_s_2_a, [
    label-'Digital Personal Data Protection Act 2023 s 2(a) definition of Appellate Tribunal',
    ref-'https://www.meity.gov.in/static/uploads/2024/06/2bf1f0e9f04e6fb4f8fef35e82c42aa5.pdf unit in-dpdp-act-2023-meity-pdf#s2_a',
    verbatim-'“Appellate Tribunal” means the Telecom Disputes Settlement and Appellate Tribunal established under section 14 of the Telecom Regulatory Authority of India Act, 1997'
]).

citation(in_dpdp_act_2023_s_2_c, [
    label-'Digital Personal Data Protection Act 2023 s 2(c) definition of Board',
    ref-'https://www.meity.gov.in/static/uploads/2024/06/2bf1f0e9f04e6fb4f8fef35e82c42aa5.pdf unit in-dpdp-act-2023-meity-pdf#s2_c',
    verbatim-'“Board” means the Data Protection Board of India established by the Central Government under section 18'
]).

citation(in_dpdp_act_2023_s_2_i, [
    label-'Digital Personal Data Protection Act 2023 s 2(i) definition of Data Fiduciary',
    ref-'https://www.meity.gov.in/static/uploads/2024/06/2bf1f0e9f04e6fb4f8fef35e82c42aa5.pdf unit in-dpdp-act-2023-meity-pdf#s2_i',
    verbatim-'“Data Fiduciary” means any person who alone or in conjunction with other persons determines the purpose and means of processing of personal data'
]).

citation(in_dpdp_act_2023_s_2_s, [
    label-'Digital Personal Data Protection Act 2023 s 2(s) definition of person',
    ref-'https://www.meity.gov.in/static/uploads/2024/06/2bf1f0e9f04e6fb4f8fef35e82c42aa5.pdf unit in-dpdp-act-2023-meity-pdf#s2_s',
    verbatim-'“person” includes'
]).

