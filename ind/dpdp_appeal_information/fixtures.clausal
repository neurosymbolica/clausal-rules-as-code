% ---- Profiles: non_disclosure_status ----------------------------------

dpdp_appeal_information_profile_for(disclosure_barred, [
    attribute(section_36_in_force_on_call_date, true),
    attribute(call_date, date(2027, 5, 13)),
    attribute(recipient_kind, data_fiduciary_or_intermediary),
    attribute(non_disclosure_required, true),
    attribute(written_permission_to_disclose, false)
]).
dpdp_appeal_information_profile_for(disclosure_permitted, [
    attribute(section_36_in_force_on_call_date, true),
    attribute(call_date, date(2027, 5, 13)),
    attribute(recipient_kind, data_fiduciary_or_intermediary),
    attribute(non_disclosure_required, true),
    attribute(written_permission_to_disclose, true)
]).
dpdp_appeal_information_profile_for(non_disclosure_not_required, [
    attribute(section_36_in_force_on_call_date, true),
    attribute(call_date, date(2027, 5, 13)),
    attribute(recipient_kind, data_fiduciary_or_intermediary),
    attribute(non_disclosure_required, false)
]).
dpdp_appeal_information_profile_for(non_disclosure_call_before_rules, [
    attribute(section_36_in_force_on_call_date, true),
    attribute(call_date, date(2027, 5, 12)),
    attribute(recipient_kind, data_fiduciary_or_intermediary),
    attribute(non_disclosure_required, true),
    attribute(written_permission_to_disclose, false)
]).

% ---- Profiles: input check --------------------------------------------

dpdp_appeal_information_profile_for(malformed_profile, [
    attribute(appellant_aggrieved, maybe),
    attribute(colour, red)
]).
dpdp_appeal_information_profile_for(duplicate_call_date, [
    attribute(call_date, date(2027, 6, 1)),
    attribute(call_date, date(2027, 6, 2))
]).

% ---- Convenience wrapper ---------------------------------------------
dpdp_appeal_information_assess(Subject, Result) :-
    dpdp_appeal_information_profile_for(Subject, Profile),
    decide_dpdp_appeal_information(Profile, Result).

:- end_module(fixtures).
