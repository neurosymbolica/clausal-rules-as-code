% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% fixtures.clausal -- representative profiles for ind/dpdp_appeal_information.
% A TOP-LAYER consumer: it imports only the slice predicate it calls.
% Profile keys and subject ids are atoms and need no import.
%
% A profile is an ATTRIBUTE LIST [attribute(Key, Value), ...] (the order's
% typed input contract); dates are date(Y, M, D) terms.
%
% Every route of every query has a positive subject and a one-unit
% near-miss control:
%   appeal_period: filed on LAST_DAY / the day after (2027-01-10 receipt,
%     LAST_DAY 2027-03-11; 2027-12-01 receipt, LAST_DAY 2028-01-30); s 29
%     in force / not in force; Board order true / false; aggrieved true /
%     false / unsure; each missing key; a LAST_DAY in the year 10000.
%   appeal_filing_requirements: filed on 2027-05-13 (rule 22 starts) / on
%     2027-05-12.
%   appeal_disposal_target: disposed within the target; reference_date on
%     TARGET_DAY / the day after.
%   information_call_status: call on 2027-05-13 / 2027-05-12; Board,
%     other recipient; outside the Schedule; not through the authorised
%     person; each judgement unsure; s 36 not in force.
%   non_disclosure_status: barred / permitted by written permission;
%     not required; call before rule 23 starts.
%   input check: a wrong type with an unknown key; a duplicate key.
% =====================================================================

:- module(fixtures, [
    dpdp_appeal_information_subject/1,
    dpdp_appeal_information_profile_for/2,
    dpdp_appeal_information_assess/2
]).

:- use_module(ind/dpdp_appeal_information/dpdp_appeal_information, [decide_dpdp_appeal_information/2]).

% ---- Subject registry ------------------------------------------------

% appeal_period routes
dpdp_appeal_information_subject(appeal_filed_on_last_day).
dpdp_appeal_information_subject(appeal_filed_day_after_last_day).
dpdp_appeal_information_subject(appeal_across_year_on_last_day).
dpdp_appeal_information_subject(appeal_across_year_day_after_last_day).
dpdp_appeal_information_subject(appeal_last_day_in_year_ten_thousand).
dpdp_appeal_information_subject(section_29_not_in_force).
dpdp_appeal_information_subject(section_29_unstated).
dpdp_appeal_information_subject(order_not_of_board).
dpdp_appeal_information_subject(appellant_not_aggrieved).
dpdp_appeal_information_subject(board_order_unsure).
dpdp_appeal_information_subject(appellant_aggrieved_unsure).
dpdp_appeal_information_subject(receipt_date_missing).
dpdp_appeal_information_subject(filing_date_missing).
% appeal_filing_requirements routes
dpdp_appeal_information_subject(filed_on_day_rules_start).
dpdp_appeal_information_subject(filed_day_before_rules_start).
% appeal_disposal_target routes
dpdp_appeal_information_subject(disposed_within_target_leap_february).
dpdp_appeal_information_subject(reference_on_target_day).
dpdp_appeal_information_subject(reference_day_after_target_day).
% information_call_status routes
dpdp_appeal_information_subject(scheduled_call_on_day_rules_start).
dpdp_appeal_information_subject(call_day_before_rules_start).
dpdp_appeal_information_subject(call_to_board).
dpdp_appeal_information_subject(call_to_other_recipient).
dpdp_appeal_information_subject(section_36_not_in_force).
dpdp_appeal_information_subject(call_outside_schedule).
dpdp_appeal_information_subject(call_not_through_authorised_person).
dpdp_appeal_information_subject(schedule_purpose_unsure).
dpdp_appeal_information_subject(authorised_person_unsure).
% non_disclosure_status routes
dpdp_appeal_information_subject(disclosure_barred).
dpdp_appeal_information_subject(disclosure_permitted).
dpdp_appeal_information_subject(non_disclosure_not_required).
dpdp_appeal_information_subject(non_disclosure_call_before_rules).
% input check
dpdp_appeal_information_subject(malformed_profile).
dpdp_appeal_information_subject(duplicate_call_date).

% ---- Profiles: appeal_period ------------------------------------------

% receipt 2027-01-10: LAST_DAY 2027-03-11; filed on it: in_time.
dpdp_appeal_information_profile_for(appeal_filed_on_last_day, [
    attribute(section_29_in_force_on_filing_date, true),
    attribute(appeal_against_board_order_or_direction, true),
    attribute(appellant_aggrieved, true),
    attribute(order_receipt_date, date(2027, 1, 10)),
    attribute(appeal_filing_date, date(2027, 3, 11))
]).
% near miss: filed one day later.
dpdp_appeal_information_profile_for(appeal_filed_day_after_last_day, [
    attribute(section_29_in_force_on_filing_date, true),
    attribute(appeal_against_board_order_or_direction, true),
    attribute(appellant_aggrieved, true),
    attribute(order_receipt_date, date(2027, 1, 10)),
    attribute(appeal_filing_date, date(2027, 3, 12))
]).
% receipt 2027-12-01: LAST_DAY 2028-01-30.
dpdp_appeal_information_profile_for(appeal_across_year_on_last_day, [
    attribute(section_29_in_force_on_filing_date, true),
    attribute(appeal_against_board_order_or_direction, true),
    attribute(appellant_aggrieved, true),
    attribute(order_receipt_date, date(2027, 12, 1)),
    attribute(appeal_filing_date, date(2028, 1, 30))
]).
dpdp_appeal_information_profile_for(appeal_across_year_day_after_last_day, [
    attribute(section_29_in_force_on_filing_date, true),
    attribute(appeal_against_board_order_or_direction, true),
    attribute(appellant_aggrieved, true),
    attribute(order_receipt_date, date(2027, 12, 1)),
    attribute(appeal_filing_date, date(2028, 1, 31))
]).
% receipt 9999-12-31: LAST_DAY 10000-02-29 (a returned date may reach 10000).
dpdp_appeal_information_profile_for(appeal_last_day_in_year_ten_thousand, [
    attribute(section_29_in_force_on_filing_date, true),
    attribute(appeal_against_board_order_or_direction, true),
    attribute(appellant_aggrieved, true),
    attribute(order_receipt_date, date(9999, 12, 31)),
    attribute(appeal_filing_date, date(9999, 12, 31))
]).
% near miss of appeal_filed_on_last_day: s 29 not in force.
dpdp_appeal_information_profile_for(section_29_not_in_force, [
    attribute(section_29_in_force_on_filing_date, false),
    attribute(appeal_against_board_order_or_direction, true),
    attribute(appellant_aggrieved, true),
    attribute(order_receipt_date, date(2027, 1, 10)),
    attribute(appeal_filing_date, date(2027, 3, 11))
]).
dpdp_appeal_information_profile_for(section_29_unstated, [
    attribute(appeal_against_board_order_or_direction, true),
    attribute(appellant_aggrieved, true),
    attribute(order_receipt_date, date(2027, 1, 10)),
    attribute(appeal_filing_date, date(2027, 3, 11))
]).
dpdp_appeal_information_profile_for(order_not_of_board, [
    attribute(section_29_in_force_on_filing_date, true),
    attribute(appeal_against_board_order_or_direction, false),
    attribute(appellant_aggrieved, true),
    attribute(order_receipt_date, date(2027, 1, 10)),
    attribute(appeal_filing_date, date(2027, 3, 11))
]).
dpdp_appeal_information_profile_for(appellant_not_aggrieved, [
    attribute(section_29_in_force_on_filing_date, true),
    attribute(appeal_against_board_order_or_direction, true),
    attribute(appellant_aggrieved, false),
    attribute(order_receipt_date, date(2027, 1, 10)),
    attribute(appeal_filing_date, date(2027, 3, 11))
]).
dpdp_appeal_information_profile_for(board_order_unsure, [
    attribute(section_29_in_force_on_filing_date, true),
    attribute(appeal_against_board_order_or_direction, unsure),
    attribute(appellant_aggrieved, true),
    attribute(order_receipt_date, date(2027, 1, 10)),
    attribute(appeal_filing_date, date(2027, 3, 11))
]).
dpdp_appeal_information_profile_for(appellant_aggrieved_unsure, [
    attribute(section_29_in_force_on_filing_date, true),
    attribute(appeal_against_board_order_or_direction, true),
    attribute(appellant_aggrieved, unsure),
    attribute(order_receipt_date, date(2027, 1, 10)),
    attribute(appeal_filing_date, date(2027, 3, 11))
]).
dpdp_appeal_information_profile_for(receipt_date_missing, [
    attribute(section_29_in_force_on_filing_date, true),
    attribute(appeal_against_board_order_or_direction, true),
    attribute(appellant_aggrieved, true),
    attribute(appeal_filing_date, date(2027, 3, 11))
]).
dpdp_appeal_information_profile_for(filing_date_missing, [
    attribute(section_29_in_force_on_filing_date, true),
    attribute(appeal_against_board_order_or_direction, true),
    attribute(appellant_aggrieved, true),
    attribute(order_receipt_date, date(2027, 1, 10))
]).

% ---- Profiles: appeal_filing_requirements -----------------------------

% receipt 2027-04-01: LAST_DAY 2027-05-31; filed the day rule 22 starts.
dpdp_appeal_information_profile_for(filed_on_day_rules_start, [
    attribute(section_29_in_force_on_filing_date, true),
    attribute(appeal_against_board_order_or_direction, true),
    attribute(appellant_aggrieved, true),
    attribute(order_receipt_date, date(2027, 4, 1)),
    attribute(appeal_filing_date, date(2027, 5, 13))
]).
% near miss: filed the day before rule 22 starts.
dpdp_appeal_information_profile_for(filed_day_before_rules_start, [
    attribute(section_29_in_force_on_filing_date, true),
    attribute(appeal_against_board_order_or_direction, true),
    attribute(appellant_aggrieved, true),
    attribute(order_receipt_date, date(2027, 4, 1)),
    attribute(appeal_filing_date, date(2027, 5, 12))
]).

% ---- Profiles: appeal_disposal_target ---------------------------------

% filed 2027-08-31: TARGET_DAY 2028-02-29.
dpdp_appeal_information_profile_for(disposed_within_target_leap_february, [
    attribute(section_29_in_force_on_filing_date, true),
    attribute(appeal_filing_date, date(2027, 8, 31)),
    attribute(appeal_disposed_of_within_six_months, true)
]).
% filed 2027-03-11: TARGET_DAY 2027-09-11; asked on it.
dpdp_appeal_information_profile_for(reference_on_target_day, [
    attribute(section_29_in_force_on_filing_date, true),
    attribute(appeal_filing_date, date(2027, 3, 11)),
    attribute(appeal_disposed_of_within_six_months, false),
    attribute(reference_date, date(2027, 9, 11))
]).
% near miss: asked the day after.
dpdp_appeal_information_profile_for(reference_day_after_target_day, [
    attribute(section_29_in_force_on_filing_date, true),
    attribute(appeal_filing_date, date(2027, 3, 11)),
    attribute(appeal_disposed_of_within_six_months, false),
    attribute(reference_date, date(2027, 9, 12))
]).

% ---- Profiles: information_call_status ---------------------------------

dpdp_appeal_information_profile_for(scheduled_call_on_day_rules_start, [
    attribute(section_36_in_force_on_call_date, true),
    attribute(call_date, date(2027, 5, 13)),
    attribute(recipient_kind, data_fiduciary_or_intermediary),
    attribute(call_for_seventh_schedule_purpose, true),
    attribute(called_through_authorised_person, true)
]).
dpdp_appeal_information_profile_for(call_day_before_rules_start, [
    attribute(section_36_in_force_on_call_date, true),
    attribute(call_date, date(2027, 5, 12)),
    attribute(recipient_kind, data_fiduciary_or_intermediary),
    attribute(call_for_seventh_schedule_purpose, true),
    attribute(called_through_authorised_person, true)
]).
dpdp_appeal_information_profile_for(call_to_board, [
    attribute(section_36_in_force_on_call_date, true),
    attribute(call_date, date(2027, 6, 1)),
    attribute(recipient_kind, board)
]).
dpdp_appeal_information_profile_for(call_to_other_recipient, [
    attribute(section_36_in_force_on_call_date, true),
    attribute(call_date, date(2027, 6, 1)),
    attribute(recipient_kind, other_recipient)
]).
dpdp_appeal_information_profile_for(section_36_not_in_force, [
    attribute(section_36_in_force_on_call_date, false),
    attribute(call_date, date(2027, 5, 13)),
    attribute(recipient_kind, data_fiduciary_or_intermediary),
    attribute(call_for_seventh_schedule_purpose, true),
    attribute(called_through_authorised_person, true)
]).
dpdp_appeal_information_profile_for(call_outside_schedule, [
    attribute(section_36_in_force_on_call_date, true),
    attribute(call_date, date(2027, 5, 13)),
    attribute(recipient_kind, data_fiduciary_or_intermediary),
    attribute(call_for_seventh_schedule_purpose, false),
    attribute(called_through_authorised_person, true)
]).
dpdp_appeal_information_profile_for(call_not_through_authorised_person, [
    attribute(section_36_in_force_on_call_date, true),
    attribute(call_date, date(2027, 5, 13)),
    attribute(recipient_kind, data_fiduciary_or_intermediary),
    attribute(call_for_seventh_schedule_purpose, true),
    attribute(called_through_authorised_person, false)
]).
dpdp_appeal_information_profile_for(schedule_purpose_unsure, [
    attribute(section_36_in_force_on_call_date, true),
    attribute(call_date, date(2027, 5, 13)),
    attribute(recipient_kind, data_fiduciary_or_intermediary),
    attribute(call_for_seventh_schedule_purpose, unsure),
    attribute(called_through_authorised_person, true)
]).
dpdp_appeal_information_profile_for(authorised_person_unsure, [
    attribute(section_36_in_force_on_call_date, true),
    attribute(call_date, date(2027, 5, 13)),
    attribute(recipient_kind, data_fiduciary_or_intermediary),
    attribute(call_for_seventh_schedule_purpose, true),
    attribute(called_through_authorised_person, unsure)
