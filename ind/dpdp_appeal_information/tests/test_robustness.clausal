% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_robustness.clausal -- ROBUSTNESS of the input check dpdp_appeal_information_input_problems/2 for a
% PROFILE that is an attribute list [attribute(Key, Value), ...]: an empty list, a
% value that is not a list, an unknown key and a value outside its type each get exactly
% one answer. Written by the scaffold from the order's typed input contract
% (input_contract.types.profile: attribute_list), not by the producer;
% do not edit or delete.
% Run: python -m clausal.testing ind/dpdp_appeal_information/tests/test_robustness.clausal
% =====================================================================
:- module(test_robustness, []).
:- use_module(ind/dpdp_appeal_information/queries, [dpdp_appeal_information_input_problems/2]).

test(an_empty_attribute_list_gets_exactly_one_answer) :-
    findall(Problems, dpdp_appeal_information_input_problems([], Problems), Answers),
    Answers == [[]].

test(a_profile_that_is_not_a_list_gets_one_non_empty_answer) :-
    findall(Problems, dpdp_appeal_information_input_problems(not_a_profile, Problems), Answers),
    Answers = [[_|_]].

test(an_unknown_key_is_named) :-
    findall(Problems, dpdp_appeal_information_input_problems([attribute(not_a_key_of_the_contract, true)], Problems), Answers),
    Answers = [Problems],
    memberchk(unknown_key(not_a_key_of_the_contract), Problems).

test(a_value_outside_the_type_of_section_29_in_force_on_filing_date_is_named) :-
    findall(Problems, dpdp_appeal_information_input_problems([attribute(section_29_in_force_on_filing_date, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(section_29_in_force_on_filing_date), Problems).

test(a_value_outside_the_type_of_appeal_against_board_order_or_direction_is_named) :-
    findall(Problems, dpdp_appeal_information_input_problems([attribute(appeal_against_board_order_or_direction, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(appeal_against_board_order_or_direction), Problems).

test(a_value_outside_the_type_of_order_receipt_date_is_named) :-
    findall(Problems, dpdp_appeal_information_input_problems([attribute(order_receipt_date, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(order_receipt_date), Problems).

test(a_value_outside_the_type_of_recipient_kind_is_named) :-
    findall(Problems, dpdp_appeal_information_input_problems([attribute(recipient_kind, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(recipient_kind), Problems).

:- end_module(test_robustness).
