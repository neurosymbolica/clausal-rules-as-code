% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% dora_payment_related_incidents.clausal -- the "dora_payment_related_incidents" DETERMINATION for
% eu/dora_payment_related_incidents, self-contained top to bottom: its statutory VALUE facts
% (the entity kinds Article 23 reaches), its decision routes, its per-rule tests,
% its checklist and its verdict assembly.
%
% Source: Regulation (EU) 2022/2554 (DORA), Article 23, read with Article 2(1),
% points (a) to (d), Article 3, points (9), (11), (32) and (35) to (39),
% Article 18(3), point (a), and Article 19(1), first, third and sixth
% subparagraphs (pinned text 32022R2554, OJ L 333, 27.12.2022, p. 1).
%
% Two queries, each with exactly ONE solution for every profile:
%   payment_related_incident_status(Profile, Status, Citations)        steps S0 to S9
%   payment_related_incident_report_recipients(Profile, Result, Citations)  steps R0 to R11
% The input check (S0, R0) is the kernel's; it comes first. Every step is a set of
% complementary clauses on the state of a key (absent, or given(Value)), so no cut,
% no negation and no committed choice is needed: exactly one clause holds.
% Whether the incident is payment-related and whether it is major are the caller's
% judgements (readings (3), (4)); unsure is handed to a lawyer as open_textured/2.
% =====================================================================

:- module(dora_payment_related_incidents, [
    decide_dora_payment_related_incidents/2,
    dora_payment_related_incidents_status/2,
    dora_payment_related_incidents_checklist/2,
    dora_payment_related_incidents_decision_resolvable/1,
    dora_payment_related_incidents_status_values/1,
    payment_related_incident_status/3,
    payment_related_incident_report_recipients/3,
    chapter_requirements_and_article_19_reporting_apply/0,
    chapter_requirements_apply/0,
    not_a_payment_related_incident/0,
    not_an_article_23_entity/0,
    relevant_competent_authority/0,
    national_competent_authority_designated_under_directive_2013_36/0,
    directive_2022_2555_competent_authority_or_csirt/0,
    recipients/1,
    indeterminate/1,
    needs_legal_review/2,
    open_textured/2,
    inputs_relied_on/1,
    provenance/2,
    input_problems/1,
    unknown_key/1,
    wrong_type/1,
    duplicate_key/1
]).

:- use_module(eu/dora_payment_related_incidents/kernel, [
    dora_payment_related_incidents_input_problems/2,
    dora_payment_related_incidents_contract_keys/1
]).
:- use_module(eu/dora_payment_related_incidents/citations, [implements/1]).
:- use_module(formalize_lib, [profile_get/3, profile_lacks/2, eval_requirements/4]).
:- use_module(library(reif), [memberd_t/3]).

% ---- result constructors (exported, data only: no clauses) -----------
:- constructors([
    recipients(list),
    indeterminate(missing_keys),
    needs_legal_review(reason, context),
    open_textured(input, citation),
    inputs_relied_on(pairs),
    provenance(clause, citations),
    input_problems(problems),
    unknown_key(key),
    wrong_type(key),
    duplicate_key(key)
]).

% ---- result atoms (exported, never queries) ---------------------------
chapter_requirements_and_article_19_reporting_apply.
chapter_requirements_apply.
not_a_payment_related_incident.
not_an_article_23_entity.
relevant_competent_authority.
national_competent_authority_designated_under_directive_2013_36.
directive_2022_2555_competent_authority_or_csirt.

% ---- statutory VALUE facts owned by this determination ---------------
% The verdict vocabulary of payment_related_incident_status/3 (final answers).
dora_payment_related_incidents_status_values([
    chapter_requirements_and_article_19_reporting_apply,
    chapter_requirements_apply,
    not_a_payment_related_incident,
    not_an_article_23_entity
]).

% Reading (2): the six values of dora_entity_type that Article 23 reaches, each
% with the entity term it rests on. The institution exempted pursuant to
% Directive 2013/36/EU (Art 3, point (32)) is NOT in this table: Article 23 and
% Article 2(1), point (a), say only 'credit institutions' (open question (Q1)).
article_23_entity_type(credit_institution, cite(eu_reg_2022_2554_art_2_1_a)).
article_23_entity_type(payment_institution, cite(eu_reg_2022_2554_art_3_35)).
article_23_entity_type(exempted_payment_institution, cite(eu_reg_2022_2554_art_3_36)).
article_23_entity_type(account_information_service_provider, cite(eu_reg_2022_2554_art_3_37)).
article_23_entity_type(electronic_money_institution, cite(eu_reg_2022_2554_art_3_38)).
article_23_entity_type(exempted_electronic_money_institution, cite(eu_reg_2022_2554_art_3_39)).

% ---- profile plumbing --------------------------------------------------
% key_state(Profile, Key, State): State is absent, or given(Value). Called only
% after the input check has passed, so a present key occurs once.
key_state(Profile, Key, absent) :-
    profile_lacks(Profile, Key).
key_state(Profile, Key, given(Value)) :-
    profile_get(Profile, Key, Value).

% A judgement that is not false: it leaves the later keys able to matter.
judgement_open(true).
judgement_open(unsure).

% PAIRS: every Key-Value of a key the query reads that is present, in contract order.
relied_pairs(Profile, ReadKeys, Pairs) :-
    dora_payment_related_incidents_contract_keys(ContractKeys),
    findall(Key-Value,
            ( member(Key, ContractKeys),
              member(Key, ReadKeys),
              profile_get(Profile, Key, Value) ),
            Pairs).

status_pairs(Profile, Pairs) :-
    relied_pairs(Profile,
                 [dora_entity_type,
                  incident_is_operational_or_security_payment_related,
                  payment_related_incident_is_major],
                 Pairs).

recipients_pairs(Profile, Pairs) :-
    dora_payment_related_incidents_contract_keys(ContractKeys),
    relied_pairs(Profile, ContractKeys, Pairs).

% ---- reading (2): the entities reached --------------------------------
% Article 23 names the four kinds of Article 2(1), points (a) to (d); points (b)
% and (d) add their exempted kinds expressly ('including ... exempted').
entity_reach(EntityType, Reach) :-
    implements(eu_reg_2022_2554_art_23),
    implements(eu_reg_2022_2554_art_2_1_a),
    implements(eu_reg_2022_2554_art_2_1_b),
    implements(eu_reg_2022_2554_art_2_1_c),
    implements(eu_reg_2022_2554_art_2_1_d),
    findall(ReachedType, article_23_entity_type(ReachedType, _Citation), ReachedTypes),
    memberd_t(EntityType, ReachedTypes, IsReached),
    reach_of_truth(IsReached, Reach).

reach_of_truth(true, reached).
% Every other value, the institution exempted pursuant to Directive 2013/36/EU
% (Art 3, point (32)) included, is not reached (open question (Q1)).
reach_of_truth(false, not_reached) :-
    implements(eu_reg_2022_2554_art_3_32).

% ---- payment_related_incident_status/3 (steps S0 to S9) ---------------
payment_related_incident_status(Profile, Status, Citations) :-
    dora_payment_related_incidents_input_problems(Profile, Problems),
    status_after_check(Problems, Profile, Status, Citations).

% (S0) input problems first.
status_after_check([Problem|Problems], _Profile, input_problems([Problem|Problems]), []).
status_after_check([], Profile, Status, Citations) :-
    key_state(Profile, dora_entity_type, TypeState),
    status_by_type(TypeState, Profile, Status, Citations).

% (S1) the gate.
status_by_type(absent, _Profile, indeterminate([dora_entity_type]), []).
status_by_type(given(EntityType), Profile, Status, Citations) :-
    entity_reach(EntityType, Reach),
    status_by_reach(Reach, Profile, Status, Citations).

% (S2) a type not reached decides alone.
status_by_reach(not_reached, _Profile, not_an_article_23_entity, [cite(eu_reg_2022_2554_art_23)]) :-
    implements(eu_reg_2022_2554_art_23).
status_by_reach(reached, Profile, Status, Citations) :-
    implements(eu_reg_2022_2554_art_23),
    key_state(Profile, incident_is_operational_or_security_payment_related, IncidentState),
    key_state(Profile, payment_related_incident_is_major, MajorState),
    status_by_incident(IncidentState, MajorState, Profile, Status, Citations).

% (S3) not a payment-related incident decides alone.
status_by_incident(given(false), _MajorState, _Profile, not_a_payment_related_incident,
                   [cite(eu_reg_2022_2554_art_23), cite(eu_reg_2022_2554_art_3_9)]) :-
    implements(eu_reg_2022_2554_art_3_9).
% (S4)
status_by_incident(absent, _MajorState, _Profile,
                   indeterminate([incident_is_operational_or_security_payment_related]), []).
% (S5) <<DNUM>>: major is named before an unsure incident is referred.
status_by_incident(given(IncidentValue), absent, _Profile,
                   indeterminate([payment_related_incident_is_major]), []) :-
    judgement_open(IncidentValue).
% (S6)
status_by_incident(given(unsure), given(_MajorValue), Profile,
                   needs_legal_review(
                       open_textured(incident_is_operational_or_security_payment_related,
                                     cite(eu_reg_2022_2554_art_3_9)),
                       [inputs_relied_on(Pairs)]),
                   []) :-
    implements(eu_reg_2022_2554_art_3_9),
    status_pairs(Profile, Pairs).
% (S7)
status_by_incident(given(true), given(unsure), Profile,
                   needs_legal_review(
                       open_textured(payment_related_incident_is_major,
                                     cite(eu_reg_2022_2554_art_3_11)),
                       [inputs_relied_on(Pairs)]),
                   []) :-
    implements(eu_reg_2022_2554_art_3_11),
    status_pairs(Profile, Pairs).
% (S8)
status_by_incident(given(true), given(false), _Profile, chapter_requirements_apply,
                   [cite(eu_reg_2022_2554_art_23),
                    cite(eu_reg_2022_2554_art_3_9),
                    cite(eu_reg_2022_2554_art_3_11)]) :-
    implements(eu_reg_2022_2554_art_3_11).
% (S9) reading (5): a major one is subject to the reporting obligation of Art 19(1).
status_by_incident(given(true), given(true), _Profile,
                   chapter_requirements_and_article_19_reporting_apply,
                   [cite(eu_reg_2022_2554_art_23),
                    cite(eu_reg_2022_2554_art_3_9),
                    cite(eu_reg_2022_2554_art_3_11),
                    cite(eu_reg_2022_2554_art_18_3_a),
                    cite(eu_reg_2022_2554_art_19_1)]) :-
    implements(eu_reg_2022_2554_art_18_3_a).

% ---- payment_related_incident_report_recipients/3 (steps R0 to R11) ---
payment_related_incident_report_recipients(Profile, Result, Citations) :-
    dora_payment_related_incidents_input_problems(Profile, Problems),
    recipients_after_check(Problems, Profile, Result, Citations).

% (R0)
recipients_after_check([Problem|Problems], _Profile, input_problems([Problem|Problems]), []).
recipients_after_check([], Profile, Result, Citations) :-
    key_state(Profile, dora_entity_type, TypeState),
    recipients_by_type(TypeState, Profile, Result, Citations).

% (R1)
recipients_by_type(absent, _Profile, indeterminate([dora_entity_type]), []).
recipients_by_type(given(EntityType), Profile, Result, Citations) :-
    entity_reach(EntityType, Reach),
    recipients_by_reach(Reach, EntityType, Profile, Result, Citations).

% (R2)
recipients_by_reach(not_reached, _EntityType, _Profile, not_an_article_23_entity,
                    [cite(eu_reg_2022_2554_art_23)]) :-
    implements(eu_reg_2022_2554_art_23).
recipients_by_reach(reached, EntityType, Profile, Result, Citations) :-
    implements(eu_reg_2022_2554_art_23),
    key_state(Profile, incident_is_operational_or_security_payment_related, IncidentState),
    key_state(Profile, payment_related_incident_is_major, MajorState),
    recipients_by_incident(IncidentState, MajorState, EntityType, Profile, Result, Citations).

% (R3)
recipients_by_incident(given(false), _MajorState, _EntityType, _Profile,
                       not_a_payment_related_incident,
                       [cite(eu_reg_2022_2554_art_23), cite(eu_reg_2022_2554_art_3_9)]) :-
    implements(eu_reg_2022_2554_art_3_9).
% (R4)
recipients_by_incident(absent, _MajorState, _EntityType, _Profile,
                       indeterminate([incident_is_operational_or_security_payment_related]), []).
% (R5)
recipients_by_incident(given(IncidentValue), absent, _EntityType, _Profile,
                       indeterminate([payment_related_incident_is_major]), []) :-
    judgement_open(IncidentValue).
% (R6) not major: no list is due; the fact keys are not read.
recipients_by_incident(given(unsure), given(false), _EntityType, Profile,
                       needs_legal_review(
                           open_textured(incident_is_operational_or_security_payment_related,
                                         cite(eu_reg_2022_2554_art_3_9)),
                           [inputs_relied_on(Pairs)]),
                       []) :-
    implements(eu_reg_2022_2554_art_3_9),
    recipients_pairs(Profile, Pairs).
recipients_by_incident(given(true), given(false), _EntityType, _Profile,
                       chapter_requirements_apply,
                       [cite(eu_reg_2022_2554_art_23),
                        cite(eu_reg_2022_2554_art_3_9),
                        cite(eu_reg_2022_2554_art_3_11)]) :-
    implements(eu_reg_2022_2554_art_3_11).
% (R7) to (R11): major true or unsure.
recipients_by_incident(given(IncidentValue), given(MajorValue), EntityType, Profile, Result, Citations) :-
    implements(eu_reg_2022_2554_art_19_1),
    judgement_open(IncidentValue),
    judgement_open(MajorValue),
    significance_state(EntityType, Profile, SignificanceState),
    key_state(Profile, member_state_requires_reports_to_directive_2022_2555_authorities, MemberStateState),
    recipients_by_facts(SignificanceState, MemberStateState, IncidentValue, MajorValue,
                        Profile, Result, Citations).

% Reading (6): credit_institution_classified_as_significant is read only for a credit institution.
significance_state(credit_institution, Profile, SignificanceState) :-
    implements(eu_reg_2022_2554_art_19_1_third_subparagraph),
    key_state(Profile, credit_institution_classified_as_significant, SignificanceState).
significance_state(EntityType, _Profile, not_read) :-
    implements(eu_reg_2022_2554_art_19_1_third_subparagraph),
    dif(EntityType, credit_institution).

significance_settled(given(_SignificanceValue)).
significance_settled(not_read).

% (R7)
recipients_by_facts(absent, _MemberStateState, _IncidentValue, _MajorValue, _Profile,
                    indeterminate([credit_institution_classified_as_significant]), []).
% (R8)
recipients_by_facts(SignificanceState, absent, _IncidentValue, _MajorValue, _Profile,
                    indeterminate([member_state_requires_reports_to_directive_2022_2555_authorities]), []) :-
    significance_settled(SignificanceState).
% (R9)
recipients_by_facts(SignificanceState, given(_MemberStateValue), unsure, _MajorValue, Profile,
                    needs_legal_review(
                        open_textured(incident_is_operational_or_security_payment_related,
                                      cite(eu_reg_2022_2554_art_3_9)),
                        [inputs_relied_on(Pairs)]),
                    []) :-
    implements(eu_reg_2022_2554_art_3_9),
    significance_settled(SignificanceState),
    recipients_pairs(Profile, Pairs).
% (R10)
recipients_by_facts(SignificanceState, given(_MemberStateValue), true, unsure, Profile,
                    needs_legal_review(
                        open_textured(payment_related_incident_is_major,
                                      cite(eu_reg_2022_2554_art_3_11)),
                        [inputs_relied_on(Pairs)]),
                    []) :-
    implements(eu_reg_2022_2554_art_3_11),
    significance_settled(SignificanceState),
    recipients_pairs(Profile, Pairs).
% (R11)
recipients_by_facts(SignificanceState, given(MemberStateValue), true, true, _Profile,
                    recipients([PrimaryRecipient|AdditionalRecipients]),
                    [cite(eu_reg_2022_2554_art_23),
                     cite(eu_reg_2022_2554_art_3_9),
                     cite(eu_reg_2022_2554_art_3_11),
                     cite(eu_reg_2022_2554_art_18_3_a),
                     cite(eu_reg_2022_2554_art_19_1)]) :-
    implements(eu_reg_2022_2554_art_19_1),
    significance_settled(SignificanceState),
    primary_recipient(SignificanceState, PrimaryRecipient),
    additional_recipients(MemberStateValue, AdditionalRecipients).

% First and third subparagraphs of Art 19(1) (open question (Q2)).
primary_recipient(given(true), national_competent_authority_designated_under_directive_2013_36) :-
    implements(eu_reg_2022_2554_art_19_1_third_subparagraph).
primary_recipient(given(false), relevant_competent_authority) :-
    implements(eu_reg_2022_2554_art_19_1).
primary_recipient(not_read, relevant_competent_authority) :-
    implements(eu_reg_2022_2554_art_19_1).

% Sixth subparagraph of Art 19(1) (open question (Q10)).
additional_recipients(true, [directive_2022_2555_competent_authority_or_csirt]) :-
    implements(eu_reg_2022_2554_art_19_1_sixth_subparagraph).
additional_recipients(false, []) :-
    implements(eu_reg_2022_2554_art_19_1_sixth_subparagraph).

% ---- facade: verdict and status projection ----------------------------
decide_dora_payment_related_incidents(Profile, dora_payment_related_incidents_verdict(Status, Citations)) :-
    payment_related_incident_status(Profile, Status, Citations).

dora_payment_related_incidents_status(Profile, Status) :-
    decide_dora_payment_related_incidents(Profile, dora_payment_related_incidents_verdict(Status, _Citations)).

dora_payment_related_incidents_decision_resolvable(Profile) :-
    decide_dora_payment_related_incidents(Profile, _Verdict).

% ---- checklist: one row per requirement, each with cite(...) ---------
dora_payment_related_incidents_checklist(Profile, Items) :-
    dora_payment_related_incidents_input_problems(Profile, Problems),
    checklist_after_check(Problems, Profile, Items).

checklist_after_check([Problem|Problems], _Profile,
                      [item(well_formed_profile,
                            unmet(input_problems([Problem|Problems])),
                            cite(eu_reg_2022_2554_art_23))]).
checklist_after_check([], Profile, Items) :-
    eval_requirements([article_23_entity, payment_related_incident, major_incident],
                      Profile,
                      dora_payment_related_incidents_requirement,
                      Items).

dora_payment_related_incidents_requirement(article_23_entity, Profile, Status, cite(eu_reg_2022_2554_art_23)) :-
    implements(eu_reg_2022_2554_art_23),
    key_state(Profile, dora_entity_type, TypeState),
    entity_requirement_status(TypeState, Status).
dora_payment_related_incidents_requirement(payment_related_incident, Profile, Status, cite(eu_reg_2022_2554_art_3_9)) :-
    implements(eu_reg_2022_2554_art_3_9),
    key_state(Profile, incident_is_operational_or_security_payment_related, IncidentState),
    judgement_requirement_status(IncidentState,
                                 incident_is_operational_or_security_payment_related,
                                 not_a_payment_related_incident,
                                 Status).
dora_payment_related_incidents_requirement(major_incident, Profile, Status, cite(eu_reg_2022_2554_art_3_11)) :-
    implements(eu_reg_2022_2554_art_3_11),
    key_state(Profile, payment_related_incident_is_major, MajorState),
    judgement_requirement_status(MajorState,
                                 payment_related_incident_is_major,
                                 not_a_major_incident,
                                 Status).

entity_requirement_status(absent, unknown([dora_entity_type])).
entity_requirement_status(given(EntityType), Status) :-
    entity_reach(EntityType, Reach),
    reach_requirement_status(Reach, Status).

reach_requirement_status(reached, met).
reach_requirement_status(not_reached, unmet(not_an_article_23_entity)).

judgement_requirement_status(absent, Key, _Reason, unknown([Key])).
judgement_requirement_status(given(true), _Key, _Reason, met).
judgement_requirement_status(given(false), _Key, Reason, unmet(Reason)).
judgement_requirement_status(given(unsure), Key, _Reason, unknown([Key])).

% ---- tests ------------------------------------------------------------
test(a_major_incident_of_a_payment_institution_is_reported) :-
    findall(Status-Citations,
            payment_related_incident_status(
                [attribute(dora_entity_type, payment_institution),
                 attribute(incident_is_operational_or_security_payment_related, true),
                 attribute(payment_related_incident_is_major, true)],
                Status,
                Citations),
            Answers),
    Answers == [chapter_requirements_and_article_19_reporting_apply-
                [cite(eu_reg_2022_2554_art_23),
                 cite(eu_reg_2022_2554_art_3_9),
                 cite(eu_reg_2022_2554_art_3_11),
                 cite(eu_reg_2022_2554_art_18_3_a),
                 cite(eu_reg_2022_2554_art_19_1)]].

test(an_incident_that_is_not_major_brings_only_the_chapter) :-
    findall(Status,
            payment_related_incident_status(
                [attribute(dora_entity_type, exempted_electronic_money_institution),
                 attribute(incident_is_operational_or_security_payment_related, true),
                 attribute(payment_related_incident_is_major, false)],
                Status,
                _Citations),
            Answers),
    Answers == [chapter_requirements_apply].

test(the_institution_exempted_under_directive_2013_36_is_not_reached) :-
    findall(Status-Citations,
            payment_related_incident_status(
                [attribute(dora_entity_type, institution_exempted_pursuant_to_directive_2013_36),
                 attribute(incident_is_operational_or_security_payment_related, false)],
                Status,
                Citations),
            Answers),
    Answers == [not_an_article_23_entity-[cite(eu_reg_2022_2554_art_23)]].

test(the_entity_type_is_the_gate) :-
    findall(Status,
            payment_related_incident_status(
                [attribute(incident_is_operational_or_security_payment_related, false)],
                Status,
                _Citations),
            Answers),
    Answers == [indeterminate([dora_entity_type])].

test(not_payment_related_decides_alone) :-
    findall(Status,
            payment_related_incident_status(
                [attribute(dora_entity_type, credit_institution),
                 attribute(incident_is_operational_or_security_payment_related, false)],
                Status,
                _Citations),
            Answers),
    Answers == [not_a_payment_related_incident].

test(major_is_named_before_an_unsure_incident_is_referred) :-
    findall(Status,
            payment_related_incident_status(
                [attribute(dora_entity_type, credit_institution),
                 attribute(incident_is_operational_or_security_payment_related, unsure)],
                Status,
                _Citations),
            Answers),
    Answers == [indeterminate([payment_related_incident_is_major])].

test(an_unsure_incident_is_referred_with_the_pairs_the_status_reads) :-
    findall(Status-Citations,
            payment_related_incident_status(
                [attribute(credit_institution_classified_as_significant, true),
                 attribute(payment_related_incident_is_major, false),
                 attribute(incident_is_operational_or_security_payment_related, unsure),
                 attribute(dora_entity_type, credit_institution)],
                Status,
                Citations),
            Answers),
    Answers == [needs_legal_review(
                    open_textured(incident_is_operational_or_security_payment_related,
                                  cite(eu_reg_2022_2554_art_3_9)),
                    [inputs_relied_on([dora_entity_type-credit_institution,
                                       incident_is_operational_or_security_payment_related-unsure,
                                       payment_related_incident_is_major-false])])-[]].

test(an_input_problem_comes_first) :-
    findall(Status-Citations,
            payment_related_incident_status(
                [attribute(dora_entity_type, bank)],
                Status,
                Citations),
            Answers),
    Answers == [input_problems([wrong_type(dora_entity_type)])-[]].

test(a_significant_credit_institution_reports_to_the_national_authority) :-
    findall(Result-Citations,
            payment_related_incident_report_recipients(
                [attribute(dora_entity_type, credit_institution),
                 attribute(incident_is_operational_or_security_payment_related, true),
                 attribute(payment_related_incident_is_major, true),
                 attribute(credit_institution_classified_as_significant, true),
                 attribute(member_state_requires_reports_to_directive_2022_2555_authorities, true)],
                Result,
                Citations),
            Answers),
    Answers == [recipients([national_competent_authority_designated_under_directive_2013_36,
                            directive_2022_2555_competent_authority_or_csirt])-
                [cite(eu_reg_2022_2554_art_23),
                 cite(eu_reg_2022_2554_art_3_9),
                 cite(eu_reg_2022_2554_art_3_11),
                 cite(eu_reg_2022_2554_art_18_3_a),
                 cite(eu_reg_2022_2554_art_19_1)]].

test(a_payment_institution_reports_to_the_relevant_authority) :-
    findall(Result,
            payment_related_incident_report_recipients(
                [attribute(dora_entity_type, payment_institution),
                 attribute(incident_is_operational_or_security_payment_related, true),
                 attribute(payment_related_incident_is_major, true),
                 attribute(credit_institution_classified_as_significant, true),
                 attribute(member_state_requires_reports_to_directive_2022_2555_authorities, false)],
                Result,
                _Citations),
            Answers),
    Answers == [recipients([relevant_competent_authority])].

test(significance_is_named_before_an_unsure_judgement_is_referred) :-
    findall(Result,
            payment_related_incident_report_recipients(
                [attribute(dora_entity_type, credit_institution),
                 attribute(incident_is_operational_or_security_payment_related, unsure),
                 attribute(payment_related_incident_is_major, true)],
                Result,
                _Citations),
            Answers),
    Answers == [indeterminate([credit_institution_classified_as_significant])].

test(the_member_state_key_is_named_for_another_type) :-
    findall(Result,
            payment_related_incident_report_recipients(
                [attribute(dora_entity_type, account_information_service_provider),
                 attribute(incident_is_operational_or_security_payment_related, true),
                 attribute(payment_related_incident_is_major, unsure)],
                Result,
                _Citations),
            Answers),
    Answers == [indeterminate([member_state_requires_reports_to_directive_2022_2555_authorities])].

test(not_major_gives_no_list_and_reads_no_fact_key) :-
    findall(Result,
            payment_related_incident_report_recipients(
                [attribute(dora_entity_type, credit_institution),
                 attribute(incident_is_operational_or_security_payment_related, true),
                 attribute(payment_related_incident_is_major, false)],
                Result,
                _Citations),
            Answers),
    Answers == [chapter_requirements_apply].

test(an_unsure_major_is_referred_with_all_present_pairs) :-
    findall(Result,
            payment_related_incident_report_recipients(
                [attribute(dora_entity_type, electronic_money_institution),
                 attribute(incident_is_operational_or_security_payment_related, true),
                 attribute(payment_related_incident_is_major, unsure),
                 attribute(credit_institution_classified_as_significant, false),
                 attribute(member_state_requires_reports_to_directive_2022_2555_authorities, true)],
                Result,
                _Citations),
            Answers),
    Answers == [needs_legal_review(
                    open_textured(payment_related_incident_is_major,
                                  cite(eu_reg_2022_2554_art_3_11)),
                    [inputs_relied_on([dora_entity_type-electronic_money_institution,
                                       incident_is_operational_or_security_payment_related-true,
                                       payment_related_incident_is_major-unsure,
                                       credit_institution_classified_as_significant-false,
                                       member_state_requires_reports_to_directive_2022_2555_authorities-true])])].

test(a_type_not_reached_gives_no_recipients) :-
    findall(Result,
            payment_related_incident_report_recipients(
                [attribute(dora_entity_type, ict_third_party_service_provider)],
                Result,
                _Citations),
            Answers),
    Answers == [not_an_article_23_entity].

test(a_type_not_reached_is_not_a_report, fail) :-
    payment_related_incident_report_recipients(
        [attribute(dora_entity_type, ict_third_party_service_provider)],
        recipients(_Recipients),
        _Citations).

test(the_facade_verdict_carries_the_status) :-
    decide_dora_payment_related_incidents(
        [attribute(dora_entity_type, credit_institution),
         attribute(incident_is_operational_or_security_payment_related, true),
         attribute(payment_related_incident_is_major, false)],
        dora_payment_related_incidents_verdict(chapter_requirements_apply, _Citations)).

test(the_checklist_cites_each_requirement) :-
    dora_payment_related_incidents_checklist(
        [attribute(dora_entity_type, credit_institution),
         attribute(incident_is_operational_or_security_payment_related, true)],
        Items),
    member(item(article_23_entity, met, cite(eu_reg_2022_2554_art_23)), Items),
    member(item(payment_related_incident, met, cite(eu_reg_2022_2554_art_3_9)), Items),
    member(item(major_incident, unknown([payment_related_incident_is_major]), cite(eu_reg_2022_2554_art_3_11)), Items).

:- end_module(dora_payment_related_incidents).
