% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/dora_payment_related_incidents.
% Source: Regulation (EU) 2022/2554 (DORA), pinned text 32022R2554 (the original
% OJ text as published, OJ L 333, 27.12.2022, p. 1; pin folder
% eu/dora_payment_related_incidents/sources/).
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% Every record below is `status: verified` in citations-sources.yaml: its
% verbatim is an exact substring of the pinned unit text named in its ref.
%
% The first five keys are the CITATION VOCABULARY of the order: the only
% keys a result may return. The other keys are recorded for the provenance
% markers of the clauses that apply those provisions (the entity terms of
% Article 2(1), points (a) to (d), and Article 3, points (32), (35) to (39),
% and the third and sixth subparagraphs of Article 19(1)); they are never
% returned in a result.
%
% lint: canonical-citation-key -- the keys keep the corpus lexicon spelling
% (_lexicon/citations.yaml), eu_reg_2022_2554_art_..., which the order
% mandates verbatim; they are not renamed.
%
% PROVENANCE: every operative clause opens its body with implements(Key).
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

% lint: canonical-citation-key
citation(eu_reg_2022_2554_art_23, [label-'Regulation (EU) 2022/2554 (DORA) Art 23 (operational or security payment-related incidents concerning credit institutions, payment institutions, account information service providers, and electronic money institutions)', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj (pinned unit 32022R2554#art_023)', verbatim-'The requirements laid down in this Chapter shall also apply to operational or security payment-related incidents and to major operational or security payment-related incidents, where they concern credit institutions, payment institutions, account information service providers, and electronic money institutions.']).

% lint: canonical-citation-key
citation(eu_reg_2022_2554_art_3_9, [label-'Regulation (EU) 2022/2554 (DORA) Art 3, point (9), definition of operational or security payment-related incident', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj (pinned unit 32022R2554#point_003_9)', verbatim-'means a single event or a series of linked events unplanned by the financial entities referred to in Article 2(1), points (a) to (d), whether ICT-related or not, that has an adverse impact on the availability, authenticity, integrity or confidentiality of payment-related data, or on the payment-related services provided by the financial entity']).

% lint: canonical-citation-key
citation(eu_reg_2022_2554_art_3_11, [label-'Regulation (EU) 2022/2554 (DORA) Art 3, point (11), definition of major operational or security payment-related incident', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj (pinned unit 32022R2554#point_003_11)', verbatim-'means an operational or security payment-related incident that has a high adverse impact on the payment-related services provided']).

% lint: canonical-citation-key
citation(eu_reg_2022_2554_art_18_3_a, [label-'Regulation (EU) 2022/2554 (DORA) Art 18(3), point (a), major operational or security payment-related incidents subject to the reporting obligation of Art 19(1) (read only for those words)', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj (pinned unit 32022R2554#point_018.003_a)', verbatim-'major ICT-related incidents or, as applicable, major operational or security payment-related incidents, that are subject to the reporting obligation laid down in Article 19(1)']).

% lint: canonical-citation-key
citation(eu_reg_2022_2554_art_19_1, [label-'Regulation (EU) 2022/2554 (DORA) Art 19(1), first subparagraph, reporting obligation to the relevant competent authority', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj (pinned unit 32022R2554#parag_019.001)', verbatim-'Financial entities shall report major ICT-related incidents to the relevant competent authority as referred to in Article 46 in accordance with paragraph 4 of this Article.']).

% lint: canonical-citation-key
citation(eu_reg_2022_2554_art_19_1_third_subparagraph, [label-'Regulation (EU) 2022/2554 (DORA) Art 19(1), third subparagraph, credit institutions classified as significant report to the national competent authority designated under Art 4 of Directive 2013/36/EU', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj (pinned unit 32022R2554#parag_019.001)', verbatim-'Credit institutions classified as significant, in accordance with Article 6(4) of Regulation (EU) No 1024/2013, shall report major ICT-related incidents to the relevant national competent authority designated in accordance with Article 4 of Directive 2013/36/EU']).

% lint: canonical-citation-key
citation(eu_reg_2022_2554_art_19_1_sixth_subparagraph, [label-'Regulation (EU) 2022/2554 (DORA) Art 19(1), sixth subparagraph, Member State option for reports also to the competent authorities or CSIRTs under Directive (EU) 2022/2555', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj (pinned unit 32022R2554#parag_019.001)', verbatim-'Member States may additionally determine that some or all financial entities shall also provide the initial notification and each report referred to in paragraph 4 of this Article using the templates referred to in Article 20 to the competent authorities or the computer security incident response teams (CSIRTs) designated or established in accordance with Directive (EU) 2022/2555.']).

% lint: canonical-citation-key
citation(eu_reg_2022_2554_art_2_1_a, [label-'Regulation (EU) 2022/2554 (DORA) Art 2(1), point (a), credit institutions', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj (pinned unit 32022R2554#point_002.001_a)', verbatim-'(a) credit institutions;']).

% lint: canonical-citation-key
citation(eu_reg_2022_2554_art_2_1_b, [label-'Regulation (EU) 2022/2554 (DORA) Art 2(1), point (b), payment institutions, including exempted payment institutions', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj (pinned unit 32022R2554#point_002.001_b)', verbatim-'(b) payment institutions, including payment institutions exempted pursuant to Directive (EU) 2015/2366;']).

% lint: canonical-citation-key
citation(eu_reg_2022_2554_art_2_1_c, [label-'Regulation (EU) 2022/2554 (DORA) Art 2(1), point (c), account information service providers', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj (pinned unit 32022R2554#point_002.001_c)', verbatim-'(c) account information service providers;']).

% lint: canonical-citation-key
citation(eu_reg_2022_2554_art_2_1_d, [label-'Regulation (EU) 2022/2554 (DORA) Art 2(1), point (d), electronic money institutions, including exempted electronic money institutions', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj (pinned unit 32022R2554#point_002.001_d)', verbatim-'(d) electronic money institutions, including electronic money institutions exempted pursuant to Directive 2009/110/EC;']).

% lint: canonical-citation-key
citation(eu_reg_2022_2554_art_3_32, [label-'Regulation (EU) 2022/2554 (DORA) Art 3, point (32), definition of institution exempted pursuant to Directive 2013/36/EU', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj (pinned unit 32022R2554#point_003_32)', verbatim-'means an entity as referred to in Article 2(5), points (4) to (23), of Directive 2013/36/EU']).

% lint: canonical-citation-key
citation(eu_reg_2022_2554_art_3_35, [label-'Regulation (EU) 2022/2554 (DORA) Art 3, point (35), definition of payment institution', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj (pinned unit 32022R2554#point_003_35)', verbatim-'means a payment institution as defined in Article 4, point (4), of Directive (EU) 2015/2366']).

% lint: canonical-citation-key
citation(eu_reg_2022_2554_art_3_36, [label-'Regulation (EU) 2022/2554 (DORA) Art 3, point (36), definition of payment institution exempted pursuant to Directive (EU) 2015/2366', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj (pinned unit 32022R2554#point_003_36)', verbatim-'means a payment institution exempted pursuant to Article 32(1) of Directive (EU) 2015/2366']).

% lint: canonical-citation-key
citation(eu_reg_2022_2554_art_3_37, [label-'Regulation (EU) 2022/2554 (DORA) Art 3, point (37), definition of account information service provider', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj (pinned unit 32022R2554#point_003_37)', verbatim-'means an account information service provider as referred to in Article 33(1) of Directive (EU) 2015/2366']).

% lint: canonical-citation-key
citation(eu_reg_2022_2554_art_3_38, [label-'Regulation (EU) 2022/2554 (DORA) Art 3, point (38), definition of electronic money institution', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj (pinned unit 32022R2554#point_003_38)', verbatim-'means an electronic money institution as defined in Article 2, point (1), of Directive 2009/110/EC of the European Parliament and of the Council']).

% lint: canonical-citation-key
citation(eu_reg_2022_2554_art_3_39, [label-'Regulation (EU) 2022/2554 (DORA) Art 3, point (39), definition of electronic money institution exempted pursuant to Directive 2009/110/EC', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj (pinned unit 32022R2554#point_003_39)', verbatim-'means an electronic money institution benefitting from a waiver as referred to in Article 9(1) of Directive 2009/110/EC']).

% implements(Key): the provenance marker. It succeeds for every recorded key
% and fails for a key this module does not record.
implements(Key) :-
    citation(Key, _).

test(the_article_23_key_is_recorded) :-
    implements(eu_reg_2022_2554_art_23).
test(every_result_key_is_recorded) :-
    implements(eu_reg_2022_2554_art_3_9),
    implements(eu_reg_2022_2554_art_3_11),
    implements(eu_reg_2022_2554_art_18_3_a),
    implements(eu_reg_2022_2554_art_19_1).
test(a_shortened_key_is_not_recorded, fail) :-
    implements(dora_art_23).

:- end_module(citations).
