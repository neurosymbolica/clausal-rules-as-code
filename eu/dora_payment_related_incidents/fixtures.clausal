% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% fixtures.clausal -- representative profiles for eu/dora_payment_related_incidents.
% A TOP-LAYER consumer: it imports the determination slice's PUBLIC predicate it
% calls -- that is the whole import list. Profile keys and subject ids are atoms
% and need no import.
%
% A profile is an ATTRIBUTE LIST [attribute(Key, Value), ...] (the order's typed
% input contract). The order has no numeric threshold, so each route is paired
% with a ONE-KEY near-miss control: the same profile with one value changed,
% which lands on the neighbouring route.
%
% Routes and their pairs (status S-steps / recipients R-steps of THE LIMBS):
%   S9/R11 major_payment_institution_incident
%     <-> S8/R6 non_major_payment_institution_incident (major false)
%   R11 nca + csirt significant_credit_institution_major_incident
%     <-> R11 relevant + csirt non_significant_credit_institution_major_incident
%   R11 nca alone significant_credit_institution_without_member_state_determination
%     <-> S2/R2 exempted_institution_under_directive_2013_36_major_incident (type)
%   S2/R2 ict_third_party_service_provider_incident
%     <-> S9 exempted_payment_institution_incident (type)
%   S3/R3 not_payment_related_electronic_money_incident
%     <-> S8/R6 payment_related_electronic_money_incident (incident true)
%   S6/R9 unsure_payment_related_incident
%     <-> S9/R11 settled_payment_related_incident (incident true)
%   S7/R10 unsure_major_incident
%     <-> S9/R11 settled_major_incident (major true)
%   S1 missing_entity_type, S4 missing_incident_judgement,
%   S5 missing_major_with_unsure_incident, R7 missing_significance,
%   S0 malformed_entity_type, S0 unknown_key_profile.
% =====================================================================

:- module(fixtures, [
    dora_payment_related_incidents_subject/1,
    dora_payment_related_incidents_profile_for/2,
    dora_payment_related_incidents_assess/2
]).

:- use_module(eu/dora_payment_related_incidents/dora_payment_related_incidents, [decide_dora_payment_related_incidents/2]).

% ---- Subject registry ------------------------------------------------
dora_payment_related_incidents_subject(major_payment_institution_incident).
dora_payment_related_incidents_subject(non_major_payment_institution_incident).
dora_payment_related_incidents_subject(significant_credit_institution_major_incident).
dora_payment_related_incidents_subject(non_significant_credit_institution_major_incident).
dora_payment_related_incidents_subject(significant_credit_institution_without_member_state_determination).
dora_payment_related_incidents_subject(exempted_institution_under_directive_2013_36_major_incident).
dora_payment_related_incidents_subject(ict_third_party_service_provider_incident).
dora_payment_related_incidents_subject(exempted_payment_institution_incident).
dora_payment_related_incidents_subject(not_payment_related_electronic_money_incident).
dora_payment_related_incidents_subject(payment_related_electronic_money_incident).
dora_payment_related_incidents_subject(unsure_payment_related_incident).
dora_payment_related_incidents_subject(settled_payment_related_incident).
dora_payment_related_incidents_subject(unsure_major_incident).
dora_payment_related_incidents_subject(settled_major_incident).
dora_payment_related_incidents_subject(missing_entity_type).
dora_payment_related_incidents_subject(missing_incident_judgement).
dora_payment_related_incidents_subject(missing_major_with_unsure_incident).
dora_payment_related_incidents_subject(missing_significance).
dora_payment_related_incidents_subject(malformed_entity_type).
dora_payment_related_incidents_subject(unknown_key_profile).

% ---- Profiles --------------------------------------------------------
dora_payment_related_incidents_profile_for(major_payment_institution_incident, [
    attribute(dora_entity_type, payment_institution),
    attribute(incident_is_operational_or_security_payment_related, true),
    attribute(payment_related_incident_is_major, true),
    attribute(member_state_requires_reports_to_directive_2022_2555_authorities, false)
]).
dora_payment_related_incidents_profile_for(non_major_payment_institution_incident, [
    attribute(dora_entity_type, payment_institution),
    attribute(incident_is_operational_or_security_payment_related, true),
    attribute(payment_related_incident_is_major, false),
    attribute(member_state_requires_reports_to_directive_2022_2555_authorities, false)
]).
dora_payment_related_incidents_profile_for(significant_credit_institution_major_incident, [
    attribute(dora_entity_type, credit_institution),
    attribute(incident_is_operational_or_security_payment_related, true),
    attribute(payment_related_incident_is_major, true),
    attribute(credit_institution_classified_as_significant, true),
    attribute(member_state_requires_reports_to_directive_2022_2555_authorities, true)
]).
dora_payment_related_incidents_profile_for(non_significant_credit_institution_major_incident, [
    attribute(dora_entity_type, credit_institution),
    attribute(incident_is_operational_or_security_payment_related, true),
    attribute(payment_related_incident_is_major, true),
    attribute(credit_institution_classified_as_significant, false),
    attribute(member_state_requires_reports_to_directive_2022_2555_authorities, true)
]).
dora_payment_related_incidents_profile_for(significant_credit_institution_without_member_state_determination, [
    attribute(dora_entity_type, credit_institution),
    attribute(incident_is_operational_or_security_payment_related, true),
    attribute(payment_related_incident_is_major, true),
    attribute(credit_institution_classified_as_significant, true),
    attribute(member_state_requires_reports_to_directive_2022_2555_authorities, false)
]).
dora_payment_related_incidents_profile_for(exempted_institution_under_directive_2013_36_major_incident, [
    attribute(dora_entity_type, institution_exempted_pursuant_to_directive_2013_36),
    attribute(incident_is_operational_or_security_payment_related, true),
    attribute(payment_related_incident_is_major, true),
    attribute(credit_institution_classified_as_significant, true),
    attribute(member_state_requires_reports_to_directive_2022_2555_authorities, false)
]).
dora_payment_related_incidents_profile_for(ict_third_party_service_provider_incident, [
    attribute(dora_entity_type, ict_third_party_service_provider),
    attribute(incident_is_operational_or_security_payment_related, true),
    attribute(payment_related_incident_is_major, true)
]).
dora_payment_related_incidents_profile_for(exempted_payment_institution_incident, [
    attribute(dora_entity_type, exempted_payment_institution),
    attribute(incident_is_operational_or_security_payment_related, true),
    attribute(payment_related_incident_is_major, true)
]).
dora_payment_related_incidents_profile_for(not_payment_related_electronic_money_incident, [
    attribute(dora_entity_type, electronic_money_institution),
    attribute(incident_is_operational_or_security_payment_related, false),
    attribute(payment_related_incident_is_major, false)
]).
dora_payment_related_incidents_profile_for(payment_related_electronic_money_incident, [
    attribute(dora_entity_type, electronic_money_institution),
    attribute(incident_is_operational_or_security_payment_related, true),
    attribute(payment_related_incident_is_major, false)
]).
dora_payment_related_incidents_profile_for(unsure_payment_related_incident, [
    attribute(dora_entity_type, account_information_service_provider),
    attribute(incident_is_operational_or_security_payment_related, unsure),
    attribute(payment_related_incident_is_major, true),
    attribute(member_state_requires_reports_to_directive_2022_2555_authorities, false)
]).
dora_payment_related_incidents_profile_for(settled_payment_related_incident, [
    attribute(dora_entity_type, account_information_service_provider),
    attribute(incident_is_operational_or_security_payment_related, true),
    attribute(payment_related_incident_is_major, true),
    attribute(member_state_requires_reports_to_directive_2022_2555_authorities, false)
]).
dora_payment_related_incidents_profile_for(unsure_major_incident, [
    attribute(dora_entity_type, exempted_electronic_money_institution),
    attribute(incident_is_operational_or_security_payment_related, true),
    attribute(payment_related_incident_is_major, unsure),
    attribute(member_state_requires_reports_to_directive_2022_2555_authorities, true)
]).
dora_payment_related_incidents_profile_for(settled_major_incident, [
    attribute(dora_entity_type, exempted_electronic_money_institution),
    attribute(incident_is_operational_or_security_payment_related, true),
    attribute(payment_related_incident_is_major, true),
    attribute(member_state_requires_reports_to_directive_2022_2555_authorities, true)
]).
dora_payment_related_incidents_profile_for(missing_entity_type, [
    attribute(incident_is_operational_or_security_payment_related, false)
]).
dora_payment_related_incidents_profile_for(missing_incident_judgement, [
    attribute(dora_entity_type, payment_institution),
    attribute(payment_related_incident_is_major, true)
]).
dora_payment_related_incidents_profile_for(missing_major_with_unsure_incident, [
    attribute(dora_entity_type, credit_institution),
    attribute(incident_is_operational_or_security_payment_related, unsure)
]).
dora_payment_related_incidents_profile_for(missing_significance, [
    attribute(dora_entity_type, credit_institution),
    attribute(incident_is_operational_or_security_payment_related, true),
    attribute(payment_related_incident_is_major, true)
]).
dora_payment_related_incidents_profile_for(malformed_entity_type, [
    attribute(dora_entity_type, bank)
]).
dora_payment_related_incidents_profile_for(unknown_key_profile, [
    attribute(dora_entity_type, credit_institution),
    attribute(colour, red)
]).

% ---- Convenience wrapper ---------------------------------------------
dora_payment_related_incidents_assess(Subject, Result) :-
    dora_payment_related_incidents_profile_for(Subject, Profile),
    decide_dora_payment_related_incidents(Profile, Result).

:- end_module(fixtures).
