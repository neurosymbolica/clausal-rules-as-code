% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% fixtures.clausal -- representative profiles for eu/cra_art14_manufacturer_reporting.
% A TOP-LAYER consumer: it imports the determination slice's PUBLIC
% predicate it calls -- that is the whole import list. Profile keys and
% subject ids are atoms and need no import.
%
% A profile is an ATTRIBUTE LIST [attribute(Key, Value), ...] (the order's
% typed input contract). The EVENT, AWARENESS_DATE, STEP and HOURS_ELAPSED
% arguments are not profile keys: the public-interface tests pass them
% beside these profiles, with the boundary pairs (dates 2026-09-10 /
% 2026-09-11; hours 24 / 25 and 72 / 73).
%
% Every route has a positive case and a near-miss control one value away:
%   severity S1 (each limb) against S4 (both limbs false);
%   S2 (each missing key) against S3 (the same key given as unsure);
%   S0 input problems against the well-formed profile they differ from;
%   timeliness T2 for each undue-delay judgement (true / false / unsure).
% =====================================================================

:- module(fixtures, [
    cra_art14_manufacturer_reporting_subject/1,
    cra_art14_manufacturer_reporting_profile_for/2,
    cra_art14_manufacturer_reporting_assess/2
]).

:- use_module(eu/cra_art14_manufacturer_reporting/cra_art14_manufacturer_reporting, [decide_cra_art14_manufacturer_reporting/2]).

% ---- Subject registry ------------------------------------------------
cra_art14_manufacturer_reporting_subject(severe_by_protection_limb).
cra_art14_manufacturer_reporting_subject(severe_by_malicious_code_limb).
cra_art14_manufacturer_reporting_subject(not_severe_both_limbs_false).
cra_art14_manufacturer_reporting_subject(protection_limb_missing).
cra_art14_manufacturer_reporting_subject(malicious_code_limb_missing).
cra_art14_manufacturer_reporting_subject(protection_limb_unsure_referral).
cra_art14_manufacturer_reporting_subject(malicious_code_limb_unsure_referral).
cra_art14_manufacturer_reporting_subject(duplicate_key_problem).
cra_art14_manufacturer_reporting_subject(wrong_type_problem).
cra_art14_manufacturer_reporting_subject(unknown_key_problem).
cra_art14_manufacturer_reporting_subject(early_warning_without_undue_delay_given).
cra_art14_manufacturer_reporting_subject(early_warning_with_undue_delay).
cra_art14_manufacturer_reporting_subject(early_warning_undue_delay_unsure).
cra_art14_manufacturer_reporting_subject(notification_without_undue_delay_given).
cra_art14_manufacturer_reporting_subject(notification_with_undue_delay).
cra_art14_manufacturer_reporting_subject(notification_undue_delay_unsure).

% ---- Profiles --------------------------------------------------------
% S1 through limb (a); the other limb absent is never read.
cra_art14_manufacturer_reporting_profile_for(severe_by_protection_limb, [
    attribute(affects_protection_of_sensitive_or_important_data_or_functions, true)
]).
% S1 through limb (b), limb (a) false.
cra_art14_manufacturer_reporting_profile_for(severe_by_malicious_code_limb, [
    attribute(affects_protection_of_sensitive_or_important_data_or_functions, false),
    attribute(leads_to_malicious_code_in_product_or_user_systems, true)
]).
% S4: the near-miss control of both S1 cases (one limb flipped to false).
cra_art14_manufacturer_reporting_profile_for(not_severe_both_limbs_false, [
    attribute(affects_protection_of_sensitive_or_important_data_or_functions, false),
    attribute(leads_to_malicious_code_in_product_or_user_systems, false)
]).
% S2 naming limb (a): limb (b) false, limb (a) absent.
cra_art14_manufacturer_reporting_profile_for(protection_limb_missing, [
    attribute(leads_to_malicious_code_in_product_or_user_systems, false)
]).
% S2 naming limb (b): limb (a) unsure, limb (b) absent.
cra_art14_manufacturer_reporting_profile_for(malicious_code_limb_missing, [
    attribute(affects_protection_of_sensitive_or_important_data_or_functions, unsure)
]).
% S3 on limb (a): the control of malicious_code_limb_missing, limb (b) now given.
cra_art14_manufacturer_reporting_profile_for(protection_limb_unsure_referral, [
    attribute(affects_protection_of_sensitive_or_important_data_or_functions, unsure),
    attribute(leads_to_malicious_code_in_product_or_user_systems, false)
]).
% S3 on limb (b): one value away from not_severe_both_limbs_false.
cra_art14_manufacturer_reporting_profile_for(malicious_code_limb_unsure_referral, [
    attribute(affects_protection_of_sensitive_or_important_data_or_functions, false),
    attribute(leads_to_malicious_code_in_product_or_user_systems, unsure)
]).
% S0: a duplicated key (its values are not read).
cra_art14_manufacturer_reporting_profile_for(duplicate_key_problem, [
    attribute(affects_protection_of_sensitive_or_important_data_or_functions, true),
    attribute(affects_protection_of_sensitive_or_important_data_or_functions, true)
]).
% S0: a value outside the judgement type.
cra_art14_manufacturer_reporting_profile_for(wrong_type_problem, [
    attribute(affects_protection_of_sensitive_or_important_data_or_functions, yes)
]).
% S0: a key outside the contract.
cra_art14_manufacturer_reporting_profile_for(unknown_key_problem, [
    attribute(affects_protection_of_sensitive_or_important_data_or_functions, true),
    attribute(product_category, router)
]).
% T2 for the early warning.
cra_art14_manufacturer_reporting_profile_for(early_warning_without_undue_delay_given, [
    attribute(early_warning_without_undue_delay, true)
]).
cra_art14_manufacturer_reporting_profile_for(early_warning_with_undue_delay, [
    attribute(early_warning_without_undue_delay, false)
]).
cra_art14_manufacturer_reporting_profile_for(early_warning_undue_delay_unsure, [
    attribute(early_warning_without_undue_delay, unsure)
]).
% T2 for the notification.
cra_art14_manufacturer_reporting_profile_for(notification_without_undue_delay_given, [
    attribute(notification_without_undue_delay, true)
]).
cra_art14_manufacturer_reporting_profile_for(notification_with_undue_delay, [
    attribute(notification_without_undue_delay, false)
]).
cra_art14_manufacturer_reporting_profile_for(notification_undue_delay_unsure, [
    attribute(notification_without_undue_delay, unsure)
]).

% ---- Convenience wrapper ---------------------------------------------
cra_art14_manufacturer_reporting_assess(Subject, Result) :-
    cra_art14_manufacturer_reporting_profile_for(Subject, Profile),
    decide_cra_art14_manufacturer_reporting(Profile, Result).

:- end_module(fixtures).
