% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/cra_art14_manufacturer_reporting.
%
% Source of record: Regulation (EU) 2024/2847 (Cyber Resilience Act), the
% original OJ text as published, OJ L, 2024/2847, 20.11.2024 (CELEX
% 32024R2847; raw sha256
% fe0cca4a0caec50e7cf5a91432b94a19b211f86be8584fdba56372bdcea571ed; pin
% folder eu/cra_art14_manufacturer_reporting/sources/). No consolidated
% version is pinned.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order. Every
% verbatim below is an exact substring of the pinned unit text named in
% its ref (status: verified in citations-sources.yaml).
%
% Keys returned in answers (citation_vocabulary): Art 14(2)(a)-(c),
% Art 14(4)(a)-(c), Art 14(5) and its points (a) and (b), Art 14(6).
% Marker-only keys (implements/1, never in an answer): Art 14(1),
% Art 14(3), Art 71(2), and the Art 3 definitions the order reads as the
% caller's classification (points (1), (13), (40), (42), (43), (44)).
%
% PROVENANCE: every operative clause opens its body with implements(Key),
% Key a key recorded here.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

% ---- Article 3 definitions (the caller's classification) ----------
citation(eu_reg_2024_2847_art_3_1, [label-'Regulation (EU) 2024/2847 Art 3(1) definition of product with digital elements', ref-'OJ L, 2024/2847, 20.11.2024, Art 3(1) [32024R2847#point_003_1]', verbatim-'means a software or hardware product and its remote data processing solutions']).
citation(eu_reg_2024_2847_art_3_13, [label-'Regulation (EU) 2024/2847 Art 3(13) definition of manufacturer', ref-'OJ L, 2024/2847, 20.11.2024, Art 3(13) [32024R2847#point_003_13]', verbatim-'means a natural or legal person who develops or manufactures products with digital elements']).
citation(eu_reg_2024_2847_art_3_40, [label-'Regulation (EU) 2024/2847 Art 3(40) definition of vulnerability', ref-'OJ L, 2024/2847, 20.11.2024, Art 3(40) [32024R2847#point_003_40]', verbatim-'means a weakness, susceptibility or flaw of a product with digital elements that can be exploited by a cyber threat']).
citation(eu_reg_2024_2847_art_3_42, [label-'Regulation (EU) 2024/2847 Art 3(42) definition of actively exploited vulnerability', ref-'OJ L, 2024/2847, 20.11.2024, Art 3(42) [32024R2847#point_003_42]', verbatim-'means a vulnerability for which there is reliable evidence that a malicious actor has exploited it in a system without permission of the system owner']).
citation(eu_reg_2024_2847_art_3_43, [label-'Regulation (EU) 2024/2847 Art 3(43) definition of incident', ref-'OJ L, 2024/2847, 20.11.2024, Art 3(43) [32024R2847#point_003_43]', verbatim-'means an incident as defined in Article 6, point (6), of Directive (EU) 2022/2555']).
citation(eu_reg_2024_2847_art_3_44, [label-'Regulation (EU) 2024/2847 Art 3(44) definition of incident having an impact on the security of the product with digital elements', ref-'OJ L, 2024/2847, 20.11.2024, Art 3(44) [32024R2847#point_003_44]', verbatim-'means an incident that negatively affects or is capable of negatively affecting the ability of a product with digital elements to protect the availability, authenticity, integrity or confidentiality of data or functions']).

% ---- Article 14: actively exploited vulnerability -----------------
citation(eu_reg_2024_2847_art_14_1, [label-'Regulation (EU) 2024/2847 Art 14(1) duty to notify an actively exploited vulnerability', ref-'OJ L, 2024/2847, 20.11.2024, Art 14(1) [32024R2847#parag_014.001]', verbatim-'A manufacturer shall notify any actively exploited vulnerability contained in the product with digital elements that it becomes aware of simultaneously to the CSIRT designated as coordinator']).
citation(eu_reg_2024_2847_art_14_2_a, [label-'Regulation (EU) 2024/2847 Art 14(2)(a) early warning of an actively exploited vulnerability', ref-'OJ L, 2024/2847, 20.11.2024, Art 14(2)(a) [32024R2847#point_014.002_a]', verbatim-'an early warning notification of an actively exploited vulnerability, without undue delay and in any event within 24 hours of the manufacturer becoming aware of it']).
citation(eu_reg_2024_2847_art_14_2_b, [label-'Regulation (EU) 2024/2847 Art 14(2)(b) vulnerability notification', ref-'OJ L, 2024/2847, 20.11.2024, Art 14(2)(b) [32024R2847#point_014.002_b]', verbatim-'a vulnerability notification, without undue delay and in any event within 72 hours of the manufacturer becoming aware of the actively exploited vulnerability']).
citation(eu_reg_2024_2847_art_14_2_c, [label-'Regulation (EU) 2024/2847 Art 14(2)(c) final report on an actively exploited vulnerability', ref-'OJ L, 2024/2847, 20.11.2024, Art 14(2)(c) [32024R2847#point_014.002_c]', verbatim-'a final report, no later than 14 days after a corrective or mitigating measure is available']).

% ---- Article 14: severe incident ----------------------------------
citation(eu_reg_2024_2847_art_14_3, [label-'Regulation (EU) 2024/2847 Art 14(3) duty to notify a severe incident having an impact on the security of the product', ref-'OJ L, 2024/2847, 20.11.2024, Art 14(3) [32024R2847#parag_014.003]', verbatim-'A manufacturer shall notify any severe incident having an impact on the security of the product with digital elements that it becomes aware of']).
citation(eu_reg_2024_2847_art_14_4_a, [label-'Regulation (EU) 2024/2847 Art 14(4)(a) early warning of a severe incident', ref-'OJ L, 2024/2847, 20.11.2024, Art 14(4)(a) [32024R2847#point_014.004_a]', verbatim-'an early warning notification of a severe incident having an impact on the security of the product with digital elements, without undue delay and in any event within 24 hours of the manufacturer becoming aware of it']).
citation(eu_reg_2024_2847_art_14_4_b, [label-'Regulation (EU) 2024/2847 Art 14(4)(b) incident notification', ref-'OJ L, 2024/2847, 20.11.2024, Art 14(4)(b) [32024R2847#point_014.004_b]', verbatim-'an incident notification, without undue delay and in any event within 72 hours of the manufacturer becoming aware of the incident']).
citation(eu_reg_2024_2847_art_14_4_c, [label-'Regulation (EU) 2024/2847 Art 14(4)(c) final report on a severe incident', ref-'OJ L, 2024/2847, 20.11.2024, Art 14(4)(c) [32024R2847#point_014.004_c]', verbatim-'a final report, within one month after the submission of the incident notification under point (b)']).

% ---- Article 14(5): severity --------------------------------------
citation(eu_reg_2024_2847_art_14_5, [label-'Regulation (EU) 2024/2847 Art 14(5) severe incident having an impact on the security of the product', ref-'OJ L, 2024/2847, 20.11.2024, Art 14(5) [32024R2847#parag_014.005]', verbatim-'an incident having an impact on the security of the product with digital elements shall be considered to be severe where']).
citation(eu_reg_2024_2847_art_14_5_a, [label-'Regulation (EU) 2024/2847 Art 14(5)(a) protection of sensitive or important data or functions', ref-'OJ L, 2024/2847, 20.11.2024, Art 14(5)(a) [32024R2847#point_014.005_a]', verbatim-'it negatively affects or is capable of negatively affecting the ability of a product with digital elements to protect the availability, authenticity, integrity or confidentiality of sensitive or important data or functions']).
citation(eu_reg_2024_2847_art_14_5_b, [label-'Regulation (EU) 2024/2847 Art 14(5)(b) introduction or execution of malicious code', ref-'OJ L, 2024/2847, 20.11.2024, Art 14(5)(b) [32024R2847#point_014.005_b]', verbatim-'it has led or is capable of leading to the introduction or execution of malicious code in a product with digital elements or in the network and information systems of a user of the product with digital elements']).

% ---- Article 14(6): intermediate report on request ----------------
citation(eu_reg_2024_2847_art_14_6, [label-'Regulation (EU) 2024/2847 Art 14(6) intermediate report on request of the coordinator CSIRT', ref-'OJ L, 2024/2847, 20.11.2024, Art 14(6) [32024R2847#parag_014.006]', verbatim-'the CSIRT designated as coordinator initially receiving the notification may request manufacturers to provide an intermediate report']).

% ---- Article 71(2): date of application of Article 14 -------------
citation(eu_reg_2024_2847_art_71_2, [label-'Regulation (EU) 2024/2847 Art 71(2) second sentence, application of Article 14', ref-'OJ L, 2024/2847, 20.11.2024, Art 71(2) [32024R2847#parag_071.002]', verbatim-'However, Article 14 shall apply from 11 September 2026']).

% implements(Key): the provenance marker. It succeeds for every recorded key
% and fails for a key not recorded here; it never changes an answer.
implements(Key) :-
    citation(Key, _).

:- end_module(citations).
