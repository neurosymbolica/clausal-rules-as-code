% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/dora_register_of_information.
%
% Instruments (pinned original OJ texts, pin folder
% eu/dora_register_of_information/sources/; no consolidated version pinned):
%   - Regulation (EU) 2022/2554 (the Digital Operational Resilience Act,
%     DORA), CELEX 32022R2554, OJ L 333, 27.12.2022, p. 1: Article 28(3);
%   - Commission Implementing Regulation (EU) 2024/2956 (the ITS on the
%     standard templates for the register of information), CELEX 32024R2956:
%     Articles 2 to 6.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order. Each
% verbatim is an exact substring of the pinned unit text quoted in the order.
%
% The keys are the corpus lexicon's canonical keys (_lexicon/citations.yaml):
% fourteen paragraph keys (THE FIXED CITATIONS) and seventeen point keys
% (ITS Art 3(2)(a)-(b), ITS Art 5(1)(a)-(o)). No other key is recorded:
% every provision the rules decide or apply is one of these (the deferred
% and excluded provisions, DORA Art 28(1), 28(2), 28(4)-(10), ITS Art 1,
% Art 5(2) and Art 7, are read by no rule).
%
% PROVENANCE: implements(Key) succeeds for every recorded key; every operative
% clause of the slice opens its body with implements(Key).
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1,
    paragraph_of/2,
    fixed_citations/1
]).

implements(Key) :-
    citation(Key, _).

% ---- DORA, Regulation (EU) 2022/2554 -------------------------------
citation(eu_reg_2022_2554_art_28_3, [label-'Regulation (EU) 2022/2554 (DORA) Art 28(3), first to fifth subparagraphs (register of information; documentation; yearly report; register on request; information on planned arrangements and on functions become critical or important)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (unit 32022R2554#parag_028.003)', verbatim-'financial entities shall maintain and update at entity level, and at sub-consolidated and consolidated levels, a register of information in relation to all contractual arrangements on the use of ICT services provided by ICT third-party service providers']).

% ---- ITS, Implementing Regulation (EU) 2024/2956: paragraphs -------
citation(eu_reg_2024_2956_art_2, [label-'Implementing Regulation (EU) 2024/2956 (ITS) Art 2 (ranking of ICT third-party service providers in the supply chain)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32024R2956 (unit 32024R2956#art_002)', verbatim-'Financial entities shall assign a rank to each ICT third-party service provider.']).
citation(eu_reg_2024_2956_art_3_1, [label-'Implementing Regulation (EU) 2024/2956 (ITS) Art 3(1) (use of the templates of Annexes I to IV at each level)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32024R2956 (unit 32024R2956#parag_003.001)', verbatim-'Financial entities shall use the templates set out in Annex I to IV to maintain and update the register of information']).
citation(eu_reg_2024_2956_art_3_2, [label-'Implementing Regulation (EU) 2024/2956 (ITS) Art 3(2) (what the templates include)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32024R2956 (unit 32024R2956#parag_003.002)', verbatim-'Financial entities shall ensure that the templates referred to in paragraph 1 include all of the following']).
citation(eu_reg_2024_2956_art_3_3, [label-'Implementing Regulation (EU) 2024/2956 (ITS) Art 3(3) (accuracy and consistency; regular review and prompt correction; consistency at group levels)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32024R2956 (unit 32024R2956#parag_003.003)', verbatim-'Financial entities shall review the information contained in the templates regularly and shall promptly correct any errors or discrepancies detected.']).
citation(eu_reg_2024_2956_art_3_4, [label-'Implementing Regulation (EU) 2024/2956 (ITS) Art 3(4) (principles of data quality, points (a) to (f))', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32024R2956 (unit 32024R2956#parag_003.004)', verbatim-'adhere to the following principles of data quality']).
citation(eu_reg_2024_2956_art_3_5, [label-'Implementing Regulation (EU) 2024/2956 (ITS) Art 3(5) (LEI or EUID of ICT third-party service providers that are legal persons)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32024R2956 (unit 32024R2956#parag_003.005)', verbatim-'to identify all of their ICT third-party service providers that are legal persons, except for individuals acting in a business capacity']).
citation(eu_reg_2024_2956_art_3_6, [label-'Implementing Regulation (EU) 2024/2956 (ITS) Art 3(6) (LEI or EUID of subcontractors underpinning ICT services supporting critical or important functions)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32024R2956 (unit 32024R2956#parag_003.006)', verbatim-'use a valid and active LEI or provide their EUID, and where available both of these identifiers, except if those subcontractors are individuals acting in a business capacity']).
citation(eu_reg_2024_2956_art_4_1, [label-'Implementing Regulation (EU) 2024/2956 (ITS) Art 4(1) (each template a table)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32024R2956 (unit 32024R2956#parag_004.001)', verbatim-'each template composing the register of information shall be a table with a predefined number of columns and an indefinite number of rows']).
citation(eu_reg_2024_2956_art_4_2, [label-'Implementing Regulation (EU) 2024/2956 (ITS) Art 4(2) (a single value per data element)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32024R2956 (unit 32024R2956#parag_004.002)', verbatim-'Financial entities shall complete each data element with a single value.']).
citation(eu_reg_2024_2956_art_4_3, [label-'Implementing Regulation (EU) 2024/2956 (ITS) Art 4(3) (all data elements completed at each level that applies)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32024R2956 (unit 32024R2956#parag_004.003)', verbatim-'Financial entities shall complete all data elements in the register of information at entity level, sub-consolidated and consolidated level, as applicable.']).
citation(eu_reg_2024_2956_art_5_1, [label-'Implementing Regulation (EU) 2024/2956 (ITS) Art 5(1) (content of the register, points (a) to (o))', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32024R2956 (unit 32024R2956#parag_005.001)', verbatim-'Financial entities shall include in the register of information, in accordance with the instructions set out in Annex I, the following information']).
citation(eu_reg_2024_2956_art_6_1, [label-'Implementing Regulation (EU) 2024/2956 (ITS) Art 6(1) (entities included in a group register under sectorial Union legislation)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32024R2956 (unit 32024R2956#parag_006.001)', verbatim-'the parent undertakings shall take into account the relevant sectorial Union legislation when determining which entities to be included in the register of information']).
citation(eu_reg_2024_2956_art_6_2, [label-'Implementing Regulation (EU) 2024/2956 (ITS) Art 6(2) (a group register includes all financial entities and ICT intra-group service providers of the sub-group or group)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32024R2956 (unit 32024R2956#parag_006.002)', verbatim-'shall include all financial entities and ICT intra-group service providers, which are part of the sub-group and group']).

