% ---- tests -------------------------------------------------------
test(thirty_one_citation_records) :-
    findall(Key, citation(Key, _), Keys),
    length(Keys, 31),
    sort(Keys, Distinct),
    length(Distinct, 31).
test(every_recorded_key_has_a_paragraph) :-
    findall(Key, citation(Key, _), Keys),
    findall(Key, (member(Key, Keys), paragraph_of(Key, _)), WithParagraph),
    WithParagraph == Keys.
test(every_paragraph_is_recorded) :-
    findall(Paragraph, (paragraph_of(_, Paragraph), citation(Paragraph, _)), Recorded),
    findall(Paragraph, paragraph_of(_, Paragraph), Paragraphs),
    Recorded == Paragraphs.
test(fixed_citations_are_the_fourteen_paragraphs) :-
    fixed_citations(Citations),
    length(Citations, 14),
    findall(cite(Key), paragraph_of(Key, Key), Paragraphs),
    msort(Citations, SortedCitations),
    msort(Paragraphs, SortedParagraphs),
    SortedCitations == SortedParagraphs.
test(a_point_maps_to_its_paragraph) :-
    paragraph_of(eu_reg_2024_2956_art_5_1_n, eu_reg_2024_2956_art_5_1),
    paragraph_of(eu_reg_2024_2956_art_3_2_a, eu_reg_2024_2956_art_3_2).
test(implements_a_recorded_key) :-
    implements(eu_reg_2022_2554_art_28_3).
test(implements_refuses_an_unrecorded_key, fail) :-
    implements(eu_reg_2022_2554_art_28).

:- end_module(citations).
