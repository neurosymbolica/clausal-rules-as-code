% ---- the PARAGRAPHS of a citation key (THE LIMBS) -----------------
% paragraph_of(CitationKey, ParagraphKey): a point key is replaced by the key of
% the paragraph the point belongs to; every other key is its own paragraph.
paragraph_of(eu_reg_2022_2554_art_28_3, eu_reg_2022_2554_art_28_3).
paragraph_of(eu_reg_2024_2956_art_2, eu_reg_2024_2956_art_2).
