    register_maintained_and_updated_at_consolidated_level/0,
    arrangements_documented_distinguishing_critical_or_important_functions/0,
    reported_to_competent_authorities_at_least_yearly/0,
    register_made_available_to_competent_authority_on_request/0,
    competent_authority_informed_of_planned_arrangement/0,
    competent_authority_informed_that_function_has_become_critical_or_important/0,
    rank_assigned_to_each_ict_third_party_service_provider/0,
    templates_include_information_on_all_ict_services_of_direct_providers/0,
    templates_include_information_on_subcontractors_underpinning_critical_or_important_functions/0,
    template_information_meets_data_quality_principles/0,
    template_information_reviewed_regularly_and_errors_corrected/0,
    entity_level_information_consistent_with_sub_consolidated_level/0,
    entity_level_information_consistent_with_consolidated_level/0,
    providers_identified_by_legal_entity_identifier_or_european_unique_identifier/0,
    subcontractors_identified_by_legal_entity_identifier_or_european_unique_identifier/0,
    data_elements_completed_with_single_values/0,
    all_data_elements_completed_at_each_applicable_level/0,
    register_includes_general_information_on_maintaining_entity/0,
    register_includes_general_information_on_entities_in_consolidation/0,
    register_includes_identification_of_branches_outside_home_country/0,
    register_includes_general_information_on_contractual_arrangements/0,
    register_includes_specific_information_on_contractual_arrangements/0,
    register_includes_links_between_intra_group_and_other_arrangements/0,
    register_includes_entities_signing_arrangements_for_receiving_ict_services/0,
