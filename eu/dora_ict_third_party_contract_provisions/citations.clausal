% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/dora_ict_third_party_contract_provisions.
%
% Instrument: Regulation (EU) 2022/2554 of the European Parliament and of
% the Council of 14 December 2022 on digital operational resilience for the
% financial sector (DORA), CELEX 32022R2554, OJ L 333, 27.12.2022, p. 1
% (the original OJ text as published; no consolidated version is pinned).
% Pin folder: eu/dora_ict_third_party_contract_provisions/sources/.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% Every verbatim below is an exact substring of the pinned unit text named
% in its ref (status: verified in citations-sources.yaml).
%
% Keys follow the canonical lexicon scheme (_lexicon/citations.yaml): four
% paragraph keys (Art 28(7), Art 30(1), Art 30(2), Art 30(3)) and one key
% per lettered point formalised as an element. Art 30(3) also anchors the
% microenterprise derogation in its closing words and the critical or
% important function test of its lead words. Point (e) of Art 30(3) anchors
% both monitoring elements (reading (7)).
%
% Art 28(1)(b) and Art 28(2) are quoted for reading (5) only and decide no
% condition; the deferred and excluded provisions are read by no limb. They
% get no key.
%
% PROVENANCE: every operative clause opens its body with implements(Key);
% implements/1 succeeds exactly for a key recorded here.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

% ---- Art 28(7): termination circumstances -----------------------
citation(eu_reg_2022_2554_art_28_7, [label-'Regulation (EU) 2022/2554 (DORA) Art 28(7), lead words (termination circumstances)', ref-'32022R2554#parag_028.007, OJ L 333, 27.12.2022, p. 1', verbatim-'Financial entities shall ensure that contractual arrangements on the use of ICT services may be terminated in any of the following circumstances']).
citation(eu_reg_2022_2554_art_28_7_a, [label-'Regulation (EU) 2022/2554 (DORA) Art 28(7)(a) (significant breach)', ref-'32022R2554#point_028.007_a, OJ L 333, 27.12.2022, p. 1', verbatim-'significant breach by the ICT third-party service provider of applicable laws, regulations or contractual terms']).
citation(eu_reg_2022_2554_art_28_7_b, [label-'Regulation (EU) 2022/2554 (DORA) Art 28(7)(b) (circumstances altering performance)', ref-'32022R2554#point_028.007_b, OJ L 333, 27.12.2022, p. 1', verbatim-'circumstances identified throughout the monitoring of ICT third-party risk that are deemed capable of altering the performance of the functions provided through the contractual arrangement']).
citation(eu_reg_2022_2554_art_28_7_c, [label-'Regulation (EU) 2022/2554 (DORA) Art 28(7)(c) (evidenced weaknesses in ICT risk management)', ref-'32022R2554#point_028.007_c, OJ L 333, 27.12.2022, p. 1', verbatim-'evidenced weaknesses pertaining to its overall ICT risk management']).
citation(eu_reg_2022_2554_art_28_7_d, [label-'Regulation (EU) 2022/2554 (DORA) Art 28(7)(d) (supervision impeded)', ref-'32022R2554#point_028.007_d, OJ L 333, 27.12.2022, p. 1', verbatim-'where the competent authority can no longer effectively supervise the financial entity as a result of the conditions of, or circumstances related to, the respective contractual arrangement']).

% ---- Art 30(1): one written document -----------------------------
citation(eu_reg_2022_2554_art_30_1, [label-'Regulation (EU) 2022/2554 (DORA) Art 30(1) (rights and obligations in one written document)', ref-'32022R2554#parag_030.001, OJ L 333, 27.12.2022, p. 1', verbatim-'The rights and obligations of the financial entity and of the ICT third-party service provider shall be clearly allocated and set out in writing.']).

% ---- Art 30(2): elements of every arrangement --------------------
citation(eu_reg_2022_2554_art_30_2, [label-'Regulation (EU) 2022/2554 (DORA) Art 30(2), lead words (elements of every arrangement)', ref-'32022R2554#parag_030.002, OJ L 333, 27.12.2022, p. 1', verbatim-'The contractual arrangements on the use of ICT services shall include at least the following elements']).
citation(eu_reg_2022_2554_art_30_2_a, [label-'Regulation (EU) 2022/2554 (DORA) Art 30(2)(a) (description of functions, services and subcontracting)', ref-'32022R2554#point_030.002_a, OJ L 333, 27.12.2022, p. 1', verbatim-'a clear and complete description of all functions and ICT services to be provided by the ICT third-party service provider']).
citation(eu_reg_2022_2554_art_30_2_b, [label-'Regulation (EU) 2022/2554 (DORA) Art 30(2)(b) (service and data locations)', ref-'32022R2554#point_030.002_b, OJ L 333, 27.12.2022, p. 1', verbatim-'the locations, namely the regions or countries, where the contracted or subcontracted functions and ICT services are to be provided and where data is to be processed']).
citation(eu_reg_2022_2554_art_30_2_c, [label-'Regulation (EU) 2022/2554 (DORA) Art 30(2)(c) (data protection provisions)', ref-'32022R2554#point_030.002_c, OJ L 333, 27.12.2022, p. 1', verbatim-'provisions on availability, authenticity, integrity and confidentiality in relation to the protection of data, including personal data']).
citation(eu_reg_2022_2554_art_30_2_d, [label-'Regulation (EU) 2022/2554 (DORA) Art 30(2)(d) (data access, recovery and return)', ref-'32022R2554#point_030.002_d, OJ L 333, 27.12.2022, p. 1', verbatim-'provisions on ensuring access, recovery and return in an easily accessible format of personal and non-personal data processed by the financial entity']).
citation(eu_reg_2022_2554_art_30_2_e, [label-'Regulation (EU) 2022/2554 (DORA) Art 30(2)(e) (service level descriptions)', ref-'32022R2554#point_030.002_e, OJ L 333, 27.12.2022, p. 1', verbatim-'service level descriptions, including updates and revisions thereof']).
citation(eu_reg_2022_2554_art_30_2_f, [label-'Regulation (EU) 2022/2554 (DORA) Art 30(2)(f) (incident assistance)', ref-'32022R2554#point_030.002_f, OJ L 333, 27.12.2022, p. 1', verbatim-'the obligation of the ICT third-party service provider to provide assistance to the financial entity at no additional cost, or at a cost that is determined ex-ante']).
citation(eu_reg_2022_2554_art_30_2_g, [label-'Regulation (EU) 2022/2554 (DORA) Art 30(2)(g) (cooperation with authorities)', ref-'32022R2554#point_030.002_g, OJ L 333, 27.12.2022, p. 1', verbatim-'the obligation of the ICT third-party service provider to fully cooperate with the competent authorities and the resolution authorities of the financial entity']).
citation(eu_reg_2022_2554_art_30_2_h, [label-'Regulation (EU) 2022/2554 (DORA) Art 30(2)(h) (termination rights and minimum notice periods)', ref-'32022R2554#point_030.002_h, OJ L 333, 27.12.2022, p. 1', verbatim-'termination rights and related minimum notice periods for the termination of the contractual arrangements']).
citation(eu_reg_2022_2554_art_30_2_i, [label-'Regulation (EU) 2022/2554 (DORA) Art 30(2)(i) (security awareness and training participation)', ref-'32022R2554#point_030.002_i, OJ L 333, 27.12.2022, p. 1', verbatim-'digital operational resilience training in accordance with Article 13(6)']).

% ---- Art 30(3): critical or important functions, and the derogation ----
citation(eu_reg_2022_2554_art_30_3, [label-'Regulation (EU) 2022/2554 (DORA) Art 30(3), lead words (ICT services supporting critical or important functions) and closing words (microenterprise derogation from point (e))', ref-'32022R2554#parag_030.003, OJ L 333, 27.12.2022, p. 1', verbatim-'The contractual arrangements on the use of ICT services supporting critical or important functions shall include, in addition to the elements referred to in paragraph 2, at least the following']).
citation(eu_reg_2022_2554_art_30_3_a, [label-'Regulation (EU) 2022/2554 (DORA) Art 30(3)(a) (full service levels with performance targets)', ref-'32022R2554#point_030.003_a, OJ L 333, 27.12.2022, p. 1', verbatim-'full service level descriptions, including updates and revisions thereof with precise quantitative and qualitative performance targets']).
citation(eu_reg_2022_2554_art_30_3_b, [label-'Regulation (EU) 2022/2554 (DORA) Art 30(3)(b) (notice periods and reporting obligations)', ref-'32022R2554#point_030.003_b, OJ L 333, 27.12.2022, p. 1', verbatim-'notice periods and reporting obligations of the ICT third-party service provider to the financial entity']).
citation(eu_reg_2022_2554_art_30_3_c, [label-'Regulation (EU) 2022/2554 (DORA) Art 30(3)(c) (contingency plans and security measures)', ref-'32022R2554#point_030.003_c, OJ L 333, 27.12.2022, p. 1', verbatim-'requirements for the ICT third-party service provider to implement and test business contingency plans']).
citation(eu_reg_2022_2554_art_30_3_d, [label-'Regulation (EU) 2022/2554 (DORA) Art 30(3)(d) (participation in threat-led penetration testing)', ref-'32022R2554#point_030.003_d, OJ L 333, 27.12.2022, p. 1', verbatim-'the obligation of the ICT third-party service provider to participate and fully cooperate in the financial entity']).
citation(eu_reg_2022_2554_art_30_3_e, [label-'Regulation (EU) 2022/2554 (DORA) Art 30(3)(e) with points (i) to (iv) (ongoing monitoring rights: of the financial entity and of the authorities)', ref-'32022R2554#point_030.003_e, 32022R2554#point_030.003_e_i, OJ L 333, 27.12.2022, p. 1', verbatim-'unrestricted rights of access, inspection and audit by the financial entity, or an appointed third party, and by the competent authority']).
citation(eu_reg_2022_2554_art_30_3_f, [label-'Regulation (EU) 2022/2554 (DORA) Art 30(3)(f) (exit strategies and transition period)', ref-'32022R2554#point_030.003_f, OJ L 333, 27.12.2022, p. 1', verbatim-'exit strategies, in particular the establishment of a mandatory adequate transition period']).

% implements(Key): the provenance marker. Succeeds exactly for a recorded key.
implements(Key) :-
    citation(Key, _).

:- end_module(citations).
