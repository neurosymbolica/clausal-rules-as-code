% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% queries.clausal -- QUERY-COMBINATOR layer for eu/dora_ict_third_party_contract_provisions.
% A TOP-LAYER consumer: it imports the determination slice's PUBLIC
% predicates it calls, and nothing else.
%
% Source: Regulation (EU) 2022/2554 (DORA), 32022R2554, OJ L 333,
% 27.12.2022, p. 1: Art 28(7), Art 30(1), (2), (3).
%
% The declared query types are served as follows (all registered in
% manifest.yaml query_interface):
%   #13 compliance_check -- contract_provisions_sufficient/3 (in the slice):
%       does the contract contain every element Art 28(7) and Art 30(1) to (3)
%       require, as the caller judges each element;
%   #2 eligibility -- dora_ict_third_party_contract_provisions_status/2 (in the slice):
%       sufficient | insufficient | a status compound;
%   #7 justification -- dora_ict_third_party_contract_provisions_checklist/2 (in the
%       slice): one item(Element, Status, cite(Key)) per element.
% This layer adds:
%   dora_ict_third_party_contract_provisions_what_if/4      (#16 what-if): override one key -> re-evaluate
%   dora_ict_third_party_contract_provisions_profile_keys/1: top-level profile key schema
%   dora_ict_third_party_contract_provisions_input_problems/2: the problems a profile has ([] = none),
%       re-exported from the kernel as the scaffold wrote it.
% No threshold or flip-point combinator applies: the pinned text sets no
% figure (reading (11)); every key is a tri-state judgement or a crisp fact.
% These predicates decide no statutory condition themselves (they re-run
% the slice), so they carry no provenance marker.
%
% The PROFILE of this order is an ATTRIBUTE LIST, not a dict, so the kit's
% override_key/4 (dict only) cannot be used: the override below replaces
% every attribute(Key, _) of the overridden key by one attribute(Key, Value).
% =====================================================================

:- module(queries, [
    dora_ict_third_party_contract_provisions_profile_keys/1,
    dora_ict_third_party_contract_provisions_input_problems/2,
    dora_ict_third_party_contract_provisions_what_if/4
]).

:- use_module(eu/dora_ict_third_party_contract_provisions/kernel, [dora_ict_third_party_contract_provisions_input_problems/2]).
:- use_module(eu/dora_ict_third_party_contract_provisions/dora_ict_third_party_contract_provisions, [dora_ict_third_party_contract_provisions_status/2]).

% schema of top-level profile keys: the keys of the order's typed input contract, in its order
dora_ict_third_party_contract_provisions_profile_keys([contract_provides_termination_for_significant_breach, contract_provides_termination_for_circumstances_altering_performance, contract_provides_termination_for_risk_management_weaknesses, contract_provides_termination_where_supervision_impeded, contract_is_single_written_document, contract_provides_description_of_functions_services_and_subcontracting, contract_provides_service_and_data_locations, contract_provides_data_protection_provisions, contract_provides_data_access_recovery_and_return, contract_provides_service_level_descriptions, contract_provides_incident_assistance, contract_provides_cooperation_with_authorities, contract_provides_termination_rights_and_notice_periods, contract_provides_security_awareness_and_training_participation, supports_critical_or_important_function, contract_provides_full_service_levels_with_performance_targets, contract_provides_notice_periods_and_reporting_obligations, contract_provides_contingency_plans_and_security_measures, contract_provides_threat_led_penetration_testing_participation, contract_provides_monitoring_rights_of_the_authorities, contract_provides_exit_strategy_and_transition_period, contract_provides_monitoring_rights_of_the_financial_entity, financial_entity_is_microenterprise, contract_provides_delegated_access_inspection_and_audit]).

% #16 what-if: re-evaluate the sufficiency status with one key hypothetically overridden
% (a): the logic was wrong -- override_key/4 needs a dict; the profile is an attribute list.
dora_ict_third_party_contract_provisions_what_if(Profile, OverriddenKey, NewValue, NewStatus) :-
    override_attribute(Profile, OverriddenKey, NewValue, Hypothesis),
    dora_ict_third_party_contract_provisions_status(Hypothesis, NewStatus).

% override_attribute(Profile, Key, Value, NewProfile): every attribute of Key
% dropped, then attribute(Key, Value) added once (list plumbing, no statute).
override_attribute(Profile, OverriddenKey, NewValue, Hypothesis) :-
    exclude(attribute_of_key(OverriddenKey), Profile, KeptAttributes),
    append(KeptAttributes, [attribute(OverriddenKey, NewValue)], Hypothesis).

attribute_of_key(OverriddenKey, attribute(AttributeKey, _)) :-
    AttributeKey == OverriddenKey.

:- end_module(queries).
