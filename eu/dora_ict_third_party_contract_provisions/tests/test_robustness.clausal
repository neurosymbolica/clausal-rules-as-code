% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_robustness.clausal -- ROBUSTNESS of the input check dora_ict_third_party_contract_provisions_input_problems/2 for a
% PROFILE that is an attribute list [attribute(Key, Value), ...]: an empty list, a
% value that is not a list, an unknown key and a value outside its type each get exactly
% one answer. Written by the scaffold from the order's typed input contract
% (input_contract.types.profile: attribute_list), not by the producer;
% do not edit or delete.
% Run: python -m clausal.testing eu/dora_ict_third_party_contract_provisions/tests/test_robustness.clausal
% =====================================================================
:- module(test_robustness, []).
:- use_module(eu/dora_ict_third_party_contract_provisions/queries, [dora_ict_third_party_contract_provisions_input_problems/2]).

test(an_empty_attribute_list_gets_exactly_one_answer) :-
    findall(Problems, dora_ict_third_party_contract_provisions_input_problems([], Problems), Answers),
    Answers == [[]].

test(a_profile_that_is_not_a_list_gets_one_non_empty_answer) :-
    findall(Problems, dora_ict_third_party_contract_provisions_input_problems(not_a_profile, Problems), Answers),
    Answers = [[_|_]].

test(an_unknown_key_is_named) :-
    findall(Problems, dora_ict_third_party_contract_provisions_input_problems([attribute(not_a_key_of_the_contract, true)], Problems), Answers),
    Answers = [Problems],
    memberchk(unknown_key(not_a_key_of_the_contract), Problems).

test(a_value_outside_the_type_of_contract_provides_termination_for_significant_breach_is_named) :-
    findall(Problems, dora_ict_third_party_contract_provisions_input_problems([attribute(contract_provides_termination_for_significant_breach, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(contract_provides_termination_for_significant_breach), Problems).

test(a_value_outside_the_type_of_financial_entity_is_microenterprise_is_named) :-
    findall(Problems, dora_ict_third_party_contract_provisions_input_problems([attribute(financial_entity_is_microenterprise, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(financial_entity_is_microenterprise), Problems).

:- end_module(test_robustness).
