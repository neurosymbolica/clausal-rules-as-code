% ---- Convenience wrapper ---------------------------------------------
dora_ctpp_oversight_assess(Subject, Result) :-
    dora_ctpp_oversight_profile_for(Subject, Profile),
    decide_dora_ctpp_oversight(Profile, Result).

:- end_module(fixtures).
