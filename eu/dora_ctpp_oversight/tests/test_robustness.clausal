% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_robustness.clausal -- ROBUSTNESS of the input check dora_ctpp_oversight_input_problems/2 for a
% PROFILE that is an attribute list [attribute(Key, Value), ...]: an empty list, a
% value that is not a list, an unknown key and a value outside its type each get exactly
% one answer. Written by the scaffold from the order's typed input contract
% (input_contract.types.profile: attribute_list), not by the producer;
% do not edit or delete.
% Run: python -m clausal.testing eu/dora_ctpp_oversight/tests/test_robustness.clausal
% =====================================================================
:- module(test_robustness, []).
:- use_module(eu/dora_ctpp_oversight/queries, [dora_ctpp_oversight_input_problems/2]).

test(an_empty_attribute_list_gets_exactly_one_answer) :-
    findall(Problems, dora_ctpp_oversight_input_problems([], Problems), Answers),
    Answers == [[]].

test(a_profile_that_is_not_a_list_gets_one_non_empty_answer) :-
    findall(Problems, dora_ctpp_oversight_input_problems(not_a_profile, Problems), Answers),
    Answers = [[_|_]].

test(an_unknown_key_is_named) :-
    findall(Problems, dora_ctpp_oversight_input_problems([attribute(not_a_key_of_the_contract, true)], Problems), Answers),
    Answers = [Problems],
    memberchk(unknown_key(not_a_key_of_the_contract), Problems).

test(a_value_outside_the_type_of_provider_designated_as_critical_is_named) :-
    findall(Problems, dora_ctpp_oversight_input_problems([attribute(provider_designated_as_critical, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(provider_designated_as_critical), Problems).

test(a_value_outside_the_type_of_response_window_is_named) :-
    findall(Problems, dora_ctpp_oversight_input_problems([attribute(response_window, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(response_window), Problems).

test(a_value_outside_the_type_of_draft_oversight_plan_received_on_is_named) :-
    findall(Problems, dora_ctpp_oversight_input_problems([attribute(draft_oversight_plan_received_on, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(draft_oversight_plan_received_on), Problems).

test(a_value_outside_the_type_of_preceding_business_year_worldwide_turnover_is_named) :-
    findall(Problems, dora_ctpp_oversight_input_problems([attribute(preceding_business_year_worldwide_turnover, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(preceding_business_year_worldwide_turnover), Problems).

:- end_module(test_robustness).
