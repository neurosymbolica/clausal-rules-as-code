# =====================================================================
# queries.clausal -- QUERY-COMBINATOR layer for eu/procurement/shortlisting.
# A TOP-LAYER consumer: imports the determination slices' PUBLICS and
# the kernel names it spells, and nothing else.
# Covers the four declared query types:
#   #3 status_determination  -> shortlisting_what_if/4
#   #4 enumeration           -> shortlisting_profile_keys/1
#   #6 threshold             -> shortlisting_threshold_flip/4
#   #23 calculation          -> shortlisting_floor_comparison/7
# =====================================================================
-module(queries, [
    shortlisting_profile_keys(VALUES),
    shortlisting_what_if(PROFILE, OVERRIDDEN_KEY, NEW_VALUE, NEW_STATUS),
    shortlisting_threshold_flip(PROFILE, KEY, LO, HI, BOUNDARY),
    shortlisting_floor_comparison(PROCEDURE_TYPE, DECLARED_MIN_A, QUALIFIED_A, DECLARED_MIN_B, QUALIFIED_B, FLOOR_A, FLOOR_B)
])
-double_quotes(chars)

-import_from(eu.procurement.shortlisting.kernel, [
    procedure_type_key,
    objective_and_non_discriminatory_criteria_indicated,
    minimum_number_indicated,
    declared_minimum_candidates,
    declared_maximum_candidates,
    qualified_candidates,
    invited_candidates,
    number_invited_sufficient_for_genuine_competition,
    invited_include_non_requesting_economic_operators,
    invited_include_candidates_without_required_capabilities
])

-import_from(eu.procurement.shortlisting.shortlisting, [
    shortlisting_status,
    shortlisting_input_problem,
    shortlisting_invitation_floor
])

-import_from(kit.query_combinators, [override_key, flip_scan])

# =====================================================================
# #4 enumeration -- the ten-key schema.
# =====================================================================
shortlisting_profile_keys([procedure_type_key, objective_and_non_discriminatory_criteria_indicated, minimum_number_indicated, declared_minimum_candidates, declared_maximum_candidates, qualified_candidates, invited_candidates, number_invited_sufficient_for_genuine_competition, invited_include_non_requesting_economic_operators, invited_include_candidates_without_required_capabilities])

# =====================================================================
# #3 status_determination -- what-if combinator.
# Override one profile key, re-evaluate, return the new status.
# =====================================================================
shortlisting_what_if(PROFILE, OVERRIDDEN_KEY, NEW_VALUE, NEW_STATUS) <- (
    not shortlisting_input_problem(PROFILE, _),
    ground(OVERRIDDEN_KEY),
    override_key(PROFILE, OVERRIDDEN_KEY, NEW_VALUE, HYPOTHESIS),
    shortlisting_status(HYPOTHESIS, NEW_STATUS)
)

# =====================================================================
# #6 threshold -- flip-point combinator.
# Given a profile and a numeric key to vary, find the boundary value
# at which the status changes (e.g. qualified_candidates crossing the
# declared minimum, or declared_minimum crossing the statutory floor).
# =====================================================================
threshold_probe(PROFILE, KEY, X, STATUS) <- (
    override_key(PROFILE, KEY, X, MODIFIED),
    shortlisting_status(MODIFIED, STATUS)
)

shortlisting_threshold_flip(PROFILE, KEY, LO, HI, BOUNDARY) <- (
    not shortlisting_input_problem(PROFILE, _),
    ground(KEY),
    flip_scan(LO, HI, ((X, STATUS) <- threshold_probe(PROFILE, KEY, X, STATUS)), BOUNDARY)
)

# =====================================================================
# #23 calculation -- comparison combinator.
# Compute the invitation floor for two (declared_min, qualified) pairs
# under the same procedure type and return both values side by side.
# =====================================================================
shortlisting_floor_comparison(PROCEDURE_TYPE, DECLARED_MIN_A, QUALIFIED_A, DECLARED_MIN_B, QUALIFIED_B, FLOOR_A, FLOOR_B) <- (
    shortlisting_invitation_floor(PROCEDURE_TYPE, DECLARED_MIN_A, QUALIFIED_A, FLOOR_A),
    shortlisting_invitation_floor(PROCEDURE_TYPE, DECLARED_MIN_B, QUALIFIED_B, FLOOR_B)
)
