# =====================================================================
# fixtures.clausal -- representative profiles for eu/procurement/shortlisting.
# For EVERY route a positive case AND a one-unit near-miss control
# (at-boundary / just-below pairs for every threshold).
# =====================================================================
-module(fixtures, [
    shortlisting_subject(SUBJECT),
    shortlisting_profile_for(SUBJECT, PROFILE),
    shortlisting_assess(SUBJECT, RESULT)
])
-double_quotes(chars)

-import_from(eu.procurement.shortlisting.kernel, [
    procedure_type_key,
    objective_and_non_discriminatory_criteria_indicated,
    minimum_number_indicated,
    declared_minimum_candidates,
    declared_maximum_candidates,
    qualified_candidates,
    invited_candidates,
    number_invited_sufficient_for_genuine_competition,
    invited_include_non_requesting_economic_operators,
    invited_include_candidates_without_required_capabilities
])

-import_from(eu.procurement.shortlisting.shortlisting, [
    decide_shortlisting,
    restricted_procedure,
    competitive_procedure_with_negotiation,
    open_procedure,
    negotiated_procedure_without_prior_publication
])

# ---- Subject registry ------------------------------------------------
shortlisting_subject("restricted_all_clear"),
shortlisting_subject("restricted_below_statutory"),
shortlisting_subject("restricted_at_continuation_boundary"),
shortlisting_subject("restricted_continuation"),
shortlisting_subject("restricted_max_at_min"),
shortlisting_subject("restricted_max_below_min"),
shortlisting_subject("open_procedure"),
shortlisting_subject("restricted_defect_criteria"),
shortlisting_subject("cpwn_all_clear"),

shortlisting_subject("cpwn_continuation")

# ---- Profiles --------------------------------------------------------

# Route: limitation_permitted (positive, at statutory boundary: declared_min = 5 = statutory)
shortlisting_profile_for("restricted_all_clear", {
    procedure_type_key: restricted_procedure,
    objective_and_non_discriminatory_criteria_indicated: True,
    minimum_number_indicated: True,
    declared_minimum_candidates: 5,
    declared_maximum_candidates: 8,
    qualified_candidates: 10,
    invited_candidates: 5,
    number_invited_sufficient_for_genuine_competition: True,
    invited_include_non_requesting_economic_operators: False,
    invited_include_candidates_without_required_capabilities: False
}),

# Route: limitation_prohibited (near-miss: declared_min = 4, just below statutory 5)
shortlisting_profile_for("restricted_below_statutory", {
    procedure_type_key: restricted_procedure,
    objective_and_non_discriminatory_criteria_indicated: True,
    minimum_number_indicated: True,
    declared_minimum_candidates: 4,
    declared_maximum_candidates: 8,
    qualified_candidates: 10,
    invited_candidates: 5,
    number_invited_sufficient_for_genuine_competition: True,
    invited_include_non_requesting_economic_operators: False,
    invited_include_candidates_without_required_capabilities: False
}),

# Route: limitation_permitted (near-miss: at continuation boundary, qualified = declared_min = 5)
shortlisting_profile_for("restricted_at_continuation_boundary", {
    procedure_type_key: restricted_procedure,
    objective_and_non_discriminatory_criteria_indicated: True,
    minimum_number_indicated: True,
    declared_minimum_candidates: 5,
    declared_maximum_candidates: 0,
    qualified_candidates: 5,
    invited_candidates: 5,
    number_invited_sufficient_for_genuine_competition: True,
    invited_include_non_requesting_economic_operators: False,
    invited_include_candidates_without_required_capabilities: False
}),

# Route: continuation_permitted (positive: qualified = 4, just below declared_min = 5)
shortlisting_profile_for("restricted_continuation", {
    procedure_type_key: restricted_procedure,
    objective_and_non_discriminatory_criteria_indicated: True,
    minimum_number_indicated: True,
    declared_minimum_candidates: 5,
    declared_maximum_candidates: 0,
    qualified_candidates: 4,
    invited_candidates: 4,
    number_invited_sufficient_for_genuine_competition: True,
    invited_include_non_requesting_economic_operators: False,
    invited_include_candidates_without_required_capabilities: False
}),

# Route: limitation_permitted (near-miss: at max=min boundary, declared_max = declared_min = 5)
shortlisting_profile_for("restricted_max_at_min", {
    procedure_type_key: restricted_procedure,
    objective_and_non_discriminatory_criteria_indicated: True,
    minimum_number_indicated: True,
    declared_minimum_candidates: 5,
    declared_maximum_candidates: 5,
    qualified_candidates: 10,
    invited_candidates: 5,
    number_invited_sufficient_for_genuine_competition: True,
    invited_include_non_requesting_economic_operators: False,
    invited_include_candidates_without_required_capabilities: False
}),

# Route: limitation_prohibited (near-miss: just below max=min, declared_max = 4 < declared_min = 5)
shortlisting_profile_for("restricted_max_below_min", {
    procedure_type_key: restricted_procedure,
    objective_and_non_discriminatory_criteria_indicated: True,
    minimum_number_indicated: True,
    declared_minimum_candidates: 5,
    declared_maximum_candidates: 4,
    qualified_candidates: 10,
    invited_candidates: 5,
    number_invited_sufficient_for_genuine_competition: True,
    invited_include_non_requesting_economic_operators: False,
    invited_include_candidates_without_required_capabilities: False
}),

# Route: limitation_not_available (positive: open procedure, Art 65 does not apply)
shortlisting_profile_for("open_procedure", {
    procedure_type_key: open_procedure,
    objective_and_non_discriminatory_criteria_indicated: True,
    minimum_number_indicated: True,
    declared_minimum_candidates: 0,
    declared_maximum_candidates: 0,
    qualified_candidates: 10,
    invited_candidates: 10,
    number_invited_sufficient_for_genuine_competition: True,
    invited_include_non_requesting_economic_operators: False,
    invited_include_candidates_without_required_capabilities: False
}),

# Route: limitation_prohibited (positive: criteria not indicated)
shortlisting_profile_for("restricted_defect_criteria", {
    procedure_type_key: restricted_procedure,
    objective_and_non_discriminatory_criteria_indicated: False,
    minimum_number_indicated: True,
    declared_minimum_candidates: 5,
    declared_maximum_candidates: 8,
    qualified_candidates: 10,
    invited_candidates: 5,
    number_invited_sufficient_for_genuine_competition: True,
    invited_include_non_requesting_economic_operators: False,
    invited_include_candidates_without_required_capabilities: False
}),

# Route: limitation_permitted (positive, CPWN at statutory boundary: declared_min = 3 = statutory)
shortlisting_profile_for("cpwn_all_clear", {
    procedure_type_key: competitive_procedure_with_negotiation,
    objective_and_non_discriminatory_criteria_indicated: True,
    minimum_number_indicated: True,
    declared_minimum_candidates: 3,
    declared_maximum_candidates: 6,
    qualified_candidates: 8,
    invited_candidates: 3,
    number_invited_sufficient_for_genuine_competition: True,
    invited_include_non_requesting_economic_operators: False,
    invited_include_candidates_without_required_capabilities: False
}),

# Route: continuation_permitted (positive, CPWN: qualified = 2 < declared_min = 3)
shortlisting_profile_for("cpwn_continuation", {
    procedure_type_key: competitive_procedure_with_negotiation,
    objective_and_non_discriminatory_criteria_indicated: True,
    minimum_number_indicated: True,
    declared_minimum_candidates: 3,
    declared_maximum_candidates: 0,
    qualified_candidates: 2,
    invited_candidates: 2,
    number_invited_sufficient_for_genuine_competition: True,
    invited_include_non_requesting_economic_operators: False,
    invited_include_candidates_without_required_capabilities: False
})

# ---- Convenience wrapper ---------------------------------------------
shortlisting_assess(SUBJECT, RESULT) <- (
    shortlisting_profile_for(SUBJECT, PROFILE),
    decide_shortlisting(PROFILE, RESULT)
)
