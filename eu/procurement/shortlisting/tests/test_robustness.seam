-double_quotes(chars)
# =====================================================================
# test_robustness.seam -- ROBUSTNESS of decide_shortlisting/2, the one
# decision predicate of eu/procurement/shortlisting, against missing inputs,
# wrongly typed inputs, the empty profile, and more than one answer; plus
# boundary values at the Art 65(2) numeric thresholds.
#
# What counts as a pass. The domain has no guard (no clause throws) and no
# indeterminate status of its own: its four status atoms are all definite
# (limitation_not_available, limitation_permitted, limitation_prohibited,
# continuation_permitted). So for an input the decision cannot lawfully decide
# on, the only acceptable outcome is NO SOLUTION (the decision refuses: it
# fails closed; shortlisting_decision_resolvable/1 then fails). A definite
# verdict is a FAILS-OPEN defect. Any exception is recorded as raised(ERROR);
# since the domain has no guard, every exception is incidental and is a CRASH
# defect.
#
# Base profile: the fixture restricted_all_clear, pinned by
# test_public_interface and test_output_mode as limitation_permitted. It is a
# restricted procedure (an Art 65(1) procedure), so every one of the ten keys
# is read. The group of tests starts with a known-green control on it.
#
# Key contract: profile_keys.yaml key_contract (booleans are native
# True/False, "never 1/0"; counts are "a plain non-negative INTEGER COUNT OF
# CANDIDATES"; procedure_type_key is one of six atoms).
# Run: python -m clausal.testing eu/procurement/shortlisting/tests/test_robustness.seam
# =====================================================================
-import_from(eu.procurement.shortlisting.shortlisting, [
    decide_shortlisting,
    shortlisting_status,
    shortlisting_checklist,
    shortlisting_decision_resolvable,
    shortlisting_what_if,
    shortlisting_invitation_floor,
    shortlisting_limitation_modality,
    shortlisting_input_problem,
    not_ground,
    missing_key,
    wrong_type,
    wrong_value,
    negative_count,
    profile,
    expected_dict,
    expected_boolean,
    expected_integer_count,
    expected_procedure_type_atom,
    restricted_procedure,
    competitive_procedure_with_negotiation,
    open_procedure
])

-import_from(eu.procurement.shortlisting.kernel, [
    shortlisting_verdict,
    limitation_not_available,
    limitation_prohibited,
    continuation_permitted,
    limitation_permitted,
    procedure_type_key,
    objective_and_non_discriminatory_criteria_indicated,
    minimum_number_indicated,
    declared_minimum_candidates,
    declared_maximum_candidates,
    qualified_candidates,
    invited_candidates,
    number_invited_sufficient_for_genuine_competition,
    invited_include_non_requesting_economic_operators,
    invited_include_candidates_without_required_capabilities,
    declared_minimum_below_statutory_minimum,
    declared_maximum_below_declared_minimum,
    fewer_invited_than_minimum_number
])

-import_from(eu.procurement.shortlisting.citations, [
    cite,
    eu_dir_2014_24_art_65_2_minima,
    eu_dir_2014_24_art_65_2_indication,
    eu_dir_2014_24_art_65_2_invitation_floor
])

-import_from(eu.procurement.shortlisting.queries, [
    shortlisting_threshold_flip
])

-import_from(eu.procurement.shortlisting.fixtures, [
    shortlisting_subject,
    shortlisting_profile_for
])

# Outcome constructors, and wrong-value atoms used only as bad inputs
# (declared so strict atoms accepts them).
-private([
    answers(VERDICTS),
    raised(ERROR),
    yes,
    five,
    procedure_not_in_vocabulary
])

# ---- Outcome helpers ---------------------------------------------------
# Collects EVERY answer of decide_shortlisting/2, or the exception it raised.
shortlisting_outcome(PROFILE, OUTCOME) <- (
    catch((findall(VERDICT, decide_shortlisting(PROFILE, VERDICT), VERDICTS), OUTCOME is answers(VERDICTS)),
          CAUGHT,
          OUTCOME is raised(CAUGHT))
)

profile_without(KEY, PROFILE) <- (
    shortlisting_profile_for("restricted_all_clear", BASE),
    dict_remove(KEY, BASE, PROFILE)
)

profile_with(KEY, VALUE, PROFILE) <- (
    shortlisting_profile_for("restricted_all_clear", BASE),
    dict_put(KEY, VALUE, BASE, PROFILE)
)

profile_with_two(KEY_ONE, VALUE_ONE, KEY_TWO, VALUE_TWO, PROFILE) <- (
    profile_with(KEY_ONE, VALUE_ONE, MIDDLE),
    dict_put(KEY_TWO, VALUE_TWO, MIDDLE, PROFILE)
)

# ---- Known-green control -------------------------------------------------
test("control: restricted_all_clear is limitation_permitted with 5 to invite, exactly one answer") <- (
    shortlisting_profile_for("restricted_all_clear", PROFILE),
    shortlisting_outcome(PROFILE, answers([shortlisting_verdict(limitation_permitted, [], 5, [])]))
)

# ---- 1. Missing required inputs ---------------------------------------------
# For an Art 65(1) procedure decide_shortlisting/2 reads all ten keys.
# profile_keys.yaml: "Ten keys, no more and no fewer"; no key has a default
# (declared_minimum_candidates and declared_maximum_candidates use 0 as an
# explicit value meaning "none indicated", which is not the same as absence).

test("missing procedure_type_key (Art 65(1)): decide_shortlisting must refuse, not answer") <- (
    profile_without(procedure_type_key, PROFILE),
    shortlisting_outcome(PROFILE, answers([]))
)

test("missing objective_and_non_discriminatory_criteria_indicated (Art 65(2) first sub-paragraph): decide_shortlisting must refuse, not answer") <- (
    profile_without(objective_and_non_discriminatory_criteria_indicated, PROFILE),
    shortlisting_outcome(PROFILE, answers([]))
)

test("missing minimum_number_indicated (Art 65(2) first sub-paragraph): decide_shortlisting must refuse, not answer") <- (
    profile_without(minimum_number_indicated, PROFILE),
    shortlisting_outcome(PROFILE, answers([]))
)

test("missing declared_minimum_candidates (Art 65(2) first sub-paragraph): decide_shortlisting must refuse, not answer") <- (
    profile_without(declared_minimum_candidates, PROFILE),
    shortlisting_outcome(PROFILE, answers([]))
)

test("missing declared_maximum_candidates (Art 65(2) first sub-paragraph): decide_shortlisting must refuse, not answer") <- (
    profile_without(declared_maximum_candidates, PROFILE),
    shortlisting_outcome(PROFILE, answers([]))
)

test("missing qualified_candidates (Art 65(1) and 65(2) third sub-paragraph): decide_shortlisting must refuse, not answer") <- (
    profile_without(qualified_candidates, PROFILE),
    shortlisting_outcome(PROFILE, answers([]))
)

test("missing invited_candidates (Art 65(2) third sub-paragraph): decide_shortlisting must refuse, not answer") <- (
    profile_without(invited_candidates, PROFILE),
    shortlisting_outcome(PROFILE, answers([]))
)

test("missing number_invited_sufficient_for_genuine_competition (Art 65(2) second sub-paragraph final sentence): decide_shortlisting must refuse, not answer") <- (
    profile_without(number_invited_sufficient_for_genuine_competition, PROFILE),
    shortlisting_outcome(PROFILE, answers([]))
)

test("missing invited_include_non_requesting_economic_operators (Art 65(2) third sub-paragraph final sentence): decide_shortlisting must refuse, not answer") <- (
    profile_without(invited_include_non_requesting_economic_operators, PROFILE),
    shortlisting_outcome(PROFILE, answers([]))
)

test("missing invited_include_candidates_without_required_capabilities (Art 65(2) third sub-paragraph final sentence): decide_shortlisting must refuse, not answer") <- (
    profile_without(invited_include_candidates_without_required_capabilities, PROFILE),
    shortlisting_outcome(PROFILE, answers([]))
)

# By design: manifest.yaml scope -- Art 65(1) names four procedures "and in no
# other, so for an open procedure ... there is no power to exercise". The nine
# Art 65(2) keys are therefore not read for an open procedure, and a profile
# carrying only the procedure type is decided as limitation_not_available.
test("by design: open procedure with only procedure_type_key is limitation_not_available (Art 65(1))") <- (
    shortlisting_outcome({procedure_type_key: open_procedure}, answers([shortlisting_verdict(limitation_not_available, [], 0, [])]))
)

# ---- 2. Wrong types -----------------------------------------------------------
test("wrong value: procedure_type_key outside the six-atom vocabulary: decide_shortlisting must refuse") <- (
    profile_with(procedure_type_key, procedure_not_in_vocabulary, PROFILE),
    shortlisting_outcome(PROFILE, answers([]))
)

test("wrong type: procedure_type_key as a string: decide_shortlisting must refuse") <- (
    profile_with(procedure_type_key, "restricted_procedure", PROFILE),
    shortlisting_outcome(PROFILE, answers([]))
)

test("wrong type: procedure_type_key as a number: decide_shortlisting must refuse") <- (
    profile_with(procedure_type_key, 1, PROFILE),
    shortlisting_outcome(PROFILE, answers([]))
)

test("wrong type: procedure_type_key as a list: decide_shortlisting must refuse") <- (
    profile_with(procedure_type_key, [restricted_procedure], PROFILE),
    shortlisting_outcome(PROFILE, answers([]))
)

# Booleans: profile_keys.yaml "a native True/False -- never the strings
# "true"/"false", never 1/0".

test("wrong type: objective_and_non_discriminatory_criteria_indicated as atom yes: decide_shortlisting must refuse, not answer") <- (
    profile_with(objective_and_non_discriminatory_criteria_indicated, yes, PROFILE),
    shortlisting_outcome(PROFILE, answers([]))
)

test("wrong type: objective_and_non_discriminatory_criteria_indicated as string true (a char list under double_quotes(chars)): decide_shortlisting must refuse, not answer") <- (
    profile_with(objective_and_non_discriminatory_criteria_indicated, "true", PROFILE),
    shortlisting_outcome(PROFILE, answers([]))
)

test("wrong type: objective_and_non_discriminatory_criteria_indicated as integer 1: decide_shortlisting must refuse, not answer") <- (
