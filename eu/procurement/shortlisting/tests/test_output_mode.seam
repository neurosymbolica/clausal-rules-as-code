-double_quotes(chars)
# =====================================================================
# test_output_mode.clausal -- OUTPUT MODE tests for decide_shortlisting/2
# and the scalar predicates.
# =====================================================================
-import_from(eu.procurement.shortlisting.shortlisting, [
    decide_shortlisting,
    shortlisting_status,
    statutory_minimum_candidates,
    shortlisting_invitation_floor,
    shortlisting_limitation_modality,
    shortlisting_inclusion_modality,
    restricted_procedure,
    competitive_procedure_with_negotiation,
    open_procedure,
    requested_and_has_required_capabilities,
    requested_without_required_capabilities,
    did_not_request_to_participate,
    inclusion_permitted,
    inclusion_prohibited
])

-import_from(eu.procurement.shortlisting.fixtures, [shortlisting_profile_for])

-import_from(eu.procurement.shortlisting.kernel, [
    shortlisting_verdict,
    limitation_permitted,
    limitation_prohibited,
    continuation_permitted,
    limitation_not_available
])

test("output mode: restricted all-clear yields limitation_permitted") <- (
    shortlisting_profile_for("restricted_all_clear", PROFILE),
    findall(STATUS, shortlisting_status(PROFILE, STATUS), STATUS_LIST),
    STATUS_LIST is [limitation_permitted]
)

test("output mode: restricted defect yields limitation_prohibited") <- (
    shortlisting_profile_for("restricted_defect_criteria", PROFILE),
    findall(STATUS, shortlisting_status(PROFILE, STATUS), STATUS_LIST),
    STATUS_LIST is [limitation_prohibited]
)

test("output mode: restricted continuation yields continuation_permitted") <- (
    shortlisting_profile_for("restricted_continuation", PROFILE),
    findall(STATUS, shortlisting_status(PROFILE, STATUS), STATUS_LIST),
    STATUS_LIST is [continuation_permitted]
)

test("output mode: open procedure yields limitation_not_available") <- (
    shortlisting_profile_for("open_procedure", PROFILE),
    findall(STATUS, shortlisting_status(PROFILE, STATUS), STATUS_LIST),
    STATUS_LIST is [limitation_not_available]
)

test("output mode: verdict carries a citation list for defects") <- (
    shortlisting_profile_for("restricted_defect_criteria", PROFILE),
    decide_shortlisting(PROFILE, shortlisting_verdict(_, DEFECT_IDS, _NUMBER_TO_INVITE, CITATIONS)),
    not DEFECT_IDS is [],
    not CITATIONS is []
)

test("output mode: statutory minimum for restricted is 5") <- (
    findall(MIN, statutory_minimum_candidates(restricted_procedure, MIN), MIN_LIST),
    MIN_LIST is [5]
)

test("output mode: statutory minimum for CPWN is 3") <- (
    findall(MIN, statutory_minimum_candidates(competitive_procedure_with_negotiation, MIN), MIN_LIST),
    MIN_LIST is [3]
)

test("output mode: invitation floor for restricted at statutory boundary") <- (
    findall(FLOOR, shortlisting_invitation_floor(restricted_procedure, 5, 10, FLOOR), FLOOR_LIST),
    FLOOR_LIST is [5]
)

test("output mode: invitation floor for restricted continuation") <- (
    findall(FLOOR, shortlisting_invitation_floor(restricted_procedure, 5, 4, FLOOR), FLOOR_LIST),
    FLOOR_LIST is [4]
)

test("output mode: inclusion modality enumerates all three statuses") <- (
    findall(MOD, shortlisting_inclusion_modality(requested_and_has_required_capabilities, MOD), MOD_LIST),
    MOD_LIST is [inclusion_permitted]
)

test("output mode: inclusion modality for non-requesting") <- (
    findall(MOD, shortlisting_inclusion_modality(did_not_request_to_participate, MOD), MOD_LIST),
    MOD_LIST is [inclusion_prohibited]
)
