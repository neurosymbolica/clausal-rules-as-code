-double_quotes(chars)
-private([label])
# Run: cd <corpus root> && python -m clausal.testing \
#      eu/procurement/shortlisting/tests/test_load.clausal
-import_from(eu.procurement.shortlisting.kernel, [
    shortlisting_verdict,
    limitation_not_available,
    limitation_prohibited,
    continuation_permitted,
    limitation_permitted,
    objective_and_non_discriminatory_criteria_not_indicated,
    minimum_number_not_indicated,
    declared_minimum_below_statutory_minimum,
    declared_maximum_below_declared_minimum,
    genuine_competition_not_ensured,
    fewer_invited_than_minimum_number,
    non_requesting_economic_operator_included,
    candidate_without_required_capabilities_included
])

-import_from(eu.procurement.shortlisting.citations, [
    cite,
    citation,
    eu_dir_2014_24_art_65_1,
    eu_dir_2014_24_art_65_2_indication,
    eu_dir_2014_24_art_65_2_minima,
    eu_dir_2014_24_art_65_2_genuine_competition,
    eu_dir_2014_24_art_65_2_invitation_floor,
    eu_dir_2014_24_art_65_2_prohibition
])

test("verdict status atoms are pairwise distinct") <- (
    not limitation_not_available is limitation_prohibited,
    not limitation_not_available is continuation_permitted,
    not limitation_not_available is limitation_permitted,
    not limitation_prohibited is continuation_permitted,
    not limitation_prohibited is limitation_permitted,
    not continuation_permitted is limitation_permitted
)

test("verdict constructor builds and destructures") <- (
    VERDICT is shortlisting_verdict(limitation_permitted, [objective_and_non_discriminatory_criteria_not_indicated, minimum_number_not_indicated], 5, [cite(eu_dir_2014_24_art_65_2_indication), cite(eu_dir_2014_24_art_65_2_indication)]),
    VERDICT is shortlisting_verdict(STATUS, DEFECT_IDS, NUMBER_TO_INVITE, CITATIONS),
    STATUS is limitation_permitted,
    DEFECT_IDS is [objective_and_non_discriminatory_criteria_not_indicated, minimum_number_not_indicated],
    NUMBER_TO_INVITE is 5,
    CITATIONS is [cite(eu_dir_2014_24_art_65_2_indication), cite(eu_dir_2014_24_art_65_2_indication)]
)

test("verdict constructor with empty defects and citations") <- (
    VERDICT is shortlisting_verdict(limitation_not_available, [], 0, []),
    VERDICT is shortlisting_verdict(STATUS, DEFECT_IDS, NUMBER_TO_INVITE, CITATIONS),
    STATUS is limitation_not_available,
    DEFECT_IDS is [],
    NUMBER_TO_INVITE is 0,
    CITATIONS is []
)

test("citation record resolves for art 65(1)") <- (
    citation(eu_dir_2014_24_art_65_1, RECORD),
    get(RECORD, label, LABEL),
    LABEL is "Directive 2014/24/EU, Article 65(1) (the power to limit the number of candidates, and the four procedures in which it exists)"
)

test("citation record resolves for the Art 65(2) minima sentence") <- (
    citation(eu_dir_2014_24_art_65_2_minima, RECORD),
    get(RECORD, label, LABEL),
    LABEL is "Directive 2014/24/EU, Article 65(2) second sub-paragraph, first two sentences (the minimum is five in the restricted procedure and three in the other three)"
)

test("all eight defect limb atoms are pairwise distinct") <- (
    not objective_and_non_discriminatory_criteria_not_indicated is minimum_number_not_indicated,
    not objective_and_non_discriminatory_criteria_not_indicated is declared_minimum_below_statutory_minimum,
    not objective_and_non_discriminatory_criteria_not_indicated is declared_maximum_below_declared_minimum,
    not objective_and_non_discriminatory_criteria_not_indicated is genuine_competition_not_ensured,
    not objective_and_non_discriminatory_criteria_not_indicated is fewer_invited_than_minimum_number,
    not objective_and_non_discriminatory_criteria_not_indicated is non_requesting_economic_operator_included,
    not objective_and_non_discriminatory_criteria_not_indicated is candidate_without_required_capabilities_included,
    not minimum_number_not_indicated is declared_minimum_below_statutory_minimum,
    not minimum_number_not_indicated is declared_maximum_below_declared_minimum,
    not minimum_number_not_indicated is genuine_competition_not_ensured,
    not minimum_number_not_indicated is fewer_invited_than_minimum_number,
    not minimum_number_not_indicated is non_requesting_economic_operator_included,
    not minimum_number_not_indicated is candidate_without_required_capabilities_included,
    not declared_minimum_below_statutory_minimum is declared_maximum_below_declared_minimum,
    not declared_minimum_below_statutory_minimum is genuine_competition_not_ensured,
    not declared_minimum_below_statutory_minimum is fewer_invited_than_minimum_number,
    not declared_minimum_below_statutory_minimum is non_requesting_economic_operator_included,
    not declared_minimum_below_statutory_minimum is candidate_without_required_capabilities_included,
    not declared_maximum_below_declared_minimum is genuine_competition_not_ensured,
    not declared_maximum_below_declared_minimum is fewer_invited_than_minimum_number,
    not declared_maximum_below_declared_minimum is non_requesting_economic_operator_included,
    not declared_maximum_below_declared_minimum is candidate_without_required_capabilities_included,
    not genuine_competition_not_ensured is fewer_invited_than_minimum_number,
    not genuine_competition_not_ensured is non_requesting_economic_operator_included,
    not genuine_competition_not_ensured is candidate_without_required_capabilities_included,
    not fewer_invited_than_minimum_number is non_requesting_economic_operator_included,
    not fewer_invited_than_minimum_number is candidate_without_required_capabilities_included,
    not non_requesting_economic_operator_included is candidate_without_required_capabilities_included
)
