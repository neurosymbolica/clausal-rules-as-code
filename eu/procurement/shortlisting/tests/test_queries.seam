-double_quotes(chars)
# =====================================================================
# test_queries.clausal -- exercise every query combinator exported by
# the queries module.
# =====================================================================
-import_from(eu.procurement.shortlisting.queries, [
    shortlisting_profile_keys,
    shortlisting_what_if,
    shortlisting_threshold_flip,
    shortlisting_floor_comparison
])

-import_from(eu.procurement.shortlisting.fixtures, [shortlisting_profile_for])

-import_from(eu.procurement.shortlisting.kernel, [
    limitation_permitted,
    limitation_prohibited,
    continuation_permitted,
    procedure_type_key,
    qualified_candidates,
    declared_minimum_candidates
])

-import_from(eu.procurement.shortlisting.shortlisting, [
    restricted_procedure,
    competitive_procedure_with_negotiation
])

test("profile keys: all ten keys are declared") <- (
    shortlisting_profile_keys(PROFILE_KEYS),
    length(PROFILE_KEYS, 10)
)

test("what_if: overriding declared_minimum below statutory creates a defect") <- (
    shortlisting_profile_for("restricted_all_clear", PROFILE),
    shortlisting_what_if(PROFILE, declared_minimum_candidates, 3, limitation_prohibited)
)

test("what_if: overriding qualified below declared triggers continuation") <- (
    shortlisting_profile_for("restricted_all_clear", PROFILE),
    shortlisting_what_if(PROFILE, qualified_candidates, 3, continuation_permitted)
)

test("what_if: overriding qualified above declared keeps limitation_permitted") <- (
    shortlisting_profile_for("restricted_all_clear", PROFILE),
    shortlisting_what_if(PROFILE, qualified_candidates, 12, limitation_permitted)
)

test("threshold_flip: finding the boundary for qualified_candidates") <- (
    shortlisting_profile_for("restricted_all_clear", PROFILE),
    shortlisting_threshold_flip(PROFILE, qualified_candidates, 0, 20, BOUNDARY),
    BOUNDARY >= 0
)

test("floor_comparison: same procedure different inputs") <- (
    shortlisting_floor_comparison(restricted_procedure, 5, 10, 5, 4, FLOOR_A, FLOOR_B),
    FLOOR_A == 5,
    FLOOR_B == 4
)

test("floor_comparison: below statutory returns qualified count") <- (
    shortlisting_floor_comparison(restricted_procedure, 3, 7, 5, 10, FLOOR_A, FLOOR_B),
    FLOOR_A == 7,
    FLOOR_B == 5
)

test("floor_comparison: CPWN statutory boundary") <- (
    shortlisting_floor_comparison(competitive_procedure_with_negotiation, 3, 8, 3, 2, FLOOR_A, FLOOR_B),
    FLOOR_A == 3,
    FLOOR_B == 2
)
