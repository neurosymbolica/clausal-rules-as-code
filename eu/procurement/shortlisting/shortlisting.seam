# =====================================================================
# shortlisting.clausal -- the "shortlisting" DETERMINATION for eu/procurement/shortlisting,
# self-contained top to bottom: its statutory VALUE facts, its derived
# arithmetic, its per-rule tests, its checklist and its verdict assembly.
# Source: Directive 2014/24/EU, Art 65(1)-(2), OJ L 94, 28.3.2014.
# =====================================================================
-module(shortlisting, [
    decide_shortlisting(PROFILE, VERDICT),
    shortlisting_status(PROFILE, STATUS),
    shortlisting_checklist(PROFILE, CHECKLIST),
    shortlisting_decision_resolvable(PROFILE),
    shortlisting_status_values(VALUES),
    statutory_minimum_candidates(PROCEDURE_TYPE, MINIMUM_CANDIDATES),
    shortlisting_limitation_modality(PROCEDURE_TYPE, DECLARED_MINIMUM_CANDIDATES, QUALIFIED_CANDIDATES, MODALITY),
    shortlisting_invitation_floor(PROCEDURE_TYPE, DECLARED_MINIMUM_CANDIDATES, QUALIFIED_CANDIDATES, NUMBER_TO_INVITE),
    shortlisting_inclusion_modality(CANDIDATE_STATUS, MODALITY),
    shortlisting_what_if(PROFILE, OVERRIDDEN_KEY, NEW_VALUE, NEW_STATUS),
    shortlisting_profile_keys(PROFILE_KEYS),
    shortlisting_input_problem(PROFILE, PROBLEM),
    not_ground,
    missing_key(KEY),
    wrong_type(WHAT, EXPECTED),
    wrong_value(KEY, EXPECTED),
    negative_count(KEY),
    profile,
    expected_dict,
    expected_boolean,
    expected_integer_count,
    expected_procedure_type_atom,
    non_requesting_economic_operator,
    candidate_without_required_capabilities,
    inclusion_prohibited,
    inclusion_permitted,
    requested_and_has_required_capabilities,
    requested_without_required_capabilities,
    did_not_request_to_participate,
    restricted_procedure,
    competitive_procedure_with_negotiation,
    competitive_dialogue,
    innovation_partnership,
    open_procedure,
    negotiated_procedure_without_prior_publication
])
-double_quotes(chars)

-import_from(eu.procurement.shortlisting.kernel, [
    shortlisting_verdict,
    limitation_not_available,
    limitation_prohibited,
    continuation_permitted,
    limitation_permitted,
    procedure_type_key,
    objective_and_non_discriminatory_criteria_indicated,
    minimum_number_indicated,
    declared_minimum_candidates,
    declared_maximum_candidates,
    qualified_candidates,
    invited_candidates,
    number_invited_sufficient_for_genuine_competition,
    invited_include_non_requesting_economic_operators,
    invited_include_candidates_without_required_capabilities,
    objective_and_non_discriminatory_criteria_not_indicated,
    minimum_number_not_indicated,
    declared_minimum_below_statutory_minimum,
    declared_maximum_below_declared_minimum,
    genuine_competition_not_ensured,
    fewer_invited_than_minimum_number,
    non_requesting_economic_operator_included,
    candidate_without_required_capabilities_included
])

-import_from(eu.procurement.shortlisting.citations, [
    cite,
    implements,
    eu_dir_2014_24_art_65_1,
    eu_dir_2014_24_art_65_2_indication,
    eu_dir_2014_24_art_65_2_minima,
    eu_dir_2014_24_art_65_2_genuine_competition,
    eu_dir_2014_24_art_65_2_invitation_floor,
    eu_dir_2014_24_art_65_2_prohibition
])

-import_from(formalize_lib, [profile_get, item, met, unmet])

-import_from(kit.query_combinators, [override_key])

# procedure_type/1 -- the Art 26 procedure vocabulary, IMPORTED. This file used
# to hand-copy its six clauses, with a comment blaming the import path; the
# shared module is now importable, so the copy is gone and the membership test
# has one definition again.
-import_from(eu.procurement.directive_2014_24.vocabulary, [procedure_type])

# =====================================================================
# Statutory VALUE facts (Art 65(2) sub-para 2) -- internal table with
# ready-made cite terms for the gate.
# =====================================================================
statutory_minimum_fact(restricted_procedure, 5, cite(eu_dir_2014_24_art_65_2_minima)),
statutory_minimum_fact(competitive_procedure_with_negotiation, 3, cite(eu_dir_2014_24_art_65_2_minima)),
statutory_minimum_fact(competitive_dialogue, 3, cite(eu_dir_2014_24_art_65_2_minima)),

statutory_minimum_fact(innovation_partnership, 3, cite(eu_dir_2014_24_art_65_2_minima))

# =====================================================================
# Art 65(1) procedure membership -- the four procedures where the power
# to limit candidate numbers exists.
# =====================================================================
is_article_65_procedure(restricted_procedure),
is_article_65_procedure(competitive_procedure_with_negotiation),
is_article_65_procedure(competitive_dialogue),

is_article_65_procedure(innovation_partnership)

# =====================================================================
# statutory_minimum_candidates/2 -- threshold query type #6.
# DELIBERATELY PARTIAL: no solution for open_procedure and
# negotiated_procedure_without_prior_publication.
# =====================================================================
statutory_minimum_candidates(PROCEDURE_TYPE, MINIMUM_CANDIDATES) <- (
    statutory_minimum_fact(PROCEDURE_TYPE, MINIMUM_CANDIDATES, _)
)

# =====================================================================
# shortlisting_invitation_floor/4 -- calculation query type #23.
# TOTAL over all six procedure atoms.
# =====================================================================
shortlisting_invitation_floor(PROCEDURE_TYPE, DECLARED_MINIMUM_CANDIDATES, QUALIFIED_CANDIDATES, 0) <- (
    ground(PROCEDURE_TYPE),
    procedure_type(PROCEDURE_TYPE),
    not is_article_65_procedure(PROCEDURE_TYPE)
)

shortlisting_invitation_floor(PROCEDURE_TYPE, DECLARED_MINIMUM_CANDIDATES, QUALIFIED_CANDIDATES, QUALIFIED_CANDIDATES) <- (
    ground(PROCEDURE_TYPE),
    procedure_type(PROCEDURE_TYPE),
    is_article_65_procedure(PROCEDURE_TYPE),
    shortlisting_count(DECLARED_MINIMUM_CANDIDATES),
    shortlisting_count(QUALIFIED_CANDIDATES),
    statutory_minimum_candidates(PROCEDURE_TYPE, STATUTORY_MINIMUM),
    DECLARED_MINIMUM_CANDIDATES < STATUTORY_MINIMUM
)

shortlisting_invitation_floor(PROCEDURE_TYPE, DECLARED_MINIMUM_CANDIDATES, QUALIFIED_CANDIDATES, QUALIFIED_CANDIDATES) <- (
    ground(PROCEDURE_TYPE),
    procedure_type(PROCEDURE_TYPE),
    is_article_65_procedure(PROCEDURE_TYPE),
    shortlisting_count(DECLARED_MINIMUM_CANDIDATES),
    shortlisting_count(QUALIFIED_CANDIDATES),
    statutory_minimum_candidates(PROCEDURE_TYPE, STATUTORY_MINIMUM),
    DECLARED_MINIMUM_CANDIDATES >= STATUTORY_MINIMUM,
    QUALIFIED_CANDIDATES < DECLARED_MINIMUM_CANDIDATES
)

shortlisting_invitation_floor(PROCEDURE_TYPE, DECLARED_MINIMUM_CANDIDATES, QUALIFIED_CANDIDATES, DECLARED_MINIMUM_CANDIDATES) <- (
    ground(PROCEDURE_TYPE),
    procedure_type(PROCEDURE_TYPE),
    is_article_65_procedure(PROCEDURE_TYPE),
    shortlisting_count(DECLARED_MINIMUM_CANDIDATES),
    shortlisting_count(QUALIFIED_CANDIDATES),
    statutory_minimum_candidates(PROCEDURE_TYPE, STATUTORY_MINIMUM),
    DECLARED_MINIMUM_CANDIDATES >= STATUTORY_MINIMUM,
    QUALIFIED_CANDIDATES >= DECLARED_MINIMUM_CANDIDATES
)

# =====================================================================
# shortlisting_limitation_modality/4 -- numeric-only modality,
# total over all six procedure atoms.
# =====================================================================
shortlisting_limitation_modality(PROCEDURE_TYPE, DECLARED_MINIMUM_CANDIDATES, QUALIFIED_CANDIDATES, limitation_not_available) <- (
    ground(PROCEDURE_TYPE),
    procedure_type(PROCEDURE_TYPE),
    not is_article_65_procedure(PROCEDURE_TYPE)
)

shortlisting_limitation_modality(PROCEDURE_TYPE, DECLARED_MINIMUM_CANDIDATES, QUALIFIED_CANDIDATES, limitation_prohibited) <- (
    ground(PROCEDURE_TYPE),
    procedure_type(PROCEDURE_TYPE),
    is_article_65_procedure(PROCEDURE_TYPE),
    shortlisting_count(DECLARED_MINIMUM_CANDIDATES),
    shortlisting_count(QUALIFIED_CANDIDATES),
    statutory_minimum_candidates(PROCEDURE_TYPE, STATUTORY_MINIMUM),
    DECLARED_MINIMUM_CANDIDATES < STATUTORY_MINIMUM
)

shortlisting_limitation_modality(PROCEDURE_TYPE, DECLARED_MINIMUM_CANDIDATES, QUALIFIED_CANDIDATES, continuation_permitted) <- (
    ground(PROCEDURE_TYPE),
    procedure_type(PROCEDURE_TYPE),
    is_article_65_procedure(PROCEDURE_TYPE),
    shortlisting_count(DECLARED_MINIMUM_CANDIDATES),
    shortlisting_count(QUALIFIED_CANDIDATES),
    statutory_minimum_candidates(PROCEDURE_TYPE, STATUTORY_MINIMUM),
    DECLARED_MINIMUM_CANDIDATES >= STATUTORY_MINIMUM,
    QUALIFIED_CANDIDATES < DECLARED_MINIMUM_CANDIDATES
)

shortlisting_limitation_modality(PROCEDURE_TYPE, DECLARED_MINIMUM_CANDIDATES, QUALIFIED_CANDIDATES, limitation_permitted) <- (
    ground(PROCEDURE_TYPE),
    procedure_type(PROCEDURE_TYPE),
    is_article_65_procedure(PROCEDURE_TYPE),
    shortlisting_count(DECLARED_MINIMUM_CANDIDATES),
    shortlisting_count(QUALIFIED_CANDIDATES),
    statutory_minimum_candidates(PROCEDURE_TYPE, STATUTORY_MINIMUM),
    DECLARED_MINIMUM_CANDIDATES >= STATUTORY_MINIMUM,
    QUALIFIED_CANDIDATES >= DECLARED_MINIMUM_CANDIDATES
)

# =====================================================================
# shortlisting_inclusion_modality/2 -- Art 65(2) sub-para 3 sentence 3.
# TOTAL over the three candidate-status atoms.
# =====================================================================
shortlisting_inclusion_modality(requested_and_has_required_capabilities, inclusion_permitted),
shortlisting_inclusion_modality(requested_without_required_capabilities, inclusion_prohibited),

shortlisting_inclusion_modality(did_not_request_to_participate, inclusion_prohibited)

# =====================================================================
# shortlisting_status_values/1 -- enumeration query type #4.
# =====================================================================
shortlisting_status_values([limitation_not_available, limitation_prohibited, continuation_permitted, limitation_permitted])

# =====================================================================
# Defect limb definitions -- eight clauses, one per Art 65(2) sentence.
# Each clause fires independently; the findall in decide_shortlisting
# collects them in statutory order (clause definition order).
# =====================================================================
defect_limb(False, _MINIMUM_INDICATED, _DECLARED_MINIMUM, _DECLARED_MAXIMUM, _STATUTORY_MINIMUM, _FLOOR, _INVITED, _SUFFICIENT, _NON_REQUESTING, _NO_CAPABILITIES, objective_and_non_discriminatory_criteria_not_indicated) <- (
    implements(eu_dir_2014_24_art_65_2_indication)
),
defect_limb(_CRITERIA_INDICATED, False, _DECLARED_MINIMUM, _DECLARED_MAXIMUM, _STATUTORY_MINIMUM, _FLOOR, _INVITED, _SUFFICIENT, _NON_REQUESTING, _NO_CAPABILITIES, minimum_number_not_indicated) <- (
    implements(eu_dir_2014_24_art_65_2_indication)
),

defect_limb(_CRITERIA_INDICATED, _MINIMUM_INDICATED, DECLARED_MINIMUM, _DECLARED_MAXIMUM, STATUTORY_MINIMUM, _FLOOR, _INVITED, _SUFFICIENT, _NON_REQUESTING, _NO_CAPABILITIES, declared_minimum_below_statutory_minimum) <- (
    implements(eu_dir_2014_24_art_65_2_minima),
    DECLARED_MINIMUM < STATUTORY_MINIMUM
)

defect_limb(_CRITERIA_INDICATED, _MINIMUM_INDICATED, DECLARED_MINIMUM, DECLARED_MAXIMUM, _STATUTORY_MINIMUM, _FLOOR, _INVITED, _SUFFICIENT, _NON_REQUESTING, _NO_CAPABILITIES, declared_maximum_below_declared_minimum) <- (
    implements(eu_dir_2014_24_art_65_2_indication),
    DECLARED_MAXIMUM > 0,
    DECLARED_MAXIMUM < DECLARED_MINIMUM
)

defect_limb(_CRITERIA_INDICATED, _MINIMUM_INDICATED, _DECLARED_MINIMUM, _DECLARED_MAXIMUM, _STATUTORY_MINIMUM, _FLOOR, _INVITED, False, _NON_REQUESTING, _NO_CAPABILITIES, genuine_competition_not_ensured) <- (
    implements(eu_dir_2014_24_art_65_2_genuine_competition)
),

defect_limb(_CRITERIA_INDICATED, _MINIMUM_INDICATED, _DECLARED_MINIMUM, _DECLARED_MAXIMUM, _STATUTORY_MINIMUM, FLOOR, INVITED, _SUFFICIENT, _NON_REQUESTING, _NO_CAPABILITIES, fewer_invited_than_minimum_number) <- (
    implements(eu_dir_2014_24_art_65_2_invitation_floor),
    INVITED < FLOOR
)

defect_limb(_CRITERIA_INDICATED, _MINIMUM_INDICATED, _DECLARED_MINIMUM, _DECLARED_MAXIMUM, _STATUTORY_MINIMUM, _FLOOR, _INVITED, _SUFFICIENT, True, _NO_CAPABILITIES, non_requesting_economic_operator_included) <- (
    implements(eu_dir_2014_24_art_65_2_prohibition)
),
defect_limb(_CRITERIA_INDICATED, _MINIMUM_INDICATED, _DECLARED_MINIMUM, _DECLARED_MAXIMUM, _STATUTORY_MINIMUM, _FLOOR, _INVITED, _SUFFICIENT, _NON_REQUESTING, True, candidate_without_required_capabilities_included) <- (
    implements(eu_dir_2014_24_art_65_2_prohibition)
),

# =====================================================================
# Limb-to-citation mapping -- eight facts.
# =====================================================================
limb_citation(objective_and_non_discriminatory_criteria_not_indicated, cite(eu_dir_2014_24_art_65_2_indication)),
limb_citation(minimum_number_not_indicated, cite(eu_dir_2014_24_art_65_2_indication)),
limb_citation(declared_minimum_below_statutory_minimum, cite(eu_dir_2014_24_art_65_2_minima)),
limb_citation(declared_maximum_below_declared_minimum, cite(eu_dir_2014_24_art_65_2_indication)),
limb_citation(genuine_competition_not_ensured, cite(eu_dir_2014_24_art_65_2_genuine_competition)),
limb_citation(fewer_invited_than_minimum_number, cite(eu_dir_2014_24_art_65_2_invitation_floor)),
limb_citation(non_requesting_economic_operator_included, cite(eu_dir_2014_24_art_65_2_prohibition)),

limb_citation(candidate_without_required_capabilities_included, cite(eu_dir_2014_24_art_65_2_prohibition))

# =====================================================================
# determine_status/6 -- status precedence (internal helper).
# (i) any defect -> limitation_prohibited
# (ii) no defects, qualified < declared -> continuation_permitted
# (iii) no defects, qualified >= declared -> limitation_permitted
# NUMBER_TO_INVITE is always FLOOR (the floor computation encodes the
# correct number for each case).
# =====================================================================
determine_status(DEFECT_IDS, _QUALIFIED, _DECLARED_MINIMUM, FLOOR, limitation_prohibited, FLOOR) <- (
    not DEFECT_IDS is []
)

determine_status([], QUALIFIED, DECLARED_MINIMUM, FLOOR, continuation_permitted, FLOOR) <- (
    QUALIFIED < DECLARED_MINIMUM
)

determine_status([], QUALIFIED, DECLARED_MINIMUM, FLOOR, limitation_permitted, FLOOR) <- (
    QUALIFIED >= DECLARED_MINIMUM
)

# =====================================================================
# decide_shortlisting/2 -- the main determination.
# Two disjoint clauses: not-Art-65 (ground verdict) and Art-65 (computed).
# =====================================================================
shortlisting_decide(PROFILE, shortlisting_verdict(limitation_not_available, [], 0, [])) <- (
    implements(eu_dir_2014_24_art_65_1),
    profile_get(PROFILE, procedure_type_key, PROCEDURE_TYPE),
    procedure_type(PROCEDURE_TYPE),
    not is_article_65_procedure(PROCEDURE_TYPE)
)

shortlisting_decide(PROFILE, shortlisting_verdict(STATUS, DEFECT_IDS, NUMBER_TO_INVITE, CITATIONS)) <- (
    implements(eu_dir_2014_24_art_65_1),
    profile_get(PROFILE, procedure_type_key, PROCEDURE_TYPE),
    procedure_type(PROCEDURE_TYPE),
    is_article_65_procedure(PROCEDURE_TYPE),
    profile_get(PROFILE, objective_and_non_discriminatory_criteria_indicated, CRITERIA_INDICATED),
    profile_get(PROFILE, minimum_number_indicated, MINIMUM_INDICATED),
    profile_get(PROFILE, declared_minimum_candidates, DECLARED_MINIMUM),
    profile_get(PROFILE, declared_maximum_candidates, DECLARED_MAXIMUM),
    profile_get(PROFILE, qualified_candidates, QUALIFIED),
    profile_get(PROFILE, invited_candidates, INVITED),
    profile_get(PROFILE, number_invited_sufficient_for_genuine_competition, SUFFICIENT),
    profile_get(PROFILE, invited_include_non_requesting_economic_operators, NON_REQUESTING),
    profile_get(PROFILE, invited_include_candidates_without_required_capabilities, NO_CAPABILITIES),
    statutory_minimum_candidates(PROCEDURE_TYPE, STATUTORY_MINIMUM),
    shortlisting_invitation_floor(PROCEDURE_TYPE, DECLARED_MINIMUM, QUALIFIED, FLOOR),
    findall(LIMB_ATOM, defect_limb(CRITERIA_INDICATED, MINIMUM_INDICATED, DECLARED_MINIMUM, DECLARED_MAXIMUM, STATUTORY_MINIMUM, FLOOR, INVITED, SUFFICIENT, NON_REQUESTING, NO_CAPABILITIES, LIMB_ATOM), DEFECT_IDS),
    findall(CITATION, (EACH_LIMB in DEFECT_IDS, limb_citation(EACH_LIMB, CITATION)), CITATIONS),
    determine_status(DEFECT_IDS, QUALIFIED, DECLARED_MINIMUM, FLOOR, STATUS, NUMBER_TO_INVITE)
)

# =====================================================================
# shortlisting_status/2 -- status projection.
# =====================================================================
shortlisting_status(PROFILE, STATUS) <- (
    decide_shortlisting(PROFILE, shortlisting_verdict(STATUS, _, _, _))
)

# =====================================================================
# shortlisting_checklist/2 -- one item per fired defect, or one met item
# if no defects.
# =====================================================================
shortlisting_checklist(PROFILE, [item(STATUS, met, cite(eu_dir_2014_24_art_65_1))]) <- (
    decide_shortlisting(PROFILE, shortlisting_verdict(STATUS, DEFECT_IDS, _NUMBER_TO_INVITE, _CITATIONS)),
    DEFECT_IDS is []
)

shortlisting_checklist(PROFILE, CHECKLIST) <- (
    decide_shortlisting(PROFILE, shortlisting_verdict(_STATUS, DEFECT_IDS, _NUMBER_TO_INVITE, _CITATIONS)),
    not DEFECT_IDS is [],
    findall(CHECKLIST_ITEM, (EACH_LIMB in DEFECT_IDS, limb_citation(EACH_LIMB, CITATION), CHECKLIST_ITEM is item(EACH_LIMB, unmet(EACH_LIMB), CITATION)), CHECKLIST)
)

# =====================================================================
# shortlisting_decision_resolvable/1 -- succeeds iff decide_shortlisting
# yields a solution.
# =====================================================================
shortlisting_decision_resolvable(PROFILE) <- (
    decide_shortlisting(PROFILE, _)
)

# =====================================================================
# shortlisting_what_if/4 -- re-evaluate with one profile key overridden.
# =====================================================================
shortlisting_what_if(PROFILE, OVERRIDDEN_KEY, NEW_VALUE, NEW_STATUS) <- (
    not shortlisting_input_problem(PROFILE, _),
    ground(OVERRIDDEN_KEY),
    override_key(PROFILE, OVERRIDDEN_KEY, NEW_VALUE, MODIFIED_PROFILE),
    decide_shortlisting(MODIFIED_PROFILE, shortlisting_verdict(NEW_STATUS, _, _, _))
)

# =====================================================================
# shortlisting_profile_keys/1 -- the ten-key schema.
# =====================================================================
shortlisting_profile_keys([procedure_type_key, objective_and_non_discriminatory_criteria_indicated, minimum_number_indicated, declared_minimum_candidates, declared_maximum_candidates, qualified_candidates, invited_candidates, number_invited_sufficient_for_genuine_competition, invited_include_non_requesting_economic_operators, invited_include_candidates_without_required_capabilities])

# =====================================================================
# THE INPUT CHECK (D80, 2026-10-20). One check for the domain, run before
# any rule decides. decide_shortlisting/2 calls it, and every other entry
# point that takes a profile goes through decide_shortlisting/2
# (shortlisting_status/2, shortlisting_checklist/2,
# shortlisting_decision_resolvable/1, the fixtures wrapper); the what-if
# entry points check the profile before overriding a key, and the
# overridden profile is checked again by decide_shortlisting/2.
#
# shortlisting_input_problem(PROFILE, PROBLEM) gives the FIRST problem with
# PROFILE and fails when there is none. It is total and negation-safe:
# ground(PROFILE) is tested first, then that PROFILE is a dict, and only then
# are values read; no count is compared before integer/1 has accepted it.
#
# It refuses: a profile that is not ground or not a dict; a missing
# procedure_type_key or one outside the six-atom Art 26 vocabulary; any PRESENT
# key of the wrong type (booleans must be True/False exactly, counts
# non-negative integers, profile_keys.yaml key_contract); and, for the four
# Art 65(1) procedures, any of the nine Art 65(2) keys being absent. For the
# open procedure and the negotiated procedure without prior publication the
# nine keys may be absent: Art 65(1) gives no power to limit there, so they
# are not read (manifest.yaml scope).
#
# What a refused profile gives: the domain has no "cannot decide" status, so
# decide_shortlisting/2 fails (no answer) and shortlisting_decision_resolvable/1
# fails with it.
# =====================================================================
shortlisting_input_problem(PROFILE, PROBLEM) <- (
    shortlisting_input_problems(PROFILE, [PROBLEM, *_])
)

shortlisting_input_problems(PROFILE, [not_ground]) <- (
    not ground(PROFILE)
)

shortlisting_input_problems(PROFILE, [wrong_type(profile, expected_dict)]) <- (
    ground(PROFILE),
    not is_dict(PROFILE)
)

shortlisting_input_problems(PROFILE, PROBLEMS) <- (
    ground(PROFILE),
    is_dict(PROFILE),
    findall(PROBLEM, shortlisting_profile_problem(PROFILE, PROBLEM), PROBLEMS)
)

shortlisting_boolean_key(objective_and_non_discriminatory_criteria_indicated),
shortlisting_boolean_key(minimum_number_indicated),
shortlisting_boolean_key(number_invited_sufficient_for_genuine_competition),
shortlisting_boolean_key(invited_include_non_requesting_economic_operators),
shortlisting_boolean_key(invited_include_candidates_without_required_capabilities),

shortlisting_count_key(declared_minimum_candidates),
shortlisting_count_key(declared_maximum_candidates),
shortlisting_count_key(qualified_candidates),
shortlisting_count_key(invited_candidates),

shortlisting_article_65_key(objective_and_non_discriminatory_criteria_indicated),
shortlisting_article_65_key(minimum_number_indicated),
shortlisting_article_65_key(declared_minimum_candidates),
shortlisting_article_65_key(declared_maximum_candidates),
shortlisting_article_65_key(qualified_candidates),
shortlisting_article_65_key(invited_candidates),
shortlisting_article_65_key(number_invited_sufficient_for_genuine_competition),
shortlisting_article_65_key(invited_include_non_requesting_economic_operators),
shortlisting_article_65_key(invited_include_candidates_without_required_capabilities),

shortlisting_boolean(True),
shortlisting_boolean(False),

# A count of candidates: a non-negative integer (integer/1 first, so the
# comparison never sees a non-number).
shortlisting_count(VALUE) <- (
    integer(VALUE),
    VALUE >= 0
)

shortlisting_profile_problem(PROFILE, missing_key(procedure_type_key)) <- (
    not get(PROFILE, procedure_type_key, _)
)

shortlisting_profile_problem(PROFILE, wrong_value(procedure_type_key, expected_procedure_type_atom)) <- (
    get(PROFILE, procedure_type_key, PROCEDURE_TYPE),
    not procedure_type(PROCEDURE_TYPE)
)

shortlisting_profile_problem(PROFILE, missing_key(KEY)) <- (
    get(PROFILE, procedure_type_key, PROCEDURE_TYPE),
    is_article_65_procedure(PROCEDURE_TYPE),
    shortlisting_article_65_key(KEY),
    not get(PROFILE, KEY, _)
)

shortlisting_profile_problem(PROFILE, wrong_type(KEY, expected_boolean)) <- (
    shortlisting_boolean_key(KEY),
    get(PROFILE, KEY, VALUE),
    not shortlisting_boolean(VALUE)
)

shortlisting_profile_problem(PROFILE, wrong_type(KEY, expected_integer_count)) <- (
    shortlisting_count_key(KEY),
    get(PROFILE, KEY, VALUE),
    not integer(VALUE)
)

shortlisting_profile_problem(PROFILE, negative_count(KEY)) <- (
    shortlisting_count_key(KEY),
    get(PROFILE, KEY, VALUE),
    integer(VALUE),
    VALUE < 0
)

# ---- The guarded public decision predicate -----------------------------
decide_shortlisting(PROFILE, VERDICT) <- (
    not shortlisting_input_problem(PROFILE, _),
    shortlisting_decide(PROFILE, VERDICT)
)
