# =====================================================================
# citations.clausal -- statutory citation atoms for eu/procurement/framework_agreements.
#
# citation/2 format: citation(ATOM, {"label": LABEL, "ref": REF, "verbatim": VERBATIM})
#
# Source: Directive 2014/24/EU (OJ L 94, 28.3.2014), Article 33, paragraphs 1-5.
# =====================================================================
-module(citations, [
    cite(KEY),
    implements(KEY),
    citation(KEY, METADATA),
    eu_dir_2014_24_art_33_1,
    eu_dir_2014_24_art_33_2,
    eu_dir_2014_24_art_33_3,
    eu_dir_2014_24_art_33_4,
    eu_dir_2014_24_art_33_5
])
-double_quotes(chars)
-private([label, ref, units, verbatim])

citation(eu_dir_2014_24_art_33_1, {
  units:    ["02014L0024-20260101#parag_033.001"],
  label:    "Directive 2014/24/EU, Article 33(1) -- four-year limit on the term of a framework agreement",
  ref:      "http://publications.europa.eu/resource/celex/02014L0024-20260101.ENG.fmx4",
  verbatim: "The term of a framework agreement shall not exceed four years, save in exceptional cases duly justified, in particular by the subject of the framework agreement."
}),
citation(eu_dir_2014_24_art_33_2, {
  units:    ["02014L0024-20260101#parag_033.002"],
  label:    "Directive 2014/24/EU, Article 33(2) -- call-offs: identified parties, no substantial modification",
  ref:      "http://publications.europa.eu/resource/celex/02014L0024-20260101.ENG.fmx4",
  verbatim: "Contracts based on a framework agreement may under no circumstances entail substantial modifications to the terms laid down in that framework agreement, in particular in the case referred to in paragraph 3."
}),
citation(eu_dir_2014_24_art_33_3, {
  units:    ["02014L0024-20260101#parag_033.003"],
  label:    "Directive 2014/24/EU, Article 33(3) -- single-operator framework: award within the limits of its terms",
  ref:      "http://publications.europa.eu/resource/celex/02014L0024-20260101.ENG.fmx4",
  verbatim: "Where a framework agreement is concluded with a single economic operator, contracts based on that agreement shall be awarded within the limits of the terms laid down in the framework agreement."
}),
citation(eu_dir_2014_24_art_33_4, {
  units:    ["02014L0024-20260101#parag_033.004", "02014L0024-20260101#point_033.004_a", "02014L0024-20260101#point_033.004_b", "02014L0024-20260101#point_033.004_c"],
  label:    "Directive 2014/24/EU, Article 33(4) and points (a) to (c) -- the three routes for a multi-operator framework",
  ref:      "http://publications.europa.eu/resource/celex/02014L0024-20260101.ENG.fmx4",
  verbatim: "Where a framework agreement is concluded with more than one economic operator, that framework agreement shall be performed in one of the following ways:"
}),
citation(eu_dir_2014_24_art_33_5, {
  units:    ["02014L0024-20260101#parag_033.005", "02014L0024-20260101#point_033.005_a", "02014L0024-20260101#point_033.005_b", "02014L0024-20260101#point_033.005_c", "02014L0024-20260101#point_033.005_d"],
  label:    "Directive 2014/24/EU, Article 33(5) and points (a) to (d) -- procedure for a reopened competition",
  ref:      "http://publications.europa.eu/resource/celex/02014L0024-20260101.ENG.fmx4",
  verbatim: "The competitions referred to in points (b) and (c) of paragraph 4 shall be based on the same terms as applied for the award of the framework agreement and, where necessary, more precisely formulated terms"
}),

# =====================================================================
# implements/1 -- the in-clause provenance marker (convention 2026-08-28).
# DEFINED, not merely declared: a declared-only predicate has no dispatch and
# RAISES when called. It succeeds for every key this module records and fails
# loudly for one it does not. `cite/1` above is the DATA constructor for the
# citation term a verdict returns; the two are kept apart on purpose.
# =====================================================================
implements(KEY) <- (
    citation(KEY, _)
)
