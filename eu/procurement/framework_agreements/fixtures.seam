# =====================================================================
# fixtures.clausal -- representative profiles for eu/procurement/framework_agreements.
# A TOP-LAYER consumer: import the determination slices' PUBLICS you call
# and the key atoms you spell in a profile dict.
#
# For EVERY route: a positive (lawful) case AND a one-unit near-miss control.
# Plus framework-term boundary cases.
# =====================================================================
-module(fixtures, [
    framework_agreements_subject(SUBJECT),
    framework_agreements_profile_for(SUBJECT, PROFILE),
    framework_agreements_assess(SUBJECT, RESULT)
])
-double_quotes(chars)

-import_from(eu.procurement.framework_agreements.framework_agreements, [
    decide_framework_agreements,
    decide_call_off,
    decide_framework_term,
    framework_start_date,
    framework_end_date,
    call_off_award_date,
    framework_operator_count,
    call_off_method_key,
    exceptional_case_duly_justified,
    contracting_authority_identified_in_call_for_competition,
    economic_operator_party_to_framework,
    call_off_entails_substantial_modification,
    call_off_within_limits_of_framework_terms,
    framework_sets_out_all_terms,
    objective_conditions_for_determining_performer_indicated,
    partly_with_partly_without_reopening_stipulated,
    objective_criteria_for_choice_of_route_stated,
    terms_subject_to_reopening_specified,
    reopened_competition_based_on_framework_terms,
    capable_operators_consulted_in_writing,
    time_limit_sufficiently_long,
    tenders_submitted_in_writing,
    tender_contents_confidential_until_time_limit_expired,
    award_made_on_framework_award_criteria,
    without_reopening_competition,
    with_reopening_competition
])

-import_from(eu.procurement.framework_agreements.kernel, [framework_agreements_verdict])

-import_from(date_time, [date])

# =====================================================================
# Subject registry
# =====================================================================
framework_agreements_subject("single_op_lawful"),
framework_agreements_subject("single_op_outside_term"),
framework_agreements_subject("multi_direct_all_lawful"),
framework_agreements_subject("multi_direct_all_no_conditions"),
framework_agreements_subject("multi_direct_split_lawful"),
framework_agreements_subject("multi_direct_split_no_terms_spec"),
framework_agreements_subject("multi_reopen_lawful"),
framework_agreements_subject("multi_reopen_short_time"),
framework_agreements_subject("no_route_single_reopen"),
framework_agreements_subject("no_route_multi_all_nosplit"),
framework_agreements_subject("term_boundary"),
framework_agreements_subject("term_exceeds"),
framework_agreements_subject("term_justified"),

# =====================================================================
# Profiles
# =====================================================================

# Route 1: single_operator_direct_award -- lawful
framework_agreements_profile_for("single_op_lawful", {
    framework_start_date: date(2024, 1, 1),
    framework_end_date: date(2027, 1, 1),
    call_off_award_date: date(2025, 6, 15),
    framework_operator_count: 1,
    call_off_method_key: without_reopening_competition,
    exceptional_case_duly_justified: False,
    contracting_authority_identified_in_call_for_competition: True,
    economic_operator_party_to_framework: True,
    call_off_entails_substantial_modification: False,
