-double_quotes(chars)
# eu.procurement.time_limits/__init__.clausal -- thin package init.
# Re-exports the domain's PUBLIC surface from its named submodules.
# Keep in sync with manifest.yaml public_interface.
#
# Determination-slices re-slice (2026-08-07): the export NAME SET is unchanged
# (compat contract -- it still equals manifest.yaml public_interface exactly);
# only the SOURCE submodule moved. schema -> kernel (time_limits_verdict) and
# -> time_limits (the status/day-slot/checklist-id/profile-key/stage/
# reduction-condition atoms); constants + computation + decision ->
# time_limits, the single determination slice.
#
# HAND-MAINTAINED, deliberately: auto/pkginit.py sources re-exports only from
# the domain's OWN submodules, so a regeneration silently DROPS the five
# eu.procurement.directive_2014_24.vocabulary procedure atoms at the bottom of this file. They are
# in manifest.yaml public_interface, tests/test_public_interface.clausal
# imports two of them from this package root, and eval/score_harness.py
# resolves all five through it via getattr. Verified by dry-running
# pkginit.render() against the pre-change tree: 44 names, not 49.
-import_from(eu.procurement.time_limits.kernel, [
    time_limits_verdict])
-import_from(eu.procurement.time_limits.time_limits, [
    minimum_days_prescribed, no_minimum_prescribed, stage_not_applicable,
    n_a, overall,
    meets_prescribed_minimum, shorter_than_prescribed_minimum,
    observed_days_not_supplied, no_prescribed_minimum_to_meet,
    procedure_type_key, stage_key,
    prior_information_notice_published,
    electronic_submission_accepted,
    state_of_urgency_substantiated,
    observed_time_limit_days,
    receipt_of_tenders, receipt_of_participation_requests,
    baseline_minimum, with_prior_information_notice,
    with_electronic_submission, under_state_of_urgency,
    time_limits_status_values,
    time_limits_conformity_values,
    time_limits_stage_values,
    time_limits_reduction_condition_values,
    minimum_time_limit_days,
    no_minimum_prescribed_for,
    stage_not_provided_for,
    decide_time_limits, time_limits_status, minimum_days,
    time_limits_conformity, observed_days_conformity,
    applicable_reduction_condition, candidate_time_limit,
    time_limits_checklist, time_limits_decision_resolvable,
    time_limits_input_problem, time_limits_input_acceptable,
    not_ground, not_a_dict, missing_key, wrong_value, wrong_type,
    negative_count,
    expected_procedure_type, expected_stage, expected_boolean,
    expected_integer])
-import_from(eu.procurement.time_limits.citations, [
    cite, citation,
    eu_dir_2014_24_art_27,
    eu_dir_2014_24_art_28,
    eu_dir_2014_24_art_29,
    eu_dir_2014_24_art_30,
    eu_dir_2014_24_art_31])
-import_from(eu.procurement.time_limits.queries, [
    time_limits_profile_keys, time_limits_what_if,
    time_limits_enumerate, time_limits_floor])
-import_from(eu.procurement.time_limits.fixtures, [
    time_limits_subject, time_limits_profile_for, time_limits_assess])
# Re-export the procedure-type atoms from common that form the profile
# vocabulary (the valid values for procedure_type_key). The Python eval
# harness resolves them through this package surface.
-import_from(eu.procurement.directive_2014_24.vocabulary, [
    open_procedure,
    restricted_procedure,
    competitive_procedure_with_negotiation,
    competitive_dialogue,
    innovation_partnership])
