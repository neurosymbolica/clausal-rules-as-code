% =====================================================================
% citations.clausal -- statutory citation atoms for eu/procurement/time_limits.
% Source: EU Directive 2014/24/EU Arts 27-31 (minimum time limits for
% receipt of tenders / requests to participate, per procedure).
%
% citation/2 format: citation(ATOM, {"label": LABEL, "ref": REF})
% =====================================================================
% Clausal Prolog record form (the Prolog citation checker's signed-off shape):
%   citation(Key, [label-'...', ref-'...', verbatim-'...', units-['...', ...]]).
% label, ref, verbatim in that order, units last; every value a quoted atom.
% cite/1 is a data constructor and the five citation keys are atoms: neither
% needs (or can have) an export entry in a .clausal module.

:- module(citations, [
    citation/2,
    implements/1
]).

citation(eu_dir_2014_24_art_27, [
    label-'Directive 2014/24/EU, Article 27 (Open procedure)',
    ref-'http://publications.europa.eu/resource/celex/02014L0024-20260101.ENG.fmx4',
    verbatim-'The minimum time limit for the receipt of tenders shall be 35 days from the date on which the contract notice was sent.',
    units-['02014L0024-20260101#parag_027.001', '02014L0024-20260101#parag_027.002', '02014L0024-20260101#point_027.002_a', '02014L0024-20260101#point_027.002_b', '02014L0024-20260101#parag_027.003', '02014L0024-20260101#parag_027.004']
]).

citation(eu_dir_2014_24_art_28, [
    label-'Directive 2014/24/EU, Article 28 (Restricted procedure)',
    ref-'http://publications.europa.eu/resource/celex/02014L0024-20260101.ENG.fmx4',
    verbatim-'The minimum time limit for receipt of requests to participate shall be 30 days from the date on which the contract notice or, where a prior information notice is used as a means of calling for competition, the invitation to confirm interest was sent.',
    units-['02014L0024-20260101#parag_028.001', '02014L0024-20260101#parag_028.002', '02014L0024-20260101#parag_028.003', '02014L0024-20260101#point_028.003_a', '02014L0024-20260101#point_028.003_b', '02014L0024-20260101#parag_028.005', '02014L0024-20260101#parag_028.006', '02014L0024-20260101#point_028.006_a', '02014L0024-20260101#point_028.006_b']
]).

citation(eu_dir_2014_24_art_29, [
    label-'Directive 2014/24/EU, Article 29 (Competitive procedure with negotiation)',
    ref-'http://publications.europa.eu/resource/celex/02014L0024-20260101.ENG.fmx4',
    verbatim-'The minimum time limit for receipt of requests to participate shall be 30 days from the date on which the contract notice or, where a prior information notice is used as a means of calling for competition, the invitation to confirm interest was sent. The minimum time limit for the receipt of initial tenders shall be 30 days from the date on which the invitation was sent. Article 28(3) to (6) shall apply.',
    units-['02014L0024-20260101#parag_029.001']
]).

citation(eu_dir_2014_24_art_30, [
    label-'Directive 2014/24/EU, Article 30 (Competitive dialogue)',
    ref-'http://publications.europa.eu/resource/celex/02014L0024-20260101.ENG.fmx4',
    verbatim-'The minimum time limit for receipt of requests to participate shall be 30 days from the date on which the contract notice was sent.',
    units-['02014L0024-20260101#parag_030.001']
]).

citation(eu_dir_2014_24_art_31, [
    label-'Directive 2014/24/EU, Article 31 (Innovation partnership)',
    ref-'http://publications.europa.eu/resource/celex/02014L0024-20260101.ENG.fmx4',
    verbatim-'The minimum time limit for receipt of requests to participate shall be 30 days from the date on which the contract notice is sent.',
    units-['02014L0024-20260101#parag_031.001']
]).

% =====================================================================
% implements/1 -- the in-clause provenance marker (convention 2026-08-28).
% DEFINED, not merely declared: a declared-only predicate has no dispatch and
% RAISES when called. It succeeds for every key this module records and fails
% loudly for one it does not. `cite/1` above is the DATA constructor for the
% citation term a verdict returns; the two are kept apart on purpose, and the
% coverage scanner reads ONLY this one.
% =====================================================================
implements(Key) :-
    citation(Key, _).

:- end_module(citations).
