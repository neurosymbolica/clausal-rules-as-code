-double_quotes(chars)
# Run: cd <corpus root> && python -m clausal.testing \
#      eu/procurement/time_limits/tests/test_load.clausal
-import_from(eu.procurement.time_limits.kernel, [
    time_limits_verdict])
-import_from(eu.procurement.time_limits.time_limits, [
    minimum_days_prescribed, no_minimum_prescribed, stage_not_applicable,
    n_a,
    meets_prescribed_minimum, shorter_than_prescribed_minimum,
    observed_days_not_supplied, no_prescribed_minimum_to_meet,
    receipt_of_tenders, receipt_of_participation_requests,
    baseline_minimum, with_prior_information_notice,
    with_electronic_submission, under_state_of_urgency])
-strict_atoms

test("schema status atoms load and are distinct") <- (
    not (minimum_days_prescribed is no_minimum_prescribed),
    not (minimum_days_prescribed is stage_not_applicable),
    not (no_minimum_prescribed is stage_not_applicable)
)

test("stage atoms load and are distinct") <- (
    not (receipt_of_tenders is receipt_of_participation_requests)
)

test("reduction-condition atoms load and are distinct") <- (
    not (baseline_minimum is with_prior_information_notice),
    not (with_prior_information_notice is with_electronic_submission),
    not (with_electronic_submission is under_state_of_urgency),
    not (baseline_minimum is under_state_of_urgency)
)

test("verdict constructor round-trips its four slots") <- (
    VERDICT is time_limits_verdict(
        minimum_days_prescribed, 35, meets_prescribed_minimum, []),
    VERDICT is time_limits_verdict(STATUS, MINIMUM_DAYS, CONFORMITY, CITATIONS),
    STATUS is minimum_days_prescribed,
    MINIMUM_DAYS == 35,
    CONFORMITY is meets_prescribed_minimum,
    CITATIONS is []
)

test("n_a is a distinct day-slot marker") <- (
    not (n_a is minimum_days_prescribed),
    VERDICT is time_limits_verdict(
        no_minimum_prescribed, n_a, no_prescribed_minimum_to_meet, []),
    VERDICT is time_limits_verdict(_, DAY_SLOT, _, _),
    DAY_SLOT is n_a
)

test("conformity atoms load and are pairwise distinct") <- (
    not (meets_prescribed_minimum is shorter_than_prescribed_minimum),
    not (meets_prescribed_minimum is observed_days_not_supplied),
    not (meets_prescribed_minimum is no_prescribed_minimum_to_meet),
    not (shorter_than_prescribed_minimum is observed_days_not_supplied),
    not (shorter_than_prescribed_minimum is no_prescribed_minimum_to_meet),
    not (observed_days_not_supplied is no_prescribed_minimum_to_meet)
)

# The conformity slot is not the status slot wearing another name: nothing in
# one vocabulary is also in the other, so a reader (or a composition rulebase)
# matching on CONFORMITY can never accidentally match a STATUS.
test("the conformity vocabulary is disjoint from the status vocabulary") <- (
    not (meets_prescribed_minimum is minimum_days_prescribed),
    not (no_prescribed_minimum_to_meet is no_minimum_prescribed),
    not (no_prescribed_minimum_to_meet is stage_not_applicable),
    not (observed_days_not_supplied is n_a)
)
