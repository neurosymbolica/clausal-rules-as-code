-double_quotes(chars)
# =====================================================================
# test_robustness.seam -- ROBUSTNESS of the decision predicate
# decide_time_limits/2 (and the facade time_limits_decision_resolvable/1)
# against incomplete and malformed profiles.
#
# The contract these tests hold the domain to comes from NOTES.md section 1:
#   - "With no procedure type or no stage, or a procedure outside the five,
#     there is no verdict."  -> no solution, and no exception either.
#   - the three circumstance flags: "Absent means it does not apply."
#     -> a stated default (the reductions of Arts 27(2)-(4) and 28(3)-(6)
#        are permissions the authority "may" use only where the condition
#        holds), tested below as a default, not as a refusal.
#   - observed_time_limit_days is optional; its absence is reported as
#     observed_days_not_supplied (time_limits.seam header, lines 41-50).
# A malformed value is not an absent one: a flag that is neither True nor
# False, or a day count that is not a non-negative number, must not
# produce a definite verdict.
#
# Run: python -m clausal.testing eu/procurement/time_limits/tests/test_robustness.seam
# =====================================================================
-import_from(eu.procurement.time_limits, [
    time_limits_verdict,
    minimum_days_prescribed,
    meets_prescribed_minimum, shorter_than_prescribed_minimum,
    observed_days_not_supplied,
    decide_time_limits, time_limits_decision_resolvable,
    time_limits_subject, time_limits_profile_for,
    procedure_type_key, stage_key,
    receipt_of_tenders, receipt_of_participation_requests,
    prior_information_notice_published,
    electronic_submission_accepted,
    state_of_urgency_substantiated,
    observed_time_limit_days,
    open_procedure, restricted_procedure,
    cite, eu_dir_2014_24_art_27,
    time_limits_input_problem, time_limits_what_if, time_limits_checklist,
    not_ground, not_a_dict, missing_key, wrong_value, wrong_type,
    negative_count,
    expected_procedure_type, expected_stage, expected_boolean,
    expected_integer])
-private([answers(LIST), raised(ERROR), not_a_procedure, yes, forty])

# ---- helpers ---------------------------------------------------------

# OUTCOME is answers(VERDICTS) -- every verdict decide_time_limits/2 gives --
# or raised(ERROR) when the call throws.
decision_outcome(PROFILE, OUTCOME) <- (
    catch(
        (findall(VERDICT, decide_time_limits(PROFILE, VERDICT), VERDICTS),
         OUTCOME is answers(VERDICTS)),
        ERROR,
        OUTCOME is raised(ERROR))
)

# The documented answer for an unusable profile: no verdict, no exception.
gives_no_verdict(PROFILE) <- (
    decision_outcome(PROFILE, OUTCOME),
    OUTCOME is answers([])
)

# The open-procedure tender-stage profile with every flag False (the fixture
# open_tenders_baseline, minimum 35 days), spelled out so single keys can be
# changed. PIN, ELECTRONIC, URGENCY are the three flag values.
open_tenders_profile(PIN, ELECTRONIC, URGENCY, {
    procedure_type_key: open_procedure,
    stage_key: receipt_of_tenders,
    prior_information_notice_published: PIN,
    electronic_submission_accepted: ELECTRONIC,
    state_of_urgency_substantiated: URGENCY
}),

open_tenders_profile_observing(DAYS, {
    procedure_type_key: open_procedure,
    stage_key: receipt_of_tenders,
    prior_information_notice_published: False,
    electronic_submission_accepted: False,
    state_of_urgency_substantiated: False,
    observed_time_limit_days: DAYS
}),

# =====================================================================
# 1. DROPPING EACH INPUT, one at a time, from the open_tenders_baseline
#    fixture (whose 35-day verdict test_public_interface already pins).
# =====================================================================

# procedure_type_key and stage_key are required (NOTES.md section 1: "there
# is no verdict"). The domain reads them with PROFILE[KEY] subscripts
# (time_limits.seam lines 361-362, 440-441, 447-448), which raise
# existence_error(dict_key, KEY) instead of failing: an exception from inside
# the rule, not a guard.
test("dropping procedure type raises an unguarded dict key existence error instead of giving no verdict") <- (
    gives_no_verdict({
        stage_key: receipt_of_tenders,
        prior_information_notice_published: False,
        electronic_submission_accepted: False,
        state_of_urgency_substantiated: False
    })
)

test("dropping stage raises an unguarded dict key existence error instead of giving no verdict") <- (
    gives_no_verdict({
        procedure_type_key: open_procedure,
        prior_information_notice_published: False,
        electronic_submission_accepted: False,
        state_of_urgency_substantiated: False
    })
)

# The three flags default to "does not apply" (NOTES.md section 1, "Absent
# means it does not apply"; time_limits.seam lines 335-352): the reductions
# are permissions conditional on a fact, so without the fact the base figure
# of Art 27(1) stands. The verdict must equal the all-False verdict.
test("default: an absent prior information notice flag reads as not published") <- (
    decide_time_limits({
        procedure_type_key: open_procedure,
        stage_key: receipt_of_tenders,
        electronic_submission_accepted: False,
        state_of_urgency_substantiated: False
    }, VERDICT),
    VERDICT is time_limits_verdict(minimum_days_prescribed, 35, observed_days_not_supplied, [cite(eu_dir_2014_24_art_27)])
)

test("default: an absent electronic submission flag reads as not accepted") <- (
    decide_time_limits({
        procedure_type_key: open_procedure,
        stage_key: receipt_of_tenders,
        prior_information_notice_published: False,
        state_of_urgency_substantiated: False
    }, VERDICT),
    VERDICT is time_limits_verdict(minimum_days_prescribed, 35, observed_days_not_supplied, [cite(eu_dir_2014_24_art_27)])
)

test("default: an absent urgency flag reads as not substantiated") <- (
    decide_time_limits({
        procedure_type_key: open_procedure,
        stage_key: receipt_of_tenders,
        prior_information_notice_published: False,
        electronic_submission_accepted: False
    }, VERDICT),
    VERDICT is time_limits_verdict(minimum_days_prescribed, 35, observed_days_not_supplied, [cite(eu_dir_2014_24_art_27)])
)

# observed_time_limit_days is optional; its absence is named, never read as
# compliance (time_limits.seam lines 41-50). Dropped from the
# open_tenders_baseline_allowing_35 fixture, which otherwise meets.
test("default: an absent observed day count is reported as not supplied") <- (
    time_limits_profile_for("open_tenders_baseline_allowing_35", WITH_DAYS),
    decide_time_limits(WITH_DAYS, time_limits_verdict(_, _, meets_prescribed_minimum, _)),
    open_tenders_profile(False, False, False, WITHOUT_DAYS),
    findall(CONFORMITY,
        decide_time_limits(WITHOUT_DAYS, time_limits_verdict(_, _, CONFORMITY, _)),
        CONFORMITIES),
    CONFORMITIES is [observed_days_not_supplied]
)

# =====================================================================
# 2. WRONG TYPES for each input. Expected: no verdict.
# =====================================================================

# ---- procedure_type_key and stage_key: not one of the closed atoms -----
test("procedure type spelled as a character list gives no verdict") <- (
    gives_no_verdict({procedure_type_key: "open_procedure", stage_key: receipt_of_tenders,
        prior_information_notice_published: False, electronic_submission_accepted: False,
        state_of_urgency_substantiated: False})
)

test("procedure type given as a number gives no verdict") <- (
    gives_no_verdict({procedure_type_key: 1, stage_key: receipt_of_tenders,
        prior_information_notice_published: False, electronic_submission_accepted: False,
        state_of_urgency_substantiated: False})
)

test("procedure type given as a list gives no verdict") <- (
    gives_no_verdict({procedure_type_key: [open_procedure], stage_key: receipt_of_tenders,
        prior_information_notice_published: False, electronic_submission_accepted: False,
        state_of_urgency_substantiated: False})
)

test("procedure type outside the five procedures gives no verdict") <- (
    gives_no_verdict({procedure_type_key: not_a_procedure, stage_key: receipt_of_tenders,
        prior_information_notice_published: False, electronic_submission_accepted: False,
        state_of_urgency_substantiated: False})
)

# An unbound procedure type is not a procedure: it must not be solved for.
# decide_time_limits unifies it with every table row instead
# (time_limits.seam lines 360-366 and 439-444 read it without a type check).
test("unbound procedure type gives no verdict rather than one verdict per procedure") <- (
    gives_no_verdict({procedure_type_key: _, stage_key: receipt_of_tenders,
        prior_information_notice_published: False, electronic_submission_accepted: False,
        state_of_urgency_substantiated: False})
)

test("stage given as a number gives no verdict") <- (
    gives_no_verdict({procedure_type_key: open_procedure, stage_key: 1,
        prior_information_notice_published: False, electronic_submission_accepted: False,
        state_of_urgency_substantiated: False})
)

test("stage spelled as a character list gives no verdict") <- (
    gives_no_verdict({procedure_type_key: restricted_procedure, stage_key: "receipt_of_tenders",
        prior_information_notice_published: False, electronic_submission_accepted: False,
        state_of_urgency_substantiated: False})
)

# ---- the three flags: neither True nor False ---------------------------
# applicable_reduction_condition/2 (time_limits.seam lines 342-352) matches
# only True, so any other value silently reads as "does not apply" and the
# 35-day base verdict comes back as if the flag were False. A malformed flag
# is not an absent one.
test("prior information notice flag given as the number 1 still gives a definite verdict") <- (
    open_tenders_profile(1, False, False, PROFILE), gives_no_verdict(PROFILE)
)
test("prior information notice flag given as an atom still gives a definite verdict") <- (
    open_tenders_profile(yes, False, False, PROFILE), gives_no_verdict(PROFILE)
)
test("prior information notice flag given as a list still gives a definite verdict") <- (
    open_tenders_profile([True], False, False, PROFILE), gives_no_verdict(PROFILE)
)
test("prior information notice flag given as a character list still gives a definite verdict") <- (
    open_tenders_profile("True", False, False, PROFILE), gives_no_verdict(PROFILE)
)
test("electronic submission flag given as the number 1 still gives a definite verdict") <- (
    open_tenders_profile(False, 1, False, PROFILE), gives_no_verdict(PROFILE)
)
test("electronic submission flag given as an atom still gives a definite verdict") <- (
    open_tenders_profile(False, yes, False, PROFILE), gives_no_verdict(PROFILE)
)
test("electronic submission flag given as a list still gives a definite verdict") <- (
    open_tenders_profile(False, [True], False, PROFILE), gives_no_verdict(PROFILE)
)
test("electronic submission flag given as a character list still gives a definite verdict") <- (
    open_tenders_profile(False, "True", False, PROFILE), gives_no_verdict(PROFILE)
)
test("urgency flag given as the number 1 still gives a definite verdict") <- (
    open_tenders_profile(False, False, 1, PROFILE), gives_no_verdict(PROFILE)
)
test("urgency flag given as an atom still gives a definite verdict") <- (
    open_tenders_profile(False, False, yes, PROFILE), gives_no_verdict(PROFILE)
)
test("urgency flag given as a list still gives a definite verdict") <- (
    open_tenders_profile(False, False, [True], PROFILE), gives_no_verdict(PROFILE)
)
test("urgency flag given as a character list still gives a definite verdict") <- (
    open_tenders_profile(False, False, "True", PROFILE), gives_no_verdict(PROFILE)
)

# An UNBOUND flag is worse than a malformed one: profile_get(PROFILE, KEY, True)
# (time_limits.seam lines 343, 347, 351) binds the variable to True, so the
# reduction is applied as though the condition had been established.
test("unbound prior information notice flag gives no verdict instead of applying the 15-day reduction") <- (
    open_tenders_profile(_, False, False, PROFILE), gives_no_verdict(PROFILE)
)
test("unbound electronic submission flag gives no verdict instead of applying the 30-day reduction") <- (
    open_tenders_profile(False, _, False, PROFILE), gives_no_verdict(PROFILE)
)
test("unbound urgency flag gives no verdict instead of applying the 15-day reduction") <- (
    open_tenders_profile(False, False, _, PROFILE), gives_no_verdict(PROFILE)
)

# ---- observed_time_limit_days: not a non-negative number ---------------
# check_gte/5 (kit formalize_lib) matches only number(VALUE), so a non-number
# matches no clause and route 1 fails closed (time_limits.seam lines 381-386).
test("observed day count spelled as a character list gives no verdict") <- (
    open_tenders_profile_observing("40", PROFILE), gives_no_verdict(PROFILE)
)
test("observed day count given as an atom gives no verdict") <- (
    open_tenders_profile_observing(forty, PROFILE), gives_no_verdict(PROFILE)
)
test("observed day count given as a list gives no verdict") <- (
    open_tenders_profile_observing([40], PROFILE), gives_no_verdict(PROFILE)
)
test("observed day count given as a boolean gives no verdict") <- (
    open_tenders_profile_observing(True, PROFILE), gives_no_verdict(PROFILE)
)
test("unbound observed day count gives no verdict") <- (
    open_tenders_profile_observing(_, PROFILE), gives_no_verdict(PROFILE)
)
# A negative day count is a number but no notice can allow it; the domain
# compares it anyway and reports a breach.
test("negative observed day count is reported as a breach instead of refused") <- (
    open_tenders_profile_observing(-5, PROFILE), gives_no_verdict(PROFILE)
)

# ---- the profile itself is not a dict ---------------------------------
# The engine raises type_error(dict, _) from the PROFILE[KEY] subscript; no
# verdict is given, which is the property checked here.
test("a profile that is not a dict gives no definite verdict") <- (
    decision_outcome(not_a_procedure, OUTCOME),
    not (OUTCOME is answers([_, *_]))
)

# =====================================================================
# 3. THE EMPTY PROFILE: no verdict, no exception -- through the decision
#    predicate and through the resolvable facade, which should simply fail.
# =====================================================================
test("empty profile raises an unguarded dict key existence error instead of giving no verdict") <- (
    gives_no_verdict({})
)

test("empty profile makes the resolvable facade raise instead of failing") <- (
    catch(
        (findall(PROFILE, (PROFILE is {}, time_limits_decision_resolvable(PROFILE)), RESOLVED),
         OUTCOME is answers(RESOLVED)),
        ERROR,
        OUTCOME is raised(ERROR)),
    OUTCOME is answers([])
)

# =====================================================================
# 4. EXACTLY ONE ANSWER for every registered fixture profile.
# =====================================================================
test("every fixture profile yields exactly one verdict") <- (
    findall(SUBJECT, time_limits_subject(SUBJECT), SUBJECTS),
    length(SUBJECTS, 24),
    findall(SUBJECT,
        (time_limits_subject(SUBJECT),
         time_limits_profile_for(SUBJECT, PROFILE),
         findall(VERDICT, decide_time_limits(PROFILE, VERDICT), VERDICTS),
         not length(VERDICTS, 1)),
        OFFENDERS),
    OFFENDERS is []
)

# =====================================================================
# 5. BOUNDARIES of the inclusive floor (Art 27(1) "shall be 35 days";
#    time_limits.seam lines 373-376): at the figure meets, one day below is
#    short, one day above meets. Checked at each distinct published figure.
# =====================================================================
conformity_at(PROFILE, DAYS, CONFORMITY) <- (
    findall(FOUND,
        decide_time_limits({**PROFILE, observed_time_limit_days: DAYS},
            time_limits_verdict(minimum_days_prescribed, _, FOUND, _)),
        [CONFORMITY])
)

floor_boundaries_hold(PROFILE, MINIMUM) <- (
    BELOW == MINIMUM - 1,
    ABOVE == MINIMUM + 1,
    conformity_at(PROFILE, BELOW, shorter_than_prescribed_minimum),
    conformity_at(PROFILE, MINIMUM, meets_prescribed_minimum),
    conformity_at(PROFILE, ABOVE, meets_prescribed_minimum)
)

test("boundary: open tenders base of 35 days is an inclusive floor") <- (
    time_limits_profile_for("open_tenders_baseline", PROFILE),
    floor_boundaries_hold(PROFILE, 35)
)
test("boundary: open tenders electronic figure of 30 days is an inclusive floor") <- (
    time_limits_profile_for("open_tenders_electronic_submission", PROFILE),
    floor_boundaries_hold(PROFILE, 30)
)
test("boundary: restricted tenders electronic figure of 25 days is an inclusive floor") <- (
    time_limits_profile_for("restricted_tenders_electronic_submission", PROFILE),
    floor_boundaries_hold(PROFILE, 25)
)
test("boundary: open tenders prior information notice figure of 15 days is an inclusive floor") <- (
    time_limits_profile_for("open_tenders_prior_information_notice", PROFILE),
    floor_boundaries_hold(PROFILE, 15)
)
test("boundary: restricted tenders urgency figure of 10 days is an inclusive floor") <- (
    time_limits_profile_for("restricted_tenders_urgency", PROFILE),
    floor_boundaries_hold(PROFILE, 10)
)

# =====================================================================
# 6. THE INPUT CHECK (ruling D80): time_limits_input_problem/2
#    names the first problem, and finds none on any registered fixture.
# =====================================================================
test("input check finds no problem on any registered fixture") <- (
    findall(SUBJECT,
        (time_limits_subject(SUBJECT),
         time_limits_profile_for(SUBJECT, PROFILE),
         time_limits_input_problem(PROFILE, _)),
        OFFENDERS),
    OFFENDERS is []
)
test("input check reports an unbound variable as not_ground") <- (
    open_tenders_profile(_, False, False, PROFILE),
    time_limits_input_problem(PROFILE, not_ground)
)
test("input check reports a profile that is not a dict") <- (
    time_limits_input_problem(not_a_procedure, not_a_dict)
)
test("input check reports a missing procedure type first on the empty profile") <- (
    findall(PROBLEM, time_limits_input_problem({}, PROBLEM), [missing_key(procedure_type_key)])
)
test("input check reports a missing stage") <- (
    time_limits_input_problem({procedure_type_key: open_procedure}, missing_key(stage_key))
)
test("input check reports an unknown procedure type") <- (
    time_limits_input_problem({procedure_type_key: not_a_procedure, stage_key: receipt_of_tenders},
        wrong_value(procedure_type_key, expected_procedure_type))
)
test("input check reports an unknown stage") <- (
    time_limits_input_problem({procedure_type_key: open_procedure, stage_key: 1},
        wrong_value(stage_key, expected_stage))
)
test("input check reports a flag that is not exactly True or False") <- (
    open_tenders_profile(False, 1, False, PROFILE),
    time_limits_input_problem(PROFILE, wrong_type(electronic_submission_accepted, expected_boolean))
)
test("input check reports a boolean day count as not an integer") <- (
    open_tenders_profile_observing(True, PROFILE),
    time_limits_input_problem(PROFILE, wrong_type(observed_time_limit_days, expected_integer))
)
test("input check reports a fractional day count as not an integer") <- (
    open_tenders_profile_observing(34.5, PROFILE),
    time_limits_input_problem(PROFILE, wrong_type(observed_time_limit_days, expected_integer))
)
test("input check reports a negative day count") <- (
    open_tenders_profile_observing(-5, PROFILE),
    time_limits_input_problem(PROFILE, negative_count(observed_time_limit_days))
)
test("input check accepts a zero day count, which is then a breach") <- (
    open_tenders_profile_observing(0, PROFILE),
    not time_limits_input_problem(PROFILE, _),
    decide_time_limits(PROFILE, time_limits_verdict(_, 35, shorter_than_prescribed_minimum, _))
)
test("checklist and what-if give no answer on a refused profile") <- (
    open_tenders_profile(yes, False, False, PROFILE),
    not time_limits_checklist(PROFILE, _),
    not time_limits_what_if(PROFILE, state_of_urgency_substantiated, True, _)
)
test("what-if can still correct the refused key it overrides") <- (
    open_tenders_profile(yes, False, False, PROFILE),
    time_limits_what_if(PROFILE, prior_information_notice_published, True, 15)
)
