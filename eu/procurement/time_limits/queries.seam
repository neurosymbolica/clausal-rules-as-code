# =====================================================================
# queries.clausal -- QUERY-COMBINATOR layer for eu/procurement/time_limits.
#
# time_limits_what_if/4    (#16 what-if): override one key -> new minimum days
# time_limits_enumerate/4  (#4 enumeration): the full published day table
# time_limits_floor/3      (#6 threshold/floor): fully-reduced floor per
#                          (procedure, stage) -- the least published figure
# time_limits_profile_keys/1: top-level profile key schema
# =====================================================================

-module(queries, [
    time_limits_profile_keys(PROFILE_KEYS),
    time_limits_what_if(PROFILE, OVERRIDDEN_KEY, NEW_VALUE, NEW_MINIMUM_DAYS),
    time_limits_enumerate(PROCEDURE_TYPE, STAGE, REDUCTION_CONDITION, DAYS),
    time_limits_floor(PROCEDURE_TYPE, STAGE, FLOOR_DAYS)
])
-double_quotes(chars)

# Imports are LEXICAL CLOSURE ONLY: every name below is spelled in a clause
# body or list literal of this file. time_limits_verdict/3 is NOT imported --
# this file never spells it, and no query template compiled here carries a
# literal verdict term (deletion verified against the full test battery and
# the oracle, per recipe rule 3's "remove it and prove the gates fail").
-import_from(query_combinators, [override_key])
-import_from(eu.procurement.time_limits.time_limits, [
    baseline_minimum,
    procedure_type_key, stage_key,
    prior_information_notice_published,
    electronic_submission_accepted,
    state_of_urgency_substantiated,
    observed_time_limit_days,
    minimum_days,
    minimum_time_limit_days])

-strict_atoms

# schema of top-level profile keys. observed_time_limit_days is the day count
# the notice ACTUALLY allowed -- the only key here that is not a circumstance of
# the procedure but a reading of the record, and the one the CONFORMITY slot of
# the verdict is computed from.
time_limits_profile_keys([
    procedure_type_key, stage_key,
    prior_information_notice_published,
    electronic_submission_accepted,
    state_of_urgency_substantiated,
    observed_time_limit_days]),

# #16 what-if: re-evaluate with one key hypothetically overridden;
# reports the new minimum day count (or n_a).
time_limits_what_if(PROFILE, OVERRIDDEN_KEY, NEW_VALUE, NEW_MINIMUM_DAYS) <- (
    override_key(PROFILE, OVERRIDDEN_KEY, NEW_VALUE, HYPOTHESIS),
    minimum_days(HYPOTHESIS, NEW_MINIMUM_DAYS)
)

# #4 enumeration: every published (procedure, stage, condition, days) row.
time_limits_enumerate(PROCEDURE_TYPE, STAGE, REDUCTION_CONDITION, DAYS) <- (
    minimum_time_limit_days(PROCEDURE_TYPE, STAGE, REDUCTION_CONDITION,
        DAYS, _CITATION)
)

# #6 threshold/floor: the least published figure for a (procedure, stage)
# -- the fully-reduced floor no lawful time limit may undercut.
# The baseline_minimum row (exactly one per meaningful pair) doubles as
# the distinct-pair generator, so the query is fully relational.
time_limits_floor(PROCEDURE_TYPE, STAGE, FLOOR_DAYS) <- (
    minimum_time_limit_days(PROCEDURE_TYPE, STAGE, baseline_minimum, _, _),
    findall(
        DAYS,
        minimum_time_limit_days(PROCEDURE_TYPE, STAGE, _, DAYS, _),
        DAYS_LIST),
    not (DAYS_LIST is []),
    min_list(DAYS_LIST, FLOOR_DAYS)
)
