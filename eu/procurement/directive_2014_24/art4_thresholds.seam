# =====================================================================
# art4_thresholds.clausal -- Art 4 threshold values for EU public procurement.
# Stores raw period facts and exposes query predicates.
# Source: EU Directive 2014/24/EU Art 4 + biennial delegated regulations.
# All monetary amounts in plain integer euro-cents.
# Library module: no verdict, no oracle, no manifest.yaml.
# =====================================================================

-module(art4_thresholds, [
    art4_threshold(CONTRACT_TYPE, CONTRACTING_AUTHORITY_TYPE, AS_OF_DATE, THRESHOLD_EUR_CENTS),
    current_art4_threshold(CONTRACT_TYPE, CONTRACTING_AUTHORITY_TYPE, THRESHOLD_EUR_CENTS)
])
-double_quotes(chars)

-import_from(date_time, [date])
-import_from(kit.deadline_lib, [date_before, date_after, date_on_or_before, date_on_or_after])

-import_from(eu.procurement.directive_2014_24.vocabulary, [
    central_government_authority,
    sub_central_contracting_authority,
    body_governed_by_public_law,
    works,
    supplies,
    services,
    social_and_other_specific_services])

-strict_atoms

-import_from(european_union, [euro, eur_cent])

# The Art 4 threshold table, ONE declaration. Amounts declared in BASE
# currency (_tools/MIGRATION-money-constants.md) so the value and its
# currency are facts the engine holds; art4_threshold_value/5 keeps its
# name, arity and cents value type, DERIVED, so art4_threshold/4 and
# every one of the fourteen consumer domains is untouched.
-constants_number_currency(art4_threshold_amount/5,
    [(works, central_government_authority,
     date(2016, 1, 1), date(2018, 1, 1), 5_225_000),
