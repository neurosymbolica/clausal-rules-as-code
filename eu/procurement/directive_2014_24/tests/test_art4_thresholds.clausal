% (Clausal Prolog: the seam imports of the seven contracting-authority and
% contract-type ATOMS from eu.procurement.directive_2014_24.vocabulary, and of
% date/3 from date_time, have no counterpart: atoms and compound terms need no
% import. Only predicates are imported.)
:- module(test_art4_thresholds, []).
:- use_module(library(clpz)).
:- use_module(eu/procurement/directive_2014_24/art4_thresholds, [
    art4_threshold/4, current_art4_threshold/3]).

% The seam's two `not art4_threshold(...)` checks are written in pure form
% (ruling 2026-10-20): the lookup has no answer, findall(Cents, Goal, []).

test('2024-2025 period: works all CA = EUR 5538000 (553800000 cents)') :-
    art4_threshold(works, central_government_authority,
        date(2024, 6, 1), 553800000),
    art4_threshold(works, sub_central_contracting_authority,
        date(2024, 6, 1), 553800000),
    art4_threshold(works, body_governed_by_public_law,
        date(2024, 6, 1), 553800000).

test('2024-2025 period: central gov supplies = EUR 143000 (14300000 cents)') :-
    art4_threshold(supplies, central_government_authority,
        date(2024, 6, 1), 14300000).

test('2024-2025 period: sub-central supplies = EUR 221000 (22100000 cents)') :-
    art4_threshold(supplies, sub_central_contracting_authority,
        date(2024, 6, 1), 22100000).

test('2024-2025 period: social services = EUR 750000 (75000000 cents)') :-
    art4_threshold(social_and_other_specific_services, central_government_authority,
        date(2024, 6, 1), 75000000),
    art4_threshold(social_and_other_specific_services, sub_central_contracting_authority,
        date(2024, 6, 1), 75000000).

test('2022-2023 period: works all CA = EUR 5382000 (538200000 cents)') :-
    art4_threshold(works, central_government_authority,
        date(2022, 6, 1), 538200000).

test('2022-2023 period: central gov supplies = EUR 140000 (14000000 cents)') :-
    art4_threshold(supplies, central_government_authority,
        date(2022, 6, 1), 14000000).

test('2022-2023 period: sub-central supplies = EUR 215000 (21500000 cents)') :-
    art4_threshold(supplies, sub_central_contracting_authority,
        date(2022, 6, 1), 21500000).

test('2022-2023 period: social services = EUR 750000 (75000000 cents)') :-
    art4_threshold(social_and_other_specific_services, central_government_authority,
        date(2022, 6, 1), 75000000).

test('2026-2027 period (current): works = EUR 5404000 (540400000 cents)') :-
    art4_threshold(works, central_government_authority,
        date(2026, 7, 24), 540400000).

test('2026-2027 period (current): central gov supplies = EUR 140000 (14000000 cents)') :-
    art4_threshold(supplies, central_government_authority,
        date(2026, 7, 24), 14000000).

test('current_art4_threshold resolves works for today') :-
    current_art4_threshold(works, central_government_authority, ThresholdEurCents),
    ThresholdEurCents #= 540400000.

test('current_art4_threshold resolves services for today') :-
    current_art4_threshold(services, central_government_authority, ThresholdEurCents),
    ThresholdEurCents #= 14000000.

% CORRECTED 2026-08-23. This test used to name [2020, 1, 1] as a date "outside
% all known periods" -- a date on which Directive 2014/24/EU was fully in force
% and Reg (EU) 2019/1828's figures applied. So it did not merely miss the
% pre-2022 gap, it ASSERTED the gap was correct and held it in place: a green
% test called "no threshold outside all known periods" is exactly what stops
% anyone looking. The intent was always right; the example date was not.
test('no threshold AFTER the last known period') :-
    findall(Cents, art4_threshold(works, central_government_authority, date(2030, 1, 1), Cents), []).

% =====================================================================
% PRE-2022 PERIODS (added 2026-08-23). Before these facts existed,
% art4_threshold/4 FAILED for any date before 2022-01-01 -- so every
% historical contract was undecidable on the gate the whole directive
% hangs off. Figures read verbatim from the fetched Formex of the
% amending Regulations; see thresholds-sources.yaml.
% =====================================================================

test('2016-2017 period: works all CA = EUR 5225000 (522500000 cents)') :-
    art4_threshold(works, central_government_authority,
        date(2016, 6, 1), 522500000),
    art4_threshold(works, sub_central_contracting_authority,
        date(2016, 6, 1), 522500000),
    art4_threshold(works, body_governed_by_public_law,
        date(2016, 6, 1), 522500000).

test('2016-2017 period: central gov supplies = EUR 135000 (13500000 cents)') :-
    art4_threshold(supplies, central_government_authority,
        date(2016, 6, 1), 13500000),
    art4_threshold(services, central_government_authority,
        date(2016, 6, 1), 13500000).

test('2016-2017 period: sub-central supplies = EUR 209000 (20900000 cents)') :-
    art4_threshold(supplies, sub_central_contracting_authority,
        date(2016, 6, 1), 20900000),
    art4_threshold(supplies, body_governed_by_public_law,
        date(2016, 6, 1), 20900000).

test('2018-2019 period: works all CA = EUR 5548000 (554800000 cents)') :-
    art4_threshold(works, central_government_authority,
        date(2018, 6, 1), 554800000),
    art4_threshold(works, body_governed_by_public_law,
        date(2018, 6, 1), 554800000).

test('2018-2019 period: central gov supplies = EUR 144000 (14400000 cents)') :-
    art4_threshold(supplies, central_government_authority,
        date(2018, 6, 1), 14400000).

test('2018-2019 period: sub-central supplies = EUR 221000 (22100000 cents)') :-
    art4_threshold(supplies, sub_central_contracting_authority,
        date(2018, 6, 1), 22100000).

test('2020-2021 period: works all CA = EUR 5350000 (535000000 cents)') :-
    art4_threshold(works, central_government_authority,
        date(2020, 6, 1), 535000000),
    art4_threshold(works, body_governed_by_public_law,
        date(2020, 6, 1), 535000000).

test('2020-2021 period: central gov supplies = EUR 139000 (13900000 cents)') :-
    art4_threshold(supplies, central_government_authority,
        date(2020, 6, 1), 13900000).

test('2020-2021 period: sub-central supplies = EUR 214000 (21400000 cents)') :-
    art4_threshold(supplies, sub_central_contracting_authority,
        date(2020, 6, 1), 21400000).

test('social services stay EUR 750000 across every pre-2022 period') :-
    art4_threshold(social_and_other_specific_services, central_government_authority,
        date(2016, 6, 1), 75000000),
    art4_threshold(social_and_other_specific_services, central_government_authority,
        date(2018, 6, 1), 75000000),
    art4_threshold(social_and_other_specific_services, sub_central_contracting_authority,
        date(2020, 6, 1), 75000000).

% Boundary tests. The period interval is half-open [START, END), so the last
% instant of one period and the first of the next must not both match, and
% must not disagree.
test('period boundary: 31 Dec 2017 is the old figure, 1 Jan 2018 the new') :-
    art4_threshold(supplies, central_government_authority,
        date(2017, 12, 31), 13500000),
    art4_threshold(supplies, central_government_authority,
        date(2018, 1, 1), 14400000).

test('period boundary: 31 Dec 2021 is the old figure, 1 Jan 2022 the new') :-
    art4_threshold(supplies, central_government_authority,
        date(2021, 12, 31), 13900000),
    art4_threshold(supplies, central_government_authority,
        date(2022, 1, 1), 14000000).

% Before Directive 2014/24/EU's Art 4 amounts took effect there is no figure,
% and that must stay a FAILURE rather than acquiring a default. Whether the
% Directive applied at all before 18 April 2016 is a separate gate, upstream.
test('no threshold before 2016: a 2015 date yields nothing') :-
    findall(Cents, art4_threshold(works, central_government_authority, date(2015, 6, 1), Cents), []).

:- end_module(test_art4_thresholds).
