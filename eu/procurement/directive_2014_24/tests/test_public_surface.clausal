% =====================================================================
% test_public_surface.clausal -- every exported name of both library
% modules, reached the ONLY way a consumer may reach it: by importing
% the module that declares it.
%
% THERE IS DELIBERATELY NO `__init__.clausal` HERE, and this file used
% to test the one that existed. A package `__init__` that re-exported
% both modules let a consumer write
%     -import_from(eu.procurement.directive_2014_24, [...])
% and 48 of 55 consumer files then declared a dependency on Art 4
% figures they never used. It also cannot be exported: an emitted
% `use_module` resolves to a FILE and ISO has no reexport directive, so
% a shim satisfies the path and fails every call. The ISO exporter now
% REFUSES a package target ("unresolvable use_module target"), which is
% what keeps the facade from coming back.
%
% So: two modules, two import paths, each consumer naming the half it
% uses. If you are here because you want one import instead of two,
% that is the thing that was removed on purpose.
% =====================================================================
% (Clausal Prolog: the seam import of the thirteen vocabulary ATOMS and of
% date/3 from date_time has no counterpart: atoms and compound terms need no
% import. Each module's PREDICATES are imported by that module's own path.)
:- module(test_public_surface, []).
:- use_module(eu/procurement/directive_2014_24/vocabulary, [
    contracting_authority_type/1, contract_type/1, procedure_type/1]).
:- use_module(eu/procurement/directive_2014_24/art4_thresholds, [
    art4_threshold/4, current_art4_threshold/3]).

test('vocabulary predicates work via their own module import') :-
    contracting_authority_type(central_government_authority),
    contracting_authority_type(sub_central_contracting_authority),
    contracting_authority_type(body_governed_by_public_law),
    contract_type(works),
    contract_type(supplies),
    contract_type(services),
    contract_type(social_and_other_specific_services),
    procedure_type(open_procedure),
    procedure_type(restricted_procedure),
    procedure_type(competitive_procedure_with_negotiation),
    procedure_type(competitive_dialogue),
    procedure_type(innovation_partnership),
    procedure_type(negotiated_procedure_without_prior_publication).

test('threshold predicate resolves via its own module import') :-
    current_art4_threshold(works, central_government_authority, _ThresholdEurCents).

test('art4_threshold resolves for a specific date via its own module import') :-
    art4_threshold(supplies, sub_central_contracting_authority,
        date(2024, 6, 1), 22100000).

test('the two modules compose: a vocabulary atom keys a threshold row') :-
    contract_type(social_and_other_specific_services),
    contracting_authority_type(sub_central_contracting_authority),
    current_art4_threshold(social_and_other_specific_services,
        sub_central_contracting_authority, _Cents).

:- end_module(test_public_surface).
