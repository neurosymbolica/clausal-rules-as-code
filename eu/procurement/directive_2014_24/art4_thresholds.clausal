% The seam derived the cents as A / eur_cent (dividing the united euro amount
% by the euro-cent minor unit). Clausal Prolog: the euro figure times 100
% cents to the euro.
art4_threshold_value(Kind, Authority, PeriodStart, PeriodEnd, Cents) :-
    art4_threshold_amount(Kind, Authority, PeriodStart, PeriodEnd, Euro),
    Cents #= Euro * 100.

% =====================================================================
% Raw period facts: art4_threshold_value/5
% art4_threshold_value(CONTRACT_TYPE, CONTRACTING_AUTHORITY_TYPE,
%                      PERIOD_START, PERIOD_END, THRESHOLD_EUR_CENTS)
% PERIOD_START inclusive, PERIOD_END exclusive (half-open interval).
% All threshold amounts in euro-cents (EUR × 100).
% =====================================================================

% =====================================================================
% PRE-2022 PERIODS. Added 2026-08-23: the corpus began at 2022-01-01, so every
% contract awarded before then made art4_threshold/4 fail, decide_threshold yield
% no solution, and decide() raise EngineError -- on the GATE every other
% procurement module depends on. Directive 2014/24/EU has applied since its
% 18 April 2016 transposition deadline, so that was ~6 years of its life
% undecidable.
%
% NOTE the separate question these facts do NOT answer: whether the Directive
% applied at all on a given date. Art 4's AMOUNTS took effect 1 Jan 2016 (Reg
% 2015/2170), but procedures launched before 18 April 2016 are governed by
% Directive 2004/18/EC, which is not formalized. That gate belongs upstream, not
% in a table of amounts.
% =====================================================================

% --- 2016-2017: Reg (EU) 2015/2170 (CELEX 32015R2170), from 1 Jan 2016 ---
% Works: all contracting authority types, EUR 5,225,000 = 522,500,000 cents

% Supplies + services, central government, EUR 135000 = 13500000 cents

% Supplies + services, sub-central and bodies governed by public law,
% EUR 209000 = 20900000 cents

% Social + other specific services (Art 74), EUR 750000 = 75000000 cents.
% Art 4(d) is NOT GPA-linked: Reg 2017/2365 Art 1(1) amends points (a), (b) and (c)
% only, so this figure is unchanged across every period.

% --- 2018-2019: Reg (EU) 2017/2365 (CELEX 32017R2365), from 1 Jan 2018 ---
% Works: all contracting authority types, EUR 5,548,000 = 554,800,000 cents

% Supplies + services, central government, EUR 144000 = 14400000 cents

% Supplies + services, sub-central and bodies governed by public law,
% EUR 221000 = 22100000 cents

% Social + other specific services (Art 74), EUR 750000 = 75000000 cents.
% Art 4(d) is NOT GPA-linked: Reg 2017/2365 Art 1(1) amends points (a), (b) and (c)
% only, so this figure is unchanged across every period.

% --- 2020-2021: Reg (EU) 2019/1828 (CELEX 32019R1828), from 1 Jan 2020 ---
% Works: all contracting authority types, EUR 5,350,000 = 535,000,000 cents

% Supplies + services, central government, EUR 139000 = 13900000 cents

% Supplies + services, sub-central and bodies governed by public law,
% EUR 214000 = 21400000 cents

% Social + other specific services (Art 74), EUR 750000 = 75000000 cents.
% Art 4(d) is NOT GPA-linked: Reg 2019/1828 Art 1(1) amends points (a), (b) and (c)
% only, so this figure is unchanged across every period.

% --- 2022-2023: Reg (EU) 2021/1952 (CELEX 32021R1952), from 1 Jan 2022 ---
% Works: all contracting authority types, EUR 5,382,000 = 538,200,000 cents

% Supplies + services, central government, EUR 140,000 = 14,000,000 cents

% Supplies + services, sub-central, EUR 215,000 = 21,500,000 cents

% Social + other specific services (Art 74), EUR 750,000 = 75,000,000 cents

% --- 2024-2025: Reg (EU) 2023/2495 (CELEX 32023R2495), from 1 Jan 2024 ---
% Works: all contracting authority types, EUR 5,538,000 = 553,800,000 cents

% Supplies + services, central government, EUR 143,000 = 14,300,000 cents

% Supplies + services, sub-central, EUR 221,000 = 22,100,000 cents

% Social + other specific services (Art 74), EUR 750,000 = 75,000,000 cents (unchanged)

% --- 2026-2027: Reg (EU) 2025/2152 (CELEX 32025R2152), from 1 Jan 2026 ---
% Works: all contracting authority types, EUR 5,404,000 = 540,400,000 cents

% Supplies + services, central government, EUR 140,000 = 14,000,000 cents

% Supplies + services, sub-central, EUR 216,000 = 21,600,000 cents

% Social + other specific services (Art 74), EUR 750,000 = 75,000,000 cents (unchanged)

% =====================================================================
% Query predicates
% =====================================================================

% art4_threshold/4: look up the threshold applicable on AS_OF_DATE.
% AS_OF_DATE is a date(YEAR, MONTH, DAY). Half-open interval: START <= AS_OF < END.
art4_threshold(ContractType, ContractingAuthorityType, AsOfDate, ThresholdEurCents) :-
    art4_threshold_value(ContractType, ContractingAuthorityType,
        PeriodStart, PeriodEnd, ThresholdEurCents),
    date_on_or_after(AsOfDate, PeriodStart),
    date_before(AsOfDate, PeriodEnd).

% current_art4_threshold/3: threshold as of 2026-07-24 (today per MEMORY.md).
current_art4_threshold(ContractType, ContractingAuthorityType, ThresholdEurCents) :-
    art4_threshold(ContractType, ContractingAuthorityType,
        date(2026, 7, 24), ThresholdEurCents).

:- end_module(art4_thresholds).
