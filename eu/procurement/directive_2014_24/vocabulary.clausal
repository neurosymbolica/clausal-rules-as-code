% =====================================================================
% vocabulary.clausal -- shared bare atoms for EU public procurement.
% Contracting-authority types, contract types, and procedure types
% declared once for reuse across procurement decision domains.
% Source: EU Directive 2014/24/EU Arts 2(1), 4, 26.
% Library module: no verdict, no oracle, no manifest.yaml.
% =====================================================================

% Clausal Prolog: a .clausal module exports PREDICATES only. The seam export
% list also named these thirteen value ATOMS, which need no export (and cannot
% have one); a consumer spells them directly:
%   contracting authority types: central_government_authority,
%     sub_central_contracting_authority, body_governed_by_public_law
%   contract types: works, supplies, services, social_and_other_specific_services
%   procedure types: open_procedure, restricted_procedure,
%     competitive_procedure_with_negotiation, competitive_dialogue,
%     innovation_partnership, negotiated_procedure_without_prior_publication
:- module(vocabulary, [
    contracting_authority_type/1,
    contract_type/1,
    procedure_type/1
]).

% --- contracting authority types (Art 2(1)(1) + Art 2(1)(4)) ---
contracting_authority_type(central_government_authority).
contracting_authority_type(sub_central_contracting_authority).
contracting_authority_type(body_governed_by_public_law).

% --- contract types (Art 4 scope) ---
contract_type(works).
contract_type(supplies).
contract_type(services).
contract_type(social_and_other_specific_services).

% --- procedure types (Art 26) ---
procedure_type(open_procedure).
procedure_type(restricted_procedure).
procedure_type(competitive_procedure_with_negotiation).
procedure_type(competitive_dialogue).
procedure_type(innovation_partnership).
procedure_type(negotiated_procedure_without_prior_publication).

:- end_module(vocabulary).
