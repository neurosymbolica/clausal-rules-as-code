% =====================================================================
% kernel.clausal -- the SHARED FLOOR for eu/procurement/life_cycle_costing (constraint-satisfaction family).
% DAG root of the determination-slices layout. It holds ONLY what more than
% one file needs: the result CONSTRUCTORS, the terminal verdict vocabulary,
% and the profile KEY atoms / closed value sets shared across the slices.
% Atoms + constructors ONLY -- no rules, no facts.
%
% Source: Directive 2014/24/EU (OJ L 94, 28.3.2014) Art 68(1)-(3), Annex XIII.
% =====================================================================
% Clausal Prolog: a .clausal module exports PREDICATES only (Name/Arity), and
% atoms and compound terms need no export and no import, so this module has an
% empty export list. The seam export list, kept here as the vocabulary record:
%
%   % scaffold constructor (retained per additive-vocabulary rule)
%   life_cycle_costing_verdict(Status, Citations),
%
%   % result constructors -- one per determination
%   lcc_method_validity_verdict(Status, DefectIds, Citations),
%   lcc_mandatory_method_verdict(Status, DefectIds, Citations),
%   lcc_computation_verdict(Status, TotalEurCents, ExcludedCategories),
%
%   % terminal verdict vocabulary -- method validity (Art 68(1)(b) + Art 68(2))
%   valid_lcc_method,
%   invalid_lcc_method,
%
%   % terminal verdict vocabulary -- mandatory method (Art 68(3))
%   union_common_method_mandatory_and_applied,
%   union_common_method_mandatory_and_not_applied,
%   no_union_common_method_mandatory,
%
%   % terminal verdict vocabulary -- computation (Art 68(1))
%   lcc_computed,
%   lcc_no_costs_declared,
%   lcc_indeterminate,
%
%   % scaffold atoms (retained per additive-vocabulary rule)
%   satisfied,
%   not_satisfied,
%   overall,
%   as_of_date
:- module(kernel, []).

:- end_module(kernel).
