% =====================================================================
% fixtures.clausal -- representative profiles for eu/procurement/life_cycle_costing.
% A TOP-LAYER consumer: imports the determination slice's PUBLICS it calls
% and the key atoms it spells in profile dicts.
%
% Subjects cover every route with a positive case and a near-miss control:
%   - outer gate (empty list) vs. one flag false (still valid)
%   - basic compliant vs. one flag missing
%   - externality determinable vs. not determinable
%   - established method vs. undue favour
%   - mandatory applied vs. not applied
%   - zero amount vs. negative amount
% =====================================================================
% (Clausal Prolog: the seam imports of the profile-key, cost-category and
% Union-act ATOMS have no counterpart: atoms need no import. Only predicates
% are imported. A seam dict literal is built with dict_pairs/2.)
:- module(fixtures, [
    life_cycle_costing_subject/1,
    life_cycle_costing_profile_for/2,
    life_cycle_costing_assess/2
]).

:- use_module(eu/procurement/life_cycle_costing/life_cycle_costing, [
    decide_lcc_method_validity/2]).

% ---- Subject registry ------------------------------------------------
life_cycle_costing_subject("no_lcc_approach").
life_cycle_costing_subject("no_lcc_approach_flag_false").
life_cycle_costing_subject("basic_compliant").
life_cycle_costing_subject("basic_tenderer_missing").
life_cycle_costing_subject("two_first_alinea_defects").
life_cycle_costing_subject("externality_compliant").
life_cycle_costing_subject("externality_not_determinable").
life_cycle_costing_subject("externality_undue_favour").
life_cycle_costing_subject("externality_established").
life_cycle_costing_subject("mandatory_applied").
life_cycle_costing_subject("mandatory_not_applied").
life_cycle_costing_subject("negative_amount").
life_cycle_costing_subject("zero_amount").

% ---- Profiles --------------------------------------------------------

% Route: outer gate (empty list) -- positive: all flags True, no LCC approach
life_cycle_costing_profile_for("no_lcc_approach", Profile) :-
    dict_pairs(Profile, [
        cost_components-[],
        tenderer_data_indicated_in_procurement_documents-true,
        costing_method_indicated_in_procurement_documents-true,
        externality_method_criteria_objectively_verifiable-true,
        externality_method_criteria_non_discriminatory-true,
        externality_method_established_for_repeated_or_continuous_application-true,
        externality_method_unduly_favours_or_disadvantages_operators-false,
        externality_method_accessible_to_all_interested_parties-true,
        externality_data_obtainable_with_reasonable_effort-true,
        externality_data_obtainable_by_third_country_gpa_operators-true,
        union_common_method_act_key-no_union_common_method,
        union_common_method_applied-false
    ]).

% Route: outer gate -- near-miss: one flag False, still valid (gate voids all)
life_cycle_costing_profile_for("no_lcc_approach_flag_false", Profile) :-
    dict_pairs(Profile, [
        cost_components-[],
        tenderer_data_indicated_in_procurement_documents-false,
        costing_method_indicated_in_procurement_documents-true,
        externality_method_criteria_objectively_verifiable-true,
        externality_method_criteria_non_discriminatory-true,
        externality_method_established_for_repeated_or_continuous_application-true,
        externality_method_unduly_favours_or_disadvantages_operators-false,
        externality_method_accessible_to_all_interested_parties-true,
        externality_data_obtainable_with_reasonable_effort-true,
        externality_data_obtainable_by_third_country_gpa_operators-true,
        union_common_method_act_key-no_union_common_method,
        union_common_method_applied-false
    ]).

% Route: basic compliant (no externality) -- positive
life_cycle_costing_profile_for("basic_compliant", Profile) :-
    dict_pairs(Profile, [
        cost_components-[[acquisition_cost, 10000, 1]],
        tenderer_data_indicated_in_procurement_documents-true,
        costing_method_indicated_in_procurement_documents-true,
        externality_method_criteria_objectively_verifiable-true,
        externality_method_criteria_non_discriminatory-true,
        externality_method_established_for_repeated_or_continuous_application-true,
        externality_method_unduly_favours_or_disadvantages_operators-false,
        externality_method_accessible_to_all_interested_parties-true,
        externality_data_obtainable_with_reasonable_effort-true,
        externality_data_obtainable_by_third_country_gpa_operators-true,
        union_common_method_act_key-no_union_common_method,
        union_common_method_applied-false
    ]).

% Route: basic -- near-miss: tenderer data not indicated
life_cycle_costing_profile_for("basic_tenderer_missing", Profile) :-
    dict_pairs(Profile, [
        cost_components-[[acquisition_cost, 10000, 1]],
        tenderer_data_indicated_in_procurement_documents-false,
        costing_method_indicated_in_procurement_documents-true,
        externality_method_criteria_objectively_verifiable-true,
        externality_method_criteria_non_discriminatory-true,
        externality_method_established_for_repeated_or_continuous_application-true,
        externality_method_unduly_favours_or_disadvantages_operators-false,
        externality_method_accessible_to_all_interested_parties-true,
        externality_data_obtainable_with_reasonable_effort-true,
        externality_data_obtainable_by_third_country_gpa_operators-true,
        union_common_method_act_key-no_union_common_method,
        union_common_method_applied-false
    ]).

% Route: two first-alinea defects -- both tenderer and costing method missing
life_cycle_costing_profile_for("two_first_alinea_defects", Profile) :-
    dict_pairs(Profile, [
        cost_components-[[acquisition_cost, 10000, 1]],
        tenderer_data_indicated_in_procurement_documents-false,
        costing_method_indicated_in_procurement_documents-false,
        externality_method_criteria_objectively_verifiable-true,
        externality_method_criteria_non_discriminatory-true,
        externality_method_established_for_repeated_or_continuous_application-true,
        externality_method_unduly_favours_or_disadvantages_operators-false,
        externality_method_accessible_to_all_interested_parties-true,
        externality_data_obtainable_with_reasonable_effort-true,
        externality_data_obtainable_by_third_country_gpa_operators-true,
        union_common_method_act_key-no_union_common_method,
        union_common_method_applied-false
    ]).

% Route: externality compliant -- positive: determinable=1, all flags True
life_cycle_costing_profile_for("externality_compliant", Profile) :-
    dict_pairs(Profile, [
        cost_components-[[acquisition_cost, 10000, 1], [environmental_externality_cost, 5000, 1]],
        tenderer_data_indicated_in_procurement_documents-true,
        costing_method_indicated_in_procurement_documents-true,
        externality_method_criteria_objectively_verifiable-true,
        externality_method_criteria_non_discriminatory-true,
        externality_method_established_for_repeated_or_continuous_application-true,
        externality_method_unduly_favours_or_disadvantages_operators-false,
        externality_method_accessible_to_all_interested_parties-true,
        externality_data_obtainable_with_reasonable_effort-true,
        externality_data_obtainable_by_third_country_gpa_operators-true,
        union_common_method_act_key-no_union_common_method,
        union_common_method_applied-false
    ]).

% Route: externality -- near-miss: determinable=0 (excluded from sum, defect fires)
life_cycle_costing_profile_for("externality_not_determinable", Profile) :-
    dict_pairs(Profile, [
        cost_components-[[acquisition_cost, 10000, 1], [environmental_externality_cost, 5000, 0]],
        tenderer_data_indicated_in_procurement_documents-true,
        costing_method_indicated_in_procurement_documents-true,
        externality_method_criteria_objectively_verifiable-true,
        externality_method_criteria_non_discriminatory-true,
        externality_method_established_for_repeated_or_continuous_application-true,
        externality_method_unduly_favours_or_disadvantages_operators-false,
        externality_method_accessible_to_all_interested_parties-true,
        externality_data_obtainable_with_reasonable_effort-true,
        externality_data_obtainable_by_third_country_gpa_operators-true,
        union_common_method_act_key-no_union_common_method,
        union_common_method_applied-false
    ]).

% Route: undue favour -- near-miss: not established + undue=True (defect fires)
life_cycle_costing_profile_for("externality_undue_favour", Profile) :-
    dict_pairs(Profile, [
        cost_components-[[environmental_externality_cost, 5000, 1]],
        tenderer_data_indicated_in_procurement_documents-true,
        costing_method_indicated_in_procurement_documents-true,
        externality_method_criteria_objectively_verifiable-true,
        externality_method_criteria_non_discriminatory-true,
        externality_method_established_for_repeated_or_continuous_application-false,
        externality_method_unduly_favours_or_disadvantages_operators-true,
        externality_method_accessible_to_all_interested_parties-true,
        externality_data_obtainable_with_reasonable_effort-true,
        externality_data_obtainable_by_third_country_gpa_operators-true,
        union_common_method_act_key-no_union_common_method,
        union_common_method_applied-false
    ]).

% Route: undue favour -- positive: established=True (limb satisfied even if undue=True)
life_cycle_costing_profile_for("externality_established", Profile) :-
    dict_pairs(Profile, [
        cost_components-[[environmental_externality_cost, 5000, 1]],
        tenderer_data_indicated_in_procurement_documents-true,
        costing_method_indicated_in_procurement_documents-true,
        externality_method_criteria_objectively_verifiable-true,
        externality_method_criteria_non_discriminatory-true,
        externality_method_established_for_repeated_or_continuous_application-true,
        externality_method_unduly_favours_or_disadvantages_operators-true,
        externality_method_accessible_to_all_interested_parties-true,
        externality_data_obtainable_with_reasonable_effort-true,
        externality_data_obtainable_by_third_country_gpa_operators-true,
        union_common_method_act_key-no_union_common_method,
        union_common_method_applied-false
    ]).

% Route: mandatory method -- positive: directive applied
life_cycle_costing_profile_for("mandatory_applied", Profile) :-
    dict_pairs(Profile, [
        cost_components-[[acquisition_cost, 10000, 1]],
        tenderer_data_indicated_in_procurement_documents-true,
        costing_method_indicated_in_procurement_documents-true,
        externality_method_criteria_objectively_verifiable-true,
        externality_method_criteria_non_discriminatory-true,
        externality_method_established_for_repeated_or_continuous_application-true,
        externality_method_unduly_favours_or_disadvantages_operators-false,
        externality_method_accessible_to_all_interested_parties-true,
        externality_data_obtainable_with_reasonable_effort-true,
        externality_data_obtainable_by_third_country_gpa_operators-true,
        union_common_method_act_key-directive_2009_33_ec,
        union_common_method_applied-true
    ]).

% Route: mandatory method -- near-miss: directive not applied
life_cycle_costing_profile_for("mandatory_not_applied", Profile) :-
    dict_pairs(Profile, [
        cost_components-[[acquisition_cost, 10000, 1]],
        tenderer_data_indicated_in_procurement_documents-true,
        costing_method_indicated_in_procurement_documents-true,
        externality_method_criteria_objectively_verifiable-true,
        externality_method_criteria_non_discriminatory-true,
        externality_method_established_for_repeated_or_continuous_application-true,
        externality_method_unduly_favours_or_disadvantages_operators-false,
        externality_method_accessible_to_all_interested_parties-true,
        externality_data_obtainable_with_reasonable_effort-true,
        externality_data_obtainable_by_third_country_gpa_operators-true,
        union_common_method_act_key-directive_2009_33_ec,
        union_common_method_applied-false
    ]).

% Route: computation -- near-miss: negative amount (indeterminate)
life_cycle_costing_profile_for("negative_amount", Profile) :-
    dict_pairs(Profile, [
        cost_components-[[acquisition_cost, -100, 1]],
        tenderer_data_indicated_in_procurement_documents-true,
        costing_method_indicated_in_procurement_documents-true,
        externality_method_criteria_objectively_verifiable-true,
        externality_method_criteria_non_discriminatory-true,
        externality_method_established_for_repeated_or_continuous_application-true,
        externality_method_unduly_favours_or_disadvantages_operators-false,
        externality_method_accessible_to_all_interested_parties-true,
        externality_data_obtainable_with_reasonable_effort-true,
        externality_data_obtainable_by_third_country_gpa_operators-true,
        union_common_method_act_key-no_union_common_method,
        union_common_method_applied-false
    ]).

% Route: computation -- positive: zero amount (computed, total=0)
life_cycle_costing_profile_for("zero_amount", Profile) :-
    dict_pairs(Profile, [
        cost_components-[[acquisition_cost, 0, 1]],
        tenderer_data_indicated_in_procurement_documents-true,
        costing_method_indicated_in_procurement_documents-true,
        externality_method_criteria_objectively_verifiable-true,
        externality_method_criteria_non_discriminatory-true,
        externality_method_established_for_repeated_or_continuous_application-true,
        externality_method_unduly_favours_or_disadvantages_operators-false,
        externality_method_accessible_to_all_interested_parties-true,
        externality_data_obtainable_with_reasonable_effort-true,
        externality_data_obtainable_by_third_country_gpa_operators-true,
        union_common_method_act_key-no_union_common_method,
        union_common_method_applied-false
    ]).

% ---- Convenience wrapper ---------------------------------------------
life_cycle_costing_assess(Subject, Result) :-
    life_cycle_costing_profile_for(Subject, Profile),
    decide_lcc_method_validity(Profile, Result).

:- end_module(fixtures).
