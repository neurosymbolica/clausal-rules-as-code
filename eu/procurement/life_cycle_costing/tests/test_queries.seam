-double_quotes(chars)
# =====================================================================
# test_queries.clausal -- PROPERTY tests for the query layer.
# One test per query-taxonomy predicate registered in manifest.yaml.
# Run: python -m clausal.testing eu/procurement/life_cycle_costing/tests/test_queries.clausal
# =====================================================================
-import_from(eu.procurement.life_cycle_costing.queries, [
    life_cycle_costing_profile_keys,
    life_cycle_costing_what_if,
    life_cycle_costing_eligibility,
    life_cycle_costing_status,
    life_cycle_costing_defect_enumeration,
    life_cycle_costing_checklist,
    life_cycle_costing_calculation
])

-import_from(eu.procurement.life_cycle_costing.life_cycle_costing, [
    cost_components,
    tenderer_data_indicated_in_procurement_documents,
    costing_method_indicated_in_procurement_documents,
    externality_method_criteria_objectively_verifiable,
    externality_method_criteria_non_discriminatory,
    externality_method_established_for_repeated_or_continuous_application,
    externality_method_unduly_favours_or_disadvantages_operators,
    externality_method_accessible_to_all_interested_parties,
    externality_data_obtainable_with_reasonable_effort,
    externality_data_obtainable_by_third_country_gpa_operators,
    union_common_method_act_key,
    union_common_method_applied,
    acquisition_cost,
    environmental_externality_cost,
    no_union_common_method,
    directive_2009_33_ec,
    tenderer_data_not_indicated,
    externality_cost_monetary_value_not_determinable
])

-import_from(eu.procurement.life_cycle_costing.kernel, [
    lcc_method_validity_verdict,
    lcc_mandatory_method_verdict,
    lcc_computation_verdict,
    valid_lcc_method,
    invalid_lcc_method,
    union_common_method_mandatory_and_applied,
    union_common_method_mandatory_and_not_applied,
    no_union_common_method_mandatory,
    lcc_computed,
    lcc_no_costs_declared,
    lcc_indeterminate,
    satisfied,
    not_satisfied
])

-import_from(eu.procurement.life_cycle_costing.citations, [
    cite,
    eu_dir_2014_24_art_68_2,
    eu_dir_2014_24_art_68_3
])

-import_from(eu.procurement.life_cycle_costing.fixtures, [
    life_cycle_costing_profile_for
])

-import_from(formalize_lib, [item])

# #4 enumeration: profile_keys returns exactly 12 keys
test("query: profile_keys returns 12 keys") <- (
    life_cycle_costing_profile_keys(PROFILE_KEYS),
    length(PROFILE_KEYS, 12)
)

# #2 eligibility: compliant profile yields valid_lcc_method
test("query: eligibility returns valid for compliant profile") <- (
    life_cycle_costing_profile_for("basic_compliant", PROFILE),
    life_cycle_costing_eligibility(PROFILE, lcc_method_validity_verdict(valid_lcc_method, [], []))
)

# #2 eligibility: non-compliant profile yields invalid_lcc_method
test("query: eligibility returns invalid for non-compliant profile") <- (
    life_cycle_costing_profile_for("basic_tenderer_missing", PROFILE),
    life_cycle_costing_eligibility(PROFILE, lcc_method_validity_verdict(invalid_lcc_method, [tenderer_data_not_indicated], [cite(eu_dir_2014_24_art_68_2)]))
)

# #3 status_determination: no union act
test("query: status returns no_union_common_method_mandatory") <- (
    life_cycle_costing_profile_for("basic_compliant", PROFILE),
    life_cycle_costing_status(PROFILE, no_union_common_method_mandatory)
)

# #3 status_determination: directive applied
test("query: status returns mandatory_and_applied for directive") <- (
    life_cycle_costing_profile_for("mandatory_applied", PROFILE),
    life_cycle_costing_status(PROFILE, union_common_method_mandatory_and_applied)
)

# #4 enumeration: defect list for non-compliant profile
test("query: defect_enumeration returns the defect for tenderer missing") <- (
    life_cycle_costing_profile_for("basic_tenderer_missing", PROFILE),
    life_cycle_costing_defect_enumeration(PROFILE, [tenderer_data_not_indicated])
)

# #4 enumeration: empty defect list for compliant profile
test("query: defect_enumeration returns empty list for compliant profile") <- (
    life_cycle_costing_profile_for("basic_compliant", PROFILE),
    life_cycle_costing_defect_enumeration(PROFILE, [])
)

# #7 justification: checklist has 9 items for any profile with components
test("query: checklist returns 9 items for basic_compliant") <- (
    life_cycle_costing_profile_for("basic_compliant", PROFILE),
    life_cycle_costing_checklist(PROFILE, CHECKLIST),
    length(CHECKLIST, 9)
)

# #7 justification: each checklist item carries a cite(...) term
test("query: checklist items carry cite terms") <- (
    life_cycle_costing_profile_for("basic_compliant", PROFILE),
    life_cycle_costing_checklist(PROFILE, CHECKLIST),
    item(tenderer_data_not_indicated, satisfied, cite(eu_dir_2014_24_art_68_2)) in CHECKLIST
)

# #23 calculation: total for basic_compliant is 10000
test("query: calculation returns 10000 for basic_compliant") <- (
    life_cycle_costing_profile_for("basic_compliant", PROFILE),
    life_cycle_costing_calculation(PROFILE, 10000)
)

# #23 calculation: total for externality_compliant is 15000
test("query: calculation returns 15000 for externality_compliant") <- (
    life_cycle_costing_profile_for("externality_compliant", PROFILE),
    life_cycle_costing_calculation(PROFILE, 15000)
)

# what-if: flipping tenderer_data to False changes verdict to invalid
test("query: what_if flipping tenderer_data yields invalid") <- (
    life_cycle_costing_profile_for("basic_compliant", PROFILE),
    life_cycle_costing_what_if(PROFILE, tenderer_data_indicated_in_procurement_documents, False, lcc_method_validity_verdict(invalid_lcc_method, [tenderer_data_not_indicated], [cite(eu_dir_2014_24_art_68_2)]))
)

# what-if: flipping a key that is already True to True keeps valid
test("query: what_if keeping tenderer_data True stays valid") <- (
    life_cycle_costing_profile_for("basic_compliant", PROFILE),
    life_cycle_costing_what_if(PROFILE, tenderer_data_indicated_in_procurement_documents, True, lcc_method_validity_verdict(valid_lcc_method, [], []))
)
