-double_quotes(chars)
# =====================================================================
# test_output_mode.clausal -- OUTPUT MODE tests: result argument UNBOUND,
# verify exactly one solution and the correct value.
# Run: python -m clausal.testing eu/procurement/life_cycle_costing/tests/test_output_mode.clausal
# =====================================================================
-import_from(eu.procurement.life_cycle_costing.life_cycle_costing, [
    decide_lcc_method_validity,
    decide_lcc_mandatory_method,
    decide_lcc_computation,
    lcc_total,
    lcc_externality_assessment,
    lcc_method_validity_limb_status,
    lcc_component_admissibility,
    lcc_mandatory_method_status,
    lcc_union_act_listing,
    acquisition_cost,
    environmental_externality_cost,
    no_union_common_method,
    directive_2009_33_ec,
    tenderer_data_not_indicated,
    costing_method_not_indicated,
    externality_cost_monetary_value_not_determinable,
    component_included,
    externality_costs_assessed,
    externality_costs_not_assessed,
    mandatory_union_common_method_not_applied,
    no_union_act
])

-import_from(eu.procurement.life_cycle_costing.kernel, [
    lcc_method_validity_verdict,
    lcc_mandatory_method_verdict,
    lcc_computation_verdict,
    valid_lcc_method,
    invalid_lcc_method,
    union_common_method_mandatory_and_applied,
    union_common_method_mandatory_and_not_applied,
    no_union_common_method_mandatory,
    lcc_computed,
    lcc_no_costs_declared,
    lcc_indeterminate,
    satisfied,
    not_satisfied
])

-import_from(eu.procurement.life_cycle_costing.citations, [
    cite,
    eu_dir_2014_24_art_68_2,
    eu_dir_2014_24_art_68_3
])

-import_from(eu.procurement.life_cycle_costing.fixtures, [
    life_cycle_costing_profile_for
])

test("output mode: compliant profile yields valid_lcc_method") <- (
    life_cycle_costing_profile_for("basic_compliant", PROFILE),
    findall(VERDICT, decide_lcc_method_validity(PROFILE, VERDICT), VERDICT_LIST),
    VERDICT_LIST is [lcc_method_validity_verdict(valid_lcc_method, [], [])]
)

test("output mode: non-compliant profile yields invalid_lcc_method with defect") <- (
    life_cycle_costing_profile_for("basic_tenderer_missing", PROFILE),
    findall(VERDICT, decide_lcc_method_validity(PROFILE, VERDICT), VERDICT_LIST),
    VERDICT_LIST is [lcc_method_validity_verdict(invalid_lcc_method, [tenderer_data_not_indicated], [cite(eu_dir_2014_24_art_68_2)])]
)

test("output mode: two first-alinea defects in pinned statutory order") <- (
    life_cycle_costing_profile_for("two_first_alinea_defects", PROFILE),
    findall(VERDICT, decide_lcc_method_validity(PROFILE, VERDICT), VERDICT_LIST),
    VERDICT_LIST is [lcc_method_validity_verdict(invalid_lcc_method, [tenderer_data_not_indicated, costing_method_not_indicated], [cite(eu_dir_2014_24_art_68_2), cite(eu_dir_2014_24_art_68_2)])]
)

test("output mode: no union act yields no_union_common_method_mandatory") <- (
    life_cycle_costing_profile_for("basic_compliant", PROFILE),
    findall(VERDICT, decide_lcc_mandatory_method(PROFILE, VERDICT), VERDICT_LIST),
    VERDICT_LIST is [lcc_mandatory_method_verdict(no_union_common_method_mandatory, [], [])]
)

test("output mode: directive applied yields mandatory_and_applied") <- (
    life_cycle_costing_profile_for("mandatory_applied", PROFILE),
    findall(VERDICT, decide_lcc_mandatory_method(PROFILE, VERDICT), VERDICT_LIST),
    VERDICT_LIST is [lcc_mandatory_method_verdict(union_common_method_mandatory_and_applied, [], [])]
)

test("output mode: directive not applied yields mandatory_and_not_applied with defect") <- (
    life_cycle_costing_profile_for("mandatory_not_applied", PROFILE),
    findall(VERDICT, decide_lcc_mandatory_method(PROFILE, VERDICT), VERDICT_LIST),
    VERDICT_LIST is [lcc_mandatory_method_verdict(union_common_method_mandatory_and_not_applied, [mandatory_union_common_method_not_applied], [cite(eu_dir_2014_24_art_68_3)])]
)

test("output mode: empty components yields lcc_no_costs_declared") <- (
    life_cycle_costing_profile_for("no_lcc_approach", PROFILE),
    findall(VERDICT, decide_lcc_computation(PROFILE, VERDICT), VERDICT_LIST),
    VERDICT_LIST is [lcc_computation_verdict(lcc_no_costs_declared, 0, [])]
)

test("output mode: positive amount yields lcc_computed with correct total") <- (
    life_cycle_costing_profile_for("basic_compliant", PROFILE),
    findall(VERDICT, decide_lcc_computation(PROFILE, VERDICT), VERDICT_LIST),
    VERDICT_LIST is [lcc_computation_verdict(lcc_computed, 10000, [])]
)

test("output mode: negative amount yields lcc_indeterminate") <- (
    life_cycle_costing_profile_for("negative_amount", PROFILE),
    findall(VERDICT, decide_lcc_computation(PROFILE, VERDICT), VERDICT_LIST),
    VERDICT_LIST is [lcc_computation_verdict(lcc_indeterminate, 0, [])]
)

test("output mode: lcc_total yields one solution for valid list") <- (
    findall(TOTAL, lcc_total([[acquisition_cost, 10000, 1]], TOTAL), TOTAL_LIST),
    TOTAL_LIST is [10000]
)

test("output mode: lcc_total yields zero solutions for negative amount") <- (
    findall(TOTAL, lcc_total([[acquisition_cost, -100, 1]], TOTAL), TOTAL_LIST),
    TOTAL_LIST is []
)

test("output mode: externality_assessment yields one solution for empty list") <- (
    findall(ASSESSMENT, lcc_externality_assessment([], ASSESSMENT), ASSESSMENT_LIST),
    ASSESSMENT_LIST is [externality_costs_not_assessed]
)

test("output mode: externality_assessment yields one solution for externality present") <- (
    findall(ASSESSMENT, lcc_externality_assessment([[environmental_externality_cost, 5000, 1]], ASSESSMENT), ASSESSMENT_LIST),
    ASSESSMENT_LIST is [externality_costs_assessed]
)

test("output mode: limb_status yields satisfied with citation for compliant limb") <- (
    life_cycle_costing_profile_for("basic_compliant", PROFILE),
    findall(RESULT, lcc_method_validity_limb_status(tenderer_data_not_indicated, PROFILE, STATUS, CITATION), RESULT_LIST),
    length(RESULT_LIST, 1)
)

test("output mode: component_admissibility yields one solution") <- (
    findall(STATUS, lcc_component_admissibility(acquisition_cost, 1, STATUS), STATUS_LIST),
    STATUS_LIST is [component_included]
)

test("output mode: mandatory_method_status yields one solution") <- (
    findall(STATUS, lcc_mandatory_method_status(no_union_common_method, 0, STATUS), STATUS_LIST),
    STATUS_LIST is [no_union_common_method_mandatory]
)

test("output mode: union_act_listing yields one solution for no_union") <- (
    findall(LISTING, lcc_union_act_listing(no_union_common_method, LISTING), LISTING_LIST),
    LISTING_LIST is [no_union_act]
)
