-double_quotes(chars)
# =====================================================================
# test_robustness.seam -- ROBUSTNESS of the three decision predicates of
# eu/procurement/life_cycle_costing against missing inputs, wrongly typed
# inputs, the empty profile, and more than one answer.
#
# What counts as a pass. None of the three decision predicates has a guard
# (no clause throws), and only decide_lcc_computation/2 has an indeterminate
# value of its own (lcc_indeterminate). So for an input the decision cannot
# lawfully decide on, the only acceptable outcomes are:
#   - NO SOLUTION (the decision refuses: it fails closed), or
#   - for the computation, lcc_computation_verdict(lcc_indeterminate, _, _).
# A definite verdict (valid / invalid, applied / not applied / none mandatory,
# computed / no costs declared) is a FAILS-OPEN defect. Any exception is
# recorded as raised(ERROR); since the domain has no guard, every exception is
# incidental and is a CRASH defect.
#
# Base profiles are fixtures whose answers the existing suites pin:
#   externality_compliant  -- valid_lcc_method, every Art 68(2) limb is read
#                             (an environmental externality cost is declared,
#                             so the inner gate is open)
#   mandatory_applied      -- union_common_method_mandatory_and_applied
#                             (test_negative_controls NC5, test_output_mode)
#   basic_compliant        -- lcc_computed with total 10000 (test_output_mode)
# Every group starts with a known-green control on its base profile.
#
# Key contract: profile_keys.yaml key_contract (flags are native booleans;
# the third element of a cost component is an integer 1/0; money is integer
# euro-cents).
# Run: python -m clausal.testing eu/procurement/life_cycle_costing/tests/test_robustness.seam
# =====================================================================
-import_from(eu.procurement.life_cycle_costing.life_cycle_costing, [
    decide_lcc_method_validity,
    decide_lcc_mandatory_method,
    decide_lcc_computation,
    cost_components,
    tenderer_data_indicated_in_procurement_documents,
    costing_method_indicated_in_procurement_documents,
    externality_method_criteria_objectively_verifiable,
    externality_method_criteria_non_discriminatory,
    externality_method_established_for_repeated_or_continuous_application,
    externality_method_unduly_favours_or_disadvantages_operators,
    externality_method_accessible_to_all_interested_parties,
    externality_data_obtainable_with_reasonable_effort,
    externality_data_obtainable_by_third_country_gpa_operators,
    union_common_method_act_key,
    union_common_method_applied,
    acquisition_cost,
    environmental_externality_cost,
    directive_2009_33_ec,
    other_union_act,
    no_union_common_method,
    life_cycle_costing_input_problem,
    method_validity,
    mandatory_method,
    computation,
    not_ground,
    missing_key,
    wrong_type,
    not_a_list,
    malformed_cost_component,
    unknown_cost_category,
    negative_amount,
    cost_component,
    wrong_value,
    incoherent_input,
    profile,
    expected_dict,
    expected_boolean,
    expected_integer_euro_cents,
    expected_zero_or_one,
    expected_union_act_atom,
    union_common_method_applied_without_union_act,
    lcc_total,
    lcc_externality_assessment,
    lcc_method_validity_limb_status,
    tenderer_data_not_indicated
])

-import_from(eu.procurement.life_cycle_costing.queries, [
    life_cycle_costing_calculation
])

-import_from(eu.procurement.life_cycle_costing.kernel, [
    lcc_method_validity_verdict,
    lcc_mandatory_method_verdict,
    lcc_computation_verdict,
    valid_lcc_method,
    union_common_method_mandatory_and_applied,
    no_union_common_method_mandatory,
    lcc_computed,
    lcc_indeterminate
])

-import_from(eu.procurement.life_cycle_costing.fixtures, [
    life_cycle_costing_subject,
    life_cycle_costing_profile_for
])

# Outcome constructors, and wrong-value atoms used only as bad inputs
# (declared so strict atoms accepts them).
-private([
    yes,
    no_cost_components_given,
    ten_thousand,
    fuel_cost_not_in_vocabulary,
    regulation_not_in_vocabulary,
    answers(VERDICTS),
    raised(ERROR)
])

# ---- Outcome helpers ---------------------------------------------------
# Each collects EVERY answer of one decision predicate, or the exception it
# raised, so a test can say exactly which kind of outcome it requires.
method_validity_outcome(PROFILE, OUTCOME) <- (
    catch((findall(VERDICT, decide_lcc_method_validity(PROFILE, VERDICT), VERDICTS), OUTCOME is answers(VERDICTS)),
          CAUGHT,
          OUTCOME is raised(CAUGHT))
)

mandatory_method_outcome(PROFILE, OUTCOME) <- (
    catch((findall(VERDICT, decide_lcc_mandatory_method(PROFILE, VERDICT), VERDICTS), OUTCOME is answers(VERDICTS)),
          CAUGHT,
          OUTCOME is raised(CAUGHT))
)

computation_outcome(PROFILE, OUTCOME) <- (
    catch((findall(VERDICT, decide_lcc_computation(PROFILE, VERDICT), VERDICTS), OUTCOME is answers(VERDICTS)),
          CAUGHT,
          OUTCOME is raised(CAUGHT))
)

# The computation may also answer with its own indeterminate value.
computation_not_definite(answers([])),
computation_not_definite(answers([lcc_computation_verdict(lcc_indeterminate, _, _)])),

profile_without(SUBJECT, KEY, PROFILE) <- (
    life_cycle_costing_profile_for(SUBJECT, BASE),
    dict_remove(KEY, BASE, PROFILE)
)

profile_with(SUBJECT, KEY, VALUE, PROFILE) <- (
    life_cycle_costing_profile_for(SUBJECT, BASE),
    dict_put(KEY, VALUE, BASE, PROFILE)
)

# Base for the Art 68(2)(a) second-sentence limb: externality_compliant with
# the method NOT established for repeated or continuous application, so the
# negative-polarity undue-favour flag is actually read (with the method
# established the sentence cannot be breached and the flag is never read).
not_established_base(PROFILE) <- (
    profile_with("externality_compliant", externality_method_established_for_repeated_or_continuous_application, False, PROFILE)
)

# ---- Known-green controls ------------------------------------------------
test("control: externality_compliant is valid_lcc_method, exactly one answer") <- (
    life_cycle_costing_profile_for("externality_compliant", PROFILE),
    method_validity_outcome(PROFILE, answers([lcc_method_validity_verdict(valid_lcc_method, [], [])]))
)

test("control: externality_compliant with method not established and no undue favour is valid_lcc_method") <- (
    not_established_base(PROFILE),
    method_validity_outcome(PROFILE, answers([lcc_method_validity_verdict(valid_lcc_method, [], [])]))
)

test("control: mandatory_applied is union_common_method_mandatory_and_applied, exactly one answer") <- (
    life_cycle_costing_profile_for("mandatory_applied", PROFILE),
    mandatory_method_outcome(PROFILE, answers([lcc_mandatory_method_verdict(union_common_method_mandatory_and_applied, [], [])]))
)

test("control: basic_compliant computes 10000 euro-cents, exactly one answer") <- (
    life_cycle_costing_profile_for("basic_compliant", PROFILE),
    computation_outcome(PROFILE, answers([lcc_computation_verdict(lcc_computed, 10000, [])]))
)

# ---- 1. Missing required inputs: method validity --------------------------
# decide_lcc_method_validity/2 reads cost_components and the nine Art 68(2)
# flags. None is optional: profile_keys.yaml lists all twelve keys as required
# ("Twelve keys, no more and no fewer") and states no default. A missing key
# must not yield a definite verdict.
test("missing cost_components: method validity must refuse, not answer valid or invalid") <- (
    profile_without("externality_compliant", cost_components, PROFILE),
    method_validity_outcome(PROFILE, answers([]))
)

test("missing tenderer_data_indicated_in_procurement_documents (Art 68(2) first alinea): method validity must refuse, not answer valid or invalid") <- (
    profile_without("externality_compliant", tenderer_data_indicated_in_procurement_documents, PROFILE),
    method_validity_outcome(PROFILE, answers([]))
)

test("missing costing_method_indicated_in_procurement_documents (Art 68(2) first alinea): method validity must refuse, not answer valid or invalid") <- (
    profile_without("externality_compliant", costing_method_indicated_in_procurement_documents, PROFILE),
    method_validity_outcome(PROFILE, answers([]))
)

test("missing externality_method_criteria_objectively_verifiable (Art 68(2)(a) first sentence): method validity must refuse, not answer valid or invalid") <- (
    profile_without("externality_compliant", externality_method_criteria_objectively_verifiable, PROFILE),
    method_validity_outcome(PROFILE, answers([]))
)

test("missing externality_method_criteria_non_discriminatory (Art 68(2)(a) first sentence): method validity must refuse, not answer valid or invalid") <- (
    profile_without("externality_compliant", externality_method_criteria_non_discriminatory, PROFILE),
    method_validity_outcome(PROFILE, answers([]))
)

test("missing externality_method_established_for_repeated_or_continuous_application (Art 68(2)(a) second sentence): method validity must refuse, not answer valid or invalid") <- (
    profile_without("externality_compliant", externality_method_established_for_repeated_or_continuous_application, PROFILE),
    method_validity_outcome(PROFILE, answers([]))
)

test("missing externality_method_accessible_to_all_interested_parties (Art 68(2)(b)): method validity must refuse, not answer valid or invalid") <- (
    profile_without("externality_compliant", externality_method_accessible_to_all_interested_parties, PROFILE),
    method_validity_outcome(PROFILE, answers([]))
)

test("missing externality_data_obtainable_with_reasonable_effort (Art 68(2)(c)): method validity must refuse, not answer valid or invalid") <- (
    profile_without("externality_compliant", externality_data_obtainable_with_reasonable_effort, PROFILE),
    method_validity_outcome(PROFILE, answers([]))
)

test("missing externality_data_obtainable_by_third_country_gpa_operators (Art 68(2)(c)): method validity must refuse, not answer valid or invalid") <- (
    profile_without("externality_compliant", externality_data_obtainable_by_third_country_gpa_operators, PROFILE),
    method_validity_outcome(PROFILE, answers([]))
)

test("missing externality_method_unduly_favours_or_disadvantages_operators with method not established (Art 68(2)(a) second sentence): method validity must refuse") <- (
    not_established_base(BASE),
    dict_remove(externality_method_unduly_favours_or_disadvantages_operators, BASE, PROFILE),
    method_validity_outcome(PROFILE, answers([]))
)

# ---- 1b. Inputs that are legitimately not read (by design) ---------------
# manifest.yaml scope (A), "TWO APPLICABILITY GATES": an EMPTY cost-component
# list means no life-cycle costing approach is used and Art 68 imposes nothing
# (outer gate, Art 68(2) opening words); with no environmental externality
# component the six externality limbs are vacuous (inner gate, Art 68(2)
# second alinea). profile_keys.yaml externality_method_established_...: an
# established method "cannot breach that sentence however it behaves", so the
# undue-favour flag is not read. These tests pin that the absence is ignored.
test("by design: empty cost_components with every flag missing is valid_lcc_method (Art 68(2) outer gate)") <- (
    PROFILE is {cost_components: []},
    method_validity_outcome(PROFILE, answers([lcc_method_validity_verdict(valid_lcc_method, [], [])]))
)

test("by design: no externality component, externality flags missing, is valid_lcc_method (Art 68(2) second alinea inner gate)") <- (
    PROFILE is {cost_components: [[acquisition_cost, 10000, 1]], tenderer_data_indicated_in_procurement_documents: True, costing_method_indicated_in_procurement_documents: True},
    method_validity_outcome(PROFILE, answers([lcc_method_validity_verdict(valid_lcc_method, [], [])]))
)

test("by design: established method with undue-favour flag missing is valid_lcc_method (Art 68(2)(a) second sentence condition)") <- (
    profile_without("externality_compliant", externality_method_unduly_favours_or_disadvantages_operators, PROFILE),
    method_validity_outcome(PROFILE, answers([lcc_method_validity_verdict(valid_lcc_method, [], [])]))
)

# ---- 2. Wrong types: method validity --------------------------------------
# profile_keys.yaml: every flag is "a native True/False -- never the strings
# "true"/"false", never 1/0". An atom, a string or an integer in a flag's
# place must not yield a definite verdict.

test("wrong type: tenderer_data_indicated_in_procurement_documents as atom yes: method validity must refuse, not answer") <- (
    profile_with("externality_compliant", tenderer_data_indicated_in_procurement_documents, yes, PROFILE),
    method_validity_outcome(PROFILE, answers([]))
)

test("wrong type: tenderer_data_indicated_in_procurement_documents as string true (a char list under double_quotes(chars)): method validity must refuse, not answer") <- (
    profile_with("externality_compliant", tenderer_data_indicated_in_procurement_documents, "true", PROFILE),
    method_validity_outcome(PROFILE, answers([]))
)

test("wrong type: tenderer_data_indicated_in_procurement_documents as integer 1: method validity must refuse, not answer") <- (
    profile_with("externality_compliant", tenderer_data_indicated_in_procurement_documents, 1, PROFILE),
    method_validity_outcome(PROFILE, answers([]))
)

test("wrong type: tenderer_data_indicated_in_procurement_documents as integer 0: method validity must refuse, not answer") <- (
    profile_with("externality_compliant", tenderer_data_indicated_in_procurement_documents, 0, PROFILE),
    method_validity_outcome(PROFILE, answers([]))
)

