-double_quotes(chars)
# =====================================================================
# test_properties.clausal -- structural PROPERTIES over the subject set.
# P1 totality: every registered subject yields exactly one verdict for each decide_*.
# P2 determinism: calling twice yields the same result.
# P3 invariant: empty cost_components always yields valid_lcc_method.
# P4 invariant: multi-defect order is pinned.
# P5 invariant: DEFECT_IDS multi-element order (7 defects in pinned order).
# P6 invariant: lcc_cost_category table order (6 categories in pinned order).
# P7 invariant: DEFECT_IDS multi-element order (3 non-adjacent externality limbs).
# Run: python -m clausal.testing eu/procurement/life_cycle_costing/tests/test_properties.clausal
# =====================================================================
-import_from(eu.procurement.life_cycle_costing.life_cycle_costing, [
    decide_lcc_method_validity,
    decide_lcc_mandatory_method,
    decide_lcc_computation,
    lcc_cost_category,
    cost_components,
    tenderer_data_indicated_in_procurement_documents,
    costing_method_indicated_in_procurement_documents,
    externality_method_criteria_objectively_verifiable,
    externality_method_criteria_non_discriminatory,
    externality_method_established_for_repeated_or_continuous_application,
    externality_method_unduly_favours_or_disadvantages_operators,
    externality_method_accessible_to_all_interested_parties,
    externality_data_obtainable_with_reasonable_effort,
    externality_data_obtainable_by_third_country_gpa_operators,
    union_common_method_act_key,
    union_common_method_applied,
    acquisition_cost,
    use_cost,
    maintenance_cost,
    end_of_life_cost,
    other_cost_borne_by_authority_or_users,
    environmental_externality_cost,
    no_union_common_method,
    tenderer_data_not_indicated,
    costing_method_not_indicated,
    externality_cost_monetary_value_not_determinable,
    externality_method_criteria_not_objectively_verifiable,
    externality_method_not_accessible,
    externality_data_not_obtainable_with_reasonable_effort,
    externality_data_not_obtainable_by_gpa_operators
])

-import_from(eu.procurement.life_cycle_costing.kernel, [
    lcc_method_validity_verdict,
    lcc_mandatory_method_verdict,
    lcc_computation_verdict,
    valid_lcc_method,
    invalid_lcc_method,
    union_common_method_mandatory_and_applied,
    union_common_method_mandatory_and_not_applied,
    no_union_common_method_mandatory,
    lcc_computed,
    lcc_no_costs_declared,
    lcc_indeterminate
])

-import_from(eu.procurement.life_cycle_costing.citations, [
    cite,
    eu_dir_2014_24_art_68_1_b,
    eu_dir_2014_24_art_68_2,
    eu_dir_2014_24_art_68_2_a,
    eu_dir_2014_24_art_68_2_b,
    eu_dir_2014_24_art_68_2_c
])

-import_from(eu.procurement.life_cycle_costing.fixtures, [
    life_cycle_costing_subject,
    life_cycle_costing_profile_for
])

# P1: totality -- every subject yields exactly one method-validity verdict
method_validity_total(SUBJECT) <- (
    life_cycle_costing_subject(SUBJECT),
    life_cycle_costing_profile_for(SUBJECT, PROFILE),
    findall(VERDICT, decide_lcc_method_validity(PROFILE, VERDICT), VERDICT_LIST),
    length(VERDICT_LIST, 1)
)

# P1: totality -- every subject yields exactly one mandatory-method verdict
mandatory_method_total(SUBJECT) <- (
    life_cycle_costing_subject(SUBJECT),
    life_cycle_costing_profile_for(SUBJECT, PROFILE),
    findall(VERDICT, decide_lcc_mandatory_method(PROFILE, VERDICT), VERDICT_LIST),
    length(VERDICT_LIST, 1)
)

# P1: totality -- every subject yields exactly one computation verdict
computation_total(SUBJECT) <- (
    life_cycle_costing_subject(SUBJECT),
    life_cycle_costing_profile_for(SUBJECT, PROFILE),
    findall(VERDICT, decide_lcc_computation(PROFILE, VERDICT), VERDICT_LIST),
    length(VERDICT_LIST, 1)
)

test("P1 totality: every subject yields exactly one method-validity verdict") <- (
    findall(SUBJECT, life_cycle_costing_subject(SUBJECT), SUBJECT_LIST),
    length(SUBJECT_LIST, SUBJECT_COUNT),
    findall(SUBJECT, method_validity_total(SUBJECT), CLASSIFIED_LIST),
    length(CLASSIFIED_LIST, SUBJECT_COUNT)
)

test("P1 totality: every subject yields exactly one mandatory-method verdict") <- (
    findall(SUBJECT, life_cycle_costing_subject(SUBJECT), SUBJECT_LIST),
    length(SUBJECT_LIST, SUBJECT_COUNT),
    findall(SUBJECT, mandatory_method_total(SUBJECT), CLASSIFIED_LIST),
    length(CLASSIFIED_LIST, SUBJECT_COUNT)
)

test("P1 totality: every subject yields exactly one computation verdict") <- (
    findall(SUBJECT, life_cycle_costing_subject(SUBJECT), SUBJECT_LIST),
    length(SUBJECT_LIST, SUBJECT_COUNT),
    findall(SUBJECT, computation_total(SUBJECT), CLASSIFIED_LIST),
    length(CLASSIFIED_LIST, SUBJECT_COUNT)
)

# P2: determinism -- calling decide_lcc_method_validity twice gives same result
determinism_check(SUBJECT) <- (
    life_cycle_costing_subject(SUBJECT),
    life_cycle_costing_profile_for(SUBJECT, PROFILE),
    findall(V1, decide_lcc_method_validity(PROFILE, V1), LIST1),
    findall(V2, decide_lcc_method_validity(PROFILE, V2), LIST2),
    LIST1 is LIST2
)

test("P2 determinism: method-validity verdict is deterministic") <- (
    findall(SUBJECT, life_cycle_costing_subject(SUBJECT), SUBJECT_LIST),
    length(SUBJECT_LIST, SUBJECT_COUNT),
    findall(SUBJECT, determinism_check(SUBJECT), DETERMINISTIC_LIST),
    length(DETERMINISTIC_LIST, SUBJECT_COUNT)
)

# P3: invariant -- empty cost_components always yields valid_lcc_method
empty_list_valid(SUBJECT) <- (
    life_cycle_costing_subject(SUBJECT),
    life_cycle_costing_profile_for(SUBJECT, PROFILE),
    get(PROFILE, cost_components, COST_COMPONENTS),
    COST_COMPONENTS is [],
    decide_lcc_method_validity(PROFILE, lcc_method_validity_verdict(valid_lcc_method, [], []))
)

test("P3 invariant: empty cost_components always yields valid_lcc_method") <- (
    findall(SUBJECT, life_cycle_costing_subject(SUBJECT), SUBJECT_LIST),
    findall(SUBJECT, empty_list_valid(SUBJECT), VALID_LIST),
    length(VALID_LIST, 2)
)

# P4: invariant -- two first-alinea defects reported in pinned order
test("P4 invariant: two first-alinea defects in pinned order") <- (
    PROFILE is {cost_components: [[acquisition_cost, 10000, 1]], tenderer_data_indicated_in_procurement_documents: False, costing_method_indicated_in_procurement_documents: False, externality_method_criteria_objectively_verifiable: True, externality_method_criteria_non_discriminatory: True, externality_method_established_for_repeated_or_continuous_application: True, externality_method_unduly_favours_or_disadvantages_operators: False, externality_method_accessible_to_all_interested_parties: True, externality_data_obtainable_with_reasonable_effort: True, externality_data_obtainable_by_third_country_gpa_operators: True, union_common_method_act_key: no_union_common_method, union_common_method_applied: False},
    decide_lcc_method_validity(PROFILE, lcc_method_validity_verdict(invalid_lcc_method, [tenderer_data_not_indicated, costing_method_not_indicated], [cite(eu_dir_2014_24_art_68_2), cite(eu_dir_2014_24_art_68_2)]))
)

# P5: DEFECT_IDS multi-element order -- 7 defects in pinned statutory order
test("P5 DEFECT_IDS order: seven defects in pinned order") <- (
    PROFILE is {cost_components: [[acquisition_cost, 10000, 1], [environmental_externality_cost, 5000, 0]], tenderer_data_indicated_in_procurement_documents: False, costing_method_indicated_in_procurement_documents: False, externality_method_criteria_objectively_verifiable: False, externality_method_criteria_non_discriminatory: True, externality_method_established_for_repeated_or_continuous_application: True, externality_method_unduly_favours_or_disadvantages_operators: False, externality_method_accessible_to_all_interested_parties: False, externality_data_obtainable_with_reasonable_effort: False, externality_data_obtainable_by_third_country_gpa_operators: False, union_common_method_act_key: no_union_common_method, union_common_method_applied: False},
    decide_lcc_method_validity(PROFILE, lcc_method_validity_verdict(invalid_lcc_method, [externality_cost_monetary_value_not_determinable, tenderer_data_not_indicated, costing_method_not_indicated, externality_method_criteria_not_objectively_verifiable, externality_method_not_accessible, externality_data_not_obtainable_with_reasonable_effort, externality_data_not_obtainable_by_gpa_operators], [cite(eu_dir_2014_24_art_68_1_b), cite(eu_dir_2014_24_art_68_2), cite(eu_dir_2014_24_art_68_2), cite(eu_dir_2014_24_art_68_2_a), cite(eu_dir_2014_24_art_68_2_b), cite(eu_dir_2014_24_art_68_2_c), cite(eu_dir_2014_24_art_68_2_c)]))
)

# P6: lcc_cost_category table in pinned order (6 categories)
test("P6 lcc_cost_category table in pinned order") <- (
    findall(CAT, lcc_cost_category(CAT), CATS),
    CATS is [acquisition_cost, use_cost, maintenance_cost, end_of_life_cost, other_cost_borne_by_authority_or_users, environmental_externality_cost]
)

# P7: DEFECT_IDS multi-element order -- three non-adjacent externality limbs (positions 4, 7, 9)
test("P7 DEFECT_IDS order: three non-adjacent externality limbs in pinned order") <- (
    PROFILE is {cost_components: [[environmental_externality_cost, 5000, 1]], tenderer_data_indicated_in_procurement_documents: True, costing_method_indicated_in_procurement_documents: True, externality_method_criteria_objectively_verifiable: False, externality_method_criteria_non_discriminatory: True, externality_method_established_for_repeated_or_continuous_application: True, externality_method_unduly_favours_or_disadvantages_operators: False, externality_method_accessible_to_all_interested_parties: False, externality_data_obtainable_with_reasonable_effort: True, externality_data_obtainable_by_third_country_gpa_operators: False, union_common_method_act_key: no_union_common_method, union_common_method_applied: False},
    decide_lcc_method_validity(PROFILE, lcc_method_validity_verdict(invalid_lcc_method, [externality_method_criteria_not_objectively_verifiable, externality_method_not_accessible, externality_data_not_obtainable_by_gpa_operators], [cite(eu_dir_2014_24_art_68_2_a), cite(eu_dir_2014_24_art_68_2_b), cite(eu_dir_2014_24_art_68_2_c)]))
)
