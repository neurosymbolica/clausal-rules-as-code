-double_quotes(chars)
# Run: cd <corpus root> && python -m clausal.testing \
#      eu/procurement/life_cycle_costing/tests/test_load.clausal
-import_from(eu.procurement.life_cycle_costing.kernel, [
    life_cycle_costing_verdict,
    lcc_method_validity_verdict,
    lcc_mandatory_method_verdict,
    lcc_computation_verdict,
    valid_lcc_method,
    invalid_lcc_method,
    union_common_method_mandatory_and_applied,
    union_common_method_mandatory_and_not_applied,
    no_union_common_method_mandatory,
    lcc_computed,
    lcc_no_costs_declared,
    lcc_indeterminate,
    satisfied,
    not_satisfied
])

-import_from(eu.procurement.life_cycle_costing.citations, [
    cite,
    citation,
    implements,
    eu_dir_2014_24_art_68_1,
    eu_dir_2014_24_art_68_2,
    eu_dir_2014_24_art_68_3,
    eu_dir_2014_24_annex_xiii
])

test("kernel verdict atoms are pairwise distinct") <- (
    not valid_lcc_method is invalid_lcc_method,
    not union_common_method_mandatory_and_applied is union_common_method_mandatory_and_not_applied,
    not union_common_method_mandatory_and_applied is no_union_common_method_mandatory,
    not union_common_method_mandatory_and_not_applied is no_union_common_method_mandatory,
    not lcc_computed is lcc_no_costs_declared,
    not lcc_computed is lcc_indeterminate,
    not lcc_no_costs_declared is lcc_indeterminate,
    not satisfied is not_satisfied
)

test("lcc_method_validity_verdict builds and destructures") <- (
    VERDICT is lcc_method_validity_verdict(valid_lcc_method, [], []),
    VERDICT is lcc_method_validity_verdict(STATUS, DEFECT_IDS, CITATIONS),
    STATUS is valid_lcc_method,
    DEFECT_IDS is [],
    CITATIONS is []
)

test("lcc_mandatory_method_verdict builds and destructures") <- (
    VERDICT is lcc_mandatory_method_verdict(no_union_common_method_mandatory, [], []),
    VERDICT is lcc_mandatory_method_verdict(STATUS, DEFECT_IDS, CITATIONS),
    STATUS is no_union_common_method_mandatory,
    DEFECT_IDS is [],
    CITATIONS is []
)

test("lcc_computation_verdict builds and destructures") <- (
    VERDICT is lcc_computation_verdict(lcc_computed, 0, []),
    VERDICT is lcc_computation_verdict(STATUS, TOTAL_EUR_CENTS, EXCLUDED_CATEGORIES),
    STATUS is lcc_computed,
    TOTAL_EUR_CENTS is 0,
    EXCLUDED_CATEGORIES is []
)

test("scaffold life_cycle_costing_verdict builds and destructures") <- (
    VERDICT is life_cycle_costing_verdict(satisfied, []),
    VERDICT is life_cycle_costing_verdict(STATUS, CITATIONS),
    STATUS is satisfied,
    CITATIONS is []
)

test("citation record resolves for eu_dir_2014_24_art_68_1") <- (
    citation(eu_dir_2014_24_art_68_1, METADATA),
    implements(eu_dir_2014_24_art_68_1)
)

test("cite term builds and destructures for eu_dir_2014_24_art_68_2") <- (
    C is cite(eu_dir_2014_24_art_68_2),
    C is cite(KEY),
    KEY is eu_dir_2014_24_art_68_2
)

test("implements succeeds for eu_dir_2014_24_annex_xiii") <- (
    implements(eu_dir_2014_24_annex_xiii)
)
