# =====================================================================
# queries.clausal -- QUERY-COMBINATOR layer for eu/procurement/life_cycle_costing.
# A TOP-LAYER consumer: imports the determination slice's PUBLICS and
# the kernel names it spells, and nothing else.
#
# Query types covered:
#   #2 eligibility:         life_cycle_costing_eligibility/2
#   #3 status_determination: life_cycle_costing_status/2
#   #4 enumeration:         life_cycle_costing_defect_enumeration/2
#   #7 justification:       life_cycle_costing_checklist/2
#   #23 calculation:        life_cycle_costing_calculation/2
#   what-if:                life_cycle_costing_what_if/4
# =====================================================================
-module(queries, [
    life_cycle_costing_profile_keys(PROFILE_KEYS),
    life_cycle_costing_what_if(PROFILE, OVERRIDDEN_KEY, NEW_VALUE, NEW_VERDICT),
    life_cycle_costing_eligibility(PROFILE, VERDICT),
    life_cycle_costing_status(PROFILE, STATUS),
    life_cycle_costing_defect_enumeration(PROFILE, DEFECT_IDS),
    life_cycle_costing_checklist(PROFILE, CHECKLIST),
    life_cycle_costing_calculation(PROFILE, TOTAL_EUR_CENTS)
])
-double_quotes(chars)

-import_from(eu.procurement.life_cycle_costing.life_cycle_costing, [
    decide_lcc_method_validity,
    decide_lcc_mandatory_method,
    decide_lcc_computation,
    lcc_method_validity_limb_status,
    lcc_total,
    life_cycle_costing_input_problem,
    computation,
    cost_components,
    tenderer_data_indicated_in_procurement_documents,
    costing_method_indicated_in_procurement_documents,
    externality_method_criteria_objectively_verifiable,
    externality_method_criteria_non_discriminatory,
    externality_method_established_for_repeated_or_continuous_application,
    externality_method_unduly_favours_or_disadvantages_operators,
    externality_method_accessible_to_all_interested_parties,
    externality_data_obtainable_with_reasonable_effort,
    externality_data_obtainable_by_third_country_gpa_operators,
    union_common_method_act_key,
    union_common_method_applied,
    externality_cost_monetary_value_not_determinable,
    tenderer_data_not_indicated,
    costing_method_not_indicated,
    externality_method_criteria_not_objectively_verifiable,
    externality_method_criteria_discriminatory,
    undue_favour_or_disadvantage_of_economic_operators,
    externality_method_not_accessible,
    externality_data_not_obtainable_with_reasonable_effort,
    externality_data_not_obtainable_by_gpa_operators
])

-import_from(eu.procurement.life_cycle_costing.kernel, [
    lcc_method_validity_verdict,
    lcc_mandatory_method_verdict,
    lcc_computation_verdict,
    valid_lcc_method,
    invalid_lcc_method,
    union_common_method_mandatory_and_applied,
    union_common_method_mandatory_and_not_applied,
    no_union_common_method_mandatory,
    lcc_computed,
    lcc_no_costs_declared,
    lcc_indeterminate,
    satisfied,
    not_satisfied
])

-import_from(eu.procurement.life_cycle_costing.citations, [
    cite,
    implements,
    eu_dir_2014_24_art_68_1,
    eu_dir_2014_24_art_68_1_b,
    eu_dir_2014_24_art_68_2,
    eu_dir_2014_24_art_68_2_a,
    eu_dir_2014_24_art_68_2_b,
    eu_dir_2014_24_art_68_2_c,
    eu_dir_2014_24_art_68_3,
    eu_dir_2014_24_annex_xiii
])

-import_from(formalize_lib, [item])

-import_from(kit.query_combinators, [what_if])

# #4 enumeration: the 12 profile keys in fixed order
life_cycle_costing_profile_keys([cost_components, tenderer_data_indicated_in_procurement_documents, costing_method_indicated_in_procurement_documents, externality_method_criteria_objectively_verifiable, externality_method_criteria_non_discriminatory, externality_method_established_for_repeated_or_continuous_application, externality_method_unduly_favours_or_disadvantages_operators, externality_method_accessible_to_all_interested_parties, externality_data_obtainable_with_reasonable_effort, externality_data_obtainable_by_third_country_gpa_operators, union_common_method_act_key, union_common_method_applied]),

# #2 eligibility: method validity verdict (valid_lcc_method / invalid_lcc_method)
life_cycle_costing_eligibility(PROFILE, VERDICT) <- (
    decide_lcc_method_validity(PROFILE, VERDICT)
)

# #3 status_determination: mandatory method classification
life_cycle_costing_status(PROFILE, STATUS) <- (
    decide_lcc_mandatory_method(PROFILE, lcc_mandatory_method_verdict(STATUS, _, _))
)

# #4 enumeration: all qualifying defect IDs for the method validity determination
life_cycle_costing_defect_enumeration(PROFILE, DEFECT_IDS) <- (
    decide_lcc_method_validity(PROFILE, lcc_method_validity_verdict(_, DEFECT_IDS, _))
)

# #7 justification: per-limb checklist with cite(...) provenance for every limb
life_cycle_costing_checklist(PROFILE, CHECKLIST) <- (
    findall(ITEM, (LIMB_ID in [externality_cost_monetary_value_not_determinable, tenderer_data_not_indicated, costing_method_not_indicated, externality_method_criteria_not_objectively_verifiable, externality_method_criteria_discriminatory, undue_favour_or_disadvantage_of_economic_operators, externality_method_not_accessible, externality_data_not_obtainable_with_reasonable_effort, externality_data_not_obtainable_by_gpa_operators], lcc_method_validity_limb_status(LIMB_ID, PROFILE, STATUS, CITATION), ITEM is item(LIMB_ID, STATUS, CITATION)), CHECKLIST)
)

# #23 calculation: the exact integer sum of admissible components
# Refused (no solution) for a profile the domain input check rejects.
life_cycle_costing_calculation(PROFILE, TOTAL_EUR_CENTS) <- (
    not life_cycle_costing_input_problem(computation, PROFILE, _),
    get(PROFILE, cost_components, COST_COMPONENTS),
    lcc_total(COST_COMPONENTS, TOTAL_EUR_CENTS)
)

# what-if: override one profile key and re-decide method validity
life_cycle_costing_what_if(PROFILE, OVERRIDDEN_KEY, NEW_VALUE, NEW_VERDICT) <- (
    what_if(PROFILE, OVERRIDDEN_KEY, NEW_VALUE, decide_lcc_method_validity, NEW_VERDICT)
)
