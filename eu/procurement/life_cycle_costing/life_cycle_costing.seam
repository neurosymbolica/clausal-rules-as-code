-module(life_cycle_costing, [
    decide_lcc_method_validity(PROFILE, VERDICT),
    decide_lcc_mandatory_method(PROFILE, VERDICT),
    decide_lcc_computation(PROFILE, VERDICT),
    lcc_method_validity_limb_status(LIMB_ID, PROFILE, STATUS, CITATION),
    lcc_externality_assessment(COST_COMPONENTS, ASSESSMENT),
    lcc_mandatory_method_status(UNION_ACT_KEY, UNION_COMMON_METHOD_APPLIED, STATUS),
    lcc_union_act_listing(UNION_ACT_KEY, LISTING),
    lcc_total(COST_COMPONENTS, TOTAL_EUR_CENTS),
    lcc_component_admissibility(COST_CATEGORY, MONETARY_VALUE_DETERMINABLE_AND_VERIFIED, STATUS),
    lcc_cost_category(CATEGORY),
    life_cycle_costing_input_problem(DETERMINATION, PROFILE, PROBLEM),
    method_validity,
    mandatory_method,
    computation,
    not_ground,
    missing_key(KEY),
    wrong_type(WHAT, EXPECTED),
    not_a_list(KEY),
    malformed_cost_component(COMPONENT),
    unknown_cost_category(CATEGORY),
    negative_amount(COMPONENT),
    cost_component(COMPONENT),
    wrong_value(KEY, EXPECTED),
    incoherent_input(REASON),
    profile,
    expected_dict,
    expected_boolean,
    expected_integer_euro_cents,
    expected_zero_or_one,
    expected_union_act_atom,
    union_common_method_applied_without_union_act,
    cost_components,
    tenderer_data_indicated_in_procurement_documents,
    costing_method_indicated_in_procurement_documents,
    externality_method_criteria_objectively_verifiable,
    externality_method_criteria_non_discriminatory,
    externality_method_established_for_repeated_or_continuous_application,
    externality_method_unduly_favours_or_disadvantages_operators,
    externality_method_accessible_to_all_interested_parties,
    externality_data_obtainable_with_reasonable_effort,
    externality_data_obtainable_by_third_country_gpa_operators,
    union_common_method_act_key,
    union_common_method_applied,
    acquisition_cost,
    use_cost,
    maintenance_cost,
    end_of_life_cost,
    other_cost_borne_by_authority_or_users,
    environmental_externality_cost,
    directive_2009_33_ec,
    other_union_act,
    no_union_common_method,
    externality_cost_monetary_value_not_determinable,
    tenderer_data_not_indicated,
    costing_method_not_indicated,
    externality_method_criteria_not_objectively_verifiable,
    externality_method_criteria_discriminatory,
    undue_favour_or_disadvantage_of_economic_operators,
    externality_method_not_accessible,
    externality_data_not_obtainable_with_reasonable_effort,
    externality_data_not_obtainable_by_gpa_operators,
    mandatory_union_common_method_not_applied,
    externality_costs_assessed,
    externality_costs_not_assessed,
    component_included,
    component_excluded,
    listed_in_annex_xiii,
    not_listed_in_annex_xiii,
    no_union_act
])
-double_quotes(chars)

-private([
    lcc_union_act_id(ACT_KEY),
    annex_xiii_act(ACT_KEY),
    lcc_defect_order(DEFECT_ID),
    lcc_first_alinea_limb(LIMB_ID),
    lcc_externality_limb(LIMB_ID),
    lcc_simple_boolean_limb(DEFECT_ID, PROFILE_KEY),
    lcc_limb_citation(LIMB_ID, CITATION),
    lcc_limb_gate(LIMB_ID, PROFILE, GATE),
    lcc_limb_defect(LIMB_ID, PROFILE, DEFECT_STATUS),
    lcc_limb_status(LIMB_ID, PROFILE, STATUS),
    lcc_has_externality_category(COST_COMPONENTS, STATUS),
    lcc_has_externality_not_determinable(COST_COMPONENTS, STATUS),
    lcc_has_negative_amount(COST_COMPONENTS, STATUS),
    lcc_total_acc(COST_COMPONENTS, ACC, TOTAL_EUR_CENTS),
    lcc_excluded_categories(COST_COMPONENTS, EXCLUDED_CATEGORIES),
    lcc_category_excluded_present(COST_COMPONENTS, CATEGORY),
    lcc_method_validity_defects(PROFILE, DEFECT_IDS),
    lcc_method_validity_citations(DEFECT_IDS, CITATIONS),
    lcc_method_validity_checklist(PROFILE, CHECKLIST),
    lcc_cost_category_citation(CATEGORY, CITATION),
    lcc_input_problems(DETERMINATION, PROFILE, PROBLEMS),
    lcc_profile_problem(DETERMINATION, PROFILE, PROBLEM),
    lcc_cost_components_problem(COST_COMPONENTS, PROBLEM),
    lcc_component_problem(COMPONENT, PROBLEM),
    lcc_three_element_record(COMPONENT),
    lcc_determinability_flag(VALUE),
    lcc_boolean(VALUE),
    lcc_boolean_key(KEY),
    lcc_reads_cost_components(DETERMINATION),
    lcc_first_alinea_key(KEY),
    lcc_externality_key(KEY),
    lcc_list_has_externality(COST_COMPONENTS),
    lcc_limb_row(LIMB_ID, PROFILE, STATUS, CITATION),
    lcc_decide_method_validity(PROFILE, VERDICT),
    lcc_decide_mandatory_method(PROFILE, VERDICT),
    lcc_decide_computation(PROFILE, VERDICT),
    gate_open,
    gate_closed,
    has_externality,
    no_externality,
    has_not_determinable,
    no_not_determinable,
    has_negative,
    no_negative,
    defect_present,
    defect_absent
])

-import_from(eu.procurement.life_cycle_costing.kernel, [
    lcc_method_validity_verdict,
    lcc_mandatory_method_verdict,
    lcc_computation_verdict,
    valid_lcc_method,
    invalid_lcc_method,
    union_common_method_mandatory_and_applied,
    union_common_method_mandatory_and_not_applied,
    no_union_common_method_mandatory,
    lcc_computed,
    lcc_no_costs_declared,
    lcc_indeterminate,
    satisfied,
    not_satisfied
])

-import_from(eu.procurement.life_cycle_costing.citations, [
    cite,
    implements,
    eu_dir_2014_24_art_68_1,
    eu_dir_2014_24_art_68_1_a,
    eu_dir_2014_24_art_68_1_a_i,
    eu_dir_2014_24_art_68_1_a_ii,
    eu_dir_2014_24_art_68_1_a_iii,
    eu_dir_2014_24_art_68_1_a_iv,
    eu_dir_2014_24_art_68_1_b,
    eu_dir_2014_24_art_68_2,
    eu_dir_2014_24_art_68_2_a,
    eu_dir_2014_24_art_68_2_b,
    eu_dir_2014_24_art_68_2_c,
    eu_dir_2014_24_art_68_3,
    eu_dir_2014_24_annex_xiii
])

-import_from(formalize_lib, [item])

lcc_cost_category(acquisition_cost),
lcc_cost_category(use_cost),
lcc_cost_category(maintenance_cost),
lcc_cost_category(end_of_life_cost),
lcc_cost_category(other_cost_borne_by_authority_or_users),
lcc_cost_category(environmental_externality_cost),

lcc_cost_category_citation(acquisition_cost, cite(eu_dir_2014_24_art_68_1_a_i)),
lcc_cost_category_citation(use_cost, cite(eu_dir_2014_24_art_68_1_a_ii)),
lcc_cost_category_citation(maintenance_cost, cite(eu_dir_2014_24_art_68_1_a_iii)),
lcc_cost_category_citation(end_of_life_cost, cite(eu_dir_2014_24_art_68_1_a_iv)),
lcc_cost_category_citation(other_cost_borne_by_authority_or_users, cite(eu_dir_2014_24_art_68_1_a)),

lcc_union_act_id(directive_2009_33_ec),
lcc_union_act_id(other_union_act),
lcc_union_act_id(no_union_common_method),

annex_xiii_act(directive_2009_33_ec),

lcc_defect_order(externality_cost_monetary_value_not_determinable),
lcc_defect_order(tenderer_data_not_indicated),
lcc_defect_order(costing_method_not_indicated),
lcc_defect_order(externality_method_criteria_not_objectively_verifiable),
lcc_defect_order(externality_method_criteria_discriminatory),
lcc_defect_order(undue_favour_or_disadvantage_of_economic_operators),
lcc_defect_order(externality_method_not_accessible),
lcc_defect_order(externality_data_not_obtainable_with_reasonable_effort),
lcc_defect_order(externality_data_not_obtainable_by_gpa_operators),

lcc_first_alinea_limb(tenderer_data_not_indicated),
lcc_first_alinea_limb(costing_method_not_indicated),

lcc_externality_limb(externality_cost_monetary_value_not_determinable),
lcc_externality_limb(externality_method_criteria_not_objectively_verifiable),
lcc_externality_limb(externality_method_criteria_discriminatory),
lcc_externality_limb(undue_favour_or_disadvantage_of_economic_operators),
lcc_externality_limb(externality_method_not_accessible),
lcc_externality_limb(externality_data_not_obtainable_with_reasonable_effort),
lcc_externality_limb(externality_data_not_obtainable_by_gpa_operators),

lcc_simple_boolean_limb(tenderer_data_not_indicated, tenderer_data_indicated_in_procurement_documents),
lcc_simple_boolean_limb(costing_method_not_indicated, costing_method_indicated_in_procurement_documents),
lcc_simple_boolean_limb(externality_method_criteria_not_objectively_verifiable, externality_method_criteria_objectively_verifiable),
lcc_simple_boolean_limb(externality_method_criteria_discriminatory, externality_method_criteria_non_discriminatory),
lcc_simple_boolean_limb(externality_method_not_accessible, externality_method_accessible_to_all_interested_parties),
lcc_simple_boolean_limb(externality_data_not_obtainable_with_reasonable_effort, externality_data_obtainable_with_reasonable_effort),
lcc_simple_boolean_limb(externality_data_not_obtainable_by_gpa_operators, externality_data_obtainable_by_third_country_gpa_operators),

lcc_limb_citation(externality_cost_monetary_value_not_determinable, cite(eu_dir_2014_24_art_68_1_b)),
lcc_limb_citation(tenderer_data_not_indicated, cite(eu_dir_2014_24_art_68_2)),
lcc_limb_citation(costing_method_not_indicated, cite(eu_dir_2014_24_art_68_2)),
lcc_limb_citation(externality_method_criteria_not_objectively_verifiable, cite(eu_dir_2014_24_art_68_2_a)),
lcc_limb_citation(externality_method_criteria_discriminatory, cite(eu_dir_2014_24_art_68_2_a)),
lcc_limb_citation(undue_favour_or_disadvantage_of_economic_operators, cite(eu_dir_2014_24_art_68_2_a)),
lcc_limb_citation(externality_method_not_accessible, cite(eu_dir_2014_24_art_68_2_b)),
lcc_limb_citation(externality_data_not_obtainable_with_reasonable_effort, cite(eu_dir_2014_24_art_68_2_c)),
lcc_limb_citation(externality_data_not_obtainable_by_gpa_operators, cite(eu_dir_2014_24_art_68_2_c)),

lcc_has_externality_category([], no_externality),
lcc_has_externality_category([[environmental_externality_cost, _, _], *_], has_externality),

lcc_has_externality_category([[_CATEGORY, _, _], *REST], STATUS) <- (
    _CATEGORY is not environmental_externality_cost,
    lcc_has_externality_category(REST, STATUS)
)

lcc_has_externality_not_determinable([], no_not_determinable),
lcc_has_externality_not_determinable([[environmental_externality_cost, _, 0], *_], has_not_determinable),

lcc_has_externality_not_determinable([[environmental_externality_cost, _, 1], *REST], STATUS) <- (
    lcc_has_externality_not_determinable(REST, STATUS)
)

lcc_has_externality_not_determinable([[_CATEGORY, _, _], *REST], STATUS) <- (
    _CATEGORY is not environmental_externality_cost,
    lcc_has_externality_not_determinable(REST, STATUS)
)

lcc_has_negative_amount([], no_negative),

lcc_has_negative_amount([[_CATEGORY, AMOUNT_EUR_CENTS, _], *REST], has_negative) <- (
    AMOUNT_EUR_CENTS < 0
)

lcc_has_negative_amount([[_CATEGORY, AMOUNT_EUR_CENTS, _], *REST], STATUS) <- (
    AMOUNT_EUR_CENTS >= 0,
    lcc_has_negative_amount(REST, STATUS)
)

lcc_total_acc([], ACC, ACC),

lcc_total_acc([[COST_CATEGORY, AMOUNT_EUR_CENTS, DETERMINABLE], *REST], ACC, TOTAL_EUR_CENTS) <- (
    AMOUNT_EUR_CENTS >= 0,
    lcc_component_admissibility(COST_CATEGORY, DETERMINABLE, component_included),
    NEW_ACC == ACC + AMOUNT_EUR_CENTS,
    lcc_total_acc(REST, NEW_ACC, TOTAL_EUR_CENTS)
)

lcc_total_acc([[COST_CATEGORY, AMOUNT_EUR_CENTS, DETERMINABLE], *REST], ACC, TOTAL_EUR_CENTS) <- (
    AMOUNT_EUR_CENTS >= 0,
    lcc_component_admissibility(COST_CATEGORY, DETERMINABLE, component_excluded),
    lcc_total_acc(REST, ACC, TOTAL_EUR_CENTS)
)

lcc_category_excluded_present([[CATEGORY, _AMOUNT_EUR_CENTS, DETERMINABLE], *REST], CATEGORY) <- (
    lcc_component_admissibility(CATEGORY, DETERMINABLE, component_excluded)
)

lcc_category_excluded_present([[CATEGORY, _AMOUNT_EUR_CENTS, DETERMINABLE], *REST], CATEGORY) <- (
    lcc_component_admissibility(CATEGORY, DETERMINABLE, component_included),
    lcc_category_excluded_present(REST, CATEGORY)
)

lcc_category_excluded_present([[_OTHER_CATEGORY, _AMOUNT_EUR_CENTS, _DETERMINABLE], *REST], CATEGORY) <- (
    _OTHER_CATEGORY is not CATEGORY,
    lcc_category_excluded_present(REST, CATEGORY)
)

lcc_excluded_categories(COST_COMPONENTS, EXCLUDED_CATEGORIES) <- (
    implements(eu_dir_2014_24_art_68_1_a),
    implements(eu_dir_2014_24_art_68_1_a_i),
    implements(eu_dir_2014_24_art_68_1_a_ii),
    implements(eu_dir_2014_24_art_68_1_a_iii),
    implements(eu_dir_2014_24_art_68_1_a_iv),
    findall(CATEGORY, (lcc_cost_category(CATEGORY), lcc_category_excluded_present(COST_COMPONENTS, CATEGORY)), EXCLUDED_CATEGORIES)
)

lcc_component_admissibility(acquisition_cost, _DETERMINABLE, component_included),
lcc_component_admissibility(use_cost, _DETERMINABLE, component_included),
lcc_component_admissibility(maintenance_cost, _DETERMINABLE, component_included),
lcc_component_admissibility(end_of_life_cost, _DETERMINABLE, component_included),
lcc_component_admissibility(other_cost_borne_by_authority_or_users, _DETERMINABLE, component_included),
lcc_component_admissibility(environmental_externality_cost, 1, component_included),
lcc_component_admissibility(environmental_externality_cost, 0, component_excluded),

lcc_total(COST_COMPONENTS, TOTAL_EUR_CENTS) <- (
    implements(eu_dir_2014_24_art_68_1),
    ground(COST_COMPONENTS),
    not lcc_cost_components_problem(COST_COMPONENTS, _),
    lcc_total_acc(COST_COMPONENTS, 0, TOTAL_EUR_CENTS)
)

lcc_externality_assessment(COST_COMPONENTS, externality_costs_assessed) <- (
    implements(eu_dir_2014_24_art_68_1_b),
    ground(COST_COMPONENTS),
    not lcc_cost_components_problem(COST_COMPONENTS, _),
    lcc_has_externality_category(COST_COMPONENTS, has_externality)
)

lcc_externality_assessment(COST_COMPONENTS, externality_costs_not_assessed) <- (
    implements(eu_dir_2014_24_art_68_1_b),
    ground(COST_COMPONENTS),
    not lcc_cost_components_problem(COST_COMPONENTS, _),
    lcc_has_externality_category(COST_COMPONENTS, no_externality)
)

lcc_mandatory_method_status(no_union_common_method, _APPLIED, no_union_common_method_mandatory),
lcc_mandatory_method_status(directive_2009_33_ec, 1, union_common_method_mandatory_and_applied),
lcc_mandatory_method_status(directive_2009_33_ec, 0, union_common_method_mandatory_and_not_applied),
lcc_mandatory_method_status(other_union_act, 1, union_common_method_mandatory_and_applied),
lcc_mandatory_method_status(other_union_act, 0, union_common_method_mandatory_and_not_applied),

lcc_union_act_listing(no_union_common_method, no_union_act) <- (
    implements(eu_dir_2014_24_annex_xiii)
)

lcc_union_act_listing(UNION_ACT_KEY, listed_in_annex_xiii) <- (
    implements(eu_dir_2014_24_annex_xiii),
    UNION_ACT_KEY is not no_union_common_method,
    annex_xiii_act(UNION_ACT_KEY)
)

lcc_union_act_listing(UNION_ACT_KEY, not_listed_in_annex_xiii) <- (
    implements(eu_dir_2014_24_annex_xiii),
    UNION_ACT_KEY is not no_union_common_method,
    not annex_xiii_act(UNION_ACT_KEY)
)

lcc_limb_gate(LIMB_ID, PROFILE, gate_open) <- (
    lcc_first_alinea_limb(LIMB_ID),
    get(PROFILE, cost_components, COST_COMPONENTS),
    COST_COMPONENTS is not []
)

lcc_limb_gate(LIMB_ID, PROFILE, gate_closed) <- (
    lcc_first_alinea_limb(LIMB_ID),
    get(PROFILE, cost_components, COST_COMPONENTS),
    COST_COMPONENTS is []
)

lcc_limb_gate(LIMB_ID, PROFILE, gate_open) <- (
    lcc_externality_limb(LIMB_ID),
    get(PROFILE, cost_components, COST_COMPONENTS),
    COST_COMPONENTS is not [],
    lcc_has_externality_category(COST_COMPONENTS, has_externality)
)

lcc_limb_gate(LIMB_ID, PROFILE, gate_closed) <- (
    lcc_externality_limb(LIMB_ID),
    get(PROFILE, cost_components, COST_COMPONENTS),
    COST_COMPONENTS is []
)

lcc_limb_gate(LIMB_ID, PROFILE, gate_closed) <- (
    lcc_externality_limb(LIMB_ID),
    get(PROFILE, cost_components, COST_COMPONENTS),
    COST_COMPONENTS is not [],
    lcc_has_externality_category(COST_COMPONENTS, no_externality)
)

lcc_limb_defect(DEFECT_ID, PROFILE, defect_present) <- (
    lcc_simple_boolean_limb(DEFECT_ID, PROFILE_KEY),
    implements(eu_dir_2014_24_art_68_2),
    implements(eu_dir_2014_24_art_68_2_a),
    implements(eu_dir_2014_24_art_68_2_b),
    implements(eu_dir_2014_24_art_68_2_c),
    get(PROFILE, PROFILE_KEY, FLAG),
    FLAG is False
)

lcc_limb_defect(DEFECT_ID, PROFILE, defect_absent) <- (
    lcc_simple_boolean_limb(DEFECT_ID, PROFILE_KEY),
    implements(eu_dir_2014_24_art_68_2),
    implements(eu_dir_2014_24_art_68_2_a),
    implements(eu_dir_2014_24_art_68_2_b),
    implements(eu_dir_2014_24_art_68_2_c),
    get(PROFILE, PROFILE_KEY, FLAG),
    FLAG is True
)

lcc_limb_defect(externality_cost_monetary_value_not_determinable, PROFILE, defect_present) <- (
    implements(eu_dir_2014_24_art_68_1_b),
    get(PROFILE, cost_components, COST_COMPONENTS),
    lcc_has_externality_not_determinable(COST_COMPONENTS, has_not_determinable)
)

lcc_limb_defect(externality_cost_monetary_value_not_determinable, PROFILE, defect_absent) <- (
    implements(eu_dir_2014_24_art_68_1_b),
    get(PROFILE, cost_components, COST_COMPONENTS),
    lcc_has_externality_not_determinable(COST_COMPONENTS, no_not_determinable)
)

lcc_limb_defect(undue_favour_or_disadvantage_of_economic_operators, PROFILE, defect_present) <- (
    implements(eu_dir_2014_24_art_68_2_a),
    get(PROFILE, externality_method_established_for_repeated_or_continuous_application, ESTABLISHED),
    ESTABLISHED is False,
    get(PROFILE, externality_method_unduly_favours_or_disadvantages_operators, UNDUE),
    UNDUE is True
)

lcc_limb_defect(undue_favour_or_disadvantage_of_economic_operators, PROFILE, defect_absent) <- (
    implements(eu_dir_2014_24_art_68_2_a),
    get(PROFILE, externality_method_established_for_repeated_or_continuous_application, ESTABLISHED),
    ESTABLISHED is True
)

lcc_limb_defect(undue_favour_or_disadvantage_of_economic_operators, PROFILE, defect_absent) <- (
    implements(eu_dir_2014_24_art_68_2_a),
    get(PROFILE, externality_method_established_for_repeated_or_continuous_application, ESTABLISHED),
    ESTABLISHED is False,
    get(PROFILE, externality_method_unduly_favours_or_disadvantages_operators, UNDUE),
    UNDUE is False
)

lcc_limb_status(LIMB_ID, PROFILE, satisfied) <- (
    lcc_limb_gate(LIMB_ID, PROFILE, gate_closed)
)

lcc_limb_status(LIMB_ID, PROFILE, satisfied) <- (
    lcc_limb_gate(LIMB_ID, PROFILE, gate_open),
    lcc_limb_defect(LIMB_ID, PROFILE, defect_absent)
)

lcc_limb_status(LIMB_ID, PROFILE, not_satisfied) <- (
    lcc_limb_gate(LIMB_ID, PROFILE, gate_open),
    lcc_limb_defect(LIMB_ID, PROFILE, defect_present)
)

lcc_limb_row(LIMB_ID, PROFILE, STATUS, CITATION) <- (
    lcc_limb_citation(LIMB_ID, CITATION),
    lcc_limb_status(LIMB_ID, PROFILE, STATUS)
)

# Public per-limb row: refused (no solution) for a profile the input check rejects.
lcc_method_validity_limb_status(LIMB_ID, PROFILE, STATUS, CITATION) <- (
    not life_cycle_costing_input_problem(method_validity, PROFILE, _),
    lcc_limb_row(LIMB_ID, PROFILE, STATUS, CITATION)
)

lcc_method_validity_defects(PROFILE, DEFECT_IDS) <- (
    findall(DEFECT_ID, (lcc_defect_order(DEFECT_ID), lcc_limb_row(DEFECT_ID, PROFILE, not_satisfied, _CITATION)), DEFECT_IDS)
)

lcc_method_validity_citations(DEFECT_IDS, CITATIONS) <- (
    findall(CITATION, (lcc_defect_order(DEFECT_ID), DEFECT_ID in DEFECT_IDS, lcc_limb_citation(DEFECT_ID, CITATION)), CITATIONS)
)

lcc_method_validity_checklist(PROFILE, CHECKLIST) <- (
    findall(ITEM, (lcc_defect_order(LIMB_ID), lcc_limb_row(LIMB_ID, PROFILE, STATUS, CITATION), ITEM is item(LIMB_ID, STATUS, CITATION)), CHECKLIST)
)

lcc_decide_method_validity(PROFILE, lcc_method_validity_verdict(valid_lcc_method, [], [])) <- (
    implements(eu_dir_2014_24_art_68_2),
    lcc_method_validity_defects(PROFILE, DEFECT_IDS),
    DEFECT_IDS is []
)

lcc_decide_method_validity(PROFILE, lcc_method_validity_verdict(invalid_lcc_method, DEFECT_IDS, CITATIONS)) <- (
    implements(eu_dir_2014_24_art_68_2),
    lcc_method_validity_defects(PROFILE, DEFECT_IDS),
    DEFECT_IDS is not [],
    lcc_method_validity_citations(DEFECT_IDS, CITATIONS)
)

lcc_decide_mandatory_method(PROFILE, lcc_mandatory_method_verdict(no_union_common_method_mandatory, [], [])) <- (
    implements(eu_dir_2014_24_art_68_3),
    get(PROFILE, union_common_method_act_key, no_union_common_method)
)

lcc_decide_mandatory_method(PROFILE, lcc_mandatory_method_verdict(union_common_method_mandatory_and_applied, [], [])) <- (
    implements(eu_dir_2014_24_art_68_3),
    get(PROFILE, union_common_method_act_key, ACT_KEY),
    get(PROFILE, union_common_method_applied, APPLIED_BOOL),
    APPLIED_BOOL is True,
    lcc_mandatory_method_status(ACT_KEY, 1, union_common_method_mandatory_and_applied)
)

lcc_decide_mandatory_method(PROFILE, lcc_mandatory_method_verdict(union_common_method_mandatory_and_not_applied, [mandatory_union_common_method_not_applied], [cite(eu_dir_2014_24_art_68_3)])) <- (
    implements(eu_dir_2014_24_art_68_3),
    get(PROFILE, union_common_method_act_key, ACT_KEY),
    get(PROFILE, union_common_method_applied, APPLIED_BOOL),
    APPLIED_BOOL is False,
    lcc_mandatory_method_status(ACT_KEY, 0, union_common_method_mandatory_and_not_applied)
)

lcc_decide_computation(PROFILE, lcc_computation_verdict(lcc_no_costs_declared, 0, [])) <- (
    implements(eu_dir_2014_24_art_68_1),
    get(PROFILE, cost_components, COST_COMPONENTS),
    COST_COMPONENTS is []
)

lcc_decide_computation(PROFILE, lcc_computation_verdict(lcc_indeterminate, 0, [])) <- (
    implements(eu_dir_2014_24_art_68_1),
    get(PROFILE, cost_components, COST_COMPONENTS),
    COST_COMPONENTS is not [],
    lcc_has_negative_amount(COST_COMPONENTS, has_negative)
)

lcc_decide_computation(PROFILE, lcc_computation_verdict(lcc_computed, TOTAL_EUR_CENTS, EXCLUDED_CATEGORIES)) <- (
    implements(eu_dir_2014_24_art_68_1),
    get(PROFILE, cost_components, COST_COMPONENTS),
    COST_COMPONENTS is not [],
    lcc_has_negative_amount(COST_COMPONENTS, no_negative),
    lcc_total(COST_COMPONENTS, TOTAL_EUR_CENTS),
    lcc_excluded_categories(COST_COMPONENTS, EXCLUDED_CATEGORIES)
)

# =====================================================================
# THE INPUT CHECK (D80, 2026-10-20). One check for the whole domain, run
# before any rule decides, at every public entry point that takes a profile:
# decide_lcc_method_validity/2, decide_lcc_mandatory_method/2,
# decide_lcc_computation/2 and lcc_method_validity_limb_status/4 here, and
# life_cycle_costing_calculation/2 in queries (the other queries and the
# fixtures wrapper go through the decide_* predicates). lcc_total/2 and
# lcc_externality_assessment/2 take a component list, and run the
# component-list half of the same check.
#
# life_cycle_costing_input_problem(DETERMINATION, PROFILE, PROBLEM) gives
# the FIRST problem with PROFILE for DETERMINATION (method_validity,
# mandatory_method or computation), and fails when there is none.
#
# It is total and negation-safe: ground(PROFILE) is tested first, then that
# PROFILE is a dict, and only then are values read; nothing is compared
# arithmetically before integer/1 has accepted it.
#
# What it refuses, for every determination: a profile that is not ground or
# not a dict; a PRESENT key of the wrong type or outside its vocabulary
# (profile_keys.yaml key_contract); and no_union_common_method together with
# union_common_method_applied True, which profile_keys.yaml calls
# "incoherent input" that "fails closed".
#
# Which ABSENT keys it refuses depends on the determination, because the
# three slices read different keys and no slice gates another (manifest.yaml
# modules banner). Absence is accepted exactly where the law makes the key
# irrelevant (manifest.yaml scope (A) "TWO APPLICABILITY GATES"):
#   method_validity: cost_components always; the two Art 68(2) first-alinea
#     flags when the list is non-empty (outer gate); the six externality
#     flags when an environmental externality component is declared (inner
#     gate); the undue-favour flag only when, in addition, the method was not
#     established for repeated or continuous application (Art 68(2)(a)
#     second sentence).
#   mandatory_method: union_common_method_act_key always;
#     union_common_method_applied unless the act key is no_union_common_method
#     ("Read only where an act exists", profile_keys.yaml).
#   computation: cost_components always.
# A negative amount is refused for the computation only (its documented
# outcome is lcc_indeterminate, manifest.yaml scope (C)); the validity slice
# does not read amounts' sign.
#
# What a refused profile gives: decide_lcc_computation/2 returns its own
# indeterminate verdict lcc_computation_verdict(lcc_indeterminate, 0, []); the
# other entry points have no "cannot decide" value and fail (no answer).
# =====================================================================
life_cycle_costing_input_problem(DETERMINATION, PROFILE, PROBLEM) <- (
    lcc_input_problems(DETERMINATION, PROFILE, [PROBLEM, *_])
)

lcc_input_problems(_DETERMINATION, PROFILE, [not_ground]) <- (
    not ground(PROFILE)
)

lcc_input_problems(_DETERMINATION, PROFILE, [wrong_type(profile, expected_dict)]) <- (
    ground(PROFILE),
    not is_dict(PROFILE)
)

lcc_input_problems(DETERMINATION, PROFILE, PROBLEMS) <- (
    ground(PROFILE),
    is_dict(PROFILE),
    findall(PROBLEM, lcc_profile_problem(DETERMINATION, PROFILE, PROBLEM), PROBLEMS)
)

lcc_reads_cost_components(method_validity),
lcc_reads_cost_components(computation),

lcc_first_alinea_key(tenderer_data_indicated_in_procurement_documents),
lcc_first_alinea_key(costing_method_indicated_in_procurement_documents),

lcc_externality_key(externality_method_criteria_objectively_verifiable),
lcc_externality_key(externality_method_criteria_non_discriminatory),
lcc_externality_key(externality_method_established_for_repeated_or_continuous_application),
lcc_externality_key(externality_method_accessible_to_all_interested_parties),
lcc_externality_key(externality_data_obtainable_with_reasonable_effort),
lcc_externality_key(externality_data_obtainable_by_third_country_gpa_operators),

lcc_boolean_key(tenderer_data_indicated_in_procurement_documents),
lcc_boolean_key(costing_method_indicated_in_procurement_documents),
lcc_boolean_key(externality_method_criteria_objectively_verifiable),
lcc_boolean_key(externality_method_criteria_non_discriminatory),
lcc_boolean_key(externality_method_established_for_repeated_or_continuous_application),
lcc_boolean_key(externality_method_unduly_favours_or_disadvantages_operators),
lcc_boolean_key(externality_method_accessible_to_all_interested_parties),
lcc_boolean_key(externality_data_obtainable_with_reasonable_effort),
lcc_boolean_key(externality_data_obtainable_by_third_country_gpa_operators),
lcc_boolean_key(union_common_method_applied),

lcc_boolean(True),
lcc_boolean(False),

lcc_determinability_flag(0),
lcc_determinability_flag(1),

lcc_three_element_record([_CATEGORY, _AMOUNT_EUR_CENTS, _DETERMINABLE]),

# -- absent keys, per determination --
lcc_profile_problem(DETERMINATION, PROFILE, missing_key(cost_components)) <- (
    lcc_reads_cost_components(DETERMINATION),
    not get(PROFILE, cost_components, _)
)

# -- cost_components shape, every determination --
lcc_profile_problem(_DETERMINATION, PROFILE, PROBLEM) <- (
    get(PROFILE, cost_components, COST_COMPONENTS),
    lcc_cost_components_problem(COST_COMPONENTS, PROBLEM)
)

lcc_profile_problem(computation, PROFILE, negative_amount(COMPONENT)) <- (
    get(PROFILE, cost_components, COST_COMPONENTS),
    is_list(COST_COMPONENTS),
    COMPONENT in COST_COMPONENTS,
    COMPONENT is [_CATEGORY, AMOUNT_EUR_CENTS, _DETERMINABLE],
    integer(AMOUNT_EUR_CENTS),
    AMOUNT_EUR_CENTS < 0
)

# -- booleans and the act key, every determination --
lcc_profile_problem(_DETERMINATION, PROFILE, wrong_type(KEY, expected_boolean)) <- (
    lcc_boolean_key(KEY),
    get(PROFILE, KEY, VALUE),
    not lcc_boolean(VALUE)
)

lcc_profile_problem(_DETERMINATION, PROFILE, wrong_value(union_common_method_act_key, expected_union_act_atom)) <- (
    get(PROFILE, union_common_method_act_key, VALUE),
    not lcc_union_act_id(VALUE)
)

lcc_profile_problem(_DETERMINATION, PROFILE, incoherent_input(union_common_method_applied_without_union_act)) <- (
    get(PROFILE, union_common_method_act_key, no_union_common_method),
    get(PROFILE, union_common_method_applied, True)
)

# -- method validity: flags required by the open gates --
lcc_profile_problem(method_validity, PROFILE, missing_key(KEY)) <- (
    get(PROFILE, cost_components, COST_COMPONENTS),
    COST_COMPONENTS is not [],
    lcc_first_alinea_key(KEY),
    not get(PROFILE, KEY, _)
)

lcc_profile_problem(method_validity, PROFILE, missing_key(KEY)) <- (
    get(PROFILE, cost_components, COST_COMPONENTS),
    lcc_list_has_externality(COST_COMPONENTS),
    lcc_externality_key(KEY),
    not get(PROFILE, KEY, _)
)

lcc_profile_problem(method_validity, PROFILE, missing_key(externality_method_unduly_favours_or_disadvantages_operators)) <- (
    get(PROFILE, cost_components, COST_COMPONENTS),
    lcc_list_has_externality(COST_COMPONENTS),
    get(PROFILE, externality_method_established_for_repeated_or_continuous_application, False),
    not get(PROFILE, externality_method_unduly_favours_or_disadvantages_operators, _)
)

# -- mandatory method --
lcc_profile_problem(mandatory_method, PROFILE, missing_key(union_common_method_act_key)) <- (
    not get(PROFILE, union_common_method_act_key, _)
)

lcc_profile_problem(mandatory_method, PROFILE, missing_key(union_common_method_applied)) <- (
    get(PROFILE, union_common_method_act_key, ACT_KEY),
    ACT_KEY is not no_union_common_method,
    not get(PROFILE, union_common_method_applied, _)
)

# -- the component list (also run by lcc_total/2 and lcc_externality_assessment/2) --
lcc_cost_components_problem(COST_COMPONENTS, not_a_list(cost_components)) <- (
    not is_list(COST_COMPONENTS)
)

lcc_cost_components_problem(COST_COMPONENTS, PROBLEM) <- (
    is_list(COST_COMPONENTS),
    COMPONENT in COST_COMPONENTS,
    lcc_component_problem(COMPONENT, PROBLEM)
)

lcc_component_problem(COMPONENT, malformed_cost_component(COMPONENT)) <- (
    not lcc_three_element_record(COMPONENT)
)

lcc_component_problem([CATEGORY, _AMOUNT_EUR_CENTS, _DETERMINABLE], unknown_cost_category(CATEGORY)) <- (
    not lcc_cost_category(CATEGORY)
)

lcc_component_problem([CATEGORY, AMOUNT_EUR_CENTS, DETERMINABLE], wrong_type(cost_component([CATEGORY, AMOUNT_EUR_CENTS, DETERMINABLE]), expected_integer_euro_cents)) <- (
    not integer(AMOUNT_EUR_CENTS)
)

lcc_component_problem([CATEGORY, AMOUNT_EUR_CENTS, DETERMINABLE], wrong_type(cost_component([CATEGORY, AMOUNT_EUR_CENTS, DETERMINABLE]), expected_zero_or_one)) <- (
    not integer(DETERMINABLE)
)

lcc_component_problem([CATEGORY, AMOUNT_EUR_CENTS, DETERMINABLE], wrong_type(cost_component([CATEGORY, AMOUNT_EUR_CENTS, DETERMINABLE]), expected_zero_or_one)) <- (
    integer(DETERMINABLE),
    not lcc_determinability_flag(DETERMINABLE)
)

lcc_list_has_externality(COST_COMPONENTS) <- (
    is_list(COST_COMPONENTS),
    once((COMPONENT in COST_COMPONENTS, COMPONENT is [environmental_externality_cost, _AMOUNT_EUR_CENTS, _DETERMINABLE]))
)

# ---- The guarded public decision predicates ----------------------------
decide_lcc_method_validity(PROFILE, VERDICT) <- (
    not life_cycle_costing_input_problem(method_validity, PROFILE, _),
    lcc_decide_method_validity(PROFILE, VERDICT)
)

decide_lcc_mandatory_method(PROFILE, VERDICT) <- (
    not life_cycle_costing_input_problem(mandatory_method, PROFILE, _),
    lcc_decide_mandatory_method(PROFILE, VERDICT)
)

decide_lcc_computation(PROFILE, lcc_computation_verdict(lcc_indeterminate, 0, [])) <- (
    implements(eu_dir_2014_24_art_68_1),
    life_cycle_costing_input_problem(computation, PROFILE, _PROBLEM)
)

decide_lcc_computation(PROFILE, VERDICT) <- (
    not life_cycle_costing_input_problem(computation, PROFILE, _),
    lcc_decide_computation(PROFILE, VERDICT)
)
