# citations.clausal -- machine-readable citation registry for this domain.
# Generated by _tools/scaffold_citations.py; ref/verbatim populated by the
# citation sourcing pass (verified against authoritative sources; see
# citations-sources.yaml). Regenerate structure; hand-edit only ref/verbatim.
#
# Owns cite/1 (the in-clause citation wrapper) and citation/2 (the
# explainability lookup: cite(C) in a decision resolves to citation(C, Meta)).
# English verbatim is the default-language rendition; other languages go in a
# per-domain translation/<lang>.clausal subpackage -- the translation/2 functor
# carries {verbatim, ref}, namespace-derived, load-on-demand -- NOT here.


-module(citations, [cite(C), implements(C), citation(ATOM, META), eu_dir_2014_24_annex_xiii, eu_dir_2014_24_art_68_1, eu_dir_2014_24_art_68_1_a, eu_dir_2014_24_art_68_1_a_i, eu_dir_2014_24_art_68_1_a_ii, eu_dir_2014_24_art_68_1_a_iii, eu_dir_2014_24_art_68_1_a_iv, eu_dir_2014_24_art_68_1_b, eu_dir_2014_24_art_68_2, eu_dir_2014_24_art_68_2_a, eu_dir_2014_24_art_68_2_b, eu_dir_2014_24_art_68_2_c, eu_dir_2014_24_art_68_3])
-double_quotes(chars)
-private([label, ref, units, verbatim])

-strict_atoms

citation(eu_dir_2014_24_annex_xiii, {
  units:    ["02014L0024-20260101#division_annex_xiii-list_of_union_legal_acts_referred_to_in_article_68_3"],
  label:    "Directive 2014/24/EU, Annex XIII (list of Union legal acts referred to in Article 68(3))",
  ref:      "http://publications.europa.eu/resource/celex/02014L0024-20260101.ENG.fmx4",
  verbatim: "LIST OF UNION LEGAL ACTS REFERRED TO IN ARTICLE 68(3) Directive 2009/33/EC of the European Parliament and of the Council."
}),

citation(eu_dir_2014_24_art_68_1, {
  units:    ["02014L0024-20260101#parag_068.001"],
  label:    "Directive 2014/24/EU, Article 68(1) (what life-cycle costing covers)",
  ref:      "http://publications.europa.eu/resource/celex/02014L0024-20260101.ENG.fmx4",
  verbatim: "1. Life-cycle costing shall to the extent relevant cover parts or all of the following costs over the life cycle of a product, service or works:"
}),

citation(eu_dir_2014_24_art_68_1_a, {
  units:    ["02014L0024-20260101#point_068.001_a"],
  label:    "Directive 2014/24/EU, Article 68(1)(a) (costs borne by the contracting authority or other users)",
  ref:      "http://publications.europa.eu/resource/celex/02014L0024-20260101.ENG.fmx4",
  verbatim: "(a) costs, borne by the contracting authority or other users, such as:"
}),

citation(eu_dir_2014_24_art_68_1_a_i, {
  units:    ["02014L0024-20260101#point_068.001_a_i"],
  label:    "Directive 2014/24/EU, Article 68(1)(a)(i) (costs relating to acquisition)",
  ref:      "http://publications.europa.eu/resource/celex/02014L0024-20260101.ENG.fmx4",
  verbatim: "(i) costs relating to acquisition,"
}),

citation(eu_dir_2014_24_art_68_1_a_ii, {
  units:    ["02014L0024-20260101#point_068.001_a_ii"],
  label:    "Directive 2014/24/EU, Article 68(1)(a)(ii) (costs of use)",
  ref:      "http://publications.europa.eu/resource/celex/02014L0024-20260101.ENG.fmx4",
  verbatim: "(ii) costs of use, such as consumption of energy and other resources,"
}),

citation(eu_dir_2014_24_art_68_1_a_iii, {
  units:    ["02014L0024-20260101#point_068.001_a_iii"],
  label:    "Directive 2014/24/EU, Article 68(1)(a)(iii) (maintenance costs)",
  ref:      "http://publications.europa.eu/resource/celex/02014L0024-20260101.ENG.fmx4",
  verbatim: "(iii) maintenance costs,"
}),

citation(eu_dir_2014_24_art_68_1_a_iv, {
  units:    ["02014L0024-20260101#point_068.001_a_iv"],
  label:    "Directive 2014/24/EU, Article 68(1)(a)(iv) (end of life costs)",
  ref:      "http://publications.europa.eu/resource/celex/02014L0024-20260101.ENG.fmx4",
  verbatim: "(iv) end of life costs, such as collection and recycling costs."
}),

citation(eu_dir_2014_24_art_68_1_b, {
  units:    ["02014L0024-20260101#point_068.001_b"],
  label:    "Directive 2014/24/EU, Article 68(1)(b) (environmental externality costs, and the determinable-and-verifiable proviso)",
  ref:      "http://publications.europa.eu/resource/celex/02014L0024-20260101.ENG.fmx4",
  verbatim: "(b) costs imputed to environmental externalities linked to the product, service or works during its life cycle, provided their monetary value can be determined and verified; such costs may include the cost of emissions of greenhouse gases and of other pollutant emissions and other climate change mitigation costs."
}),

citation(eu_dir_2014_24_art_68_2, {
  units:    ["02014L0024-20260101#parag_068.002"],
  label:    "Directive 2014/24/EU, Article 68(2) (duty to indicate the data and the method; chapeau to the three cumulative conditions)",
  ref:      "http://publications.europa.eu/resource/celex/02014L0024-20260101.ENG.fmx4",
  verbatim: "2. Where contracting authorities assess the costs using a life-cycle costing approach, they shall indicate in the procurement documents the data to be provided by the tenderers and the method which the contracting authority will use to determine the life-cycle costs on the basis of those data. The method used for the assessment of costs imputed to environmental externalities shall fulfil all of the following conditions:"
}),

citation(eu_dir_2014_24_art_68_2_a, {
  units:    ["02014L0024-20260101#point_068.002_a"],
  label:    "Directive 2014/24/EU, Article 68(2)(a) (objectively verifiable and non-discriminatory criteria; no undue favour)",
  ref:      "http://publications.europa.eu/resource/celex/02014L0024-20260101.ENG.fmx4",
  verbatim: "(a) it is based on objectively verifiable and non-discriminatory criteria. In particular, where it has not been established for repeated or continuous application, it shall not unduly favour or disadvantage certain economic operators;"
}),

citation(eu_dir_2014_24_art_68_2_b, {
  units:    ["02014L0024-20260101#point_068.002_b"],
  label:    "Directive 2014/24/EU, Article 68(2)(b) (accessible to all interested parties)",
  ref:      "http://publications.europa.eu/resource/celex/02014L0024-20260101.ENG.fmx4",
  verbatim: "(b) it is accessible to all interested parties;"
}),

citation(eu_dir_2014_24_art_68_2_c, {
  units:    ["02014L0024-20260101#point_068.002_c"],
  label:    "Directive 2014/24/EU, Article 68(2)(c) (data obtainable with reasonable effort, including by GPA third-country operators)",
  ref:      "http://publications.europa.eu/resource/celex/02014L0024-20260101.ENG.fmx4",
  verbatim: "(c) the data required can be provided with reasonable effort by normally diligent economic operators, including economic operators from third countries party to the GPA or other international agreements by which the Union is bound."
}),

citation(eu_dir_2014_24_art_68_3, {
  units:    ["02014L0024-20260101#parag_068.003"],
  label:    "Directive 2014/24/EU, Article 68(3) (a mandatory Union common method displaces the authority's own)",
  ref:      "http://publications.europa.eu/resource/celex/02014L0024-20260101.ENG.fmx4",
  verbatim: "3. Whenever a common method for the calculation of life-cycle costs has been made mandatory by a legislative act of the Union, that common method shall be applied for the assessment of life-cycle costs. A list of such legislative acts, and where necessary the delegated acts supplementing them, is set out in Annex XIII. The Commission shall be empowered to adopt delegated acts in accordance with Article 87 concerning the update of that list, when an update of the list is necessary due to the adoption of new legislation making a common method mandatory or the repeal or modification of existing legal acts."
}),

# implements/1 -- the in-clause provenance marker (convention 2026-08-28).
# DEFINED, not merely declared: an exported predicate with no clause has
# no compiled dispatch function and RAISES when called.
implements(KEY) <- (
    citation(KEY, _)
),
