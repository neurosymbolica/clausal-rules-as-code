-double_quotes(chars)
# Run: cd <corpus root> && python -m clausal.testing
#      eu/procurement/utilities_negotiated_without_prior_call/tests/test_load.clausal

-import_from(eu.procurement.utilities_negotiated_without_prior_call.kernel, [
    utilities_negotiated_verdict,
    use_lawful,
    use_unlawful,
    n_a
])

-import_from(eu.procurement.utilities_negotiated_without_prior_call.citations, [
    cite,
    citation,
    implements,
    eu_dir_2014_25_art_50_chapeau
])

test("verdict atoms are distinct") <- (
    not (use_lawful is use_unlawful),
    not (use_lawful is n_a),
    not (use_unlawful is n_a)
)

test("result constructor builds and destructures") <- (
    VERDICT is utilities_negotiated_verdict(use_lawful, n_a, [cite(eu_dir_2014_25_art_50_chapeau)]),
    VERDICT is utilities_negotiated_verdict(STATUS, GROUND, CITATIONS),
    STATUS is use_lawful,
    GROUND is n_a,
    CITATIONS is [cite(eu_dir_2014_25_art_50_chapeau)]
)

test("one real citation record resolves") <- (
    citation(eu_dir_2014_25_art_50_chapeau, METADATA),
    implements(eu_dir_2014_25_art_50_chapeau)
)
