-double_quotes(chars)
# =====================================================================
# test_robustness.seam -- ROBUSTNESS of the decision predicate
# decide_utilities_negotiated_without_prior_call/2 against incomplete and
# malformed profiles.
#
# The contract these tests hold the domain to comes from NOTES.md:
#   - section 1: "With no pleaded ground there is no verdict."
#     -> no solution, and no exception.
#   - section 1: a pleaded ground that "is not one of the ten" is use_unlawful
#     (the Art 50 chapeau list is exhaustive).
#   - section 2: "Each condition is met only when its flag is `true`. A flag
#     that is absent counts as not established, so the condition is unmet."
#     and "There is no `indeterminate` verdict: the entity relying on an
#     exception must establish it."
#     -> a stated default for an ABSENT flag: dropping it gives use_unlawful.
#        A PRESENT flag with any other value is refused (ruling D80,
#        2026-10-20), as is any other malformed value.
#   - section 3: the contract type is an extra condition for grounds (e)-(j)
#     only; "Grounds (a) to (d) apply to any contract type."
#   - section 4(c): "With no reason given, or a reason outside the three, the
#     ground fails."
# What NO documented default covers is an UNBOUND value: a variable is not
# `true`, not a contract type and not a ground, so it must not be solved for.
#
# Run: python -m clausal.testing eu/procurement/utilities_negotiated_without_prior_call/tests/test_robustness.seam
# =====================================================================
-import_from(eu.procurement.utilities_negotiated_without_prior_call, [
    decide_utilities_negotiated_without_prior_call,
    pleaded_ground_key, contract_type_key, sole_operator_reason_key,
    art_50_a_no_suitable_tenders, art_50_b_research_contract,
    art_50_c_sole_operator, art_50_d_extreme_urgency,
    art_50_e_additional_deliveries, art_50_f_repetition,
    art_50_g_commodity_market, art_50_h_bargain_purchase,
    art_50_i_advantageous_winding_up, art_50_j_design_contest,
    no_suitable_tenders_or_requests_received,
    initial_conditions_not_substantially_altered,
    only_particular_operator_can_perform,
    additional_deliveries_by_original_supplier,
    change_of_supplier_would_cause_technical_incompatibility,
    repetition_conforms_to_basic_project,
    original_contract_followed_article_44_1_procedure,
    basic_project_indicated_extent_and_conditions,
    possible_use_of_this_procedure_disclosed_at_first_tender,
    utilities_negotiated_without_prior_call_input_problem,
    utilities_negotiated_without_prior_call_status,
    utilities_negotiated_without_prior_call_checklist,
    utilities_negotiated_without_prior_call_unmet_count,
    not_ground, not_a_dict, missing_key, wrong_type, wrong_value,
    expected_atom, expected_boolean, expected_contract_type])
-import_from(eu.procurement.utilities_negotiated_without_prior_call.queries, [
    utilities_negotiated_without_prior_call_what_if])
-import_from(eu.procurement.utilities_negotiated_without_prior_call.fixtures, [
    utilities_negotiated_without_prior_call_subject,
    utilities_negotiated_without_prior_call_profile_for])
-import_from(eu.procurement.utilities_negotiated_without_prior_call.kernel, [
    utilities_negotiated_verdict, use_lawful, use_unlawful, n_a])
-import_from(eu.procurement.directive_2014_24.vocabulary, [works, supplies, services])
-private([answers(LIST), raised(ERROR), statuses(LIST), yes, not_a_ground,
          not_a_profile, not_a_contract_type])

# ---- helpers ---------------------------------------------------------

# OUTCOME is answers(VERDICTS) -- every verdict the decision gives -- or
# raised(ERROR) when the call throws.
decision_outcome(PROFILE, OUTCOME) <- (
    catch(
        (findall(VERDICT, decide_utilities_negotiated_without_prior_call(PROFILE, VERDICT), VERDICTS),
         OUTCOME is answers(VERDICTS)),
        ERROR,
        OUTCOME is raised(ERROR))
)

gives_no_verdict(PROFILE) <- (
    decision_outcome(PROFILE, OUTCOME),
    OUTCOME is answers([])
)

# Exactly one verdict, and it is the chapeau's use_unlawful.
gives_only_use_unlawful(PROFILE) <- (
    decision_outcome(PROFILE, OUTCOME),
    OUTCOME is answers([utilities_negotiated_verdict(use_unlawful, n_a, _)])
)

gives_only_use_lawful(PROFILE) <- (
    decision_outcome(PROFILE, OUTCOME),
    OUTCOME is answers([utilities_negotiated_verdict(use_lawful, _, _)])
)

fixture(SUBJECT, PROFILE) <- (
    utilities_negotiated_without_prior_call_profile_for(SUBJECT, PROFILE)
)

# The lawful fixtures, the profiles to start from.
lawful_subject(SUBJECT) <- (
    utilities_negotiated_without_prior_call_subject(SUBJECT),
    fixture(SUBJECT, PROFILE),
    decide_utilities_negotiated_without_prior_call(PROFILE, utilities_negotiated_verdict(use_lawful, _, _))
)

# Grounds whose own words limit the contract type (NOTES.md section 3).
ground_limited_by_contract_type(art_50_e_additional_deliveries),
ground_limited_by_contract_type(art_50_f_repetition),
ground_limited_by_contract_type(art_50_g_commodity_market),
ground_limited_by_contract_type(art_50_h_bargain_purchase),
ground_limited_by_contract_type(art_50_i_advantageous_winding_up),
ground_limited_by_contract_type(art_50_j_design_contest),

# =====================================================================
# 1. DROPPING EACH INPUT, one at a time, from every lawful fixture.
# =====================================================================

test("there are twelve lawful fixtures to start from") <- (
    findall(SUBJECT, lawful_subject(SUBJECT), SUBJECTS),
    length(SUBJECTS, 12)
)

# NOTES.md section 1: with no pleaded ground there is no verdict.
test("dropping the pleaded ground gives no verdict, for every lawful fixture") <- (
    findall(SUBJECT,
        (lawful_subject(SUBJECT), fixture(SUBJECT, PROFILE),
         dict_remove(pleaded_ground_key, PROFILE, REDUCED),
         not gives_no_verdict(REDUCED)),
        OFFENDERS),
    OFFENDERS is []
)

# NOTES.md section 2: an absent condition flag counts as not established, so
# the ground fails and the use is unlawful. Every key of every lawful fixture
# other than the three selector keys is a condition flag.
test("default: dropping any condition flag from a lawful fixture gives use_unlawful") <- (
    # guard against a vacuous pass: the 12 lawful fixtures carry 26 condition flags
    findall(SUBJECT - KEY,
        (lawful_subject(SUBJECT), fixture(SUBJECT, PROFILE),
         dict_keys(PROFILE, KEYS),
         KEY in KEYS,
         not (KEY in [pleaded_ground_key, contract_type_key, sole_operator_reason_key])),
        EXAMINED),
    length(EXAMINED, EXAMINED_COUNT),
    EXAMINED_COUNT > 20,
    findall(SUBJECT - KEY,
        (lawful_subject(SUBJECT), fixture(SUBJECT, PROFILE),
         dict_keys(PROFILE, KEYS),
         KEY in KEYS,
         not (KEY in [pleaded_ground_key, contract_type_key, sole_operator_reason_key]),
         dict_remove(KEY, PROFILE, REDUCED),
         not gives_only_use_unlawful(REDUCED)),
        OFFENDERS),
    OFFENDERS is []
)

# NOTES.md section 3: for grounds (e)-(j) the contract type is a condition, so
# its absence is "not established" and the use is unlawful.
test("default: dropping the contract type gives use_unlawful where the ground is limited by type") <- (
    findall(SUBJECT,
        (lawful_subject(SUBJECT), fixture(SUBJECT, PROFILE),
         get(PROFILE, pleaded_ground_key, GROUND),
         ground_limited_by_contract_type(GROUND),
         dict_remove(contract_type_key, PROFILE, REDUCED),
         not gives_only_use_unlawful(REDUCED)),
        OFFENDERS),
    OFFENDERS is []
)

# NOTES.md section 3: "Grounds (a) to (d) apply to any contract type", so the
# contract type is not an input of theirs and dropping it changes nothing.
test("dropping the contract type leaves grounds (a) to (d) lawful") <- (
    findall(SUBJECT,
        (lawful_subject(SUBJECT), fixture(SUBJECT, PROFILE),
         get(PROFILE, pleaded_ground_key, GROUND),
         not ground_limited_by_contract_type(GROUND),
         dict_remove(contract_type_key, PROFILE, REDUCED),
         not gives_only_use_lawful(REDUCED)),
        OFFENDERS),
    OFFENDERS is []
)

# NOTES.md section 4(c): "With no reason given ... the ground fails."
test("default: dropping the sole operator reason gives use_unlawful") <- (
    findall(SUBJECT,
        (lawful_subject(SUBJECT), fixture(SUBJECT, PROFILE),
         get(PROFILE, pleaded_ground_key, art_50_c_sole_operator),
         dict_remove(sole_operator_reason_key, PROFILE, REDUCED),
         not gives_only_use_unlawful(REDUCED)),
        OFFENDERS),
    OFFENDERS is []
)

# =====================================================================
# 2. WRONG TYPES for each input.
# =====================================================================

# ---- pleaded ground: a non-atom is malformed and refused (ruling
#      D80); an atom outside the ten is use_unlawful (NOTES.md 1) ----------
test("pleaded ground spelled as a character list gives no verdict") <- (
    fixture("a_lawful", PROFILE),
    gives_no_verdict({**PROFILE, pleaded_ground_key: "art_50_a_no_suitable_tenders"})
)
test("pleaded ground given as a number gives no verdict") <- (
    fixture("a_lawful", PROFILE),
    gives_no_verdict({**PROFILE, pleaded_ground_key: 50})
)
test("pleaded ground given as a list gives no verdict") <- (
    fixture("a_lawful", PROFILE),
    gives_no_verdict({**PROFILE, pleaded_ground_key: [art_50_a_no_suitable_tenders]})
)
test("pleaded ground outside the ten gives use_unlawful") <- (
    fixture("a_lawful", PROFILE),
    gives_only_use_unlawful({**PROFILE, pleaded_ground_key: not_a_ground})
)

# An unbound pleaded ground is not a ground. The lawful clauses read it with
# get(PROFILE, pleaded_ground_key, <ground>) (rule file lines 149-199), which
# BINDS the variable to each ground in turn, so a profile that pleads nothing
# is decided as though it pleaded whichever ground its flags satisfy.
test("unbound pleaded ground gives no verdict instead of being solved to a lawful ground") <- (
    fixture("a_lawful", PROFILE),
    gives_no_verdict({**PROFILE, pleaded_ground_key: _})
)

# ---- contract type: a malformed value is refused, not read as "not
#      established" (ruling D80: the burden-of-proof default of
#      NOTES.md section 2 covers an ABSENT fact only) ---------------------
test("contract type spelled as a character list gives no verdict for ground (e)") <- (
    fixture("e_lawful", PROFILE),
    gives_no_verdict({**PROFILE, contract_type_key: "supplies"})
)
test("contract type given as a number gives no verdict for ground (e)") <- (
    fixture("e_lawful", PROFILE),
    gives_no_verdict({**PROFILE, contract_type_key: 1})
)
test("contract type given as a list gives no verdict for ground (e)") <- (
    fixture("e_lawful", PROFILE),
    gives_no_verdict({**PROFILE, contract_type_key: [supplies]})
)

# An unbound contract type: type_status/3 reads it with
# profile_get(PROFILE, contract_type_key, supplies) (rule file lines 31-50),
# which binds the variable to supplies and finds the type gate met.
test("unbound contract type gives no verdict instead of satisfying the supplies-only gate of ground (e)") <- (
    fixture("e_lawful", PROFILE),
    gives_no_verdict({**PROFILE, contract_type_key: _})
)
# Ground (f) has TWO met clauses for the type gate (works, services; rule file
# lines 33-34); an unbound type satisfies both.
test("unbound contract type gives no verdict instead of satisfying the works-or-services gate of ground (f)") <- (
    fixture("f_lawful", PROFILE),
    gives_no_verdict({**PROFILE, contract_type_key: _})
)

# ---- condition flags: a present value other than true or false is
#      refused (ruling D80); only an ABSENT flag reads as not
#      established (NOTES.md section 2) --------------------------------------
test("condition flag given as the number 1 gives no verdict") <- (
    fixture("a_lawful", PROFILE),
    gives_no_verdict({**PROFILE, initial_conditions_not_substantially_altered: 1})
)
test("condition flag given as an atom other than true gives no verdict") <- (
    fixture("a_lawful", PROFILE),
    gives_no_verdict({**PROFILE, initial_conditions_not_substantially_altered: yes})
)
test("condition flag spelled as a character list gives no verdict") <- (
    fixture("a_lawful", PROFILE),
    gives_no_verdict({**PROFILE, initial_conditions_not_substantially_altered: "true"})
)
test("condition flag given as a list gives no verdict") <- (
    fixture("a_lawful", PROFILE),
    gives_no_verdict({**PROFILE, initial_conditions_not_substantially_altered: [true]})
)

# An unbound flag: condition_status/3 reads it with
# profile_get(PROFILE, KEY, true) (rule file line 22), which binds the
# variable to true and finds the condition established.
test("unbound condition flag gives no verdict instead of reading as established") <- (
    fixture("a_lawful", PROFILE),
    gives_no_verdict({**PROFILE, initial_conditions_not_substantially_altered: _})
)
test("all condition flags unbound give no verdict instead of a lawful use") <- (
    gives_no_verdict({
        pleaded_ground_key: art_50_f_repetition,
        contract_type_key: services,
        repetition_conforms_to_basic_project: _,
        original_contract_followed_article_44_1_procedure: _,
        basic_project_indicated_extent_and_conditions: _,
        possible_use_of_this_procedure_disclosed_at_first_tender: _
    })
)

# ---- sole operator reason: a non-atom is refused (ruling D80); an
#      atom outside the three makes the ground fail (NOTES.md section 4(c)),
#      tested in section 5 below --------------------------------------------
test("sole operator reason spelled as a character list gives no verdict") <- (
    fixture("c_art_lawful", PROFILE),
    gives_no_verdict({**PROFILE, sole_operator_reason_key: "unique_artistic_work_or_performance"})
)
test("sole operator reason given as a number gives no verdict") <- (
    fixture("c_art_lawful", PROFILE),
    gives_no_verdict({**PROFILE, sole_operator_reason_key: 3})
)
# An unbound reason: ground_status/3 for (c) reads it with profile_get against
# each of the three reasons (rule file lines 66, 73, 83), binding it.
test("unbound sole operator reason gives no verdict instead of being solved to a reason") <- (
    fixture("c_art_lawful", PROFILE),
    gives_no_verdict({**PROFILE, sole_operator_reason_key: _})
)

# ---- the profile itself is not a dict ---------------------------------
test("a profile that is not a dict gives no definite verdict") <- (
    decision_outcome(not_a_profile, OUTCOME),
    not (OUTCOME is answers([_, *_]))
)

# =====================================================================
# 3. THE EMPTY PROFILE: no pleaded ground, so no verdict (NOTES.md 1).
# =====================================================================
test("empty profile gives no verdict and raises nothing") <- (
    gives_no_verdict({})
)

# =====================================================================
# 4. EXACTLY ONE ANSWER for every registered fixture profile.
# =====================================================================
test("every fixture profile yields exactly one verdict") <- (
    findall(SUBJECT, utilities_negotiated_without_prior_call_subject(SUBJECT), SUBJECTS),
    length(SUBJECTS, 24),
    findall(SUBJECT,
        (utilities_negotiated_without_prior_call_subject(SUBJECT),
         fixture(SUBJECT, PROFILE),
         findall(VERDICT, decide_utilities_negotiated_without_prior_call(PROFILE, VERDICT), VERDICTS),
         not length(VERDICTS, 1)),
        OFFENDERS),
    OFFENDERS is []
)

# =====================================================================
# 5. THE INPUT CHECK (ruling D80): a present key with the wrong
#    type is refused (no verdict), and
#    utilities_negotiated_without_prior_call_input_problem/2 names it.
# =====================================================================
problem_is(PROFILE, EXPECTED_PROBLEM) <- (
    findall(PROBLEM, utilities_negotiated_without_prior_call_input_problem(PROFILE, PROBLEM), [EXPECTED_PROBLEM]),
    gives_no_verdict(PROFILE)
)

test("input check finds no problem on any registered fixture") <- (
    findall(SUBJECT,
        (utilities_negotiated_without_prior_call_subject(SUBJECT),
         fixture(SUBJECT, PROFILE),
         utilities_negotiated_without_prior_call_input_problem(PROFILE, _)),
        OFFENDERS),
    OFFENDERS is []
)
test("refused: an unbound value is reported as not_ground") <- (
    fixture("a_lawful", PROFILE),
    problem_is({**PROFILE, initial_conditions_not_substantially_altered: _}, not_ground)
)
test("refused: a profile that is not a dict") <- (
    problem_is(not_a_profile, not_a_dict)
)
test("refused: the empty profile is reported as missing the pleaded ground") <- (
    problem_is({}, missing_key(pleaded_ground_key))
)
test("refused: a pleaded ground given as a number") <- (
    fixture("a_lawful", PROFILE),
    problem_is({**PROFILE, pleaded_ground_key: 50}, wrong_type(pleaded_ground_key, expected_atom))
)
test("refused: a pleaded ground spelled as a character list") <- (
    fixture("a_lawful", PROFILE),
    problem_is({**PROFILE, pleaded_ground_key: "art_50_a_no_suitable_tenders"}, wrong_type(pleaded_ground_key, expected_atom))
)
test("refused: a contract type given as a list") <- (
    fixture("e_lawful", PROFILE),
    problem_is({**PROFILE, contract_type_key: [supplies]}, wrong_type(contract_type_key, expected_atom))
)
test("refused: a contract type that is not works, supplies or services") <- (
    fixture("e_lawful", PROFILE),
    problem_is({**PROFILE, contract_type_key: not_a_contract_type}, wrong_value(contract_type_key, expected_contract_type))
)
test("refused: a sole operator reason given as a number") <- (
    fixture("c_art_lawful", PROFILE),
    problem_is({**PROFILE, sole_operator_reason_key: 3}, wrong_type(sole_operator_reason_key, expected_atom))
)
test("refused: a condition flag given as the number 1") <- (
    fixture("a_lawful", PROFILE),
    problem_is({**PROFILE, initial_conditions_not_substantially_altered: 1},
        wrong_type(initial_conditions_not_substantially_altered, expected_boolean))
)
test("refused: a condition flag given as an atom other than true or false") <- (
    fixture("a_lawful", PROFILE),
    problem_is({**PROFILE, initial_conditions_not_substantially_altered: yes},
        wrong_type(initial_conditions_not_substantially_altered, expected_boolean))
)
test("refused: a condition flag spelled as a character list") <- (
    fixture("a_lawful", PROFILE),
    problem_is({**PROFILE, initial_conditions_not_substantially_altered: "true"},
        wrong_type(initial_conditions_not_substantially_altered, expected_boolean))
)
test("documented: a sole operator reason that is an atom outside the three is not refused and the use is unlawful") <- (
    fixture("c_art_lawful", PROFILE),
    REFERRED is {**PROFILE, sole_operator_reason_key: not_a_ground},
    not utilities_negotiated_without_prior_call_input_problem(REFERRED, _),
    gives_only_use_unlawful(REFERRED)
)
test("status, checklist, unmet count and what-if give no answer on a refused profile") <- (
    fixture("a_lawful", PROFILE),
    REFUSED is {**PROFILE, initial_conditions_not_substantially_altered: 1},
    not utilities_negotiated_without_prior_call_status(REFUSED, _),
    not utilities_negotiated_without_prior_call_checklist(REFUSED, _),
    not utilities_negotiated_without_prior_call_unmet_count(REFUSED, _),
    not utilities_negotiated_without_prior_call_what_if(REFUSED, no_suitable_tenders_or_requests_received, true, _)
)
test("what-if can still correct the refused key it overrides") <- (
    fixture("a_lawful", PROFILE),
    REFUSED is {**PROFILE, initial_conditions_not_substantially_altered: 1},
    utilities_negotiated_without_prior_call_what_if(REFUSED, initial_conditions_not_substantially_altered, true, use_lawful)
)
