# =====================================================================
# kernel.clausal -- the SHARED FLOOR for eu/procurement/utilities_negotiated_without_prior_call (eligibility family).
# DAG root of the determination-slices layout. It holds ONLY what more than
# one file needs: the result CONSTRUCTORS, the pinned verdict vocabulary,
# and the profile KEY atoms / checklist row ids shared across the slices.
# Atoms + constructors ONLY -- no rules, no facts.
#
# Source: Directive 2014/25/EU, Art 50 (negotiated procedure without prior
# call for competition in the water, energy, transport and postal sectors).
# =====================================================================

-module(kernel, [
    # result constructor -- the 3-arg verdict term (STATUS, GROUND, CITATIONS)
    utilities_negotiated_verdict(STATUS, GROUND, CITATIONS),
    # terminal verdict vocabulary
    use_lawful,
    use_unlawful,
    n_a,
    # scaffold placeholders (additive-vocabulary rule: keep until importers retire them)
    utilities_negotiated_without_prior_call_verdict(STATUS, CITATIONS),
    eligible,
    ineligible,
    overall,
    as_of_date])
-double_quotes(chars)
