# citations.clausal -- machine-readable citation registry for this domain.
# Generated by _tools/scaffold_citations.py; ref/verbatim populated by the
# citation sourcing pass (verified against authoritative sources; see
# citations-sources.yaml). Regenerate structure; hand-edit only ref/verbatim.
#
# Owns cite/1 (the in-clause citation wrapper) and citation/2 (the
# explainability lookup: cite(C) in a decision resolves to citation(C, Meta)).
# English verbatim is the default-language rendition; other languages go in a
# per-domain translation/<lang>.clausal subpackage -- the translation/2 functor
# carries {verbatim, ref}, namespace-derived, load-on-demand -- NOT here.


-module(citations, [cite(C), implements(C), citation(ATOM, META), eu_dir_2014_25_art_50_a, eu_dir_2014_25_art_50_b, eu_dir_2014_25_art_50_c, eu_dir_2014_25_art_50_c_i, eu_dir_2014_25_art_50_c_ii, eu_dir_2014_25_art_50_c_iii, eu_dir_2014_25_art_50_c_proviso, eu_dir_2014_25_art_50_chapeau, eu_dir_2014_25_art_50_d, eu_dir_2014_25_art_50_e, eu_dir_2014_25_art_50_f, eu_dir_2014_25_art_50_g, eu_dir_2014_25_art_50_h, eu_dir_2014_25_art_50_i, eu_dir_2014_25_art_50_j])
-double_quotes(chars)
-private([label, ref, units, verbatim])

-strict_atoms

citation(eu_dir_2014_25_art_50_a, {
  label:    "Directive 2014/25/EU, Art 50(a) -- no or no suitable tenders or requests, initial conditions not substantially altered",
  ref:      "http://publications.europa.eu/resource/celex/02014L0025-20260101.ENG.fmx4",
  verbatim: "(a) where no tenders or no suitable tenders or no requests to participate or no suitable requests to participate have been submitted in response to a procedure with a prior call for competition, provided that the initial conditions of the contract are not substantially altered; A tender shall be considered not to be suitable where it is irrelevant to the contract, being manifestly incapable, without substantial changes, of meeting the contracting entity’s needs and requirements as specified in the procurement documents. A request for participation shall be considered not to be suitable where the economic operator concerned is to be or may be excluded pursuant to Articles 78(1) or 80(1), or does not meet the selection criteria laid down by the contracting entity pursuant to Articles 78 or 80;"
}),

citation(eu_dir_2014_25_art_50_b, {
  units:    ["02014L0025-20260101#point_050_b"],
  label:    "Directive 2014/25/EU, Art 50(b) -- contract purely for research, experiment, study or development",
  ref:      "http://publications.europa.eu/resource/celex/02014L0025-20260101.ENG.fmx4",
  verbatim: "(b) where a contract is purely for the purpose of research, experiment, study or development, and not for the purpose of securing a profit or of recovering research and development costs, and insofar as the award of such contract does not prejudice the competitive award of subsequent contracts which do seek, in particular, those ends;"
}),

citation(eu_dir_2014_25_art_50_c, {
  units:    ["02014L0025-20260101#point_050_c/1"],
  label:    "Directive 2014/25/EU, Art 50(c) -- the works, supplies or services can be supplied only by a particular economic operator",
  ref:      "http://publications.europa.eu/resource/celex/02014L0025-20260101.ENG.fmx4",
  verbatim: "(c) where the works, supplies or services can be supplied only by a particular economic operator for any of the following reasons:"
}),

citation(eu_dir_2014_25_art_50_c_i, {
  units:    ["02014L0025-20260101#point_050_c_i"],
  label:    "Directive 2014/25/EU, Art 50(c)(i) -- sole-operator reason",
  ref:      "http://publications.europa.eu/resource/celex/02014L0025-20260101.ENG.fmx4",
  verbatim: "(i) the aim of the procurement is the creation or acquisition of a unique work of art or artistic performance;"
}),

citation(eu_dir_2014_25_art_50_c_ii, {
  units:    ["02014L0025-20260101#point_050_c_ii"],
  label:    "Directive 2014/25/EU, Art 50(c)(ii) -- sole-operator reason",
  ref:      "http://publications.europa.eu/resource/celex/02014L0025-20260101.ENG.fmx4",
  verbatim: "(ii) competition is absent for technical reasons;"
}),

citation(eu_dir_2014_25_art_50_c_iii, {
  units:    ["02014L0025-20260101#point_050_c_iii"],
  label:    "Directive 2014/25/EU, Art 50(c)(iii) -- sole-operator reason",
  ref:      "http://publications.europa.eu/resource/celex/02014L0025-20260101.ENG.fmx4",
  verbatim: "(iii) the protection of exclusive rights, including intellectual property rights."
}),

citation(eu_dir_2014_25_art_50_c_proviso, {
  units:    ["02014L0025-20260101#point_050_c/2"],
  label:    "Directive 2014/25/EU, Art 50(c) proviso -- applies to points (ii) and (iii) ONLY",
  ref:      "http://publications.europa.eu/resource/celex/02014L0025-20260101.ENG.fmx4",
  verbatim: "The exceptions set out in points (ii) and (iii) shall only apply when no reasonable alternative or substitute exists and the absence of competition is not the result of an artificial narrowing down of the parameters of the procurement;"
}),

citation(eu_dir_2014_25_art_50_chapeau, {
  label:    "Directive 2014/25/EU, Art 50 chapeau -- the exhaustive gateway",
  ref:      "http://publications.europa.eu/resource/celex/02014L0025-20260101.ENG.fmx4",
  verbatim: "Contracting entities may use a negotiated procedure without prior call for competition in the following cases:"
}),

citation(eu_dir_2014_25_art_50_d, {
  units:    ["02014L0025-20260101#point_050_d"],
  label:    "Directive 2014/25/EU, Art 50(d) -- extreme urgency brought about by unforeseeable events",
  ref:      "http://publications.europa.eu/resource/celex/02014L0025-20260101.ENG.fmx4",
  verbatim: "(d) in so far as is strictly necessary where, for reasons of extreme urgency brought about by events unforeseeable by the contracting entity, the time limits laid down for open procedures, restricted procedures and negotiated procedures with prior call for competition cannot be complied with. The circumstances invoked to justify extreme urgency shall not in any event be attributable to the contracting entity;"
}),

citation(eu_dir_2014_25_art_50_e, {
  units:    ["02014L0025-20260101#point_050_e"],
  label:    "Directive 2014/25/EU, Art 50(e) -- supply contracts, additional deliveries by the original supplier",
  ref:      "http://publications.europa.eu/resource/celex/02014L0025-20260101.ENG.fmx4",
  verbatim: "(e) in the case of supply contracts for additional deliveries by the original supplier which are intended either as a partial replacement of supplies or installations or as the extension of existing supplies or installations, where a change of supplier would oblige the contracting entity to acquire supplies having different technical characteristics which would result in incompatibility or disproportionate technical difficulties in operation and maintenance;"
}),

citation(eu_dir_2014_25_art_50_f, {
  label:    "Directive 2014/25/EU, Art 50(f) -- repetition of similar works or services conforming to a basic project",
  ref:      "http://publications.europa.eu/resource/celex/02014L0025-20260101.ENG.fmx4",
  verbatim: "(f) for new works or services consisting in the repetition of similar works or services assigned to the contractor to which the same contracting entities awarded an earlier contract, provided that such works or services conform to a basic project for which a first contract was awarded according to a procedure in accordance with Article 44(1). The basic project shall indicate the extent of possible additional works or services and the conditions under which they will be awarded. As soon as the first project is put up for tender, the possible use of this procedure shall be disclosed and the total estimated cost of subsequent works or services shall be taken into consideration by the contracting entities when they apply Articles 15 and 16;"
}),

citation(eu_dir_2014_25_art_50_g, {
  units:    ["02014L0025-20260101#point_050_g"],
  label:    "Directive 2014/25/EU, Art 50(g) -- supplies quoted and purchased on a commodity market",
  ref:      "http://publications.europa.eu/resource/celex/02014L0025-20260101.ENG.fmx4",
  verbatim: "(g) for supplies quoted and purchased on a commodity market;"
}),

citation(eu_dir_2014_25_art_50_h, {
  units:    ["02014L0025-20260101#point_050_h"],
  label:    "Directive 2014/25/EU, Art 50(h) -- bargain purchases",
  ref:      "http://publications.europa.eu/resource/celex/02014L0025-20260101.ENG.fmx4",
  verbatim: "(h) for bargain purchases, where it is possible to procure supplies by taking advantage of a particularly advantageous opportunity available for a very short time at a price considerably lower than normal market prices;"
}),

citation(eu_dir_2014_25_art_50_i, {
  units:    ["02014L0025-20260101#point_050_i"],
  label:    "Directive 2014/25/EU, Art 50(i) -- particularly advantageous conditions from a winding-up supplier or liquidator",
  ref:      "http://publications.europa.eu/resource/celex/02014L0025-20260101.ENG.fmx4",
  verbatim: "(i) for purchases of supplies or services under particularly advantageous conditions from either a supplier which is definitively winding up its business activities or the liquidator in an insolvency procedure, an arrangement with creditors or a similar procedure under national laws or regulations;"
}),

citation(eu_dir_2014_25_art_50_j, {
  label:    "Directive 2014/25/EU, Art 50(j) -- service contract following a design contest",
  ref:      "http://publications.europa.eu/resource/celex/02014L0025-20260101.ENG.fmx4",
  verbatim: "(j) where the service contract concerned follows a design contest organised in accordance with this Directive and is to be awarded, under the rules provided for in the design contest, to the winner or to one of the winners of that contest; in the latter case, all the winners shall be invited to participate in the negotiations."
}),

# implements/1 -- the in-clause provenance marker (convention 2026-08-28).
# DEFINED, not merely declared: an exported predicate with no clause has
# no compiled dispatch function and RAISES when called.
implements(KEY) <- (
    citation(KEY, _)
),
