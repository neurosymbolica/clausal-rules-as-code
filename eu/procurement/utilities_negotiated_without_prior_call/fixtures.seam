utilities_negotiated_without_prior_call_profile_for("c_rights_lawful", {
    pleaded_ground_key: art_50_c_sole_operator,
    contract_type_key: works,
    sole_operator_reason_key: protection_of_exclusive_rights,
    only_particular_operator_can_perform: true,
    no_reasonable_alternative_or_substitute: true,
    absence_of_competition_not_artificially_narrowed: true
}),

utilities_negotiated_without_prior_call_profile_for("c_rights_near_miss", {
    pleaded_ground_key: art_50_c_sole_operator,
    contract_type_key: works,
    sole_operator_reason_key: protection_of_exclusive_rights,
    only_particular_operator_can_perform: true,
    no_reasonable_alternative_or_substitute: false,
    absence_of_competition_not_artificially_narrowed: true
}),

# ---- Profiles: ground (d) extreme urgency ----------------------------

utilities_negotiated_without_prior_call_profile_for("d_lawful", {
    pleaded_ground_key: art_50_d_extreme_urgency,
    contract_type_key: services,
    extreme_urgency_time_limits_cannot_be_met: true,
    urgency_events_unforeseeable_by_contracting_entity: true,
    urgency_not_attributable_to_contracting_entity: true
}),

utilities_negotiated_without_prior_call_profile_for("d_near_miss", {
    pleaded_ground_key: art_50_d_extreme_urgency,
    contract_type_key: services,
    extreme_urgency_time_limits_cannot_be_met: true,
    urgency_events_unforeseeable_by_contracting_entity: true,
    urgency_not_attributable_to_contracting_entity: false
}),

# ---- Profiles: ground (e) additional deliveries (supplies only) ------

utilities_negotiated_without_prior_call_profile_for("e_lawful", {
    pleaded_ground_key: art_50_e_additional_deliveries,
    contract_type_key: supplies,
    additional_deliveries_by_original_supplier: true,
    change_of_supplier_would_cause_technical_incompatibility: true
}),

utilities_negotiated_without_prior_call_profile_for("e_near_miss", {
    pleaded_ground_key: art_50_e_additional_deliveries,
    contract_type_key: works,
    additional_deliveries_by_original_supplier: true,
    change_of_supplier_would_cause_technical_incompatibility: true
}),

# ---- Profiles: ground (f) repetition (works or services) -------------

utilities_negotiated_without_prior_call_profile_for("f_lawful", {
    pleaded_ground_key: art_50_f_repetition,
    contract_type_key: services,
    repetition_conforms_to_basic_project: true,
    original_contract_followed_article_44_1_procedure: true,
    basic_project_indicated_extent_and_conditions: true,
    possible_use_of_this_procedure_disclosed_at_first_tender: true
}),

utilities_negotiated_without_prior_call_profile_for("f_near_miss", {
    pleaded_ground_key: art_50_f_repetition,
    contract_type_key: supplies,
    repetition_conforms_to_basic_project: true,
    original_contract_followed_article_44_1_procedure: true,
    basic_project_indicated_extent_and_conditions: true,
    possible_use_of_this_procedure_disclosed_at_first_tender: true
}),

# ---- Profiles: ground (g) commodity market (supplies only) -----------

utilities_negotiated_without_prior_call_profile_for("g_lawful", {
    pleaded_ground_key: art_50_g_commodity_market,
    contract_type_key: supplies,
    supplies_quoted_and_purchased_on_commodity_market: true
}),

utilities_negotiated_without_prior_call_profile_for("g_near_miss", {
    pleaded_ground_key: art_50_g_commodity_market,
    contract_type_key: services,
    supplies_quoted_and_purchased_on_commodity_market: true
}),

# ---- Profiles: ground (h) bargain purchase (supplies only) ----------

utilities_negotiated_without_prior_call_profile_for("h_lawful", {
    pleaded_ground_key: art_50_h_bargain_purchase,
    contract_type_key: supplies,
    bargain_opportunity_available_for_very_short_time: true,
    price_considerably_lower_than_normal_market_prices: true
}),

utilities_negotiated_without_prior_call_profile_for("h_near_miss", {
    pleaded_ground_key: art_50_h_bargain_purchase,
    contract_type_key: supplies,
    bargain_opportunity_available_for_very_short_time: true,
    price_considerably_lower_than_normal_market_prices: false
}),

# ---- Profiles: ground (i) advantageous winding up (supplies or svc) -

utilities_negotiated_without_prior_call_profile_for("i_lawful", {
    pleaded_ground_key: art_50_i_advantageous_winding_up,
    contract_type_key: services,
    particularly_advantageous_conditions_from_winding_up_or_liquidator: true,
    supplier_winding_up_or_in_insolvency_procedure: true
}),

utilities_negotiated_without_prior_call_profile_for("i_near_miss", {
    pleaded_ground_key: art_50_i_advantageous_winding_up,
    contract_type_key: works,
    particularly_advantageous_conditions_from_winding_up_or_liquidator: true,
    supplier_winding_up_or_in_insolvency_procedure: true
}),

# ---- Profiles: ground (j) design contest (services only) ------------

utilities_negotiated_without_prior_call_profile_for("j_lawful", {
    pleaded_ground_key: art_50_j_design_contest,
    contract_type_key: services,
    contract_follows_directive_design_contest: true,
    awarded_to_contest_winner_or_all_winners_invited: true
}),

utilities_negotiated_without_prior_call_profile_for("j_near_miss", {
    pleaded_ground_key: art_50_j_design_contest,
    contract_type_key: supplies,
    contract_follows_directive_design_contest: true,
    awarded_to_contest_winner_or_all_winners_invited: true
}),

# ---- Convenience wrapper --------------------------------------------

utilities_negotiated_without_prior_call_assess(SUBJECT, RESULT) <- (
    utilities_negotiated_without_prior_call_profile_for(SUBJECT, PROFILE),
    decide_utilities_negotiated_without_prior_call(PROFILE, RESULT)
)
