# =====================================================================
# fixtures.clausal -- representative profiles for eu/procurement/utilities_negotiated_without_prior_call.
# A TOP-LAYER consumer: imports the determination slice's PUBLICS and
# the key atoms spelled in profile dicts.
#
# For every ground route: one positive (all conditions met -> use_lawful)
# and one near-miss (one condition flipped or type-gate violated -> use_unlawful).
# =====================================================================

-module(fixtures, [
    utilities_negotiated_without_prior_call_subject(SUBJECT),
    utilities_negotiated_without_prior_call_profile_for(SUBJECT, PROFILE),
    utilities_negotiated_without_prior_call_assess(SUBJECT, RESULT)
])
-double_quotes(chars)

-import_from(eu.procurement.directive_2014_24.vocabulary, [works, supplies, services])
-import_from(eu.procurement.utilities_negotiated_without_prior_call.utilities_negotiated_without_prior_call, [
    decide_utilities_negotiated_without_prior_call,
    pleaded_ground_key,
    contract_type_key,
    sole_operator_reason_key,
    art_50_a_no_suitable_tenders,
    art_50_b_research_contract,
    art_50_c_sole_operator,
    art_50_d_extreme_urgency,
    art_50_e_additional_deliveries,
    art_50_f_repetition,
    art_50_g_commodity_market,
    art_50_h_bargain_purchase,
    art_50_i_advantageous_winding_up,
    art_50_j_design_contest,
    unique_artistic_work_or_performance,
    competition_absent_for_technical_reasons,
    protection_of_exclusive_rights,
    no_suitable_tenders_or_requests_received,
    initial_conditions_not_substantially_altered,
    contract_purely_for_research_experiment_study_or_development,
    not_for_securing_profit_or_recovering_research_costs,
    award_does_not_prejudice_competitive_award_of_subsequent_contracts,
    only_particular_operator_can_perform,
    no_reasonable_alternative_or_substitute,
    absence_of_competition_not_artificially_narrowed,
    extreme_urgency_time_limits_cannot_be_met,
    urgency_events_unforeseeable_by_contracting_entity,
    urgency_not_attributable_to_contracting_entity,
    additional_deliveries_by_original_supplier,
    change_of_supplier_would_cause_technical_incompatibility,
    repetition_conforms_to_basic_project,
    original_contract_followed_article_44_1_procedure,
    basic_project_indicated_extent_and_conditions,
    possible_use_of_this_procedure_disclosed_at_first_tender,
    supplies_quoted_and_purchased_on_commodity_market,
    bargain_opportunity_available_for_very_short_time,
    price_considerably_lower_than_normal_market_prices,
    particularly_advantageous_conditions_from_winding_up_or_liquidator,
    supplier_winding_up_or_in_insolvency_procedure,
    contract_follows_directive_design_contest,
    awarded_to_contest_winner_or_all_winners_invited
])

# ---- Subject registry ------------------------------------------------

utilities_negotiated_without_prior_call_subject("a_lawful"),
utilities_negotiated_without_prior_call_subject("a_near_miss"),
utilities_negotiated_without_prior_call_subject("b_lawful"),
utilities_negotiated_without_prior_call_subject("b_near_miss"),
utilities_negotiated_without_prior_call_subject("c_art_lawful"),
utilities_negotiated_without_prior_call_subject("c_art_near_miss"),
utilities_negotiated_without_prior_call_subject("c_tech_lawful"),
utilities_negotiated_without_prior_call_subject("c_tech_near_miss"),
utilities_negotiated_without_prior_call_subject("c_rights_lawful"),
utilities_negotiated_without_prior_call_subject("c_rights_near_miss"),
utilities_negotiated_without_prior_call_subject("d_lawful"),
utilities_negotiated_without_prior_call_subject("d_near_miss"),
utilities_negotiated_without_prior_call_subject("e_lawful"),
utilities_negotiated_without_prior_call_subject("e_near_miss"),
utilities_negotiated_without_prior_call_subject("f_lawful"),
utilities_negotiated_without_prior_call_subject("f_near_miss"),
utilities_negotiated_without_prior_call_subject("g_lawful"),
utilities_negotiated_without_prior_call_subject("g_near_miss"),
utilities_negotiated_without_prior_call_subject("h_lawful"),
utilities_negotiated_without_prior_call_subject("h_near_miss"),
utilities_negotiated_without_prior_call_subject("i_lawful"),
utilities_negotiated_without_prior_call_subject("i_near_miss"),
utilities_negotiated_without_prior_call_subject("j_lawful"),
utilities_negotiated_without_prior_call_subject("j_near_miss"),

# ---- Profiles: ground (a) no suitable tenders -------------------------

utilities_negotiated_without_prior_call_profile_for("a_lawful", {
    pleaded_ground_key: art_50_a_no_suitable_tenders,
    contract_type_key: services,
    no_suitable_tenders_or_requests_received: true,
    initial_conditions_not_substantially_altered: true
}),

utilities_negotiated_without_prior_call_profile_for("a_near_miss", {
    pleaded_ground_key: art_50_a_no_suitable_tenders,
    contract_type_key: services,
    no_suitable_tenders_or_requests_received: true,
    initial_conditions_not_substantially_altered: false
}),

# ---- Profiles: ground (b) research contract --------------------------

utilities_negotiated_without_prior_call_profile_for("b_lawful", {
    pleaded_ground_key: art_50_b_research_contract,
    contract_type_key: services,
    contract_purely_for_research_experiment_study_or_development: true,
    not_for_securing_profit_or_recovering_research_costs: true,
    award_does_not_prejudice_competitive_award_of_subsequent_contracts: true
}),

utilities_negotiated_without_prior_call_profile_for("b_near_miss", {
    pleaded_ground_key: art_50_b_research_contract,
    contract_type_key: services,
    contract_purely_for_research_experiment_study_or_development: true,
    not_for_securing_profit_or_recovering_research_costs: true,
    award_does_not_prejudice_competitive_award_of_subsequent_contracts: false
}),

# ---- Profiles: ground (c) sole operator -- unique art ----------------

utilities_negotiated_without_prior_call_profile_for("c_art_lawful", {
    pleaded_ground_key: art_50_c_sole_operator,
    contract_type_key: works,
    sole_operator_reason_key: unique_artistic_work_or_performance,
    only_particular_operator_can_perform: true
}),

utilities_negotiated_without_prior_call_profile_for("c_art_near_miss", {
    pleaded_ground_key: art_50_c_sole_operator,
    contract_type_key: works,
    sole_operator_reason_key: unique_artistic_work_or_performance,
    only_particular_operator_can_perform: false
}),

# ---- Profiles: ground (c) sole operator -- technical reasons ---------

utilities_negotiated_without_prior_call_profile_for("c_tech_lawful", {
    pleaded_ground_key: art_50_c_sole_operator,
    contract_type_key: works,
    sole_operator_reason_key: competition_absent_for_technical_reasons,
    only_particular_operator_can_perform: true,
    no_reasonable_alternative_or_substitute: true,
    absence_of_competition_not_artificially_narrowed: true
}),

utilities_negotiated_without_prior_call_profile_for("c_tech_near_miss", {
    pleaded_ground_key: art_50_c_sole_operator,
    contract_type_key: works,
    sole_operator_reason_key: competition_absent_for_technical_reasons,
