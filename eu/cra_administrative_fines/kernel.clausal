% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% kernel.clausal -- the SHARED FLOOR for eu/cra_administrative_fines (numeric family).
% DAG root of the determination-slices layout. It holds ONLY the
% PREDICATES that two or more files CALL.
% Exception: the scaffold writes the order's input check
% cra_administrative_fines_input_problems/2 here, exported, for every slice to import.
%
% Source: Regulation (EU) 2024/2847 (Cyber Resilience Act), pinned text of
% 32024R2847 (OJ L, 2024/2847, 20.11.2024; raw sha256
% fe0cca4a0caec50e7cf5a91432b94a19b211f86be8584fdba56372bdcea571ed):
% Art 64(1) to (4) and (10)(b), with Art 71(2) for the date of application.
% The input check and the calendar-day check below decide no statutory
% condition: they are plumbing for the typed input contract, so they carry
% no implements/1 marker (and the kernel, the DAG root, imports no citations).
%
% Shared predicates (each called by the slice and by queries/fixtures):
%   cra_administrative_fines_input_problems(Profile, Problems)
%       THE INPUT CHECK on the profile alone (scaffold, kept as written).
%   cra_administrative_fines_calendar_day_t(DateTerm, Truth)
%       Truth is true when DateTerm is a ground date(Year, Month, Day) of
%       bare integers naming a real calendar day (29 February only in a
%       leap year), false for anything else, an unbound term included.
%       It never fails and never raises; step (F0) of the query adds
%       wrong_type(infringement_date) when Truth is false.
%   cra_administrative_fines_contract_keys(Keys)
%       the four profile keys in root_exports / input_contract order.
%
% Result terms (atoms and data terms need NO declaration and NO import;
% this block only RECORDS their spelling so every file writes them alike):
%   administrative_fine_maximum(Profile, InfringementDate, Verdict, Citations)
%   Verdict is exactly one of:
%     fine_maximum(Tier, Basis, CapInEuroCents)   -- final answer
%         Tier:  highest_maximum_tier (Art 64(2)) | middle_maximum_tier
%                (Art 64(3)) | lowest_maximum_tier (Art 64(4))
%         Basis: fixed_amount | percentage_of_turnover |
%                fixed_amount_for_non_undertaking
%         CapInEuroCents: a non-negative integer of euro cents
%     fine_excluded(open_source_software_steward)  -- final answer
%     not_listed_in_article_64                     -- final answer (atom)
%     not_yet_applicable                           -- final answer (atom)
%     indeterminate([Key])                         -- status, one bare key
%     needs_legal_review(open_textured(Key, cite(CitationKey)),
%                        [inputs_relied_on(Pairs)])  -- status
%     input_problems(Problems)                     -- status; Problems a list
%         of duplicate_key(Key), wrong_type(Key), unknown_key(Key)
%   Citations: a set-like list of cite(Key) terms for a final answer, []
%   for every status.
%   The scaffold facade wraps the same pair as
%     cra_administrative_fines_verdict(Status, Citations)
%   Status being the Verdict above, Citations the list above.
% The bare atom indeterminate is never written.
% =====================================================================

:- module(kernel, [
    cra_administrative_fines_input_problems/2,
    cra_administrative_fines_calendar_day_t/2,
    cra_administrative_fines_contract_keys/1
]).

:- use_module(library(reif), [memberd_t/3]).
:- use_module(kit/deadline_lib, [month_last_day/3]).

% ---- input checks: the problems a profile has, if any -----------
% cra_administrative_fines_input_problems(Profile, Problems): Problems = [] means the profile can be
% judged. Written from the order's typed input contract
% (input_contract.types.profile: attribute_list).
% Each public query calls this check first: it gives its normal answer only when
% Problems = [], and when Problems is not [] it gives the answer the order states for
% a profile with input problems.
% It gives exactly one answer for every Profile, and the answer is ground except for a
% Key named as given:
% - a Profile that is not an attribute list [attribute(Key, Value), ...] gives [wrong_type(profile)]:
%   an unbound Profile, a partial list, a list holding an unbound item or an item that is
%   not attribute(_, _);
% - a Key that is not an atom (a number, a string, a compound term, an unbound variable)
%   is a key outside the contract: unknown_key(Key), Key as given;
% - otherwise, for each contract key in the contract's key order, duplicate_key(Key) when
%   the key occurs more than once in Profile (whatever its values: none of them is read,
%   so it is never also wrong_type(Key)), else wrong_type(Key) when its one value is
%   outside its type; then unknown_key(Key) for each key outside the contract, in the
%   order of its first occurrence in Profile. Each key is named once. An absent key is
%   not a problem.
% Every step is complementary clauses: exactly one clause holds for each input.
cra_administrative_fines_input_problems(Profile, Problems) :-
    attribute_list_t(Profile, IsAttributeList),
    profile_problems(IsAttributeList, Profile, Problems).

profile_problems(false, _, [wrong_type(profile)]).
profile_problems(true, Profile, Problems) :-
    Keys = [infringed_provision, offender_is_open_source_software_steward, offender_is_undertaking, total_worldwide_annual_turnover_in_euros],
    unknown_keys(Profile, Keys, UnknownKeyProblems),
    key_problems(Keys, Profile, UnknownKeyProblems, Problems).

% The contract: each key and the type of its value.
key_type(infringed_provision, provision).
key_type(offender_is_open_source_software_steward, judgement).
key_type(offender_is_undertaking, judgement).
key_type(total_worldwide_annual_turnover_in_euros, non_negative_integer).

% attribute_list_t(Term, T): T is true when Term is a list of attribute(Key, Value)
% items, whatever each Key is; false for anything else, an unbound Term or item included.
attribute_list_t(Term, false) :-
    var(Term).
attribute_list_t(Term, true) :-
    Term == [].
attribute_list_t(Term, T) :-
    nonvar(Term),
    Term = [Element|Elements],
    attribute_t(Element, ElementIsAttribute),
    attribute_list_t(Elements, ElementsAreAttributes),
    truth_and(ElementIsAttribute, ElementsAreAttributes, T).
attribute_list_t(Term, false) :-
    nonvar(Term),
    Term \== [],
    Term \= [_|_].

attribute_t(Element, false) :-
    var(Element).
attribute_t(Element, true) :-
    nonvar(Element),
    Element = attribute(_, _).
attribute_t(Element, false) :-
    nonvar(Element),
    Element \= attribute(_, _).

% Unknown keys, in profile order, each once: Known grows by each key named. A key is
% known when it is identical (==) to one in Known, so an unbound Key is never bound:
% the same variable twice is one unknown key, two different variables are two.
unknown_keys([], _, []).
unknown_keys([attribute(Key, _)|Elements], Known, Problems) :-
    known_t(Key, Known, IsKnown),
    name_unknown_key(IsKnown, Key, Known, Elements, Problems).

known_t(_, [], false).
known_t(Key, [Known|_], true) :-
    Known == Key.
known_t(Key, [Known|Knowns], T) :-
    Known \== Key,
    known_t(Key, Knowns, T).

name_unknown_key(true, _, Known, Elements, Problems) :-
    unknown_keys(Elements, Known, Problems).
name_unknown_key(false, Key, Known, Elements, [unknown_key(Key)|Problems]) :-
    unknown_keys(Elements, [Key|Known], Problems).

% Contract keys, in contract order: duplicate_key(Key) when the key occurs more than once
% (none of its values is read), else wrong_type(Key) when its one value is outside the
% key's type. An absent key has no value to check.
key_problems([], _, Problems, Problems).
key_problems([Key|Keys], Profile, LaterProblems, Problems) :-
    key_type(Key, Type),
    key_occurrences(Profile, Key, Occurrences),
    key_problems(Keys, Profile, LaterProblems, KeyProblems),
    name_key_problem(Occurrences, Key, Type, Profile, KeyProblems, Problems).

% key_occurrences(Elements, Key, Occurrences): none, one or many items give Key.
key_occurrences([], _, none).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey == Key,
    key_occurrences(Elements, Key, RestOccurrences),
    one_more_occurrence(RestOccurrences, Occurrences).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey \== Key,
    key_occurrences(Elements, Key, Occurrences).

one_more_occurrence(none, one).
one_more_occurrence(one, many).
one_more_occurrence(many, many).

name_key_problem(none, _, _, _, Problems, Problems).
name_key_problem(many, Key, _, _, Problems, [duplicate_key(Key)|Problems]).
name_key_problem(one, Key, Type, Profile, KeyProblems, Problems) :-
    values_in_type_t(Profile, Key, Type, InType),
    name_wrong_type(InType, Key, KeyProblems, Problems).

name_wrong_type(true, _, Problems, Problems).
name_wrong_type(false, Key, Problems, [wrong_type(Key)|Problems]).

% values_in_type_t(Elements, Key, Type, T): T is true when every value Elements gives Key is
% in Type (true when Elements gives Key none).
values_in_type_t([], _, _, true).
values_in_type_t([attribute(ElementKey, Value)|Elements], Key, Type, T) :-
    ElementKey == Key,
    value_in_type_t(Type, Value, ValueInType),
    values_in_type_t(Elements, Key, Type, RestInType),
    truth_and(ValueInType, RestInType, T).
values_in_type_t([attribute(ElementKey, _)|Elements], Key, Type, T) :-
    ElementKey \== Key,
    values_in_type_t(Elements, Key, Type, T).

% A value with an unbound part is outside every type; a ground one is checked.
value_in_type_t(Type, Value, T) :-
    term_variables(Value, Variables),
    ground_value_in_type_t(Variables, Type, Value, T).

ground_value_in_type_t([_|_], _, _, false).
ground_value_in_type_t([], Type, Value, T) :-
    in_type_t(Type, Value, T).

% in_type_t(Type, Value, T): one clause per type, for a ground Value.
in_type_t(provision, Value, T) :-
    in_type_t(enum([annex_i_essential_cybersecurity_requirements, article_13, article_14, article_18, article_19, article_20, article_21, article_22, article_23, article_28, article_30_paragraphs_1_to_4, article_31_paragraphs_1_to_4, article_32_paragraphs_1_to_3, article_33_paragraph_5, article_39, article_41, article_47, article_49, article_53, incorrect_incomplete_or_misleading_information_in_reply_to_request, other_provision]), Value, T).

in_type_t(judgement, Value, T) :-
    in_type_t(one_of([boolean, enum([unsure])]), Value, T).

in_type_t(boolean, Value, T) :-
    memberd_t(Value, [true, false], T).

in_type_t(enum(Values), Value, T) :-
    memberd_t(Value, Values, T).

in_type_t(one_of(Types), Value, T) :-
    in_some_type_t(Types, Value, T).

in_type_t(non_negative_integer, Value, T) :-
    non_negative_integer_t(Value, T).

truth_and(true, T, T).
truth_and(false, _, false).

% in_some_type_t(Types, Value, T): T is true when Value is in at least one of Types.
in_some_type_t([], _, false).
in_some_type_t([Type|Types], Value, T) :-
    in_type_t(Type, Value, InType),
    in_some_type_t(Types, Value, InAnother),
    truth_or(InType, InAnother, T).

truth_or(true, _, true).
truth_or(false, T, T).

% integer_t(Value, T): for a ground Value, T is true when it is an integer and false when it is a
% float, an atom or a compound term.
integer_t(Value, true) :-
    integer(Value).
integer_t(Value, false) :-
    float(Value).
integer_t(Value, false) :-
    atom(Value).
integer_t(Value, false) :-
    compound(Value).

% non_negative_integer_t(Value, T): for a ground Value, T is true when it is an integer of 0 or
% more.
non_negative_integer_t(Value, T) :-
    integer_t(Value, IsInteger),
    not_below_zero_t(IsInteger, Value, T).

not_below_zero_t(false, _, false).
not_below_zero_t(true, Value, true) :-
    Value >= 0.
not_below_zero_t(true, Value, false) :-
    Value < 0.

% ---- the contract keys, shared with queries (what_if) and fixtures -----
% cra_administrative_fines_contract_keys(Keys): the four profile keys in
% root_exports / input_contract order.
cra_administrative_fines_contract_keys([
    infringed_provision,
    offender_is_open_source_software_steward,
    offender_is_undertaking,
    total_worldwide_annual_turnover_in_euros
]).

% ---- the INFRINGEMENT_DATE argument: a real calendar day ---------------
% cra_administrative_fines_calendar_day_t(DateTerm, Truth): Truth is true when
% DateTerm is a ground date(YearNumber, MonthNumber, DayNumber) of bare
% integers, MonthNumber from 1 to 12 and DayNumber from 1 to the last day of
% that month (month_last_day/3 of kit/deadline_lib: 29 February only in a
% year divisible by 4 and not by 100, or divisible by 400). A float part
% is not an integer. No year range is imposed. Exactly one clause
% holds for every term; the predicate never fails and never raises.
cra_administrative_fines_calendar_day_t(DateTerm, false) :-
    var(DateTerm).
cra_administrative_fines_calendar_day_t(DateTerm, Truth) :-
    nonvar(DateTerm),
    DateTerm = date(YearNumber, MonthNumber, DayNumber),
    date_parts_integer_t(YearNumber, MonthNumber, DayNumber, AllIntegers),
    calendar_parts_t(AllIntegers, YearNumber, MonthNumber, DayNumber, Truth).
cra_administrative_fines_calendar_day_t(DateTerm, false) :-
    nonvar(DateTerm),
    DateTerm \= date(_, _, _).

date_parts_integer_t(YearNumber, MonthNumber, DayNumber, Truth) :-
    part_integer_t(YearNumber, YearIsInteger),
    part_integer_t(MonthNumber, MonthIsInteger),
    part_integer_t(DayNumber, DayIsInteger),
    truth_and(YearIsInteger, MonthIsInteger, YearAndMonthAreIntegers),
    truth_and(YearAndMonthAreIntegers, DayIsInteger, Truth).

% part_integer_t(Part, Truth): an unbound part is not an integer; a bound one
% is checked by integer_t/2 (a compound part with a variable is a compound).
part_integer_t(Part, false) :-
    var(Part).
part_integer_t(Part, Truth) :-
    nonvar(Part),
    integer_t(Part, Truth).

calendar_parts_t(false, _, _, _, false).
calendar_parts_t(true, YearNumber, MonthNumber, DayNumber, Truth) :-
    within_bounds_t(1, 12, MonthNumber, MonthIsValid),
    day_of_month_t(MonthIsValid, YearNumber, MonthNumber, DayNumber, Truth).

day_of_month_t(false, _, _, _, false).
day_of_month_t(true, YearNumber, MonthNumber, DayNumber, Truth) :-
    month_last_day(YearNumber, MonthNumber, LastDayOfMonth),
    within_bounds_t(1, LastDayOfMonth, DayNumber, Truth).

% within_bounds_t(Lowest, Highest, Value, Truth): for integers with
% Lowest =< Highest, exactly one clause holds.
within_bounds_t(Lowest, Highest, Value, true) :-
    Value >= Lowest,
    Value =< Highest.
within_bounds_t(Lowest, _, Value, false) :-
    Value < Lowest.
within_bounds_t(_, Highest, Value, false) :-
    Value > Highest.

% ---- tests ------------------------------------------------------------
test(a_well_formed_profile_has_no_problem) :-
    cra_administrative_fines_input_problems([attribute(infringed_provision, article_13), attribute(offender_is_undertaking, unsure)], []).
test(an_empty_profile_has_no_problem) :-
    cra_administrative_fines_input_problems([], []).
test(problems_come_in_contract_order_then_unknown_keys) :-
    FloatTurnover is float(1),
    cra_administrative_fines_input_problems([attribute(colour, red), attribute(offender_is_undertaking, true), attribute(offender_is_undertaking, true), attribute(total_worldwide_annual_turnover_in_euros, FloatTurnover)], Problems),
    Problems == [duplicate_key(offender_is_undertaking), wrong_type(total_worldwide_annual_turnover_in_euros), unknown_key(colour)].
test(a_provision_outside_the_closed_list_is_wrong_type) :-
    cra_administrative_fines_input_problems([attribute(infringed_provision, article_99)], [wrong_type(infringed_provision)]).
test(a_list_holding_a_non_attribute_is_not_a_profile) :-
    cra_administrative_fines_input_problems([attribute(infringed_provision, article_13), colour], [wrong_type(profile)]).
test(an_unbound_profile_is_not_a_profile) :-
    cra_administrative_fines_input_problems(_, [wrong_type(profile)]).
test(the_contract_keys_in_order) :-
    cra_administrative_fines_contract_keys([infringed_provision, offender_is_open_source_software_steward, offender_is_undertaking, total_worldwide_annual_turnover_in_euros]).
test(the_application_day_is_a_calendar_day) :-
    cra_administrative_fines_calendar_day_t(date(2027, 12, 11), true).
test(leap_day_2028_is_a_calendar_day) :-
    cra_administrative_fines_calendar_day_t(date(2028, 2, 29), true).
test(leap_day_2027_is_not_a_calendar_day) :-
    cra_administrative_fines_calendar_day_t(date(2027, 2, 29), false).
test(leap_day_2027_is_never_true, fail) :-
    cra_administrative_fines_calendar_day_t(date(2027, 2, 29), true).
test(a_float_year_is_not_a_calendar_day) :-
    FloatYear is float(2028),
    cra_administrative_fines_calendar_day_t(date(FloatYear, 1, 1), false).
test(month_thirteen_is_not_a_calendar_day) :-
    cra_administrative_fines_calendar_day_t(date(2028, 13, 1), false).
test(an_unbound_date_is_not_a_calendar_day) :-
    cra_administrative_fines_calendar_day_t(_, false).
test(a_date_with_an_unbound_day_is_not_a_calendar_day) :-
    cra_administrative_fines_calendar_day_t(date(2028, 1, _), false).
test(an_atom_is_not_a_calendar_day) :-
    cra_administrative_fines_calendar_day_t(tomorrow, false).
test(the_calendar_check_gives_one_answer) :-
    findall(Truth, cra_administrative_fines_calendar_day_t(date(2028, 2, 29), Truth), Truths),
    Truths == [true].

:- end_module(kernel).
