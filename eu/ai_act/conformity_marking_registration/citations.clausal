% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/ai_act/conformity_marking_registration.
%
% Instrument: Regulation (EU) 2024/1689 (Artificial Intelligence Act), the
% consolidated text 02024R1689-20260727 (as amended by Regulation (EU)
% 2026/1744, valid from 27 July 2026), the pinned units of this order. Each
% verbatim is an exact substring of the pinned unit text.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% The verbatim pair is OMITTED where citations-sources.yaml says
% `status: unverified` (the provisions not in the pin: Art 6 and
% Regulation (EU) 2026/1744).
%
% Keys that are not in the citation vocabulary of any query (the Art 3
% definitions read into the keys, the lead words and third subparagraph of
% Art 43(1), Art 6 and Regulation (EU) 2026/1744) are recorded for the
% implements/1 markers only and are never returned in a result.
%
% PROVENANCE: every operative clause opens its body with implements(Key).
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

implements(Key) :-
    citation(Key, _).

% ---- Article 3: definitions read into the meaning of the keys ----
citation(eu_reg_2024_1689_art_3_9, [label-'Regulation (EU) 2024/1689 Art 3, point (9), definition of placing on the market', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'placing on the market means the first making available of an AI system or a general-purpose AI model on the Union market']).
citation(eu_reg_2024_1689_art_3_11, [label-'Regulation (EU) 2024/1689 Art 3, point (11), definition of putting into service', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'putting into service means the supply of an AI system for first use directly to the deployer or for own use in the Union for its intended purpose']).
citation(eu_reg_2024_1689_art_3_20, [label-'Regulation (EU) 2024/1689 Art 3, point (20), definition of conformity assessment', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'conformity assessment means the process of demonstrating whether the requirements set out in Chapter III, Section 2 relating to a high-risk AI system have been fulfilled']).
citation(eu_reg_2024_1689_art_3_22, [label-'Regulation (EU) 2024/1689 Art 3, point (22), definition of notified body', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'notified body means a conformity assessment body notified in accordance with this Regulation and other relevant Union harmonisation legislation']).
citation(eu_reg_2024_1689_art_3_23, [label-'Regulation (EU) 2024/1689 Art 3, point (23), definition of substantial modification', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'substantial modification means a change to an AI system after its placing on the market or putting into service which is not foreseen or planned in the initial conformity assessment carried out by the provider']).
citation(eu_reg_2024_1689_art_3_24, [label-'Regulation (EU) 2024/1689 Art 3, point (24), definition of CE marking', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'CE marking means a marking by which a provider indicates that an AI system is in conformity with the requirements set out in Chapter III, Section 2']).
citation(eu_reg_2024_1689_art_3_26, [label-'Regulation (EU) 2024/1689 Art 3, point (26), definition of market surveillance authority', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'market surveillance authority means the national authority carrying out the activities and taking the measures pursuant to Regulation (EU) 2019/1020']).
citation(eu_reg_2024_1689_art_3_27, [label-'Regulation (EU) 2024/1689 Art 3, point (27), definition of harmonised standard', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'harmonised standard means a harmonised standard as defined in Article 2(1), point (c), of Regulation (EU) No 1025/2012']).
citation(eu_reg_2024_1689_art_3_28, [label-'Regulation (EU) 2024/1689 Art 3, point (28), definition of common specification', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'common specification means a set of technical specifications as defined in Article 2, point (4) of Regulation (EU) No 1025/2012']).

% ---- Article 6: the classification the caller gives (not pinned) ----
citation(eu_reg_2024_1689_art_6_1, [label-'Regulation (EU) 2024/1689 Art 6(1), high-risk classification through Union harmonisation legislation listed in Annex I (not pinned; the caller gives it)', ref-'https://eur-lex.europa.eu/eli/reg/2024/1689/oj']).
citation(eu_reg_2024_1689_art_6_2, [label-'Regulation (EU) 2024/1689 Art 6(2), high-risk classification of the systems listed in Annex III (not pinned; the caller gives it)', ref-'https://eur-lex.europa.eu/eli/reg/2024/1689/oj']).
citation(eu_reg_2024_1689_art_6_3, [label-'Regulation (EU) 2024/1689 Art 6(3), the provider conclusion that a system listed in Annex III is not high-risk (not pinned; taken as given)', ref-'https://eur-lex.europa.eu/eli/reg/2024/1689/oj']).

% ---- Article 43: conformity assessment ----
citation(eu_reg_2024_1689_art_43_1, [label-'Regulation (EU) 2024/1689 Art 43(1)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'For high-risk AI systems listed in point 1 of Annex III, where, in demonstrating the compliance of a high-risk AI system with the requirements set out in Section 2, the provider has applied harmonised standards referred to in Article 40']).
citation(eu_reg_2024_1689_art_43_1_first_subparagraph_a, [label-'Regulation (EU) 2024/1689 Art 43(1), first subparagraph, point (a)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'the internal control referred to in Annex VI']).
citation(eu_reg_2024_1689_art_43_1_first_subparagraph_b, [label-'Regulation (EU) 2024/1689 Art 43(1), first subparagraph, point (b)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'the assessment of the quality management system and the assessment of the technical documentation, with the involvement of a notified body, referred to in Annex VII']).
citation(eu_reg_2024_1689_art_43_1_second_subparagraph, [label-'Regulation (EU) 2024/1689 Art 43(1), second subparagraph, lead words', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'the provider shall follow the conformity assessment procedure set out in Annex VII where']).
citation(eu_reg_2024_1689_art_43_1_second_subparagraph_a, [label-'Regulation (EU) 2024/1689 Art 43(1), second subparagraph, point (a)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'harmonised standards referred to in Article 40 do not exist, and common specifications referred to in Article 41 are not available']).
citation(eu_reg_2024_1689_art_43_1_second_subparagraph_b, [label-'Regulation (EU) 2024/1689 Art 43(1), second subparagraph, point (b)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'the provider has not applied, or has applied only part of, the harmonised standard']).
citation(eu_reg_2024_1689_art_43_1_second_subparagraph_c, [label-'Regulation (EU) 2024/1689 Art 43(1), second subparagraph, point (c)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'the common specifications referred to in point (a) exist, but the provider has not applied them']).
citation(eu_reg_2024_1689_art_43_1_second_subparagraph_d, [label-'Regulation (EU) 2024/1689 Art 43(1), second subparagraph, point (d)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'one or more of the harmonised standards referred to in point (a) has been published with a restriction, and only on the part of the standard that was restricted']).
citation(eu_reg_2024_1689_art_43_1_third_subparagraph, [label-'Regulation (EU) 2024/1689 Art 43(1), third subparagraph', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'the market surveillance authority referred to in Article 74(8) or (9), as applicable, shall act as a notified body']).
citation(eu_reg_2024_1689_art_43_2, [label-'Regulation (EU) 2024/1689 Art 43(2)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'providers shall follow the conformity assessment procedure based on internal control as referred to in Annex VI, which does not provide for the involvement of a notified body']).
citation(eu_reg_2024_1689_art_43_3, [label-'Regulation (EU) 2024/1689 Art 43(3), first, fifth and last sentences', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'the provider of the system shall follow the relevant conformity assessment procedure as required in accordance with the relevant Union harmonisation legislation']).
citation(eu_reg_2024_1689_art_43_4, [label-'Regulation (EU) 2024/1689 Art 43(4)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'shall undergo a new conformity assessment procedure in the event of a substantial modification']).

% ---- Article 47: EU declaration of conformity ----
citation(eu_reg_2024_1689_art_47_1, [label-'Regulation (EU) 2024/1689 Art 47(1), first sentence', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'keep it at the disposal of the national competent authorities for 10 years after the high-risk AI system has been placed on the market or put into service']).
citation(eu_reg_2024_1689_art_47_3, [label-'Regulation (EU) 2024/1689 Art 47(3), first sentence', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'a single EU declaration of conformity shall be drawn up in respect of all Union law applicable to the high-risk AI system']).

% ---- Article 48: CE marking ----
citation(eu_reg_2024_1689_art_48_1, [label-'Regulation (EU) 2024/1689 Art 48(1)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'The CE marking shall be subject to the general principles set out in Article 30 of Regulation (EC) No 765/2008']).
citation(eu_reg_2024_1689_art_48_2, [label-'Regulation (EU) 2024/1689 Art 48(2)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'For high-risk AI systems provided digitally, a digital CE marking shall be used']).
citation(eu_reg_2024_1689_art_48_3, [label-'Regulation (EU) 2024/1689 Art 48(3)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'Where that is not possible or not warranted on account of the nature of the high-risk AI system, it shall be affixed to the packaging or to the accompanying documentation, as appropriate']).
citation(eu_reg_2024_1689_art_48_4, [label-'Regulation (EU) 2024/1689 Art 48(4), first sentence', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'Where applicable, the CE marking shall be followed by the identification number of the notified body responsible for the conformity assessment procedures set out in Article 43']).
citation(eu_reg_2024_1689_art_48_5, [label-'Regulation (EU) 2024/1689 Art 48(5)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'the CE marking shall indicate that the high-risk AI system also fulfil the requirements of that other law']).

% ---- Article 49: registration ----
citation(eu_reg_2024_1689_art_49_1, [label-'Regulation (EU) 2024/1689 Art 49(1)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'with the exception of high-risk AI systems referred to in point 2 of Annex III, the provider or, where applicable, the authorised representative shall register themselves and their system in the EU database referred to in Article 71']).
citation(eu_reg_2024_1689_art_49_2, [label-'Regulation (EU) 2024/1689 Art 49(2)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'an AI system for which the provider has concluded that it is not high-risk according to Article 6(3), that provider or, where applicable, the authorised representative shall register themselves and that system in the EU database referred to in Article 71']).
citation(eu_reg_2024_1689_art_49_3, [label-'Regulation (EU) 2024/1689 Art 49(3)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'deployers that are public authorities, Union institutions, bodies, offices or agencies or persons acting on their behalf shall register themselves, select the system and register its use in the EU database referred to in Article 71']).
citation(eu_reg_2024_1689_art_49_4, [label-'Regulation (EU) 2024/1689 Art 49(4), first subparagraph', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'shall be in a secure non-public section of the EU database referred to in Article 71']).
citation(eu_reg_2024_1689_art_49_4_a, [label-'Regulation (EU) 2024/1689 Art 49(4), point (a)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'Section A, points 1 to 10, of Annex VIII, with the exception of points 6, 8 and 9']).
citation(eu_reg_2024_1689_art_49_4_b, [label-'Regulation (EU) 2024/1689 Art 49(4), point (b)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'Section B, points 1 to 5, and points 8 and 9 of Annex VIII']).
citation(eu_reg_2024_1689_art_49_4_c, [label-'Regulation (EU) 2024/1689 Art 49(4), point (c)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'Section C, points 1 to 3, of Annex VIII']).
citation(eu_reg_2024_1689_art_49_4_d, [label-'Regulation (EU) 2024/1689 Art 49(4), point (d)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'points 1, 2, 3 and 5, of Annex IX']).
citation(eu_reg_2024_1689_art_49_5, [label-'Regulation (EU) 2024/1689 Art 49(5)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'High-risk AI systems referred to in point 2 of Annex III shall be registered at national level']).

% ---- Articles 111 and 113: transitions and dates ----
citation(eu_reg_2024_1689_art_111_1, [label-'Regulation (EU) 2024/1689 Art 111(1), first sentence', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'shall be brought into compliance with this Regulation by 31 December 2030']).
citation(eu_reg_2024_1689_art_111_2, [label-'Regulation (EU) 2024/1689 Art 111(2), first and second sentences', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'only if, as from that date, those systems are subject to significant changes in their designs']).
citation(eu_reg_2024_1689_art_113, [label-'Regulation (EU) 2024/1689 Art 113, second paragraph', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'It shall apply from 2 August 2026']).
citation(eu_reg_2024_1689_art_113_c, [label-'Regulation (EU) 2024/1689 Art 113, third paragraph, point (c)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'Chapter III, Sections 1, 2, and 3, with the exception of Article 6(5), shall apply from']).
citation(eu_reg_2024_1689_art_113_c_i, [label-'Regulation (EU) 2024/1689 Art 113, third paragraph, point (c)(i)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'2 December 2027 as regards AI systems classified as high-risk pursuant to Article 6(2) and Annex III']).
citation(eu_reg_2024_1689_art_113_c_ii, [label-'Regulation (EU) 2024/1689 Art 113, third paragraph, point (c)(ii)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'2 August 2028 as regards AI systems classified as high-risk pursuant to Article 6(1) and Annex I']).

% ---- Annex VI: internal control ----
citation(eu_reg_2024_1689_annex_vi, [label-'Regulation (EU) 2024/1689 Annex VI, title', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'Conformity assessment procedure based on internal control']).
citation(eu_reg_2024_1689_annex_vi_1, [label-'Regulation (EU) 2024/1689 Annex VI, point 1', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'The conformity assessment procedure based on internal control is the conformity assessment procedure based on points 2, 3 and 4']).
citation(eu_reg_2024_1689_annex_vi_2, [label-'Regulation (EU) 2024/1689 Annex VI, point 2', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'The provider verifies that the established quality management system is in compliance with the requirements of Article 17']).
citation(eu_reg_2024_1689_annex_vi_3, [label-'Regulation (EU) 2024/1689 Annex VI, point 3', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'The provider examines the information contained in the technical documentation in order to assess the compliance of the AI system with the relevant essential requirements set out in Chapter III, Section 2']).
citation(eu_reg_2024_1689_annex_vi_4, [label-'Regulation (EU) 2024/1689 Annex VI, point 4', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'The provider also verifies that the design and development process of the AI system and its post-market monitoring as referred to in Article 72 is consistent with the technical documentation']).

% ---- Annex VII: the procedure with a notified body ----
citation(eu_reg_2024_1689_annex_vii, [label-'Regulation (EU) 2024/1689 Annex VII, title', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'Conformity based on an assessment of the quality management system and an assessment of the technical documentation']).
citation(eu_reg_2024_1689_annex_vii_1, [label-'Regulation (EU) 2024/1689 Annex VII, point 1', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'is the conformity assessment procedure based on points 2 to 5']).
citation(eu_reg_2024_1689_annex_vii_3_1, [label-'Regulation (EU) 2024/1689 Annex VII, point 3.1', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'The application of the provider shall include']).
citation(eu_reg_2024_1689_annex_vii_3_1_a, [label-'Regulation (EU) 2024/1689 Annex VII, point 3.1(a)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'the name and address of the provider and, if the application is lodged by an authorised representative, also their name and address']).
citation(eu_reg_2024_1689_annex_vii_3_1_b, [label-'Regulation (EU) 2024/1689 Annex VII, point 3.1(b)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'the list of AI systems covered under the same quality management system']).
citation(eu_reg_2024_1689_annex_vii_3_1_c, [label-'Regulation (EU) 2024/1689 Annex VII, point 3.1(c)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'the technical documentation for each AI system covered under the same quality management system']).
citation(eu_reg_2024_1689_annex_vii_3_1_d, [label-'Regulation (EU) 2024/1689 Annex VII, point 3.1(d)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'the documentation concerning the quality management system which shall cover all the aspects listed under Article 17']).
citation(eu_reg_2024_1689_annex_vii_3_1_e, [label-'Regulation (EU) 2024/1689 Annex VII, point 3.1(e)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'a description of the procedures in place to ensure that the quality management system remains adequate and effective']).
citation(eu_reg_2024_1689_annex_vii_3_1_f, [label-'Regulation (EU) 2024/1689 Annex VII, point 3.1(f)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'a written declaration that the same application has not been lodged with any other notified body']).
citation(eu_reg_2024_1689_annex_vii_4_2, [label-'Regulation (EU) 2024/1689 Annex VII, point 4.2', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'The application shall include']).
citation(eu_reg_2024_1689_annex_vii_4_2_a, [label-'Regulation (EU) 2024/1689 Annex VII, point 4.2(a)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'the name and address of the provider']).
citation(eu_reg_2024_1689_annex_vii_4_2_b, [label-'Regulation (EU) 2024/1689 Annex VII, point 4.2(b)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'a written declaration that the same application has not been lodged with any other notified body']).
citation(eu_reg_2024_1689_annex_vii_4_2_c, [label-'Regulation (EU) 2024/1689 Annex VII, point 4.2(c)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'the technical documentation referred to in Annex IV']).

% ---- Annex VIII: registration information ----
citation(eu_reg_2024_1689_annex_viii, [label-'Regulation (EU) 2024/1689 Annex VIII, title', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'Information to be submitted upon the registration of high-risk AI systems in accordance with Article 49']).
citation(eu_reg_2024_1689_annex_viii_section_a, [label-'Regulation (EU) 2024/1689 Annex VIII, Section A', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'Information to be submitted by providers of high-risk AI systems in accordance with Article 49(1)']).
citation(eu_reg_2024_1689_annex_viii_section_a_1, [label-'Regulation (EU) 2024/1689 Annex VIII, Section A, point 1', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'The name, address and contact details of the provider']).
citation(eu_reg_2024_1689_annex_viii_section_a_2, [label-'Regulation (EU) 2024/1689 Annex VIII, Section A, point 2', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'Where submission of information is carried out by another person on behalf of the provider, the name, address and contact details of that person']).
citation(eu_reg_2024_1689_annex_viii_section_a_3, [label-'Regulation (EU) 2024/1689 Annex VIII, Section A, point 3', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'The name, address and contact details of the authorised representative']).
citation(eu_reg_2024_1689_annex_viii_section_a_4, [label-'Regulation (EU) 2024/1689 Annex VIII, Section A, point 4', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'The AI system trade name and any additional unambiguous reference allowing the identification and traceability of the AI system']).
citation(eu_reg_2024_1689_annex_viii_section_a_5, [label-'Regulation (EU) 2024/1689 Annex VIII, Section A, point 5', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727', verbatim-'A description of the intended purpose of the AI system and of the components and functions supported through this AI system']).
