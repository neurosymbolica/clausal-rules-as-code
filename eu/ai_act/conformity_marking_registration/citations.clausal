test(a_recorded_key_is_implemented) :-
    implements(eu_reg_2024_1689_art_43_2).
test(an_unrecorded_key_is_not_implemented, fail) :-
    implements(eu_reg_2024_1689_art_43_9).
test(an_unverified_record_has_no_verbatim) :-
    citation(eu_reg_2024_1689_art_6_3, Pairs),
    Pairs = [label-_, ref-_].

:- end_module(citations).
