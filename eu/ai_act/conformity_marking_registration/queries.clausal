% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% queries.clausal -- QUERY-COMBINATOR layer for eu/ai_act/conformity_marking_registration.
% A TOP-LAYER consumer: it imports the determination slice's PUBLIC
% predicates it calls, and nothing else.
%
% The declared query types are served by the slice's public predicates,
% which the package facade re-exports:
%   #3  status_determination  conformity_assessment_procedure/4 (and the six
%                             other status queries, decide_/status facade)
%   #14 obligation_surfacing  registration_status/5 (also ce_marking_status/5,
%                             declaration_of_conformity_status/4)
%   #15 deadline              declaration_keeping_status/4 (Art 47(1))
%   #1  factual_lookup        listed_items/3 (Annexes VI to IX, Art 49(4))
%   #7  justification         conformity_marking_registration_checklist/2
% This layer adds:
%   conformity_marking_registration_what_if/4      (#16 what-if): override one key -> re-decide
%   conformity_marking_registration_profile_keys/1: top-level profile key schema
%   conformity_marking_registration_input_problems/2: the problems a profile has ([] = none),
%     re-exported from the kernel as the scaffold wrote it
%   the RESULT ATOMS and the ITEM ATOMS of the order, served as vocabulary
%     facts (never called as queries; they decide nothing and carry no
%     marker), and the RESULT CONSTRUCTORS, exported as data with no clauses.
%
% The what-if case is assessment(Profile, AssessmentDate), the facade case.
% The profile is an ATTRIBUTE LIST, not a dict, so the override drops every
% attribute(Key, _) and appends attribute(Key, Value): the hypothesis never
% holds the key twice (a repeat would be duplicate_key(Key)). kit
% query_combinators override_key/4 works on dicts and is not used here.
% =====================================================================

:- module(queries, [
    conformity_marking_registration_profile_keys/1,
    conformity_marking_registration_input_problems/2,
    conformity_marking_registration_what_if/4,
    not_applicable_on_date/0,
    not_high_risk_under_annex_iii_or_section_a_of_annex_i/0,
    compliance_required_by_31_december_2030/0,
    compliance_required_by_2_august_2030/0,
    not_applicable_to_a_system_placed_before_the_application_day/0,
    procedure_of_the_union_harmonisation_legislation/0,
    procedure_of_the_union_harmonisation_legislation_with_the_option_without_a_third_party/0,
    procedure_of_the_union_harmonisation_legislation_with_third_party_assessment/0,
    choice_of_internal_control_under_annex_vi_or_notified_body_procedure_under_annex_vii/0,
    choice_of_annex_vi_or_annex_vii_with_annex_vii_for_the_restricted_part/0,
    notified_body_procedure_under_annex_vii/0,
    internal_control_under_annex_vi/0,
    article_43_1_not_applicable/0,
    market_surveillance_authority_acts_as_notified_body/0,
    notified_body_of_the_providers_choice/0,
    no_previous_conformity_assessment/0,
    new_conformity_assessment_required/0,
    new_conformity_assessment_not_required/0,
    single_declaration_for_all_applicable_union_law/0,
    declaration_under_this_regulation/0,
    declaration_to_be_kept/0,
    keeping_period_ended/0,
    marking_element_required/0,
    marking_element_not_required/0,
    no_registration_duty/0,
    registration_in_the_eu_database/0,
    registration_in_the_secure_non_public_section_of_the_eu_database/0,
    registration_at_national_level/0,
    verification_of_the_quality_management_system_against_article_17/0,
    examination_of_the_technical_documentation_against_the_essential_requirements/0,
    verification_of_the_consistency_of_design_development_and_post_market_monitoring_with_the_technical_documentation/0,
    name_and_address_of_the_provider_and_of_any_authorised_representative_lodging_the_application/0,
    list_of_ai_systems_covered_by_the_quality_management_system/0,
    technical_documentation_for_each_ai_system_covered/0,
    documentation_of_the_quality_management_system/0,
    description_of_the_procedures_keeping_the_quality_management_system_adequate_and_effective/0,
    written_declaration_that_the_application_has_not_been_lodged_with_another_notified_body/0,
    name_and_address_of_the_provider/0,
    technical_documentation_referred_to_in_annex_iv/0,
    name_address_and_contact_details_of_the_provider/0,
    name_address_and_contact_details_of_the_person_submitting_on_behalf_of_the_provider/0,
    name_address_and_contact_details_of_the_authorised_representative/0,
    trade_name_and_unambiguous_reference_for_identification_and_traceability/0,
    description_of_the_intended_purpose_and_of_the_components_and_functions/0,
    description_of_the_information_used_and_of_the_operating_logic/0,
    status_of_the_ai_system/0,
    type_number_and_expiry_date_of_the_certificate_and_name_or_number_of_the_notified_body/0,
    scanned_copy_of_the_certificate/0,
    member_states_where_placed_on_the_market_put_into_service_or_made_available/0,
    copy_of_the_eu_declaration_of_conformity/0,
    electronic_instructions_for_use/0,
    url_for_additional_information/0,
    description_of_the_intended_purpose/0,
    conditions_under_article_6_3_on_which_the_system_is_considered_not_high_risk/0,
    name_address_and_contact_details_of_the_deployer/0,
    name_address_and_contact_details_of_the_person_submitting_on_behalf_of_the_deployer/0,
    url_of_the_providers_entry_in_the_eu_database/0,
    summary_of_the_findings_of_the_fundamental_rights_impact_assessment/0,
    summary_of_the_data_protection_impact_assessment/0,
    union_wide_unique_single_identification_number_of_the_testing/0,
    name_and_contact_details_of_the_provider_and_of_the_deployers_involved_in_the_testing/0,
    brief_description_of_the_ai_system_and_of_its_intended_purpose/0,
    summary_of_the_main_characteristics_of_the_testing_plan/0,
    information_on_suspension_or_termination_of_the_testing/0,
    date/3,
    indeterminate/1,
    needs_legal_review/2,
    open_textured/2,
    inputs_relied_on/1,
    provenance/2,
    input_problems/1,
    unknown_key/1,
    wrong_type/1,
    duplicate_key/1
]).

:- use_module(library(reif), [memberd_t/3]).
:- use_module(eu/ai_act/conformity_marking_registration/kernel, [conformity_marking_registration_input_problems/2]).
:- use_module(eu/ai_act/conformity_marking_registration/conformity_marking_registration, [conformity_marking_registration_status/2]).

% ---- the RESULT CONSTRUCTORS (exported data, no clauses) ------------------
:- constructors([date(year, month, day), indeterminate(missing_keys), needs_legal_review(reason, context), open_textured(input, citation), inputs_relied_on(pairs), provenance(clause, citations), input_problems(problems), unknown_key(key), wrong_type(key), duplicate_key(key)]).

% schema of top-level profile keys: the keys of the order's typed input contract, in its order
conformity_marking_registration_profile_keys([annex_iii_point, provider_concluded_under_article_6_3_that_the_system_is_not_high_risk, covered_by_union_harmonisation_legislation_listed_in_section_a_of_annex_i, component_of_an_annex_x_large_scale_it_system_placed_on_the_market_or_put_into_service_before_2_august_2027, placed_on_the_market_or_put_into_service_before_the_application_day, significant_changes_in_design_from_the_application_day, intended_to_be_used_by_public_authorities, harmonised_standards_or_common_specifications_applied_in_full, applied_harmonised_standard_published_with_a_restriction, harmonisation_legislation_offers_an_option_without_third_party_conformity_assessment, intended_to_be_put_into_service_by_law_enforcement_immigration_or_asylum_authorities_or_union_institutions_bodies_offices_or_agencies, already_subject_to_a_conformity_assessment_procedure, change_pre_determined_for_a_system_that_continues_to_learn, substantial_modification, other_union_harmonisation_legislation_requires_an_eu_declaration_of_conformity, provided_digitally, affixing_to_the_system_possible_and_warranted, notified_body_involved_in_the_conformity_assessment, other_union_law_provides_for_affixing_the_ce_marking, deployer_is_a_public_authority_or_union_institution_body_office_or_agency_or_acts_on_their_behalf]).

% #16 what-if: re-decide with one key hypothetically overridden.
% A case that is not assessment(Profile, AssessmentDate) is decided as given
% (the facade answers input_problems([wrong_type(case)])).
conformity_marking_registration_what_if(AssessmentCase, OverriddenKey, NewValue, NewStatus) :-
    assessment_case_t(AssessmentCase, IsAssessment),
    what_if_case(IsAssessment, AssessmentCase, OverriddenKey, NewValue, NewStatus).

what_if_case(true, assessment(Profile, AssessmentDate), OverriddenKey, NewValue, NewStatus) :-
    override_attribute(Profile, OverriddenKey, NewValue, Hypothesis),
    conformity_marking_registration_status(assessment(Hypothesis, AssessmentDate), NewStatus).
what_if_case(false, AssessmentCase, _, _, NewStatus) :-
    conformity_marking_registration_status(AssessmentCase, NewStatus).

assessment_case_t(AssessmentCase, false) :-
    var(AssessmentCase).
assessment_case_t(AssessmentCase, Truth) :-
    nonvar(AssessmentCase),
    functor(AssessmentCase, Functor, Arity),
    memberd_t(Functor/Arity, [assessment/2], Truth).

% override_attribute(Profile, Key, Value, Hypothesis): every attribute(Key, _)
% dropped, attribute(Key, Value) appended. A Profile that is not a proper list
% is kept as given, so the input check reports it.
override_attribute(Profile, OverriddenKey, NewValue, Hypothesis) :-
    proper_list_t(Profile, IsList),
    override_in(IsList, Profile, OverriddenKey, NewValue, Hypothesis).

override_in(false, Profile, _, _, Profile).
override_in(true, Profile, OverriddenKey, NewValue, Hypothesis) :-
    exclude(same_key(OverriddenKey), Profile, KeptElements),
    append(KeptElements, [attribute(OverriddenKey, NewValue)], Hypothesis).

same_key(OverriddenKey, Element) :-
    nonvar(Element),
    Element = attribute(ElementKey, _),
    ElementKey == OverriddenKey.

proper_list_t(Term, Truth) :-
    catch(list_check(Term, Truth), error(_, _), Truth = false).

list_check(Term, true) :-
    must_be(list, Term).

