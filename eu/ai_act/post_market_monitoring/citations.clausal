% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/ai_act/post_market_monitoring.
%
% Instrument: Regulation (EU) 2024/1689 (Artificial Intelligence Act), the
% consolidated text 02024R1689-20260727 (as amended by Regulation (EU)
% 2026/1744, valid from 27 July 2026; Formex, cut on
% 2026-11-15). Each record names its pinned unit in its ref.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order.
% Every verbatim below is an exact substring of the pinned unit text.
%
% RESULT CITATIONS (the canonical lexicon keys the queries may return):
%   eu_reg_2024_1689_art_72_1, eu_reg_2024_1689_art_72_3,
%   eu_reg_2024_1689_art_72_4, eu_reg_2024_1689_art_111_1,
%   eu_reg_2024_1689_art_111_2, eu_reg_2024_1689_art_113_c,
%   eu_reg_2024_1689_art_113_c_i, eu_reg_2024_1689_art_113_c_ii.
% MARKER-ONLY CITATIONS (definitions and the general date the rules read into
% the keys; recorded so clauses can carry implements/1, never returned in a
% result): eu_reg_2024_1689_art_3_3, eu_reg_2024_1689_art_3_8,
%   eu_reg_2024_1689_art_3_9, eu_reg_2024_1689_art_3_11,
%   eu_reg_2024_1689_art_3_25, eu_reg_2024_1689_art_113.
%
% PROVENANCE: every operative clause opens its body with implements(Key),
% Key the provision for THAT condition or value.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

% ---- result citations ----------------------------------------------

citation(eu_reg_2024_1689_art_72_1, [label-'Regulation (EU) 2024/1689 (Artificial Intelligence Act) Art 72(1) (duty to establish and document a post-market monitoring system)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727 (unit 02024R1689-20260727#parag_072.001)', verbatim-'Providers shall establish and document a post-market monitoring system']).

citation(eu_reg_2024_1689_art_72_3, [label-'Regulation (EU) 2024/1689 (Artificial Intelligence Act) Art 72(3), first and second sentences (post-market monitoring plan, part of the Annex IV technical documentation)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727 (unit 02024R1689-20260727#parag_072.003)', verbatim-'The post-market monitoring system shall be based on a post-market monitoring plan. The post-market monitoring plan shall be part of the technical documentation referred to in Annex IV.']).

citation(eu_reg_2024_1689_art_72_4, [label-'Regulation (EU) 2024/1689 (Artificial Intelligence Act) Art 72(4), first and second subparagraphs (choice of integrating into an existing post-market monitoring system and plan)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727 (unit 02024R1689-20260727#parag_072.004)', verbatim-'providers shall have a choice of integrating']).

citation(eu_reg_2024_1689_art_111_1, [label-'Regulation (EU) 2024/1689 (Artificial Intelligence Act) Art 111(1), first sentence (components of Annex X large-scale IT systems placed on the market or put into service before 2 August 2027)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727 (unit 02024R1689-20260727#parag_111.001)', verbatim-'shall be brought into compliance with this Regulation by 31 December 2030']).

citation(eu_reg_2024_1689_art_111_2, [label-'Regulation (EU) 2024/1689 (Artificial Intelligence Act) Art 111(2), first and second sentences (high-risk AI systems placed on the market or put into service before the date of application of Chapter III)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727 (unit 02024R1689-20260727#parag_111.002)', verbatim-'only if, as from that date, those systems are subject to significant changes in their designs']).

citation(eu_reg_2024_1689_art_113_c, [label-'Regulation (EU) 2024/1689 (Artificial Intelligence Act) Art 113, third paragraph, point (c) (application of Chapter III, Sections 1, 2 and 3)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727 (unit 02024R1689-20260727#point_113_c)', verbatim-'Chapter III, Sections 1, 2, and 3, with the exception of Article 6(5), shall apply from:']).

citation(eu_reg_2024_1689_art_113_c_i, [label-'Regulation (EU) 2024/1689 (Artificial Intelligence Act) Art 113, third paragraph, point (c)(i) (2 December 2027 for high-risk AI systems under Article 6(2) and Annex III)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727 (unit 02024R1689-20260727#point_113_c_i)', verbatim-'2 December 2027 as regards AI systems classified as high-risk pursuant to Article 6(2) and Annex III']).

citation(eu_reg_2024_1689_art_113_c_ii, [label-'Regulation (EU) 2024/1689 (Artificial Intelligence Act) Art 113, third paragraph, point (c)(ii) (2 August 2028 for high-risk AI systems under Article 6(1) and Annex I)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727 (unit 02024R1689-20260727#point_113_c_ii)', verbatim-'2 August 2028 as regards AI systems classified as high-risk pursuant to Article 6(1) and Annex I']).

% ---- marker-only citations (never returned in a result) -------------

citation(eu_reg_2024_1689_art_3_3, [label-'Regulation (EU) 2024/1689 (Artificial Intelligence Act) Art 3, point (3), definition of provider', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727 (unit 02024R1689-20260727#point_003_3)', verbatim-'means a natural or legal person, public authority, agency or other body that develops an AI system or a general-purpose AI model']).

citation(eu_reg_2024_1689_art_3_8, [label-'Regulation (EU) 2024/1689 (Artificial Intelligence Act) Art 3, point (8), definition of operator', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727 (unit 02024R1689-20260727#point_003_8)', verbatim-'means a provider, product manufacturer, deployer, authorised representative, importer or distributor']).

citation(eu_reg_2024_1689_art_3_9, [label-'Regulation (EU) 2024/1689 (Artificial Intelligence Act) Art 3, point (9), definition of placing on the market', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727 (unit 02024R1689-20260727#point_003_9)', verbatim-'means the first making available of an AI system or a general-purpose AI model on the Union market']).

citation(eu_reg_2024_1689_art_3_11, [label-'Regulation (EU) 2024/1689 (Artificial Intelligence Act) Art 3, point (11), definition of putting into service', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727 (unit 02024R1689-20260727#point_003_11)', verbatim-'means the supply of an AI system for first use directly to the deployer or for own use in the Union for its intended purpose']).

citation(eu_reg_2024_1689_art_3_25, [label-'Regulation (EU) 2024/1689 (Artificial Intelligence Act) Art 3, point (25), definition of post-market monitoring system', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727 (unit 02024R1689-20260727#point_003_25)', verbatim-'means all activities carried out by providers of AI systems to collect and review experience gained from the use of AI systems they place on the market or put into service']).

citation(eu_reg_2024_1689_art_113, [label-'Regulation (EU) 2024/1689 (Artificial Intelligence Act) Art 113, second paragraph (general date of application, the date of Art 72 itself)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727 (unit 02024R1689-20260727#art_113)', verbatim-'It shall apply from 2 August 2026.']).

% ---- provenance marker ------------------------------------------------
% implements(Key): succeeds for every recorded key; a key not recorded fails.
implements(Key) :-
    citation(Key, _).

:- end_module(citations).
