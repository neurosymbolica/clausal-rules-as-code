% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_queries.clausal -- PROPERTY tests for the query layer: one test per
% query-taxonomy predicate registered in manifest.yaml query_interface
% (#2 status, #7 checklist, #13 integration, #14 and #15 duty status,
% #16 what-if), the profile key schema and the served result atoms.
% Run: python -m clausal.testing eu/ai_act/post_market_monitoring/tests/test_queries.clausal
% =====================================================================
:- module(test_queries, []).
:- use_module(eu/ai_act/post_market_monitoring/queries, [
    post_market_monitoring_profile_keys/1,
    post_market_monitoring_what_if/4,
    post_market_monitoring_input_problems/2,
    duty_applies/0,
    integration_available/0
]).
:- use_module(eu/ai_act/post_market_monitoring/post_market_monitoring, [
    post_market_monitoring_duty_status/4,
    post_market_monitoring_integration_status/3,
    post_market_monitoring_status/2,
    post_market_monitoring_checklist/2
]).
:- use_module(eu/ai_act/post_market_monitoring/fixtures, [post_market_monitoring_profile_for/2]).

test(profile_keys_are_the_contract_keys) :-
    post_market_monitoring_profile_keys(ProfileKeys),
    ProfileKeys == [provider_of_the_system, system_is_a_high_risk_ai_system_listed_in_annex_iii, system_is_a_high_risk_ai_system_under_article_6_1_and_annex_i, component_of_an_annex_x_large_scale_it_system_placed_on_the_market_or_put_into_service_before_2_august_2027, placed_on_the_market_or_put_into_service_before_the_chapter_iii_date, significant_changes_in_design_as_from_the_chapter_iii_date, intended_to_be_used_by_public_authorities, covered_by_union_harmonisation_legislation_listed_in_section_a_of_annex_i, point_5_annex_iii_system_of_a_financial_institution_under_union_financial_services_law, post_market_monitoring_system_and_plan_already_established_under_that_legislation, integration_achieves_an_equivalent_level_of_protection].

test(the_input_check_is_re_exported_unchanged) :-
    post_market_monitoring_input_problems([attribute(provider_of_the_system, true)], []).

test(the_result_atoms_are_served) :-
    duty_applies,
    integration_available.

% ---- #2 status ---------------------------------------------------------
test(status_through_the_facade) :-
    post_market_monitoring_profile_for(provider_of_an_annex_iii_system, Request),
    findall(Status, post_market_monitoring_status(Request, Status), Statuses),
    Statuses == [duty_applies].

% ---- #14 obligation surfacing -----------------------------------------
test(obligation_surfaced_as_duty_applies) :-
    post_market_monitoring_profile_for(provider_of_an_annex_iii_system, duty(Profile, AssessmentDate)),
    post_market_monitoring_duty_status(Profile, AssessmentDate, duty_applies, Citations),
    sort(Citations, [cite(eu_reg_2024_1689_art_72_1), cite(eu_reg_2024_1689_art_72_3)]).

% ---- #15 deadline: the answer flips on the day itself ------------------
test(deadline_flip_on_31_december_2030) :-
    post_market_monitoring_profile_for(annex_x_component_the_day_before_the_deadline, duty(Profile, _)),
    post_market_monitoring_duty_status(Profile, date(2030, 12, 30), compliance_required_by_31_december_2030, _),
    post_market_monitoring_duty_status(Profile, date(2030, 12, 31), duty_applies, _).

test(deadline_flip_on_2_august_2030) :-
    post_market_monitoring_profile_for(existing_public_authority_system_the_day_before_the_deadline, duty(Profile, _)),
    post_market_monitoring_duty_status(Profile, date(2030, 8, 1), compliance_required_by_2_august_2030, _),
    post_market_monitoring_duty_status(Profile, date(2030, 8, 2), duty_applies, _).

% ---- #13 compliance check: is integrating allowed ----------------------
test(compliance_check_integration_allowed) :-
    post_market_monitoring_profile_for(integration_for_covered_annex_iii_system, integration(Profile)),
    post_market_monitoring_integration_status(Profile, integration_available, [cite(eu_reg_2024_1689_art_72_4)]).

test(compliance_check_integration_refused) :-
    post_market_monitoring_profile_for(integration_without_legislation_route, integration(Profile)),
    post_market_monitoring_integration_status(Profile, integration_not_available, [cite(eu_reg_2024_1689_art_72_4)]).

% ---- #7 justification: a cite(...) on every checklist row --------------
test(checklist_carries_a_cite_per_row) :-
    post_market_monitoring_profile_for(provider_of_an_annex_iii_system, Request),
    post_market_monitoring_checklist(Request, Items),
    Items = [item(verdict, duty_applies, _)|Rows],
    Rows == [item(provider_of_the_system, met, cite(eu_reg_2024_1689_art_3_3)),
             item(high_risk_ai_system, met, cite(eu_reg_2024_1689_art_72_1)),
             item(chapter_iii_date_reached, met, cite(eu_reg_2024_1689_art_113_c))].

test(integration_checklist_names_the_unmet_condition) :-
    post_market_monitoring_profile_for(integration_without_equivalent_protection, Request),
    post_market_monitoring_checklist(Request, Items),
    member(item(equivalent_level_of_protection, unmet(integration_achieves_an_equivalent_level_of_protection), cite(eu_reg_2024_1689_art_72_4)), Items).

% ---- #16 what-if --------------------------------------------------------
test(what_if_the_actor_is_not_the_provider) :-
    post_market_monitoring_profile_for(provider_of_an_annex_iii_system, Request),
    findall(Status, post_market_monitoring_what_if(Request, provider_of_the_system, false, Status), Statuses),
    Statuses == [not_a_provider].

test(what_if_the_design_was_significantly_changed) :-
    post_market_monitoring_profile_for(existing_system_without_changes, Request),
    post_market_monitoring_what_if(Request, significant_changes_in_design_as_from_the_chapter_iii_date, true, duty_applies).

test(what_if_settles_a_referral_either_way) :-
    post_market_monitoring_profile_for(integration_referral_on_equivalence, Request),
    post_market_monitoring_what_if(Request, integration_achieves_an_equivalent_level_of_protection, true, integration_available),
    post_market_monitoring_what_if(Request, integration_achieves_an_equivalent_level_of_protection, false, integration_not_available).

test(what_if_supplies_a_missing_key) :-
    post_market_monitoring_profile_for(missing_provider, Request),
    post_market_monitoring_what_if(Request, provider_of_the_system, true, duty_applies).

test(what_if_with_a_bad_value_is_an_input_problem) :-
    post_market_monitoring_profile_for(provider_of_an_annex_iii_system, Request),
    post_market_monitoring_what_if(Request, provider_of_the_system, maybe, input_problems([wrong_type(provider_of_the_system)])).

test(what_if_leaves_a_non_list_profile_to_the_input_check) :-
    post_market_monitoring_what_if(integration(profile), provider_of_the_system, true, input_problems([wrong_type(profile)])).

test(what_if_on_a_bare_profile_answers_the_integration_query) :-
    post_market_monitoring_what_if([attribute(provider_of_the_system, true)], provider_of_the_system, false, not_a_provider).

:- end_module(test_queries).
