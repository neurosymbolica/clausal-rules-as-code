% ---- near-miss controls: control_pair(Positive, Control) ---------------
% Each control differs from its positive case by one day, one euro or one
% key value, and gets a different MAXIMUM.
control_pair(pinned_text_start_day, earlier_version_day_before_pinned_text).
control_pair(deferred_prohibition_application_day, deferred_prohibition_day_before_application).
control_pair(public_authority_absent_infringement_december_day, public_authority_absent_infringement_day_before_december).
control_pair(public_authority_operator_breach, deferred_prohibition_public_authority_day_before).
control_pair(union_institution_other_infringement, other_infringement_undertaking).
control_pair(not_an_undertaking_provider_obligations, undertaking_provider_obligations_without_turnover).
control_pair(prohibition_turnover_above_boundary, prohibition_turnover_at_boundary).
control_pair(transparency_turnover_above_boundary, transparency_turnover_at_boundary).
control_pair(incorrect_information_turnover_above_boundary, incorrect_information_turnover_at_boundary).
control_pair(small_or_medium_enterprise_prohibition_below_boundary, small_or_medium_enterprise_prohibition_at_boundary).
control_pair(small_mid_cap_importer_below_boundary, small_mid_cap_importer_at_boundary).
control_pair(small_or_medium_enterprise_prohibition_below_boundary, small_mid_cap_prohibition_below_boundary).
control_pair(model_fine_application_day, model_fine_day_before_application).
control_pair(model_fine_measure_above_boundary, model_fine_measure_at_boundary).
control_pair(model_fine_intent_settled, model_fine_intent_unsure).
control_pair(model_fine_intent_settled, model_fine_no_intent_or_negligence).
control_pair(model_fine_intent_unsure, model_fine_intent_unsure_act_absent).

% Pairs whose control also gets the opposite STATUS atom.
status_pair(pinned_text_start_day, earlier_version_day_before_pinned_text).
status_pair(deferred_prohibition_application_day, deferred_prohibition_day_before_application).
status_pair(public_authority_absent_infringement_december_day, public_authority_absent_infringement_day_before_december).
status_pair(not_an_undertaking_provider_obligations, undertaking_provider_obligations_without_turnover).
status_pair(model_fine_application_day, model_fine_day_before_application).
status_pair(model_fine_intent_settled, model_fine_intent_unsure).
status_pair(model_fine_intent_settled, model_fine_no_intent_or_negligence).

% ---- helpers (test plumbing) --------------------------------------------
subject_matches_expectation(Subject) :-
    expected(Subject, Status, Maximum, Citations),
    findall(Verdict, penalties_assess(Subject, Verdict), Verdicts),
    Verdicts = [penalties_verdict(GotStatus, GotMaximum, GotCitations)],
    GotStatus == Status,
    GotMaximum == Maximum,
    msort(GotCitations, SortedGot),
    msort(Citations, SortedExpected),
    SortedGot == SortedExpected,
    sort(GotCitations, DistinctGot),
    length(GotCitations, CitationCount),
    length(DistinctGot, CitationCount).

subject_status_is_expected(Subject) :-
    expected(Subject, Status, _, _),
    penalties_profile_for(Subject, Request),
    findall(GotStatus, penalties_status(Request, GotStatus), Statuses),
    Statuses == [Status].

subject_status_is_a_value(Subject) :-
    penalties_assess(Subject, penalties_verdict(Status, _, _)),
    penalties_status_values(StatusValues),
    member(Status, StatusValues).

subject_has_checklist(Subject) :-
    penalties_profile_for(Subject, Request),
    penalties_decision_resolvable(Request),
    findall(Items, penalties_checklist(Request, Items), Checklists),
    Checklists = [[_|_]].

% A determined maximum carries its citations on the checklist item.
subject_checklist_cites_the_maximum(Subject) :-
    penalties_profile_for(Subject, Request),
    penalties_checklist(Request, Items),
    member(item(maximum, met, [cite(_)|_]), Items).

pair_differs(Positive-Control) :-
    penalties_assess(Positive, penalties_verdict(_, PositiveMaximum, _)),
    penalties_assess(Control, penalties_verdict(_, ControlMaximum, _)),
    dif(PositiveMaximum, ControlMaximum).

pair_status_differs(Positive-Control) :-
    penalties_assess(Positive, penalties_verdict(PositiveStatus, _, _)),
    penalties_assess(Control, penalties_verdict(ControlStatus, _, _)),
    dif(PositiveStatus, ControlStatus).

% ---- the whole registry -------------------------------------------------
test(every_subject_has_one_expectation) :-
    findall(Subject, penalties_subject(Subject), Subjects),
    msort(Subjects, SortedSubjects),
    findall(Subject, expected(Subject, _, _, _), ExpectedSubjects),
    msort(ExpectedSubjects, SortedExpected),
    SortedSubjects == SortedExpected,
    sort(Subjects, DistinctSubjects),
    SortedSubjects == DistinctSubjects.
test(every_subject_resolves_to_its_expected_verdict) :-
    findall(Subject, penalties_subject(Subject), Subjects),
    maplist(subject_matches_expectation, Subjects).
test(every_subject_status_is_its_expected_atom) :-
    findall(Subject, penalties_subject(Subject), Subjects),
    maplist(subject_status_is_expected, Subjects).
test(every_status_is_in_the_vocabulary) :-
    findall(Subject, penalties_subject(Subject), Subjects),
    maplist(subject_status_is_a_value, Subjects).
test(every_subject_has_a_non_empty_checklist) :-
    findall(Subject, penalties_subject(Subject), Subjects),
    maplist(subject_has_checklist, Subjects).
test(every_determined_maximum_is_cited_on_its_checklist) :-
    findall(Subject, expected(Subject, union_maximum_determined, _, _), Subjects),
    maplist(subject_checklist_cites_the_maximum, Subjects).
test(every_near_miss_control_gets_another_maximum) :-
    findall(Positive-Control, control_pair(Positive, Control), Pairs),
    maplist(pair_differs, Pairs).
test(every_status_control_gets_the_opposite_status) :-
    findall(Positive-Control, status_pair(Positive, Control), Pairs),
    maplist(pair_status_differs, Pairs).

