% ---- negative tests, each paired with the positive one above -------------
test(the_day_before_the_pinned_text_is_not_a_determined_maximum, fail) :-
    penalties_profile_for(earlier_version_day_before_pinned_text, Request),
    penalties_status(Request, union_maximum_determined).
test(the_pinned_text_start_day_is_not_the_earlier_version, fail) :-
    penalties_assess(pinned_text_start_day, penalties_verdict(_, earlier_version_applies, _)).
test(at_the_boundary_the_basis_is_not_the_turnover, fail) :-
    penalties_assess(prohibition_turnover_at_boundary, penalties_verdict(_, fine_maximum(_, turnover_percentage), _)).
test(above_the_boundary_the_basis_is_not_the_fixed_amount, fail) :-
    penalties_assess(prohibition_turnover_above_boundary, penalties_verdict(_, fine_maximum(_, fixed_amount), _)).
test(a_small_mid_cap_prohibition_does_not_take_the_lower_amount, fail) :-
    penalties_assess(small_mid_cap_prohibition_below_boundary, penalties_verdict(_, fine_maximum(3499999993, _), _)).
test(a_small_mid_cap_prohibition_does_not_cite_article_99_6a, fail) :-
    penalties_assess(small_mid_cap_prohibition_below_boundary, penalties_verdict(_, _, Citations)),
    member(cite(eu_reg_2024_1689_art_99_6a), Citations).
test(a_deferred_prohibition_of_a_public_authority_is_not_for_member_state_rules, fail) :-
    penalties_assess(deferred_prohibition_public_authority_day_before, penalties_verdict(_, set_by_member_state_rules, _)).
test(an_offender_not_an_undertaking_does_not_take_the_turnover_amount, fail) :-
    penalties_assess(not_an_undertaking_provider_obligations, penalties_verdict(_, fine_maximum(_, turnover_percentage), _)).
test(the_model_fine_never_answers_the_earlier_version, fail) :-
    penalties_assess(model_fine_before_pinned_text, penalties_verdict(_, earlier_version_applies, _)).
test(an_unsure_judgement_is_not_a_determined_maximum, fail) :-
    penalties_profile_for(model_fine_intent_unsure, Request),
    penalties_status(Request, union_maximum_determined).
test(a_missing_act_is_not_sent_to_review, fail) :-
    penalties_assess(model_fine_intent_unsure_act_absent, penalties_verdict(legal_review_needed, _, _)).
test(the_model_fine_does_not_apply_the_small_or_medium_rule, fail) :-
    penalties_assess(model_fine_ignores_small_or_medium_category, penalties_verdict(_, fine_maximum(300000000, _), _)).
test(a_rejected_input_has_no_citations, fail) :-
    penalties_assess(profile_and_date_problems, penalties_verdict(_, _, [_|_])).

% ---- checklist shape and the facade directly ------------------------------
test(the_checklist_of_a_determined_maximum_carries_its_citations) :-
    penalties_profile_for(small_mid_cap_importer_at_boundary, Request),
    penalties_checklist(Request, Items),
    Items == [item(input_check, met, []), item(maximum, met, [cite(eu_reg_2024_1689_art_99_4), cite(eu_reg_2024_1689_art_99_4_c), cite(eu_reg_2024_1689_art_99_6a)])].
test(the_checklist_of_a_review_names_the_judgement) :-
    penalties_profile_for(model_fine_intent_unsure, Request),
    penalties_checklist(Request, Items),
    Items == [item(input_check, met, []), item(maximum, unknown([provider_acted_intentionally_or_negligently]), [])].
test(the_checklist_of_rejected_input_marks_the_input_check_unmet) :-
    penalties_profile_for(duplicate_infringement_key, Request),
    penalties_checklist(Request, [item(input_check, unmet(input_problems([duplicate_key(infringement)])), [])|_]).
test(the_facade_decides_a_request_once) :-
    findall(Verdict, decide_penalties(maximum_fine([attribute(offender_category, other_undertaking), attribute(infringement, incorrect_incomplete_or_misleading_information), attribute(worldwide_annual_turnover_eur, 750000000)], date(2026, 9, 1)), Verdict), Verdicts),
    Verdicts == [penalties_verdict(union_maximum_determined, fine_maximum(750000000, fixed_amount), [cite(eu_reg_2024_1689_art_99_5)])].

% ---- the called contract directly: maximum_fine/4 --------------------------
test(maximum_fine_called_directly_gives_one_answer) :-
    findall(Maximum-Citations, maximum_fine([attribute(offender_category, not_an_undertaking), attribute(infringement, prohibited_practice)], date(2026, 9, 1), Maximum, Citations), Answers),
    Answers == [fine_maximum(3500000000, fixed_amount)-[cite(eu_reg_2024_1689_art_99_3)]].

% ---- the called contract directly: general_purpose_ai_model_maximum_fine/4 --
% One case per outcome: fine_maximum (both bases), no_commission_fine,
% not_applicable_on_date, indeterminate, needs_legal_review, input_problems.
test(general_purpose_ai_model_maximum_fine_turnover_basis) :-
    findall(Maximum-Citations, general_purpose_ai_model_maximum_fine([attribute(offender_is_general_purpose_ai_model_provider, true), attribute(general_purpose_ai_model_infringement, infringed_relevant_provisions), attribute(provider_acted_intentionally_or_negligently, true), attribute(worldwide_annual_turnover_eur, 1000000000)], date(2026, 9, 1), Maximum, Citations), Answers),
    Answers == [fine_maximum(3000000000, turnover_percentage)-[cite(eu_reg_2024_1689_art_101_1), cite(eu_reg_2024_1689_art_101_1_a)]].
test(general_purpose_ai_model_maximum_fine_fixed_basis_at_the_boundary) :-
    findall(Maximum-Citations, general_purpose_ai_model_maximum_fine([attribute(offender_is_general_purpose_ai_model_provider, true), attribute(general_purpose_ai_model_infringement, access_for_evaluation_under_article_92_not_given), attribute(provider_acted_intentionally_or_negligently, true), attribute(worldwide_annual_turnover_eur, 500000000)], date(2026, 9, 1), Maximum, Citations), Answers),
    Answers == [fine_maximum(1500000000, fixed_amount)-[cite(eu_reg_2024_1689_art_101_1), cite(eu_reg_2024_1689_art_101_1_d)]].
test(general_purpose_ai_model_maximum_fine_no_commission_fine) :-
    findall(Maximum-Citations, general_purpose_ai_model_maximum_fine([attribute(offender_is_general_purpose_ai_model_provider, true), attribute(general_purpose_ai_model_infringement, none_of_article_101_1)], date(2026, 9, 1), Maximum, Citations), Answers),
    Answers == [no_commission_fine-[cite(eu_reg_2024_1689_art_101_1)]].
test(general_purpose_ai_model_maximum_fine_not_applicable_on_date) :-
    findall(Maximum-Citations, general_purpose_ai_model_maximum_fine([attribute(offender_is_general_purpose_ai_model_provider, true)], date(2026, 8, 1), Maximum, Citations), Answers),
    Answers == [not_applicable_on_date-[cite(eu_reg_2024_1689_art_113), cite(eu_reg_2024_1689_art_113_b)]].
test(general_purpose_ai_model_maximum_fine_indeterminate) :-
    findall(Maximum-Citations, general_purpose_ai_model_maximum_fine([], date(2026, 9, 1), Maximum, Citations), Answers),
    Answers == [indeterminate([offender_is_general_purpose_ai_model_provider])-[]].
test(general_purpose_ai_model_maximum_fine_needs_legal_review) :-
    findall(Maximum-Citations, general_purpose_ai_model_maximum_fine([attribute(offender_is_general_purpose_ai_model_provider, true), attribute(general_purpose_ai_model_infringement, measure_under_article_93_not_complied_with), attribute(provider_acted_intentionally_or_negligently, unsure), attribute(worldwide_annual_turnover_eur, 10)], date(2026, 9, 1), Maximum, Citations), Answers),
    Answers == [needs_legal_review(open_textured(provider_acted_intentionally_or_negligently, cite(eu_reg_2024_1689_art_101_1)), [inputs_relied_on([provider_acted_intentionally_or_negligently-unsure])])-[]].
test(general_purpose_ai_model_maximum_fine_input_problems) :-
    findall(Maximum-Citations, general_purpose_ai_model_maximum_fine([attribute(colour, red)], date(2026, 2, 30), Maximum, Citations), Answers),
    Answers == [input_problems([unknown_key(colour), wrong_type(infringement_date)])-[]].
test(general_purpose_ai_model_maximum_fine_on_the_application_day_is_not_inapplicable, fail) :-
    general_purpose_ai_model_maximum_fine([attribute(offender_is_general_purpose_ai_model_provider, true)], date(2026, 8, 2), not_applicable_on_date, _).

% ---- the optional provenance element of a referral context -----------------
% The CONTEXT of needs_legal_review may carry one trailing, unscored
% provenance(CLAUSE, CITATIONS) after inputs_relied_on(PAIRS); the scored
% part is unchanged by it.
test(a_provenance_element_may_follow_the_pairs_of_a_referral) :-
    general_purpose_ai_model_maximum_fine([attribute(offender_is_general_purpose_ai_model_provider, true), attribute(general_purpose_ai_model_infringement, infringed_relevant_provisions), attribute(provider_acted_intentionally_or_negligently, unsure), attribute(worldwide_annual_turnover_eur, 1000000000)], date(2026, 9, 1), needs_legal_review(Reason, [inputs_relied_on(Pairs)]), []),
    Marker = provenance(commission_fault_route, [cite(eu_reg_2024_1689_art_101_1)]),
    Context = [inputs_relied_on(Pairs), Marker],
    Context = [inputs_relied_on(ScoredPairs), provenance(Clause, ProvenanceCitations)],
    ScoredPairs == [provider_acted_intentionally_or_negligently-unsure],
    Clause == commission_fault_route,
    ProvenanceCitations == [cite(eu_reg_2024_1689_art_101_1)],
    Reason == open_textured(provider_acted_intentionally_or_negligently, cite(eu_reg_2024_1689_art_101_1)).

:- end_module(test_public_interface).
