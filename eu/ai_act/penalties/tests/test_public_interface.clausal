% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_public_interface.clausal -- the package's PUBLIC surface, exercised
% through the package facade (what an external caller sees).
% Each fixture subject resolves to its EXPECTED verdict: the concrete status
% atom, the MAXIMUM term and the set of citations; its checklist is
% non-empty; each near-miss control gets a different answer.
% Run: python -m clausal.testing eu/ai_act/penalties/tests/test_public_interface.clausal
% =====================================================================
:- module(test_public_interface, []).
:- use_module(eu/ai_act/penalties, [
    maximum_fine/4,
    general_purpose_ai_model_maximum_fine/4,
    decide_penalties/2,
    penalties_status/2,
    penalties_checklist/2,
    penalties_decision_resolvable/1,
    penalties_status_values/1,
    penalties_subject/1,
    penalties_profile_for/2,
    penalties_assess/2
]).

