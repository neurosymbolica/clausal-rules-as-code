% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/ai_act/transparency_art50.
%
% Instrument: Regulation (EU) 2024/1689 (Artificial Intelligence Act), the
% consolidated text 02024R1689-20260727 (as amended by Regulation (EU)
% 2026/1744, valid from 27 July 2026; the pinned Formex text, cut on
% 2026-11-14). Every verbatim below is quoted from that pinned text.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order.
% The keys are the corpus lexicon's canonical keys (_lexicon/citations.yaml);
% they are the ONLY citation atoms a result may return
% (citation_vocabulary/1).
%
% PROVENANCE: every operative clause opens its body with implements(Key),
% Key a key recorded here.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1,
    citation_vocabulary/1
]).

implements(Key) :-
    citation(Key, _).

citation(eu_reg_2024_1689_art_113, [label-'Regulation (EU) 2024/1689 (Artificial Intelligence Act) Art 113, second sentence (date of application)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727 (unit art_113)', verbatim-'It shall apply from 2 August 2026.']).

citation(eu_reg_2024_1689_art_50_1, [label-'Regulation (EU) 2024/1689 (Artificial Intelligence Act) Art 50(1) (information that persons interact with an AI system)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727 (unit parag_050.001)', verbatim-'Providers shall ensure that AI systems intended to interact directly with natural persons are designed and developed in such a way that the natural persons concerned are informed that they are interacting with an AI system']).

citation(eu_reg_2024_1689_art_50_2, [label-'Regulation (EU) 2024/1689 (Artificial Intelligence Act) Art 50(2), first and third sentences (machine-readable marking of synthetic content)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727 (unit parag_050.002)', verbatim-'shall ensure that the outputs of the AI system are marked in a machine-readable format and detectable as artificially generated or manipulated']).

citation(eu_reg_2024_1689_art_50_3, [label-'Regulation (EU) 2024/1689 (Artificial Intelligence Act) Art 50(3) (information on emotion recognition and biometric categorisation systems)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727 (unit parag_050.003)', verbatim-'Deployers of an emotion recognition system or a biometric categorisation system shall inform the natural persons exposed thereto of the operation of the system']).

citation(eu_reg_2024_1689_art_50_4, [label-'Regulation (EU) 2024/1689 (Artificial Intelligence Act) Art 50(4) (disclosure of deep fakes and of public-interest text)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727 (unit parag_050.004)', verbatim-'Deployers of an AI system that generates or manipulates image, audio or video content constituting a deep fake, shall disclose that the content has been artificially generated or manipulated.']).

citation(eu_reg_2024_1689_art_50_5, [label-'Regulation (EU) 2024/1689 (Artificial Intelligence Act) Art 50(5) (time and form of the information)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727 (unit parag_050.005)', verbatim-'The information referred to in paragraphs 1 to 4 shall be provided to the natural persons concerned in a clear and distinguishable manner at the latest at the time of the first interaction or exposure.']).

citation(eu_reg_2024_1689_art_111_4, [label-'Regulation (EU) 2024/1689 (Artificial Intelligence Act) Art 111(4) (transitional period for Art 50(2))', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727 (unit parag_111.004)', verbatim-'shall take the necessary steps in order to comply with Article 50(2) by 2 December 2026']).

citation(eu_reg_2024_1689_art_3_1, [label-'Regulation (EU) 2024/1689 (Artificial Intelligence Act) Art 3, point (1), definition of AI system', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727 (unit point_003_1)', verbatim-'a machine-based system that is designed to operate with varying levels of autonomy']).

citation(eu_reg_2024_1689_art_3_4, [label-'Regulation (EU) 2024/1689 (Artificial Intelligence Act) Art 3, point (4), definition of deployer', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727 (unit point_003_4)', verbatim-'using an AI system under its authority except where the AI system is used in the course of a personal non-professional activity']).

% The citation atoms a result may return (the order's CITATION VOCABULARY).
citation_vocabulary(eu_reg_2024_1689_art_113).
citation_vocabulary(eu_reg_2024_1689_art_50_1).
citation_vocabulary(eu_reg_2024_1689_art_50_2).
citation_vocabulary(eu_reg_2024_1689_art_50_3).
citation_vocabulary(eu_reg_2024_1689_art_50_4).
citation_vocabulary(eu_reg_2024_1689_art_50_5).
citation_vocabulary(eu_reg_2024_1689_art_111_4).
citation_vocabulary(eu_reg_2024_1689_art_3_1).
citation_vocabulary(eu_reg_2024_1689_art_3_4).

test(every_vocabulary_key_is_recorded) :-
    findall(Key, citation_vocabulary(Key), Keys),
    length(Keys, 9),
    maplist(implements, Keys).
test(the_date_key_is_recorded) :-
    implements(eu_reg_2024_1689_art_113).
test(a_shortened_key_is_not_recorded, fail) :-
    implements(art_50_1).

:- end_module(citations).
