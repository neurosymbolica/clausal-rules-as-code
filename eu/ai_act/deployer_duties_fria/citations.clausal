% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/ai_act/deployer_duties_fria.
%
% Instrument: Regulation (EU) 2024/1689 (Artificial Intelligence Act),
% consolidated text 02024R1689-20260727 (as amended by Regulation (EU)
% 2026/1744, valid from 27 July 2026), pinned units cut on 2026-11-15.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% Every record below is `status: verified` in citations-sources.yaml: its
% verbatim is an exact substring of the pinned unit text.
%
% TWO KINDS OF KEY.
%   1. The twelve RETURNABLE keys: the canonical lexicon keys of the
%      order's citation vocabulary (citation_vocabulary/1 below). Only
%      these may appear in a RESULT's CITATIONS, as cite(Key).
%   2. MARKER-ONLY keys: provisions the rules read or apply but never
%      return: the defined terms of Art 3 points (9), (11) and (46), the
%      Annex III units read into the meaning of the keys, and Art 113's
%      general date (read only to say it does not date Arts 26 and 27).
%      They are used in implements/1 markers only.
%
% PROVENANCE: every clause that decides a statutory condition or computes a
% statutory value opens its body with implements(Key), Key the provision
% for THAT condition or value.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1,
    citation_vocabulary/1
]).

% ---- returnable keys (the order's citation vocabulary) ---------------

citation(eu_reg_2024_1689_art_3_4, [label-'Regulation (EU) 2024/1689 Art 3 point (4) definition of deployer', ref-'02024R1689-20260727#point_003_4', verbatim-'deployer means a natural or legal person, public authority, agency or other body using an AI system under its authority except where the AI system is used in the course of a personal non-professional activity']).

citation(eu_reg_2024_1689_art_26_6, [label-'Regulation (EU) 2024/1689 Art 26(6) first sentence (keeping the automatically generated logs, at least six months)', ref-'02024R1689-20260727#parag_026.006', verbatim-'Deployers of high-risk AI systems shall keep the logs automatically generated by that high-risk AI system to the extent such logs are under their control, for a period appropriate to the intended purpose of the high-risk AI system, of at least six months, unless provided otherwise in applicable Union or national law, in particular in Union law on the protection of personal data.']).

citation(eu_reg_2024_1689_art_26_7, [label-'Regulation (EU) 2024/1689 Art 26(7) first sentence (deployers who are employers inform workers'' representatives and affected workers)', ref-'02024R1689-20260727#parag_026.007', verbatim-'Before putting into service or using a high-risk AI system at the workplace, deployers who are employers shall inform workers’ representatives and the affected workers that they will be subject to the use of the high-risk AI system.']).

citation(eu_reg_2024_1689_art_26_11, [label-'Regulation (EU) 2024/1689 Art 26(11) (informing natural persons subject to decisions; Art 13 of Directive (EU) 2016/680 for law enforcement)', ref-'02024R1689-20260727#parag_026.011', verbatim-'Without prejudice to Article 50 of this Regulation, deployers of high-risk AI systems referred to in Annex III that make decisions or assist in making decisions related to natural persons shall inform the natural persons that they are subject to the use of the high-risk AI system. For high-risk AI systems used for law enforcement purposes Article 13 of Directive (EU) 2016/680 shall apply.']).

citation(eu_reg_2024_1689_art_27_1, [label-'Regulation (EU) 2024/1689 Art 27(1) first subparagraph, first sentence (who performs a fundamental rights impact assessment)', ref-'02024R1689-20260727#parag_027.001', verbatim-'Prior to deploying a high-risk AI system referred to in Article 6(2), with the exception of high-risk AI systems intended to be used in the area listed in point 2 of Annex III, deployers that are bodies governed by public law, or are private entities providing public services, and deployers of high-risk AI systems referred to in points 5 (b) and (c) of Annex III, shall perform an assessment of the impact on fundamental rights that the use of such system may produce.']).

citation(eu_reg_2024_1689_art_27_2, [label-'Regulation (EU) 2024/1689 Art 27(2) first sentence (the assessment applies to the first use)', ref-'02024R1689-20260727#parag_027.002', verbatim-'The obligation laid down in paragraph 1 applies to the first use of the high-risk AI system.']).

citation(eu_reg_2024_1689_art_27_3, [label-'Regulation (EU) 2024/1689 Art 27(3) (notifying the results to the market surveillance authority; exemption in the case of Art 46(1))', ref-'02024R1689-20260727#parag_027.003', verbatim-'Once the assessment referred to in paragraph 1 of this Article has been performed, the deployer shall notify the market surveillance authority of its results, submitting the filled-out template referred to in paragraph 5 of this Article as part of the notification. In the case referred to in Article 46(1), deployers may be exempt from that obligation to notify.']).

citation(eu_reg_2024_1689_art_111_1, [label-'Regulation (EU) 2024/1689 Art 111(1) first sentence (Annex X large-scale IT system components: compliance by 31 December 2030)', ref-'02024R1689-20260727#parag_111.001', verbatim-'AI systems which are components of the large-scale IT systems established by the legal acts listed in Annex X that have been placed on the market or put into service before 2 August 2027 shall be brought into compliance with this Regulation by 31 December 2030.']).

citation(eu_reg_2024_1689_art_111_2, [label-'Regulation (EU) 2024/1689 Art 111(2) (existing high-risk systems: significant changes in design; public authorities by 2 August 2030)', ref-'02024R1689-20260727#parag_111.002', verbatim-'Without prejudice to the application of Article 5 as referred to in Article 113, third paragraph, point (a), this Regulation shall apply to operators of high-risk AI systems, other than the systems referred to in paragraph 1 of this Article, that have been placed on the market or put into service before the date of application of Chapter III referred to in Article 113, only if, as from that date, those systems are subject to significant changes in their designs. In any case, the providers and deployers of high-risk AI systems intended to be used by public authorities shall take the necessary steps to comply with the requirements and obligations laid down in this Regulation by 2 August 2030.']).

citation(eu_reg_2024_1689_art_113_c, [label-'Regulation (EU) 2024/1689 Art 113 third paragraph point (c) (application of Chapter III, Sections 1, 2 and 3)', ref-'02024R1689-20260727#point_113_c', verbatim-'Chapter III, Sections 1, 2, and 3, with the exception of Article 6(5), shall apply from:']).

citation(eu_reg_2024_1689_art_113_c_i, [label-'Regulation (EU) 2024/1689 Art 113 third paragraph point (c)(i) (2 December 2027 for Art 6(2) and Annex III systems)', ref-'02024R1689-20260727#point_113_c_i', verbatim-'2 December 2027 as regards AI systems classified as high-risk pursuant to Article 6(2) and Annex III']).

citation(eu_reg_2024_1689_art_113_c_ii, [label-'Regulation (EU) 2024/1689 Art 113 third paragraph point (c)(ii) (2 August 2028 for Art 6(1) and Annex I systems)', ref-'02024R1689-20260727#point_113_c_ii', verbatim-'2 August 2028 as regards AI systems classified as high-risk pursuant to Article 6(1) and Annex I']).

% ---- marker-only keys (read or applied, never returned) --------------

citation(eu_reg_2024_1689_art_3_9, [label-'Regulation (EU) 2024/1689 Art 3 point (9) definition of placing on the market', ref-'02024R1689-20260727#point_003_9', verbatim-'placing on the market means the first making available of an AI system or a general-purpose AI model on the Union market']).

citation(eu_reg_2024_1689_art_3_11, [label-'Regulation (EU) 2024/1689 Art 3 point (11) definition of putting into service', ref-'02024R1689-20260727#point_003_11', verbatim-'putting into service means the supply of an AI system for first use directly to the deployer or for own use in the Union for its intended purpose']).

citation(eu_reg_2024_1689_art_3_46, [label-'Regulation (EU) 2024/1689 Art 3 point (46) definition of law enforcement', ref-'02024R1689-20260727#point_003_46', verbatim-'law enforcement means activities carried out by law enforcement authorities or on their behalf for the prevention, investigation, detection or prosecution of criminal offences or the execution of criminal penalties, including safeguarding against and preventing threats to public security']).

citation(eu_reg_2024_1689_art_113, [label-'Regulation (EU) 2024/1689 Art 113 second paragraph (general date of application, which does not date Arts 26 and 27)', ref-'02024R1689-20260727#art_113', verbatim-'It shall apply from 2 August 2026. However:']).

citation(eu_reg_2024_1689_annex_iii, [label-'Regulation (EU) 2024/1689 Annex III lead words (high-risk AI systems pursuant to Article 6(2))', ref-'02024R1689-20260727#division_annex_iii', verbatim-'High-risk AI systems pursuant to Article 6(2) are the AI systems listed in any of the following areas:']).

citation(eu_reg_2024_1689_annex_iii_2, [label-'Regulation (EU) 2024/1689 Annex III point 2 (critical infrastructure)', ref-'02024R1689-20260727#point_annex_iii_2', verbatim-'Critical infrastructure: AI systems intended to be used as safety components in the management and operation of critical digital infrastructure, road traffic, or in the supply of water, gas, heating or electricity.']).

citation(eu_reg_2024_1689_annex_iii_5, [label-'Regulation (EU) 2024/1689 Annex III point 5 lead words (essential private and public services and benefits)', ref-'02024R1689-20260727#point_annex_iii_5', verbatim-'Access to and enjoyment of essential private services and essential public services and benefits:']).

citation(eu_reg_2024_1689_annex_iii_5_b, [label-'Regulation (EU) 2024/1689 Annex III point 5(b) (creditworthiness and credit score)', ref-'02024R1689-20260727#point_annex_iii_5_b', verbatim-'AI systems intended to be used to evaluate the creditworthiness of natural persons or establish their credit score, with the exception of AI systems used for the purpose of detecting financial fraud;']).

citation(eu_reg_2024_1689_annex_iii_5_c, [label-'Regulation (EU) 2024/1689 Annex III point 5(c) (life and health insurance risk assessment and pricing)', ref-'02024R1689-20260727#point_annex_iii_5_c', verbatim-'AI systems intended to be used for risk assessment and pricing in relation to natural persons in the case of life and health insurance;']).

% ---- provenance marker ------------------------------------------------
% implements(Key): succeeds for every recorded key and fails for any other,
% so a misspelt marker fails instead of lying.
implements(Key) :-
    citation(Key, _).

% ---- the citation vocabulary: the only keys a RESULT may return -------
citation_vocabulary(eu_reg_2024_1689_art_3_4).
citation_vocabulary(eu_reg_2024_1689_art_26_6).
citation_vocabulary(eu_reg_2024_1689_art_26_7).
citation_vocabulary(eu_reg_2024_1689_art_26_11).
citation_vocabulary(eu_reg_2024_1689_art_27_1).
citation_vocabulary(eu_reg_2024_1689_art_27_2).
citation_vocabulary(eu_reg_2024_1689_art_27_3).
citation_vocabulary(eu_reg_2024_1689_art_111_1).
citation_vocabulary(eu_reg_2024_1689_art_111_2).
citation_vocabulary(eu_reg_2024_1689_art_113_c).
citation_vocabulary(eu_reg_2024_1689_art_113_c_i).
citation_vocabulary(eu_reg_2024_1689_art_113_c_ii).

test(every_vocabulary_key_is_recorded) :-
    findall(Key, citation_vocabulary(Key), Keys),
    length(Keys, 12),
    maplist(implements, Keys).
test(a_recorded_key_is_implemented) :-
    implements(eu_reg_2024_1689_art_26_6).
test(an_unrecorded_key_fails, fail) :-
    implements(eu_reg_2024_1689_art_26).
test(a_marker_only_key_is_recorded) :-
    implements(eu_reg_2024_1689_art_3_46).
test(a_marker_only_key_is_not_returnable, fail) :-
    citation_vocabulary(eu_reg_2024_1689_art_3_46).

:- end_module(citations).
