% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_queries.clausal -- PROPERTY tests for the query layer: one test (or
% more) per query-taxonomy predicate registered in manifest.yaml
% query_interface, and for the vocabulary the query layer serves.
%   #2  serious_incident_reporting_status/2
%   #14 serious_incident_report_duty/4
%   #15 serious_incident_report_timeliness/5
%   #16 serious_incident_reporting_what_if/4
% Run: python -m clausal.testing eu/ai_act/serious_incident_reporting/tests/test_queries.clausal
% =====================================================================
:- module(test_queries, []).
:- use_module(eu/ai_act/serious_incident_reporting/queries, [
    serious_incident_reporting_profile_keys/1,
    serious_incident_reporting_input_problems/2,
    serious_incident_reporting_what_if/4,
    not_applicable_on_date/0,
    report_after_time_limit/0,
    market_surveillance_authority_of_member_state_where_incident_occurred/0,
    corrective_action/0,
    high_risk_classification/0,
    system_under_the_exclusive_competence_of_the_ai_office/0,
    annex_i_high_risk/0,
    no_death_or_serious_harm_to_health/0,
    unsure/0
]).
:- use_module(eu/ai_act/serious_incident_reporting/serious_incident_reporting, [
    serious_incident_report_duty/4,
    serious_incident_report_timeliness/5,
    serious_incident_reporting_status/2
]).
:- use_module(eu/ai_act/serious_incident_reporting/fixtures, [serious_incident_reporting_profile_for/2]).

query_test_profile([attribute(high_risk_classification, annex_iii_high_risk), attribute(placed_before_chapter_iii_application_date, false), attribute(medical_device_or_safety_component_of_one, false), attribute(provider_subject_to_equivalent_union_reporting_obligations, false), attribute(harm_to_health, death_of_a_person), attribute(critical_infrastructure_disruption, false), attribute(fundamental_rights_obligations_infringed, false), attribute(serious_harm_to_property_or_environment, false), attribute(widespread_infringement, false)]).

test(profile_keys_are_the_contract_keys) :-
    serious_incident_reporting_profile_keys(ProfileKeys),
    ProfileKeys == [high_risk_classification, placed_before_chapter_iii_application_date, significant_change_in_design_since_that_date, intended_to_be_used_by_public_authorities, medical_device_or_safety_component_of_one, provider_subject_to_equivalent_union_reporting_obligations, harm_to_health, critical_infrastructure_disruption, fundamental_rights_obligations_infringed, serious_harm_to_property_or_environment, widespread_infringement, report_made_immediately, system_under_the_exclusive_competence_of_the_ai_office].

test(the_re_exported_input_check_answers) :-
    serious_incident_reporting_input_problems([attribute(colour, blue)], [unknown_key(colour)]).

% #2 status.
test(status_reads_the_case_term) :-
    serious_incident_reporting_profile_for(system_not_high_risk, Case),
    serious_incident_reporting_status(Case, not_a_high_risk_ai_system).

% #14 obligation surfacing.
test(duty_surfaces_recipient_days_last_day_and_follow_up) :-
    query_test_profile(Profile),
    serious_incident_report_duty(Profile, date(2028, 1, 10), report_due(Recipient, Days, LastDay, FollowUp), _),
    Recipient == market_surveillance_authority_of_member_state_where_incident_occurred,
    Days == 10,
    LastDay = date(2028, 1, 20),
    length(FollowUp, 5).
test(duty_yields_one_solution) :-
    query_test_profile(Profile),
    findall(Duty-Citations, serious_incident_report_duty(Profile, date(2028, 1, 10), Duty, Citations), Answers),
    length(Answers, 1).

% #15 deadline: the consequence of missing the limit.
test(timeliness_on_the_last_day_needs_the_immediacy) :-
    query_test_profile(Profile),
    serious_incident_report_timeliness(Profile, date(2028, 1, 10), date(2028, 1, 20), indeterminate([report_made_immediately]), []).
test(timeliness_after_the_last_day_is_late) :-
    query_test_profile(Profile),
    serious_incident_report_timeliness(Profile, date(2028, 1, 10), date(2028, 1, 21), report_after_time_limit, Citations),
    member(cite(eu_reg_2024_1689_art_73_4), Citations).
test(timeliness_after_the_last_day_is_not_in_time, fail) :-
    query_test_profile(Profile),
    serious_incident_report_timeliness(Profile, date(2028, 1, 10), date(2028, 1, 21), report_in_time, _).

% #16 what-if.
test(what_if_supplies_a_missing_classification) :-
    serious_incident_reporting_what_if(duty([], date(2028, 1, 10)), high_risk_classification, annex_iii_high_risk, serious_incident_reporting_verdict(indeterminate([placed_before_chapter_iii_application_date]), [])).
test(what_if_an_annex_i_system_before_its_date) :-
    query_test_profile(Profile),
    serious_incident_reporting_what_if(duty(Profile, date(2028, 1, 10)), high_risk_classification, annex_i_high_risk, serious_incident_reporting_verdict(not_applicable_on_date, _)).
test(what_if_the_ai_office_is_competent) :-
    query_test_profile(Profile),
    serious_incident_reporting_what_if(duty(Profile, date(2028, 1, 10)), system_under_the_exclusive_competence_of_the_ai_office, attested(true, attestation(host, stamp, reason, none)), serious_incident_reporting_verdict(report_due(ai_office, 10, _, _), Citations)),
    member(cite(eu_reg_2024_1689_art_75_1a), Citations).
test(what_if_the_ai_office_is_attested_not_competent) :-
    query_test_profile(Profile),
    serious_incident_reporting_what_if(duty(Profile, date(2028, 1, 10)), system_under_the_exclusive_competence_of_the_ai_office, attested(false, attestation(host, stamp, reason, none)), serious_incident_reporting_verdict(report_due(market_surveillance_authority_of_member_state_where_incident_occurred, 10, _, _), _)).
test(what_if_an_unsure_immediacy_is_referred) :-
    query_test_profile(Profile),
    serious_incident_reporting_what_if(timeliness(Profile, date(2028, 1, 10), date(2028, 1, 15)), report_made_immediately, unsure, serious_incident_reporting_verdict(needs_legal_review(open_textured(report_made_immediately, cite(eu_reg_2024_1689_art_73_2)), _), [])).
test(what_if_a_bad_value_is_an_input_problem) :-
    query_test_profile(Profile),
    serious_incident_reporting_what_if(duty(Profile, date(2028, 1, 10)), harm_to_health, unsure, serious_incident_reporting_verdict(input_problems([wrong_type(harm_to_health)]), [])).
test(what_if_replaces_rather_than_duplicates) :-
    query_test_profile(Profile),
    serious_incident_reporting_what_if(duty(Profile, date(2028, 1, 10)), harm_to_health, no_death_or_serious_harm_to_health, serious_incident_reporting_verdict(not_a_serious_incident, _)).

% The served vocabulary.
test(the_vocabulary_names_are_served) :-
    not_applicable_on_date,
    report_after_time_limit,
    market_surveillance_authority_of_member_state_where_incident_occurred,
    corrective_action,
    high_risk_classification,
    system_under_the_exclusive_competence_of_the_ai_office,
    annex_i_high_risk,
    no_death_or_serious_harm_to_health,
    unsure.
% The result constructors are data: they build and destructure as terms.
test(the_constructors_are_data) :-
    Duty = report_due(ai_office, 2, date(2028, 1, 12), []),
    Duty = report_due(Recipient, _, _, _),
    Recipient == ai_office,
    Missing = indeterminate([harm_to_health]),
    Missing = indeterminate([MissingKey]),
    MissingKey == harm_to_health.

:- end_module(test_queries).
