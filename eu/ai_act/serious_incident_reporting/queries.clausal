% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% queries.clausal -- QUERY-COMBINATOR layer for eu/ai_act/serious_incident_reporting.
% A TOP-LAYER consumer: it imports the determination slice's PUBLIC
% predicates it calls, and nothing else.
%
% The two declared query types are served by the slice's contract
% predicates, which the package facade re-exports:
%   #14 obligation_surfacing: serious_incident_report_duty/4 (is the Art 73(1)
%       report due, to whom, by which last day, with which Art 73(6) follow-up);
%   #15 deadline: serious_incident_report_timeliness/5 (was a first report made
%       on a given day in time; the consequence of missing the limit is the
%       verdict report_after_time_limit or report_not_immediate).
%
% This layer adds:
% serious_incident_reporting_what_if/4      (#16 what-if): override one profile key of a
%     request (duty(Profile, AwarenessDate) or timeliness(Profile, AwarenessDate,
%     ReportDate)) and re-evaluate; Result is
%     serious_incident_reporting_verdict(Status, Citations).
% serious_incident_reporting_profile_keys/1: the thirteen profile keys in contract order
% serious_incident_reporting_input_problems/2: the kernel's input check, re-exported
%
% It also SERVES the answer vocabulary of the order as package-root names
% (root_exports): the answer atoms, the recipient atoms, the follow-up
% atoms, the thirteen profile key atoms, the six enumeration atoms and the
% judgement value unsure, each as a 0-arity fact. The result constructors
% are exported as data: they have no clauses and are never called as
% queries; their fields are named by the constructors directive below.
%
% The profile is an attribute list, not a dict, so the override is a pure
% replacement of the attribute (every occurrence of the key is removed and
% one attribute(Key, Value) is added); the order of the attributes does not
% change any answer.
% =====================================================================

:- module(queries, [
    serious_incident_reporting_profile_keys/1,
    serious_incident_reporting_input_problems/2,
    serious_incident_reporting_what_if/4,
    not_applicable_on_date/0,
    not_a_high_risk_ai_system/0,
    not_covered_placed_before_application_date/0,
    not_a_serious_incident/0,
    not_a_reportable_incident/0,
    report_in_time/0,
    report_after_time_limit/0,
    report_not_immediate/0,
    market_surveillance_authority_of_member_state_where_incident_occurred/0,
    national_competent_authority_chosen_by_member_state_where_incident_occurred/0,
    ai_office/0,
    perform_necessary_investigations_without_delay/0,
    risk_assessment_of_the_incident/0,
    corrective_action/0,
    cooperate_with_competent_authorities/0,
    inform_authorities_before_altering_the_system/0,
    report_due/4,
    indeterminate/1,
    needs_legal_review/2,
    open_textured/2,
    inputs_relied_on/1,
    provenance/2,
    input_problems/1,
    unknown_key/1,
    wrong_type/1,
    duplicate_key/1,
    high_risk_classification/0,
    placed_before_chapter_iii_application_date/0,
    significant_change_in_design_since_that_date/0,
    intended_to_be_used_by_public_authorities/0,
    medical_device_or_safety_component_of_one/0,
    provider_subject_to_equivalent_union_reporting_obligations/0,
    harm_to_health/0,
    critical_infrastructure_disruption/0,
    fundamental_rights_obligations_infringed/0,
    serious_harm_to_property_or_environment/0,
    widespread_infringement/0,
    report_made_immediately/0,
    system_under_the_exclusive_competence_of_the_ai_office/0,
    annex_iii_high_risk/0,
    annex_i_high_risk/0,
    not_high_risk/0,
    death_of_a_person/0,
    serious_harm_to_health_without_death/0,
    no_death_or_serious_harm_to_health/0,
    unsure/0
]).

:- use_module(eu/ai_act/serious_incident_reporting/kernel, [serious_incident_reporting_input_problems/2]).
:- use_module(eu/ai_act/serious_incident_reporting/serious_incident_reporting, [decide_serious_incident_reporting/2]).

% RESULT CONSTRUCTORS (exported, never called as queries): data, no clauses.
:- constructors([report_due(recipient, days, last_day, follow_up)]).
:- constructors([indeterminate(missing_keys)]).
:- constructors([needs_legal_review(reason, context)]).
:- constructors([open_textured(input, citation)]).
:- constructors([inputs_relied_on(pairs)]).
:- constructors([provenance(clause, citations)]).
:- constructors([input_problems(problems)]).
:- constructors([unknown_key(key)]).
:- constructors([wrong_type(key)]).
:- constructors([duplicate_key(key)]).

% schema of top-level profile keys: the keys of the order's typed input contract, in its order
serious_incident_reporting_profile_keys([high_risk_classification, placed_before_chapter_iii_application_date, significant_change_in_design_since_that_date, intended_to_be_used_by_public_authorities, medical_device_or_safety_component_of_one, provider_subject_to_equivalent_union_reporting_obligations, harm_to_health, critical_infrastructure_disruption, fundamental_rights_obligations_infringed, serious_harm_to_property_or_environment, widespread_infringement, report_made_immediately, system_under_the_exclusive_competence_of_the_ai_office]).

% #16 what-if: re-evaluate a request with one profile key hypothetically overridden.
serious_incident_reporting_what_if(duty(Profile, AwarenessDate), OverriddenKey, NewValue, Result) :-
    replace_attribute(Profile, OverriddenKey, NewValue, Hypothesis),
    decide_serious_incident_reporting(duty(Hypothesis, AwarenessDate), Result).
serious_incident_reporting_what_if(timeliness(Profile, AwarenessDate, ReportDate), OverriddenKey, NewValue, Result) :-
    replace_attribute(Profile, OverriddenKey, NewValue, Hypothesis),
    decide_serious_incident_reporting(timeliness(Hypothesis, AwarenessDate, ReportDate), Result).

% Profile plumbing: drop every attribute of the key, then add the new one.
replace_attribute(Profile, Key, Value, Hypothesis) :-
    exclude(attribute_with_key(Key), Profile, Others),
    append(Others, [attribute(Key, Value)], Hypothesis).

attribute_with_key(Key, attribute(ElementKey, _)) :-
    ElementKey == Key.

% ---- the answer vocabulary, served as package-root names ---------------
% The no-duty answers of serious_incident_report_duty/4.
not_applicable_on_date.
not_a_high_risk_ai_system.
not_covered_placed_before_application_date.
not_a_serious_incident.
not_a_reportable_incident.

% The timeliness verdicts of serious_incident_report_timeliness/5.
report_in_time.
report_after_time_limit.
report_not_immediate.

% The recipients of report_due/4.
market_surveillance_authority_of_member_state_where_incident_occurred.
national_competent_authority_chosen_by_member_state_where_incident_occurred.
ai_office.

% The follow-up duties of report_due/4, in their fixed order.
perform_necessary_investigations_without_delay.
risk_assessment_of_the_incident.
corrective_action.
cooperate_with_competent_authorities.
inform_authorities_before_altering_the_system.

% The thirteen profile keys (root_exports order).
high_risk_classification.
placed_before_chapter_iii_application_date.
significant_change_in_design_since_that_date.
intended_to_be_used_by_public_authorities.
medical_device_or_safety_component_of_one.
provider_subject_to_equivalent_union_reporting_obligations.
harm_to_health.
critical_infrastructure_disruption.
fundamental_rights_obligations_infringed.
serious_harm_to_property_or_environment.
widespread_infringement.
report_made_immediately.
system_under_the_exclusive_competence_of_the_ai_office.

% The six enumeration atoms.
annex_iii_high_risk.
annex_i_high_risk.
not_high_risk.
death_of_a_person.
serious_harm_to_health_without_death.
no_death_or_serious_harm_to_health.

% The judgement value besides true and false.
unsure.

% ---- tests -------------------------------------------------------------

query_base_profile([attribute(high_risk_classification, annex_iii_high_risk), attribute(placed_before_chapter_iii_application_date, false), attribute(medical_device_or_safety_component_of_one, false), attribute(provider_subject_to_equivalent_union_reporting_obligations, false), attribute(harm_to_health, death_of_a_person), attribute(critical_infrastructure_disruption, false), attribute(fundamental_rights_obligations_infringed, false), attribute(serious_harm_to_property_or_environment, false), attribute(widespread_infringement, false)]).

test(the_schema_has_thirteen_keys) :-
    serious_incident_reporting_profile_keys(Keys),
    length(Keys, 13).
test(what_if_without_any_harm_is_not_a_serious_incident) :-
    query_base_profile(Profile),
    serious_incident_reporting_what_if(duty(Profile, date(2028, 1, 10)), harm_to_health, no_death_or_serious_harm_to_health, serious_incident_reporting_verdict(not_a_serious_incident, [cite(eu_reg_2024_1689_art_3_49)])).
test(what_if_with_a_death_is_still_a_report) :-
    query_base_profile(Profile),
    serious_incident_reporting_what_if(duty(Profile, date(2028, 1, 10)), harm_to_health, death_of_a_person, serious_incident_reporting_verdict(report_due(_, 10, _, _), _)).
test(what_if_critical_infrastructure_shortens_to_two_days) :-
    query_base_profile(Profile),
    serious_incident_reporting_what_if(duty(Profile, date(2028, 1, 10)), critical_infrastructure_disruption, true, serious_incident_reporting_verdict(report_due(_, 2, _, _), _)).
test(what_if_critical_infrastructure_is_not_ten_days, fail) :-
    query_base_profile(Profile),
    serious_incident_reporting_what_if(duty(Profile, date(2028, 1, 10)), critical_infrastructure_disruption, true, serious_incident_reporting_verdict(report_due(_, 10, _, _), _)).
test(what_if_immediacy_makes_a_report_in_time) :-
    query_base_profile(Profile),
    serious_incident_reporting_what_if(timeliness(Profile, date(2028, 1, 10), date(2028, 1, 20)), report_made_immediately, true, serious_incident_reporting_verdict(report_in_time, _)).
test(the_vocabulary_is_served) :-
    not_applicable_on_date,
    report_in_time,
    ai_office,
    unsure,
    annex_iii_high_risk,
    harm_to_health.

:- end_module(queries).
