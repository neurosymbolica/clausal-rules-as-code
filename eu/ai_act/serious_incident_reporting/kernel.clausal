% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% kernel.clausal -- the SHARED FLOOR for eu/ai_act/serious_incident_reporting (temporal family).
% DAG root of the determination-slices layout. It holds ONLY the
% PREDICATES that two or more files CALL.
%
% Source: Regulation (EU) 2024/1689 (Artificial Intelligence Act), consolidated
% text 02024R1689-20260727 (as amended by Regulation (EU) 2026/1744), Formex
% CL2024R1689EN0010010.0001.xml, sha256
% dfeac37ec03557cfe751427429c6314c11792f88bf654a381484e5c7239f7893:
% Art 3(49), Art 3(61), Art 73(1) to (6), (9) and (10), Art 111(2) and
% Art 113 (first and second paragraphs, third paragraph point (c)(i) and (ii)).
%
% What lives here, and who calls it:
%   serious_incident_reporting_input_problems/2  THE INPUT CHECK (written by the
%       scaffold from the typed input contract; called by queries.clausal and the
%       determination slice).
%   serious_incident_reporting_root_key/2        the twelve profile keys with their
%       0-based root_exports position (the slice names the FIRST absent key; the
%       unsure rule in queries.clausal names the FIRST unsure judgement).
%   serious_incident_reporting_key_type/2        each key with its contract type
%       (enum(Atoms), boolean or judgement); queries.clausal reads which keys are
%       judgements, the input check reads every type.
%   calendar_date_t/2                            T is true when a term is a ground
%       date(Year, Month, Day) of a real calendar day, else false; it never raises
%       (queries.clausal steps (0) and (12); fixtures).
%
% Atoms and data terms need NO declaration and NO import. The comment block below
% only RECORDS the result terms so every file spells them alike.
%
% Result terms.
%   serious_incident_reporting_verdict(Status, Citations): the slice's verdict.
%     Status is the DUTY of serious_incident_report_duty/4: one of
%       report_due(Recipient, Days, LastDay, FollowUp)
%         Recipient  market_surveillance_authority_of_member_state_where_incident_occurred
%                    | national_competent_authority_chosen_by_member_state_where_incident_occurred
%         Days       the integer 2 (Art 73(3)), 10 (Art 73(4)) or 15 (Art 73(2))
%         LastDay    date(Y, M, D): AwarenessDate plus Days calendar days
%         FollowUp   [perform_necessary_investigations_without_delay,
%                     risk_assessment_of_the_incident, corrective_action,
%                     cooperate_with_competent_authorities,
%                     inform_authorities_before_altering_the_system]  (Art 73(6))
%       not_applicable_on_date | not_a_high_risk_ai_system
%       | not_covered_placed_before_application_date | not_a_serious_incident
%       | not_a_reportable_incident
%       indeterminate([Key])  (one bare key atom; the bare atom is never written)
%     Citations is a set-like list of cite(Key) terms ([] when not final).
%   The timeliness VERDICT of serious_incident_report_timeliness/5 is one of
%       report_in_time | report_after_time_limit | report_not_immediate,
%       or one of the five no-duty atoms above, passed through, or indeterminate([Key]).
%   Built by queries.clausal only (never by the slice):
%       needs_legal_review(open_textured(JudgementKey, cite(CitationKey)),
%                          [inputs_relied_on(Pairs)])   Pairs: Key-Value terms
%       input_problems(Problems)  Problems: duplicate_key(Key), wrong_type(Key)
%                                 (Key also profile, awareness_date, report_date),
%                                 unknown_key(Key).
% =====================================================================

:- module(kernel, [
    serious_incident_reporting_input_problems/2,
    serious_incident_reporting_root_key/2,
    serious_incident_reporting_key_type/2,
    calendar_date_t/2
]).

:- use_module(library(reif), [memberd_t/3]).
:- use_module(kit/deadline_lib, [month_last_day/3]).

% ---- the twelve profile keys in root_exports order (0-based) --------
serious_incident_reporting_root_key(high_risk_classification, 0).
serious_incident_reporting_root_key(placed_before_chapter_iii_application_date, 1).
serious_incident_reporting_root_key(significant_change_in_design_since_that_date, 2).
serious_incident_reporting_root_key(intended_to_be_used_by_public_authorities, 3).
serious_incident_reporting_root_key(medical_device_or_safety_component_of_one, 4).
serious_incident_reporting_root_key(provider_subject_to_equivalent_union_reporting_obligations, 5).
serious_incident_reporting_root_key(harm_to_health, 6).
serious_incident_reporting_root_key(critical_infrastructure_disruption, 7).
serious_incident_reporting_root_key(fundamental_rights_obligations_infringed, 8).
serious_incident_reporting_root_key(serious_harm_to_property_or_environment, 9).
serious_incident_reporting_root_key(widespread_infringement, 10).
serious_incident_reporting_root_key(report_made_immediately, 11).

serious_incident_reporting_key_type(Key, Type) :-
    key_type(Key, Type).

% ---- input checks: the problems a profile has, if any -----------
% serious_incident_reporting_input_problems(Profile, Problems): Problems = [] means the profile can be
% judged. Written from the order's typed input contract
% (input_contract.types.profile: attribute_list).
% It gives exactly one answer for every Profile:
% - a Profile that is not an attribute list [attribute(Key, Value), ...] (an unbound
%   Profile, a partial list, an unbound element, an element that is not
%   attribute(_, _)) gives [wrong_type(profile)];
% - otherwise, for each contract key in the contract's key order, duplicate_key(Key) when
%   the key occurs more than once in Profile (none of its values is read), else
%   wrong_type(Key) when its one value is outside its type (an unbound value included);
%   then unknown_key(Key) for each key outside the contract, in the order of its first
%   occurrence in Profile, each once. A Key that is not an atom (a number, a string, a
%   compound, an unbound variable) is a key outside the contract, named AS GIVEN
%   (INTERFACE - THE INPUT CHECK: unknown_key(KEY), KEY as given) and compared by
%   identity (==), never unified. An unbound part of such a key is bound to the atom
%   unbound_key when it is named, so the key as given and the answer are one ground
%   term. An absent key is not a problem.
serious_incident_reporting_input_problems(Profile, Problems) :-
    attribute_list_t(Profile, IsAttributeList),
    profile_problems(IsAttributeList, Profile, Problems).

profile_problems(false, _, [wrong_type(profile)]).
profile_problems(true, Profile, Problems) :-
    Keys = [high_risk_classification, placed_before_chapter_iii_application_date, significant_change_in_design_since_that_date, intended_to_be_used_by_public_authorities, medical_device_or_safety_component_of_one, provider_subject_to_equivalent_union_reporting_obligations, harm_to_health, critical_infrastructure_disruption, fundamental_rights_obligations_infringed, serious_harm_to_property_or_environment, widespread_infringement, report_made_immediately],
    unknown_keys(Profile, Keys, UnknownKeyProblems),
    key_problems(Keys, Profile, UnknownKeyProblems, Problems).

% The contract: each key and the type of its value.
key_type(high_risk_classification, enum([annex_iii_high_risk, annex_i_high_risk, not_high_risk])).
key_type(placed_before_chapter_iii_application_date, boolean).
key_type(significant_change_in_design_since_that_date, judgement).
key_type(intended_to_be_used_by_public_authorities, boolean).
key_type(medical_device_or_safety_component_of_one, boolean).
key_type(provider_subject_to_equivalent_union_reporting_obligations, judgement).
key_type(harm_to_health, enum([death_of_a_person, serious_harm_to_health_without_death, no_death_or_serious_harm_to_health])).
key_type(critical_infrastructure_disruption, boolean).
key_type(fundamental_rights_obligations_infringed, boolean).
key_type(serious_harm_to_property_or_environment, boolean).
key_type(widespread_infringement, judgement).
key_type(report_made_immediately, judgement).

% attribute_list_t(Term, T): T is true when Term is a proper list of attribute(Key, Value)
% items; false for anything else, an unbound Term or a partial list included.
attribute_list_t(Term, false) :-
    var(Term).
attribute_list_t(Term, true) :-
    Term == [].
attribute_list_t(Term, T) :-
    nonvar(Term),
    Term = [Element|Elements],
    attribute_t(Element, ElementIsAttribute),
    attribute_list_t(Elements, ElementsAreAttributes),
    truth_and(ElementIsAttribute, ElementsAreAttributes, T).
attribute_list_t(Term, false) :-
    nonvar(Term),
    Term \== [],
    Term \= [_|_].

attribute_t(Element, false) :-
    var(Element).
attribute_t(Element, true) :-
    nonvar(Element),
    Element = attribute(_, _).
attribute_t(Element, false) :-
    nonvar(Element),
    Element \= attribute(_, _).

% Unknown keys, in profile order, each once: Known grows by each key named.
% Membership is by identity, so an unbound or compound key is never unified.
unknown_keys([], _, []).
unknown_keys([attribute(Key, _)|Elements], Known, Problems) :-
    identical_member_t(Key, Known, IsKnown),
    name_unknown_key(IsKnown, Key, Known, Elements, Problems).

name_unknown_key(true, _, Known, Elements, Problems) :-
    unknown_keys(Elements, Known, Problems).
% A key outside the twelve is unknown_key(KEY), KEY as given; an unbound part of it is
% bound to the atom unbound_key, so the answer is ground (one ground answer per query).
name_unknown_key(false, Key, Known, Elements, [unknown_key(Key)|Problems]) :-
    term_variables(Key, KeyVariables),
    maplist(=(unbound_key), KeyVariables),
    unknown_keys(Elements, [Key|Known], Problems).

% identical_member_t(Term, List, T): T is true when List holds an item identical (==) to Term.
identical_member_t(_, [], false).
identical_member_t(Term, [Item|_], true) :-
    Term == Item.
identical_member_t(Term, [Item|Items], T) :-
    Term \== Item,
    identical_member_t(Term, Items, T).

% Contract keys, in contract order: duplicate_key(Key) when the key occurs more than once
% (none of its values is read), else wrong_type(Key) when its one value is outside the
% key's type. An absent key has no value to check.
key_problems([], _, Problems, Problems).
key_problems([Key|Keys], Profile, LaterProblems, Problems) :-
    key_type(Key, Type),
    key_occurrences(Profile, Key, Occurrences),
    key_problems(Keys, Profile, LaterProblems, KeyProblems),
    name_key_problem(Occurrences, Key, Type, Profile, KeyProblems, Problems).

% key_occurrences(Elements, Key, Occurrences): none, one or many items give Key.
key_occurrences([], _, none).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey == Key,
    key_occurrences(Elements, Key, RestOccurrences),
    one_more_occurrence(RestOccurrences, Occurrences).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey \== Key,
    key_occurrences(Elements, Key, Occurrences).

one_more_occurrence(none, one).
one_more_occurrence(one, many).
one_more_occurrence(many, many).

name_key_problem(none, _, _, _, Problems, Problems).
name_key_problem(many, Key, _, _, Problems, [duplicate_key(Key)|Problems]).
name_key_problem(one, Key, Type, Profile, KeyProblems, Problems) :-
    values_in_type_t(Profile, Key, Type, InType),
    name_wrong_type(InType, Key, KeyProblems, Problems).

name_wrong_type(true, _, Problems, Problems).
name_wrong_type(false, Key, Problems, [wrong_type(Key)|Problems]).

% values_in_type_t(Elements, Key, Type, T): T is true when every value Elements gives Key is
% in Type (true when Elements gives Key none).
values_in_type_t([], _, _, true).
values_in_type_t([attribute(ElementKey, Value)|Elements], Key, Type, T) :-
    ElementKey == Key,
    value_in_type_t(Type, Value, ValueInType),
    values_in_type_t(Elements, Key, Type, RestInType),
    truth_and(ValueInType, RestInType, T).
values_in_type_t([attribute(ElementKey, _)|Elements], Key, Type, T) :-
    ElementKey \== Key,
    values_in_type_t(Elements, Key, Type, T).

% A value with an unbound part is outside every type; a ground one is checked.
value_in_type_t(Type, Value, T) :-
    term_variables(Value, Variables),
    ground_value_in_type_t(Variables, Type, Value, T).

ground_value_in_type_t([_|_], _, _, false).
ground_value_in_type_t([], Type, Value, T) :-
    in_type_t(Type, Value, T).

% in_type_t(Type, Value, T): one clause per type, for a ground Value.
in_type_t(judgement, Value, T) :-
    in_type_t(one_of([boolean, enum([unsure])]), Value, T).

in_type_t(boolean, Value, T) :-
    memberd_t(Value, [true, false], T).

in_type_t(enum(Values), Value, T) :-
    memberd_t(Value, Values, T).

in_type_t(one_of(Types), Value, T) :-
    in_some_type_t(Types, Value, T).

truth_and(true, T, T).
truth_and(false, _, false).

% in_some_type_t(Types, Value, T): T is true when Value is in at least one of Types.
in_some_type_t([], _, false).
in_some_type_t([Type|Types], Value, T) :-
    in_type_t(Type, Value, InType),
    in_some_type_t(Types, Value, InAnother),
    truth_or(InType, InAnother, T).

truth_or(true, _, true).
truth_or(false, T, T).

% ---- the date arguments: a real calendar day --------------------
% calendar_date_t(Term, T): T is true when Term is a ground date(Year, Month, Day) of three
% integers that names a real calendar day (year 1 to 9999, month 1 to 12, day 1 to the
% last day of that month, leap years included); false for anything else. It never
% raises: the type of every field is tested before any arithmetic. (Q9: a date that is
% not a real calendar day is wrong_type(awareness_date) or wrong_type(report_date).)
calendar_date_t(Term, false) :-
    var(Term).
calendar_date_t(Term, false) :-
    nonvar(Term),
    Term \= date(_, _, _).
calendar_date_t(Term, T) :-
    nonvar(Term),
    Term = date(Year, Month, Day),
    integer_t(Year, YearIsInteger),
    integer_t(Month, MonthIsInteger),
    integer_t(Day, DayIsInteger),
    truth_and(YearIsInteger, MonthIsInteger, YearAndMonthAreIntegers),
    truth_and(YearAndMonthAreIntegers, DayIsInteger, FieldsAreIntegers),
    integer_fields_date_t(FieldsAreIntegers, Year, Month, Day, T).

% integer_t(Value, T): T is true when Value is an integer (an unbound Value is not).
integer_t(Value, T) :-
    aggregate_all(count, integer(Value), Count),
    count_truth(Count, T).

count_truth(0, false).
count_truth(1, true).

integer_fields_date_t(false, _, _, _, false).
integer_fields_date_t(true, Year, Month, Day, T) :-
    range_t(Year, 1, 9999, YearInRange),
    range_t(Month, 1, 12, MonthInRange),
    truth_and(YearInRange, MonthInRange, YearAndMonthInRange),
    month_day_t(YearAndMonthInRange, Year, Month, Day, T).

month_day_t(false, _, _, _, false).
month_day_t(true, Year, Month, Day, T) :-
    month_last_day(Year, Month, LastDay),
    range_t(Day, 1, LastDay, T).

% range_t(Value, Low, High, T): for an integer Value, T is true when Low =< Value =< High.
range_t(Value, Low, High, true) :-
    Value >= Low,
    Value =< High.
range_t(Value, Low, _, false) :-
    Value < Low.
range_t(Value, Low, High, false) :-
    Value >= Low,
    Value > High.

:- end_module(kernel).
