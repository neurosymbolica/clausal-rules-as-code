% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/ai_act/serious_incident_reporting.
%
% Source of every record: Regulation (EU) 2024/1689 (Artificial Intelligence
% Act), pinned unit text 02024R1689-20260727 (consolidated text as amended by
% Regulation (EU) 2026/1744, valid from 27 July 2026; Formex source
% CL2024R1689EN0010010.0001.xml, sha256
% dfeac37ec03557cfe751427429c6314c11792f88bf654a381484e5c7239f7893).
% The ref of each record is the pinned unit id. The verbatim is an exact
% substring of that pinned unit text (the pinned Formex text of Art 3 drops
% the quotation marks around defined terms, Q12; it is quoted as pinned).
%
% Keys returned in answers are the canonical lexicon keys of the order's
% citation vocabulary. Keys recorded only for provenance markers (never
% returned): eu_reg_2024_1689_art_3_49_a, eu_reg_2024_1689_art_3_49_b,
% eu_reg_2024_1689_art_3_49_d, eu_reg_2024_1689_art_73_5,
% eu_reg_2024_1689_art_113.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

citation(eu_reg_2024_1689_art_3_49, [label-'Regulation (EU) 2024/1689 Art 3 point (49) definition of serious incident', ref-'02024R1689-20260727#point_003_49', verbatim-'serious incident means an incident or malfunctioning of an AI system that directly or indirectly leads to any of the following:']).

citation(eu_reg_2024_1689_art_3_49_a, [label-'Regulation (EU) 2024/1689 Art 3 point (49)(a) death of a person or serious harm to health', ref-'02024R1689-20260727#point_003_49_a', verbatim-'the death of a person, or serious harm to a person']).

citation(eu_reg_2024_1689_art_3_49_b, [label-'Regulation (EU) 2024/1689 Art 3 point (49)(b) serious and irreversible disruption of critical infrastructure', ref-'02024R1689-20260727#point_003_49_b', verbatim-'a serious and irreversible disruption of the management or operation of critical infrastructure']).

citation(eu_reg_2024_1689_art_3_49_c, [label-'Regulation (EU) 2024/1689 Art 3 point (49)(c) infringement of obligations protecting fundamental rights', ref-'02024R1689-20260727#point_003_49_c', verbatim-'the infringement of obligations under Union law intended to protect fundamental rights']).

citation(eu_reg_2024_1689_art_3_49_d, [label-'Regulation (EU) 2024/1689 Art 3 point (49)(d) serious harm to property or the environment', ref-'02024R1689-20260727#point_003_49_d', verbatim-'serious harm to property or the environment']).

citation(eu_reg_2024_1689_art_3_61, [label-'Regulation (EU) 2024/1689 Art 3 point (61) definition of widespread infringement', ref-'02024R1689-20260727#point_003_61', verbatim-'widespread infringement means any act or omission contrary to Union law protecting the interest of individuals']).

citation(eu_reg_2024_1689_art_73_1, [label-'Regulation (EU) 2024/1689 Art 73(1) duty of providers to report serious incidents', ref-'02024R1689-20260727#parag_073.001', verbatim-'Providers of high-risk AI systems placed on the Union market shall report any serious incident to the market surveillance authorities of the Member States where that incident occurred.']).

citation(eu_reg_2024_1689_art_73_2, [label-'Regulation (EU) 2024/1689 Art 73(2) first subparagraph, immediately and not later than 15 days', ref-'02024R1689-20260727#parag_073.002', verbatim-'not later than 15 days after the provider or, where applicable, the deployer, becomes aware of the serious incident']).

citation(eu_reg_2024_1689_art_73_3, [label-'Regulation (EU) 2024/1689 Art 73(3) widespread infringement or point (49)(b) incident, not later than two days', ref-'02024R1689-20260727#parag_073.003', verbatim-'in the event of a widespread infringement or a serious incident as defined in Article 3, point (49)(b), the report referred to in paragraph 1 of this Article shall be provided immediately, and not later than two days after the provider or, where applicable, the deployer becomes aware of that incident']).

citation(eu_reg_2024_1689_art_73_4, [label-'Regulation (EU) 2024/1689 Art 73(4) death of a person, not later than 10 days', ref-'02024R1689-20260727#parag_073.004', verbatim-'in the event of the death of a person, the report shall be provided immediately after the provider or the deployer has established, or as soon as it suspects, a causal relationship between the high-risk AI system and the serious incident, but not later than 10 days after the date on which the provider or, where applicable, the deployer becomes aware of the serious incident']).

citation(eu_reg_2024_1689_art_73_5, [label-'Regulation (EU) 2024/1689 Art 73(5) incomplete initial report followed by a complete report', ref-'02024R1689-20260727#parag_073.005', verbatim-'Where necessary to ensure timely reporting, the provider or, where applicable, the deployer, may submit an initial report that is incomplete, followed by a complete report.']).

citation(eu_reg_2024_1689_art_73_6, [label-'Regulation (EU) 2024/1689 Art 73(6) investigations, risk assessment, corrective action and cooperation after the report', ref-'02024R1689-20260727#parag_073.006', verbatim-'Following the reporting of a serious incident pursuant to paragraph 1, the provider shall, without delay, perform the necessary investigations in relation to the serious incident and the AI system concerned.']).

citation(eu_reg_2024_1689_art_73_9, [label-'Regulation (EU) 2024/1689 Art 73(9) Annex III systems of providers with equivalent Union reporting obligations', ref-'02024R1689-20260727#parag_073.009', verbatim-'the notification of serious incidents shall be limited to those referred to in Article 3, point (49)(c).']).

citation(eu_reg_2024_1689_art_73_10, [label-'Regulation (EU) 2024/1689 Art 73(10) devices and safety components of devices under Regulations (EU) 2017/745 and 2017/746', ref-'02024R1689-20260727#parag_073.010', verbatim-'shall be made to the national competent authority chosen for that purpose by the Member States where the incident occurred']).

citation(eu_reg_2024_1689_art_75_1, [label-'Regulation (EU) 2024/1689 Art 75(1) exclusive competence of the AI Office', ref-'02024R1689-20260727#parag_075.001', verbatim-'The AI Office shall be exclusively competent for the supervision and enforcement of the obligations under this Regulation in relation to the following AI systems:']).

citation(eu_reg_2024_1689_art_75_1a, [label-'Regulation (EU) 2024/1689 Art 75(1a) first and second sentences, report to the AI Office', ref-'02024R1689-20260727#parag_075.001A', verbatim-'By way of derogation from Article 73, providers of high-risk AI systems subject to the competence of the AI Office pursuant to paragraph 1 of this Article shall report any serious incidents to the AI Office. Article 73 (2) to (9), shall apply mutatis mutandis.']).

citation(eu_reg_2024_1689_art_111_2, [label-'Regulation (EU) 2024/1689 Art 111(2) high-risk AI systems placed on the market or put into service before the date of application', ref-'02024R1689-20260727#parag_111.002', verbatim-'only if, as from that date, those systems are subject to significant changes in their designs. In any case, the providers and deployers of high-risk AI systems intended to be used by public authorities shall take the necessary steps to comply with the requirements and obligations laid down in this Regulation by 2 August 2030.']).

citation(eu_reg_2024_1689_art_113, [label-'Regulation (EU) 2024/1689 Art 113 second paragraph, general date of application', ref-'02024R1689-20260727#art_113', verbatim-'It shall apply from 2 August 2026.']).

citation(eu_reg_2024_1689_art_113_c, [label-'Regulation (EU) 2024/1689 Art 113 third paragraph point (c), application of Chapter III Sections 1 to 3', ref-'02024R1689-20260727#point_113_c', verbatim-'Chapter III, Sections 1, 2, and 3, with the exception of Article 6(5), shall apply from:']).

citation(eu_reg_2024_1689_art_113_c_i, [label-'Regulation (EU) 2024/1689 Art 113 third paragraph point (c)(i), 2 December 2027 for Article 6(2) and Annex III', ref-'02024R1689-20260727#point_113_c_i', verbatim-'2 December 2027 as regards AI systems classified as high-risk pursuant to Article 6(2) and Annex III']).

citation(eu_reg_2024_1689_art_113_c_ii, [label-'Regulation (EU) 2024/1689 Art 113 third paragraph point (c)(ii), 2 August 2028 for Article 6(1) and Annex I', ref-'02024R1689-20260727#point_113_c_ii', verbatim-'2 August 2028 as regards AI systems classified as high-risk pursuant to Article 6(1) and Annex I']).

% implements(Key): the provenance marker. Succeeds for every recorded key and
% fails for a key not recorded here.
implements(Key) :-
    citation(Key, _).

test(a_recorded_key_is_implemented) :-
    implements(eu_reg_2024_1689_art_73_1).
test(an_unrecorded_key_is_not_implemented, fail) :-
    implements(eu_reg_2024_1689_art_73_99).

:- end_module(citations).
