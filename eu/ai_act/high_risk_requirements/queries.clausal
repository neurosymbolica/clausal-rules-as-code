% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% queries.clausal -- QUERY-COMBINATOR layer for eu/ai_act/high_risk_requirements.
% A TOP-LAYER consumer: it imports the determination slice's PUBLIC
% predicates it calls (and implements/1 for its provenance markers).
%
% Query types served (manifest query_interface):
%   #3  status determination  high_risk_requirement_status/5 (the slice)
%   #7  justification         high_risk_requirements_checklist/2 (the slice):
%                             one item per requirement or element, each
%                             carrying its cite(...) provenance
%   #14 obligation surfacing  high_risk_requirements_obligations/3 (here)
%   #15 deadline              high_risk_requirements_compliance_date/4 (here)
%   #16 what-if               high_risk_requirements_what_if/4 (here)
%
% high_risk_requirements_profile_keys/1   the fourteen profile keys, contract order
% high_risk_requirements_input_problems/2 THE INPUT CHECK, re-exported from the kernel
% high_risk_requirements_what_if/4        override one key of the case's profile,
%                                         then re-decide
% high_risk_requirements_obligations/3    the Section 2 requirements that bind the
%                                         system on a day
% high_risk_requirements_compliance_date/4 the first day from which a requirement
%                                         applies (Art 113(c), Art 111)
%
% Every answer here is a projection of the called contract
% (high_risk_requirement_status/5): no answer of the contract is changed.
% PROFILE is an attribute list, so the what-if edits it in place of the
% dict-based override_key/4 of kit/query_combinators.
%
% This module also owns the RESULT CONSTRUCTORS of the order (exported,
% never called as queries; data terms with no clauses) and the ROOT EXPORT
% atoms: the fourteen profile keys, the nine REQUIREMENT atoms, the
% thirty-seven ELEMENT atoms and the judgement value unsure, each a bare
% zero-arity fact.
% =====================================================================

:- module(queries, [
    high_risk_requirements_profile_keys/1,
    high_risk_requirements_input_problems/2,
    high_risk_requirements_what_if/4,
    high_risk_requirements_obligations/3,
    high_risk_requirements_compliance_date/4,
    date/3,
    cite/1,
    attribute/2,
    indeterminate/1,
    needs_legal_review/2,
    open_textured/2,
    inputs_relied_on/1,
    provenance/2,
    input_problems/1,
    unknown_key/1,
    wrong_type/1,
    duplicate_key/1,
    system_is_a_high_risk_ai_system_listed_in_annex_iii/0,
    system_is_a_high_risk_ai_system_under_article_6_1_and_annex_i/0,
    system_listed_under_point_1_a_of_annex_iii/0,
    used_for_the_purposes_of_law_enforcement_migration_border_control_or_asylum/0,
    union_or_national_law_considers_the_separate_verification_disproportionate/0,
    uses_techniques_involving_the_training_of_ai_models_with_data/0,
    provider_is_an_sme_including_a_start_up_or_an_smc/0,
    component_of_an_annex_x_large_scale_it_system_placed_on_the_market_or_put_into_service_before_2_august_2027/0,
    placed_on_the_market_or_put_into_service_before_the_chapter_iii_date/0,
    significant_changes_in_design_as_from_the_chapter_iii_date/0,
    intended_to_be_used_by_public_authorities/0,
    system_is_a_component_of_products/0,
    pre_determined_changes_to_the_system_and_its_performance/0,
    related_to_a_product_covered_by_annex_i_section_a/0,
    risk_management_system/0,
    data_and_data_governance/0,
    technical_documentation/0,
    record_keeping/0,
    minimum_logging_capabilities_for_point_1_a_systems/0,
    transparency_and_instructions_for_use/0,
    human_oversight/0,
    separate_verification_by_at_least_two_natural_persons/0,
    accuracy_robustness_and_cybersecurity/0,
    annex_iv_point_1_a/0,
    annex_iv_point_1_b/0,
    annex_iv_point_1_c/0,
    annex_iv_point_1_d/0,
    annex_iv_point_1_e/0,
    annex_iv_point_1_f/0,
    annex_iv_point_1_g/0,
    annex_iv_point_1_h/0,
    annex_iv_point_2_a/0,
    annex_iv_point_2_b/0,
    annex_iv_point_2_c/0,
    annex_iv_point_2_d/0,
    annex_iv_point_2_e/0,
    annex_iv_point_2_f/0,
    annex_iv_point_2_g/0,
    annex_iv_point_2_h/0,
    annex_iv_point_3/0,
    annex_iv_point_4/0,
    annex_iv_point_5/0,
    annex_iv_point_6/0,
    annex_iv_point_7/0,
    annex_iv_point_8/0,
    annex_iv_point_9/0,
    article_11_2_information_under_annex_i_section_a_legislation/0,
    article_13_3_point_a/0,
    article_13_3_point_b_i/0,
    article_13_3_point_b_ii/0,
    article_13_3_point_b_iii/0,
    article_13_3_point_b_iv/0,
    article_13_3_point_b_v/0,
    article_13_3_point_b_vi/0,
    article_13_3_point_b_vii/0,
    article_13_3_point_c/0,
    article_13_3_point_d/0,
    article_13_3_point_e/0,
    article_13_3_point_f/0,
    article_15_3_levels_of_accuracy_and_accuracy_metrics/0,
    unsure/0
]).

:- use_module(eu/ai_act/high_risk_requirements/kernel, [high_risk_requirements_input_problems/2]).
:- use_module(eu/ai_act/high_risk_requirements/high_risk_requirements, [
    decide_high_risk_requirements/2,
    high_risk_requirement_status/5
]).
:- use_module(eu/ai_act/high_risk_requirements/citations, [implements/1]).

% ---- RESULT CONSTRUCTORS (exported, never called as queries; data, no clauses) ----
:- constructors([
    date(year, month, day),
    cite(key),
    attribute(key, value),
    indeterminate(missing_keys),
    needs_legal_review(reason, context),
    open_textured(input, citation),
    inputs_relied_on(pairs),
    provenance(clause, citations),
    input_problems(problems),
    unknown_key(key),
    wrong_type(key),
    duplicate_key(key)
]).

% ---- ROOT EXPORTS: the profile keys, in contract order --------------------
system_is_a_high_risk_ai_system_listed_in_annex_iii.
system_is_a_high_risk_ai_system_under_article_6_1_and_annex_i.
system_listed_under_point_1_a_of_annex_iii.
used_for_the_purposes_of_law_enforcement_migration_border_control_or_asylum.
union_or_national_law_considers_the_separate_verification_disproportionate.
uses_techniques_involving_the_training_of_ai_models_with_data.
provider_is_an_sme_including_a_start_up_or_an_smc.
component_of_an_annex_x_large_scale_it_system_placed_on_the_market_or_put_into_service_before_2_august_2027.
placed_on_the_market_or_put_into_service_before_the_chapter_iii_date.
significant_changes_in_design_as_from_the_chapter_iii_date.
intended_to_be_used_by_public_authorities.
system_is_a_component_of_products.
pre_determined_changes_to_the_system_and_its_performance.
related_to_a_product_covered_by_annex_i_section_a.

% ---- ROOT EXPORTS: the REQUIREMENT atoms -----------------------------------
risk_management_system.
data_and_data_governance.
technical_documentation.
record_keeping.
minimum_logging_capabilities_for_point_1_a_systems.
transparency_and_instructions_for_use.
human_oversight.
separate_verification_by_at_least_two_natural_persons.
accuracy_robustness_and_cybersecurity.

% ---- ROOT EXPORTS: the ELEMENT atoms ---------------------------------------
annex_iv_point_1_a.
annex_iv_point_1_b.
annex_iv_point_1_c.
annex_iv_point_1_d.
annex_iv_point_1_e.
annex_iv_point_1_f.
annex_iv_point_1_g.
annex_iv_point_1_h.
annex_iv_point_2_a.
annex_iv_point_2_b.
annex_iv_point_2_c.
annex_iv_point_2_d.
annex_iv_point_2_e.
annex_iv_point_2_f.
annex_iv_point_2_g.
annex_iv_point_2_h.
annex_iv_point_3.
annex_iv_point_4.
annex_iv_point_5.
annex_iv_point_6.
annex_iv_point_7.
annex_iv_point_8.
annex_iv_point_9.
article_11_2_information_under_annex_i_section_a_legislation.
