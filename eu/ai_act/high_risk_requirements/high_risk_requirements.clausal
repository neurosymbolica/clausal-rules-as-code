requirement_row(accuracy_robustness_and_cybersecurity, no_own_condition, plain, [cite(eu_reg_2024_1689_art_8_1), cite(eu_reg_2024_1689_art_15_1)]).

% THE NOT-APPLYING CITATIONS of the two requirements with conditions of their own.
not_applying_citation_row(minimum_logging_capabilities_for_point_1_a_systems, [cite(eu_reg_2024_1689_art_12_3)]).
not_applying_citation_row(separate_verification_by_at_least_two_natural_persons, [cite(eu_reg_2024_1689_art_14_5)]).

