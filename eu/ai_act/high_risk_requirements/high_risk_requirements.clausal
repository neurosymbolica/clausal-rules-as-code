requirement_row(risk_management_system, no_own_condition, plain, [cite(eu_reg_2024_1689_art_8_1), cite(eu_reg_2024_1689_art_9_1)]).
requirement_row(data_and_data_governance, no_own_condition, data_sets, [cite(eu_reg_2024_1689_art_8_1), cite(eu_reg_2024_1689_art_10_1)]).
