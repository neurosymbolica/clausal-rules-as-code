% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% high_risk_requirements.clausal -- the high_risk_requirements DETERMINATION for
% eu/ai_act/high_risk_requirements, self-contained top to bottom: its statutory
% VALUE facts (the Chapter III dates and the Art 111 compliance dates, the
% requirement table and the element table, each row carrying ready-made
% cite(Key) terms), its ladder over complete profiles, its two called queries,
% its checklist and its verdict assembly.
%
% Source: Regulation (EU) 2024/1689 (Artificial Intelligence Act), consolidated
% text 02024R1689-20260727: Art 3, points (8), (9), (11), (14a), (14b) (read into
% the keys); Art 8(1); Art 9(1); Art 10(1) and (6); Art 11(1) and (2); Art 12(1)
% and (3); Art 13(1), (2) and (3); Art 14(1) and (5); Art 15(1) and (3); Annex IV;
% Art 111(1) and (2); Art 113, third paragraph, point (c).
%
% THE CALLED CONTRACT:
%   high_risk_requirement_status(Profile, Requirement, AssessmentDate, Result, Citations)
%   documentation_element_status(Profile, Element, Result, Citations)
% Each takes step (0), the input problems, first; then hands THE LADDER (the
% answer of a COMPLETE profile) to THE STATUS RULE (settle_status/6, the same
% rule as the kernel's high_risk_requirements_settle/6, run in THIS module so
% that the ladder closures resolve here), which gives the answer, the missing
% key (indeterminate([Key])) or the referral (needs_legal_review(...)).
%
% PRECEDENCE (defeasibility, reading (15)): the ladder is a chain of steps,
% each a pair of complementary clauses on a reified truth value; a step whose
% test is met defeats every later step. No cut, no if-then-else, no once/1.
% Open-textured judgements (significant changes in design; intended to be used
% by public authorities) are never decided here: the caller states them, and an
% unsure judgement that matters goes to a lawyer through the status rule.
%
% FACADE: decide_high_risk_requirements(Case, high_risk_requirements_verdict(Result, Citations))
% with Case one of requirement_case(Profile, Requirement, AssessmentDate) or
% element_case(Profile, Element); Result and Citations exactly as the called
% contract gives them.
% =====================================================================

:- module(high_risk_requirements, [
    decide_high_risk_requirements/2,
    high_risk_requirements_status/2,
    high_risk_requirements_checklist/2,
    high_risk_requirements_decision_resolvable/1,
    high_risk_requirements_status_values/1,
    high_risk_requirement_status/5,
    documentation_element_status/4,
    not_applicable_on_date/0,
    not_a_high_risk_ai_system/0,
    requirement_does_not_apply/0,
    compliance_required_by_31_december_2030/0,
    existing_system_without_significant_changes_not_covered/0,
    compliance_required_by_2_august_2030/0,
    requirement_applies_to_testing_data_sets_only/0,
    requirement_applies_and_the_simplified_form_may_be_used/0,
    requirement_applies/0,
    element_not_required/0,
    element_required_subject_to_an_open_condition/0,
    element_required/0
]).

:- use_module(library(clpz)).
:- use_module(library(reif), [memberd_t/3]).
:- use_module(formalize_lib, [profile_get/3]).
:- use_module(eu/ai_act/high_risk_requirements/kernel, [
    high_risk_requirements_input_problems/2,
    high_risk_requirements_valid_date_t/2,
    high_risk_requirements_day_before_t/3
]).
:- use_module(eu/ai_act/high_risk_requirements/citations, [implements/1]).

% ---- the result atoms of the contract (result constructors, never queries) ----
not_applicable_on_date.
not_a_high_risk_ai_system.
requirement_does_not_apply.
compliance_required_by_31_december_2030.
existing_system_without_significant_changes_not_covered.
compliance_required_by_2_august_2030.
requirement_applies_to_testing_data_sets_only.
requirement_applies_and_the_simplified_form_may_be_used.
requirement_applies.
element_not_required.
element_required_subject_to_an_open_condition.
element_required.

% The final answers of both queries, as a ground table.
high_risk_requirements_status_values([
    not_applicable_on_date,
    not_a_high_risk_ai_system,
    requirement_does_not_apply,
    compliance_required_by_31_december_2030,
    existing_system_without_significant_changes_not_covered,
    compliance_required_by_2_august_2030,
    requirement_applies_to_testing_data_sets_only,
    requirement_applies_and_the_simplified_form_may_be_used,
    requirement_applies,
    element_not_required,
    element_required_subject_to_an_open_condition,
    element_required
]).

% ---- statutory VALUE facts: the dates (reading (2), (10), (11)) -----------
% application_date(Route, Date, Citation): Art 113, third paragraph, point (c).
application_date(chapter_three_annex_iii, date(2027, 12, 2), cite(eu_reg_2024_1689_art_113_c_i)).
application_date(chapter_three_annex_i, date(2028, 8, 2), cite(eu_reg_2024_1689_art_113_c_ii)).

% compliance_deadline(Route, Date, Citation): Art 111(1) and (2), 'by D' read as
% due on D itself (the requirement applies from D).
compliance_deadline(annex_ten_component, date(2030, 12, 31), cite(eu_reg_2024_1689_art_111_1)).
compliance_deadline(public_authority_system, date(2030, 8, 2), cite(eu_reg_2024_1689_art_111_2)).

% ---- the query keys, in decision (root_exports) order ----------------------
status_query_keys([
    system_is_a_high_risk_ai_system_listed_in_annex_iii,
    system_is_a_high_risk_ai_system_under_article_6_1_and_annex_i,
    system_listed_under_point_1_a_of_annex_iii,
    used_for_the_purposes_of_law_enforcement_migration_border_control_or_asylum,
    union_or_national_law_considers_the_separate_verification_disproportionate,
    uses_techniques_involving_the_training_of_ai_models_with_data,
    provider_is_an_sme_including_a_start_up_or_an_smc,
    component_of_an_annex_x_large_scale_it_system_placed_on_the_market_or_put_into_service_before_2_august_2027,
    placed_on_the_market_or_put_into_service_before_the_chapter_iii_date,
    significant_changes_in_design_as_from_the_chapter_iii_date,
    intended_to_be_used_by_public_authorities
]).

element_query_keys([
    system_is_a_component_of_products,
    pre_determined_changes_to_the_system_and_its_performance,
    related_to_a_product_covered_by_annex_i_section_a
]).

% The type of each key (as the input contract types it): boolean or judgement.
key_type(system_is_a_high_risk_ai_system_listed_in_annex_iii, boolean).
key_type(system_is_a_high_risk_ai_system_under_article_6_1_and_annex_i, boolean).
key_type(system_listed_under_point_1_a_of_annex_iii, boolean).
key_type(used_for_the_purposes_of_law_enforcement_migration_border_control_or_asylum, boolean).
key_type(union_or_national_law_considers_the_separate_verification_disproportionate, boolean).
key_type(uses_techniques_involving_the_training_of_ai_models_with_data, boolean).
key_type(provider_is_an_sme_including_a_start_up_or_an_smc, boolean).
key_type(component_of_an_annex_x_large_scale_it_system_placed_on_the_market_or_put_into_service_before_2_august_2027, boolean).
key_type(placed_on_the_market_or_put_into_service_before_the_chapter_iii_date, boolean).
key_type(significant_changes_in_design_as_from_the_chapter_iii_date, judgement).
key_type(intended_to_be_used_by_public_authorities, judgement).
key_type(system_is_a_component_of_products, boolean).
key_type(pre_determined_changes_to_the_system_and_its_performance, boolean).
key_type(related_to_a_product_covered_by_annex_i_section_a, boolean).

% ---- the referral rows (the order's REFERRALS, bare citation keys) ---------
referral_citation(significant_changes_in_design_as_from_the_chapter_iii_date, eu_reg_2024_1689_art_111_2).
referral_citation(intended_to_be_used_by_public_authorities, eu_reg_2024_1689_art_111_2).

% ---- the requirement table (reading (1), (4) to (9)) ----------------------
