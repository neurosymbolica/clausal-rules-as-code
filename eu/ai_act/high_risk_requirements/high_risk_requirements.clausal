requirement_row(minimum_logging_capabilities_for_point_1_a_systems, point_one_a_logging, plain, [cite(eu_reg_2024_1689_art_8_1), cite(eu_reg_2024_1689_art_12_3)]).
requirement_row(transparency_and_instructions_for_use, no_own_condition, plain, [cite(eu_reg_2024_1689_art_8_1), cite(eu_reg_2024_1689_art_13_1), cite(eu_reg_2024_1689_art_13_2)]).
requirement_row(human_oversight, no_own_condition, plain, [cite(eu_reg_2024_1689_art_8_1), cite(eu_reg_2024_1689_art_14_1)]).
