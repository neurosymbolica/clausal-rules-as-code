% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% queries.clausal -- QUERY-COMBINATOR layer for eu/ai_act/scope_and_roles.
% A TOP-LAYER consumer: it imports the determination slice's PUBLIC
% predicates it calls, and nothing else.
%
% scope_and_roles_profile_keys/1   : the top-level profile key schema (the
%                                    forty keys of the typed input contract)
% scope_and_roles_input_problems/2 : THE INPUT CHECK (re-exported from the
%                                    kernel, as the scaffold wrote it)
% scope_and_roles_what_if/4        : (#16 what-if) set one key of the case's
%                                    profile, re-evaluate the leading question
%                                    (regulation_scope_status/4)
% scope_and_roles_action_permitted/4 : (#13 compliance check) is a proposed
%                                    action allowed in the current state:
%     supply_items_without_written_agreement -- forbidden when Art 25(4)
%         requires a written agreement (supplier_agreement_status/4 gives
%         written_agreement_required), else permitted;
%     initial_provider_withholds_cooperation -- forbidden when Art 25(2)
%         obliges the initial provider to cooperate (initial_provider_status/4
%         gives no_longer_provider_must_cooperate), else permitted.
%   A not-final answer (indeterminate/1, needs_legal_review/2,
%   input_problems/1) is returned as the Modality itself, citations [].
%   paragraph_2_not_applied gives permitted for withholding cooperation
%   only because the duty to cooperate is in paragraph 2; it says nothing
%   on whether the initial provider is still the provider (Q1).
% provenance/2                     : the optional, unscored provenance
%                                    constructor of needs_legal_review/2's
%                                    CONTEXT: provenance(Clause, Citations)
%                                    gives the ground citation list of a
%                                    deciding clause ([] for a clause it
%                                    does not name).
%
% Justification (#7) is the slice's scope_and_roles_checklist/2; status
% determination (#3) is the five queries and scope_and_roles_status/2.
%
% ROOT VOCABULARY. The scorer reads the forty profile key atoms, the
% enumeration atoms and the judgement value unsure as package-root
% attributes. The slice already exports the six DEFINED_ROLE atoms
% (provider, deployer, importer, distributor, authorised_representative,
% operator); this module exports the rest as bare 0-arity facts. They are
% data, never called as queries, and decide nothing.
% =====================================================================

:- module(queries, [
    scope_and_roles_profile_keys/1,
    scope_and_roles_input_problems/2,
    scope_and_roles_what_if/4,
    scope_and_roles_action_permitted/4,
    provenance/2,
    ai_system/0,
    exclusively_for_military_defence_or_national_security_purposes/0,
    third_country_public_authority_or_international_organisation_in_law_enforcement_and_judicial_cooperation/0,
    adequate_safeguards_for_fundamental_rights_and_freedoms/0,
    specifically_developed_and_put_into_service_for_the_sole_purpose_of_scientific_research_and_development/0,
    research_testing_or_development_before_placing_on_the_market_or_putting_into_service/0,
    testing_in_real_world_conditions/0,
    released_under_free_and_open_source_licence/0,
    placed_on_the_market_or_put_into_service_as_high_risk_or_under_article_5_or_50/0,
    actor_role/0,
    use_in_a_personal_non_professional_activity/0,
    develops_or_has_developed_the_system/0,
    places_or_puts_into_service_the_system_together_with_its_product/0,
    under_its_own_name_or_trademark/0,
    uses_the_system_under_its_authority/0,
    written_mandate_from_a_provider_received_and_accepted/0,
    in_the_supply_chain/0,
    makes_the_system_available_on_the_union_market/0,
    is_a_product_manufacturer/0,
    places_the_system_on_the_union_market/0,
    puts_the_system_into_service_in_the_union/0,
    established_or_located_in_the_union/0,
    located_in_the_union/0,
    output_used_in_the_union/0,
    represented_provider_established_in_the_union/0,
    high_risk_under_article_6_1_related_to_a_product_under_section_b_of_annex_i/0,
    system_bears_the_name_or_trademark_of_a_person_established_in_a_third_country/0,
    high_risk_route/0,
    product_manufacturer_of_a_product_under_section_a_of_annex_i_with_the_system_as_safety_component/0,
    system_is_high_risk_after_the_change/0,
    puts_its_name_or_trademark_on_a_high_risk_system_already_placed_or_in_service/0,
    makes_a_substantial_modification_to_a_high_risk_system_already_placed_or_in_service/0,
    modifies_the_intended_purpose_of_a_system_not_classified_as_high_risk_already_placed_or_in_service/0,
    system_placed_on_the_market_together_with_the_product_under_the_manufacturer_name/0,
    system_put_into_service_under_the_manufacturer_name_after_the_product_was_placed/0,
    another_person_became_the_provider_under_paragraph_1/0,
    initial_provider_clearly_specified_the_system_is_not_to_be_changed_into_high_risk/0,
    supplies_items_used_or_integrated_in_a_high_risk_system/0,
    makes_the_items_accessible_to_the_public_under_a_free_and_open_source_licence/0,
    supplied_items_include_a_general_purpose_ai_model/0,
    product_manufacturer/0,
    affected_person/0,
    annex_iii/0,
    annex_i/0,
    unsure/0
]).

:- use_module(library(reif), [memberd_t/3]).
:- use_module(eu/ai_act/scope_and_roles/kernel, [scope_and_roles_input_problems/2]).
:- use_module(eu/ai_act/scope_and_roles/citations, [implements/1]).
:- use_module(eu/ai_act/scope_and_roles/scope_and_roles, [
    scope_and_roles_status/2,
    supplier_agreement_status/4,
    initial_provider_status/4
]).

