% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_queries.clausal -- tests for the query layer registered in
% manifest.yaml query_interface: #3 status (regulation_scope_status/4),
% #7 justification (scope_and_roles_checklist/2), #13 compliance check
% (scope_and_roles_action_permitted/4), #16 what-if
% (scope_and_roles_what_if/4), plus the key schema and the re-exported
% input check.
% Run: python -m clausal.testing eu/ai_act/scope_and_roles/tests/test_queries.clausal
% =====================================================================
:- module(test_queries, []).
:- use_module(eu/ai_act/scope_and_roles/queries, [
    scope_and_roles_profile_keys/1,
    scope_and_roles_input_problems/2,
    scope_and_roles_what_if/4,
    scope_and_roles_action_permitted/4,
    ai_system/0,
    unsure/0,
    annex_i/0,
    annex_iii/0,
    product_manufacturer/0,
    affected_person/0
]).
:- use_module(eu/ai_act/scope_and_roles/scope_and_roles, [
    regulation_scope_status/4,
    scope_and_roles_checklist/2
]).
:- use_module(eu/ai_act/scope_and_roles/fixtures, [scope_and_roles_profile_for/2]).

permitted_answers(Subject, Action, Answers) :-
    scope_and_roles_profile_for(Subject, Profile),
    findall(Modality-Citations, scope_and_roles_action_permitted(case(Profile, date(2028, 9, 1)), Action, Modality, Citations), Answers).

test(profile_keys_are_the_contract_keys) :-
    scope_and_roles_profile_keys(ProfileKeys),
    ProfileKeys == [ai_system, exclusively_for_military_defence_or_national_security_purposes, third_country_public_authority_or_international_organisation_in_law_enforcement_and_judicial_cooperation, adequate_safeguards_for_fundamental_rights_and_freedoms, specifically_developed_and_put_into_service_for_the_sole_purpose_of_scientific_research_and_development, research_testing_or_development_before_placing_on_the_market_or_putting_into_service, testing_in_real_world_conditions, released_under_free_and_open_source_licence, placed_on_the_market_or_put_into_service_as_high_risk_or_under_article_5_or_50, actor_role, use_in_a_personal_non_professional_activity, develops_or_has_developed_the_system, places_or_puts_into_service_the_system_together_with_its_product, under_its_own_name_or_trademark, uses_the_system_under_its_authority, written_mandate_from_a_provider_received_and_accepted, in_the_supply_chain, makes_the_system_available_on_the_union_market, is_a_product_manufacturer, places_the_system_on_the_union_market, puts_the_system_into_service_in_the_union, established_or_located_in_the_union, located_in_the_union, output_used_in_the_union, represented_provider_established_in_the_union, high_risk_under_article_6_1_related_to_a_product_under_section_b_of_annex_i, system_bears_the_name_or_trademark_of_a_person_established_in_a_third_country, high_risk_route, product_manufacturer_of_a_product_under_section_a_of_annex_i_with_the_system_as_safety_component, system_is_high_risk_after_the_change, puts_its_name_or_trademark_on_a_high_risk_system_already_placed_or_in_service, makes_a_substantial_modification_to_a_high_risk_system_already_placed_or_in_service, modifies_the_intended_purpose_of_a_system_not_classified_as_high_risk_already_placed_or_in_service, system_placed_on_the_market_together_with_the_product_under_the_manufacturer_name, system_put_into_service_under_the_manufacturer_name_after_the_product_was_placed, another_person_became_the_provider_under_paragraph_1, initial_provider_clearly_specified_the_system_is_not_to_be_changed_into_high_risk, supplies_items_used_or_integrated_in_a_high_risk_system, makes_the_items_accessible_to_the_public_under_a_free_and_open_source_licence, supplied_items_include_a_general_purpose_ai_model].

test(there_are_forty_profile_keys) :-
    scope_and_roles_profile_keys(ProfileKeys),
    length(ProfileKeys, 40).

test(the_re_exported_input_check_answers) :-
    scope_and_roles_input_problems([attribute(colour, red)], Problems),
    Problems == [unknown_key(colour)].

test(the_root_vocabulary_atoms_are_served) :-
    ai_system,
    unsure,
    annex_i,
    annex_iii,
    product_manufacturer,
    affected_person.

% ---- #3 status ---------------------------------------------------------------
test(status_determination_answers_once) :-
    scope_and_roles_profile_for(professional_deployer_in_union, Profile),
    findall(Result-Citations, regulation_scope_status(Profile, date(2026, 8, 1), Result, Citations), Answers),
    Answers == [regulation_applies-[cite(eu_reg_2024_1689_art_2_1_b), cite(eu_reg_2024_1689_art_2_1_c)]].

% ---- #16 what-if ---------------------------------------------------------------
test(what_if_a_provider_stops_placing_on_the_market) :-
    scope_and_roles_profile_for(eu_provider_placing_on_market, Profile),
    findall(Status, scope_and_roles_what_if(case(Profile, date(2026, 8, 1)), places_the_system_on_the_union_market, false, Status), Statuses),
    Statuses == [out_of_scope].

test(what_if_with_the_same_value_keeps_the_status) :-
    scope_and_roles_profile_for(eu_provider_placing_on_market, Profile),
    findall(Status, scope_and_roles_what_if(case(Profile, date(2026, 8, 1)), places_the_system_on_the_union_market, true, Status), Statuses),
    Statuses == [regulation_applies].

test(what_if_adds_an_absent_key) :-
    scope_and_roles_profile_for(missing_actor_role_indeterminate, Profile),
    findall(Status, scope_and_roles_what_if(case(Profile, date(2026, 8, 1)), actor_role, importer, Status), Statuses),
    Statuses == [regulation_applies].

test(what_if_to_a_bad_value_is_an_input_problem) :-
    scope_and_roles_profile_for(eu_provider_placing_on_market, Profile),
    findall(Status, scope_and_roles_what_if(case(Profile, date(2026, 8, 1)), actor_role, manufacturer, Status), Statuses),
    Statuses == [input_problems([wrong_type(actor_role)])].

% ---- #13 compliance check -------------------------------------------------------
test(supplying_a_general_purpose_model_without_agreement_is_forbidden) :-
    permitted_answers(general_purpose_model_supplier_agreement_required, supply_items_without_written_agreement, Answers),
    Answers == [forbidden-[cite(eu_reg_2024_1689_art_25_4)]].

test(supplying_open_source_items_without_agreement_is_permitted) :-
    permitted_answers(open_source_supplier_no_agreement, supply_items_without_written_agreement, Answers),
    Answers == [permitted-[cite(eu_reg_2024_1689_art_25_4)]].

test(withholding_cooperation_is_forbidden_when_the_duty_applies) :-
    permitted_answers(initial_provider_must_cooperate, initial_provider_withholds_cooperation, Answers),
    Answers == [forbidden-[cite(eu_reg_2024_1689_art_25_2), cite(eu_reg_2024_1689_art_25_2_a), cite(eu_reg_2024_1689_art_25_2_b), cite(eu_reg_2024_1689_art_25_2_c)]].

test(withholding_cooperation_is_permitted_when_paragraph_2_is_not_applied) :-
    permitted_answers(initial_provider_clearly_specified, initial_provider_withholds_cooperation, Answers),
    Answers == [permitted-[cite(eu_reg_2024_1689_art_25_2)]].

test(withholding_cooperation_is_permitted_when_no_one_became_provider) :-
    permitted_answers(initial_provider_unaffected_case, initial_provider_withholds_cooperation, Answers),
    Answers == [permitted-[cite(eu_reg_2024_1689_art_25_2)]].

test(before_article_25_applies_supplying_is_permitted) :-
    scope_and_roles_profile_for(general_purpose_model_supplier_agreement_required, Profile),
    findall(Modality-Citations, scope_and_roles_action_permitted(case(Profile, date(2027, 1, 1)), supply_items_without_written_agreement, Modality, Citations), Answers),
    Answers == [permitted-[cite(eu_reg_2024_1689_art_113_c), cite(eu_reg_2024_1689_art_113_c_i), cite(eu_reg_2024_1689_art_113_c_ii)]].

test(an_unsure_specification_is_returned_as_the_modality) :-
    Profile = [
        attribute(high_risk_route, annex_iii),
        attribute(another_person_became_the_provider_under_paragraph_1, true),
        attribute(initial_provider_clearly_specified_the_system_is_not_to_be_changed_into_high_risk, unsure)
    ],
    findall(Modality-Citations, scope_and_roles_action_permitted(case(Profile, date(2028, 9, 1)), initial_provider_withholds_cooperation, Modality, Citations), Answers),
    Answers == [needs_legal_review(open_textured(initial_provider_clearly_specified_the_system_is_not_to_be_changed_into_high_risk, cite(eu_reg_2024_1689_art_25_2)), [inputs_relied_on([initial_provider_clearly_specified_the_system_is_not_to_be_changed_into_high_risk-unsure])])-[]].

test(an_input_problem_is_returned_as_the_modality) :-
    findall(Modality-Citations, scope_and_roles_action_permitted(case([attribute(colour, red)], date(2028, 9, 1)), supply_items_without_written_agreement, Modality, Citations), Answers),
    Answers == [input_problems([unknown_key(colour)])-[]].

test(an_unknown_action_has_no_answer, fail) :-
    scope_and_roles_action_permitted(case([], date(2028, 9, 1)), sell_the_system, _, _).

% ---- #7 justification -------------------------------------------------------------
test(the_checklist_has_one_cited_item_per_ground) :-
    scope_and_roles_profile_for(eu_provider_placing_on_market, Profile),
    scope_and_roles_checklist(case(Profile, date(2026, 8, 1)), Items),
    length(Items, 7),
    maplist(cited_item, Items).

cited_item(item(_Ground, _Status, cite(Key))) :-
    atom(Key).

test(the_checklist_marks_the_uncovered_deployer) :-
    scope_and_roles_profile_for(personal_use_deployer, Profile),
    scope_and_roles_checklist(case(Profile, date(2026, 8, 1)), Items),
    member(item(actor_not_covered, unmet(actor_not_covered), cite(eu_reg_2024_1689_art_2_1)), Items),
    member(item(not_an_ai_system, met, cite(eu_reg_2024_1689_art_3_1)), Items).

test(the_checklist_names_an_open_key) :-
    scope_and_roles_profile_for(missing_actor_role_indeterminate, Profile),
    scope_and_roles_checklist(case(Profile, date(2026, 8, 1)), Items),
    member(item(actor_not_covered, unknown([actor_role]), cite(eu_reg_2024_1689_art_2_1)), Items).

test(the_checklist_reports_input_problems) :-
    scope_and_roles_checklist(case([attribute(colour, red)], date(2026, 8, 1)), Items),
    Items == [item(input_check, unmet(input_problems([unknown_key(colour)])), cite(eu_reg_2024_1689_art_2_1))].

:- end_module(test_queries).
