% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/ai_act/scope_and_roles.
%
% Instrument: Regulation (EU) 2024/1689 (Artificial Intelligence Act), pinned
% consolidated text 02024R1689-20260727 (as amended by Regulation (EU)
% 2026/1744, valid from 27 July 2026; Formex, cut on 2026-11-14).
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% The verbatim pair is OMITTED while the key's entry in
% citations-sources.yaml is `status: unverified` (every entry is, at this
% phase: the pinned consolidated text has not been fetched and compared at
% the url). The pinned wording is recorded in the yaml note of each entry.
%
% Keys are the canonical lexicon keys (citation_vocabulary). The keys for
% Art 3, points (9), (10), (11) and (23) are cited only by the referral
% rows of the judgement keys whose open words those points define.
%
% PROVENANCE: every operative clause opens its body with implements(Key),
% Key a key recorded below.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

% implements(Key): the provenance marker; succeeds for every recorded key and
% fails for a key not recorded here.
implements(Key) :-
    citation(Key, _).

% ---- Art 113, third paragraph: dates of application -------------------
citation(eu_reg_2024_1689_art_113_a, [label-'Regulation (EU) 2024/1689 Art 113, third paragraph, point (a) (application of Chapters I and II from 2 February 2025)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727']).
citation(eu_reg_2024_1689_art_113_c, [label-'Regulation (EU) 2024/1689 Art 113, third paragraph, point (c) (application of Chapter III, Sections 1, 2 and 3)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727']).
citation(eu_reg_2024_1689_art_113_c_i, [label-'Regulation (EU) 2024/1689 Art 113, third paragraph, point (c)(i) (2 December 2027, high-risk pursuant to Article 6(2) and Annex III)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727']).
citation(eu_reg_2024_1689_art_113_c_ii, [label-'Regulation (EU) 2024/1689 Art 113, third paragraph, point (c)(ii) (2 August 2028, high-risk pursuant to Article 6(1) and Annex I)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727']).

