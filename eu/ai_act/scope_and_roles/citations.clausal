citation(eu_reg_2024_1689_art_25_1, [label-'Regulation (EU) 2024/1689 Art 25(1), lead words (distributor, importer, deployer or other third-party considered to be a provider of a high-risk AI system)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727']).
citation(eu_reg_2024_1689_art_25_1_a, [label-'Regulation (EU) 2024/1689 Art 25(1)(a) (putting a name or trademark on a high-risk AI system already placed on the market or put into service)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727']).
citation(eu_reg_2024_1689_art_25_1_b, [label-'Regulation (EU) 2024/1689 Art 25(1)(b) (substantial modification of a high-risk AI system that remains high-risk)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727']).
