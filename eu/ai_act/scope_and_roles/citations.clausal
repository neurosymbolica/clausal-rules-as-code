citation(eu_reg_2024_1689_art_25_3, [label-'Regulation (EU) 2024/1689 Art 25(3), lead words (product manufacturer of a product under Section A of Annex I considered to be the provider of a high-risk safety component)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727']).
