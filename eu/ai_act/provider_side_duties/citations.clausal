% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/ai_act/provider_side_duties.
%
% Source: Regulation (EU) 2024/1689 (Artificial Intelligence Act), the
% consolidated text 02024R1689-20260727 (as amended by Regulation (EU)
% 2026/1744, valid from 27 July 2026; Formex, cut on 2026-11-15). Each key
% is the CANONICAL lexicon key (_lexicon/citations.yaml); each ref names its
% pinned unit id after the '#'.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order. Every
% entry in citations-sources.yaml is `status: unverified` (the consolidated
% text could not be fetched at its url for this pass), so every record
% OMITS the verbatim pair.
%
% Two groups:
%   - EMITTED keys: the only citation atoms an answer may return
%     (the citation vocabulary of operator_duty_status/5 and
%     retention_period_end/4).
%   - MEANING-ONLY key (Art 3, point (8)): recorded so the clause applying
%     the definition carries its marker; NEVER returned in a result. The
%     other definitions read into the keys (Art 3, points (9), (10), (11),
%     (26), (48) and (56)) and Art 17 are deferred and have no record.
%
% PROVENANCE: implements(Key) succeeds for every recorded key and fails for
% any other, so a misspelt marker makes its clause fail.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

implements(Key) :-
    citation(Key, _).

% ---- Art 3: definitions (emitted) ---------------------------------
citation(eu_reg_2024_1689_art_3_1, [label-'Regulation (EU) 2024/1689 Art 3, point (1), definition of AI system', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02024R1689-20260727#point_003_1']).
