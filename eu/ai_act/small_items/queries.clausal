test(profile_keys_are_the_sixty_three_contract_keys) :-
    small_items_profile_keys(ProfileKeys),
    length(ProfileKeys, 63).
test(every_profile_key_is_served_at_the_root) :-
    small_items_profile_keys(ProfileKeys),
    maplist(call, ProfileKeys).
test(every_enumeration_atom_and_unsure_is_served_at_the_root) :-
    maplist(call, [provider_of_a_high_risk_system, other_provider_or_deployer, public_safety_and_public_health, environment, energy_sustainability, transport_and_critical_infrastructure, public_administration_and_public_services, none_of_the_listed_areas, annex_iii, annex_i_section_a, annex_i_section_b, approved, no_answer_within_30_days, not_approved, up_to_six_months, extended_up_to_twelve_months, longer, unsure]).
test(what_if_partner_enterprises_removes_the_simplification) :-
    small_items_what_if(small_items_request(sme_simplified_compliance, [attribute(is_an_sme_including_a_start_up, true), attribute(has_partner_or_linked_enterprises, false)], date(2026, 8, 2)), has_partner_or_linked_enterprises, true, Status),
    Status == no_simplified_compliance.
test(what_if_adds_an_absent_key) :-
    small_items_what_if(small_items_request(sme_simplified_compliance, [attribute(is_an_sme_including_a_start_up, true)], date(2026, 8, 2)), has_partner_or_linked_enterprises, false, Status),
    Status == may_comply_in_a_simplified_manner.
test(what_if_answers_exactly_once) :-
    findall(Status, small_items_what_if(small_items_request(sme_simplified_compliance, [attribute(is_an_sme_including_a_start_up, true)], date(2026, 8, 2)), has_partner_or_linked_enterprises, false, Status), Statuses),
    length(Statuses, 1).
test(what_if_on_an_unbound_profile_is_an_input_problem) :-
    small_items_what_if(small_items_request(sme_simplified_compliance, _, date(2026, 8, 2)), has_partner_or_linked_enterprises, false, Status),
    Status == input_problems([wrong_type(profile)]).
test(input_check_is_re_exported) :-
    small_items_input_problems([attribute(unlisted_key, true)], Problems),
    Problems == [unknown_key(unlisted_key)].

% ---- the result constructors: ground calls, each paired with a refusal ----
test(date_constructor_holds_for_a_real_day) :-
    findall(found, date(2026, 8, 2), Answers),
    Answers == [found].
test(date_constructor_refuses_an_impossible_day, fail) :-
    date(2026, 2, 30).
test(indeterminate_constructor_holds_for_one_bare_key) :-
    findall(found, indeterminate([testing_route]), Answers),
    Answers == [found].
test(indeterminate_constructor_refuses_two_keys, fail) :-
    indeterminate([testing_route, approval_status]).
test(needs_legal_review_constructor_holds_for_a_referral) :-
    findall(found, needs_legal_review(open_textured(consent_freely_given, cite(eu_reg_2024_1689_art_61_1)), [inputs_relied_on([consent_freely_given-unsure])]), Answers),
    Answers == [found].
test(needs_legal_review_constructor_refuses_a_bare_citation, fail) :-
    needs_legal_review(open_textured(consent_freely_given, eu_reg_2024_1689_art_61_1), [inputs_relied_on([])]).
test(open_textured_constructor_holds_for_a_key_and_citation) :-
    findall(found, open_textured(consent_freely_given, cite(eu_reg_2024_1689_art_61_1)), Answers),
    Answers == [found].
test(open_textured_constructor_refuses_a_bare_citation, fail) :-
    open_textured(consent_freely_given, eu_reg_2024_1689_art_61_1).
test(inputs_relied_on_constructor_holds_for_pairs) :-
    findall(found, inputs_relied_on([consent_freely_given-unsure]), Answers),
    Answers == [found].
test(inputs_relied_on_constructor_refuses_a_non_pair, fail) :-
    inputs_relied_on([consent_freely_given]).
test(provenance_constructor_holds_for_a_clause_and_citations) :-
    findall(found, provenance(informed_consent, [cite(eu_reg_2024_1689_art_61_1)]), Answers),
    Answers == [found].
test(provenance_constructor_refuses_a_non_list, fail) :-
    provenance(informed_consent, cite(eu_reg_2024_1689_art_61_1)).
test(input_problems_constructor_holds_for_a_problem_list) :-
    findall(found, input_problems([unknown_key(unlisted_key), wrong_type(assessment_date)]), Answers),
    Answers == [found].
test(input_problems_constructor_refuses_an_empty_list, fail) :-
    input_problems([]).
test(unknown_key_constructor_holds_for_a_key_outside_the_contract) :-
    findall(found, unknown_key(unlisted_key), Answers),
    Answers == [found].
test(unknown_key_constructor_refuses_a_contract_key, fail) :-
    unknown_key(testing_route).
test(wrong_type_constructor_holds_for_a_contract_key) :-
    findall(found, wrong_type(testing_route), Answers),
    Answers == [found].
test(wrong_type_constructor_holds_for_the_assessment_date) :-
    findall(found, wrong_type(assessment_date), Answers),
    Answers == [found].
test(wrong_type_constructor_refuses_an_unlisted_key, fail) :-
    wrong_type(unlisted_key).
test(duplicate_key_constructor_holds_for_a_contract_key) :-
    findall(found, duplicate_key(is_an_sme_including_a_start_up), Answers),
    Answers == [found].
test(duplicate_key_constructor_refuses_an_unlisted_key, fail) :-
    duplicate_key(unlisted_key).

:- end_module(queries).
