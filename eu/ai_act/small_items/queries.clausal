% schema of top-level profile keys: the keys of the order's typed input contract, in its order
small_items_profile_keys([bias_processing_capacity, strictly_necessary_for_bias_detection_and_correction_under_article_10_2_f_and_g, strictly_necessary_for_bias_detection_and_correction_of_biases_affecting_health_safety_or_fundamental_rights, appropriate_safeguards_for_fundamental_rights_and_freedoms, bias_detection_cannot_be_effectively_fulfilled_by_processing_other_data, technical_limitations_on_reuse_and_state_of_the_art_security_and_privacy_preserving_measures, measures_securing_and_protecting_the_data_with_strict_access_controls_and_documentation, data_not_transmitted_transferred_or_otherwise_accessed_by_other_parties, data_deleted_once_bias_corrected_or_retention_period_ended, records_of_processing_include_the_reasons_for_the_processing, sandbox_processing_of_data_collected_for_other_purposes_solely_for_developing_training_and_testing, developed_for_safeguarding_substantial_public_interest, public_interest_area, data_necessary_for_chapter_iii_section_2_requirements_and_non_personal_data_not_effective, effective_monitoring_and_response_mechanisms, functionally_separate_isolated_and_protected_environment_under_provider_control, data_shared_only_as_article_59_allows, processing_leads_to_no_measures_or_decisions_affecting_data_subjects_or_their_rights, appropriate_technical_and_organisational_measures, data_deleted_at_end_of_participation_or_retention_period, processing_logs_kept_for_the_duration_of_participation, description_of_process_and_rationale_kept_in_technical_documentation, project_summary_published_on_competent_authority_website, for_law_enforcement_purposes_under_law_enforcement_authority_control, based_on_specific_union_or_national_law, testing_route, member_state_has_adopted_a_real_world_testing_framework, testing_plan_drawn_up_and_submitted_to_the_market_surveillance_authority, approval_status, national_law_provides_for_tacit_approval, testing_registered_as_article_60_4_c_requires, established_in_the_union_or_legal_representative_established_in_the_union, third_country_transfers_only_with_appropriate_and_applicable_safeguards, testing_duration, extension_notified_in_advance_with_explanation, testing_no_longer_than_necessary_to_achieve_its_objectives, vulnerable_subjects_appropriately_protected, testing_in_cooperation_with_deployers, deployers_informed_instructed_and_agreement_concluded, informed_consent_given_in_accordance_with_article_61, law_enforcement_testing_where_seeking_consent_would_prevent_the_test, no_negative_effect_on_subjects_and_data_deleted_after_the_test, effectively_overseen_by_suitably_qualified_persons, outputs_can_be_effectively_reversed_and_disregarded, consent_freely_given, consent_obtained_before_participation, information_concise_clear_relevant_and_understandable, informed_of_nature_objectives_and_possible_inconvenience, informed_of_conditions_and_expected_duration, informed_of_rights_and_guarantees_including_refusal_and_withdrawal, informed_of_arrangements_for_reversal_or_disregarding, informed_of_identification_number_and_contact_details, consent_dated_and_documented, copy_given_to_the_subject_or_legal_representative, is_an_sme_including_a_start_up, has_partner_or_linked_enterprises, affected_person_subject_to_a_deployer_decision_based_on_the_system_output, system_is_a_high_risk_ai_system_listed_in_annex_iii, system_listed_under_point_2_of_annex_iii, decision_produces_legal_effects_or_similarly_significantly_affects_the_person, person_considers_an_adverse_impact_on_health_safety_or_fundamental_rights, union_or_national_law_provides_an_exception_or_restriction, right_otherwise_provided_for_under_union_law]).

% #16 what-if: re-evaluate with one key hypothetically overridden.
small_items_what_if(small_items_request(Query, Profile, AssessmentDate), OverriddenKey, NewValue, NewStatus) :-
    proper_list_t(Profile, IsProperList),
    hypothetical_profile(IsProperList, Profile, OverriddenKey, NewValue, Hypothesis),
    small_items_status(small_items_request(Query, Hypothesis, AssessmentDate), NewStatus).

% A term that is not a proper list is passed on unchanged: the query then
% answers input_problems([wrong_type(profile)]) for it.
hypothetical_profile(false, Profile, _, _, Profile).
hypothetical_profile(true, Profile, OverriddenKey, NewValue, Hypothesis) :-
    exclude(attribute_with_key(OverriddenKey), Profile, OtherAttributes),
    append(OtherAttributes, [attribute(OverriddenKey, NewValue)], Hypothesis).

attribute_with_key(Key, attribute(ElementKey, _)) :-
    ElementKey == Key.

% proper_list_t(Term, Truth): true for a proper list, false for anything else
% (an unbound term or a partial list included): must_be/2 raises on those.
proper_list_t(Term, Truth) :-
    catch(proper_list_confirmed(Term, Truth), _, Truth = false).

proper_list_confirmed(Term, true) :-
    must_be(list, Term).

% ---- root exports: the result constructors as well-formedness checks ----
% Each holds exactly for a term of the shape the called contract states.
% date(Year, Month, Day): a real calendar day (the ASSESSMENT_DATE argument).
date(Year, Month, Day) :-
    small_items_assessment_date_t(date(Year, Month, Day), true).

% indeterminate(MissingKeys): exactly one bare key atom.
indeterminate([Key]) :-
    atom(Key).

% needs_legal_review(open_textured(Key, cite(Citation)), [inputs_relied_on(Pairs)|Rest]):
% Rest is the optional, unscored provenance element.
needs_legal_review(open_textured(Key, cite(Citation)), [inputs_relied_on(Pairs)|Rest]) :-
    atom(Key),
    atom(Citation),
    is_list(Pairs),
    is_list(Rest).

% open_textured(Key, cite(Citation)): the referred judgement key and the
% citation of its referral row.
open_textured(Key, cite(Citation)) :-
    atom(Key),
    atom(Citation).

% inputs_relied_on(Pairs): a flat list of Key-Value pairs, each key an atom.
inputs_relied_on(Pairs) :-
    is_list(Pairs),
    maplist(key_value_pair, Pairs).

key_value_pair(Key-_Value) :-
    atom(Key).

% provenance(Clause, Citations): the deciding clause and a list of citations.
provenance(Clause, Citations) :-
    atom(Clause),
    is_list(Citations).

% input_problems(Problems): a non-empty flat list of problem terms.
input_problems([Problem|Problems]) :-
    nonvar(Problem),
    is_list(Problems).

% unknown_key(Key): a key outside the sixty-three of the contract.
unknown_key(Key) :-
    small_items_input_problems([attribute(Key, true)], [unknown_key(Found)]),
    Found == Key.

% wrong_type(Key): a contract key, the profile itself or the assessment date.
wrong_type(Key) :-
    atom(Key),
    small_items_profile_keys(ProfileKeys),
    memberd_t(Key, [profile, assessment_date|ProfileKeys], true).

% duplicate_key(Key): a contract key.
duplicate_key(Key) :-
    atom(Key),
    small_items_profile_keys(ProfileKeys),
    memberd_t(Key, ProfileKeys, true).

