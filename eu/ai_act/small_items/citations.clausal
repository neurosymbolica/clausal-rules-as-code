% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/ai_act/small_items.
%
% Source of record: Regulation (EU) 2024/1689 (Artificial Intelligence Act),
% consolidated text 02024R1689-20260727 (as amended by Regulation (EU) 2026/1744,
% valid from 27 July 2026; Formex, cut by the build process on 2026-11-14).
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order. Every
% entry is `status: unverified` in citations-sources.yaml, so the verbatim
% pair is omitted.
%
% The first block is the citation vocabulary of the order (the only atoms a
% RESULT may return). The second block records provisions the rules apply
% (points of Art 59(1) and Art 60(4)) that the vocabulary does not name: they
% are marker keys for implements/1 and are never returned in a result.
%
% PROVENANCE: implements(Key) succeeds for every recorded key; an operative
% clause opens its body with implements(Key).
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

implements(Key) :-
    citation(Key, _).

% ---- Art 113: application dates ----
citation(eu_reg_2024_1689_art_113, [label-'Regulation (EU) 2024/1689 Art 113, first paragraph (application from 2 August 2026) and lead words of the third paragraph', ref-'CELEX 02024R1689-20260727, unit art_113']).
citation(eu_reg_2024_1689_art_113_a, [label-'Regulation (EU) 2024/1689 Art 113, third paragraph, point (a) (Chapters I and II apply from 2 February 2025)', ref-'CELEX 02024R1689-20260727, unit point_113_a']).

