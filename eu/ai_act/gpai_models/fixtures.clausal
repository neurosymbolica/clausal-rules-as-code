% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% fixtures.clausal -- representative subjects for eu/ai_act/gpai_models.
% A TOP-LAYER consumer: it imports the determination slice's PUBLIC
% predicate it calls (decide_gpai_models/2). Profile keys and subject ids
% are atoms and need no import. Fixtures carry no provenance marker.
%
% gpai_models_profile_for(Subject, Request): Request is the facade request
% term decide_gpai_models/2 reads:
%   systemic_risk_classification(Profile, AssessmentDate)
%   systemic_risk_notification(Profile, TriggerDate, NotificationDate)
%   provider_obligation(Profile, Obligation, AssessmentDate)
%   documentation(Document)
% A profile is an ATTRIBUTE LIST [attribute(Key, Value), ...]; dates are
% date(Y, M, D) terms.
%
% Every route has a positive case and a one-unit near-miss control:
%   - the threshold of Art 51(2): 10^25 (no presumption) / 10^25 + 1;
%   - Art 113(b): 1 August 2025 / 2 August 2025;
%   - Art 111(3): 1 August 2027 / 2 August 2027 (obligations), and
%     2 / 3 August 2027 (notification of a model already on the market);
%   - Art 52(1): the two-week day / the day after, for a trigger after and
%     before 2 August 2025;
%   - each exception route of each obligation kind, and its control;
%   - each status form (indeterminate, needs_legal_review, input_problems)
%     with a control that settles.
% =====================================================================

:- module(fixtures, [
    gpai_models_subject/1,
    gpai_models_profile_for/2,
    gpai_models_assess/2
]).

:- use_module(eu/ai_act/gpai_models/gpai_models, [decide_gpai_models/2]).

% ---- the computation figures of the boundary pairs --------------------
threshold_computation(10000000000000000000000000).
above_threshold_computation(10000000000000000000000001).

% ---- profile builders (plumbing) --------------------------------------
classification_profile(Model, Research, Computation, HighImpact, Designated, Accepted, [
        attribute(general_purpose_ai_model, Model),
        attribute(used_for_research_development_or_prototyping_before_being_placed_on_the_market, Research),
        attribute(cumulative_training_computation_in_floating_point_operations, Computation),
        attribute(high_impact_capabilities, HighImpact),
        attribute(designated_by_a_commission_decision_as_a_model_with_systemic_risk, Designated),
        attribute(commission_accepted_the_providers_arguments_that_the_model_presents_no_systemic_risks, Accepted)
    ]).

notification_profile(Model, Computation, HighImpact, Placed, [
        attribute(general_purpose_ai_model, Model),
        attribute(cumulative_training_computation_in_floating_point_operations, Computation),
        attribute(high_impact_capabilities, HighImpact),
        attribute(placed_on_the_market_before_2_august_2025, Placed)
    ]).

obligation_profile(model_facts(Model, Research, Computation, HighImpact, Designated, Accepted, Licence, Public, ThirdCountry, Placed), [
        attribute(general_purpose_ai_model, Model),
        attribute(used_for_research_development_or_prototyping_before_being_placed_on_the_market, Research),
        attribute(cumulative_training_computation_in_floating_point_operations, Computation),
        attribute(high_impact_capabilities, HighImpact),
        attribute(designated_by_a_commission_decision_as_a_model_with_systemic_risk, Designated),
        attribute(commission_accepted_the_providers_arguments_that_the_model_presents_no_systemic_risks, Accepted),
        attribute(released_under_a_free_and_open_source_licence_allowing_access_usage_modification_and_distribution, Licence),
        attribute(parameters_weights_architecture_and_usage_information_made_publicly_available, Public),
        attribute(provider_established_in_a_third_country, ThirdCountry),
        attribute(placed_on_the_market_before_2_august_2025, Placed)
    ]).

% Named model descriptions for the obligation query.
% open_small: open source, parameters public, Union provider, no systemic risk.
model_description(open_small, model_facts(true, false, 0, false, false, false, true, true, false, false)).
% open_not_public: the licence is open but the parameters are not public.
model_description(open_not_public, model_facts(true, false, 0, false, false, false, true, false, false, false)).
% open_large: open source, above the threshold (systemic risk), third-country provider.
model_description(open_large, model_facts(true, false, 10000000000000000000000001, false, false, false, true, true, true, false)).
% open_at_threshold: exactly the threshold, no presumption, no systemic risk.
model_description(open_at_threshold, model_facts(true, false, 10000000000000000000000000, false, false, false, true, true, true, false)).
% open_third_country: open source, third-country provider, no systemic risk.
model_description(open_third_country, model_facts(true, false, 0, false, false, false, true, true, true, false)).
% closed_union: closed model, Union provider (dual establishment reads as Union).
model_description(closed_union, model_facts(true, false, 0, false, false, false, false, false, false, false)).
% closed_third_country: closed model, third-country provider.
model_description(closed_third_country, model_facts(true, false, 0, false, false, false, false, false, true, false)).
% legacy_closed: closed model placed on the market before 2 August 2025.
model_description(legacy_closed, model_facts(true, false, 0, false, false, false, false, false, true, true)).
% research_model: not yet placed, used for research (Art 3(63) exception).
model_description(research_model, model_facts(true, true, 0, false, false, false, false, false, false, false)).
% unsure_licence: the licence judgement is unsure, parameters public.
model_description(unsure_licence, model_facts(true, false, 0, false, false, false, unsure, true, false, false)).

described_profile(Description, Profile) :-
    model_description(Description, Facts),
    obligation_profile(Facts, Profile).

% The obligation profile with every key but placed_on_the_market_before_2_august_2025.
profile_without_placed_key([
        attribute(general_purpose_ai_model, true),
        attribute(used_for_research_development_or_prototyping_before_being_placed_on_the_market, false),
        attribute(cumulative_training_computation_in_floating_point_operations, 0),
        attribute(high_impact_capabilities, false),
        attribute(designated_by_a_commission_decision_as_a_model_with_systemic_risk, false),
        attribute(commission_accepted_the_providers_arguments_that_the_model_presents_no_systemic_risks, false),
        attribute(released_under_a_free_and_open_source_licence_allowing_access_usage_modification_and_distribution, false),
        attribute(parameters_weights_architecture_and_usage_information_made_publicly_available, false),
        attribute(provider_established_in_a_third_country, false)
    ]).

