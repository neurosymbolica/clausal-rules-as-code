% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% queries.clausal -- QUERY-COMBINATOR layer for eu/data_act_connected_product_data_sharing.
% A TOP-LAYER consumer: it imports the determination slice's PUBLIC
% predicates it calls, and nothing else.
%
% Source: Regulation (EU) 2023/2854 (the Data Act), CELEX 32023R2854, as
% published: Chapter II, Articles 3, 4 and 5, with the Article 2
% definitions they use, Article 7(1) and Article 50, second and third
% paragraphs. Every reading is the author's, not a lawyer's.
%
% Query types served by the package (registered in manifest.yaml
% query_interface):
%   #2 eligibility: decide_data_act_connected_product_data_sharing/2,
%      data_act_connected_product_data_sharing_status/2 and the cited
%      data_act_connected_product_data_sharing_checklist/2 (the slice),
%      over user_access_request_status/3 (Art 4): eligible exactly when
%      the answer is access_due.
%   #16 what-if: data_act_connected_product_data_sharing_what_if/4 sets one
%      key of the attribute list (every earlier occurrence removed) and
%      re-evaluates the eligibility status; the input check applies to
%      the edited profile. A profile that is not an attribute list gives
%      input_problems([wrong_type(profile)]) unchanged.
%   data_act_connected_product_data_sharing_profile_keys/1: the key schema.
%   data_act_connected_product_data_sharing_input_problems/2: the input
%      check, re-exported as the scaffold wrote it in kernel.clausal.
%
% RESULT CONSTRUCTORS (exported, never called as queries): input_problems/1,
% unknown_key/1, wrong_type/1, duplicate_key/1, indeterminate/1,
% needs_legal_review/2, open_textured/2, inputs_relied_on/1, provenance/2.
% A constructor is data and has no clauses; its fields are named by the
% constructors/1 declaration below. They decide nothing statutory.
%
% ROOT ATOMS: the twenty-two profile key atoms, the judgement value unsure
% and the two pre_contract_contract_kind atoms are listed under root_atoms
% in manifest.yaml, which makes them package-root attributes; an export
% list holds only name/arity entries, so they are not exported here.
%
% The profile is an ATTRIBUTE LIST, not a dict, so the kit's override_key/4
% (a dict combinator) is not used: the edit below is list plumbing.
% =====================================================================

:- module(queries, [
    data_act_connected_product_data_sharing_profile_keys/1,
    data_act_connected_product_data_sharing_input_problems/2,
    data_act_connected_product_data_sharing_what_if/4,
    input_problems/1,
    unknown_key/1,
    wrong_type/1,
    duplicate_key/1,
    indeterminate/1,
    needs_legal_review/2,
    open_textured/2,
    inputs_relied_on/1,
    provenance/2
]).

:- use_module(eu/data_act_connected_product_data_sharing/kernel, [data_act_connected_product_data_sharing_input_problems/2]).
:- use_module(eu/data_act_connected_product_data_sharing/data_act_connected_product_data_sharing, [data_act_connected_product_data_sharing_status/2]).

% ---- result constructors (data terms of the answers; no clauses) --------
:- constructors([input_problems(problems), unknown_key(key), wrong_type(key), duplicate_key(key), indeterminate(missing_keys), needs_legal_review(reason, context), open_textured(key, citation), inputs_relied_on(pairs), provenance(clause, citations)]).

% schema of top-level profile keys: the keys of the order's typed input contract, in its order
data_act_connected_product_data_sharing_profile_keys([connected_product_or_related_service, small_enterprise_exemption_applies, placed_on_market_after_12_september_2026, data_accessible_by_default_as_required, directly_accessible_where_relevant_and_feasible, pre_contract_contract_kind, required_information_provided_before_contract, requester_is_user, request_by_or_on_behalf_of_user, addressee_is_data_holder, requested_data_readily_available, data_directly_accessible_by_user, security_restriction_agreed_applies, testing_data_not_yet_on_market, third_party_use_contractually_permitted, third_party_is_designated_gatekeeper, other_persons_personal_data_requested, gdpr_conditions_for_making_available_met, requested_data_identified_as_trade_secrets, trade_secret_disclosure_strictly_necessary, trade_secret_measures_agreed_and_kept, exceptional_trade_secret_refusal_invoked]).

% ---- #16 what-if: re-evaluate with one key hypothetically set ----------
% Exactly one clause of hypothesis_status/5 holds: the profile is not an
% attribute list (the only way the check gives [wrong_type(profile)]), or it is.
data_act_connected_product_data_sharing_what_if(Profile, OverriddenKey, NewValue, NewStatus) :-
    data_act_connected_product_data_sharing_input_problems(Profile, Problems),
    hypothesis_status(Problems, Profile, OverriddenKey, NewValue, NewStatus).

hypothesis_status([wrong_type(profile)], _, _, _, input_problems([wrong_type(profile)])).
hypothesis_status(Problems, Profile, OverriddenKey, NewValue, NewStatus) :-
    dif(Problems, [wrong_type(profile)]),
    without_key(Profile, OverriddenKey, Remaining),
    append(Remaining, [attribute(OverriddenKey, NewValue)], Hypothesis),
    data_act_connected_product_data_sharing_status(Hypothesis, NewStatus).

% without_key(Elements, Key, Remaining): every attribute whose key is identical
% (==) to Key removed; an unbound key is never bound.
without_key([], _, []).
without_key([attribute(ElementKey, _OldValue)|Elements], Key, Remaining) :-
    ElementKey == Key,
    without_key(Elements, Key, Remaining).
without_key([attribute(ElementKey, Value)|Elements], Key, [attribute(ElementKey, Value)|Remaining]) :-
    ElementKey \== Key,
    without_key(Elements, Key, Remaining).

% ---- tests ---------------------------------------------------------------
clean_access_profile([
    attribute(connected_product_or_related_service, true),
    attribute(small_enterprise_exemption_applies, false),
    attribute(requester_is_user, true),
    attribute(addressee_is_data_holder, true),
    attribute(requested_data_readily_available, true),
    attribute(data_directly_accessible_by_user, false),
    attribute(security_restriction_agreed_applies, false),
    attribute(other_persons_personal_data_requested, false),
    attribute(requested_data_identified_as_trade_secrets, false)
]).

test(what_if_direct_access_flips_to_ineligible) :-
    clean_access_profile(Profile),
    findall(Status, data_act_connected_product_data_sharing_what_if(Profile, data_directly_accessible_by_user, true, Status), Statuses),
    Statuses == [ineligible].
test(what_if_same_value_stays_eligible) :-
    clean_access_profile(Profile),
    data_act_connected_product_data_sharing_what_if(Profile, data_directly_accessible_by_user, false, eligible).
test(what_if_same_value_is_not_ineligible, fail) :-
    clean_access_profile(Profile),
    data_act_connected_product_data_sharing_what_if(Profile, data_directly_accessible_by_user, false, ineligible).
test(what_if_on_a_non_list_reports_the_profile) :-
    findall(Status, data_act_connected_product_data_sharing_what_if(not_an_attribute_list, requester_is_user, true, Status), Statuses),
    Statuses == [input_problems([wrong_type(profile)])].
test(profile_keys_are_the_twenty_two) :-
    data_act_connected_product_data_sharing_profile_keys(Keys),
    length(Keys, 22).

:- end_module(queries).
