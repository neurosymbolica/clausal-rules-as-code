% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_properties.clausal -- structural PROPERTIES over the subject set.
%   totality: every registered subject classifies;
%   determinism: every subject yields exactly one answer for each of the
%     four queries and for the checklist;
%   citation completeness: a status compound has CITATIONS [], a final
%     answer a non-empty list of recorded cite(Key) terms, each once;
%   domain invariants: 'step 1' fulfilled implies the indicators of the
%     three criteria; input problems refuse every query alike; one euro
%     breaks a tie for the Lead Overseer.
% Each property is paired with a falsifier so it is not vacuous.
% Run: python -m clausal.testing eu/dora_ctpp_designation/tests/test_properties.clausal
% =====================================================================
:- module(test_properties, []).
:- use_module(eu/dora_ctpp_designation/dora_ctpp_designation, [
    decide_dora_ctpp_designation/2,
    ctpp_designation_criteria_status/3,
    ctpp_step_1_indicators/3,
    ctpp_lead_overseer/3,
    ctpp_designated_provider_duties/3,
    dora_ctpp_designation_checklist/2
]).
:- use_module(eu/dora_ctpp_designation/citations, [citation/2]).
:- use_module(eu/dora_ctpp_designation/fixtures, [
    dora_ctpp_designation_subject/1,
    dora_ctpp_designation_profile_for/2
]).

query_name(ctpp_designation_criteria_status).
query_name(ctpp_step_1_indicators).
query_name(ctpp_lead_overseer).
query_name(ctpp_designated_provider_duties).

subject_classifies(Subject) :-
    dora_ctpp_designation_subject(Subject),
    dora_ctpp_designation_profile_for(Subject, Profile),
    decide_dora_ctpp_designation(Profile, _Verdict).

answer_count(Subject, QueryName, Count) :-
    dora_ctpp_designation_profile_for(Subject, Profile),
    findall(Result-Citations, call(QueryName, Profile, Result, Citations), Answers),
    length(Answers, Count).

subject_query_count(Count) :-
    dora_ctpp_designation_subject(Subject),
    query_name(QueryName),
    answer_count(Subject, QueryName, Count).

checklist_count(Count) :-
    dora_ctpp_designation_subject(Subject),
    dora_ctpp_designation_profile_for(Subject, Profile),
    findall(Items, dora_ctpp_designation_checklist(Profile, Items), Answers),
    length(Answers, Count).

status_compound(indeterminate(_)).
status_compound(input_problems(_)).

final_result(designation_not_applicable(_)).
final_result(not_an_ict_third_party_service_provider).
final_result(step_1_sub_criteria_not_fulfilled).
final_result(step_1_sub_criteria_fulfilled).
final_result(step_1_indicators(_)).
final_result(lead_overseer(_)).
final_result(lead_overseer_tied(_)).
final_result(not_designated_as_critical).
final_result(required(_)).

recorded_citation(cite(CitationKey)) :-
    citation(CitationKey, _).

answer_well_cited(Result, []) :-
    status_compound(Result).
answer_well_cited(Result, [FirstCitation|OtherCitations]) :-
    final_result(Result),
    maplist(recorded_citation, [FirstCitation|OtherCitations]),
    sort([FirstCitation|OtherCitations], DistinctCitations),
    length(DistinctCitations, DistinctCount),
    length([FirstCitation|OtherCitations], CitationCount),
    DistinctCount =:= CitationCount.

well_cited_pair(Subject-QueryName) :-
    dora_ctpp_designation_subject(Subject),
    query_name(QueryName),
    dora_ctpp_designation_profile_for(Subject, Profile),
    call(QueryName, Profile, Result, Citations),
    answer_well_cited(Result, Citations).

subject_query_pair(Subject-QueryName) :-
    dora_ctpp_designation_subject(Subject),
    query_name(QueryName).

fulfilled_subject(Subject) :-
    dora_ctpp_designation_subject(Subject),
    dora_ctpp_designation_profile_for(Subject, Profile),
    ctpp_designation_criteria_status(Profile, step_1_sub_criteria_fulfilled, _).

fulfilled_subject_with_indicators(Subject) :-
    fulfilled_subject(Subject),
    dora_ctpp_designation_profile_for(Subject, Profile),
    ctpp_step_1_indicators(Profile, step_1_indicators(MetItems), _),
    member(sub_criteria_1_1_and_1_2(_), MetItems),
    member(sub_criterion_2_1, MetItems),
    member(sub_criterion_2_2, MetItems),
    substitutability_item(MetItems).

substitutability_item(MetItems) :-
    findall(Item, substitutability_member(Item, MetItems), Items),
    Items = [_|_].

substitutability_member(sub_criterion_4_1(Categories), MetItems) :-
    member(sub_criterion_4_1(Categories), MetItems).
substitutability_member(sub_criterion_4_2(Categories), MetItems) :-
    member(sub_criterion_4_2(Categories), MetItems).

refused_by_every_query(QueryName) :-
    query_name(QueryName),
    dora_ctpp_designation_profile_for(fixture_input_problems_float_and_duplicate, Profile),
    call(QueryName, Profile, input_problems([wrong_type(g_sii_served_count), duplicate_key(provider_is_part_of_a_group)]), []).

% ---- totality -----------------------------------------------------------
test(totality_every_subject_classifies) :-
    findall(Subject, dora_ctpp_designation_subject(Subject), Subjects),
    sort(Subjects, SubjectSet),
    findall(Subject, subject_classifies(Subject), ClassifiedSubjects),
    sort(ClassifiedSubjects, SubjectSet).

% ---- determinism --------------------------------------------------------
test(determinism_every_query_yields_exactly_one_answer_per_subject) :-
    findall(Count, subject_query_count(Count), Counts),
    Counts = [_|_],
    sort(Counts, [1]).
test(determinism_every_checklist_is_one_answer) :-
    findall(Count, checklist_count(Count), Counts),
    Counts = [_|_],
    sort(Counts, [1]).

% ---- citation completeness ----------------------------------------------
test(every_answer_is_well_cited) :-
    findall(Pair, subject_query_pair(Pair), AllPairs),
    sort(AllPairs, AllDistinct),
    findall(Pair, well_cited_pair(Pair), CitedPairs),
    sort(CitedPairs, CitedDistinct),
    CitedDistinct == AllDistinct.
test(a_status_with_a_citation_is_not_well_cited, fail) :-
    answer_well_cited(indeterminate([dora_entity_type]), [cite(eu_reg_2022_2554_art_31_1_a)]).
test(a_final_answer_without_citations_is_not_well_cited, fail) :-
    answer_well_cited(step_1_sub_criteria_fulfilled, []).
test(a_final_answer_with_recorded_citations_is_well_cited) :-
    answer_well_cited(lead_overseer(eba), [cite(eu_reg_2022_2554_art_31_1_b)]).

% ---- domain invariants ---------------------------------------------------
test(step_1_fulfilled_implies_the_indicators_of_every_criterion) :-
    findall(Subject, fulfilled_subject(Subject), FulfilledSubjects),
    FulfilledSubjects = [_|_],
    findall(Subject, fulfilled_subject_with_indicators(Subject), IndicatedSubjects),
    IndicatedSubjects == FulfilledSubjects.
test(input_problems_refuse_every_query_alike) :-
    findall(QueryName, refused_by_every_query(QueryName), QueryNames),
    length(QueryNames, 4).
test(one_euro_breaks_a_tie_for_the_lead_overseer) :-
    ctpp_lead_overseer([attribute(total_assets_of_users_within_eba_responsibility, 102), attribute(total_assets_of_users_within_eiopa_responsibility, 101), attribute(total_assets_of_users_within_esma_responsibility, 100)], Result, _),
    Result == lead_overseer(eba).
test(a_tie_is_never_a_single_lead_overseer, fail) :-
    dora_ctpp_designation_profile_for(fixture_lead_overseer_tied_eba_eiopa, Profile),
    ctpp_lead_overseer(Profile, lead_overseer(_), _).

:- end_module(test_properties).
