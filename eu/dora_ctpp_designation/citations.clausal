% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/dora_ctpp_designation.
%
% Instruments:
%   Regulation (EU) 2022/2554 (DORA), OJ L 333, 27.12.2022, p. 1 (CELEX 32022R2554);
%   Commission Delegated Regulation (EU) 2024/1502 (THE CRITERIA REGULATION)
%   (CELEX 32024R1502).
% Pinned unit texts: eu/dora_ctpp_designation/sources/.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order. Each
% verbatim is an exact substring of the pinned unit text.
%
% The keys returned in results are the canonical lexicon spellings of the
% order's citation vocabulary. The further keys (DORA Articles 2(1), 2(2),
% 2(4), 3(19), 3(20), 3(32), 31(6), 31(7), 31(12)) record provisions the
% rules apply or read; they mark clauses and data, and are never returned
% in a result.
%
% PROVENANCE: implements(Key) succeeds for every recorded key, and fails
% for a key not recorded here.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

implements(Key) :-
    citation(Key, _).

% ---- Regulation (EU) 2022/2554 (DORA), Article 31 ----
citation(eu_reg_2022_2554_art_31_1_a, [label-'Regulation (EU) 2022/2554 (DORA) Art 31(1), lead words and point (a): designation of critical ICT third-party service providers', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj', verbatim-'designate the ICT third-party service providers that are critical for financial entities, following an assessment that takes into account the criteria specified in paragraph 2']).
citation(eu_reg_2022_2554_art_31_1_b, [label-'Regulation (EU) 2022/2554 (DORA) Art 31(1), point (b): appointment of the Lead Overseer', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj', verbatim-'appoint as Lead Overseer for each critical ICT third-party service provider the ESA that is responsible']).
citation(eu_reg_2022_2554_art_31_2, [label-'Regulation (EU) 2022/2554 (DORA) Art 31(2), points (a) to (d): the criteria for designation', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj', verbatim-'The designation referred to in paragraph 1, point (a), shall be based on all of the following criteria in relation to ICT services provided by the ICT third-party service provider']).
citation(eu_reg_2022_2554_art_31_3, [label-'Regulation (EU) 2022/2554 (DORA) Art 31(3): criteria considered for the group as a whole', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj', verbatim-'Where the ICT third-party service provider belongs to a group, the criteria referred to in paragraph 2 shall be considered in relation to the ICT services provided by the group as a whole.']).
citation(eu_reg_2022_2554_art_31_4, [label-'Regulation (EU) 2022/2554 (DORA) Art 31(4): coordination point of a critical provider in a group', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj', verbatim-'Critical ICT third-party service providers which are part of a group shall designate one legal person as a coordination point to ensure adequate representation and communication with the Lead Overseer.']).
citation(eu_reg_2022_2554_art_31_5, [label-'Regulation (EU) 2022/2554 (DORA) Art 31(5), last sentence: notification of the financial entities served', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj', verbatim-'The ICT third-party service provider shall notify the financial entities to which they provide services of their designation as critical.']).
citation(eu_reg_2022_2554_art_31_6, [label-'Regulation (EU) 2022/2554 (DORA) Art 31(6): delegated act specifying the criteria (read only for Art 31(7))', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj', verbatim-'The Commission is empowered to adopt a delegated act in accordance with Article 57 to supplement this Regulation by specifying further the criteria referred to in paragraph 2 of this Article, by 17 July 2024.']).
citation(eu_reg_2022_2554_art_31_7, [label-'Regulation (EU) 2022/2554 (DORA) Art 31(7): designation not used before the delegated act (read as satisfied)', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj', verbatim-'The designation referred to in paragraph 1, point (a), shall not be used until the Commission has adopted a delegated act in accordance with paragraph 6.']).
citation(eu_reg_2022_2554_art_31_8, [label-'Regulation (EU) 2022/2554 (DORA) Art 31(8), lead words: exclusions from designation', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj', verbatim-'The designation referred to in paragraph 1, point (a), shall not apply to the following']).
citation(eu_reg_2022_2554_art_31_8_i, [label-'Regulation (EU) 2022/2554 (DORA) Art 31(8), point (i): financial entities providing ICT services to other financial entities', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj', verbatim-'financial entities providing ICT services to other financial entities']).
citation(eu_reg_2022_2554_art_31_8_ii, [label-'Regulation (EU) 2022/2554 (DORA) Art 31(8), point (ii): providers subject to oversight frameworks supporting Article 127(2) TFEU', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj', verbatim-'ICT third-party service providers that are subject to oversight frameworks established for the purposes of supporting the tasks referred to in Article 127(2) of the Treaty on the Functioning of the European Union']).
citation(eu_reg_2022_2554_art_31_8_iii, [label-'Regulation (EU) 2022/2554 (DORA) Art 31(8), point (iii): ICT intra-group service providers', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj', verbatim-'ICT intra-group service providers']).
citation(eu_reg_2022_2554_art_31_8_iv, [label-'Regulation (EU) 2022/2554 (DORA) Art 31(8), point (iv): providers serving solely in one Member State', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj', verbatim-'ICT third-party service providers providing ICT services solely in one Member State to financial entities that are only active in that Member State']).
citation(eu_reg_2022_2554_art_31_12, [label-'Regulation (EU) 2022/2554 (DORA) Art 31(12): critical provider established in a third country (read only to identify the provider of Art 31(13))', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj', verbatim-'Financial entities shall only make use of the services of an ICT third-party service provider established in a third country and which has been designated as critical']).
citation(eu_reg_2022_2554_art_31_13, [label-'Regulation (EU) 2022/2554 (DORA) Art 31(13): notification of changes to the management of the Union subsidiary', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj', verbatim-'shall notify the Lead Overseer of any changes to the structure of the management of the subsidiary established in the Union']).

% ---- Regulation (EU) 2022/2554 (DORA), Articles 2 and 3 (read for types and definitions) ----
citation(eu_reg_2022_2554_art_2_1, [label-'Regulation (EU) 2022/2554 (DORA) Art 2(1), points (a) to (u): the kinds of entity (categories and type set)', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj', verbatim-'this Regulation applies to the following entities']).
citation(eu_reg_2022_2554_art_2_2, [label-'Regulation (EU) 2022/2554 (DORA) Art 2(2): definition of financial entities (points (a) to (t))', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj', verbatim-'entities referred to in paragraph 1, points (a) to (t), shall collectively be referred to as']).
citation(eu_reg_2022_2554_art_2_4, [label-'Regulation (EU) 2022/2554 (DORA) Art 2(4): institutions exempted pursuant to Directive 2013/36/EU (no category)', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj', verbatim-'Member States may exclude from the scope of this Regulation entities referred to in Article 2(5), points (4) to (23), of Directive 2013/36/EU']).
citation(eu_reg_2022_2554_art_3_19, [label-'Regulation (EU) 2022/2554 (DORA) Art 3, point (19): definition of ICT third-party service provider', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj', verbatim-'means an undertaking providing ICT services']).
citation(eu_reg_2022_2554_art_3_20, [label-'Regulation (EU) 2022/2554 (DORA) Art 3, point (20): definition of ICT intra-group service provider', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj', verbatim-'means an undertaking that is part of a financial group and that provides predominantly ICT services to financial entities within the same group']).
citation(eu_reg_2022_2554_art_3_32, [label-'Regulation (EU) 2022/2554 (DORA) Art 3, point (32): definition of institution exempted pursuant to Directive 2013/36/EU', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj', verbatim-'means an entity as referred to in Article 2(5), points (4) to (23), of Directive 2013/36/EU']).

% ---- Commission Delegated Regulation (EU) 2024/1502 (THE CRITERIA REGULATION) ----
citation(eu_reg_2024_1502_art_1_1, [label-'Delegated Regulation (EU) 2024/1502 Art 1(1): the two steps of the assessment', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1502/oj', verbatim-'the ESAs shall apply the following approach']).
citation(eu_reg_2024_1502_art_1_2, [label-'Delegated Regulation (EU) 2024/1502 Art 1(2): designation on step 1 fulfilled and a positive step 2 outcome', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1502/oj', verbatim-'shall designate an ICT third-party service provider as critical for financial entities if it fulfils all the']).
citation(eu_reg_2024_1502_art_2_1, [label-'Delegated Regulation (EU) 2024/1502 Art 2(1): sub-criteria 1.1 and 1.2', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1502/oj', verbatim-'When considering the criterion set out in Article 31(2), point (a), of Regulation (EU) 2022/2554, the ESAs shall assess whether the ICT third-party service provider fulfils the following']).
citation(eu_reg_2024_1502_art_2_2, [label-'Delegated Regulation (EU) 2024/1502 Art 2(2): calculation of sub-criterion 1.1', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1502/oj', verbatim-'The sub-criterion 1.1 set out in paragraph 1, point (a), shall be calculated as follows']).
citation(eu_reg_2024_1502_art_2_3, [label-'Delegated Regulation (EU) 2024/1502 Art 2(3): calculation of sub-criterion 1.2', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1502/oj', verbatim-'The sub-criterion 1.2 set out in paragraph 1, point (b), shall be calculated as follows']).
citation(eu_reg_2024_1502_art_2_4, [label-'Delegated Regulation (EU) 2024/1502 Art 2(4): both shares of at least 10 % for at least one category', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1502/oj', verbatim-'where both of the shares as calculated in accordance with paragraphs 2 and 3 are of at least 10']).
citation(eu_reg_2024_1502_art_3_1, [label-'Delegated Regulation (EU) 2024/1502 Art 3(1): sub-criteria 2.1 and 2.2', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1502/oj', verbatim-'When considering the criterion set out in Article 31(2), point (b), of Regulation (EU) 2022/2554, the ESAs shall assess whether the ICT third-party service provider fulfils the following']).
citation(eu_reg_2024_1502_art_3_2, [label-'Delegated Regulation (EU) 2024/1502 Art 3(2): when sub-criterion 2.1 is fulfilled (G-SII, three O-SIIs, O-SII score above 3 000)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1502/oj', verbatim-'shall be considered as having fulfilled the sub-criterion set out in paragraph 1, point (a), if the ICT services it provides are used at least by either of the following']).
citation(eu_reg_2024_1502_art_3_3, [label-'Delegated Regulation (EU) 2024/1502 Art 3(3): when sub-criterion 2.2 is fulfilled (systemic financial entities)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1502/oj', verbatim-'shall be considered as having fulfilled the sub-criterion set out in paragraph 1, point (b), if the ICT services that it provides are used at least by either of the following']).
citation(eu_reg_2024_1502_art_5_1, [label-'Delegated Regulation (EU) 2024/1502 Art 5(1): sub-criteria 4.1 and 4.2', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1502/oj', verbatim-'When considering the criterion set out in Article 31(2), point (d), of Regulation (EU) 2022/2554, the ESAs shall assess whether the ICT third-party service provider fulfils the following']).
citation(eu_reg_2024_1502_art_5_2, [label-'Delegated Regulation (EU) 2024/1502 Art 5(2): calculation of sub-criterion 4.1', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1502/oj', verbatim-'The sub-criterion 4.1 set out in paragraph 1, point (a), shall be calculated as follows']).
citation(eu_reg_2024_1502_art_5_3, [label-'Delegated Regulation (EU) 2024/1502 Art 5(3): calculation of sub-criterion 4.2', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1502/oj', verbatim-'The sub-criterion set out in paragraph 1, point (b), shall be calculated as follows']).
citation(eu_reg_2024_1502_art_5_4, [label-'Delegated Regulation (EU) 2024/1502 Art 5(4): sub-criteria 4.1 and 4.2 fulfilled where either share is of at least 10 %', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1502/oj', verbatim-'shall be considered as having fulfilled both sub-criteria 4.1 and 4.2 where either of the following is met']).

:- end_module(citations).
