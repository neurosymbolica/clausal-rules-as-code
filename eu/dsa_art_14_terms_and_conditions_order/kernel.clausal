% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% kernel.clausal -- the SHARED FLOOR for eu/dsa_art_14_terms_and_conditions_order (deontic family).
% Source: Regulation (EU) 2022/2065 (Digital Services Act), Article 14(1) to 14(6)
% (original act, OJ L 277, 27.10.2022, English text; CELEX 32022R2065; source xhtml
% sha256 11b119a7d45f3a10cd41714061f9d907839ef5d1634e41774490f00b95856bbf).
%
% DAG root of the determination-slices layout. It holds ONLY the
% PREDICATES that two or more files CALL. Here that is the order's input
% check dsa_art_14_terms_and_conditions_order_input_problems/2, written by the
% scaffold from the order's typed input contract. The determination slice
% (step 0 of THE LIMBS of every query) and the package facade both call it.
% Every other helper (the key-state reader, the PAIRS builder, the routes)
% has a single caller, the slice dsa_art_14_terms_and_conditions_order.clausal,
% and lives there.
%
% The input check is plumbing on the input contract: it decides no statutory
% condition, so its clauses carry no implements/1 marker.
%
% deontic family: each paragraph of Art 14 is an obligation on the provider;
% the six duties are independent (Q11) and each query answers one of them.
%
% Atoms and data terms need NO declaration and NO import. The block below only
% RECORDS the result terms so every file spells them alike.
%
% RESULT TERMS -- every query has the form QUERY(Profile, Result, Basis, Citations):
%   art_14_1_terms_and_conditions_content_status/4      Art 14(1)
%     Result: art_14_1_terms_and_conditions_compliant | art_14_1_terms_and_conditions_not_compliant
%   art_14_2_significant_change_information_status/4    Art 14(2)
%     Result: art_14_2_change_information_compliant | art_14_2_change_information_not_compliant
%             | art_14_2_change_information_not_required
%   art_14_3_minors_explanation_status/4                Art 14(3)
%     Result: art_14_3_minors_explanation_compliant | art_14_3_minors_explanation_not_compliant
%             | art_14_3_minors_explanation_not_required
%   art_14_4_restriction_enforcement_status/4           Art 14(4)
%     Result: art_14_4_restriction_enforcement_compliant | art_14_4_restriction_enforcement_not_compliant
%             | art_14_4_restriction_enforcement_not_required
%   art_14_5_terms_and_conditions_summary_status/4      Art 14(5)
%     Result: art_14_5_summary_compliant | art_14_5_summary_not_compliant | art_14_5_summary_not_required
%   art_14_6_official_languages_status/4                Art 14(6)
%     Result: art_14_6_official_languages_compliant | art_14_6_official_languages_not_compliant
%             | art_14_6_official_languages_not_required
%   or, not final, a status compound ITSELF in the Result position:
%     indeterminate([Key])                    one bare missing key atom
%     needs_legal_review(open_textured(Key, cite(Paragraph)), [inputs_relied_on(Pairs)])
%     needs_legal_review(cross_reference_unresolved(cite(Paragraph),
%                            cite(commission_vlop_or_vlose_designation_decision)),
%                        [resolution(cite(commission_vlop_or_vlose_designation_decision), not_attempted),
%                         inputs_relied_on(Pairs)])
%     input_problems(Problems)                Problems from the input check below
%   Basis: [] for every answer except the final answers of Art 14(5) and 14(6),
%     which carry [outside_fact(designated_as_very_large_online_platform_or_search_engine, Attested)],
%     Attested exactly as supplied (READINGS (14)).
%   Citations: [cite(Paragraph)] for a final answer, Paragraph the one key of the query
%     (eu_reg_2022_2065_art_14_1 ... eu_reg_2022_2065_art_14_6); [] when not final.
%
% FACADE RESULT TERM (the scaffold name, one per determination slice):
%   dsa_art_14_terms_and_conditions_order_verdict(Status, Citations)
%     Status the roll-up label (dsa_art_14_terms_and_conditions_order_compliant |
%     dsa_art_14_terms_and_conditions_order_indeterminate |
%     dsa_art_14_terms_and_conditions_order_not_compliant), Citations the cite(Key)
%     terms of the six paragraphs carried by the checklist items.
%
% Move a predicate here only when a SECOND file calls it, and import it by full path:
%   :- use_module(eu/dsa_art_14_terms_and_conditions_order/kernel, [shared_predicate/2]).
% =====================================================================

:- module(kernel, [dsa_art_14_terms_and_conditions_order_input_problems/2]).

:- use_module(library(reif), [memberd_t/3]).

% ---- input checks: the problems a profile has, if any -----------
% dsa_art_14_terms_and_conditions_order_input_problems(Profile, Problems): Problems = [] means the profile can be
% judged. Written from the order's typed input contract
% (input_contract.types.profile: attribute_list).
% Each public query calls this check first: it gives its normal answer only when
% Problems = [], and when Problems is not [] it gives the answer the order states for
% a profile with input problems.
% It gives exactly one answer for every Profile, and the answer is ground except for a
% Key named as given:
% - a Profile that is not an attribute list [attribute(Key, Value), ...] gives [wrong_type(profile)]:
%   an unbound Profile, a partial list, a list holding an unbound item or an item that is
%   not attribute(_, _);
% - a Key that is not an atom (a number, a string, a compound term, an unbound variable)
%   is a key outside the contract: unknown_key(Key), Key as given;
% - otherwise, for each contract key in the contract's key order, duplicate_key(Key) when
%   the key occurs more than once in Profile (whatever its values: none of them is read,
%   so it is never also wrong_type(Key)), else wrong_type(Key) when its one value is
%   outside its type; then unknown_key(Key) for each key outside the contract, in the
%   order of its first occurrence in Profile. Each key is named once. An absent key is
%   not a problem.
% - a value holding an unbound variable anywhere (an attestation argument included) is
%   outside its type: wrong_type(Key).
% Every step is complementary clauses: exactly one clause holds for each input.
dsa_art_14_terms_and_conditions_order_input_problems(Profile, Problems) :-
    attribute_list_t(Profile, IsAttributeList),
    profile_problems(IsAttributeList, Profile, Problems).

profile_problems(false, _, [wrong_type(profile)]).
profile_problems(true, Profile, Problems) :-
    Keys = [terms_and_conditions_include_information_on_restrictions_on_recipient_information, terms_and_conditions_include_information_on_content_moderation, terms_and_conditions_in_clear_plain_intelligible_user_friendly_and_unambiguous_language, terms_and_conditions_publicly_available_in_easily_accessible_and_machine_readable_format, provider_has_internal_complaint_handling_system, terms_and_conditions_include_rules_of_procedure_of_internal_complaint_handling_system, terms_and_conditions_changed, change_to_terms_and_conditions_is_significant, recipients_informed_of_change_to_terms_and_conditions, service_primarily_directed_at_minors, service_predominantly_used_by_minors, conditions_and_restrictions_explained_in_way_minors_can_understand, provider_applies_or_enforces_restriction, restriction_applied_in_diligent_objective_and_proportionate_manner, restriction_applied_with_due_regard_to_rights_and_legitimate_interests_of_parties, concise_clear_machine_readable_summary_of_terms_and_conditions_provided, terms_and_conditions_published_in_official_languages_of_all_member_states_of_service, designated_as_very_large_online_platform_or_search_engine],
    unknown_keys(Profile, Keys, UnknownKeyProblems),
    key_problems(Keys, Profile, UnknownKeyProblems, Problems).

% The contract: each key and the type of its value.
key_type(terms_and_conditions_include_information_on_restrictions_on_recipient_information, judgement).
key_type(terms_and_conditions_include_information_on_content_moderation, judgement).
key_type(terms_and_conditions_in_clear_plain_intelligible_user_friendly_and_unambiguous_language, judgement).
key_type(terms_and_conditions_publicly_available_in_easily_accessible_and_machine_readable_format, judgement).
key_type(provider_has_internal_complaint_handling_system, boolean).
key_type(terms_and_conditions_include_rules_of_procedure_of_internal_complaint_handling_system, judgement).
key_type(terms_and_conditions_changed, boolean).
key_type(change_to_terms_and_conditions_is_significant, judgement).
key_type(recipients_informed_of_change_to_terms_and_conditions, boolean).
key_type(service_primarily_directed_at_minors, judgement).
key_type(service_predominantly_used_by_minors, judgement).
key_type(conditions_and_restrictions_explained_in_way_minors_can_understand, judgement).
key_type(provider_applies_or_enforces_restriction, boolean).
key_type(restriction_applied_in_diligent_objective_and_proportionate_manner, judgement).
key_type(restriction_applied_with_due_regard_to_rights_and_legitimate_interests_of_parties, judgement).
key_type(concise_clear_machine_readable_summary_of_terms_and_conditions_provided, judgement).
key_type(terms_and_conditions_published_in_official_languages_of_all_member_states_of_service, boolean).
key_type(designated_as_very_large_online_platform_or_search_engine, outside_fact).

% attribute_list_t(Term, T): T is true when Term is a list of attribute(Key, Value)
% items, whatever each Key is; false for anything else, an unbound Term or item included.
attribute_list_t(Term, false) :-
    var(Term).
attribute_list_t(Term, true) :-
    Term == [].
attribute_list_t(Term, T) :-
    nonvar(Term),
    Term = [Element|Elements],
    attribute_t(Element, ElementIsAttribute),
    attribute_list_t(Elements, ElementsAreAttributes),
    truth_and(ElementIsAttribute, ElementsAreAttributes, T).
attribute_list_t(Term, false) :-
    nonvar(Term),
    Term \== [],
    Term \= [_|_].

attribute_t(Element, false) :-
    var(Element).
attribute_t(Element, true) :-
    nonvar(Element),
    Element = attribute(_, _).
attribute_t(Element, false) :-
    nonvar(Element),
    Element \= attribute(_, _).

% Unknown keys, in profile order, each once: Known grows by each key named. A key is
% known when it is identical (==) to one in Known, so an unbound Key is never bound:
% the same variable twice is one unknown key, two different variables are two.
unknown_keys([], _, []).
unknown_keys([attribute(Key, _)|Elements], Known, Problems) :-
    known_t(Key, Known, IsKnown),
    name_unknown_key(IsKnown, Key, Known, Elements, Problems).

known_t(_, [], false).
known_t(Key, [Known|_], true) :-
    Known == Key.
known_t(Key, [Known|Knowns], T) :-
    Known \== Key,
    known_t(Key, Knowns, T).

name_unknown_key(true, _, Known, Elements, Problems) :-
    unknown_keys(Elements, Known, Problems).
name_unknown_key(false, Key, Known, Elements, [unknown_key(Key)|Problems]) :-
    unknown_keys(Elements, [Key|Known], Problems).

% Contract keys, in contract order: duplicate_key(Key) when the key occurs more than once
% (none of its values is read), else wrong_type(Key) when its one value is outside the
% key's type. An absent key has no value to check.
key_problems([], _, Problems, Problems).
key_problems([Key|Keys], Profile, LaterProblems, Problems) :-
    key_type(Key, Type),
    key_occurrences(Profile, Key, Occurrences),
    key_problems(Keys, Profile, LaterProblems, KeyProblems),
    name_key_problem(Occurrences, Key, Type, Profile, KeyProblems, Problems).

% key_occurrences(Elements, Key, Occurrences): none, one or many items give Key.
key_occurrences([], _, none).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey == Key,
    key_occurrences(Elements, Key, RestOccurrences),
    one_more_occurrence(RestOccurrences, Occurrences).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey \== Key,
    key_occurrences(Elements, Key, Occurrences).

one_more_occurrence(none, one).
one_more_occurrence(one, many).
one_more_occurrence(many, many).

name_key_problem(none, _, _, _, Problems, Problems).
name_key_problem(many, Key, _, _, Problems, [duplicate_key(Key)|Problems]).
name_key_problem(one, Key, Type, Profile, KeyProblems, Problems) :-
    values_in_type_t(Profile, Key, Type, InType),
    name_wrong_type(InType, Key, KeyProblems, Problems).

name_wrong_type(true, _, Problems, Problems).
name_wrong_type(false, Key, Problems, [wrong_type(Key)|Problems]).

% values_in_type_t(Elements, Key, Type, T): T is true when every value Elements gives Key is
% in Type (true when Elements gives Key none).
values_in_type_t([], _, _, true).
values_in_type_t([attribute(ElementKey, Value)|Elements], Key, Type, T) :-
    ElementKey == Key,
    value_in_type_t(Type, Value, ValueInType),
    values_in_type_t(Elements, Key, Type, RestInType),
    truth_and(ValueInType, RestInType, T).
values_in_type_t([attribute(ElementKey, _)|Elements], Key, Type, T) :-
    ElementKey \== Key,
    values_in_type_t(Elements, Key, Type, T).

% A value with an unbound part is outside every type; a ground one is checked.
% This is how an attestation argument that is, or holds, an unbound variable
% gives wrong_type(Key) for the outside fact.
value_in_type_t(Type, Value, T) :-
    term_variables(Value, Variables),
    ground_value_in_type_t(Variables, Type, Value, T).

ground_value_in_type_t([_|_], _, _, false).
ground_value_in_type_t([], Type, Value, T) :-
    in_type_t(Type, Value, T).

% in_type_t(Type, Value, T): one clause per type, for a ground Value.
in_type_t(judgement, Value, T) :-
    in_type_t(one_of([boolean, enum([unsure])]), Value, T).

in_type_t(outside_fact, Value, T) :-
    in_type_t(attested(boolean), Value, T).

in_type_t(boolean, Value, T) :-
    memberd_t(Value, [true, false], T).

in_type_t(enum(Values), Value, T) :-
    memberd_t(Value, Values, T).

in_type_t(one_of(Types), Value, T) :-
    in_some_type_t(Types, Value, T).

in_type_t(attested(Type), Value, T) :-
    attested_t(Value, Type, T).

truth_and(true, T, T).
truth_and(false, _, false).

% in_some_type_t(Types, Value, T): T is true when Value is in at least one of Types.
in_some_type_t([], _, false).
in_some_type_t([Type|Types], Value, T) :-
    in_type_t(Type, Value, InType),
    in_some_type_t(Types, Value, InAnother),
    truth_or(InType, InAnother, T).

truth_or(true, _, true).
truth_or(false, T, T).

% attested_t(Value, Type, T): T is true when Value is
% attested(AttestedValue, attestation(By, At, Reason, Evidence)) with AttestedValue in Type.
% By, At, Reason and Evidence come from the host and are not checked beyond being ground.
attested_t(attested(AttestedValue, Attestation), Type, T) :-
    attestation_t(Attestation, IsAttestation),
    attested_value_t(IsAttestation, Type, AttestedValue, T).
attested_t(Value, _, false) :-
    Value \= attested(_, _).

attestation_t(attestation(_, _, _, _), true).
attestation_t(Value, false) :-
    Value \= attestation(_, _, _, _).

attested_value_t(false, _, _, false).
attested_value_t(true, Type, AttestedValue, T) :-
    in_type_t(Type, AttestedValue, T).

% ---- tests ----------------------------------------------------------

test(an_empty_profile_has_no_problem) :-
    dsa_art_14_terms_and_conditions_order_input_problems([], Problems),
    Problems == [].

test(a_well_formed_profile_has_no_problem) :-
    dsa_art_14_terms_and_conditions_order_input_problems(
        [attribute(terms_and_conditions_changed, true),
         attribute(change_to_terms_and_conditions_is_significant, unsure),
         attribute(designated_as_very_large_online_platform_or_search_engine,
                   attested(true, attestation(host, at_time, commission_decision, none)))],
        Problems),
    Problems == [].

test(an_unbound_profile_is_wrong_type) :-
    dsa_art_14_terms_and_conditions_order_input_problems(_, Problems),
    Problems == [wrong_type(profile)].

test(a_partial_list_is_wrong_type) :-
    dsa_art_14_terms_and_conditions_order_input_problems([attribute(terms_and_conditions_changed, true)|_], Problems),
    Problems == [wrong_type(profile)].

test(a_non_attribute_element_is_wrong_type) :-
    dsa_art_14_terms_and_conditions_order_input_problems([attribute(terms_and_conditions_changed, true), other], Problems),
    Problems == [wrong_type(profile)].

test(a_duplicate_comes_before_an_unknown_key) :-
    dsa_art_14_terms_and_conditions_order_input_problems(
        [attribute(terms_and_conditions_changed, true),
         attribute(stray_key, value),
         attribute(terms_and_conditions_changed, unsure)],
        Problems),
    Problems == [duplicate_key(terms_and_conditions_changed), unknown_key(stray_key)].

test(a_crisp_key_given_unsure_is_wrong_type) :-
    dsa_art_14_terms_and_conditions_order_input_problems([attribute(provider_applies_or_enforces_restriction, unsure)], Problems),
    Problems == [wrong_type(provider_applies_or_enforces_restriction)].

test(an_attestation_with_an_unbound_argument_is_wrong_type) :-
    dsa_art_14_terms_and_conditions_order_input_problems(
        [attribute(designated_as_very_large_online_platform_or_search_engine,
                   attested(true, attestation(host, at_time, _, none)))],
        Problems),
    Problems == [wrong_type(designated_as_very_large_online_platform_or_search_engine)].

test(a_plain_boolean_designation_is_wrong_type) :-
    dsa_art_14_terms_and_conditions_order_input_problems(
        [attribute(designated_as_very_large_online_platform_or_search_engine, true)],
        Problems),
    Problems == [wrong_type(designated_as_very_large_online_platform_or_search_engine)].

test(an_unbound_key_is_named_as_given) :-
    dsa_art_14_terms_and_conditions_order_input_problems([attribute(Key, true)], Problems),
    Problems = [unknown_key(Named)],
    Named == Key.

test(the_check_has_exactly_one_answer) :-
    findall(Problems,
            dsa_art_14_terms_and_conditions_order_input_problems(
                [attribute(terms_and_conditions_changed, true),
                 attribute(terms_and_conditions_changed, false)],
                Problems),
            Answers),
    length(Answers, 1).

:- end_module(kernel).
