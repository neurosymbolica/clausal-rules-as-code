% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% queries.clausal -- QUERY-COMBINATOR layer for eu/dsa_art_14_terms_and_conditions_order.
% A TOP-LAYER consumer: it imports the determination slice's PUBLIC
% predicates it calls, and nothing else.
%
% dsa_art_14_terms_and_conditions_order_profile_keys/1: the top-level profile key schema,
%   the eighteen keys of the order's typed input contract, in root_exports order.
% dsa_art_14_terms_and_conditions_order_input_problems/2: the input check, re-exported as
%   the scaffold wrote it in kernel.clausal (never redefined here).
% dsa_art_14_terms_and_conditions_order_what_if/4 (#16 what-if): set one key to a
%   hypothetical value and re-evaluate the facade roll-up.
%
% The declared query types are served by the slice itself and re-exported by
% the package facade:
%   #2 eligibility   decide_dsa_art_14_terms_and_conditions_order/2 and
%                    dsa_art_14_terms_and_conditions_order_status/2 (roll-up label);
%   #7 justification dsa_art_14_terms_and_conditions_order_checklist/2, one item per
%                    paragraph, each carrying cite(...) of its paragraph.
% The roll-up is a convenience over the six independent answers (Q11): it adds
% no rule.
%
% ROOT EXPORTS. The test cases read the eighteen profile key atoms, the
% seventeen result atoms, the judgement value unsure and the atoms absent and
% not_attempted as package-root attributes. Each is recorded here as a fact of
% its own name and exported, so the generated package facade carries it. These
% facts are vocabulary records: no query calls them and they decide nothing
% statutory, so they carry no implements/1 marker.
%
% RESULT CONSTRUCTORS. The result constructors of the called contract are data:
% they are exported and declared with constructors/1 for their field names, and
% have no clauses.
%
% The profile is an ATTRIBUTE LIST, not a dict, so the override is written
% here as list plumbing: every occurrence of the key is dropped (a duplicate
% included) and one attribute(Key, Value) is appended. The order of the
% attributes is never read: the input check and the queries read by key.
% This clause decides nothing statutory and carries no implements/1 marker.
% =====================================================================

:- module(queries, [
    dsa_art_14_terms_and_conditions_order_profile_keys/1,
    dsa_art_14_terms_and_conditions_order_input_problems/2,
    dsa_art_14_terms_and_conditions_order_what_if/4,
    art_14_1_terms_and_conditions_compliant/0,
    art_14_1_terms_and_conditions_not_compliant/0,
    art_14_2_change_information_compliant/0,
    art_14_2_change_information_not_compliant/0,
    art_14_2_change_information_not_required/0,
    art_14_3_minors_explanation_compliant/0,
    art_14_3_minors_explanation_not_compliant/0,
    art_14_3_minors_explanation_not_required/0,
    art_14_4_restriction_enforcement_compliant/0,
    art_14_4_restriction_enforcement_not_compliant/0,
    art_14_4_restriction_enforcement_not_required/0,
    art_14_5_summary_compliant/0,
    art_14_5_summary_not_compliant/0,
    art_14_5_summary_not_required/0,
    art_14_6_official_languages_compliant/0,
    art_14_6_official_languages_not_compliant/0,
    art_14_6_official_languages_not_required/0,
    terms_and_conditions_include_information_on_restrictions_on_recipient_information/0,
    terms_and_conditions_include_information_on_content_moderation/0,
    terms_and_conditions_in_clear_plain_intelligible_user_friendly_and_unambiguous_language/0,
    terms_and_conditions_publicly_available_in_easily_accessible_and_machine_readable_format/0,
    provider_has_internal_complaint_handling_system/0,
    terms_and_conditions_include_rules_of_procedure_of_internal_complaint_handling_system/0,
    terms_and_conditions_changed/0,
    change_to_terms_and_conditions_is_significant/0,
    recipients_informed_of_change_to_terms_and_conditions/0,
    service_primarily_directed_at_minors/0,
    service_predominantly_used_by_minors/0,
    conditions_and_restrictions_explained_in_way_minors_can_understand/0,
    provider_applies_or_enforces_restriction/0,
    restriction_applied_in_diligent_objective_and_proportionate_manner/0,
    restriction_applied_with_due_regard_to_rights_and_legitimate_interests_of_parties/0,
    concise_clear_machine_readable_summary_of_terms_and_conditions_provided/0,
    terms_and_conditions_published_in_official_languages_of_all_member_states_of_service/0,
    designated_as_very_large_online_platform_or_search_engine/0,
    unsure/0,
    absent/0,
    not_attempted/0,
    indeterminate/1,
    needs_legal_review/2,
    open_textured/2,
    cross_reference_unresolved/2,
    resolution/2,
    inputs_relied_on/1,
    provenance/2,
    outside_fact/2,
    attested/2,
    attestation/4,
    url/2,
    document/2,
    input_problems/1,
    unknown_key/1,
    wrong_type/1,
    duplicate_key/1
]).

:- use_module(eu/dsa_art_14_terms_and_conditions_order/kernel, [dsa_art_14_terms_and_conditions_order_input_problems/2]).
:- use_module(eu/dsa_art_14_terms_and_conditions_order/dsa_art_14_terms_and_conditions_order, [dsa_art_14_terms_and_conditions_order_status/2]).

% ---- result constructors (data: exported, no clauses) -------------------
:- constructors([
    indeterminate(missing_keys),
    needs_legal_review(reason, context),
    open_textured(input, citation),
    cross_reference_unresolved(citation, target),
    resolution(target, resolution),
    inputs_relied_on(pairs),
    provenance(source, detail),
    outside_fact(key, attested),
    attested(value, attestation),
    attestation(by, at, reason, evidence),
    url(address, retrieved_at),
    document(upload_identifier, digest),
    input_problems(problems),
    unknown_key(key),
    wrong_type(key),
    duplicate_key(key)
]).

% schema of top-level profile keys: the keys of the order's typed input contract, in its order
dsa_art_14_terms_and_conditions_order_profile_keys([
    terms_and_conditions_include_information_on_restrictions_on_recipient_information,
    terms_and_conditions_include_information_on_content_moderation,
    terms_and_conditions_in_clear_plain_intelligible_user_friendly_and_unambiguous_language,
    terms_and_conditions_publicly_available_in_easily_accessible_and_machine_readable_format,
    provider_has_internal_complaint_handling_system,
    terms_and_conditions_include_rules_of_procedure_of_internal_complaint_handling_system,
    terms_and_conditions_changed,
    change_to_terms_and_conditions_is_significant,
    recipients_informed_of_change_to_terms_and_conditions,
    service_primarily_directed_at_minors,
    service_predominantly_used_by_minors,
    conditions_and_restrictions_explained_in_way_minors_can_understand,
    provider_applies_or_enforces_restriction,
    restriction_applied_in_diligent_objective_and_proportionate_manner,
    restriction_applied_with_due_regard_to_rights_and_legitimate_interests_of_parties,
    concise_clear_machine_readable_summary_of_terms_and_conditions_provided,
    terms_and_conditions_published_in_official_languages_of_all_member_states_of_service,
    designated_as_very_large_online_platform_or_search_engine
]).

% ---- root exports: the seventeen result atoms --------------------------
art_14_1_terms_and_conditions_compliant.
art_14_1_terms_and_conditions_not_compliant.
art_14_2_change_information_compliant.
art_14_2_change_information_not_compliant.
art_14_2_change_information_not_required.
art_14_3_minors_explanation_compliant.
art_14_3_minors_explanation_not_compliant.
art_14_3_minors_explanation_not_required.
art_14_4_restriction_enforcement_compliant.
art_14_4_restriction_enforcement_not_compliant.
art_14_4_restriction_enforcement_not_required.
art_14_5_summary_compliant.
art_14_5_summary_not_compliant.
art_14_5_summary_not_required.
art_14_6_official_languages_compliant.
art_14_6_official_languages_not_compliant.
art_14_6_official_languages_not_required.

% ---- root exports: the eighteen profile key atoms ----------------------
terms_and_conditions_include_information_on_restrictions_on_recipient_information.
terms_and_conditions_include_information_on_content_moderation.
terms_and_conditions_in_clear_plain_intelligible_user_friendly_and_unambiguous_language.
terms_and_conditions_publicly_available_in_easily_accessible_and_machine_readable_format.
provider_has_internal_complaint_handling_system.
terms_and_conditions_include_rules_of_procedure_of_internal_complaint_handling_system.
terms_and_conditions_changed.
change_to_terms_and_conditions_is_significant.
recipients_informed_of_change_to_terms_and_conditions.
service_primarily_directed_at_minors.
service_predominantly_used_by_minors.
conditions_and_restrictions_explained_in_way_minors_can_understand.
provider_applies_or_enforces_restriction.
restriction_applied_in_diligent_objective_and_proportionate_manner.
restriction_applied_with_due_regard_to_rights_and_legitimate_interests_of_parties.
concise_clear_machine_readable_summary_of_terms_and_conditions_provided.
terms_and_conditions_published_in_official_languages_of_all_member_states_of_service.
