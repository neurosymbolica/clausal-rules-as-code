% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_robustness.clausal -- ROBUSTNESS of the input check nis2_implementing_regulation_significant_incidents_input_problems/2 for a
% PROFILE that is an attribute list [attribute(Key, Value), ...]: an empty list, a
% value that is not a list, an unknown key and a value outside its type each get exactly
% one answer. Written by the scaffold from the order's typed input contract
% (input_contract.types.profile: attribute_list), not by the producer;
% do not edit or delete.
% Run: python -m clausal.testing eu/nis2_implementing_regulation_significant_incidents/tests/test_robustness.clausal
% =====================================================================
:- module(test_robustness, []).
:- use_module(eu/nis2_implementing_regulation_significant_incidents/queries, [nis2_implementing_regulation_significant_incidents_input_problems/2]).

test(an_empty_attribute_list_gets_exactly_one_answer) :-
    findall(Problems, nis2_implementing_regulation_significant_incidents_input_problems([], Problems), Answers),
    Answers == [[]].

test(a_profile_that_is_not_a_list_gets_one_non_empty_answer) :-
    findall(Problems, nis2_implementing_regulation_significant_incidents_input_problems(not_a_profile, Problems), Answers),
    Answers = [[_|_]].

test(an_unknown_key_is_named) :-
    findall(Problems, nis2_implementing_regulation_significant_incidents_input_problems([attribute(not_a_key_of_the_contract, true)], Problems), Answers),
    Answers = [Problems],
    memberchk(unknown_key(not_a_key_of_the_contract), Problems).

test(a_value_outside_the_type_of_scheduled_interruption_or_maintenance_is_named) :-
    findall(Problems, nis2_implementing_regulation_significant_incidents_input_problems([attribute(scheduled_interruption_or_maintenance, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(scheduled_interruption_or_maintenance), Problems).

test(a_value_outside_the_type_of_relevant_entity_type_is_named) :-
    findall(Problems, nis2_implementing_regulation_significant_incidents_input_problems([attribute(relevant_entity_type, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(relevant_entity_type), Problems).

test(a_value_outside_the_type_of_direct_financial_loss_euro_cents_is_named) :-
    findall(Problems, nis2_implementing_regulation_significant_incidents_input_problems([attribute(direct_financial_loss_euro_cents, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(direct_financial_loss_euro_cents), Problems).

test(a_value_outside_the_type_of_trade_secret_exfiltration_is_named) :-
    findall(Problems, nis2_implementing_regulation_significant_incidents_input_problems([attribute(trade_secret_exfiltration, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(trade_secret_exfiltration), Problems).

:- end_module(test_robustness).
