% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/nis2_implementing_regulation_significant_incidents.
%
% Instrument: Commission Implementing Regulation (EU) 2024/2690 of 17 October 2024
% (CELEX 32024R2690, original act; pinned source sha256
% 1d10f42c31a2b3c6b929b4696a04093ee1d84a298c0c0437a22f8718a9ffb3cd).
% Each record names its pinned unit id in its ref.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% Every key below is `status: verified` in citations-sources.yaml; each
% verbatim is an exact fragment of the pinned unit text (fragments stop
% before figures written with spaces, percent signs and typographic
% apostrophes).
%
% RETURNED in CITATIONS: eu_reg_2024_2690_art_3_1 and eu_reg_2024_2690_art_3_2
% only (fixed per RESULT). Every other key is carried by implements(Key)
% markers on the ways, or is the CITE of a referral row.
% eu_reg_2024_2690_art_1 is recorded for the entity-type reading (reading (2))
% and is NEVER returned in a result.
%
% PROVENANCE: implements(Key) :- citation(Key, _). Every operative clause
% opens its body with implements(Key) for the provision it decides.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

implements(Key) :-
    citation(Key, _).

% ---- Art 1: the relevant entities (read only to select the article of point (g)) ----
citation(eu_reg_2024_2690_art_1, [label-'Implementing Regulation (EU) 2024/2690 Art 1 (subject matter; the relevant entities)', ref-'https://eur-lex.europa.eu/eli/reg_impl/2024/2690/oj, CELEX 32024R2690, unit art_001', verbatim-'lays down the technical and the methodological requirements of the measures referred to in Article 21(2) of Directive (EU) 2022/2555']).

% ---- Art 3: the significance test ----
citation(eu_reg_2024_2690_art_3_1, [label-'Implementing Regulation (EU) 2024/2690 Art 3(1)', ref-'https://eur-lex.europa.eu/eli/reg_impl/2024/2690/oj, CELEX 32024R2690, unit parag_003.001', verbatim-'An incident shall be considered to be significant for the purposes of Article 23(3) of Directive (EU) 2022/2555 with regard to the relevant entities where one or more of the following criteria are fulfilled']).
citation(eu_reg_2024_2690_art_3_1_a, [label-'Implementing Regulation (EU) 2024/2690 Art 3(1)(a) (direct financial loss)', ref-'https://eur-lex.europa.eu/eli/reg_impl/2024/2690/oj, CELEX 32024R2690, unit point_003.001_a', verbatim-'the incident has caused or is capable of causing direct financial loss for the relevant entity that exceeds']).
citation(eu_reg_2024_2690_art_3_1_b, [label-'Implementing Regulation (EU) 2024/2690 Art 3(1)(b) (exfiltration of trade secrets)', ref-'https://eur-lex.europa.eu/eli/reg_impl/2024/2690/oj, CELEX 32024R2690, unit point_003.001_b', verbatim-'the incident has caused or is capable of causing the exfiltration of trade secrets']).
citation(eu_reg_2024_2690_art_3_1_c, [label-'Implementing Regulation (EU) 2024/2690 Art 3(1)(c) (death of a natural person)', ref-'https://eur-lex.europa.eu/eli/reg_impl/2024/2690/oj, CELEX 32024R2690, unit point_003.001_c', verbatim-'the incident has caused or is capable of causing the death of a natural person']).
citation(eu_reg_2024_2690_art_3_1_d, [label-'Implementing Regulation (EU) 2024/2690 Art 3(1)(d) (considerable damage to health)', ref-'https://eur-lex.europa.eu/eli/reg_impl/2024/2690/oj, CELEX 32024R2690, unit point_003.001_d', verbatim-'the incident has caused or is capable of causing considerable damage to a natural person']).
citation(eu_reg_2024_2690_art_3_1_e, [label-'Implementing Regulation (EU) 2024/2690 Art 3(1)(e) (suspectedly malicious unauthorised access)', ref-'https://eur-lex.europa.eu/eli/reg_impl/2024/2690/oj, CELEX 32024R2690, unit point_003.001_e', verbatim-'a successful, suspectedly malicious and unauthorised access to network and information systems occurred, which is capable of causing severe operational disruption']).
citation(eu_reg_2024_2690_art_3_1_f, [label-'Implementing Regulation (EU) 2024/2690 Art 3(1)(f) (criteria of Article 4)', ref-'https://eur-lex.europa.eu/eli/reg_impl/2024/2690/oj, CELEX 32024R2690, unit point_003.001_f', verbatim-'the incident meets the criteria set out in Article 4']).
citation(eu_reg_2024_2690_art_3_1_g, [label-'Implementing Regulation (EU) 2024/2690 Art 3(1)(g) (criteria of Articles 5 to 14)', ref-'https://eur-lex.europa.eu/eli/reg_impl/2024/2690/oj, CELEX 32024R2690, unit point_003.001_g', verbatim-'the incident meets one or more of the criteria set out in Articles 5 to 14']).
citation(eu_reg_2024_2690_art_3_2, [label-'Implementing Regulation (EU) 2024/2690 Art 3(2) (scheduled interruptions and planned maintenance)', ref-'https://eur-lex.europa.eu/eli/reg_impl/2024/2690/oj, CELEX 32024R2690, unit parag_003.002', verbatim-'Scheduled interruptions of service and planned consequences of scheduled maintenance operations carried out by or on behalf of the relevant entities shall not be considered to be significant incidents']).

% ---- Art 4: recurring incidents ----
citation(eu_reg_2024_2690_art_4, [label-'Implementing Regulation (EU) 2024/2690 Art 4 (recurring incidents)', ref-'https://eur-lex.europa.eu/eli/reg_impl/2024/2690/oj, CELEX 32024R2690, unit art_004', verbatim-'Incidents that individually are not considered a significant incident within the meaning of Article 3, shall be considered collectively as one significant incident where they meet all of the following criteria']).
citation(eu_reg_2024_2690_art_4_a, [label-'Implementing Regulation (EU) 2024/2690 Art 4(a) (at least twice within 6 months)', ref-'https://eur-lex.europa.eu/eli/reg_impl/2024/2690/oj, CELEX 32024R2690, unit point_004_a', verbatim-'they have occurred at least twice within']).
citation(eu_reg_2024_2690_art_4_b, [label-'Implementing Regulation (EU) 2024/2690 Art 4(b) (same apparent root cause)', ref-'https://eur-lex.europa.eu/eli/reg_impl/2024/2690/oj, CELEX 32024R2690, unit point_004_b', verbatim-'they have the same apparent root cause']).
