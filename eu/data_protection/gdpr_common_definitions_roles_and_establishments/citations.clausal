% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/data_protection/gdpr_common_definitions_roles_and_establishments.
% Source: Regulation (EU) 2016/679 (GDPR) Art 4, consolidated text
% 02016R0679-20160504 (in force from 2016-05-04, with the 2018 corrigendum).
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order. The
% verbatim pair is OMITTED where the key's entry in citations-sources.yaml
% is `status: unverified`. The Formex quotation marks around defined terms
% are markup and are not in the extracted text, so no verbatim quotes them.
%
% The nineteen citation_vocabulary keys come first, in vocabulary order;
% then the outside-fact TARGET (a lexicon entry, never in citation
% vocabulary order but last). The deferred points of Art 4 (4(17), 4(20),
% 4(21)) are disposed of in manifest.yaml deferred_set and carry no record
% here, since no clause of this order decides them.
%
% implements(Key) succeeds for every recorded key: the provenance marker
% each operative clause opens its body with.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

citation(eu_reg_2016_679_art_4_1, [label-'Regulation (EU) 2016/679 Art 4(1) definition of personal data', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (Art 4, point_004_1)', verbatim-'any information relating to an identified or identifiable natural person']).
citation(eu_reg_2016_679_art_4_7, [label-'Regulation (EU) 2016/679 Art 4(7) definition of controller', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (Art 4, point_004_7)', verbatim-'the natural or legal person, public authority, agency or other body which, alone or jointly with others, determines the purposes and means of the processing of personal data']).
citation(eu_reg_2016_679_art_4_8, [label-'Regulation (EU) 2016/679 Art 4(8) definition of processor', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (Art 4, point_004_8)', verbatim-'a natural or legal person, public authority, agency or other body which processes personal data on behalf of the controller']).
citation(eu_reg_2016_679_art_4_13, [label-'Regulation (EU) 2016/679 Art 4(13) definition of genetic data', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (Art 4, point_004_13)', verbatim-'personal data relating to the inherited or acquired genetic characteristics of a natural person which give unique information about the physiology or the health of that natural person']).
citation(eu_reg_2016_679_art_4_14, [label-'Regulation (EU) 2016/679 Art 4(14) definition of biometric data', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (Art 4, point_004_14)', verbatim-'personal data resulting from specific technical processing relating to the physical, physiological or behavioural characteristics of a natural person, which allow or confirm the unique identification of that natural person']).
citation(eu_reg_2016_679_art_4_15, [label-'Regulation (EU) 2016/679 Art 4(15) definition of data concerning health', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (Art 4, point_004_15)', verbatim-'personal data related to the physical or mental health of a natural person, including the provision of health care services, which reveal information about his or her health status']).
citation(eu_reg_2016_679_art_4_16, [label-'Regulation (EU) 2016/679 Art 4(16) definition of main establishment (chapeau)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (Art 4, point_004_16)', verbatim-'main establishment means']).
citation(eu_reg_2016_679_art_4_16_a, [label-'Regulation (EU) 2016/679 Art 4(16)(a) main establishment of a controller', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (Art 4, point_004_16_a)', verbatim-'the place of its central administration in the Union, unless the decisions on the purposes and means of the processing of personal data are taken in another establishment of the controller in the Union and the latter establishment has the power to have such decisions implemented']).
citation(eu_reg_2016_679_art_4_16_b, [label-'Regulation (EU) 2016/679 Art 4(16)(b) main establishment of a processor', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (Art 4, point_004_16_b)', verbatim-'if the processor has no central administration in the Union, the establishment of the processor in the Union where the main processing activities in the context of the activities of an establishment of the processor take place to the extent that the processor is subject to specific obligations under this Regulation']).
citation(eu_reg_2016_679_art_4_18, [label-'Regulation (EU) 2016/679 Art 4(18) definition of enterprise', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (Art 4, point_004_18)', verbatim-'a natural or legal person engaged in an economic activity, irrespective of its legal form, including partnerships or associations regularly engaged in an economic activity']).
citation(eu_reg_2016_679_art_4_19, [label-'Regulation (EU) 2016/679 Art 4(19) definition of group of undertakings', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (Art 4, point_004_19)', verbatim-'a controlling undertaking and its controlled undertakings']).
citation(eu_reg_2016_679_art_4_22, [label-'Regulation (EU) 2016/679 Art 4(22) definition of supervisory authority concerned (chapeau)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (Art 4, point_004_22)', verbatim-'a supervisory authority which is concerned by the processing of personal data because']).
citation(eu_reg_2016_679_art_4_22_a, [label-'Regulation (EU) 2016/679 Art 4(22)(a) supervisory authority concerned: controller or processor established in its Member State', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (Art 4, point_004_22_a)', verbatim-'the controller or processor is established on the territory of the Member State of that supervisory authority']).
citation(eu_reg_2016_679_art_4_22_b, [label-'Regulation (EU) 2016/679 Art 4(22)(b) supervisory authority concerned: data subjects substantially affected', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (Art 4, point_004_22_b)', verbatim-'data subjects residing in the Member State of that supervisory authority are substantially affected or likely to be substantially affected by the processing']).
citation(eu_reg_2016_679_art_4_22_c, [label-'Regulation (EU) 2016/679 Art 4(22)(c) supervisory authority concerned: complaint lodged', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (Art 4, point_004_22_c)', verbatim-'a complaint has been lodged with that supervisory authority']).
citation(eu_reg_2016_679_art_4_23, [label-'Regulation (EU) 2016/679 Art 4(23) definition of cross-border processing (chapeau)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (Art 4, point_004_23)', verbatim-'cross-border processing means either']).
citation(eu_reg_2016_679_art_4_23_a, [label-'Regulation (EU) 2016/679 Art 4(23)(a) cross-border processing: establishments in more than one Member State', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (Art 4, point_004_23_a)', verbatim-'processing of personal data which takes place in the context of the activities of establishments in more than one Member State of a controller or processor in the Union where the controller or processor is established in more than one Member State']).
citation(eu_reg_2016_679_art_4_23_b, [label-'Regulation (EU) 2016/679 Art 4(23)(b) cross-border processing: single establishment, substantial effect in more than one Member State', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (Art 4, point_004_23_b)', verbatim-'processing of personal data which takes place in the context of the activities of a single establishment of a controller or processor in the Union but which substantially affects or is likely to substantially affect data subjects in more than one Member State']).
citation(eu_reg_2016_679_art_4_24, [label-'Regulation (EU) 2016/679 Art 4(24) definition of relevant and reasoned objection', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (Art 4, point_004_24)', verbatim-'clearly demonstrates the significance of the risks posed by the draft decision as regards the fundamental rights and freedoms of data subjects']).

% The outside-fact TARGET of Art 4(7), second clause: a lexicon entry for the
% Union or Member State law that provides for the controller.
citation(union_or_member_state_law_providing_for_controller, [label-'Union or Member State law providing for the controller or the specific criteria for its nomination (cross-reference in Regulation (EU) 2016/679 Art 4(7), second clause)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (Art 4, point_004_7)']).

% Provenance marker: succeeds for every recorded key, fails for any other.
implements(Key) :-
    citation(Key, _).

test(every_vocabulary_key_is_recorded) :-
    implements(eu_reg_2016_679_art_4_7),
    implements(eu_reg_2016_679_art_4_16_a),
    implements(eu_reg_2016_679_art_4_23_b).
test(an_unrecorded_key_does_not_implement, fail) :-
    implements(eu_todo_primary_source).

:- end_module(citations).
