% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/data_protection/gdpr_data_subject_rights_response_period.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% The verbatim pair is OMITTED while the key's entry in
% citations-sources.yaml is `status: unverified`; `status: verified`
% requires a non-empty ref AND a verbatim that is an exact substring of
% the source.
%
% Load-bearing keys:
%   eu_reg_2016_679_art_12_3    -- GDPR Art 12(3), the one-month period and
%                                  its extension (the only citation a result
%                                  of this order returns).
%   eu_reg_1971_1182_art_3      -- Reg 1182/71 Art 3 as a whole (the CITATION
%                                  of the outside fact public_holidays).
%   eu_reg_1971_1182_art_3_1    -- Art 3(1), second subparagraph: the day of
%                                  the event is not counted (implements/1 only).
%   eu_reg_1971_1182_art_3_2_c  -- Art 3(2)(c): same date in the last month,
%                                  else its last day (implements/1 only).
%   eu_reg_1971_1182_art_3_4    -- Art 3(4): Saturday / Sunday / public
%                                  holiday shift (implements/1 only).
% Context keys (the CITATION column of the outside-facts table; no query of
% this order reads those facts, so no result returns them):
%   eu_reg_2016_679_art_17_1_e, eu_reg_2016_679_art_17_3_b,
%   eu_reg_2016_679_art_22_2_b, eu_reg_2016_679_art_23_1.
%
% PROVENANCE: every operative clause opens its body with implements(Key);
% implements/1 succeeds exactly for a key recorded here.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

citation(eu_reg_2016_679_art_12_3, [label-'Regulation (EU) 2016/679 (GDPR) Art 12(3) (time limit for information on action taken on a request under Articles 15 to 22, and its extension)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit 02016R0679-20160504#parag_012.003)', verbatim-'The controller shall provide information on action taken on a request under Articles 15 to 22 to the data subject without undue delay and in any event within one month of receipt of the request. That period may be extended by two further months where necessary, taking into account the complexity and number of the requests.']).

citation(eu_reg_1971_1182_art_3, [label-'Regulation (EEC, Euratom) No 1182/71 Art 3 (computation of periods, dates and time limits)', ref-'CELEX 31971R1182, OJ L 124, 8.6.1971; Formex extract 31971R1182-art003.fmx4.xml from http://publications.europa.eu/resource/celex/31971R1182.ENG.fmx4 (sha256 55a56126f24456ad48cb09bc6a7698d768cceec70806959dda928d252e96b8c1)', verbatim-'Where the last day of a period expressed otherwise than in hours is a public holiday, Sunday or Saturday, the period shall end with the expiry of the last hour of the following working day.']).

citation(eu_reg_1971_1182_art_3_1, [label-'Regulation (EEC, Euratom) No 1182/71 Art 3(1), second subparagraph (the day of the event is not counted)', ref-'CELEX 31971R1182, OJ L 124, 8.6.1971; Formex extract 31971R1182-art003.fmx4.xml from http://publications.europa.eu/resource/celex/31971R1182.ENG.fmx4 (sha256 55a56126f24456ad48cb09bc6a7698d768cceec70806959dda928d252e96b8c1)', verbatim-'Where a period expressed in days, weeks, months or years is to be calculated from the moment at which an event occurs or an action takes place, the day during which that event occurs or that action takes place shall not be considered as falling within the period in question.']).

citation(eu_reg_1971_1182_art_3_2_c, [label-'Regulation (EEC, Euratom) No 1182/71 Art 3(2)(c) (end of a period expressed in weeks, months or years)', ref-'CELEX 31971R1182, OJ L 124, 8.6.1971; Formex extract 31971R1182-art003.fmx4.xml from http://publications.europa.eu/resource/celex/31971R1182.ENG.fmx4 (sha256 55a56126f24456ad48cb09bc6a7698d768cceec70806959dda928d252e96b8c1)', verbatim-'a period expressed in weeks, months or years shall start at the beginning of the first hour of the first day of the period, and shall end with the expiry of the last hour of whichever day in the last week, month or year is the same day of the week, or falls on the same date, as the day from which the period runs. If, in a period expressed in months or in years, the day on which it should expire does not occur in the last month, the period shall end with the expiry of the last hour of the last day of that month']).

citation(eu_reg_1971_1182_art_3_4, [label-'Regulation (EEC, Euratom) No 1182/71 Art 3(4) (last day on a public holiday, Sunday or Saturday moves to the following working day)', ref-'CELEX 31971R1182, OJ L 124, 8.6.1971; Formex extract 31971R1182-art003.fmx4.xml from http://publications.europa.eu/resource/celex/31971R1182.ENG.fmx4 (sha256 55a56126f24456ad48cb09bc6a7698d768cceec70806959dda928d252e96b8c1)', verbatim-'Where the last day of a period expressed otherwise than in hours is a public holiday, Sunday or Saturday, the period shall end with the expiry of the last hour of the following working day.']).

citation(eu_reg_2016_679_art_17_1_e, [label-'Regulation (EU) 2016/679 (GDPR) Art 17(1)(e) (erasure for compliance with a legal obligation in Union or Member State law)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (Art 17(1)(e))']).

citation(eu_reg_2016_679_art_17_3_b, [label-'Regulation (EU) 2016/679 (GDPR) Art 17(3)(b) (processing required by Union or Member State law)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (Art 17(3)(b))']).

citation(eu_reg_2016_679_art_22_2_b, [label-'Regulation (EU) 2016/679 (GDPR) Art 22(2)(b) (automated decision authorised by Union or Member State law with suitable safeguards)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (Art 22(2)(b))']).

citation(eu_reg_2016_679_art_23_1, [label-'Regulation (EU) 2016/679 (GDPR) Art 23(1) (restriction of data subject rights by legislative measure)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (Art 23(1))']).

% implements(Key): the provenance marker an operative clause opens with.
% It succeeds exactly for a recorded key; a misspelt key fails.
implements(Key) :-
    citation(Key, _).

:- end_module(citations).
