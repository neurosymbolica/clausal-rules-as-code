% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_robustness.clausal -- ROBUSTNESS of the input check gdpr_data_subject_rights_portability_and_objection_input_problems/2 for a
% PROFILE that is an attribute list [attribute(Key, Value), ...]: an empty list, a
% value that is not a list, an unknown key and a value outside its type each get exactly
% one answer. Written by the scaffold from the order's typed input contract
% (input_contract.types.profile: attribute_list), not by the producer;
% do not edit or delete.
% Run: python -m clausal.testing eu/data_protection/gdpr_data_subject_rights_portability_and_objection/tests/test_robustness.clausal
% =====================================================================
:- module(test_robustness, []).
:- use_module(eu/data_protection/gdpr_data_subject_rights_portability_and_objection/queries, [gdpr_data_subject_rights_portability_and_objection_input_problems/2]).

test(an_empty_attribute_list_gets_exactly_one_answer) :-
    findall(Problems, gdpr_data_subject_rights_portability_and_objection_input_problems([], Problems), Answers),
    Answers == [[]].

test(a_profile_that_is_not_a_list_gets_one_non_empty_answer) :-
    findall(Problems, gdpr_data_subject_rights_portability_and_objection_input_problems(not_a_profile, Problems), Answers),
    Answers = [[_|_]].

test(an_unknown_key_is_named) :-
    findall(Problems, gdpr_data_subject_rights_portability_and_objection_input_problems([attribute(not_a_key_of_the_contract, access)], Problems), Answers),
    Answers = [Problems],
    memberchk(unknown_key(not_a_key_of_the_contract), Problems).

test(a_value_outside_the_type_of_request_type_is_named) :-
    findall(Problems, gdpr_data_subject_rights_portability_and_objection_input_problems([attribute(request_type, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(request_type), Problems).

test(a_value_outside_the_type_of_request_received_on_is_named) :-
    findall(Problems, gdpr_data_subject_rights_portability_and_objection_input_problems([attribute(request_received_on, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(request_received_on), Problems).

test(a_value_outside_the_type_of_extension_claimed_is_named) :-
    findall(Problems, gdpr_data_subject_rights_portability_and_objection_input_problems([attribute(extension_claimed, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(extension_claimed), Problems).

test(a_value_outside_the_type_of_extension_necessary_for_complexity_and_number_is_named) :-
    findall(Problems, gdpr_data_subject_rights_portability_and_objection_input_problems([attribute(extension_necessary_for_complexity_and_number, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(extension_necessary_for_complexity_and_number), Problems).

:- end_module(test_robustness).
