% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/data_protection/gdpr_corrective_powers_named.
%
% Instrument: Regulation (EU) 2016/679 (General Data Protection
% Regulation), consolidated text of 4 May 2016 (CELEX 02016R0679-20160504).
% Keys follow the CANONICAL lexicon scheme (_lexicon/citations.yaml); the
% short segments reg and art are mandated by that scheme.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% Each verbatim below is an exact substring of the pinned unit text; the
% matching entry in citations-sources.yaml is status: verified.
% In a quoted atom an apostrophe is written twice ('').
%
% EMITTED in results: eu_reg_2016_679_art_58_2 (the chapeau) and
% eu_reg_2016_679_art_58_2_a to eu_reg_2016_679_art_58_2_j (the points).
% RECORDED, NEVER EMITTED: eu_reg_2016_679_art_58_4, _58_5 and _58_6,
% quoted for readings (1) and (15) only (deferred set); no limb reads them.
%
% PROVENANCE: every operative clause opens its body with implements(Key),
% Key one of the atoms recorded here. implements/1 succeeds for every
% recorded key and fails for any other, so a misspelt key fails the clause.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

% Provenance marker: succeeds for every recorded key, never changes an answer.
implements(Key) :-
    citation(Key, _).

% ---- Article 58(2): the chapeau --------------------------------------
citation(eu_reg_2016_679_art_58_2, [label-'Regulation (EU) 2016/679 Art 58(2) (chapeau: the corrective powers of each supervisory authority)', ref-'02016R0679-20160504#parag_058.002', verbatim-'Each supervisory authority shall have all of the following corrective powers']).

% ---- Article 58(2), points (a) to (j) ----------------------------------
citation(eu_reg_2016_679_art_58_2_a, [label-'Regulation (EU) 2016/679 Art 58(2)(a) (warnings: intended processing likely to infringe)', ref-'02016R0679-20160504#point_058.002_a', verbatim-'to issue warnings to a controller or processor that intended processing operations are likely to infringe provisions of this Regulation']).

citation(eu_reg_2016_679_art_58_2_b, [label-'Regulation (EU) 2016/679 Art 58(2)(b) (reprimands: processing that has infringed)', ref-'02016R0679-20160504#point_058.002_b', verbatim-'to issue reprimands to a controller or a processor where processing operations have infringed provisions of this Regulation']).

citation(eu_reg_2016_679_art_58_2_c, [label-'Regulation (EU) 2016/679 Art 58(2)(c) (order to comply with the data subject''s requests to exercise rights)', ref-'02016R0679-20160504#point_058.002_c', verbatim-'to order the controller or the processor to comply with the data subject''s requests to exercise his or her rights pursuant to this Regulation']).

citation(eu_reg_2016_679_art_58_2_d, [label-'Regulation (EU) 2016/679 Art 58(2)(d) (order to bring processing operations into compliance)', ref-'02016R0679-20160504#point_058.002_d', verbatim-'to order the controller or processor to bring processing operations into compliance with the provisions of this Regulation, where appropriate, in a specified manner and within a specified period']).

citation(eu_reg_2016_679_art_58_2_e, [label-'Regulation (EU) 2016/679 Art 58(2)(e) (order to the controller to communicate a personal data breach to the data subject)', ref-'02016R0679-20160504#point_058.002_e', verbatim-'to order the controller to communicate a personal data breach to the data subject']).

citation(eu_reg_2016_679_art_58_2_f, [label-'Regulation (EU) 2016/679 Art 58(2)(f) (temporary or definitive limitation including a ban on processing)', ref-'02016R0679-20160504#point_058.002_f', verbatim-'to impose a temporary or definitive limitation including a ban on processing']).

citation(eu_reg_2016_679_art_58_2_g, [label-'Regulation (EU) 2016/679 Art 58(2)(g) (order of rectification, erasure or restriction under Arts 16 to 18, with notification of recipients)', ref-'02016R0679-20160504#point_058.002_g', verbatim-'to order the rectification or erasure of personal data or restriction of processing pursuant to Articles 16, 17 and 18 and the notification of such actions to recipients to whom the personal data have been disclosed pursuant to Article 17(2) and Article 19']).

citation(eu_reg_2016_679_art_58_2_h, [label-'Regulation (EU) 2016/679 Art 58(2)(h) (withdrawal of a certification, or order to the certification body to withdraw it or not to issue it)', ref-'02016R0679-20160504#point_058.002_h', verbatim-'to withdraw a certification or to order the certification body to withdraw a certification issued pursuant to Articles 42 and 43, or to order the certification body not to issue certification if the requirements for the certification are not or are no longer met']).

citation(eu_reg_2016_679_art_58_2_i, [label-'Regulation (EU) 2016/679 Art 58(2)(i) (administrative fine pursuant to Article 83)', ref-'02016R0679-20160504#point_058.002_i', verbatim-'to impose an administrative fine pursuant to Article 83, in addition to, or instead of measures referred to in this paragraph, depending on the circumstances of each individual case']).

citation(eu_reg_2016_679_art_58_2_j, [label-'Regulation (EU) 2016/679 Art 58(2)(j) (suspension of data flows to a third country or an international organisation)', ref-'02016R0679-20160504#point_058.002_j', verbatim-'to order the suspension of data flows to a recipient in a third country or to an international organisation']).

% ---- Article 58(4) to (6): quoted, deferred, never emitted -------------
citation(eu_reg_2016_679_art_58_4, [label-'Regulation (EU) 2016/679 Art 58(4) (safeguards on the exercise of the powers; deferred)', ref-'02016R0679-20160504#parag_058.004', verbatim-'The exercise of the powers conferred on the supervisory authority pursuant to this Article shall be subject to appropriate safeguards, including effective judicial remedy and due process, set out in Union and Member State law in accordance with the Charter.']).

citation(eu_reg_2016_679_art_58_5, [label-'Regulation (EU) 2016/679 Art 58(5) (power under Member State law to bring infringements before the judicial authorities; deferred)', ref-'02016R0679-20160504#parag_058.005', verbatim-'Each Member State shall provide by law that its supervisory authority shall have the power to bring infringements of this Regulation to the attention of the judicial authorities and where appropriate, to commence or engage otherwise in legal proceedings, in order to enforce the provisions of this Regulation.']).

citation(eu_reg_2016_679_art_58_6, [label-'Regulation (EU) 2016/679 Art 58(6) (additional powers under Member State law; deferred)', ref-'02016R0679-20160504#parag_058.006', verbatim-'Each Member State may provide by law that its supervisory authority shall have additional powers to those referred to in paragraphs 1, 2 and 3. The exercise of those powers shall not impair the effective operation of Chapter VII.']).

:- end_module(citations).
