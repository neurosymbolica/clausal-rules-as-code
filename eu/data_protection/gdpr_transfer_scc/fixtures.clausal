    attribute(local_laws_assessment_documented, true),
    attribute(processor_combines_received_data_with_data_collected_in_union, false),
    attribute(annex_i_a_list_of_parties_completed, true),
    attribute(annex_i_b_description_of_transfer_completed, true),
    attribute(annex_i_c_competent_supervisory_authority_identified, true),
    attribute(annex_ii_measures_described_in_specific_terms, true),
    attribute(sub_processor_authorisation_option, general_written_authorisation),
    attribute(annex_iii_list_of_sub_processors_completed, false)
]) :-
    fixture_attested(true, InForce),
    fixture_attested(true, ExporterSubject),
    fixture_attested(false, ImporterSubject),
    fixture_attested(true, NoReason).

% Module Four without combination: Clause 14 does not apply, so the absent
% warranty and the undocumented assessment do not change the answer.
gdpr_transfer_scc_profile_for(module_four_no_combination, [
    attribute(standard_contractual_clauses_decision_in_force, InForce),
    attribute(exporter_processing_subject_to_gdpr, ExporterSubject),
    attribute(importer_processing_subject_to_gdpr, ImporterSubject),
    attribute(exporter_role, processor),
    attribute(importer_role, controller),
    attribute(standard_contractual_clauses_concluded, true),
    attribute(module_selected, module_four),
    attribute(clauses_modified, false),
    attribute(added_clauses_contradict_clauses, false),
    attribute(local_laws_assessment_documented, false),
    attribute(processor_combines_received_data_with_data_collected_in_union, false),
    attribute(annex_i_a_list_of_parties_completed, true),
    attribute(annex_i_b_description_of_transfer_completed, true)
]) :-
    fixture_attested(true, InForce),
    fixture_attested(true, ExporterSubject),
    fixture_attested(false, ImporterSubject).

% Near miss: the EU processor combines the data, so Clause 14 applies and the
% undocumented assessment defeats the safeguard.
gdpr_transfer_scc_profile_for(module_four_with_combination_undocumented, [
    attribute(standard_contractual_clauses_decision_in_force, InForce),
    attribute(exporter_processing_subject_to_gdpr, ExporterSubject),
    attribute(importer_processing_subject_to_gdpr, ImporterSubject),
    attribute(no_reason_to_believe_local_laws_prevent_compliance, NoReason),
    attribute(exporter_role, processor),
    attribute(importer_role, controller),
    attribute(standard_contractual_clauses_concluded, true),
    attribute(module_selected, module_four),
    attribute(clauses_modified, false),
    attribute(added_clauses_contradict_clauses, false),
    attribute(local_laws_assessment_documented, false),
    attribute(processor_combines_received_data_with_data_collected_in_union, true),
    attribute(annex_i_a_list_of_parties_completed, true),
    attribute(annex_i_b_description_of_transfer_completed, true)
]) :-
    fixture_attested(true, InForce),
    fixture_attested(true, ExporterSubject),
    fixture_attested(false, ImporterSubject),
    fixture_attested(true, NoReason).

% Input problems: a repeated contract key and a key outside the contract.
gdpr_transfer_scc_profile_for(duplicate_and_unknown_keys, [
    attribute(exporter_role, controller),
    attribute(exporter_role, processor),
    attribute(colour, red)
]).

% Input problem: no profile at all (an unbound term).
gdpr_transfer_scc_profile_for(unbound_profile, _UnboundProfile).

% ---- Convenience wrapper ---------------------------------------------
gdpr_transfer_scc_assess(Subject, Result) :-
    gdpr_transfer_scc_profile_for(Subject, Profile),
    decide_gdpr_transfer_scc(Profile, Result).

:- end_module(fixtures).
