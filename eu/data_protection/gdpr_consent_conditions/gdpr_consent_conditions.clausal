% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% gdpr_consent_conditions.clausal -- the GDPR Art 7 consent conditions and
% Art 11 identification determination for eu/data_protection/gdpr_consent_conditions.
% Source: Regulation (EU) 2016/679 Arts 7(1) to 7(4), 11(1), 11(2).
%
% The profile is an attribute list read with profile_get/3 and profile_lacks/2
% only after the input check (kernel) gives []. Crisp keys read as true, false
% or absent. Outside facts read as stated(Value, Attested) or absent; the
% attested term is copied into the basis and never inspected.
% Every query yields exactly one solution: each step is disjoint clauses.
% =====================================================================

:- module(gdpr_consent_conditions, [
    decide_gdpr_consent_conditions/2,
    gdpr_consent_conditions_status/2,
    gdpr_consent_conditions_checklist/2,
    gdpr_consent_conditions_decision_resolvable/1,
    gdpr_consent_conditions_status_values/1,
    consent_conditions_status/4,
    consent_declaration_effect/3,
    consent_assessment_factors/2,
    identification_obligation/4,
    identification_information_duty/4,
    identification_rights_effect/4,
    not_applicable/0,
    conditions_met/0,
    conditions_not_met/0,
    part_not_binding/0,
    no_part_infringing/0,
    not_obliged_to_acquire_identifying_information/0,
    art11_1_not_engaged/0,
    art11_2_not_engaged/0,
    must_inform_data_subject/0,
    need_not_inform_data_subject/0,
    articles_15_to_20_apply/0,
    articles_15_to_20_do_not_apply/0,
    indeterminate/1,
    needs_legal_review/2,
    inputs_relied_on/1,
    provenance/2,
    input_problems/1,
    unknown_key/1,
    wrong_type/1,
    duplicate_key/1,
    factor/2,
    cross_reference_unresolved/2,
    resolution/2,
    outside_fact/2,
    attested/2,
    attestation/4,
    url/2,
    document/2
]).

:- constructors([indeterminate(missing_keys), needs_legal_review(reason, context), inputs_relied_on(pairs), provenance(clause, citations), input_problems(problems), unknown_key(key), wrong_type(key), duplicate_key(key), factor(name, citation), cross_reference_unresolved(citation, target), resolution(target, outcome), outside_fact(key, attested), attested(value, attestation), attestation(by, at, reason, evidence), url(address, retrieved_at), document(upload_id, digest)]).

:- use_module(formalize_lib, [profile_get/3, profile_lacks/2]).
:- use_module(eu/data_protection/gdpr_consent_conditions/kernel, [gdpr_consent_conditions_input_problems/2]).
:- use_module(eu/data_protection/gdpr_consent_conditions/citations, [implements/1]).

% ---- the verdict vocabulary of consent_conditions_status/4 -------------
gdpr_consent_conditions_status_values([not_applicable, conditions_met, conditions_not_met]).

% ---- result atoms (constructors are data and have no clauses) ----------
not_applicable.
conditions_met.
conditions_not_met.
part_not_binding.
no_part_infringing.
not_obliged_to_acquire_identifying_information.
art11_1_not_engaged.
art11_2_not_engaged.
must_inform_data_subject.
need_not_inform_data_subject.
articles_15_to_20_apply.
articles_15_to_20_do_not_apply.

% ---- the outside facts: key, its citation, its referral target --------
outside_fact_row(consent_demonstrable, cite(eu_reg_2016_679_art_7_1), cite(consent_demonstration_statement)).
outside_fact_row(request_clearly_distinguishable_and_intelligible, cite(eu_reg_2016_679_art_7_2), cite(consent_request_presentation_statement)).
outside_fact_row(withdrawal_as_easy_as_giving_consent, cite(eu_reg_2016_679_art_7_3), cite(withdrawal_ease_statement)).
outside_fact_row(consent_freely_given, cite(eu_reg_2016_679_art_7_4), cite(consent_freely_given_statement)).
outside_fact_row(purposes_do_not_require_identification, cite(eu_reg_2016_679_art_11_1), cite(identification_not_required_statement)).
outside_fact_row(able_to_demonstrate_not_in_position_to_identify, cite(eu_reg_2016_679_art_11_2), cite(inability_to_identify_statement)).
outside_fact_row(informing_data_subject_possible, cite(eu_reg_2016_679_art_11_2), cite(informing_possible_statement)).

% THE ABSENT REFERRAL for one absent outside fact.
referral(Key, needs_legal_review(cross_reference_unresolved(Citation, Target), [resolution(Target, not_attempted), inputs_relied_on([Key-absent])])) :-
    outside_fact_row(Key, Citation, Target).

% ---- reading the profile ----------------------------------------------
crisp_state(Profile, Key, absent) :-
    profile_lacks(Profile, Key).
crisp_state(Profile, Key, Value) :-
    profile_get(Profile, Key, Value).

outside_state(Profile, Key, absent) :-
    profile_lacks(Profile, Key).
outside_state(Profile, Key, stated(Value, Attested)) :-
    profile_get(Profile, Key, Attested),
    Attested = attested(Value, _).

% ---- small plumbing, one clause per case ------------------------------
state_is_false(stated(false, _), true).
state_is_false(stated(true, _), false).
state_is_false(absent, false).

crisp_is_false(false, true).
crisp_is_false(true, false).
crisp_is_false(absent, false).

either_true(true, _, true).
either_true(false, Flag, Flag).

cite_if(true, Cite, [Cite]).
cite_if(false, _, []).

basis_if(true, Key, stated(_, Attested), [outside_fact(Key, Attested)]).
basis_if(false, _, _, []).

absent_key(absent, Key, [Key]).
absent_key(true, _, []).
absent_key(false, _, []).

absent_keys_of(absent, Key, [Key]).
absent_keys_of(stated(_, _), _, []).

% ---- Art 7: the four limbs (a flag is true when the limb is UNMET) ----
limb_one_flag(Demonstrable, Flag) :-
    implements(eu_reg_2016_679_art_7_1),
    state_is_false(Demonstrable, Flag).

limb_two_flag(Declaration, Distinguishable, Flag) :-
    implements(eu_reg_2016_679_art_7_2),
    declaration_flag(Declaration, Distinguishable, Flag).

declaration_flag(true, Distinguishable, Flag) :-
    state_is_false(Distinguishable, Flag).
declaration_flag(false, _, false).
declaration_flag(absent, _, false).

limb_three_flag(Informed, Easy, Flag) :-
    implements(eu_reg_2016_679_art_7_3),
    crisp_is_false(Informed, InformedFlag),
    state_is_false(Easy, EasyFlag),
    either_true(InformedFlag, EasyFlag, Flag).

limb_four_flag(Freely, Flag) :-
    implements(eu_reg_2016_679_art_7_4),
    state_is_false(Freely, Flag).

% ---- consent_conditions_status/4 --------------------------------------
consent_conditions_status(Profile, Status, Basis, Citations) :-
    gdpr_consent_conditions_input_problems(Profile, Problems),
    conditions_for_problems(Problems, Profile, Status, Basis, Citations).

conditions_for_problems([Problem|Problems], _, input_problems([Problem|Problems]), [], []).
conditions_for_problems([], Profile, Status, Basis, Citations) :-
    crisp_state(Profile, processing_based_on_consent, Scope),
    conditions_for_scope(Scope, Profile, Status, Basis, Citations).

conditions_for_scope(absent, _, indeterminate([processing_based_on_consent]), [], []).
conditions_for_scope(false, _, not_applicable, [], []).
conditions_for_scope(true, Profile, Status, Basis, Citations) :-
    crisp_state(Profile, consent_in_declaration_with_other_matters, Declaration),
    crisp_state(Profile, informed_of_withdrawal_right_before_consent, Informed),
    outside_state(Profile, consent_demonstrable, Demonstrable),
    outside_state(Profile, request_clearly_distinguishable_and_intelligible, Distinguishable),
    outside_state(Profile, withdrawal_as_easy_as_giving_consent, Easy),
    outside_state(Profile, consent_freely_given, Freely),
    limb_one_flag(Demonstrable, FlagOne),
    limb_two_flag(Declaration, Distinguishable, FlagTwo),
    limb_three_flag(Informed, Easy, FlagThree),
    limb_four_flag(Freely, FlagFour),
    cite_if(FlagOne, cite(eu_reg_2016_679_art_7_1), CitesOne),
    cite_if(FlagTwo, cite(eu_reg_2016_679_art_7_2), CitesTwo),
    cite_if(FlagThree, cite(eu_reg_2016_679_art_7_3), CitesThree),
    cite_if(FlagFour, cite(eu_reg_2016_679_art_7_4), CitesFour),
    append([CitesOne, CitesTwo, CitesThree, CitesFour], Unmet),
    state_is_false(Easy, EasyFalse),
    basis_if(FlagOne, consent_demonstrable, Demonstrable, BasisOne),
    basis_if(FlagTwo, request_clearly_distinguishable_and_intelligible, Distinguishable, BasisTwo),
    basis_if(EasyFalse, withdrawal_as_easy_as_giving_consent, Easy, BasisThree),
    basis_if(FlagFour, consent_freely_given, Freely, BasisFour),
    append([BasisOne, BasisTwo, BasisThree, BasisFour], NotMetBasis),
    conditions_for_limbs(Unmet, NotMetBasis, facts(Declaration, Informed, Demonstrable, Distinguishable, Easy, Freely), Status, Basis, Citations).

% Step 3: any unmet limb decides before an absent key is read.
conditions_for_limbs([Cite|Cites], NotMetBasis, _, conditions_not_met, NotMetBasis, [Cite|Cites]).
conditions_for_limbs([], _, Facts, Status, Basis, Citations) :-
    Facts = facts(Declaration, Informed, _, _, _, _),
    absent_key(Declaration, consent_in_declaration_with_other_matters, DeclarationMissing),
    absent_key(Informed, informed_of_withdrawal_right_before_consent, InformedMissing),
    append(DeclarationMissing, InformedMissing, Missing),
    conditions_for_crisp(Missing, Facts, Status, Basis, Citations).

% Step 4: a missing needed crisp key is reported before a cross-reference.
conditions_for_crisp([Key|Keys], _, indeterminate([Key|Keys]), [], []).
conditions_for_crisp([], Facts, Status, Basis, Citations) :-
    Facts = facts(Declaration, _, Demonstrable, Distinguishable, Easy, Freely),
    absent_keys_of(Demonstrable, consent_demonstrable, AbsentOne),
    required_absent(Declaration, Distinguishable, request_clearly_distinguishable_and_intelligible, AbsentTwo),
    absent_keys_of(Easy, withdrawal_as_easy_as_giving_consent, AbsentThree),
    absent_keys_of(Freely, consent_freely_given, AbsentFour),
    append([AbsentOne, AbsentTwo, AbsentThree, AbsentFour], Absent),
    conditions_for_outside(Absent, Facts, Status, Basis, Citations).

required_absent(true, Distinguishable, Key, Absent) :-
    absent_keys_of(Distinguishable, Key, Absent).
required_absent(false, _, _, []).
required_absent(absent, _, _, []).

% Steps 5 and 6: the first absent needed outside fact refers, else the conditions are met.
conditions_for_outside([Key|_], _, Status, [], []) :-
    referral(Key, Status).
conditions_for_outside([], Facts, conditions_met, Basis, Citations) :-
    Facts = facts(Declaration, _, stated(_, DemonstrableAttested), Distinguishable, stated(_, EasyAttested), stated(_, FreelyAttested)),
    declaration_basis(Declaration, Distinguishable, DeclarationBasis),
    declaration_cites(Declaration, DeclarationCites),
    append([[outside_fact(consent_demonstrable, DemonstrableAttested)], DeclarationBasis, [outside_fact(withdrawal_as_easy_as_giving_consent, EasyAttested)], [outside_fact(consent_freely_given, FreelyAttested)]], Basis),
    append([[cite(eu_reg_2016_679_art_7_1)], DeclarationCites, [cite(eu_reg_2016_679_art_7_3)], [cite(eu_reg_2016_679_art_7_4)]], Citations).

declaration_basis(true, stated(_, Attested), [outside_fact(request_clearly_distinguishable_and_intelligible, Attested)]).
declaration_basis(false, _, []).
declaration_basis(absent, _, []).

declaration_cites(true, [cite(eu_reg_2016_679_art_7_2)]).
declaration_cites(false, []).
declaration_cites(absent, []).

% ---- consent_declaration_effect/3 -------------------------------------
consent_declaration_effect(Profile, Status, Citations) :-
    gdpr_consent_conditions_input_problems(Profile, Problems),
    effect_for_problems(Problems, Profile, Status, Citations).

effect_for_problems([Problem|Problems], _, input_problems([Problem|Problems]), []).
effect_for_problems([], Profile, Status, Citations) :-
    crisp_state(Profile, consent_in_declaration_with_other_matters, Declaration),
    effect_for_declaration(Declaration, Profile, Status, Citations).

effect_for_declaration(absent, _, indeterminate([consent_in_declaration_with_other_matters]), []).
effect_for_declaration(false, _, not_applicable, []).
effect_for_declaration(true, Profile, Status, Citations) :-
    crisp_state(Profile, declaration_part_infringes_regulation, Infringes),
    effect_for_infringement(Infringes, Status, Citations).

effect_for_infringement(absent, indeterminate([declaration_part_infringes_regulation]), []).
effect_for_infringement(true, part_not_binding, [cite(eu_reg_2016_679_art_7_2)]) :-
    implements(eu_reg_2016_679_art_7_2).
effect_for_infringement(false, no_part_infringing, [cite(eu_reg_2016_679_art_7_2)]) :-
    implements(eu_reg_2016_679_art_7_2).

% ---- consent_assessment_factors/2 -------------------------------------
consent_assessment_factors(Profile, Factors) :-
    gdpr_consent_conditions_input_problems(Profile, Problems),
    factors_for_problems(Problems, Profile, Factors).

factors_for_problems([Problem|Problems], _, input_problems([Problem|Problems])).
factors_for_problems([], Profile, Factors) :-
    crisp_state(Profile, contract_conditional_on_unneeded_consent, Conditional),
    factors_for_contract(Conditional, Factors).

factors_for_contract(absent, indeterminate([contract_conditional_on_unneeded_consent])).
factors_for_contract(true, [factor(contract_conditional_on_unneeded_consent, cite(eu_reg_2016_679_art_7_4))]) :-
    implements(eu_reg_2016_679_art_7_4).
factors_for_contract(false, []).

% ---- identification_obligation/4 (Art 11(1)) --------------------------
identification_obligation(Profile, Status, Basis, Citations) :-
    gdpr_consent_conditions_input_problems(Profile, Problems),
    obligation_for_problems(Problems, Profile, Status, Basis, Citations).

obligation_for_problems([Problem|Problems], _, input_problems([Problem|Problems]), [], []).
obligation_for_problems([], Profile, Status, Basis, Citations) :-
    outside_state(Profile, purposes_do_not_require_identification, Purposes),
    obligation_for_purposes(Purposes, Status, Basis, Citations).

obligation_for_purposes(absent, Status, [], []) :-
    referral(purposes_do_not_require_identification, Status).
obligation_for_purposes(stated(true, Attested), not_obliged_to_acquire_identifying_information, [outside_fact(purposes_do_not_require_identification, Attested)], [cite(eu_reg_2016_679_art_11_1)]) :-
    implements(eu_reg_2016_679_art_11_1).
obligation_for_purposes(stated(false, Attested), art11_1_not_engaged, [outside_fact(purposes_do_not_require_identification, Attested)], [cite(eu_reg_2016_679_art_11_1)]) :-
    implements(eu_reg_2016_679_art_11_1).

% ---- the engagement of Art 11(2): both outside facts attested true -----
engagement(Purposes, Unable, Outcome) :-
    state_is_false(Purposes, PurposesFalse),
    state_is_false(Unable, UnableFalse),
    either_true(PurposesFalse, UnableFalse, AnyFalse),
    engagement_for_flags(AnyFalse, Purposes, Unable, PurposesFalse, UnableFalse, Outcome).

engagement_for_flags(true, Purposes, Unable, PurposesFalse, UnableFalse, not_engaged(Basis)) :-
    implements(eu_reg_2016_679_art_11_2),
    basis_if(PurposesFalse, purposes_do_not_require_identification, Purposes, PurposesBasis),
    basis_if(UnableFalse, able_to_demonstrate_not_in_position_to_identify, Unable, UnableBasis),
    append(PurposesBasis, UnableBasis, Basis).
engagement_for_flags(false, Purposes, Unable, _, _, Outcome) :-
    absent_keys_of(Purposes, purposes_do_not_require_identification, PurposesAbsent),
    absent_keys_of(Unable, able_to_demonstrate_not_in_position_to_identify, UnableAbsent),
    append(PurposesAbsent, UnableAbsent, Absent),
    engagement_for_absent(Absent, Outcome).

engagement_for_absent([Key|_], absent_key(Key)).
engagement_for_absent([], engaged).

% ---- identification_information_duty/4 (Art 11(2) informing duty) ------
identification_information_duty(Profile, Status, Basis, Citations) :-
    gdpr_consent_conditions_input_problems(Profile, Problems),
    duty_for_problems(Problems, Profile, Status, Basis, Citations).

duty_for_problems([Problem|Problems], _, input_problems([Problem|Problems]), [], []).
duty_for_problems([], Profile, Status, Basis, Citations) :-
    outside_state(Profile, purposes_do_not_require_identification, Purposes),
    outside_state(Profile, able_to_demonstrate_not_in_position_to_identify, Unable),
    outside_state(Profile, informing_data_subject_possible, Possible),
    engagement(Purposes, Unable, Engagement),
    duty_for_engagement(Engagement, Purposes, Unable, Possible, Status, Basis, Citations).

duty_for_engagement(not_engaged(Basis), _, _, _, art11_2_not_engaged, Basis, [cite(eu_reg_2016_679_art_11_2)]).
duty_for_engagement(absent_key(Key), _, _, _, Status, [], []) :-
    referral(Key, Status).
duty_for_engagement(engaged, Purposes, Unable, Possible, Status, Basis, Citations) :-
    duty_for_possible(Possible, Purposes, Unable, Status, Basis, Citations).

duty_for_possible(absent, _, _, Status, [], []) :-
    referral(informing_data_subject_possible, Status).
duty_for_possible(stated(Value, PossibleAttested), stated(_, PurposesAttested), stated(_, UnableAttested), Status, [outside_fact(purposes_do_not_require_identification, PurposesAttested), outside_fact(able_to_demonstrate_not_in_position_to_identify, UnableAttested), outside_fact(informing_data_subject_possible, PossibleAttested)], [cite(eu_reg_2016_679_art_11_2)]) :-
    implements(eu_reg_2016_679_art_11_2),
    duty_status(Value, Status).

duty_status(true, must_inform_data_subject).
duty_status(false, need_not_inform_data_subject).

% ---- identification_rights_effect/4 (Art 11(2) Arts 15 to 20) ---------
identification_rights_effect(Profile, Status, Basis, Citations) :-
    gdpr_consent_conditions_input_problems(Profile, Problems),
    rights_for_problems(Problems, Profile, Status, Basis, Citations).

rights_for_problems([Problem|Problems], _, input_problems([Problem|Problems]), [], []).
rights_for_problems([], Profile, Status, Basis, Citations) :-
    outside_state(Profile, purposes_do_not_require_identification, Purposes),
    outside_state(Profile, able_to_demonstrate_not_in_position_to_identify, Unable),
    crisp_state(Profile, additional_identifying_information_provided, Provided),
    engagement(Purposes, Unable, Engagement),
    rights_for_engagement(Engagement, Purposes, Unable, Provided, Status, Basis, Citations).

rights_for_engagement(not_engaged(Basis), _, _, _, art11_2_not_engaged, Basis, [cite(eu_reg_2016_679_art_11_2)]).
rights_for_engagement(absent_key(Key), _, _, _, Status, [], []) :-
    referral(Key, Status).
rights_for_engagement(engaged, Purposes, Unable, Provided, Status, Basis, Citations) :-
    rights_for_provided(Provided, Purposes, Unable, Status, Basis, Citations).

rights_for_provided(absent, _, _, indeterminate([additional_identifying_information_provided]), [], []).
rights_for_provided(true, stated(_, PurposesAttested), stated(_, UnableAttested), articles_15_to_20_apply, [outside_fact(purposes_do_not_require_identification, PurposesAttested), outside_fact(able_to_demonstrate_not_in_position_to_identify, UnableAttested)], [cite(eu_reg_2016_679_art_11_2)]) :-
    implements(eu_reg_2016_679_art_11_2).
rights_for_provided(false, stated(_, PurposesAttested), stated(_, UnableAttested), articles_15_to_20_do_not_apply, [outside_fact(purposes_do_not_require_identification, PurposesAttested), outside_fact(able_to_demonstrate_not_in_position_to_identify, UnableAttested)], [cite(eu_reg_2016_679_art_11_2)]) :-
    implements(eu_reg_2016_679_art_11_2).

% ---- facade: verdict, status projection, checklist ---------------------
decide_gdpr_consent_conditions(Profile, gdpr_consent_conditions_verdict(Status, Citations)) :-
    consent_conditions_status(Profile, Status, _Basis, Citations).

gdpr_consent_conditions_status(Profile, Status) :-
    consent_conditions_status(Profile, Status, _Basis, _Citations).

gdpr_consent_conditions_decision_resolvable(Profile) :-
    consent_conditions_status(Profile, _Status, _Basis, _Citations).

gdpr_consent_conditions_checklist(Profile, Items) :-
    gdpr_consent_conditions_input_problems(Profile, Problems),
    checklist_for_problems(Problems, Profile, Items).

checklist_for_problems([_|_], _, [item(input_check, unmet, cite(eu_reg_2016_679_art_7_1))]).
checklist_for_problems([], Profile, [
    item(scope_processing_based_on_consent, ScopeStatus, cite(eu_reg_2016_679_art_7_1)),
    item(art_7_1_consent_demonstrable, DemonstrableStatus, cite(eu_reg_2016_679_art_7_1)),
    item(art_7_2_request_presentation, PresentationStatus, cite(eu_reg_2016_679_art_7_2)),
    item(art_7_3_withdrawal_information, InformedStatus, cite(eu_reg_2016_679_art_7_3)),
    item(art_7_3_withdrawal_ease, EasyStatus, cite(eu_reg_2016_679_art_7_3)),
    item(art_7_4_consent_freely_given, FreelyStatus, cite(eu_reg_2016_679_art_7_4))
]) :-
    crisp_state(Profile, processing_based_on_consent, Scope),
    crisp_state(Profile, consent_in_declaration_with_other_matters, Declaration),
    crisp_state(Profile, informed_of_withdrawal_right_before_consent, Informed),
    outside_state(Profile, consent_demonstrable, Demonstrable),
    outside_state(Profile, request_clearly_distinguishable_and_intelligible, Distinguishable),
    outside_state(Profile, withdrawal_as_easy_as_giving_consent, Easy),
    outside_state(Profile, consent_freely_given, Freely),
    crisp_item_status(Scope, processing_based_on_consent, ScopeStatus),
    outside_item_status(Demonstrable, DemonstrableStatus),
    presentation_item_status(Declaration, Distinguishable, PresentationStatus),
    crisp_item_status(Informed, informed_of_withdrawal_right_before_consent, InformedStatus),
    outside_item_status(Easy, EasyStatus),
    outside_item_status(Freely, FreelyStatus).

crisp_item_status(true, _, met).
crisp_item_status(false, _, unmet).
crisp_item_status(absent, Key, unknown([Key])).

outside_item_status(stated(true, _), met).
outside_item_status(stated(false, _), unmet).
outside_item_status(absent, referred).

presentation_item_status(true, Distinguishable, Status) :-
    outside_item_status(Distinguishable, Status).
presentation_item_status(false, _, not_applicable).
presentation_item_status(absent, _, unknown([consent_in_declaration_with_other_matters])).

:- end_module(gdpr_consent_conditions).
