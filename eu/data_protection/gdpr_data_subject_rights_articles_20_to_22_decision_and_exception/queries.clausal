% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% queries.clausal -- QUERY-COMBINATOR layer for eu/data_protection/gdpr_data_subject_rights_articles_20_to_22_decision_and_exception.
% A TOP-LAYER consumer: it imports the determination slice's PUBLIC
% predicates it calls, and nothing else.
%
% Query types served (the slice owns the logic; this file is the surface):
%   #13 compliance_check  request_decision/2 (must the controller comply
%                         with this request?), re-exported from the slice;
%   #7  justification     request_exception_checklist/2 (the slice; every
%                         item carries cite(...));
%   #16 what-if           gdpr_data_subject_rights_articles_20_to_22_decision_and_exception_what_if/4:
%                         override one key, re-decide COMPLY.
%
% gdpr_data_subject_rights_articles_20_to_22_decision_and_exception_profile_keys/1: the fifty-four contract keys
% gdpr_data_subject_rights_articles_20_to_22_decision_and_exception_input_problems/2: THE INPUT CHECK ([] = none),
%   re-exported from the kernel as the scaffold wrote it.
% request_exception/2: the EXCEPTION field, re-exported from the slice.
%
% RESULT CONSTRUCTORS (exported, never called as queries): indeterminate/1,
% needs_legal_review/2, open_textured/2, inputs_relied_on/1, provenance/2,
% suspended/1, input_problems/1, unknown_key/1, wrong_type/1,
% duplicate_key/1, attested/2, attestation/4, url/2, document/2. A few
% keep a shape recogniser for the term of the same name; the others are
% pure data (declared with constructors/1, no clauses). None decides a
% statutory condition, so none carries an implements/1 marker.
%
% ROOT ATOMS: the profile key atoms (contract order), the judgement value
% unsure and the outside-fact marker absent are NOT in this export list
% (an export list holds name/arity entries only); they are listed under
% root_atoms: in manifest.yaml, and the generated package facade makes
% them reachable on the package root (root_export/1).
% =====================================================================

:- module(queries, [
    gdpr_data_subject_rights_articles_20_to_22_decision_and_exception_profile_keys/1,
    gdpr_data_subject_rights_articles_20_to_22_decision_and_exception_input_problems/2,
    gdpr_data_subject_rights_articles_20_to_22_decision_and_exception_what_if/4,
    request_decision/2,
    request_exception/2,
    indeterminate/1,
    needs_legal_review/2,
    open_textured/2,
    inputs_relied_on/1,
    provenance/2,
    suspended/1,
    input_problems/1,
    unknown_key/1,
    wrong_type/1,
    duplicate_key/1,
    attested/2,
    attestation/4,
    url/2,
    document/2
]).

:- use_module(eu/data_protection/gdpr_data_subject_rights_articles_20_to_22_decision_and_exception/kernel, [gdpr_data_subject_rights_articles_20_to_22_decision_and_exception_input_problems/2, contract_keys/1]).
:- use_module(eu/data_protection/gdpr_data_subject_rights_articles_20_to_22_decision_and_exception/request_exception, [request_decision/2, request_exception/2]).

:- constructors([provenance(clause, citations), unknown_key(key), wrong_type(key), duplicate_key(key), attestation(by, at, reason, evidence), url(url, retrieved_at), document(upload_id, sha256)]).

% The schema of top-level profile keys: the contract keys, in contract order.
gdpr_data_subject_rights_articles_20_to_22_decision_and_exception_profile_keys(Keys) :-
    contract_keys(Keys).

% #16 what-if: re-decide COMPLY with one key hypothetically set. Every
% earlier occurrence of the key is replaced by the one new attribute, so the
% hypothesis never gains a duplicate key; the hypothesis passes through the
% input check like any profile. (The profile is an attribute list, not a
% dict, so the kit's dict-based override_key/4 does not apply here.)
gdpr_data_subject_rights_articles_20_to_22_decision_and_exception_what_if(Profile, OverriddenKey, NewValue, NewComply) :-
    override_attribute(Profile, OverriddenKey, NewValue, Hypothesis),
    request_decision(Hypothesis, NewComply).

override_attribute(Profile, OverriddenKey, NewValue, Hypothesis) :-
    exclude(attribute_with_key(OverriddenKey), Profile, Remaining),
    append(Remaining, [attribute(OverriddenKey, NewValue)], Hypothesis).

attribute_with_key(Key, attribute(ElementKey, _)) :-
    ElementKey == Key.

% ---- result constructors (shape recognisers) ---------------------------
indeterminate([_|_]).

needs_legal_review(open_textured(_, _), [_|_]).

open_textured(_, cite(_)).

inputs_relied_on([]).
inputs_relied_on([_|_]).

suspended(art12_6_identity_not_confirmed).

input_problems([_|_]).

attested(_, attestation(_, _, _, _)).

:- end_module(queries).
