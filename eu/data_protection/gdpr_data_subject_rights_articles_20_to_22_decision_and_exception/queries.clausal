% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% queries.clausal -- QUERY layer for the GDPR Arts 20 to 22 decision and exception package.
% Top-layer consumer: it imports only the public predicates of the slices.
%
% request_decision/2   (#13 compliance_check): must the controller comply with the request?
% request_exception/2  : the exception that relieves the controller, or none
% what_if/4            (#16): override one key and re-decide
% The justification query (#7), the checklist with cite(...) per item, is
% request_exception_checklist/2 of the slice, re-exported by the facade.
% The result constructors are data: attestation/4, url/2 and document/2 have no clauses.
% =====================================================================

:- module(queries, [
    request_decision/2,
    request_exception/2,
    gdpr_data_subject_rights_articles_20_to_22_decision_and_exception_profile_keys/1,
    gdpr_data_subject_rights_articles_20_to_22_decision_and_exception_input_problems/2,
    gdpr_data_subject_rights_articles_20_to_22_decision_and_exception_what_if/4,
    indeterminate/1,
    needs_legal_review/2,
    open_textured/2,
    inputs_relied_on/1,
    provenance/2,
    suspended/1,
    input_problems/1,
    unknown_key/1,
    wrong_type/1,
    duplicate_key/1,
    attested/2,
    attestation/4,
    url/2,
    document/2
]).

:- constructors([attestation(by, at, reason, evidence), url(url, retrieved_at), document(upload_id, sha256)]).

:- use_module(eu/data_protection/gdpr_data_subject_rights_articles_20_to_22_decision_and_exception/kernel, [gdpr_data_subject_rights_articles_20_to_22_decision_and_exception_input_problems/2]).
:- use_module(eu/data_protection/gdpr_data_subject_rights_articles_20_to_22_decision_and_exception/request_exception, [request_exception_full_verdict/2]).

% The COMPLY field of the verdict: exactly one answer for every profile.
request_decision(Profile, Comply) :-
    request_exception_full_verdict(Profile, gdpr_data_subject_request_verdict(Comply, _Basis, _Exception, _Conditions, _Citations)).

% The EXCEPTION field of the verdict: none for every non-final COMPLY.
request_exception(Profile, Exception) :-
    request_exception_full_verdict(Profile, gdpr_data_subject_request_verdict(_Comply, _Basis, Exception, _Conditions, _Citations)).

% schema of top-level profile keys, in the order of the typed input contract
gdpr_data_subject_rights_articles_20_to_22_decision_and_exception_profile_keys([request_type, objection_ground_claimed, request_received_on, extension_claimed, controller_demonstrates_unable_to_identify_data_subject, identity_confirmed, personal_data_inaccurate, consent_is_the_basis_of_processing, consent_withdrawn, other_legal_ground_for_processing_exists, objection_under_art21_1_made, objection_under_art21_2_made, collected_in_relation_to_information_society_services_offer, accuracy_contested_by_data_subject, data_subject_opposes_erasure, data_required_by_data_subject_for_legal_claims, verification_of_overriding_grounds_pending, personal_data_provided_by_data_subject, processing_based_on_consent_or_contract, processing_carried_out_by_automated_means, processing_based_on_art6_1_e_or_f, processing_for_direct_marketing, processing_for_research_or_statistics_pursuant_to_art89_1, data_subject_gave_explicit_consent, decision_based_on_special_categories, special_category_condition_and_safeguards_met_for_decision, personal_data_disclosed_to_recipients, data_subject_asks_who_the_recipients_are, extension_necessary_for_complexity_and_number, reasonable_doubts_about_identity, request_manifestly_unfounded_or_excessive, personal_data_incomplete_in_light_of_purposes, data_no_longer_necessary_for_purposes, overriding_legitimate_grounds_exist, personal_data_unlawfully_processed, processing_necessary_for_freedom_of_expression_and_information, processing_necessary_for_public_task_or_official_authority, processing_necessary_for_public_health_in_accordance_with_art9_2_h_and_i, processing_for_archiving_research_or_statistics_in_accordance_with_art89_1, erasure_would_render_impossible_or_seriously_impair_processing_objectives, processing_necessary_for_legal_claims, controller_no_longer_needs_data_for_processing_purposes, transmission_would_adversely_affect_rights_and_freedoms_of_others, objection_grounds_relate_to_particular_situation, controller_demonstrates_compelling_legitimate_grounds, decision_based_solely_on_automated_processing, decision_produces_legal_or_similarly_significant_effects, decision_necessary_for_contract_with_data_subject, recipient_notification_impossible_or_disproportionate_effort, legislative_restriction_applies_to_the_right, erasure_required_by_union_or_member_state_law, processing_required_by_union_or_member_state_law, decision_authorised_by_union_or_member_state_law, public_holidays]).

% what-if: re-decide with one attribute hypothetically replaced
gdpr_data_subject_rights_articles_20_to_22_decision_and_exception_what_if(Profile, OverriddenKey, NewValue, NewComply) :-
    replace_attribute(Profile, OverriddenKey, NewValue, Hypothesis),
    request_decision(Hypothesis, NewComply).

replace_attribute(Profile, Key, Value, [attribute(Key, Value)|Rest]) :-
    drop_attribute(Profile, Key, Rest).

drop_attribute([], _, []).
drop_attribute([attribute(ElementKey, _ElementValue)|Elements], Key, Rest) :-
    ElementKey == Key,
    drop_attribute(Elements, Key, Rest).
drop_attribute([attribute(ElementKey, ElementValue)|Elements], Key, [attribute(ElementKey, ElementValue)|Rest]) :-
    ElementKey \== Key,
    drop_attribute(Elements, Key, Rest).

% ---- result constructors (exported, never called as queries) ----------
indeterminate(MissingKeys) :-
    is_list(MissingKeys).

needs_legal_review(_Reason, Context) :-
    is_list(Context).

open_textured(InputKey, cite(CitationKey)) :-
    atom(InputKey),
    atom(CitationKey).

inputs_relied_on(Pairs) :-
    is_list(Pairs).

provenance(_Clause, Citations) :-
    is_list(Citations).

suspended(art12_6_identity_not_confirmed).

input_problems(Problems) :-
    is_list(Problems).

unknown_key(Key) :-
    atom(Key).

wrong_type(Key) :-
    atom(Key).

duplicate_key(Key) :-
    atom(Key).

attested(Value, attestation(_By, _At, _Reason, _Evidence)) :-
    nonvar(Value).

:- end_module(queries).
