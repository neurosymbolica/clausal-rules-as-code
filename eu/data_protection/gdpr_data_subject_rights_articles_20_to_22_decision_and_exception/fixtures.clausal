% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% fixtures.clausal -- representative profiles for the GDPR Arts 20 to 22 package.
% Every route has a positive case and a one-unit near-miss control.
% A profile is an attribute list [attribute(Key, Value), ...].
% =====================================================================

:- module(fixtures, [
    gdpr_data_subject_rights_articles_20_to_22_decision_and_exception_subject/1,
    gdpr_data_subject_rights_articles_20_to_22_decision_and_exception_profile_for/2,
    gdpr_data_subject_rights_articles_20_to_22_decision_and_exception_assess/2
]).

:- use_module(eu/data_protection/gdpr_data_subject_rights_articles_20_to_22_decision_and_exception/request_exception, [decide_request_exception/2]).

% ---- Subject registry ------------------------------------------------
gdpr_data_subject_rights_articles_20_to_22_decision_and_exception_subject(Subject) :-
    spec(Subject, _Base, _Extra).

% ---- Profiles --------------------------------------------------------
gdpr_data_subject_rights_articles_20_to_22_decision_and_exception_profile_for(Subject, Profile) :-
    spec(Subject, Base, Extra),
    base_attributes(Base, BaseAttributes),
    append(BaseAttributes, Extra, Profile).

% ---- Convenience wrapper ---------------------------------------------
gdpr_data_subject_rights_articles_20_to_22_decision_and_exception_assess(Subject, Result) :-
    gdpr_data_subject_rights_articles_20_to_22_decision_and_exception_profile_for(Subject, Profile),
    decide_request_exception(Profile, Result).

base_attributes(portability, [attribute(request_type, portability), attribute(personal_data_provided_by_data_subject, true), attribute(processing_based_on_consent_or_contract, true)]).
base_attributes(objection_art21_1, [attribute(request_type, objection), attribute(objection_ground_claimed, art21_1), attribute(processing_based_on_art6_1_e_or_f, true)]).
base_attributes(objection_art21_2, [attribute(request_type, objection), attribute(objection_ground_claimed, art21_2)]).
base_attributes(objection_art21_6, [attribute(request_type, objection), attribute(objection_ground_claimed, art21_6)]).
base_attributes(automated_decision, [attribute(request_type, automated_decision)]).
base_attributes(objection_no_ground, [attribute(request_type, objection)]).
base_attributes(empty, []).

% ---- portability (Art 20) ----------------------------------------------
spec(portability_engaged, portability, [attribute(processing_carried_out_by_automated_means, true)]).
spec(portability_not_automated, portability, [attribute(processing_carried_out_by_automated_means, false)]).
spec(portability_public_task, portability, [attribute(processing_carried_out_by_automated_means, true), attribute(processing_necessary_for_public_task_or_official_authority, true)]).
spec(portability_public_task_denied, portability, [attribute(processing_carried_out_by_automated_means, true), attribute(processing_necessary_for_public_task_or_official_authority, false)]).
spec(portability_rights_of_others, portability, [attribute(processing_carried_out_by_automated_means, true), attribute(transmission_would_adversely_affect_rights_and_freedoms_of_others, true)]).
spec(portability_rights_of_others_denied, portability, [attribute(processing_carried_out_by_automated_means, true), attribute(transmission_would_adversely_affect_rights_and_freedoms_of_others, false)]).
spec(portability_manifestly_excessive, portability, [attribute(processing_carried_out_by_automated_means, true), attribute(request_manifestly_unfounded_or_excessive, true)]).
spec(portability_manifestly_excessive_denied, portability, [attribute(processing_carried_out_by_automated_means, true), attribute(request_manifestly_unfounded_or_excessive, false)]).
spec(portability_unable_to_identify, portability, [attribute(processing_carried_out_by_automated_means, true), attribute(controller_demonstrates_unable_to_identify_data_subject, true)]).
spec(portability_unable_to_identify_denied, portability, [attribute(processing_carried_out_by_automated_means, true), attribute(controller_demonstrates_unable_to_identify_data_subject, false)]).
spec(portability_restricted_by_law, portability, [attribute(processing_carried_out_by_automated_means, true), attribute(legislative_restriction_applies_to_the_right, attested(true, attestation(host, checked, statute_reviewed, none)))]).
spec(portability_restriction_denied, portability, [attribute(processing_carried_out_by_automated_means, true), attribute(legislative_restriction_applies_to_the_right, attested(false, attestation(host, checked, statute_reviewed, none)))]).
spec(portability_identity_unconfirmed, portability, [attribute(processing_carried_out_by_automated_means, true), attribute(reasonable_doubts_about_identity, true), attribute(identity_confirmed, false)]).
spec(portability_identity_confirmed, portability, [attribute(processing_carried_out_by_automated_means, true), attribute(reasonable_doubts_about_identity, true), attribute(identity_confirmed, true)]).
spec(portability_open_unsure_rights_of_others, portability, [attribute(processing_carried_out_by_automated_means, true), attribute(transmission_would_adversely_affect_rights_and_freedoms_of_others, unsure)]).

% ---- objection (Art 21) ------------------------------------------------
spec(objection_art21_1_engaged, objection_art21_1, [attribute(objection_grounds_relate_to_particular_situation, true)]).
spec(objection_art21_1_not_particular, objection_art21_1, [attribute(objection_grounds_relate_to_particular_situation, false)]).
spec(objection_art21_1_compelling, objection_art21_1, [attribute(objection_grounds_relate_to_particular_situation, true), attribute(controller_demonstrates_compelling_legitimate_grounds, true)]).
spec(objection_art21_1_compelling_denied, objection_art21_1, [attribute(objection_grounds_relate_to_particular_situation, true), attribute(controller_demonstrates_compelling_legitimate_grounds, false)]).
spec(objection_art21_1_legal_claims, objection_art21_1, [attribute(objection_grounds_relate_to_particular_situation, true), attribute(processing_necessary_for_legal_claims, true)]).
spec(objection_art21_1_unsure_particular, objection_art21_1, [attribute(objection_grounds_relate_to_particular_situation, unsure)]).
spec(objection_art21_2_engaged, objection_art21_2, [attribute(processing_for_direct_marketing, true)]).
spec(objection_art21_2_not_marketing, objection_art21_2, [attribute(processing_for_direct_marketing, false)]).
spec(objection_art21_2_no_balancing, objection_art21_2, [attribute(processing_for_direct_marketing, true), attribute(controller_demonstrates_compelling_legitimate_grounds, true), attribute(processing_necessary_for_public_task_or_official_authority, true)]).
spec(objection_art21_6_engaged, objection_art21_6, [attribute(processing_for_research_or_statistics_pursuant_to_art89_1, true), attribute(objection_grounds_relate_to_particular_situation, true)]).
spec(objection_art21_6_public_interest, objection_art21_6, [attribute(processing_for_research_or_statistics_pursuant_to_art89_1, true), attribute(objection_grounds_relate_to_particular_situation, true), attribute(processing_necessary_for_public_task_or_official_authority, true)]).
spec(objection_art21_6_public_interest_denied, objection_art21_6, [attribute(processing_for_research_or_statistics_pursuant_to_art89_1, true), attribute(objection_grounds_relate_to_particular_situation, true), attribute(processing_necessary_for_public_task_or_official_authority, false)]).
spec(objection_art21_6_not_research, objection_art21_6, [attribute(processing_for_research_or_statistics_pursuant_to_art89_1, false), attribute(objection_grounds_relate_to_particular_situation, true)]).

% ---- automated decision (Art 22) ---------------------------------------
spec(automated_engaged, automated_decision, [attribute(decision_based_solely_on_automated_processing, true), attribute(decision_produces_legal_or_similarly_significant_effects, true)]).
spec(automated_not_solely, automated_decision, [attribute(decision_based_solely_on_automated_processing, false), attribute(decision_produces_legal_or_similarly_significant_effects, true)]).
spec(automated_contract, automated_decision, [attribute(decision_based_solely_on_automated_processing, true), attribute(decision_produces_legal_or_similarly_significant_effects, true), attribute(decision_necessary_for_contract_with_data_subject, true)]).
spec(automated_contract_denied, automated_decision, [attribute(decision_based_solely_on_automated_processing, true), attribute(decision_produces_legal_or_similarly_significant_effects, true), attribute(decision_necessary_for_contract_with_data_subject, false)]).
spec(automated_consent, automated_decision, [attribute(decision_based_solely_on_automated_processing, true), attribute(decision_produces_legal_or_similarly_significant_effects, true), attribute(data_subject_gave_explicit_consent, true)]).
spec(automated_consent_special_bar, automated_decision, [attribute(decision_based_solely_on_automated_processing, true), attribute(decision_produces_legal_or_similarly_significant_effects, true), attribute(data_subject_gave_explicit_consent, true), attribute(decision_based_on_special_categories, true), attribute(special_category_condition_and_safeguards_met_for_decision, false)]).
spec(automated_consent_special_safeguarded, automated_decision, [attribute(decision_based_solely_on_automated_processing, true), attribute(decision_produces_legal_or_similarly_significant_effects, true), attribute(data_subject_gave_explicit_consent, true), attribute(decision_based_on_special_categories, true), attribute(special_category_condition_and_safeguards_met_for_decision, true)]).
spec(automated_law_authorised, automated_decision, [attribute(decision_based_solely_on_automated_processing, true), attribute(decision_produces_legal_or_similarly_significant_effects, true), attribute(decision_authorised_by_union_or_member_state_law, attested(true, attestation(host, checked, statute_reviewed, none)))]).
spec(automated_law_not_authorised, automated_decision, [attribute(decision_based_solely_on_automated_processing, true), attribute(decision_produces_legal_or_similarly_significant_effects, true), attribute(decision_authorised_by_union_or_member_state_law, attested(false, attestation(host, checked, statute_reviewed, none)))]).

% ---- absent keys and input problems ------------------------------------
spec(missing_keys_automated, automated_decision, []).
spec(objection_missing_ground, objection_no_ground, []).
spec(no_request_type, empty, []).
spec(unknown_key_problem, empty, [attribute(not_a_contract_key, true)]).
spec(wrong_type_problem, portability, [attribute(processing_carried_out_by_automated_means, true), attribute(extension_claimed, unsure)]).
spec(duplicate_key_problem, portability, [attribute(processing_carried_out_by_automated_means, true), attribute(processing_carried_out_by_automated_means, false)]).

:- end_module(fixtures).
