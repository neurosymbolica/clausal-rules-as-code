gdpr_common_definitions_data_and_processing_subject(set_up_by_agreement).
gdpr_common_definitions_data_and_processing_subject(unattested_organisation).
gdpr_common_definitions_data_and_processing_subject(malformed_profile).

% ---- Profiles --------------------------------------------------------
gdpr_common_definitions_data_and_processing_profile_for(person_identified, [attribute(information_relates_to_natural_person, true), attribute(natural_person_identified, true), attribute(operation_performed_on_the_data, true), attribute(stored_data_marked_to_limit_future_processing, true), attribute(structured_set_accessible_by_specific_criteria, true)]).
gdpr_common_definitions_data_and_processing_profile_for(not_about_a_person, [attribute(information_relates_to_natural_person, false), attribute(natural_person_identified, true)]).
gdpr_common_definitions_data_and_processing_profile_for(identifiability_unsure, [attribute(information_relates_to_natural_person, true), attribute(natural_person_identified, false), attribute(natural_person_identifiable, unsure)]).
gdpr_common_definitions_data_and_processing_profile_for(operation_missing, [attribute(information_relates_to_natural_person, true), attribute(natural_person_identified, true)]).
gdpr_common_definitions_data_and_processing_profile_for(automated_evaluation, [attribute(information_relates_to_natural_person, true), attribute(natural_person_identified, true), attribute(operation_performed_on_the_data, true), attribute(processing_automated, true), attribute(evaluates_personal_aspects_of_natural_person, true)]).
gdpr_common_definitions_data_and_processing_profile_for(manual_evaluation, [attribute(information_relates_to_natural_person, true), attribute(natural_person_identified, true), attribute(operation_performed_on_the_data, true), attribute(processing_automated, false), attribute(evaluates_personal_aspects_of_natural_person, true)]).
gdpr_common_definitions_data_and_processing_profile_for(pseudonymised_data, [attribute(information_relates_to_natural_person, true), attribute(natural_person_identified, true), attribute(operation_performed_on_the_data, true), attribute(attribution_needs_additional_information, true), attribute(additional_information_kept_separately, true), attribute(measures_prevent_attribution, true)]).
gdpr_common_definitions_data_and_processing_profile_for(attribution_without_measures, [attribute(information_relates_to_natural_person, true), attribute(natural_person_identified, true), attribute(operation_performed_on_the_data, true), attribute(attribution_needs_additional_information, true), attribute(additional_information_kept_separately, true), attribute(measures_prevent_attribution, false)]).
gdpr_common_definitions_data_and_processing_profile_for(full_consent, [attribute(indication_freely_given, true), attribute(indication_specific, true), attribute(indication_informed, true), attribute(indication_unambiguous, true), attribute(agreement_by_statement_or_clear_affirmative_action, true)]).
gdpr_common_definitions_data_and_processing_profile_for(consent_without_specificity, [attribute(indication_freely_given, true), attribute(indication_specific, false), attribute(indication_informed, true), attribute(indication_unambiguous, false), attribute(agreement_by_statement_or_clear_affirmative_action, true)]).
gdpr_common_definitions_data_and_processing_profile_for(disclosed_to_other_body, [attribute(information_relates_to_natural_person, true), attribute(natural_person_identified, true), attribute(data_disclosed_to_receiving_body, true), attribute(receiving_body_public_authority_in_particular_inquiry, false), attribute(receiving_body_is_data_subject, false), attribute(receiving_body_is_controller_or_processor, false), attribute(receiving_body_authorised_under_direct_authority, false)]).
gdpr_common_definitions_data_and_processing_profile_for(inquiry_authority, [attribute(information_relates_to_natural_person, true), attribute(natural_person_identified, true), attribute(data_disclosed_to_receiving_body, true), attribute(receiving_body_public_authority_in_particular_inquiry, true)]).
gdpr_common_definitions_data_and_processing_profile_for(own_processor, [attribute(receiving_body_is_data_subject, false), attribute(receiving_body_is_controller_or_processor, true), attribute(receiving_body_authorised_under_direct_authority, false)]).
gdpr_common_definitions_data_and_processing_profile_for(breach_of_personal_data, [attribute(information_relates_to_natural_person, true), attribute(natural_person_identified, true), attribute(operation_performed_on_the_data, true), attribute(breach_of_security, true), attribute(breach_led_to_listed_outcome, true)]).
gdpr_common_definitions_data_and_processing_profile_for(attested_service, [attribute(service_is_information_society_service, attested(true, attestation(fixture_host, fixture_clock, fixture_reason, none)))]).
gdpr_common_definitions_data_and_processing_profile_for(ordinary_service, [attribute(service_is_information_society_service, attested(false, attestation(fixture_host, fixture_clock, fixture_reason, none)))]).
gdpr_common_definitions_data_and_processing_profile_for(unattested_service, []).
gdpr_common_definitions_data_and_processing_profile_for(public_international_organisation, [attribute(organisation_governed_by_public_international_law, attested(true, attestation(fixture_host, fixture_clock, fixture_reason, none))), attribute(body_set_up_by_agreement_between_countries, false)]).
gdpr_common_definitions_data_and_processing_profile_for(set_up_by_agreement, [attribute(body_set_up_by_agreement_between_countries, true)]).
gdpr_common_definitions_data_and_processing_profile_for(unattested_organisation, [attribute(body_set_up_by_agreement_between_countries, false)]).
gdpr_common_definitions_data_and_processing_profile_for(malformed_profile, [attribute(natural_person_identified, unsure)]).

% ---- Convenience wrapper ---------------------------------------------
gdpr_common_definitions_data_and_processing_assess(Subject, Result) :-
    gdpr_common_definitions_data_and_processing_profile_for(Subject, Profile),
    decide_gdpr_common_definitions_data_and_processing(Profile, Result).

:- end_module(fixtures).
