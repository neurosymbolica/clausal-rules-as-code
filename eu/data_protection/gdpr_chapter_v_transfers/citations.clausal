% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/data_protection/gdpr_chapter_v_transfers.
%
% Instrument: Regulation (EU) 2016/679 of the European Parliament and of the
% Council (General Data Protection Regulation), Chapter V, pinned consolidated
% text CELEX 02016R0679-20160504 (in force from 2016-05-04).
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% ref is the pinned unit of the consolidated text. Each verbatim is an exact
% run of the pinned wording (point letters and paragraph numbers left out).
%
% Keys follow the corpus lexicon's canonical scheme (eu_reg_2016_679_art_...).
% Only the keys of the order's CITATION VOCABULARY are ever returned in a
% result; the others mark clauses (implements/1) and fact rows only.
% lint: allow-abbreviation spec-mandated atom (eu_reg_2016_679_art_49_1_second_subpara)
%
% PROVENANCE: implements(Key) succeeds for every recorded key and fails for
% any other, so a misspelt marker makes its clause fail rather than lie.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

implements(Key) :-
    citation(Key, _).

citation(eu_reg_2016_679_art_44, [label-'Regulation (EU) 2016/679 (GDPR) Art 44', ref-'02016R0679-20160504#art_044', verbatim-'the conditions laid down in this Chapter are complied with by the controller and processor, including for onward transfers of personal data']).
citation(eu_reg_2016_679_art_45, [label-'Regulation (EU) 2016/679 (GDPR) Art 45 (transfers on the basis of an adequacy decision, as a whole)', ref-'02016R0679-20160504#art_045', verbatim-'Such a transfer shall not require any specific authorisation.']).
citation(eu_reg_2016_679_art_45_1, [label-'Regulation (EU) 2016/679 (GDPR) Art 45(1)', ref-'02016R0679-20160504#parag_045.001', verbatim-'A transfer of personal data to a third country or an international organisation may take place where the Commission has decided that the third country']).
citation(eu_reg_2016_679_art_45_3, [label-'Regulation (EU) 2016/679 (GDPR) Art 45(3)', ref-'02016R0679-20160504#parag_045.003', verbatim-'may decide, by means of implementing act, that a third country, a territory or one or more specified sectors within a third country, or an international organisation ensures an adequate level of protection']).
citation(eu_reg_2016_679_art_45_8, [label-'Regulation (EU) 2016/679 (GDPR) Art 45(8)', ref-'02016R0679-20160504#parag_045.008', verbatim-'a list of the third countries, territories and specified sectors within a third country and international organisations for which it has decided that an adequate level of protection is or is no longer ensured']).
citation(eu_reg_2016_679_art_46, [label-'Regulation (EU) 2016/679 (GDPR) Art 46 (transfers subject to appropriate safeguards, as a whole)', ref-'02016R0679-20160504#art_046', verbatim-'a controller or processor may transfer personal data to a third country or an international organisation only if the controller or processor has provided appropriate safeguards']).
citation(eu_reg_2016_679_art_46_1, [label-'Regulation (EU) 2016/679 (GDPR) Art 46(1)', ref-'02016R0679-20160504#parag_046.001', verbatim-'on condition that enforceable data subject rights and effective legal remedies for data subjects are available']).
citation(eu_reg_2016_679_art_46_2, [label-'Regulation (EU) 2016/679 (GDPR) Art 46(2) lead-in', ref-'02016R0679-20160504#parag_046.002', verbatim-'may be provided for, without requiring any specific authorisation from a supervisory authority, by']).
citation(eu_reg_2016_679_art_46_2_b, [label-'Regulation (EU) 2016/679 (GDPR) Art 46(2)(b)', ref-'02016R0679-20160504#point_046.002_b', verbatim-'binding corporate rules in accordance with Article 47']).
citation(eu_reg_2016_679_art_47_1, [label-'Regulation (EU) 2016/679 (GDPR) Art 47(1), points (a) to (c)', ref-'02016R0679-20160504#parag_047.001', verbatim-'The competent supervisory authority shall approve binding corporate rules in accordance with the consistency mechanism set out in Article 63']).
citation(eu_reg_2016_679_art_48, [label-'Regulation (EU) 2016/679 (GDPR) Art 48', ref-'02016R0679-20160504#art_048', verbatim-'may only be recognised or enforceable in any manner if based on an international agreement']).
citation(eu_reg_2016_679_art_49_1, [label-'Regulation (EU) 2016/679 (GDPR) Art 49(1) first subparagraph, lead-in', ref-'02016R0679-20160504#parag_049.001', verbatim-'a transfer or a set of transfers of personal data to a third country or an international organisation shall take place only on one of the following conditions']).
citation(eu_reg_2016_679_art_49_1_a, [label-'Regulation (EU) 2016/679 (GDPR) Art 49(1) first subparagraph point (a)', ref-'02016R0679-20160504#parag_049.001', verbatim-'the data subject has explicitly consented to the proposed transfer, after having been informed of the possible risks of such transfers']).
citation(eu_reg_2016_679_art_49_1_b, [label-'Regulation (EU) 2016/679 (GDPR) Art 49(1) first subparagraph point (b)', ref-'02016R0679-20160504#parag_049.001', verbatim-'the transfer is necessary for the performance of a contract between the data subject and the controller']).
citation(eu_reg_2016_679_art_49_1_c, [label-'Regulation (EU) 2016/679 (GDPR) Art 49(1) first subparagraph point (c)', ref-'02016R0679-20160504#parag_049.001', verbatim-'the transfer is necessary for the conclusion or performance of a contract concluded in the interest of the data subject']).
citation(eu_reg_2016_679_art_49_1_d, [label-'Regulation (EU) 2016/679 (GDPR) Art 49(1) first subparagraph point (d)', ref-'02016R0679-20160504#parag_049.001', verbatim-'the transfer is necessary for important reasons of public interest']).
citation(eu_reg_2016_679_art_49_1_e, [label-'Regulation (EU) 2016/679 (GDPR) Art 49(1) first subparagraph point (e)', ref-'02016R0679-20160504#parag_049.001', verbatim-'the transfer is necessary for the establishment, exercise or defence of legal claims']).
citation(eu_reg_2016_679_art_49_1_f, [label-'Regulation (EU) 2016/679 (GDPR) Art 49(1) first subparagraph point (f)', ref-'02016R0679-20160504#parag_049.001', verbatim-'the transfer is necessary in order to protect the vital interests of the data subject or of other persons']).
citation(eu_reg_2016_679_art_49_1_g, [label-'Regulation (EU) 2016/679 (GDPR) Art 49(1) first subparagraph point (g)', ref-'02016R0679-20160504#parag_049.001', verbatim-'the transfer is made from a register which according to Union or Member State law is intended to provide information to the public']).
citation(eu_reg_2016_679_art_49_1_second_subpara, [label-'Regulation (EU) 2016/679 (GDPR) Art 49(1) second subparagraph', ref-'02016R0679-20160504#parag_049.001', verbatim-'a transfer to a third country or an international organisation may take place only if the transfer is not repetitive, concerns only a limited number of data subjects']).
citation(eu_reg_2016_679_art_49_2, [label-'Regulation (EU) 2016/679 (GDPR) Art 49(2)', ref-'02016R0679-20160504#parag_049.002', verbatim-'shall not involve the entirety of the personal data or entire categories of the personal data contained in the register']).
citation(eu_reg_2016_679_art_49_3, [label-'Regulation (EU) 2016/679 (GDPR) Art 49(3)', ref-'02016R0679-20160504#parag_049.003', verbatim-'shall not apply to activities carried out by public authorities in the exercise of their public powers']).
citation(eu_reg_2016_679_art_49_4, [label-'Regulation (EU) 2016/679 (GDPR) Art 49(4)', ref-'02016R0679-20160504#parag_049.004', verbatim-'shall be recognised in Union law or in the law of the Member State to which the controller is subject']).

:- end_module(citations).
