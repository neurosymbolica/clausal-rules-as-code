% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% fixtures.clausal -- representative subjects for eu/data_protection/gdpr_codes_and_certification.
% A TOP-LAYER consumer: it imports the three contract queries of the
% determination slice, and nothing else. Profile keys and subject ids are
% atoms and need no import.
%
% A profile is an ATTRIBUTE LIST [attribute(Key, Value), ...] (the order's
% typed input contract); dates are date(Y, M, D) terms (reading (19)).
% Each subject is one row: its query (code, certification(IssuedOn,
% CheckDate) or accreditation(Body, AccreditedOn, CheckDate)), a base
% profile and the changes made to it. For every route there is a positive
% case and a one-unit near-miss control: the last day of each maximum
% period and the day after it, the issue or accreditation day and the day
% before it, a leap-day start, a year beyond the calendar, each deciding
% key flipped, each judgement unsure, and the <<DNUM>> order (an absent key
% named before an unsure judgement is referred).
% gdpr_codes_and_certification_assess/2 gives the verdict term
% gdpr_codes_and_certification_verdict(Result, Citations) of the subject's
% query.
% =====================================================================

:- module(fixtures, [
    gdpr_codes_and_certification_subject/1,
    gdpr_codes_and_certification_profile_for/2,
    gdpr_codes_and_certification_assess/2
]).

:- use_module(eu/data_protection/gdpr_codes_and_certification/gdpr_codes_and_certification, [
    certification_status/5,
    code_monitoring_status/3,
    accreditation_status/6
]).

% ---- Base profiles -----------------------------------------------------
base_profile(certification_by_authority, [
    attribute(certification_issuer, competent_supervisory_authority),
    attribute(certification_criteria_approved, true),
    attribute(certification_withdrawn, false),
    attribute(certification_requirements_not_met, false),
    attribute(certification_holder_not_subject_to_regulation, false)
]).
base_profile(certification_by_body, [
    attribute(certification_issuer, certification_body),
    attribute(certification_body_accredited, true),
    attribute(certification_criteria_approved, true),
    attribute(supervisory_authority_informed_before_issue_or_renewal, true),
    attribute(certification_withdrawn, false),
    attribute(certification_requirements_not_met, false),
    attribute(certification_holder_not_subject_to_regulation, false)
]).
base_profile(certification_for_transfers, [
    attribute(certification_issuer, competent_supervisory_authority),
    attribute(certification_criteria_approved, true),
    attribute(certification_withdrawn, false),
    attribute(certification_requirements_not_met, false),
    attribute(certification_holder_not_subject_to_regulation, true),
    attribute(certification_holder_binding_commitments_made, true)
]).
base_profile(code_relied_on_for_transfers, [
    attribute(processing_by_public_authority_or_body, false),
    attribute(code_prepared_by_body_representing_controllers_or_processors, true),
    attribute(code_approved_by_competent_supervisory_authority, true),
    attribute(code_contains_monitoring_mechanisms, true),
    attribute(monitoring_body_accredited, true),
    attribute(code_adhered_to_by_party_not_subject_to_regulation, true),
    attribute(code_has_general_validity, true),
    attribute(code_adherent_binding_commitments_made, true)
]).
base_profile(monitoring_body_in_good_standing, [
    attribute(monitoring_body_accreditation_revoked, false),
    attribute(monitoring_body_independence_and_expertise_demonstrated, true),
    attribute(monitoring_body_eligibility_monitoring_and_review_procedures_established, true),
    attribute(monitoring_body_complaint_procedures_and_structures_established, true),
    attribute(monitoring_body_no_conflict_of_interests_demonstrated, true),
    attribute(monitoring_body_actions_infringe_regulation, false)
]).
base_profile(certification_body_in_good_standing, [
    attribute(certification_body_accreditation_revoked, false),
    attribute(certification_body_accrediting_entity, national_accreditation_body),
    attribute(certification_body_independence_and_expertise_demonstrated, true),
    attribute(certification_body_undertook_to_respect_approved_criteria, true),
    attribute(certification_body_issuing_review_and_withdrawal_procedures_established, true),
    attribute(certification_body_complaint_procedures_and_structures_established, true),
    attribute(certification_body_no_conflict_of_interests_demonstrated, true),
    attribute(certification_body_actions_infringe_regulation, false)
]).
base_profile(empty, []).
base_profile(duplicate_and_unknown, [
    attribute(certification_withdrawn, true),
    attribute(certification_withdrawn, false),
    attribute(colour, blue)
]).
base_profile(attested_value, [
    attribute(certification_withdrawn, attested(true))
]).
base_profile(crisp_key_unsure, [
    attribute(certification_withdrawn, unsure)
]).
base_profile(judgement_key_unsure, [
    attribute(certification_requirements_not_met, unsure)
]).

