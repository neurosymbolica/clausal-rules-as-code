% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_queries.clausal -- the query layer: every combinator exported by
% queries.clausal and every query type registered in manifest
% query_interface (#13 decide_processor_contract/2, #3
% processor_contract_status/2, #7 contract_checklist/2, #16 what-if).
% Run: python -m clausal.testing eu/data_protection/gdpr_processor_contract/tests/test_queries.clausal
% =====================================================================
:- module(test_queries, []).
:- use_module(eu/data_protection/gdpr_processor_contract/queries, [
    gdpr_processor_contract_profile_keys/1,
    gdpr_processor_contract_input_problems/2,
    gdpr_processor_contract_what_if/4
]).
:- use_module(eu/data_protection/gdpr_processor_contract/processor_contract_status, [
    decide_processor_contract/2,
    processor_contract_status/2,
    contract_checklist/2
]).
:- use_module(eu/data_protection/gdpr_processor_contract/fixtures, [gdpr_processor_contract_profile_for/2]).

cited_item(checklist_item(Key, cite(Citation), _)) :-
    atom(Key),
    atom(Citation).

what_if_statuses(Subject, Key, Value, Statuses) :-
    gdpr_processor_contract_profile_for(Subject, Profile),
    findall(Status, gdpr_processor_contract_what_if(Profile, Key, Value, Status), Statuses).

test(profile_keys_are_the_contract_keys) :-
    gdpr_processor_contract_profile_keys(ProfileKeys),
    ProfileKeys == [contract_binding_on_processor, contract_governed_by_union_or_member_state_law, contract_in_writing, contract_sets_out_categories_of_data_subjects, contract_sets_out_controller_obligations_and_rights, contract_sets_out_duration, contract_sets_out_nature_of_processing, contract_sets_out_purpose_of_processing, contract_sets_out_subject_matter, contract_sets_out_type_of_personal_data, controller_given_opportunity_to_object, processing_on_behalf_of_controller, processor_determines_purposes_and_means, processor_informed_controller_of_intended_changes, processor_provides_sufficient_guarantees, standard_clauses_adopted, stipulates_assistance_with_articles_32_to_36_obligations, stipulates_assistance_with_data_subject_requests, stipulates_conditions_for_engaging_another_processor, stipulates_confidentiality_commitment, stipulates_deletion_or_return_of_personal_data, stipulates_information_and_audit_rights, stipulates_notice_of_infringing_instruction, stipulates_processing_only_on_documented_instructions, stipulates_security_measures, subprocessor_authorisation, subprocessor_authorisation_given_before_engagement, subprocessor_contract_governed_by_union_or_member_state_law, subprocessor_contract_in_writing, subprocessor_engaged, subprocessor_obligations_same, subprocessor_provides_sufficient_guarantees].

% ---- re-exported input check ------------------------------------------
test(input_check_is_reachable_through_queries) :-
    gdpr_processor_contract_profile_for(input_problems_mixed, Profile),
    gdpr_processor_contract_input_problems(Profile, [wrong_type(contract_in_writing), duplicate_key(subprocessor_engaged), unknown_key(stray_key)]).
test(input_check_is_empty_for_a_well_formed_profile) :-
    gdpr_processor_contract_profile_for(eligible_without_subprocessor, Profile),
    gdpr_processor_contract_input_problems(Profile, []).

% ---- #16 what-if --------------------------------------------------------
test(what_if_drops_a_stipulation_once) :-
    what_if_statuses(eligible_without_subprocessor, stipulates_security_measures, false, Statuses),
    Statuses == [ineligible].
test(what_if_repairs_point_h) :-
    what_if_statuses(near_miss_missing_point_h, stipulates_information_and_audit_rights, true, Statuses),
    Statuses == [eligible].
test(what_if_closes_the_first_gate) :-
    what_if_statuses(eligible_without_subprocessor, processing_on_behalf_of_controller, false, Statuses),
    Statuses == [not_applicable].
test(what_if_makes_the_processor_a_controller) :-
    what_if_statuses(eligible_without_subprocessor, processor_determines_purposes_and_means, true, Statuses),
    Statuses == [needs_legal_review(deferred_provision(cite(eu_reg_2016_679_art_28_10)), [inputs_relied_on([processing_on_behalf_of_controller-true, processor_determines_purposes_and_means-true, standard_clauses_adopted-absent])])].
test(what_if_unsure_guarantees_refer) :-
    what_if_statuses(eligible_without_subprocessor, processor_provides_sufficient_guarantees, unsure, [needs_legal_review(open_textured(processor_provides_sufficient_guarantees, cite(eu_reg_2016_679_art_28_1)), _)]).
test(what_if_a_wrong_type_is_an_input_problem) :-
    what_if_statuses(eligible_without_subprocessor, contract_in_writing, unsure, Statuses),
    Statuses == [input_problems([wrong_type(contract_in_writing)])].
test(what_if_replacing_a_duplicate_clears_it) :-
    gdpr_processor_contract_profile_for(input_problems_mixed, Profile),
    gdpr_processor_contract_what_if(Profile, subprocessor_engaged, false, input_problems([wrong_type(contract_in_writing), unknown_key(stray_key)])).
test(what_if_never_duplicates_a_key, fail) :-
    gdpr_processor_contract_profile_for(eligible_without_subprocessor, Profile),
    gdpr_processor_contract_what_if(Profile, subprocessor_engaged, false, input_problems(_)).

% ---- #13 compliance_check -------------------------------------------------
test(compliance_check_gives_one_verdict) :-
    gdpr_processor_contract_profile_for(eligible_general_written_authorisation, Profile),
    findall(Verdict, decide_processor_contract(Profile, Verdict), [processor_contract_verdict(eligible, [], _)]).
test(compliance_check_refuses_a_contract_without_point_h) :-
    gdpr_processor_contract_profile_for(near_miss_missing_point_h, Profile),
    decide_processor_contract(Profile, processor_contract_verdict(ineligible, [stipulates_information_and_audit_rights], [cite(eu_reg_2016_679_art_28_3_h)])).

% ---- #3 status_determination ----------------------------------------------
test(status_determination_gives_one_status) :-
    gdpr_processor_contract_profile_for(not_applicable_not_on_behalf, Profile),
    findall(Status, processor_contract_status(Profile, Status), Statuses),
    Statuses == [not_applicable].

% ---- #7 justification -----------------------------------------------------
test(justification_every_item_carries_a_citation) :-
    gdpr_processor_contract_profile_for(eligible_general_written_authorisation, Profile),
    contract_checklist(Profile, Items),
    maplist(cited_item, Items).
test(justification_cites_the_missing_point) :-
    gdpr_processor_contract_profile_for(near_miss_general_written_without_objection_opportunity, Profile),
    contract_checklist(Profile, Items),
    member(checklist_item(controller_given_opportunity_to_object, cite(eu_reg_2016_679_art_28_2), unmet), Items).

:- end_module(test_queries).
