% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% fixtures.clausal -- representative profiles for eu/data_protection/gdpr_processor_contract.
% A profile is an attribute list [attribute(Key, Value), ...]. Each subject is the
% base profile (a compliant arrangement, no other processor) with some keys set and
% some keys dropped (absent). Near-miss controls differ from their base by one key.
% =====================================================================

:- module(fixtures, [
    gdpr_processor_contract_subject/1,
    gdpr_processor_contract_profile_for/2,
    gdpr_processor_contract_assess/2
]).

:- use_module(library(reif), [memberd_t/3]).
:- use_module(eu/data_protection/gdpr_processor_contract/processor_contract_status, [decide_processor_contract/2]).

% ---- Subject registry ------------------------------------------------
gdpr_processor_contract_subject(Subject) :-
    subject_edit(Subject, _, _).

% ---- the base: every limb met, no other processor, standard clauses absent
base_pairs([
    processing_on_behalf_of_controller-true,
    processor_determines_purposes_and_means-false,
    processor_provides_sufficient_guarantees-true,
    contract_binding_on_processor-true,
    contract_governed_by_union_or_member_state_law-true,
    contract_in_writing-true,
    contract_sets_out_subject_matter-true,
    contract_sets_out_duration-true,
    contract_sets_out_nature_of_processing-true,
    contract_sets_out_purpose_of_processing-true,
    contract_sets_out_type_of_personal_data-true,
    contract_sets_out_categories_of_data_subjects-true,
    contract_sets_out_controller_obligations_and_rights-true,
    stipulates_processing_only_on_documented_instructions-true,
    stipulates_confidentiality_commitment-true,
    stipulates_security_measures-true,
    stipulates_conditions_for_engaging_another_processor-true,
    stipulates_assistance_with_data_subject_requests-true,
    stipulates_assistance_with_articles_32_to_36_obligations-true,
    stipulates_deletion_or_return_of_personal_data-true,
    stipulates_information_and_audit_rights-true,
    stipulates_notice_of_infringing_instruction-true,
    subprocessor_engaged-false
]).

subprocessor_pairs([
    subprocessor_engaged-true,
    subprocessor_obligations_same-true,
    subprocessor_provides_sufficient_guarantees-true,
    subprocessor_contract_in_writing-true,
    subprocessor_contract_governed_by_union_or_member_state_law-true
]).

% subject_edit(Subject, SetPairs, DroppedKeys)
subject_edit(compliant_without_subprocessor, [], []).
subject_edit(compliant_with_specific_subprocessor, Sets, []) :-
    subprocessor_pairs(Pairs),
    append(Pairs, [subprocessor_authorisation-specific_written, subprocessor_authorisation_given_before_engagement-true], Sets).
subject_edit(compliant_with_general_subprocessor, Sets, []) :-
    subprocessor_pairs(Pairs),
    append(Pairs, [subprocessor_authorisation-general_written, subprocessor_authorisation_given_before_engagement-true, processor_informed_controller_of_intended_changes-true, controller_given_opportunity_to_object-true], Sets).
subject_edit(general_authorisation_without_opportunity_to_object, Sets, []) :-
    subprocessor_pairs(Pairs),
    append(Pairs, [subprocessor_authorisation-general_written, subprocessor_authorisation_given_before_engagement-true, processor_informed_controller_of_intended_changes-true, controller_given_opportunity_to_object-false], Sets).
subject_edit(specific_authorisation_given_late, Sets, []) :-
    subprocessor_pairs(Pairs),
    append(Pairs, [subprocessor_authorisation-specific_written, subprocessor_authorisation_given_before_engagement-false], Sets).
subject_edit(subprocessor_engaged_without_authorisation, Sets, []) :-
    subprocessor_pairs(Pairs),
    append(Pairs, [subprocessor_authorisation-none], Sets).
subject_edit(subprocessor_obligations_unsure, [
    subprocessor_engaged-true,
    subprocessor_authorisation-specific_written,
    subprocessor_authorisation_given_before_engagement-true,
    subprocessor_obligations_same-unsure,
    subprocessor_provides_sufficient_guarantees-true,
    subprocessor_contract_in_writing-true,
    subprocessor_contract_governed_by_union_or_member_state_law-true
], []).
subject_edit(audit_clause_missing, [stipulates_information_and_audit_rights-false], []).
subject_edit(confidentiality_and_security_missing, [stipulates_confidentiality_commitment-false, stipulates_security_measures-false], []).
subject_edit(not_a_processor, [processing_on_behalf_of_controller-false], []).
subject_edit(processor_determines_purposes, [processor_determines_purposes_and_means-true], []).
subject_edit(controller_with_missing_clause, [processor_determines_purposes_and_means-true, stipulates_information_and_audit_rights-false], []).
subject_edit(guarantees_unsure, [processor_provides_sufficient_guarantees-unsure], []).
subject_edit(role_unsure, [processing_on_behalf_of_controller-unsure], []).
subject_edit(role_unestablished, [], [processing_on_behalf_of_controller]).
subject_edit(in_writing_unestablished, [], [contract_in_writing]).
subject_edit(standard_clauses_attested, [standard_clauses_adopted-attested(true, attestation(decision_layer, recorded_at_review, user_confirmed, none))], []).
subject_edit(input_problem_in_writing_unsure, [contract_in_writing-unsure], []).

% ---- Profiles --------------------------------------------------------
gdpr_processor_contract_profile_for(Subject, Profile) :-
    subject_edit(Subject, Sets, Drops),
    base_pairs(Base),
    pairs_keys(Sets, SetKeys),
    append(SetKeys, Drops, Removed),
    remove_keys(Base, Removed, Kept),
    append(Kept, Sets, Pairs),
    attributes_of(Pairs, Profile).

remove_keys([], _, []).
remove_keys([Key-Value|Pairs], Removed, Result) :-
    remove_keys(Pairs, Removed, LaterResult),
    memberd_t(Key, Removed, IsRemoved),
    keep_pair(IsRemoved, Key, Value, LaterResult, Result).

keep_pair(true, _, _, Later, Later).
keep_pair(false, Key, Value, Later, [Key-Value|Later]).

attributes_of([], []).
attributes_of([Key-Value|Pairs], [attribute(Key, Value)|Attributes]) :-
    attributes_of(Pairs, Attributes).

% ---- Convenience wrapper ---------------------------------------------
gdpr_processor_contract_assess(Subject, Result) :-
    gdpr_processor_contract_profile_for(Subject, Profile),
    decide_processor_contract(Profile, Result).

:- end_module(fixtures).
