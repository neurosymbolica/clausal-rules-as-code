% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% queries.clausal -- QUERY-COMBINATOR layer for eu/data_protection/gdpr_processor_contract.
% A TOP-LAYER consumer: it imports the determination slice's PUBLIC
% predicates it calls, and nothing else.
%
% Query types this domain serves (registered in manifest query_interface):
%   #13 compliance_check -- decide_processor_contract/2 (processor_contract_status
%       slice): may the controller use this processor under this arrangement
%       (Art 28(1) 'shall use only').
%   #3  status_determination -- processor_contract_status/2 (same slice).
%   #7  justification -- contract_checklist/2 (same slice): every
%       checklist_item carries cite(...).
% This file adds the cross-cutting combinators:
%   gdpr_processor_contract_what_if/4      (#16 what-if): REPLACE one key (never
%       append, which would be a duplicate_key input problem) -> re-evaluate.
%       The kit's override_key/4 works on dicts; this profile is an attribute
%       list, so the replacement is written here as list plumbing.
%   gdpr_processor_contract_profile_keys/1: the 32 profile keys, root_exports order
%   gdpr_processor_contract_input_problems/2: re-exported from the kernel
% and exports the order's RESULT CONSTRUCTORS: they are data. input_problems/1
% and wrong_type/1 carry a guarded shape check so the ISO export finds a
% definition; the shape check holds only for a well-shaped payload.
%
% No clause here decides a statutory condition: what-if is list plumbing and
% the status it reports is the slice's, so no implements/1 marker is needed.
% =====================================================================

:- module(queries, [
    gdpr_processor_contract_profile_keys/1,
    gdpr_processor_contract_input_problems/2,
    gdpr_processor_contract_what_if/4,
    processor_contract_verdict/3,
    checklist_item/3,
    input_problems/1,
    unknown_key/1,
    wrong_type/1,
    duplicate_key/1,
    indeterminate/1,
    needs_legal_review/2,
    open_textured/2,
    deferred_provision/1,
    inputs_relied_on/1,
    provenance/2,
    outside_fact/2,
    attested/2,
    attestation/4,
    url/2,
    document/2
]).

:- use_module(eu/data_protection/gdpr_processor_contract/kernel, [gdpr_processor_contract_input_problems/2, gdpr_processor_contract_key_order/1]).
:- use_module(eu/data_protection/gdpr_processor_contract/processor_contract_status, [processor_contract_status_status/2]).

% ---- result constructor shape checks -------------------------------------
% input_problems(Problems): Problems is the list payload of the status.
input_problems(Problems) :-
    is_list(Problems).

% wrong_type(Key): Key is the atom naming the key (or profile).
wrong_type(Key) :-
    atom(Key).

% ---- profile key schema: the kernel's canonical (root_exports) order -----
gdpr_processor_contract_profile_keys(Keys) :-
    gdpr_processor_contract_key_order(Keys).

% ---- #16 what-if: re-evaluate with one key hypothetically replaced -------
% Every occurrence of the key is removed and one attribute(Key, Value) is
% appended, so the hypothesis never carries a duplicate key. A profile that
% is not a proper list is passed through unchanged, and the slice answers it
% with its input problems.
gdpr_processor_contract_what_if(Profile, OverriddenKey, NewValue, NewStatus) :-
    proper_list_t(Profile, IsList),
    hypothesis(IsList, Profile, OverriddenKey, NewValue, Hypothesis),
    processor_contract_status_status(Hypothesis, NewStatus).

hypothesis(false, Profile, _, _, Profile).
hypothesis(true, Profile, OverriddenKey, NewValue, Hypothesis) :-
    without_key(Profile, OverriddenKey, Kept),
    append(Kept, [attribute(OverriddenKey, NewValue)], Hypothesis).

proper_list_t(Term, false) :-
    var(Term).
proper_list_t(Term, true) :-
    Term == [].
proper_list_t(Term, Truth) :-
    nonvar(Term),
    Term = [_|Elements],
    proper_list_t(Elements, Truth).
proper_list_t(Term, false) :-
    nonvar(Term),
    Term \== [],
    Term \= [_|_].

without_key([], _, []).
without_key([Element|Elements], OverriddenKey, Kept) :-
    element_matches_t(Element, OverriddenKey, Matches),
    keep_element(Matches, Element, Rest, Kept),
    without_key(Elements, OverriddenKey, Rest).

element_matches_t(Element, _, false) :-
    var(Element).
element_matches_t(Element, OverriddenKey, Truth) :-
    nonvar(Element),
    Element = attribute(ElementKey, _),
    same_key_t(ElementKey, OverriddenKey, Truth).
element_matches_t(Element, _, false) :-
    nonvar(Element),
    Element \= attribute(_, _).

same_key_t(ElementKey, OverriddenKey, true) :-
    ElementKey == OverriddenKey.
same_key_t(ElementKey, OverriddenKey, false) :-
    ElementKey \== OverriddenKey.

keep_element(true, _, Rest, Rest).
keep_element(false, Element, Rest, [Element|Rest]).

% ---- tests ----------------------------------------------------------------
base_profile([
    attribute(processing_on_behalf_of_controller, true),
    attribute(processor_determines_purposes_and_means, false),
    attribute(processor_provides_sufficient_guarantees, true),
    attribute(contract_binding_on_processor, true),
    attribute(contract_governed_by_union_or_member_state_law, true),
    attribute(contract_in_writing, true),
    attribute(contract_sets_out_subject_matter, true),
    attribute(contract_sets_out_duration, true),
    attribute(contract_sets_out_nature_of_processing, true),
    attribute(contract_sets_out_purpose_of_processing, true),
    attribute(contract_sets_out_type_of_personal_data, true),
    attribute(contract_sets_out_categories_of_data_subjects, true),
    attribute(contract_sets_out_controller_obligations_and_rights, true),
    attribute(stipulates_processing_only_on_documented_instructions, true),
    attribute(stipulates_confidentiality_commitment, true),
    attribute(stipulates_security_measures, true),
    attribute(stipulates_conditions_for_engaging_another_processor, true),
    attribute(stipulates_assistance_with_data_subject_requests, true),
    attribute(stipulates_assistance_with_articles_32_to_36_obligations, true),
    attribute(stipulates_deletion_or_return_of_personal_data, true),
    attribute(stipulates_information_and_audit_rights, true),
    attribute(stipulates_notice_of_infringing_instruction, true),
    attribute(subprocessor_engaged, false)
]).

test(profile_keys_are_thirty_two) :-
    gdpr_processor_contract_profile_keys(Keys),
    length(Keys, 32).
test(input_problems_constructor_holds_for_a_list) :-
    input_problems([wrong_type(profile)]).
test(input_problems_constructor_rejects_a_non_list, fail) :-
    input_problems(profile_text).
test(wrong_type_constructor_holds_for_an_atom) :-
    wrong_type(contract_in_writing).
test(wrong_type_constructor_rejects_a_compound, fail) :-
    wrong_type(attribute(contract_in_writing, true)).
test(what_if_replaces_and_flips_to_ineligible) :-
    base_profile(Profile),
    findall(Status, gdpr_processor_contract_what_if(Profile, stipulates_security_measures, false, Status), Statuses),
    Statuses == [ineligible].
test(what_if_identity_stays_eligible) :-
    base_profile(Profile),
    gdpr_processor_contract_what_if(Profile, stipulates_security_measures, true, eligible).
test(what_if_never_creates_a_duplicate_key, fail) :-
    base_profile(Profile),
    gdpr_processor_contract_what_if(Profile, contract_in_writing, true, input_problems(_)).
test(what_if_adds_an_absent_key) :-
    gdpr_processor_contract_what_if([], processing_on_behalf_of_controller, false, not_applicable).
test(what_if_on_a_non_list_reports_input_problems) :-
    gdpr_processor_contract_what_if(profile_text, contract_in_writing, true, input_problems([wrong_type(profile)])).

:- end_module(queries).
