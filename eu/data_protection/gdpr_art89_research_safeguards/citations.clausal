% =====================================================================
% citations.clausal -- statutory citation records for eu/data_protection/gdpr_art89_research_safeguards.
% Every operative clause opens with implements(Key), Key recorded here.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

citation(eu_reg_2016_679_art_89_1, [label-'Regulation (EU) 2016/679 (GDPR) Art 89(1)', ref-'https://eur-lex.europa.eu/eli/reg/2016/679/oj']).

implements(Key) :-
    citation(Key, _).

:- end_module(citations).
