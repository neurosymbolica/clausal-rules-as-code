% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% fixtures.clausal -- representative profiles for eu/data_protection/gdpr_data_subject_rights_erasure.
% A TOP-LAYER consumer: it imports the one public predicate it calls.
%
% A profile is an attribute list [attribute(Key, Value), ...] (the order's
% input contract). Every route of THE DECISION has a positive subject and a
% one-unit near-miss control (one key flipped) that gets another verdict:
%   must_comply_no_longer_necessary      <-> request_type_absent, input problems
%   must_comply_consent_withdrawn        <-> need_not_comply_other_legal_ground
%   must_comply_marketing_objection      <-> need_not_comply_overriding_grounds
%   must_comply_erasure_law_attested     <-> need_not_comply_no_ground
%                                         <-> needs_legal_review_erasure_law_unattested
%   must_comply_unlawful_processing      <-> needs_legal_review_unlawful_processing_unsure
%   need_not_comply_freedom_of_expression <-> must_comply_freedom_of_expression_ruled_out
%   need_not_comply_public_task_with_basis_open <-> indeterminate_every_missing_key
%   need_not_comply_processing_required_by_law <-> must_comply_processing_obligation_attested_false
%   need_not_comply_archiving_impairment <-> must_comply_archiving_without_impairment
%   need_not_comply_legal_claims         <-> needs_legal_review_legal_claims_unsure
%   need_not_comply_manifestly_unfounded_with_fee <-> must_comply_request_not_manifestly_unfounded
%   need_not_comply_unable_to_identify   <-> must_comply_controller_able_to_identify
%   need_not_comply_legislative_restriction_attested <-> must_comply_legislative_restriction_attested_false
%   suspended_identity_not_confirmed     <-> must_comply_identity_confirmed
%                                         <-> indeterminate_identity_confirmed_absent
%   input_problems_wrong_boolean_value   <-> must_comply_with_valid_boolean
% =====================================================================

:- module(fixtures, [
    gdpr_data_subject_rights_erasure_subject/1,
    gdpr_data_subject_rights_erasure_profile_for/2,
    gdpr_data_subject_rights_erasure_assess/2,
    gdpr_data_subject_rights_erasure_fixture/3
]).

:- use_module(eu/data_protection/gdpr_data_subject_rights_erasure/queries, [decide_data_subject_request/2]).

% ---- Subject registry ------------------------------------------------
gdpr_data_subject_rights_erasure_subject(must_comply_no_longer_necessary).
gdpr_data_subject_rights_erasure_subject(request_type_absent).
gdpr_data_subject_rights_erasure_subject(must_comply_consent_withdrawn).
gdpr_data_subject_rights_erasure_subject(need_not_comply_other_legal_ground).
