% ---- Expected verdicts -------------------------------------------------
expected_verdict(must_comply_no_longer_necessary, gdpr_data_subject_request_verdict(must_comply, art17_1_a, none, [], [cite(eu_reg_2016_679_art_17_1), cite(eu_reg_2016_679_art_17_1_a)])).
expected_verdict(request_type_absent, gdpr_data_subject_request_verdict(indeterminate([request_type]), none, none, [], [])).
expected_verdict(must_comply_consent_withdrawn, gdpr_data_subject_request_verdict(must_comply, art17_1_b, none, [], [cite(eu_reg_2016_679_art_17_1), cite(eu_reg_2016_679_art_17_1_b)])).
expected_verdict(need_not_comply_other_legal_ground, gdpr_data_subject_request_verdict(need_not_comply, none, none, [], [cite(eu_reg_2016_679_art_17_1)])).
expected_verdict(must_comply_marketing_objection, gdpr_data_subject_request_verdict(must_comply, art17_1_c, none, [], [cite(eu_reg_2016_679_art_17_1), cite(eu_reg_2016_679_art_17_1_c)])).
expected_verdict(need_not_comply_overriding_grounds, gdpr_data_subject_request_verdict(need_not_comply, none, none, [], [cite(eu_reg_2016_679_art_17_1)])).
expected_verdict(must_comply_erasure_law_attested, gdpr_data_subject_request_verdict(must_comply, art17_1_e, none, [], [cite(eu_reg_2016_679_art_17_1), cite(eu_reg_2016_679_art_17_1_e)])).
expected_verdict(need_not_comply_no_ground, gdpr_data_subject_request_verdict(need_not_comply, none, none, [], [cite(eu_reg_2016_679_art_17_1)])).
expected_verdict(needs_legal_review_erasure_law_unattested, gdpr_data_subject_request_verdict(needs_legal_review(cross_reference_unresolved(cite(eu_reg_2016_679_art_17_1_e), cite(union_or_member_state_law_requiring_erasure)), [resolution(cite(union_or_member_state_law_requiring_erasure), not_attempted), inputs_relied_on([request_type-erasure, data_no_longer_necessary_for_purposes-false, personal_data_unlawfully_processed-false, erasure_required_by_union_or_member_state_law-absent])]), none, none, [], [])).
expected_verdict(must_comply_unlawful_processing, gdpr_data_subject_request_verdict(must_comply, art17_1_d, none, [], [cite(eu_reg_2016_679_art_17_1), cite(eu_reg_2016_679_art_17_1_d)])).
expected_verdict(needs_legal_review_unlawful_processing_unsure, gdpr_data_subject_request_verdict(needs_legal_review(open_textured(personal_data_unlawfully_processed, cite(eu_reg_2016_679_art_17_1_d)), [inputs_relied_on([request_type-erasure, data_no_longer_necessary_for_purposes-false, personal_data_unlawfully_processed-unsure])]), none, none, [], [])).
expected_verdict(need_not_comply_freedom_of_expression, gdpr_data_subject_request_verdict(need_not_comply, art17_1_a, art17_3_a, [], [cite(eu_reg_2016_679_art_17_1), cite(eu_reg_2016_679_art_17_1_a), cite(eu_reg_2016_679_art_17_3), cite(eu_reg_2016_679_art_17_3_a)])).
expected_verdict(must_comply_freedom_of_expression_ruled_out, gdpr_data_subject_request_verdict(must_comply, art17_1_a, none, [], [cite(eu_reg_2016_679_art_17_1), cite(eu_reg_2016_679_art_17_1_a)])).
expected_verdict(need_not_comply_public_task_with_basis_open, gdpr_data_subject_request_verdict(need_not_comply, none, art17_3_b, [], [cite(eu_reg_2016_679_art_17_1), cite(eu_reg_2016_679_art_17_3), cite(eu_reg_2016_679_art_17_3_b)])).
expected_verdict(indeterminate_every_missing_key, gdpr_data_subject_request_verdict(indeterminate([consent_is_the_basis_of_processing, consent_withdrawn, other_legal_ground_for_processing_exists, objection_under_art21_1_made, objection_under_art21_2_made, collected_in_relation_to_information_society_services_offer, data_no_longer_necessary_for_purposes, overriding_legitimate_grounds_exist, personal_data_unlawfully_processed]), none, none, [], [])).
expected_verdict(need_not_comply_processing_required_by_law, gdpr_data_subject_request_verdict(need_not_comply, art17_1_a, art17_3_b, [], [cite(eu_reg_2016_679_art_17_1), cite(eu_reg_2016_679_art_17_1_a), cite(eu_reg_2016_679_art_17_3), cite(eu_reg_2016_679_art_17_3_b)])).
expected_verdict(must_comply_processing_obligation_attested_false, gdpr_data_subject_request_verdict(must_comply, art17_1_a, none, [], [cite(eu_reg_2016_679_art_17_1), cite(eu_reg_2016_679_art_17_1_a)])).
expected_verdict(need_not_comply_archiving_impairment, gdpr_data_subject_request_verdict(need_not_comply, art17_1_a, art17_3_d, [], [cite(eu_reg_2016_679_art_17_1), cite(eu_reg_2016_679_art_17_1_a), cite(eu_reg_2016_679_art_17_3), cite(eu_reg_2016_679_art_17_3_d)])).
expected_verdict(must_comply_archiving_without_impairment, gdpr_data_subject_request_verdict(must_comply, art17_1_a, none, [], [cite(eu_reg_2016_679_art_17_1), cite(eu_reg_2016_679_art_17_1_a)])).
expected_verdict(need_not_comply_legal_claims, gdpr_data_subject_request_verdict(need_not_comply, art17_1_a, art17_3_e, [], [cite(eu_reg_2016_679_art_17_1), cite(eu_reg_2016_679_art_17_1_a), cite(eu_reg_2016_679_art_17_3), cite(eu_reg_2016_679_art_17_3_e)])).
expected_verdict(needs_legal_review_legal_claims_unsure, gdpr_data_subject_request_verdict(needs_legal_review(open_textured(processing_necessary_for_legal_claims, cite(eu_reg_2016_679_art_17_3_e)), [inputs_relied_on([request_type-erasure, processing_necessary_for_legal_claims-unsure])]), none, none, [], [])).
expected_verdict(need_not_comply_manifestly_unfounded_with_fee, gdpr_data_subject_request_verdict(need_not_comply, art17_1_a, art12_5_manifestly_unfounded_or_excessive, [reasonable_fee_may_be_charged], [cite(eu_reg_2016_679_art_12_5), cite(eu_reg_2016_679_art_17_1), cite(eu_reg_2016_679_art_17_1_a)])).
expected_verdict(must_comply_request_not_manifestly_unfounded, gdpr_data_subject_request_verdict(must_comply, art17_1_a, none, [], [cite(eu_reg_2016_679_art_17_1), cite(eu_reg_2016_679_art_17_1_a)])).
expected_verdict(need_not_comply_unable_to_identify, gdpr_data_subject_request_verdict(need_not_comply, art17_1_a, art12_2_unable_to_identify, [], [cite(eu_reg_2016_679_art_12_2), cite(eu_reg_2016_679_art_17_1), cite(eu_reg_2016_679_art_17_1_a)])).
expected_verdict(must_comply_controller_able_to_identify, gdpr_data_subject_request_verdict(must_comply, art17_1_a, none, [], [cite(eu_reg_2016_679_art_17_1), cite(eu_reg_2016_679_art_17_1_a)])).
