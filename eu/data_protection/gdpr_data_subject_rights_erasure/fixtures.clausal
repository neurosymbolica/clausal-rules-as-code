gdpr_data_subject_rights_erasure_subject(needs_legal_review_erasure_law_unattested).
gdpr_data_subject_rights_erasure_subject(must_comply_unlawful_processing).
gdpr_data_subject_rights_erasure_subject(needs_legal_review_unlawful_processing_unsure).
gdpr_data_subject_rights_erasure_subject(need_not_comply_freedom_of_expression).
gdpr_data_subject_rights_erasure_subject(must_comply_freedom_of_expression_ruled_out).
gdpr_data_subject_rights_erasure_subject(need_not_comply_public_task_with_basis_open).
gdpr_data_subject_rights_erasure_subject(indeterminate_every_missing_key).
gdpr_data_subject_rights_erasure_subject(need_not_comply_processing_required_by_law).
gdpr_data_subject_rights_erasure_subject(must_comply_processing_obligation_attested_false).
gdpr_data_subject_rights_erasure_subject(need_not_comply_archiving_impairment).
gdpr_data_subject_rights_erasure_subject(must_comply_archiving_without_impairment).
gdpr_data_subject_rights_erasure_subject(need_not_comply_legal_claims).
gdpr_data_subject_rights_erasure_subject(needs_legal_review_legal_claims_unsure).
gdpr_data_subject_rights_erasure_subject(need_not_comply_manifestly_unfounded_with_fee).
gdpr_data_subject_rights_erasure_subject(must_comply_request_not_manifestly_unfounded).
gdpr_data_subject_rights_erasure_subject(need_not_comply_unable_to_identify).
gdpr_data_subject_rights_erasure_subject(must_comply_controller_able_to_identify).
gdpr_data_subject_rights_erasure_subject(need_not_comply_legislative_restriction_attested).
gdpr_data_subject_rights_erasure_subject(must_comply_legislative_restriction_attested_false).
gdpr_data_subject_rights_erasure_subject(suspended_identity_not_confirmed).
gdpr_data_subject_rights_erasure_subject(must_comply_identity_confirmed).
gdpr_data_subject_rights_erasure_subject(indeterminate_identity_confirmed_absent).
gdpr_data_subject_rights_erasure_subject(input_problems_duplicate_and_unknown).
gdpr_data_subject_rights_erasure_subject(input_problems_wrong_boolean_value).
gdpr_data_subject_rights_erasure_subject(must_comply_with_valid_boolean).

