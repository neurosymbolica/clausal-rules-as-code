% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_queries.clausal -- PROPERTY tests for the query layer: one test per
% predicate registered in manifest.yaml query_interface (#2 status, #7
% checklist, #16 what-if) and the schema and input-check re-export.
% Run: python -m clausal.testing eu/data_protection/gdpr_complaints_and_judicial_remedies/tests/test_queries.clausal
% =====================================================================
:- module(test_queries, []).
:- use_module(eu/data_protection/gdpr_complaints_and_judicial_remedies/queries, [
    gdpr_complaints_and_judicial_remedies_profile_keys/1,
    gdpr_complaints_and_judicial_remedies_input_problems/2,
    gdpr_complaints_and_judicial_remedies_what_if/4
]).
:- use_module(eu/data_protection/gdpr_complaints_and_judicial_remedies/gdpr_complaints_and_judicial_remedies, [
    gdpr_complaints_and_judicial_remedies_status/2,
    gdpr_complaints_and_judicial_remedies_checklist/2
]).
:- use_module(eu/data_protection/gdpr_complaints_and_judicial_remedies/fixtures, [gdpr_complaints_and_judicial_remedies_profile_for/2]).

test(profile_keys_are_the_contract_keys) :-
    gdpr_complaints_and_judicial_remedies_profile_keys(ProfileKeys),
    ProfileKeys == [is_data_subject, data_subject_considers_processing_infringes_regulation, decision_is_legally_binding, decision_concerns_the_caller, complaint_lodged_under_article_77, authority_competent_under_articles_55_and_56, authority_handled_the_complaint, three_months_from_the_complaint_have_passed, authority_informed_on_progress_or_outcome, data_subject_considers_rights_infringed_by_processing, defendant_is_member_state_public_authority_acting_in_public_powers].

test(input_problems_through_the_query_layer) :-
    gdpr_complaints_and_judicial_remedies_profile_for(malformed_duplicate_and_unknown, Profile),
    gdpr_complaints_and_judicial_remedies_input_problems(Profile, Problems),
    Problems == [duplicate_key(is_data_subject), wrong_type(decision_concerns_the_caller), unknown_key(colour)].

test(eligibility_status_gives_one_answer_per_query) :-
    gdpr_complaints_and_judicial_remedies_profile_for(full_positive, Profile),
    findall(Status, gdpr_complaints_and_judicial_remedies_status(Profile, Status), Statuses),
    Statuses == [answer(complaint_right, complaint_right_exists), answer(authority_decision_remedy_right, decision_remedy_right_exists), answer(authority_inaction_remedy_right, inaction_remedy_right_exists), answer(controller_processor_remedy_right, judicial_remedy_right_exists), answer(controller_processor_forum, forum_establishment_or_habitual_residence_state)].

test(justification_checklist_cites_each_provision) :-
    gdpr_complaints_and_judicial_remedies_profile_for(empty_profile, Profile),
    gdpr_complaints_and_judicial_remedies_checklist(Profile, ChecklistItems),
    ChecklistItems == [item(complaint_right, indeterminate([is_data_subject]), cite(eu_reg_2016_679_art_77_1)), item(authority_decision_remedy_right, indeterminate([decision_is_legally_binding]), cite(eu_reg_2016_679_art_78_1)), item(authority_inaction_remedy_right, indeterminate([is_data_subject]), cite(eu_reg_2016_679_art_78_2)), item(controller_processor_remedy_right, indeterminate([is_data_subject]), cite(eu_reg_2016_679_art_79_1)), item(controller_processor_forum, indeterminate([defendant_is_member_state_public_authority_acting_in_public_powers]), cite(eu_reg_2016_679_art_79_2))].

test(what_if_flips_the_forum) :-
    gdpr_complaints_and_judicial_remedies_profile_for(full_positive, Profile),
    gdpr_complaints_and_judicial_remedies_what_if(Profile, defendant_is_member_state_public_authority_acting_in_public_powers, true, answer(controller_processor_forum, Result)),
    Result == forum_establishment_state_only.

test(what_if_supplies_the_missing_competence) :-
    gdpr_complaints_and_judicial_remedies_profile_for(inaction_competence_absent, Profile),
    gdpr_complaints_and_judicial_remedies_what_if(Profile, authority_competent_under_articles_55_and_56, attested(true, attestation(host, at, reason, none)), answer(authority_inaction_remedy_right, Result)),
    Result == inaction_remedy_right_exists.

test(what_if_resolves_the_unsure_judgement) :-
    gdpr_complaints_and_judicial_remedies_profile_for(decision_unsure_binding, Profile),
    gdpr_complaints_and_judicial_remedies_what_if(Profile, decision_is_legally_binding, true, answer(authority_decision_remedy_right, Result)),
    Result == decision_remedy_right_exists.

test(what_if_with_a_wrong_value_gives_input_problems) :-
    gdpr_complaints_and_judicial_remedies_profile_for(full_positive, Profile),
    gdpr_complaints_and_judicial_remedies_what_if(Profile, is_data_subject, unsure, answer(complaint_right, Result)),
    Result == input_problems([wrong_type(is_data_subject)]).

test(what_if_does_not_keep_the_old_answer, fail) :-
    gdpr_complaints_and_judicial_remedies_profile_for(full_positive, Profile),
    gdpr_complaints_and_judicial_remedies_what_if(Profile, is_data_subject, false, answer(complaint_right, complaint_right_exists)).

:- end_module(test_queries).
