% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/data_protection/gdpr_complaints_and_judicial_remedies.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% The verbatim pair is OMITTED while the key's entry in
% citations-sources.yaml is `status: unverified`; `status: verified`
% carries a non-empty ref AND a verbatim that is an exact substring of
% the pinned unit text.
%
% Pinned source: Regulation (EU) 2016/679 (GDPR), unit text of
% 02016R0679-20160504 (the consolidated text of 2016-05-04, fmx4 cut by
% tools/pin_statute.py, fetched 2026-11-12).
%
% Keys (canonical lexicon scheme, _lexicon/citations.yaml):
%   eu_reg_2016_679_art_77_1  Art 77(1)  parag_077.001  complaint_right/3
%   eu_reg_2016_679_art_78_1  Art 78(1)  parag_078.001  authority_decision_remedy_right/3
%   eu_reg_2016_679_art_78_2  Art 78(2)  parag_078.002  authority_inaction_remedy_right/4
%   eu_reg_2016_679_art_79_1  Art 79(1)  parag_079.001  controller_processor_remedy_right/3
%   eu_reg_2016_679_art_79_2  Art 79(2)  parag_079.002  controller_processor_forum/3
%   competence_statement      the cross-reference TARGET of the outside fact
%                             authority_competent_under_articles_55_and_56
%                             (GDPR Arts 55 and 56, not pinned; the atom is
%                             fixed by the order's outside_facts row).
% Deferred, never cited in a result: parag_077.002, parag_078.003,
% parag_078.004, art_077, art_078, art_079.
%
% PROVENANCE: every operative clause opens its body with implements(Key),
% Key one of the atoms recorded here.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

citation(eu_reg_2016_679_art_77_1, [label-'Regulation (EU) 2016/679 (GDPR) Art 77(1), right to lodge a complaint with a supervisory authority', ref-'02016R0679-20160504#parag_077.001; https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'Without prejudice to any other administrative or judicial remedy, every data subject shall have the right to lodge a complaint with a supervisory authority, in particular in the Member State of his or her habitual residence, place of work or place of the alleged infringement if the data subject considers that the processing of personal data relating to him or her infringes this Regulation.']).

citation(eu_reg_2016_679_art_78_1, [label-'Regulation (EU) 2016/679 (GDPR) Art 78(1), right to an effective judicial remedy against a legally binding decision of a supervisory authority', ref-'02016R0679-20160504#parag_078.001; https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'Without prejudice to any other administrative or non-judicial remedy, each natural or legal person shall have the right to an effective judicial remedy against a legally binding decision of a supervisory authority concerning them.']).

citation(eu_reg_2016_679_art_78_2, [label-'Regulation (EU) 2016/679 (GDPR) Art 78(2), right to an effective judicial remedy where the competent supervisory authority does not handle a complaint or does not inform within three months', ref-'02016R0679-20160504#parag_078.002; https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'Without prejudice to any other administrative or non-judicial remedy, each data subject shall have the right to a an effective judicial remedy where the supervisory authority which is competent pursuant to Articles 55 and 56 does not handle a complaint or does not inform the data subject within three months on the progress or outcome of the complaint lodged pursuant to Article 77.']).

citation(eu_reg_2016_679_art_79_1, [label-'Regulation (EU) 2016/679 (GDPR) Art 79(1), right to an effective judicial remedy against a controller or processor', ref-'02016R0679-20160504#parag_079.001; https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'Without prejudice to any available administrative or non-judicial remedy, including the right to lodge a complaint with a supervisory authority pursuant to Article 77, each data subject shall have the right to an effective judicial remedy where he or she considers that his or her rights under this Regulation have been infringed as a result of the processing of his or her personal data in non-compliance with this Regulation.']).

citation(eu_reg_2016_679_art_79_2, [label-'Regulation (EU) 2016/679 (GDPR) Art 79(2), courts of the Member State of the establishment and alternative courts of the habitual residence of the data subject, public-powers exception', ref-'02016R0679-20160504#parag_079.002; https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'Proceedings against a controller or a processor shall be brought before the courts of the Member State where the controller or processor has an establishment. Alternatively, such proceedings may be brought before the courts of the Member State where the data subject has his or her habitual residence, unless the controller or processor is a public authority of a Member State acting in the exercise of its public powers.']).

citation(competence_statement, [label-'Regulation (EU) 2016/679 (GDPR) Arts 55 and 56, competence of the supervisory authority (outside fact authority_competent_under_articles_55_and_56; not pinned, never decided by this order)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504']).

% implements(Key): the provenance marker; it succeeds for every recorded key
% and fails for a key this module does not record.
implements(Key) :-
    citation(Key, _).

test(every_query_citation_is_recorded) :-
    implements(eu_reg_2016_679_art_77_1),
    implements(eu_reg_2016_679_art_78_1),
    implements(eu_reg_2016_679_art_78_2),
    implements(eu_reg_2016_679_art_79_1),
    implements(eu_reg_2016_679_art_79_2),
    implements(competence_statement).
test(an_unrecorded_key_is_not_implemented, fail) :-
    implements(eu_reg_2016_679_art_77_2).

:- end_module(citations).
