]).

% ---- Convenience wrapper ---------------------------------------------
gdpr_complaints_and_judicial_remedies_assess(Subject, Result) :-
    gdpr_complaints_and_judicial_remedies_profile_for(Subject, Profile),
    decide_gdpr_complaints_and_judicial_remedies(Profile, Result).

:- end_module(fixtures).
