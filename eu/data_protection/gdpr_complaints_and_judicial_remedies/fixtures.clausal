% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% fixtures.clausal -- representative profiles for eu/data_protection/gdpr_complaints_and_judicial_remedies.
% A TOP-LAYER consumer: it imports the slice's PUBLIC predicate it calls.
%
% A profile is an ATTRIBUTE LIST [attribute(Key, Value), ...] (the order's typed
% input contract). No key is numeric or a date: the routes turn on crisp facts,
% tri-state judgements and one attested outside fact, so each POSITIVE case is
% paired with a ONE-KEY near-miss control that flips its result.
%
% Subjects and the route each exercises (expected results are asserted in
% tests/test_public_interface.clausal):
%   full_positive                                  every right exists; forum both States
%   not_a_data_subject                             near-miss: is_data_subject false
%   complaint_no_consideration                     near-miss Art 77(1): consideration false
%   decision_not_binding                           near-miss Art 78(1): binding false
%   decision_unsure_binding                        Art 78(1) open_textured referral
%   decision_unsure_and_missing                    Art 78(1) unsure + missing: indeterminate
%   inaction_competence_absent                     Art 78(2) cross_reference_unresolved referral
%   inaction_competence_false                      Art 78(2) attested not competent
%   inaction_handled_and_informed                  Art 78(2) failure settled absent
%   inaction_three_months_uninformed_handled_absent  Art 78(2) failure holds, handled not needed
%   inaction_three_months_informed_handled_absent  near-miss: informed true, handled now needed
%   inaction_handled_three_months_absent           Art 78(2) indeterminate on the three months
%   remedy_no_consideration                        near-miss Art 79(1): consideration false
%   forum_public_authority                         near-miss Art 79(2): establishment State only
%   empty_profile                                  every query names its first key
%   malformed_duplicate_and_unknown                input problems
%   malformed_unbound_attestation                  input problem on the outside fact
% =====================================================================

:- module(fixtures, [
    gdpr_complaints_and_judicial_remedies_subject/1,
    gdpr_complaints_and_judicial_remedies_profile_for/2,
    gdpr_complaints_and_judicial_remedies_assess/2
]).

:- use_module(eu/data_protection/gdpr_complaints_and_judicial_remedies/gdpr_complaints_and_judicial_remedies, [decide_gdpr_complaints_and_judicial_remedies/2]).

% ---- Subject registry ------------------------------------------------
gdpr_complaints_and_judicial_remedies_subject(full_positive).
gdpr_complaints_and_judicial_remedies_subject(not_a_data_subject).
gdpr_complaints_and_judicial_remedies_subject(complaint_no_consideration).
gdpr_complaints_and_judicial_remedies_subject(decision_not_binding).
gdpr_complaints_and_judicial_remedies_subject(decision_unsure_binding).
gdpr_complaints_and_judicial_remedies_subject(decision_unsure_and_missing).
gdpr_complaints_and_judicial_remedies_subject(inaction_competence_absent).
gdpr_complaints_and_judicial_remedies_subject(inaction_competence_false).
gdpr_complaints_and_judicial_remedies_subject(inaction_handled_and_informed).
gdpr_complaints_and_judicial_remedies_subject(inaction_three_months_uninformed_handled_absent).
gdpr_complaints_and_judicial_remedies_subject(inaction_three_months_informed_handled_absent).
gdpr_complaints_and_judicial_remedies_subject(inaction_handled_three_months_absent).
gdpr_complaints_and_judicial_remedies_subject(remedy_no_consideration).
gdpr_complaints_and_judicial_remedies_subject(forum_public_authority).
gdpr_complaints_and_judicial_remedies_subject(empty_profile).
gdpr_complaints_and_judicial_remedies_subject(malformed_duplicate_and_unknown).
gdpr_complaints_and_judicial_remedies_subject(malformed_unbound_attestation).

% ---- Profiles --------------------------------------------------------
gdpr_complaints_and_judicial_remedies_profile_for(full_positive, [
    attribute(is_data_subject, true),
    attribute(data_subject_considers_processing_infringes_regulation, true),
    attribute(decision_is_legally_binding, true),
    attribute(decision_concerns_the_caller, true),
    attribute(complaint_lodged_under_article_77, true),
    attribute(authority_competent_under_articles_55_and_56, attested(true, attestation(host_registry, '2026-11-12T09:00:00Z', competence_confirmed_by_host, none))),
    attribute(authority_handled_the_complaint, false),
    attribute(three_months_from_the_complaint_have_passed, false),
    attribute(authority_informed_on_progress_or_outcome, false),
    attribute(data_subject_considers_rights_infringed_by_processing, true),
    attribute(defendant_is_member_state_public_authority_acting_in_public_powers, false)
]).

