% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_robustness.clausal -- ROBUSTNESS of the input check gdpr_chapter_v_extras_input_problems/2 for a
% PROFILE that is an attribute list [attribute(Key, Value), ...]: an empty list, a
% value that is not a list, an unknown key and a value outside its type each get exactly
% one answer. Written by the scaffold from the order's typed input contract
% (input_contract.types.profile: attribute_list), not by the producer;
% do not edit or delete.
% Run: python -m clausal.testing eu/data_protection/gdpr_chapter_v_extras/tests/test_robustness.clausal
% =====================================================================
:- module(test_robustness, []).
:- use_module(eu/data_protection/gdpr_chapter_v_extras/queries, [gdpr_chapter_v_extras_input_problems/2]).

test(an_empty_attribute_list_gets_exactly_one_answer) :-
    findall(Problems, gdpr_chapter_v_extras_input_problems([], Problems), Answers),
    Answers == [[]].

test(a_profile_that_is_not_a_list_gets_one_non_empty_answer) :-
    findall(Problems, gdpr_chapter_v_extras_input_problems(not_a_profile, Problems), Answers),
    Answers = [[_|_]].

test(an_unknown_key_is_named) :-
    findall(Problems, gdpr_chapter_v_extras_input_problems([attribute(not_a_key_of_the_contract, controller)], Problems), Answers),
    Answers = [Problems],
    memberchk(unknown_key(not_a_key_of_the_contract), Problems).

test(a_value_outside_the_type_of_transfer_relies_on_article_49_1_second_subparagraph_is_named) :-
    findall(Problems, gdpr_chapter_v_extras_input_problems([attribute(transfer_relies_on_article_49_1_second_subparagraph, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(transfer_relies_on_article_49_1_second_subparagraph), Problems).

test(a_value_outside_the_type_of_party_role_is_named) :-
    findall(Problems, gdpr_chapter_v_extras_input_problems([attribute(party_role, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(party_role), Problems).

test(a_value_outside_the_type_of_supervisory_authority_informed_of_transfer_is_named) :-
    findall(Problems, gdpr_chapter_v_extras_input_problems([attribute(supervisory_authority_informed_of_transfer, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(supervisory_authority_informed_of_transfer), Problems).

:- end_module(test_robustness).
