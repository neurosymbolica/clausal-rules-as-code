% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/data_protection/gdpr_chapter_v_extras.
%
% Source of record: Regulation (EU) 2016/679 (GDPR), consolidated text
% 02016R0679-20160504 (in force from 2016-05-04), EUR-Lex.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% The verbatim pair is OMITTED while the key's entry in
% citations-sources.yaml is `status: unverified`.
%
% Load-bearing keys (returned in results; canonical lexicon spelling):
%   eu_reg_2016_679_art_44                    Art 44, first sentence
%   eu_reg_2016_679_art_48                    Art 48
%   eu_reg_2016_679_art_49_1_second_subpara   Art 49(1), second subparagraph
%   eu_reg_2016_679_art_49_6                  Art 49(6)
% Reading keys (recorded for reading (6) and Q5; deferred, NEVER returned in
% a result):
%   eu_reg_2016_679_art_30_1_e, eu_reg_2016_679_art_30_2_c, eu_reg_2016_679_art_30_5
% Referral target keys (appear only as cite(TARGET) inside THE ABSENT
% REFERRAL; each names the outside statement the referral asks for, not a
% provision):
%   second_subparagraph_transfer_statement, foreign_judgment_requires_transfer_statement,
%   international_agreement_basis_statement, onward_transfer_statement,
%   onward_transfer_chapter_v_basis_statement
%
% PROVENANCE: every operative clause opens its body with implements(Key),
% Key a key recorded here.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

% ---- load-bearing provisions -------------------------------------------

citation(eu_reg_2016_679_art_44, [label-'Regulation (EU) 2016/679 (GDPR) Art 44, first sentence (general principle for transfers, including onward transfers)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'including for onward transfers of personal data from the third country or an international organisation to another third country or to another international organisation']).

citation(eu_reg_2016_679_art_48, [label-'Regulation (EU) 2016/679 (GDPR) Art 48 (transfers or disclosures not authorised by Union law)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'may only be recognised or enforceable in any manner if based on an international agreement, such as a mutual legal assistance treaty, in force between the requesting third country and the Union or a Member State']).

citation(eu_reg_2016_679_art_49_1_second_subpara, [label-'Regulation (EU) 2016/679 (GDPR) Art 49(1), second subparagraph, second and third sentences (the controller informs the supervisory authority and the data subject)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'The controller shall inform the supervisory authority of the transfer.']).

citation(eu_reg_2016_679_art_49_6, [label-'Regulation (EU) 2016/679 (GDPR) Art 49(6) (document the assessment and the suitable safeguards in the Art 30 records)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'The controller or processor shall document the assessment as well as the suitable safeguards referred to in the second subparagraph of paragraph 1 of this Article in the records referred to in Article 30.']).

% ---- reading provisions (deferred: no limb, never returned) --------------

citation(eu_reg_2016_679_art_30_1_e, [label-'Regulation (EU) 2016/679 (GDPR) Art 30(1), opening words and point (e) (controller record: documentation of suitable safeguards for Art 49(1) second-subparagraph transfers)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'in the case of transfers referred to in the second subparagraph of Article 49(1), the documentation of suitable safeguards']).

citation(eu_reg_2016_679_art_30_2_c, [label-'Regulation (EU) 2016/679 (GDPR) Art 30(2), opening words and point (c) (processor record: documentation of suitable safeguards for Art 49(1) second-subparagraph transfers)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'in the case of transfers referred to in the second subparagraph of Article 49(1), the documentation of suitable safeguards']).

citation(eu_reg_2016_679_art_30_5, [label-'Regulation (EU) 2016/679 (GDPR) Art 30(5) (record duties and enterprises employing fewer than 250 persons)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'The obligations referred to in paragraphs 1 and 2 shall not apply to an enterprise or an organisation employing fewer than 250 persons']).

% ---- referral targets (outside statements, not provisions) ---------------

citation(second_subparagraph_transfer_statement, [label-'Outside statement: this transfer takes place under Regulation (EU) 2016/679 Art 49(1), second subparagraph (determined by gdpr-chapter-v-transfers or stated by a human)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504']).

citation(foreign_judgment_requires_transfer_statement, [label-'Outside statement: a judgment or decision of a third country requires this transfer or disclosure (Regulation (EU) 2016/679 Art 48)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504']).

citation(international_agreement_basis_statement, [label-'Outside statement: that judgment or decision is based on an international agreement in force between the requesting third country and the Union or a Member State (Regulation (EU) 2016/679 Art 48)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504']).

citation(onward_transfer_statement, [label-'Outside statement: this transfer is an onward transfer from a third country or international organisation to another (Regulation (EU) 2016/679 Art 44)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504']).

citation(onward_transfer_chapter_v_basis_statement, [label-'Outside statement: the onward transfer, assessed on its own facts by gdpr-chapter-v-transfers, may take place under Chapter V (Regulation (EU) 2016/679 Art 44)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504']).

% ---- provenance marker ----------------------------------------------------
% implements(Key): succeeds for every recorded key, fails for any other.
implements(Key) :-
    citation(Key, _).

:- end_module(citations).
