% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% kernel.clausal -- the SHARED FLOOR for eu/data_protection/gdpr_chapter_v_extras (deontic family).
% DAG root of the determination-slices layout:
%   kernel -> citations -> parameters -> gdpr_chapter_v_extras -> queries -> fixtures -> facade
%
% Source (the law the slice formalises; pinned unit text of 02016R0679-20160504,
% Regulation (EU) 2016/679 (GDPR), consolidated text in force from 2016-05-04):
%   - Art 44, first sentence (onward transfers)          -> onward_transfer_condition/4
%   - Art 48 (judgments and decisions of third countries) -> foreign_judgment_or_decision_recognition/4
%   - Art 49(1), second subparagraph, second and third
%     sentences (the controller's duties to inform)       -> second_subparagraph_duty/5
%   - Art 49(6) (document the assessment and safeguards,
%     read with Art 30(1)(e), Art 30(2)(c), Art 30(5))     -> second_subparagraph_duty/5
% Drafter's reading, not a lawyer's.
%
% WHAT LIVES HERE. Only the predicates that two or more files CALL. This
% order has ONE determination slice (gdpr_chapter_v_extras.clausal), so no
% domain predicate is shared: the only export is the scaffold's input check
% gdpr_chapter_v_extras_input_problems/2, written from the order's typed
% input contract, which the slice and queries.clausal import by full path:
%   :- use_module(eu/data_protection/gdpr_chapter_v_extras/kernel, [gdpr_chapter_v_extras_input_problems/2]).
% The absent-referral constructor, the key tables and the duty tables are
% single-caller and stay in the slice.
%
% Atoms and data terms need NO declaration and NO import. The block below
% only RECORDS the result terms so every file spells them alike.
%
% RESULT TERMS (the called contract; every query yields exactly ONE solution)
%   second_subparagraph_duty(Profile, Duty, Result, Basis, Citations)
%     Duty      inform_supervisory_authority | inform_data_subject |
%               document_assessment_and_safeguards (an input argument)
%     Result    no_second_subparagraph_transfer | not_a_processor_duty |
%               duty_met | duty_not_met | a status compound (below)
%     Basis     [outside_fact(transfer_relies_on_article_49_1_second_subparagraph, Attested)]
%               for no_second_subparagraph_transfer, duty_met, duty_not_met; [] otherwise
%     Citations [cite(eu_reg_2016_679_art_49_1_second_subpara)] for the duties to
%               inform (and not_a_processor_duty), [cite(eu_reg_2016_679_art_49_6)]
%               for document_assessment_and_safeguards; [] for a status compound
%   foreign_judgment_or_decision_recognition(Profile, Result, Basis, Citations)
%     Result    article_48_not_engaged | not_barred_by_article_48 |
%               not_recognisable_or_enforceable | a status compound
%     Basis     [outside_fact(third_country_judgment_or_decision_requires_transfer, A)]
%               for article_48_not_engaged; that item followed by
%               outside_fact(international_agreement_basis_for_judgment_or_decision, A2)
%               for the two others; [] otherwise
%     Citations [cite(eu_reg_2016_679_art_48)] for a final answer, [] otherwise
%   onward_transfer_condition(Profile, Result, Basis, Citations)
%     Result    not_an_onward_transfer | onward_transfer_may_take_place |
%               onward_transfer_may_not_take_place | a status compound
%     Basis     [outside_fact(transfer_is_onward_transfer, A)] for not_an_onward_transfer;
%               that item followed by outside_fact(onward_transfer_has_chapter_v_basis, A2)
%               for the two others; [] otherwise
%     Citations [cite(eu_reg_2016_679_art_44)] for a final answer, [] otherwise
%   Status compounds (never written bare), each with Basis [] and Citations []:
%     input_problems(Problems)   Problems a list of duplicate_key(Key),
%                                wrong_type(Key) (Key may be profile or duty),
%                                unknown_key(Key)
%     indeterminate([Key])       one bare crisp or enumeration key, never an outside fact
%     needs_legal_review(cross_reference_unresolved(cite(Citation), cite(Target)),
%                        [resolution(cite(Target), not_attempted),
%                         inputs_relied_on([Key-absent])])
%   Attested is the outside fact exactly as supplied:
%     attested(true | false, attestation(By, At, Reason, Evidence)),
%     Evidence none | url(Url, RetrievedAt) | document(UploadId, Sha256).
%   Scaffold facade verdict: gdpr_chapter_v_extras_verdict(Status, Citations),
%     Status the delegated query's Result, Citations its Citations.
%
% Spell every result and verdict atom exactly as REQUIRED PUBLIC
% PREDICATES and the order pin it: an atom spelled differently is a
% DIFFERENT atom, and nothing will warn you.
% =====================================================================

:- module(kernel, [gdpr_chapter_v_extras_input_problems/2]).

:- use_module(library(reif), [memberd_t/3]).

% ---- input checks: the problems a profile has, if any -----------
% gdpr_chapter_v_extras_input_problems(Profile, Problems): Problems = [] means the profile can be
% judged. Written from the order's typed input contract
% (input_contract.types.profile: attribute_list).
% Each public query calls this check first: it gives its normal answer only when
% Problems = [], and when Problems is not [] it gives the answer the order states for
% a profile with input problems.
% It gives exactly one answer for every Profile, and the answer is ground except for a
% Key named as given:
% - a Profile that is not an attribute list [attribute(Key, Value), ...] gives [wrong_type(profile)]:
%   an unbound Profile, a partial list, a list holding an unbound item or an item that is
%   not attribute(_, _);
% - a Key that is not an atom (a number, a string, a compound term, an unbound variable)
%   is a key outside the contract: unknown_key(Key), Key as given;
% - otherwise, for each contract key in the contract's key order, duplicate_key(Key) when
%   the key occurs more than once in Profile (whatever its values: none of them is read,
%   so it is never also wrong_type(Key)), else wrong_type(Key) when its one value is
%   outside its type; then unknown_key(Key) for each key outside the contract, in the
%   order of its first occurrence in Profile. Each key is named once. An absent key is
%   not a problem.
% An outside-fact value with an unbound part (an attestation argument that is, or
% holds, an unbound variable) is outside its type: wrong_type(Key).
% Every step is complementary clauses: exactly one clause holds for each input.
gdpr_chapter_v_extras_input_problems(Profile, Problems) :-
    attribute_list_t(Profile, IsAttributeList),
    profile_problems(IsAttributeList, Profile, Problems).

profile_problems(false, _, [wrong_type(profile)]).
profile_problems(true, Profile, Problems) :-
    Keys = [transfer_relies_on_article_49_1_second_subparagraph, party_role, supervisory_authority_informed_of_transfer, data_subject_informed_of_transfer, data_subject_informed_of_compelling_legitimate_interests, assessment_documented_in_records, suitable_safeguards_documented_in_records, third_country_judgment_or_decision_requires_transfer, international_agreement_basis_for_judgment_or_decision, transfer_is_onward_transfer, onward_transfer_has_chapter_v_basis],
    unknown_keys(Profile, Keys, UnknownKeyProblems),
    key_problems(Keys, Profile, UnknownKeyProblems, Problems).

% The contract: each key and the type of its value.
key_type(transfer_relies_on_article_49_1_second_subparagraph, outside_fact).
key_type(party_role, party_role_atom).
key_type(supervisory_authority_informed_of_transfer, boolean).
key_type(data_subject_informed_of_transfer, boolean).
key_type(data_subject_informed_of_compelling_legitimate_interests, boolean).
key_type(assessment_documented_in_records, boolean).
key_type(suitable_safeguards_documented_in_records, boolean).
key_type(third_country_judgment_or_decision_requires_transfer, outside_fact).
key_type(international_agreement_basis_for_judgment_or_decision, outside_fact).
key_type(transfer_is_onward_transfer, outside_fact).
key_type(onward_transfer_has_chapter_v_basis, outside_fact).

% attribute_list_t(Term, T): T is true when Term is a list of attribute(Key, Value)
% items, whatever each Key is; false for anything else, an unbound Term or item included.
attribute_list_t(Term, false) :-
    var(Term).
attribute_list_t(Term, true) :-
    Term == [].
attribute_list_t(Term, T) :-
    nonvar(Term),
    Term = [Element|Elements],
    attribute_t(Element, ElementIsAttribute),
    attribute_list_t(Elements, ElementsAreAttributes),
    truth_and(ElementIsAttribute, ElementsAreAttributes, T).
attribute_list_t(Term, false) :-
    nonvar(Term),
    Term \== [],
    Term \= [_|_].

attribute_t(Element, false) :-
    var(Element).
attribute_t(Element, true) :-
    nonvar(Element),
    Element = attribute(_, _).
attribute_t(Element, false) :-
    nonvar(Element),
    Element \= attribute(_, _).

% Unknown keys, in profile order, each once: Known grows by each key named. A key is
% known when it is identical (==) to one in Known, so an unbound Key is never bound:
% the same variable twice is one unknown key, two different variables are two.
unknown_keys([], _, []).
unknown_keys([attribute(Key, _)|Elements], Known, Problems) :-
    known_t(Key, Known, IsKnown),
    name_unknown_key(IsKnown, Key, Known, Elements, Problems).

known_t(_, [], false).
known_t(Key, [Known|_], true) :-
    Known == Key.
known_t(Key, [Known|Knowns], T) :-
    Known \== Key,
    known_t(Key, Knowns, T).

name_unknown_key(true, _, Known, Elements, Problems) :-
    unknown_keys(Elements, Known, Problems).
name_unknown_key(false, Key, Known, Elements, [unknown_key(Key)|Problems]) :-
    unknown_keys(Elements, [Key|Known], Problems).

% Contract keys, in contract order: duplicate_key(Key) when the key occurs more than once
% (none of its values is read), else wrong_type(Key) when its one value is outside the
% key's type. An absent key has no value to check.
key_problems([], _, Problems, Problems).
key_problems([Key|Keys], Profile, LaterProblems, Problems) :-
    key_type(Key, Type),
    key_occurrences(Profile, Key, Occurrences),
    key_problems(Keys, Profile, LaterProblems, KeyProblems),
    name_key_problem(Occurrences, Key, Type, Profile, KeyProblems, Problems).

% key_occurrences(Elements, Key, Occurrences): none, one or many items give Key.
key_occurrences([], _, none).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey == Key,
    key_occurrences(Elements, Key, RestOccurrences),
    one_more_occurrence(RestOccurrences, Occurrences).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey \== Key,
    key_occurrences(Elements, Key, Occurrences).

one_more_occurrence(none, one).
one_more_occurrence(one, many).
one_more_occurrence(many, many).

name_key_problem(none, _, _, _, Problems, Problems).
name_key_problem(many, Key, _, _, Problems, [duplicate_key(Key)|Problems]).
name_key_problem(one, Key, Type, Profile, KeyProblems, Problems) :-
    values_in_type_t(Profile, Key, Type, InType),
    name_wrong_type(InType, Key, KeyProblems, Problems).

name_wrong_type(true, _, Problems, Problems).
name_wrong_type(false, Key, Problems, [wrong_type(Key)|Problems]).

% values_in_type_t(Elements, Key, Type, T): T is true when every value Elements gives Key is
% in Type (true when Elements gives Key none).
values_in_type_t([], _, _, true).
values_in_type_t([attribute(ElementKey, Value)|Elements], Key, Type, T) :-
    ElementKey == Key,
    value_in_type_t(Type, Value, ValueInType),
    values_in_type_t(Elements, Key, Type, RestInType),
    truth_and(ValueInType, RestInType, T).
values_in_type_t([attribute(ElementKey, _)|Elements], Key, Type, T) :-
    ElementKey \== Key,
    values_in_type_t(Elements, Key, Type, T).

% A value with an unbound part is outside every type; a ground one is checked.
value_in_type_t(Type, Value, T) :-
    term_variables(Value, Variables),
    ground_value_in_type_t(Variables, Type, Value, T).

ground_value_in_type_t([_|_], _, _, false).
ground_value_in_type_t([], Type, Value, T) :-
    in_type_t(Type, Value, T).

% in_type_t(Type, Value, T): one clause per type, for a ground Value.
in_type_t(outside_fact, Value, T) :-
    in_type_t(attested(boolean), Value, T).

in_type_t(party_role_atom, Value, T) :-
    in_type_t(enum([controller, processor]), Value, T).

in_type_t(boolean, Value, T) :-
    memberd_t(Value, [true, false], T).

in_type_t(enum(Values), Value, T) :-
    memberd_t(Value, Values, T).

in_type_t(attested(Type), Value, T) :-
    attested_t(Value, Type, T).

truth_and(true, T, T).
truth_and(false, _, false).

% attested_t(Value, Type, T): T is true when Value is
% attested(AttestedValue, attestation(By, At, Reason, Evidence)) with AttestedValue in Type.
% By, At, Reason and Evidence come from the host and are not checked (beyond the
% ground test above: none of them is, or holds, an unbound variable).
attested_t(attested(AttestedValue, Attestation), Type, T) :-
    attestation_t(Attestation, IsAttestation),
    attested_value_t(IsAttestation, Type, AttestedValue, T).
attested_t(Value, _, false) :-
    Value \= attested(_, _).

attestation_t(attestation(_, _, _, _), true).
attestation_t(Value, false) :-
    Value \= attestation(_, _, _, _).

attested_value_t(false, _, _, false).
attested_value_t(true, Type, AttestedValue, T) :-
    in_type_t(Type, AttestedValue, T).

:- end_module(kernel).
