% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% queries.clausal -- QUERY-COMBINATOR layer for eu/data_protection/gdpr_chapter_v_extras.
% A TOP-LAYER consumer: it imports the determination slice's PUBLIC
% predicates it calls, and nothing else.
%
% Source: Regulation (EU) 2016/679 (GDPR), consolidated text
% 02016R0679-20160504: Art 44 (first sentence), Art 48, Art 49(1) second
% subparagraph (second and third sentences) and Art 49(6). author's
% reading, not a lawyer's.
%
% Query types this domain serves, and where:
%   #13 compliance_check     -> second_subparagraph_duty/5,
%                               foreign_judgment_or_decision_recognition/4,
%                               onward_transfer_condition/4 (the slice; the
%                               package facade re-exports them)
%   #3  status_determination -> gdpr_chapter_v_extras_status/2 (the slice)
%   #16 what-if              -> gdpr_chapter_v_extras_what_if/4 (here)
%   schema                   -> gdpr_chapter_v_extras_profile_keys/1 (here)
%   input check              -> gdpr_chapter_v_extras_input_problems/2 (the
%                               kernel's check, re-exported here as written)
%
% The profile is an ATTRIBUTE LIST, not a dict, so the what-if replaces the
% attribute(Key, _) entries of the overridden key and adds the new one; the
% revised profile passes through the input check like any other. This
% layer decides nothing statutory, so it carries no implements/1 marker.
% Open-textured judgement is handed to the caller: this order has no
% judgement key, and every determination under law arrives attested.
%
% ROOT EXPORTS: the result atoms and the three DUTY argument atoms of the
% order are declared here as facts, so the package root resolves every
% name the scorer reads. The result constructors are data: they are
% exported and declared with constructors/1, and have no clauses.
% =====================================================================

:- module(queries, [
    gdpr_chapter_v_extras_profile_keys/1,
    gdpr_chapter_v_extras_input_problems/2,
    gdpr_chapter_v_extras_what_if/4,
    no_second_subparagraph_transfer/0,
    not_a_processor_duty/0,
    duty_met/0,
    duty_not_met/0,
    article_48_not_engaged/0,
    not_barred_by_article_48/0,
    not_recognisable_or_enforceable/0,
    not_an_onward_transfer/0,
    onward_transfer_may_take_place/0,
    onward_transfer_may_not_take_place/0,
    inform_supervisory_authority/0,
    inform_data_subject/0,
    document_assessment_and_safeguards/0,
    indeterminate/1,
    needs_legal_review/2,
    cross_reference_unresolved/2,
    resolution/2,
    inputs_relied_on/1,
    outside_fact/2,
    attested/2,
    attestation/4,
    url/2,
    document/2,
    input_problems/1,
    unknown_key/1,
    wrong_type/1,
    duplicate_key/1
]).

:- use_module(eu/data_protection/gdpr_chapter_v_extras/kernel, [gdpr_chapter_v_extras_input_problems/2]).
:- use_module(eu/data_protection/gdpr_chapter_v_extras/gdpr_chapter_v_extras, [gdpr_chapter_v_extras_status/2]).

% ---- result constructors (data, no clauses) ---------------------------
:- constructors([
    indeterminate(missing_keys),
    needs_legal_review(reason, context),
    cross_reference_unresolved(citation, target),
    resolution(target, outcome),
    inputs_relied_on(pairs),
    outside_fact(key, attested),
    attested(value, attestation),
    attestation(by, at, reason, evidence),
    url(url, retrieved_at),
    document(upload_id, sha256),
    input_problems(problems),
    unknown_key(key),
    wrong_type(key),
    duplicate_key(key)
]).

% schema of top-level profile keys: the keys of the order's typed input contract, in its order
gdpr_chapter_v_extras_profile_keys([transfer_relies_on_article_49_1_second_subparagraph, party_role, supervisory_authority_informed_of_transfer, data_subject_informed_of_transfer, data_subject_informed_of_compelling_legitimate_interests, assessment_documented_in_records, suitable_safeguards_documented_in_records, third_country_judgment_or_decision_requires_transfer, international_agreement_basis_for_judgment_or_decision, transfer_is_onward_transfer, onward_transfer_has_chapter_v_basis]).

% #16 what-if: re-evaluate the facade status with one key hypothetically
% overridden (every existing entry for the key is replaced by the new one).
gdpr_chapter_v_extras_what_if(Profile, OverriddenKey, NewValue, NewStatus) :-
    revised_profile(Profile, OverriddenKey, NewValue, RevisedProfile),
    gdpr_chapter_v_extras_status(RevisedProfile, NewStatus).

% revised_profile(Profile, Key, Value, Revised): plumbing, no provision.
revised_profile(Profile, OverriddenKey, NewValue, [attribute(OverriddenKey, NewValue)|KeptAttributes]) :-
    exclude(attribute_for_key(OverriddenKey), Profile, KeptAttributes).

attribute_for_key(OverriddenKey, Element) :-
    nonvar(Element),
    Element = attribute(ElementKey, _),
    ElementKey == OverriddenKey.

% ---- result atoms (the RESULT values of the three queries) ------------
no_second_subparagraph_transfer.
not_a_processor_duty.
duty_met.
duty_not_met.
article_48_not_engaged.
not_barred_by_article_48.
not_recognisable_or_enforceable.
not_an_onward_transfer.
onward_transfer_may_take_place.
onward_transfer_may_not_take_place.

% ---- argument atoms (the three DUTY inputs, never results) ------------
inform_supervisory_authority.
inform_data_subject.
document_assessment_and_safeguards.

test(the_schema_has_eleven_keys) :-
    gdpr_chapter_v_extras_profile_keys(Keys),
    length(Keys, 11).
test(a_what_if_on_an_onward_basis_clears_the_breach) :-
    Attestation = attestation(host_user, host_timestamp, fixture_statement, none),
    Profile = [attribute(transfer_is_onward_transfer, attested(true, Attestation)), attribute(onward_transfer_has_chapter_v_basis, attested(false, Attestation))],
    findall(Status, gdpr_chapter_v_extras_what_if(Profile, onward_transfer_has_chapter_v_basis, attested(true, Attestation), Status), Statuses),
    Statuses == [more_input_needed].
test(a_what_if_with_a_bare_boolean_outside_fact_is_an_input_problem) :-
    gdpr_chapter_v_extras_what_if([], transfer_is_onward_transfer, true, input_problems([wrong_type(transfer_is_onward_transfer)])).
test(a_what_if_with_a_bare_boolean_is_not_clear, fail) :-
    gdpr_chapter_v_extras_what_if([], transfer_is_onward_transfer, true, no_condition_breached).
test(the_result_atoms_are_declared) :-
    duty_met,
    not_a_processor_duty,
    onward_transfer_may_take_place,
    inform_data_subject.

:- end_module(queries).
