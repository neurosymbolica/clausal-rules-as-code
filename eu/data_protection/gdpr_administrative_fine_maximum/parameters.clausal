% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% parameters.clausal -- the PROVENANCE records of the sourced figures of
% eu/data_protection/gdpr_administrative_fine_maximum. PROVENANCE ONLY: this file references each figure by
% name and holds no value, and the logic modules do not import it.
%
% If parameters-sources.yaml is the COMMISSIONING REGISTER (its first line
% says so), then for EACH of its keys:
%   1. the VALUE is a fact in the determination slice that READS it
%      (that slice's .clausal file), never here;
%   2. this file holds its provenance record, a fact:
%        parameter_source(<key>, [label-'...', ref-'...', verbatim-'...']).
%      with the verbatim pair OMITTED while the yaml entry is
%      `status: unverified`.
%
% The commissioning register lists no key for this domain. The records
% below are the domain's own additions: the four statutory figures that
% the slice gdpr_administrative_fine_maximum.clausal declares, each once,
% with constant_value/2 under the same name, and reads by name:
%   lower_maximum_tier_fixed_amount_in_euro_cents   (1000000000 cents = EUR 10000000)
%   lower_maximum_tier_turnover_percentage          (2)
%   higher_maximum_tier_fixed_amount_in_euro_cents  (2000000000 cents = EUR 20000000)
%   higher_maximum_tier_turnover_percentage         (4)
% Source: Regulation (EU) 2016/679 (GDPR) Art 83(4), (5) and (6),
% consolidated text 02016R0679-20160504. The source states the fixed
% amounts in whole euros; the slice holds them in euro cents (x 100).
% =====================================================================

:- module(parameters, []).

parameter_source(lower_maximum_tier_fixed_amount_in_euro_cents, [
    label-'Regulation (EU) 2016/679 (GDPR) Art 83(4) fixed maximum of the lower tier, EUR 10000000 (held as 1000000000 euro cents)',
    ref-'02016R0679-20160504#parag_083.004',
    verbatim-'subject to administrative fines up to 10000000 EUR'
]).

parameter_source(lower_maximum_tier_turnover_percentage, [
    label-'Regulation (EU) 2016/679 (GDPR) Art 83(4) turnover percentage of the lower tier for an undertaking, 2 %',
    ref-'02016R0679-20160504#parag_083.004',
    verbatim-'in the case of an undertaking, up to 2 % of the total worldwide annual turnover of the preceding financial year'
]).

parameter_source(higher_maximum_tier_fixed_amount_in_euro_cents, [
    label-'Regulation (EU) 2016/679 (GDPR) Art 83(5) and (6) fixed maximum of the higher tier, EUR 20000000 (held as 2000000000 euro cents)',
    ref-'02016R0679-20160504#parag_083.005',
    verbatim-'subject to administrative fines up to 20000000 EUR'
]).

parameter_source(higher_maximum_tier_turnover_percentage, [
    label-'Regulation (EU) 2016/679 (GDPR) Art 83(5) and (6) turnover percentage of the higher tier for an undertaking, 4 %',
    ref-'02016R0679-20160504#parag_083.005',
    verbatim-'in the case of an undertaking, up to 4 % of the total worldwide annual turnover of the preceding financial year'
]).

:- end_module(parameters).
