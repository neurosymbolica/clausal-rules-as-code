% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/data_protection/gdpr_administrative_fine_maximum.
%
% Instrument: Regulation (EU) 2016/679 of the European Parliament and of
% the Council (General Data Protection Regulation), CELEX 32016R0679,
% consolidated text 02016R0679-20160504 (in force from 2016-05-04, with
% the 2018 corrigendum). Each verbatim below is an exact substring of the
% pinned unit text of that consolidated version.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% The verbatim pair is omitted while the key's entry in
% citations-sources.yaml is `status: unverified`. In a quoted atom an
% apostrophe is written twice ('').
%
% LOAD-BEARING keys (the ONLY citation atoms a result may return; the
% contract's citation vocabulary, spelled exactly as pinned):
%   eu_reg_2016_679_art_83_3, eu_reg_2016_679_art_83_4,
%   eu_reg_2016_679_art_83_4_a, eu_reg_2016_679_art_83_4_b,
%   eu_reg_2016_679_art_83_4_c, eu_reg_2016_679_art_83_5,
%   eu_reg_2016_679_art_83_5_a, eu_reg_2016_679_art_83_5_b,
%   eu_reg_2016_679_art_83_5_c, eu_reg_2016_679_art_83_5_d,
%   eu_reg_2016_679_art_83_5_e, eu_reg_2016_679_art_83_6.
% DOCUMENTARY keys (recorded for provenance markers only; NEVER returned in
% a result): eu_reg_2016_679_art_83_7 (deferred: public authorities),
%   eu_reg_2016_679_art_4_18 (definition of enterprise),
%   eu_reg_2016_679_art_4_19 (definition of group of undertakings), read
%   with the judgement input infringer_is_undertaking.
%
% lint: C6 -- the segments reg and art in the citation keys are fixed by the
% order's citation vocabulary (the corpus lexicon's canonical keys) and are
% not renamed.
%
% PROVENANCE: every operative clause opens its body with implements(Key),
% Key one of the keys recorded here. implements/1 succeeds for every
% recorded key and fails for any other spelling.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

% Art 83(3): several infringements in the same or linked processing
% operations -- the total is limited to the gravest infringement.
citation(eu_reg_2016_679_art_83_3, [
    label-'Regulation (EU) 2016/679 (GDPR) Art 83(3) several infringements, limit to the amount for the gravest infringement',
    ref-'02016R0679-20160504#parag_083.003',
    verbatim-'If a controller or processor intentionally or negligently, for the same or linked processing operations, infringes several provisions of this Regulation, the total amount of the administrative fine shall not exceed the amount specified for the gravest infringement.'
]).

% Art 83(4) chapeau: the lower maximum tier (EUR 10000000 or 2 %).
citation(eu_reg_2016_679_art_83_4, [
    label-'Regulation (EU) 2016/679 (GDPR) Art 83(4) chapeau, lower maximum: EUR 10000000 or, for an undertaking, 2 % of total worldwide annual turnover, whichever is higher',
    ref-'02016R0679-20160504#parag_083.004',
    verbatim-'be subject to administrative fines up to 10000000 EUR, or in the case of an undertaking, up to 2 % of the total worldwide annual turnover of the preceding financial year, whichever is higher'
]).

% Art 83(4)(a): controller and processor obligations, Arts 8, 11, 25-39, 42, 43.
citation(eu_reg_2016_679_art_83_4_a, [
    label-'Regulation (EU) 2016/679 (GDPR) Art 83(4)(a) obligations of the controller and the processor under Articles 8, 11, 25 to 39, 42 and 43',
    ref-'02016R0679-20160504#point_083.004_a',
    verbatim-'the obligations of the controller and the processor pursuant to Articles 8, 11, 25 to 39 and 42 and 43'
]).

% Art 83(4)(b): certification body obligations, Arts 42 and 43.
citation(eu_reg_2016_679_art_83_4_b, [
    label-'Regulation (EU) 2016/679 (GDPR) Art 83(4)(b) obligations of the certification body under Articles 42 and 43',
    ref-'02016R0679-20160504#point_083.004_b',
    verbatim-'the obligations of the certification body pursuant to Articles 42 and 43'
]).

% Art 83(4)(c): monitoring body obligations, Art 41(4).
citation(eu_reg_2016_679_art_83_4_c, [
    label-'Regulation (EU) 2016/679 (GDPR) Art 83(4)(c) obligations of the monitoring body under Article 41(4)',
    ref-'02016R0679-20160504#point_083.004_c',
    verbatim-'the obligations of the monitoring body pursuant to Article 41(4)'
]).

% Art 83(5) chapeau: the higher maximum tier (EUR 20000000 or 4 %).
citation(eu_reg_2016_679_art_83_5, [
    label-'Regulation (EU) 2016/679 (GDPR) Art 83(5) chapeau, higher maximum: EUR 20000000 or, for an undertaking, 4 % of total worldwide annual turnover, whichever is higher',
    ref-'02016R0679-20160504#parag_083.005',
    verbatim-'be subject to administrative fines up to 20000000 EUR, or in the case of an undertaking, up to 4 % of the total worldwide annual turnover of the preceding financial year, whichever is higher'
]).

% Art 83(5)(a): basic principles and consent, Arts 5, 6, 7 and 9.
citation(eu_reg_2016_679_art_83_5_a, [
    label-'Regulation (EU) 2016/679 (GDPR) Art 83(5)(a) basic principles for processing, including conditions for consent, under Articles 5, 6, 7 and 9',
    ref-'02016R0679-20160504#point_083.005_a',
    verbatim-'the basic principles for processing, including conditions for consent, pursuant to Articles 5, 6, 7 and 9'
]).

% Art 83(5)(b): data subjects'' rights, Arts 12 to 22.
citation(eu_reg_2016_679_art_83_5_b, [
    label-'Regulation (EU) 2016/679 (GDPR) Art 83(5)(b) data subjects'' rights under Articles 12 to 22',
    ref-'02016R0679-20160504#point_083.005_b',
    verbatim-'rights pursuant to Articles 12 to 22'
]).

% Art 83(5)(c): transfers to third countries or international organisations, Arts 44 to 49.
citation(eu_reg_2016_679_art_83_5_c, [
    label-'Regulation (EU) 2016/679 (GDPR) Art 83(5)(c) transfers of personal data to a third country or an international organisation under Articles 44 to 49',
    ref-'02016R0679-20160504#point_083.005_c',
    verbatim-'the transfers of personal data to a recipient in a third country or an international organisation pursuant to Articles 44 to 49'
]).

% Art 83(5)(d): obligations under Member State law adopted under Chapter IX.
citation(eu_reg_2016_679_art_83_5_d, [
    label-'Regulation (EU) 2016/679 (GDPR) Art 83(5)(d) obligations under Member State law adopted under Chapter IX',
    ref-'02016R0679-20160504#point_083.005_d',
    verbatim-'any obligations pursuant to Member State law adopted under Chapter IX'
]).

% Art 83(5)(e): non-compliance with a supervisory authority order (Art 58(2))
% or failure to provide access (Art 58(1)).
citation(eu_reg_2016_679_art_83_5_e, [
    label-'Regulation (EU) 2016/679 (GDPR) Art 83(5)(e) non-compliance with a supervisory authority order, limitation or suspension under Article 58(2), or failure to provide access under Article 58(1)',
    ref-'02016R0679-20160504#point_083.005_e',
    verbatim-'non-compliance with an order or a temporary or definitive limitation on processing or the suspension of data flows by the supervisory authority pursuant to Article 58(2) or failure to provide access in violation of Article 58(1)'
]).

% Art 83(6): non-compliance with an Art 58(2) order, higher maximum.
citation(eu_reg_2016_679_art_83_6, [
    label-'Regulation (EU) 2016/679 (GDPR) Art 83(6) non-compliance with an order of the supervisory authority under Article 58(2), higher maximum',
    ref-'02016R0679-20160504#parag_083.006',
    verbatim-'Non-compliance with an order by the supervisory authority as referred to in Article 58(2) shall, in accordance with paragraph 2 of this Article, be subject to administrative fines up to 20000000 EUR, or in the case of an undertaking, up to 4 % of the total worldwide annual turnover of the preceding financial year, whichever is higher.'
]).

% Art 83(7): public authorities -- DOCUMENTARY (deferred: art83_7_public_authorities).
citation(eu_reg_2016_679_art_83_7, [
    label-'Regulation (EU) 2016/679 (GDPR) Art 83(7) Member State rules on administrative fines for public authorities and bodies (deferred)',
    ref-'02016R0679-20160504#parag_083.007',
    verbatim-'each Member State may lay down the rules on whether and to what extent administrative fines may be imposed on public authorities and bodies established in that Member State'
]).

% Art 4(18): definition of enterprise -- DOCUMENTARY, read with infringer_is_undertaking.
citation(eu_reg_2016_679_art_4_18, [
    label-'Regulation (EU) 2016/679 (GDPR) Art 4(18) definition of enterprise',
    ref-'02016R0679-20160504#point_004_18',
    verbatim-'a natural or legal person engaged in an economic activity, irrespective of its legal form'
]).

% Art 4(19): definition of group of undertakings -- DOCUMENTARY, read with infringer_is_undertaking.
citation(eu_reg_2016_679_art_4_19, [
    label-'Regulation (EU) 2016/679 (GDPR) Art 4(19) definition of group of undertakings',
    ref-'02016R0679-20160504#point_004_19',
    verbatim-'a controlling undertaking and its controlled undertakings'
]).

% implements(Key): the provenance marker an operative clause opens with. It
% succeeds for every recorded key and fails for any other spelling.
implements(Key) :-
    citation(Key, _).

test(every_load_bearing_key_is_recorded) :-
    implements(eu_reg_2016_679_art_83_3),
    implements(eu_reg_2016_679_art_83_4),
    implements(eu_reg_2016_679_art_83_4_a),
    implements(eu_reg_2016_679_art_83_4_b),
    implements(eu_reg_2016_679_art_83_4_c),
    implements(eu_reg_2016_679_art_83_5),
    implements(eu_reg_2016_679_art_83_5_a),
    implements(eu_reg_2016_679_art_83_5_b),
    implements(eu_reg_2016_679_art_83_5_c),
    implements(eu_reg_2016_679_art_83_5_d),
    implements(eu_reg_2016_679_art_83_5_e),
    implements(eu_reg_2016_679_art_83_6).
test(documentary_keys_are_recorded) :-
    implements(eu_reg_2016_679_art_83_7),
    implements(eu_reg_2016_679_art_4_18),
    implements(eu_reg_2016_679_art_4_19).
test(a_shortened_key_is_not_recorded, fail) :-
    implements(gdpr_art_83_4).
test(each_key_has_one_record) :-
    findall(Key, citation(Key, _), Keys),
    length(Keys, Count),
    sort(Keys, DistinctKeys),
    length(DistinctKeys, Count).

:- end_module(citations).
