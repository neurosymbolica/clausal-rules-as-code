% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/data_protection/gdpr_administrative_fine_maximum.
% Source: Regulation (EU) 2016/679 (GDPR) Art 83 and Art 4.
%
% citation/2 record form: citation(Key, [label-'...', ref-'...']). The verbatim
% pair is omitted while the key is status: unverified in citations-sources.yaml.
% implements(Key) succeeds for every recorded key and fails for any other.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

implements(Key) :-
    citation(Key, _).

citation(eu_reg_2016_679_art_83_3, [label-'Regulation (EU) 2016/679 Art 83(3)', ref-'https://eur-lex.europa.eu/eli/reg/2016/679/oj']).
