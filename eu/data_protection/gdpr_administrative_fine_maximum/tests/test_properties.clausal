% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_properties.clausal -- structural PROPERTIES over the subject set.
% Totality, determinism (exactly one solution), citation hygiene, and the
% domain invariants of the cap.
% Run: python -m clausal.testing eu/data_protection/gdpr_administrative_fine_maximum/tests/test_properties.clausal
% =====================================================================
:- module(test_properties, []).
:- use_module(eu/data_protection/gdpr_administrative_fine_maximum/gdpr_administrative_fine_maximum, [
    administrative_fine_maximum/3,
    decide_gdpr_administrative_fine_maximum/2
]).
:- use_module(eu/data_protection/gdpr_administrative_fine_maximum/fixtures, [
    gdpr_administrative_fine_maximum_subject/1,
    gdpr_administrative_fine_maximum_profile_for/2
]).

subject_classifies(Subject) :-
    gdpr_administrative_fine_maximum_subject(Subject),
    gdpr_administrative_fine_maximum_profile_for(Subject, Profile),
    decide_gdpr_administrative_fine_maximum(Profile, _Verdict).

subject_solution_count(Subject, Count) :-
    gdpr_administrative_fine_maximum_subject(Subject),
    gdpr_administrative_fine_maximum_profile_for(Subject, Profile),
    findall(Verdict-Citations, administrative_fine_maximum(Profile, Verdict, Citations), Solutions),
    length(Solutions, Count).

subject_answer(Subject, Verdict, Citations) :-
    gdpr_administrative_fine_maximum_subject(Subject),
    gdpr_administrative_fine_maximum_profile_for(Subject, Profile),
    administrative_fine_maximum(Profile, Verdict, Citations).

non_final(indeterminate(_)).
non_final(needs_legal_review(_, _)).
non_final(input_problems(_)).

no_duplicates(List) :-
    sort(List, Sorted),
    length(List, Length),
    length(Sorted, Length).

subject_cap(Subject, CapInEuroCents) :-
    subject_answer(Subject, fine_maximum(_, _, CapInEuroCents), _).

cap_for(Provision, Turnover, CapInEuroCents) :-
    administrative_fine_maximum([attribute(infringed_provisions, [Provision]), attribute(infringer_is_undertaking, true), attribute(total_worldwide_annual_turnover_in_euros, Turnover)], fine_maximum(_, _, CapInEuroCents), _).

% sort/2 collapses a subject that classifies more than once.
test(totality_every_subject_classifies) :-
    findall(Subject, gdpr_administrative_fine_maximum_subject(Subject), Subjects),
    sort(Subjects, SubjectSet),
    findall(Subject, subject_classifies(Subject), ClassifiedSubjects),
    sort(ClassifiedSubjects, SubjectSet).

test(determinism_every_subject_has_exactly_one_solution) :-
    findall(Count, subject_solution_count(_, Count), Counts),
    Counts = [_|_],
    sort(Counts, [1]).

test(every_subject_is_counted) :-
    findall(Subject, gdpr_administrative_fine_maximum_subject(Subject), Subjects),
    findall(Subject, subject_solution_count(Subject, _), Counted),
    Counted == Subjects.

test(non_final_verdicts_have_no_citations) :-
    findall(Citations, (subject_answer(_, Verdict, Citations), non_final(Verdict)), CitationLists),
    CitationLists = [_|_],
    sort(CitationLists, [[]]).

test(citations_never_repeat) :-
    findall(Subject, gdpr_administrative_fine_maximum_subject(Subject), Subjects),
    findall(Subject, (subject_answer(Subject, _, Citations), no_duplicates(Citations)), Clean),
    Clean == Subjects.

test(every_final_single_answer_cites_a_paragraph) :-
    findall(Citations, subject_answer(_, fine_maximum(_, _, _), Citations), CitationLists),
    CitationLists = [_|_],
    findall(Citations, (member(Citations, CitationLists), Citations = [_|_]), Cited),
    Cited == CitationLists.

test(every_cap_is_at_least_the_lower_fixed_amount) :-
    findall(CapInEuroCents, subject_cap(_, CapInEuroCents), Caps),
    Caps = [_|_],
    min_list(Caps, Minimum),
    Minimum >= 1000000000.

test(the_higher_tier_cap_is_never_smaller_than_the_lower_for_the_same_turnover) :-
    Turnovers = [0, 1, 499999999, 500000000, 500000001, 1000000000, 999999999999],
    findall(Turnover, (member(Turnover, Turnovers), cap_for(article_32, Turnover, LowerCap), cap_for(article_5, Turnover, HigherCap), HigherCap >= LowerCap), Good),
    Good == Turnovers.

test(the_cap_never_falls_as_turnover_rises) :-
    Turnovers = [0, 499999999, 500000000, 500000001, 1000000000],
    findall(Cap, (member(Turnover, Turnovers), cap_for(article_32, Turnover, Cap)), Caps),
    msort(Caps, Caps).

test(the_cap_is_an_integer) :-
    cap_for(article_32, 500000001, CapInEuroCents),
    integer(CapInEuroCents),
    CapInEuroCents =:= 1000000002.

:- end_module(test_properties).
