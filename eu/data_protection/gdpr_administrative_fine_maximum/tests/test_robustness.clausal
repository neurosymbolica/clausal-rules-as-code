% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_robustness.clausal -- ROBUSTNESS of the input check gdpr_administrative_fine_maximum_input_problems/2 for a
% PROFILE that is an attribute list [attribute(Key, Value), ...]: an empty list, a
% value that is not a list, an unknown key and a value outside its type each get exactly
% one answer. Written by the scaffold from the order's typed input contract
% (input_contract.types.profile: attribute_list), not by the producer;
% do not edit or delete.
% Run: python -m clausal.testing eu/data_protection/gdpr_administrative_fine_maximum/tests/test_robustness.clausal
% =====================================================================
:- module(test_robustness, []).
:- use_module(eu/data_protection/gdpr_administrative_fine_maximum/queries, [gdpr_administrative_fine_maximum_input_problems/2]).

test(an_empty_attribute_list_gets_exactly_one_answer) :-
    findall(Problems, gdpr_administrative_fine_maximum_input_problems([], Problems), Answers),
    Answers == [[]].

test(a_profile_that_is_not_a_list_gets_one_non_empty_answer) :-
    findall(Problems, gdpr_administrative_fine_maximum_input_problems(not_a_profile, Problems), Answers),
    Answers = [[_|_]].

test(an_unknown_key_is_named) :-
    findall(Problems, gdpr_administrative_fine_maximum_input_problems([attribute(not_a_key_of_the_contract, true)], Problems), Answers),
    Answers = [Problems],
    memberchk(unknown_key(not_a_key_of_the_contract), Problems).

test(a_value_outside_the_type_of_infringed_provisions_is_named) :-
    findall(Problems, gdpr_administrative_fine_maximum_input_problems([attribute(infringed_provisions, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(infringed_provisions), Problems).

test(a_value_outside_the_type_of_infringer_is_undertaking_is_named) :-
    findall(Problems, gdpr_administrative_fine_maximum_input_problems([attribute(infringer_is_undertaking, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(infringer_is_undertaking), Problems).

test(a_value_outside_the_type_of_total_worldwide_annual_turnover_in_euros_is_named) :-
    findall(Problems, gdpr_administrative_fine_maximum_input_problems([attribute(total_worldwide_annual_turnover_in_euros, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(total_worldwide_annual_turnover_in_euros), Problems).

:- end_module(test_robustness).
