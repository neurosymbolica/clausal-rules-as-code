% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_load.clausal -- LOAD: the shared floor of
% eu/data_protection/gdpr_administrative_fine_maximum loads (kernel and
% citations), the result terms the order pins build and destructure, the
% verdict, tier and basis atoms are distinct, and a real citation record
% resolves. Self-contained: the determination slice is not referenced.
% Run: cd <corpus root> && python -m clausal.testing \
%      eu/data_protection/gdpr_administrative_fine_maximum/tests/test_load.clausal
% =====================================================================
:- module(test_load, []).
:- use_module(eu/data_protection/gdpr_administrative_fine_maximum/kernel, [gdpr_administrative_fine_maximum_input_problems/2]).
:- use_module(eu/data_protection/gdpr_administrative_fine_maximum/citations, [citation/2, implements/1]).

% ---- result terms build and destructure ---------------------------------

test(the_fine_maximum_term_carries_tier_basis_and_cap) :-
    Verdict = fine_maximum(lower_maximum_tier, fixed_amount, 1000000000),
    Verdict = fine_maximum(Tier, Basis, CapInEuroCents),
    Tier == lower_maximum_tier,
    Basis == fixed_amount,
    CapInEuroCents =:= 1000000000.

test(the_separate_fine_maxima_term_carries_infringement_maxima) :-
    Verdict = separate_fine_maxima([
        infringement_maximum(article_8, lower_maximum_tier, fixed_amount_for_non_undertaking, 1000000000),
        infringement_maximum(article_5, higher_maximum_tier, fixed_amount_for_non_undertaking, 2000000000)
    ]),
    Verdict = separate_fine_maxima([First, Second]),
    First = infringement_maximum(FirstProvision, FirstTier, _, FirstCapInEuroCents),
    Second = infringement_maximum(SecondProvision, SecondTier, _, SecondCapInEuroCents),
    FirstProvision == article_8,
    FirstTier == lower_maximum_tier,
    FirstCapInEuroCents =:= 1000000000,
    SecondProvision == article_5,
    SecondTier == higher_maximum_tier,
    SecondCapInEuroCents =:= 2000000000.

test(the_indeterminate_term_carries_missing_keys) :-
    Verdict = indeterminate([infringer_is_undertaking, total_worldwide_annual_turnover_in_euros]),
    Verdict = indeterminate(MissingKeys),
    MissingKeys == [infringer_is_undertaking, total_worldwide_annual_turnover_in_euros].

test(the_open_textured_referral_carries_key_citation_and_pairs) :-
    Verdict = needs_legal_review(
        open_textured(infringer_is_undertaking, cite(eu_reg_2016_679_art_83_4)),
        [inputs_relied_on([infringer_is_undertaking-unsure])]
    ),
    Verdict = needs_legal_review(open_textured(Key, cite(CitationKey)), [inputs_relied_on(Pairs)]),
    Key == infringer_is_undertaking,
    CitationKey == eu_reg_2016_679_art_83_4,
    Pairs == [infringer_is_undertaking-unsure],
    citation(CitationKey, _Record).

test(the_not_governed_here_referral_carries_three_citations) :-
    Verdict = needs_legal_review(
        not_governed_here([cite(eu_reg_2016_679_art_83_4), cite(eu_reg_2016_679_art_83_5), cite(eu_reg_2016_679_art_83_6)]),
        [inputs_relied_on([infringed_provisions-[article_24]])]
    ),
    Verdict = needs_legal_review(not_governed_here(Cites), [inputs_relied_on(Pairs)]),
    Cites == [cite(eu_reg_2016_679_art_83_4), cite(eu_reg_2016_679_art_83_5), cite(eu_reg_2016_679_art_83_6)],
    Pairs == [infringed_provisions-[article_24]].

test(the_input_problems_term_carries_problems) :-
    Verdict = input_problems([duplicate_key(infringer_is_undertaking), wrong_type(total_worldwide_annual_turnover_in_euros), unknown_key(colour)]),
    Verdict = input_problems([First, Second, Third]),
    First == duplicate_key(infringer_is_undertaking),
    Second == wrong_type(total_worldwide_annual_turnover_in_euros),
    Third == unknown_key(colour).

test(the_facade_verdict_term_carries_status_and_citations) :-
    Verdict = gdpr_administrative_fine_maximum_verdict(fine_maximum_determined, [cite(eu_reg_2016_679_art_83_4)]),
    Verdict = gdpr_administrative_fine_maximum_verdict(Status, Citations),
    Status == fine_maximum_determined,
    Citations == [cite(eu_reg_2016_679_art_83_4)].

% ---- the pinned atoms are distinct --------------------------------------

test(the_tier_atoms_are_distinct) :-
    dif(lower_maximum_tier, higher_maximum_tier).

test(the_basis_atoms_are_distinct) :-
    dif(fixed_amount, percentage_of_turnover),
    dif(fixed_amount, fixed_amount_for_non_undertaking),
    dif(percentage_of_turnover, fixed_amount_for_non_undertaking).

test(the_verdict_constructors_are_distinct) :-
    dif(fine_maximum, separate_fine_maxima),
    dif(fine_maximum, indeterminate),
    dif(fine_maximum, needs_legal_review),
    dif(fine_maximum, input_problems),
    dif(separate_fine_maxima, indeterminate),
    dif(separate_fine_maxima, needs_legal_review),
    dif(separate_fine_maxima, input_problems),
    dif(indeterminate, needs_legal_review),
    dif(indeterminate, input_problems),
    dif(needs_legal_review, input_problems).

test(the_facade_status_atoms_are_distinct) :-
    Statuses = [fine_maximum_determined, separate_fine_maxima_determined, required_input_missing, referred_for_legal_review, input_rejected],
    sort(Statuses, DistinctStatuses),
    length(Statuses, Count),
    length(DistinctStatuses, Count).

test(the_input_problem_constructors_are_distinct) :-
    dif(unknown_key(colour), wrong_type(colour)),
    dif(unknown_key(colour), duplicate_key(colour)),
    dif(wrong_type(colour), duplicate_key(colour)).

% ---- a real citation record resolves ------------------------------------

test(the_lower_tier_citation_is_recorded) :-
    citation(eu_reg_2016_679_art_83_4, Record),
    Record = [label-_, ref-Reference, verbatim-_],
    Reference == '02016R0679-20160504#parag_083.004'.

test(the_gravest_infringement_citation_is_recorded) :-
    implements(eu_reg_2016_679_art_83_3).

test(a_shortened_citation_key_is_not_recorded, fail) :-
    implements(gdpr_art_83_3).

% ---- the kernel input check loads and gives one answer ------------------

test(a_well_formed_profile_has_no_problem) :-
    findall(Problems,
            gdpr_administrative_fine_maximum_input_problems(
                [attribute(infringed_provisions, [article_5]),
                 attribute(infringer_is_undertaking, true),
                 attribute(total_worldwide_annual_turnover_in_euros, 400000000)],
                Problems),
            Answers),
    Answers == [[]].

test(an_absent_key_is_not_a_problem) :-
    gdpr_administrative_fine_maximum_input_problems([attribute(infringed_provisions, [article_8])], Problems),
    Problems == [].

test(a_term_that_is_not_an_attribute_list_is_the_wrong_type) :-
    gdpr_administrative_fine_maximum_input_problems(not_a_profile, Problems),
    Problems == [wrong_type(profile)].

test(a_float_turnover_is_the_wrong_type) :-
    gdpr_administrative_fine_maximum_input_problems([attribute(total_worldwide_annual_turnover_in_euros, 1.5)], Problems),
    Problems == [wrong_type(total_worldwide_annual_turnover_in_euros)].

test(an_empty_provision_list_is_the_wrong_type) :-
    gdpr_administrative_fine_maximum_input_problems([attribute(infringed_provisions, [])], Problems),
    Problems == [wrong_type(infringed_provisions)].

test(a_repeated_key_is_a_duplicate_and_not_the_wrong_type) :-
    gdpr_administrative_fine_maximum_input_problems(
        [attribute(infringer_is_undertaking, maybe),
         attribute(infringer_is_undertaking, true)],
        Problems),
    Problems == [duplicate_key(infringer_is_undertaking)].

test(contract_problems_come_before_unknown_keys) :-
    gdpr_administrative_fine_maximum_input_problems(
        [attribute(colour, red),
         attribute(infringer_is_undertaking, yes),
         attribute(colour, blue)],
        Problems),
    Problems == [wrong_type(infringer_is_undertaking), unknown_key(colour)].

test(an_unlisted_provision_atom_is_not_an_input_problem) :-
    gdpr_administrative_fine_maximum_input_problems([attribute(infringed_provisions, [article_24])], Problems),
    Problems == [].

:- end_module(test_load).
