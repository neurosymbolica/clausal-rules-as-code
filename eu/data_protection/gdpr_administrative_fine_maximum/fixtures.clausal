% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% fixtures.clausal -- representative profiles for eu/data_protection/gdpr_administrative_fine_maximum.
% A TOP-LAYER consumer: it imports only the slice's public predicate it
% calls. Profile keys, provision atoms and subject ids are atoms.
%
% A profile is an ATTRIBUTE LIST [attribute(Key, Value), ...] (the order's
% typed input contract). Every route has a positive case and a one-unit
% near-miss control:
%   lower tier tie   T 500000000 (fixed_amount)   / T 500000001 (percentage)
%   higher tier tie  T 500000000 (fixed_amount)   / T 500000001 (percentage)
%   non-undertaking (fixed_amount_for_non_undertaking) / undertaking, T 0
%   Art 83(3) combined (both keys true) / separate (fault key false)
%   Art 83(3) key unsure (referral)     / combined (key true)
%   turnover absent with unsure undertaking (indeterminate) / turnover given
%       (referral on the undertaking)
%   unlisted article_24 (not_governed_here) / listed neighbour article_25
%   turnover -1 (input_problems) / turnover 0 (fine maximum)
% =====================================================================

:- module(fixtures, [
    gdpr_administrative_fine_maximum_subject/1,
    gdpr_administrative_fine_maximum_profile_for/2,
    gdpr_administrative_fine_maximum_assess/2
]).

:- use_module(eu/data_protection/gdpr_administrative_fine_maximum/gdpr_administrative_fine_maximum, [decide_gdpr_administrative_fine_maximum/2]).

% ---- Subject registry ------------------------------------------------
gdpr_administrative_fine_maximum_subject(lower_tier_turnover_at_tie).
gdpr_administrative_fine_maximum_subject(lower_tier_turnover_just_above_tie).
gdpr_administrative_fine_maximum_subject(higher_tier_turnover_at_tie).
gdpr_administrative_fine_maximum_subject(higher_tier_turnover_just_above_tie).
gdpr_administrative_fine_maximum_subject(non_undertaking_certification_body).
gdpr_administrative_fine_maximum_subject(undertaking_with_zero_turnover).
gdpr_administrative_fine_maximum_subject(supervisory_order_non_undertaking).
gdpr_administrative_fine_maximum_subject(combined_linked_and_intentional).
gdpr_administrative_fine_maximum_subject(separate_not_intentional_or_negligent).
gdpr_administrative_fine_maximum_subject(linked_operations_unsure).
gdpr_administrative_fine_maximum_subject(missing_turnover_unsure_undertaking).
gdpr_administrative_fine_maximum_subject(unsure_undertaking_with_turnover).
gdpr_administrative_fine_maximum_subject(unlisted_provision).
gdpr_administrative_fine_maximum_subject(listed_neighbour_provision).
gdpr_administrative_fine_maximum_subject(negative_turnover_rejected).
gdpr_administrative_fine_maximum_subject(zero_turnover_accepted).

% ---- Profiles --------------------------------------------------------
gdpr_administrative_fine_maximum_profile_for(lower_tier_turnover_at_tie, [
    attribute(infringed_provisions, [article_30]),
    attribute(infringer_is_undertaking, true),
    attribute(total_worldwide_annual_turnover_in_euros, 500000000)
]).
gdpr_administrative_fine_maximum_profile_for(lower_tier_turnover_just_above_tie, [
    attribute(infringed_provisions, [article_30]),
    attribute(infringer_is_undertaking, true),
    attribute(total_worldwide_annual_turnover_in_euros, 500000001)
]).
gdpr_administrative_fine_maximum_profile_for(higher_tier_turnover_at_tie, [
    attribute(infringed_provisions, [article_17]),
    attribute(infringer_is_undertaking, true),
    attribute(total_worldwide_annual_turnover_in_euros, 500000000)
]).
gdpr_administrative_fine_maximum_profile_for(higher_tier_turnover_just_above_tie, [
    attribute(infringed_provisions, [article_17]),
    attribute(infringer_is_undertaking, true),
    attribute(total_worldwide_annual_turnover_in_euros, 500000001)
]).
gdpr_administrative_fine_maximum_profile_for(non_undertaking_certification_body, [
    attribute(infringed_provisions, [article_42]),
    attribute(infringer_is_undertaking, false)
]).
gdpr_administrative_fine_maximum_profile_for(undertaking_with_zero_turnover, [
    attribute(infringed_provisions, [article_42]),
    attribute(infringer_is_undertaking, true),
    attribute(total_worldwide_annual_turnover_in_euros, 0)
]).
gdpr_administrative_fine_maximum_profile_for(supervisory_order_non_undertaking, [
    attribute(infringed_provisions, [non_compliance_with_supervisory_authority_order]),
    attribute(infringer_is_undertaking, false)
]).
gdpr_administrative_fine_maximum_profile_for(combined_linked_and_intentional, [
    attribute(infringed_provisions, [article_33, article_6]),
    attribute(infringer_is_undertaking, true),
    attribute(total_worldwide_annual_turnover_in_euros, 400000000),
    attribute(infringements_concern_same_or_linked_processing_operations, true),
    attribute(infringements_intentional_or_negligent, true)
]).
gdpr_administrative_fine_maximum_profile_for(separate_not_intentional_or_negligent, [
    attribute(infringed_provisions, [article_33, article_6]),
    attribute(infringer_is_undertaking, true),
    attribute(total_worldwide_annual_turnover_in_euros, 400000000),
    attribute(infringements_concern_same_or_linked_processing_operations, true),
    attribute(infringements_intentional_or_negligent, false)
]).
gdpr_administrative_fine_maximum_profile_for(linked_operations_unsure, [
    attribute(infringed_provisions, [article_33, article_6]),
    attribute(infringer_is_undertaking, true),
    attribute(total_worldwide_annual_turnover_in_euros, 400000000),
    attribute(infringements_concern_same_or_linked_processing_operations, unsure),
    attribute(infringements_intentional_or_negligent, true)
]).
gdpr_administrative_fine_maximum_profile_for(missing_turnover_unsure_undertaking, [
    attribute(infringed_provisions, [article_6]),
    attribute(infringer_is_undertaking, unsure)
]).
gdpr_administrative_fine_maximum_profile_for(unsure_undertaking_with_turnover, [
    attribute(infringed_provisions, [article_6]),
    attribute(infringer_is_undertaking, unsure),
    attribute(total_worldwide_annual_turnover_in_euros, 100)
]).
gdpr_administrative_fine_maximum_profile_for(unlisted_provision, [
    attribute(infringed_provisions, [article_24]),
    attribute(infringer_is_undertaking, false)
]).
gdpr_administrative_fine_maximum_profile_for(listed_neighbour_provision, [
    attribute(infringed_provisions, [article_25]),
    attribute(infringer_is_undertaking, false)
]).
gdpr_administrative_fine_maximum_profile_for(negative_turnover_rejected, [
    attribute(infringed_provisions, [article_6]),
    attribute(infringer_is_undertaking, true),
    attribute(total_worldwide_annual_turnover_in_euros, -1)
]).
gdpr_administrative_fine_maximum_profile_for(zero_turnover_accepted, [
    attribute(infringed_provisions, [article_6]),
    attribute(infringer_is_undertaking, true),
    attribute(total_worldwide_annual_turnover_in_euros, 0)
]).

% ---- Convenience wrapper ---------------------------------------------
gdpr_administrative_fine_maximum_assess(Subject, Result) :-
    gdpr_administrative_fine_maximum_profile_for(Subject, Profile),
    decide_gdpr_administrative_fine_maximum(Profile, Result).

:- end_module(fixtures).
