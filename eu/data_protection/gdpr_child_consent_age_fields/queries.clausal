% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% queries.clausal -- QUERY layer for eu/data_protection/gdpr_child_consent_age_fields.
% A TOP-LAYER consumer: it imports the determination slices' PUBLIC
% predicates it calls, and nothing else.
%
% gdpr_child_consent_age_fields_what_if/4          (#16 what-if): override one key -> re-evaluate STATUS
% gdpr_child_consent_age_fields_compliance_check/3 (#13): is processing on consent allowed
% gdpr_child_consent_age_fields_justification/2    (#7): checklist with cite(...) per item
% child_consent_status_status/2 (child_consent_status slice) serves #3 status_determination
% gdpr_child_consent_age_fields_profile_keys/1:     top-level profile key schema
% gdpr_child_consent_age_fields_input_problems/2:   the problems a profile has ([] = none)
% The profile is an attribute list, so the override is written for that shape.
% The result constructors of the order are exported here as well.
% =====================================================================

:- module(queries, [
    gdpr_child_consent_age_fields_profile_keys/1,
    gdpr_child_consent_age_fields_input_problems/2,
    gdpr_child_consent_age_fields_what_if/4,
    gdpr_child_consent_age_fields_compliance_check/3,
    gdpr_child_consent_age_fields_justification/2,
    input_problems/1,
    unknown_key/1,
    wrong_type/1,
    duplicate_key/1,
    indeterminate/1,
    needs_legal_review/2,
    open_textured/2,
    cross_reference_unresolved/2,
    resolution/2,
    inputs_relied_on/1,
    provenance/2,
    outside_fact/2,
    attested/2,
    fetched/2,
    attestation/4,
    source/3,
    national_digital_consent_age/3,
    url/2,
    document/2
]).

:- use_module(eu/data_protection/gdpr_child_consent_age_fields/kernel, [gdpr_child_consent_age_fields_input_problems/2]).
:- use_module(eu/data_protection/gdpr_child_consent_age_fields/child_consent_status, [child_consent_status/2, child_consent_status_checklist/2]).

:- constructors([
    input_problems(problems),
    unknown_key(key),
    wrong_type(key),
    duplicate_key(key),
    indeterminate(missing_keys),
    needs_legal_review(reason, context),
    open_textured(input, citation),
    cross_reference_unresolved(citation, target),
    resolution(target, status),
    inputs_relied_on(pairs),
    provenance(deciding_clause, citations),
    outside_fact(key, value),
    attested(value, attestation),
    fetched(value, source),
    attestation(by, at, reason, evidence),
    source(url, retrieved_at, sha256),
    national_digital_consent_age(member_state, age, provision),
    url(url, retrieved_at),
    document(upload_id, sha256)
]).

% schema of top-level profile keys: the keys of the order's typed input contract, in its order
gdpr_child_consent_age_fields_profile_keys([processing_rests_on_consent, information_society_service, offered_directly_to_child, child_age_years, parental_consent_given, member_state, member_state_selection_test, consent_date, member_state_digital_consent_age, verification_efforts_reasonable]).

% #16 what-if: re-evaluate with one key hypothetically overridden
gdpr_child_consent_age_fields_what_if(Profile, OverriddenKey, NewValue, NewStatus) :-
    override_attribute(Profile, OverriddenKey, NewValue, Hypothesis),
    child_consent_status(Hypothesis, NewStatus).

override_attribute([], Key, Value, [attribute(Key, Value)]).
override_attribute([attribute(Key, _)|Rest], Key, Value, [attribute(Key, Value)|Rest]).
override_attribute([attribute(OtherKey, OtherValue)|Rest], Key, Value, [attribute(OtherKey, OtherValue)|NewRest]) :-
    dif(OtherKey, Key),
    override_attribute(Rest, Key, Value, NewRest).

% #13 compliance check: may the controller process on consent, in the current state?
gdpr_child_consent_age_fields_compliance_check(Profile, process_on_consent, Verdict) :-
    child_consent_status(Profile, Status),
    compliance_verdict(Status, Verdict).

compliance_verdict(eligible, permitted(cite(eu_reg_2016_679_art_8_1))).
compliance_verdict(ineligible, forbidden(cite(eu_reg_2016_679_art_8_1))).
compliance_verdict(indeterminate(MissingKeys), undetermined(indeterminate(MissingKeys))).
compliance_verdict(needs_legal_review(Reason, Context), undetermined(needs_legal_review(Reason, Context))).
compliance_verdict(input_problems(Problems), undetermined(input_problems(Problems))).

% #7 justification: the checklist, each item carrying its cite(...)
gdpr_child_consent_age_fields_justification(Profile, Checklist) :-
    child_consent_status_checklist(Profile, Checklist).

:- end_module(queries).
