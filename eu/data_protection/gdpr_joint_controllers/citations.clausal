% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/data_protection/gdpr_joint_controllers.
%
% Instrument: Regulation (EU) 2016/679 of the European Parliament and of the
% Council (General Data Protection Regulation), consolidated text
% 02016R0679-20160504 (fmx4 cut by tools/pin_statute.py, fetched 2026-11-12).
% Drafter's reading, not a lawyer's.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% The verbatim-'...' pair is OMITTED while the key's entry in
% citations-sources.yaml is `status: unverified`; `status: verified`
% carries a non-empty ref AND a verbatim that is an exact substring of
% the pinned unit text.
%
% Keys (canonical lexicon scheme, _lexicon/citations.yaml):
%   eu_reg_2016_679_art_26_3   Art 26(3)  -- rights against each joint controller
%   eu_reg_2016_679_art_28_10  Art 28(10) -- processor considered a controller
%   eu_reg_2016_679_art_82_4   Art 82(4)  -- liability for the entire damage;
%                                            also the citation of the outside fact
%   eu_reg_2016_679_art_82_5   Art 82(5)  -- claim back after full compensation
%   responsibility_under_article_82_statement
%                              the cross-reference TARGET of THE ABSENT REFERRAL:
%                              the statement, made outside this order (in
%                              gdpr-compensation-and-liability), that the caller is
%                              responsible under Art 82(2) and (3). Not a rule of
%                              this order; recorded so cite(...) of it resolves.
%
% Art 26(1), Art 82(2) and Art 82(3) are quoted for reading only (readings (2)
% and (5)); no limb applies them, they are decided in sibling orders and are
% NOT recorded here.
%
% PROVENANCE: every operative clause opens its body with implements(Key),
% Key one recorded below.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

citation(eu_reg_2016_679_art_26_3, [label-'Regulation (EU) 2016/679 (GDPR) Art 26(3) (rights of the data subject in respect of and against each of the joint controllers)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (consolidated text 02016R0679-20160504, unit parag_026.003)', verbatim-'Irrespective of the terms of the arrangement referred to in paragraph 1, the data subject may exercise his or her rights under this Regulation in respect of and against each of the controllers.']).

citation(eu_reg_2016_679_art_28_10, [label-'Regulation (EU) 2016/679 (GDPR) Art 28(10) (processor that determines the purposes and means of processing considered a controller)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (consolidated text 02016R0679-20160504, unit parag_028.010)', verbatim-'Without prejudice to Articles 82, 83 and 84, if a processor infringes this Regulation by determining the purposes and means of processing, the processor shall be considered to be a controller in respect of that processing.']).

citation(eu_reg_2016_679_art_82_4, [label-'Regulation (EU) 2016/679 (GDPR) Art 82(4) (each responsible controller or processor liable for the entire damage)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (consolidated text 02016R0679-20160504, unit parag_082.004)', verbatim-'Where more than one controller or processor, or both a controller and a processor, are involved in the same processing and where they are, under paragraphs 2 and 3, responsible for any damage caused by processing, each controller or processor shall be held liable for the entire damage in order to ensure effective compensation of the data subject.']).

citation(eu_reg_2016_679_art_82_5, [label-'Regulation (EU) 2016/679 (GDPR) Art 82(5) (claim back by the controller or processor that paid full compensation)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (consolidated text 02016R0679-20160504, unit parag_082.005)', verbatim-'Where a controller or processor has, in accordance with paragraph 4, paid full compensation for the damage suffered, that controller or processor shall be entitled to claim back from the other controllers or processors involved in the same processing that part of the compensation corresponding to their part of responsibility for the damage, in accordance with the conditions set out in paragraph 2.']).

citation(responsibility_under_article_82_statement, [label-'Statement that the caller is responsible (liable) under Regulation (EU) 2016/679 (GDPR) Art 82(2) and (3) for the damage of the claim (cross-reference target, decided in gdpr-compensation-and-liability)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (consolidated text 02016R0679-20160504, units parag_082.002 and parag_082.003)']).

% implements(Key): the provenance marker. Succeeds for every recorded key and
% fails for a key not recorded here; it never changes an answer.
implements(Key) :-
    citation(Key, _).

:- end_module(citations).
