% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/data_protection/gdpr_joint_controllers.
%
% Instrument: Regulation (EU) 2016/679 (GDPR), consolidated text
% 02016R0679-20160504 (CELEX 02016R0679-20160504), pinned unit text cut by
% tools/pin_statute.py (fmx4), fetched 2026-11-12. Each verbatim below is
% the pinned unit text without its paragraph number.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% The verbatim pair is OMITTED while the key's entry in
% citations-sources.yaml is `status: unverified`.
%
% Keys (canonical _lexicon/citations.yaml scheme; the ONLY citation atoms
% a RESULT returns):
%   eu_reg_2016_679_art_26_3   rights against each joint controller (A1, A3, A4);
%   eu_reg_2016_679_art_28_10  processor determining purposes and means is a
%                              controller (A4, beside Art 26(3));
%   eu_reg_2016_679_art_82_4   liability for the entire damage (B1, B4, B5) and
%                              the citation of the outside-fact referral (B2, C4);
%   eu_reg_2016_679_art_82_5   claim back after full compensation (C1-C3, C7, C8).
% Referral target (not a provision of this order; named only inside THE
% ABSENT REFERRAL as cite(responsibility_under_article_82_statement)):
%   responsibility_under_article_82_statement  the caller's Art 82(2)/(3)
%                              statement from gdpr-compensation-and-liability.
% Deferred and deliberately NOT recorded (no limb decides or cites them;
% decided by sibling orders): Art 26(1) and (2), Art 82(1) to (3), the
% rest of Art 28, Art 4.
%
% PROVENANCE: every operative clause opens its body with implements(Key),
% Key one of the atoms recorded below.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

citation(eu_reg_2016_679_art_26_3, [label-'Regulation (EU) 2016/679 (GDPR) Art 26(3) rights of the data subject in respect of and against each of the joint controllers', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit 02016R0679-20160504#parag_026.003)', verbatim-'Irrespective of the terms of the arrangement referred to in paragraph 1, the data subject may exercise his or her rights under this Regulation in respect of and against each of the controllers.']).

citation(eu_reg_2016_679_art_28_10, [label-'Regulation (EU) 2016/679 (GDPR) Art 28(10) processor determining the purposes and means of processing considered a controller', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit 02016R0679-20160504#parag_028.010)', verbatim-'Without prejudice to Articles 82, 83 and 84, if a processor infringes this Regulation by determining the purposes and means of processing, the processor shall be considered to be a controller in respect of that processing.']).

citation(eu_reg_2016_679_art_82_4, [label-'Regulation (EU) 2016/679 (GDPR) Art 82(4) liability of each responsible controller or processor for the entire damage', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit 02016R0679-20160504#parag_082.004)', verbatim-'Where more than one controller or processor, or both a controller and a processor, are involved in the same processing and where they are, under paragraphs 2 and 3, responsible for any damage caused by processing, each controller or processor shall be held liable for the entire damage in order to ensure effective compensation of the data subject.']).

citation(eu_reg_2016_679_art_82_5, [label-'Regulation (EU) 2016/679 (GDPR) Art 82(5) claim back by the controller or processor that paid full compensation', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit 02016R0679-20160504#parag_082.005)', verbatim-'Where a controller or processor has, in accordance with paragraph 4, paid full compensation for the damage suffered, that controller or processor shall be entitled to claim back from the other controllers or processors involved in the same processing that part of the compensation corresponding to their part of responsibility for the damage, in accordance with the conditions set out in paragraph 2.']).

citation(responsibility_under_article_82_statement, [label-'Statement of the caller''s responsibility (liability) under Regulation (EU) 2016/679 (GDPR) Art 82(2) and (3), decided in gdpr-compensation-and-liability (referral target of the outside fact responsible_under_article_82_2_and_3)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (units 02016R0679-20160504#parag_082.002 and #parag_082.003; determination made in the sibling order gdpr-compensation-and-liability)']).

% implements(Key): the provenance marker. Succeeds for every recorded key
% and fails for any other, so a misspelt key is never credited.
implements(Key) :-
    citation(Key, _).

:- end_module(citations).
