% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% fixtures.clausal -- representative profiles for eu/data_protection/gdpr_joint_controllers.
% A TOP-LAYER consumer: imports only the slice's PUBLIC predicate it calls.
%
% A profile is an ATTRIBUTE LIST [attribute(Key, Value), ...] (the order's typed
% input contract). The order carries no threshold, so the near-miss controls
% are one-key flips: each positive case is paired with a profile that differs
% in exactly one key and gets the opposite (or a non-final) answer.
%
% Routes covered (rights A1-A4, liability B1-B5, recourse C1-C8, step 0):
%   claim_back_after_full_payment       A4 B5 C8  -> eligible
%   claim_back_after_partial_payment    A4 B5 C3  -> ineligible   (near miss: F false)
%   claim_back_payment_unsure           A4 B5 C7  -> indeterminate (near miss: F unsure)
%   claim_back_payment_not_stated       A4 B5 C6  -> indeterminate (near miss: F absent)
%   sole_responsible_party              A1 B4 C2  -> ineligible   (near miss: O [])
%   party_not_responsible               A3 B1 C1  -> ineligible   (near miss: S false)
%   responsibility_statement_absent     A2 B2 C4  -> indeterminate (near miss: S absent)
%   other_parties_not_stated            A4 B3 C5  -> indeterminate (near miss: O absent)
%   duplicate_payment_key               step 0    -> indeterminate
%   arrangement_key_supplied            step 0    -> indeterminate
% =====================================================================

:- module(fixtures, [
    gdpr_joint_controllers_subject/1,
    gdpr_joint_controllers_profile_for/2,
    gdpr_joint_controllers_assess/2
]).

:- use_module(eu/data_protection/gdpr_joint_controllers/gdpr_joint_controllers, [decide_gdpr_joint_controllers/2]).

% ---- Subject registry ------------------------------------------------
gdpr_joint_controllers_subject(claim_back_after_full_payment).
gdpr_joint_controllers_subject(claim_back_after_partial_payment).
gdpr_joint_controllers_subject(claim_back_payment_unsure).
gdpr_joint_controllers_subject(claim_back_payment_not_stated).
gdpr_joint_controllers_subject(sole_responsible_party).
gdpr_joint_controllers_subject(party_not_responsible).
gdpr_joint_controllers_subject(responsibility_statement_absent).
gdpr_joint_controllers_subject(other_parties_not_stated).
gdpr_joint_controllers_subject(duplicate_payment_key).
gdpr_joint_controllers_subject(arrangement_key_supplied).

% ---- Attested outside facts (host-supplied fields, never read) --------
stated_responsibility(true, attested(true, attestation(host_service, attested_moment, stated_reason, none))).
stated_responsibility(false, attested(false, attestation(host_service, attested_moment, stated_reason, document(upload_identifier, content_hash)))).

% ---- Profiles --------------------------------------------------------
gdpr_joint_controllers_profile_for(claim_back_after_full_payment, [
        attribute(controllers_jointly_determine_purposes_and_means, true),
        attribute(responsible_under_article_82_2_and_3, Attested),
        attribute(other_responsible_parties, [processor_beta, controller_alpha]),
        attribute(full_compensation_paid, true)
    ]) :-
    stated_responsibility(true, Attested).
gdpr_joint_controllers_profile_for(claim_back_after_partial_payment, [
        attribute(controllers_jointly_determine_purposes_and_means, true),
        attribute(responsible_under_article_82_2_and_3, Attested),
        attribute(other_responsible_parties, [processor_beta, controller_alpha]),
        attribute(full_compensation_paid, false)
    ]) :-
    stated_responsibility(true, Attested).
gdpr_joint_controllers_profile_for(claim_back_payment_unsure, [
        attribute(controllers_jointly_determine_purposes_and_means, true),
        attribute(responsible_under_article_82_2_and_3, Attested),
        attribute(other_responsible_parties, [processor_beta, controller_alpha]),
        attribute(full_compensation_paid, unsure)
    ]) :-
    stated_responsibility(true, Attested).
gdpr_joint_controllers_profile_for(claim_back_payment_not_stated, [
        attribute(controllers_jointly_determine_purposes_and_means, true),
        attribute(responsible_under_article_82_2_and_3, Attested),
        attribute(other_responsible_parties, [processor_beta, controller_alpha])
    ]) :-
    stated_responsibility(true, Attested).
gdpr_joint_controllers_profile_for(sole_responsible_party, [
        attribute(controllers_jointly_determine_purposes_and_means, false),
        attribute(responsible_under_article_82_2_and_3, Attested),
        attribute(other_responsible_parties, []),
        attribute(full_compensation_paid, true)
    ]) :-
    stated_responsibility(true, Attested).
gdpr_joint_controllers_profile_for(party_not_responsible, [
        attribute(controllers_jointly_determine_purposes_and_means, unsure),
        attribute(responsible_under_article_82_2_and_3, Attested),
        attribute(other_responsible_parties, [processor_beta, controller_alpha]),
        attribute(full_compensation_paid, true)
    ]) :-
    stated_responsibility(false, Attested).
gdpr_joint_controllers_profile_for(responsibility_statement_absent, [
        attribute(other_responsible_parties, [processor_beta, controller_alpha]),
        attribute(full_compensation_paid, true)
    ]).
gdpr_joint_controllers_profile_for(other_parties_not_stated, [
        attribute(controllers_jointly_determine_purposes_and_means, true),
        attribute(responsible_under_article_82_2_and_3, Attested),
        attribute(full_compensation_paid, true)
    ]) :-
    stated_responsibility(true, Attested).
gdpr_joint_controllers_profile_for(duplicate_payment_key, [
        attribute(responsible_under_article_82_2_and_3, Attested),
        attribute(other_responsible_parties, [processor_beta]),
        attribute(full_compensation_paid, true),
        attribute(full_compensation_paid, true)
    ]) :-
    stated_responsibility(true, Attested).
gdpr_joint_controllers_profile_for(arrangement_key_supplied, [
        attribute(controllers_jointly_determine_purposes_and_means, true),
        attribute(arrangement_terms, allocated)
    ]).

% ---- Convenience wrapper ---------------------------------------------
gdpr_joint_controllers_assess(Subject, Result) :-
    gdpr_joint_controllers_profile_for(Subject, Profile),
    decide_gdpr_joint_controllers(Profile, Result).

:- end_module(fixtures).
