% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_load.clausal -- LOAD: the shared floor of
% eu/data_protection/gdpr_joint_controllers loads (kernel and citations),
% the result terms the order pins build and destructure, the result atoms
% are distinct, the citation records resolve, and the input check gives
% exactly one answer on a few plain profiles.
% Self-contained: it references no determination slice.
% Run: cd <corpus root> && python -m clausal.testing \
%      eu/data_protection/gdpr_joint_controllers/tests/test_load.clausal
% =====================================================================
:- module(test_load, []).
:- use_module(eu/data_protection/gdpr_joint_controllers/kernel, [gdpr_joint_controllers_input_problems/2]).
:- use_module(eu/data_protection/gdpr_joint_controllers/citations, [citation/2, implements/1]).

% ---- result atoms are distinct --------------------------------------

test(the_rights_result_atoms_are_distinct) :-
    dif(not_joint_controllers, rights_exercisable_against_this_controller).

test(the_entire_damage_result_atoms_are_distinct) :-
    dif(not_responsible_for_the_damage, no_other_responsible_party),
    dif(not_responsible_for_the_damage, liable_for_the_entire_damage),
    dif(no_other_responsible_party, liable_for_the_entire_damage).

test(the_claim_back_results_are_distinct) :-
    dif(not_entitled_to_claim_back, entitled_to_claim_back(_Parties)).

test(the_facade_verdict_atoms_are_distinct) :-
    dif(eligible, ineligible),
    dif(eligible, indeterminate),
    dif(ineligible, indeterminate).

% ---- result terms build and destructure -----------------------------

test(the_claim_back_term_carries_the_parties_as_given) :-
    Result = entitled_to_claim_back([processor_beta, controller_alpha]),
    Result = entitled_to_claim_back(Parties),
    Parties == [processor_beta, controller_alpha].

test(the_basis_item_carries_the_attested_term_as_given) :-
    Attested = attested(true, attestation(host_user, host_time, liable_for_damage, none)),
    Basis = [outside_fact(responsible_under_article_82_2_and_3, Attested)],
    Basis = [outside_fact(Key, Copied)],
    Key == responsible_under_article_82_2_and_3,
    Copied == Attested.

test(the_open_textured_referral_destructures) :-
    Result = needs_legal_review(open_textured(full_compensation_paid, cite(eu_reg_2016_679_art_82_5)), [inputs_relied_on([full_compensation_paid-unsure])]),
    Result = needs_legal_review(open_textured(Input, cite(CitationKey)), [inputs_relied_on(Pairs)]),
    Input == full_compensation_paid,
    CitationKey == eu_reg_2016_679_art_82_5,
    Pairs == [full_compensation_paid-unsure].

test(the_absent_referral_destructures) :-
    Result = needs_legal_review(cross_reference_unresolved(cite(eu_reg_2016_679_art_82_4), cite(responsibility_under_article_82_statement)), [resolution(cite(responsibility_under_article_82_statement), not_attempted), inputs_relied_on([responsible_under_article_82_2_and_3-absent])]),
    Result = needs_legal_review(cross_reference_unresolved(cite(CitationKey), cite(TargetKey)), [resolution(cite(ResolvedKey), Status), inputs_relied_on(Pairs)]),
    CitationKey == eu_reg_2016_679_art_82_4,
    TargetKey == responsibility_under_article_82_statement,
    ResolvedKey == TargetKey,
    Status == not_attempted,
    Pairs == [responsible_under_article_82_2_and_3-absent].

test(the_missing_key_status_names_one_key) :-
    Result = indeterminate([other_responsible_parties]),
    Result = indeterminate([MissingKey]),
    MissingKey == other_responsible_parties.

% ---- citation records resolve ---------------------------------------

test(the_article_26_3_citation_is_recorded) :-
    citation(eu_reg_2016_679_art_26_3, _Record).

test(the_article_28_10_citation_is_recorded) :-
    citation(eu_reg_2016_679_art_28_10, _Record).

test(the_article_82_4_citation_is_recorded) :-
    citation(eu_reg_2016_679_art_82_4, _Record).

test(the_article_82_5_citation_is_recorded) :-
    citation(eu_reg_2016_679_art_82_5, _Record).

test(the_referral_target_is_recorded) :-
    citation(responsibility_under_article_82_statement, _Record).

test(the_marker_holds_for_a_recorded_key) :-
    implements(eu_reg_2016_679_art_82_4).

test(the_marker_fails_for_an_unrecorded_key, fail) :-
    implements(eu_reg_2016_679_art_82_four).

% ---- the input check loads and answers once -------------------------

test(an_empty_profile_has_no_problem) :-
    findall(Problems, gdpr_joint_controllers_input_problems([], Problems), Answers),
    Answers == [[]].

test(a_well_formed_profile_has_no_problem) :-
    Profile = [attribute(controllers_jointly_determine_purposes_and_means, true), attribute(other_responsible_parties, [controller_alpha])],
    gdpr_joint_controllers_input_problems(Profile, Problems),
    Problems == [].

test(a_term_that_is_not_a_list_is_not_a_profile) :-
    gdpr_joint_controllers_input_problems(profile, Problems),
    Problems == [wrong_type(profile)].

test(a_judgement_outside_its_type_is_named) :-
    gdpr_joint_controllers_input_problems([attribute(full_compensation_paid, maybe)], Problems),
    Problems == [wrong_type(full_compensation_paid)].

test(a_judgement_outside_its_type_is_not_well_formed, fail) :-
    gdpr_joint_controllers_input_problems([attribute(full_compensation_paid, maybe)], []).

test(a_key_outside_the_contract_is_named) :-
    gdpr_joint_controllers_input_problems([attribute(colour, red)], Problems),
    Problems == [unknown_key(colour)].

:- end_module(test_load).
