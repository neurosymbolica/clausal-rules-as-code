% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_public_interface.clausal -- the package's PUBLIC surface, exercised
% through the package facade (what an external caller sees).
% Run: python -m clausal.testing eu/data_protection/gdpr_joint_controllers/tests/test_public_interface.clausal
% =====================================================================
:- module(test_public_interface, []).
:- use_module(eu/data_protection/gdpr_joint_controllers, [
    decide_gdpr_joint_controllers/2,
    gdpr_joint_controllers_status/2,
    gdpr_joint_controllers_checklist/2,
    gdpr_joint_controllers_decision_resolvable/1,
    gdpr_joint_controllers_status_values/1,
    gdpr_joint_controllers_subject/1,
    gdpr_joint_controllers_profile_for/2,
    gdpr_joint_controllers_assess/2,
    rights_against_each_joint_controller/3,
    liability_for_the_entire_damage/4,
    recourse_after_full_compensation/4,
    gdpr_joint_controllers_input_problems/2,
    gdpr_joint_controllers_what_if/4
]).

% ---- expected answers, in registry order ------------------------------
expected_status(claim_back_after_full_payment, eligible).
expected_status(claim_back_after_partial_payment, ineligible).
expected_status(claim_back_payment_unsure, indeterminate).
expected_status(claim_back_payment_not_stated, indeterminate).
expected_status(sole_responsible_party, ineligible).
expected_status(party_not_responsible, ineligible).
expected_status(responsibility_statement_absent, indeterminate).
expected_status(other_parties_not_stated, indeterminate).
expected_status(duplicate_payment_key, indeterminate).
expected_status(arrangement_key_supplied, indeterminate).

absent_referral_term(needs_legal_review(cross_reference_unresolved(cite(eu_reg_2016_679_art_82_4), cite(responsibility_under_article_82_statement)), [resolution(cite(responsibility_under_article_82_statement), not_attempted), inputs_relied_on([responsible_under_article_82_2_and_3-absent])])).

well_formed_subject(Subject) :-
    gdpr_joint_controllers_subject(Subject),
    gdpr_joint_controllers_profile_for(Subject, Profile),
    gdpr_joint_controllers_input_problems(Profile, []).

% ---- every subject, its concrete verdict -------------------------------
test(every_subject_resolves_to_its_expected_status) :-
    findall(Subject-Status, (gdpr_joint_controllers_subject(Subject), gdpr_joint_controllers_assess(Subject, gdpr_joint_controllers_verdict(Status, _))), Pairs),
    findall(Subject-Status, expected_status(Subject, Status), Expected),
    Pairs == Expected.
test(every_status_is_in_the_status_values) :-
    gdpr_joint_controllers_status_values(StatusValues),
    findall(Status, (gdpr_joint_controllers_subject(Subject), gdpr_joint_controllers_assess(Subject, gdpr_joint_controllers_verdict(Status, _))), Statuses),
    sort(Statuses, DistinctStatuses),
    sort(StatusValues, DistinctStatusValues),
    DistinctStatuses == DistinctStatusValues.
test(every_subject_is_assessed_exactly_once) :-
    findall(Subject, gdpr_joint_controllers_subject(Subject), Subjects),
    findall(Subject-Verdict, (gdpr_joint_controllers_subject(Subject), gdpr_joint_controllers_assess(Subject, Verdict)), Verdicts),
    length(Subjects, Count),
    length(Verdicts, Count).

% ---- positive case and its near-miss controls ---------------------------
test(full_payment_is_eligible_with_its_citation) :-
    gdpr_joint_controllers_assess(claim_back_after_full_payment, gdpr_joint_controllers_verdict(eligible, [cite(eu_reg_2016_679_art_82_5)])).
test(full_payment_is_not_ineligible, fail) :-
    gdpr_joint_controllers_assess(claim_back_after_full_payment, gdpr_joint_controllers_verdict(ineligible, _)).
test(partial_payment_is_ineligible) :-
    gdpr_joint_controllers_assess(claim_back_after_partial_payment, gdpr_joint_controllers_verdict(ineligible, [cite(eu_reg_2016_679_art_82_5)])).
test(partial_payment_is_not_eligible, fail) :-
    gdpr_joint_controllers_assess(claim_back_after_partial_payment, gdpr_joint_controllers_verdict(eligible, _)).
test(sole_responsible_party_is_ineligible) :-
    gdpr_joint_controllers_assess(sole_responsible_party, gdpr_joint_controllers_verdict(ineligible, [cite(eu_reg_2016_679_art_82_5)])).
test(sole_responsible_party_is_not_eligible, fail) :-
    gdpr_joint_controllers_assess(sole_responsible_party, gdpr_joint_controllers_verdict(eligible, _)).
test(party_not_responsible_is_ineligible) :-
    gdpr_joint_controllers_assess(party_not_responsible, gdpr_joint_controllers_verdict(ineligible, [cite(eu_reg_2016_679_art_82_5)])).
test(unsure_payment_is_indeterminate_without_citations) :-
    gdpr_joint_controllers_assess(claim_back_payment_unsure, gdpr_joint_controllers_verdict(indeterminate, [])).
test(unsure_payment_is_not_eligible, fail) :-
    gdpr_joint_controllers_assess(claim_back_payment_unsure, gdpr_joint_controllers_verdict(eligible, _)).

% ---- the three statutory queries on the fixtures ------------------------
test(full_payment_routes_a4_b5_c8) :-
    gdpr_joint_controllers_profile_for(claim_back_after_full_payment, Profile),
    rights_against_each_joint_controller(Profile, rights_exercisable_against_this_controller, RightsCitations),
    msort(RightsCitations, [cite(eu_reg_2016_679_art_26_3), cite(eu_reg_2016_679_art_28_10)]),
    liability_for_the_entire_damage(Profile, liable_for_the_entire_damage, [outside_fact(responsible_under_article_82_2_and_3, LiabilityAttested)], [cite(eu_reg_2016_679_art_82_4)]),
    recourse_after_full_compensation(Profile, Result, [outside_fact(responsible_under_article_82_2_and_3, RecourseAttested)], [cite(eu_reg_2016_679_art_82_5)]),
    Result == entitled_to_claim_back([processor_beta, controller_alpha]),
    member(attribute(responsible_under_article_82_2_and_3, Supplied), Profile),
    LiabilityAttested == Supplied,
    RecourseAttested == Supplied.
test(sole_responsible_party_routes_a1_b4_c2) :-
    gdpr_joint_controllers_profile_for(sole_responsible_party, Profile),
    rights_against_each_joint_controller(Profile, not_joint_controllers, [cite(eu_reg_2016_679_art_26_3)]),
    liability_for_the_entire_damage(Profile, no_other_responsible_party, [outside_fact(responsible_under_article_82_2_and_3, _)], [cite(eu_reg_2016_679_art_82_4)]),
    recourse_after_full_compensation(Profile, not_entitled_to_claim_back, [], [cite(eu_reg_2016_679_art_82_5)]).
test(party_not_responsible_routes_a3_b1_c1) :-
    gdpr_joint_controllers_profile_for(party_not_responsible, Profile),
    rights_against_each_joint_controller(Profile, RightsResult, []),
    RightsResult == needs_legal_review(open_textured(controllers_jointly_determine_purposes_and_means, cite(eu_reg_2016_679_art_26_3)), [inputs_relied_on([controllers_jointly_determine_purposes_and_means-unsure])]),
    liability_for_the_entire_damage(Profile, not_responsible_for_the_damage, [outside_fact(responsible_under_article_82_2_and_3, attested(false, _))], [cite(eu_reg_2016_679_art_82_4)]),
    recourse_after_full_compensation(Profile, not_entitled_to_claim_back, [outside_fact(responsible_under_article_82_2_and_3, attested(false, _))], [cite(eu_reg_2016_679_art_82_5)]).
test(absent_statement_routes_a2_b2_c4) :-
    gdpr_joint_controllers_profile_for(responsibility_statement_absent, Profile),
    absent_referral_term(Referral),
    rights_against_each_joint_controller(Profile, indeterminate([controllers_jointly_determine_purposes_and_means]), []),
    liability_for_the_entire_damage(Profile, LiabilityResult, [], []),
    LiabilityResult == Referral,
    recourse_after_full_compensation(Profile, RecourseResult, [], []),
    RecourseResult == Referral.
test(absent_parties_route_b3_c5) :-
    gdpr_joint_controllers_profile_for(other_parties_not_stated, Profile),
    liability_for_the_entire_damage(Profile, indeterminate([other_responsible_parties]), [], []),
    recourse_after_full_compensation(Profile, indeterminate([other_responsible_parties]), [], []).
test(absent_payment_routes_c6) :-
    gdpr_joint_controllers_profile_for(claim_back_payment_not_stated, Profile),
    recourse_after_full_compensation(Profile, indeterminate([full_compensation_paid]), [], []).
test(unsure_payment_routes_c7) :-
    gdpr_joint_controllers_profile_for(claim_back_payment_unsure, Profile),
    recourse_after_full_compensation(Profile, Result, [], []),
    Result == needs_legal_review(open_textured(full_compensation_paid, cite(eu_reg_2016_679_art_82_5)), [inputs_relied_on([full_compensation_paid-unsure])]).
test(partial_payment_routes_c3) :-
    gdpr_joint_controllers_profile_for(claim_back_after_partial_payment, Profile),
    recourse_after_full_compensation(Profile, not_entitled_to_claim_back, [], [cite(eu_reg_2016_679_art_82_5)]).

% ---- evidence terms: url(...) and document(...) in an attestation ------
test(url_evidence_is_well_formed_and_copied_into_the_basis) :-
    Attested = attested(true, attestation(host_service, attested_moment, stated_reason, url(source_address, retrieved_moment))),
    Profile = [attribute(responsible_under_article_82_2_and_3, Attested), attribute(other_responsible_parties, [controller_alpha]), attribute(full_compensation_paid, true)],
    gdpr_joint_controllers_input_problems(Profile, []),
    recourse_after_full_compensation(Profile, entitled_to_claim_back([controller_alpha]), Basis, [cite(eu_reg_2016_679_art_82_5)]),
    Basis == [outside_fact(responsible_under_article_82_2_and_3, Attested)].
test(document_evidence_is_well_formed_and_copied_into_the_basis) :-
    Attested = attested(false, attestation(host_service, attested_moment, stated_reason, document(upload_identifier, content_hash))),
    Profile = [attribute(responsible_under_article_82_2_and_3, Attested)],
    gdpr_joint_controllers_input_problems(Profile, []),
    liability_for_the_entire_damage(Profile, not_responsible_for_the_damage, Basis, [cite(eu_reg_2016_679_art_82_4)]),
    Basis == [outside_fact(responsible_under_article_82_2_and_3, Attested)].

% ---- input problems through the facade ----------------------------------
test(a_duplicate_key_is_an_input_problem_in_every_query) :-
    gdpr_joint_controllers_profile_for(duplicate_payment_key, Profile),
    gdpr_joint_controllers_input_problems(Profile, [duplicate_key(full_compensation_paid)]),
    rights_against_each_joint_controller(Profile, input_problems([duplicate_key(full_compensation_paid)]), []),
    liability_for_the_entire_damage(Profile, input_problems([duplicate_key(full_compensation_paid)]), [], []),
    recourse_after_full_compensation(Profile, input_problems([duplicate_key(full_compensation_paid)]), [], []).
test(an_arrangement_key_is_unknown) :-
    gdpr_joint_controllers_profile_for(arrangement_key_supplied, Profile),
    rights_against_each_joint_controller(Profile, input_problems([unknown_key(arrangement_terms)]), []).
test(a_number_in_the_party_list_is_a_wrong_type) :-
    gdpr_joint_controllers_input_problems([attribute(other_responsible_parties, [processor_beta, 42])], [wrong_type(other_responsible_parties)]).
test(a_non_list_profile_is_a_wrong_type) :-
    findall(Problems, gdpr_joint_controllers_input_problems(not_a_profile, Problems), Answers),
    Answers == [[wrong_type(profile)]].
test(a_well_formed_fixture_has_no_input_problem) :-
    gdpr_joint_controllers_profile_for(claim_back_after_full_payment, Profile),
    gdpr_joint_controllers_input_problems(Profile, []).

% ---- counting: exactly one solution per query per subject --------------
test(every_query_yields_exactly_one_solution_on_every_subject) :-
    findall(Subject, gdpr_joint_controllers_subject(Subject), Subjects),
    length(Subjects, Count),
    findall(Subject-Result, (gdpr_joint_controllers_subject(Subject), gdpr_joint_controllers_profile_for(Subject, Profile), rights_against_each_joint_controller(Profile, Result, _)), RightsAnswers),
    length(RightsAnswers, Count),
    findall(Subject-Result, (gdpr_joint_controllers_subject(Subject), gdpr_joint_controllers_profile_for(Subject, Profile), liability_for_the_entire_damage(Profile, Result, _, _)), LiabilityAnswers),
    length(LiabilityAnswers, Count),
    findall(Subject-Result, (gdpr_joint_controllers_subject(Subject), gdpr_joint_controllers_profile_for(Subject, Profile), recourse_after_full_compensation(Profile, Result, _, _)), RecourseAnswers),
    length(RecourseAnswers, Count).

% ---- checklist (justification): cited items -----------------------------
test(every_well_formed_subject_has_a_non_empty_cited_checklist) :-
    findall(Subject, well_formed_subject(Subject), Subjects),
    findall(Subject, (well_formed_subject(Subject), gdpr_joint_controllers_profile_for(Subject, Profile), gdpr_joint_controllers_checklist(Profile, [_|_])), CheckedSubjects),
    Subjects == CheckedSubjects,
    findall(Item, (well_formed_subject(Subject), gdpr_joint_controllers_profile_for(Subject, Profile), gdpr_joint_controllers_checklist(Profile, Items), member(Item, Items)), AllItems),
    findall(Item, (member(Item, AllItems), Item = item(_, _, cite(_))), CitedItems),
    AllItems == CitedItems.
test(the_eligible_checklist_is_all_met) :-
    gdpr_joint_controllers_profile_for(claim_back_after_full_payment, Profile),
    gdpr_joint_controllers_checklist(Profile, Items),
    Items == [item(responsible_under_article_82, met, cite(eu_reg_2016_679_art_82_4)), item(other_responsible_party_listed, met, cite(eu_reg_2016_679_art_82_4)), item(full_compensation_paid, met, cite(eu_reg_2016_679_art_82_5))].
test(the_partial_payment_checklist_names_the_unmet_payment) :-
    gdpr_joint_controllers_profile_for(claim_back_after_partial_payment, Profile),
    gdpr_joint_controllers_checklist(Profile, Items),
    member(item(full_compensation_paid, unmet(full_compensation_not_paid), cite(eu_reg_2016_679_art_82_5)), Items).
test(the_sole_party_checklist_names_the_missing_other_party) :-
    gdpr_joint_controllers_profile_for(sole_responsible_party, Profile),
    gdpr_joint_controllers_checklist(Profile, Items),
    member(item(other_responsible_party_listed, unmet(no_other_responsible_party), cite(eu_reg_2016_679_art_82_4)), Items).
test(a_malformed_subject_has_an_empty_checklist) :-
    gdpr_joint_controllers_profile_for(duplicate_payment_key, Profile),
    gdpr_joint_controllers_checklist(Profile, []).

% ---- status projection, resolvability and what-if -----------------------
test(the_status_projection_agrees_with_the_verdict) :-
    gdpr_joint_controllers_profile_for(claim_back_after_full_payment, Profile),
    gdpr_joint_controllers_status(Profile, eligible),
    decide_gdpr_joint_controllers(Profile, gdpr_joint_controllers_verdict(eligible, _)).
test(every_subject_is_resolvable) :-
    findall(Subject, gdpr_joint_controllers_subject(Subject), Subjects),
    findall(Subject, (gdpr_joint_controllers_subject(Subject), gdpr_joint_controllers_profile_for(Subject, Profile), gdpr_joint_controllers_decision_resolvable(Profile)), Resolved),
    Subjects == Resolved.
test(a_full_payment_flips_the_partial_payment_to_eligible) :-
    gdpr_joint_controllers_profile_for(claim_back_after_partial_payment, Profile),
    gdpr_joint_controllers_what_if(Profile, full_compensation_paid, true, eligible).
test(an_empty_party_list_flips_the_full_payment_to_ineligible) :-
    gdpr_joint_controllers_profile_for(claim_back_after_full_payment, Profile),
    gdpr_joint_controllers_what_if(Profile, other_responsible_parties, [], ineligible).
test(an_empty_party_list_does_not_keep_the_full_payment_eligible, fail) :-
    gdpr_joint_controllers_profile_for(claim_back_after_full_payment, Profile),
    gdpr_joint_controllers_what_if(Profile, other_responsible_parties, [], eligible).

:- end_module(test_public_interface).
