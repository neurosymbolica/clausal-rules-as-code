% ---- Convenience wrapper ---------------------------------------------
gdpr_churches_and_religious_associations_assess(Subject, Result) :-
    gdpr_churches_and_religious_associations_profile_for(Subject, Profile),
    decide_gdpr_churches_and_religious_associations(Profile, Result).

:- end_module(fixtures).
