% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% fixtures.clausal -- representative profiles for eu/data_protection/gdpr_churches_and_religious_associations.
% A TOP-LAYER consumer: it imports the determination slice's PUBLIC
% predicate it calls -- that is the whole import list. Profile keys and
% subject ids are atoms and need no import.
%
% A profile is an ATTRIBUTE LIST [attribute(Key, Value), ...] (the order's
% typed input contract). Article 91 has no threshold, so the near-miss
% controls are ONE-KEY flips: each route's positive subject is paired with
% a subject that differs from it in one key and gets another answer.
%
% Routes and their controls (expected answers are asserted in
% tests/test_public_interface.clausal):
%   rules_continue_authority_not_specific -- every Art 91(1) condition holds,
%     authority not specific: may continue / subject to an independent
%     supervisory authority. Its one-key controls, each a false condition
%     (not covered / Art 91(2) not engaged):
%       body_not_a_church, rules_not_applied_in_a_member_state,
%       rules_not_comprehensive, rules_not_applied_at_entry_into_force,
%       rules_not_brought_into_line;
%     its one-key referral controls: entry_into_force_not_attested,
%       comprehensive_rules_unsure, bringing_into_line_unsure;
%     its one-key missing-key control: body_status_not_stated;
%     its irrelevance control: chapter_vi_stated_for_authority_not_specific.
%   specific_authority_fulfils_chapter_vi -- permitted; controls
%     specific_authority_fails_chapter_vi (not permitted),
%     specific_authority_chapter_vi_not_stated (referred) and
%     authority_specificity_not_stated (indeterminate).
%   two_conditions_false -- two false conditions, still one answer.
%   crisp_key_given_unsure -- an input problem.
% =====================================================================

:- module(fixtures, [
    gdpr_churches_and_religious_associations_subject/1,
    gdpr_churches_and_religious_associations_profile_for/2,
    gdpr_churches_and_religious_associations_assess/2
]).

:- use_module(eu/data_protection/gdpr_churches_and_religious_associations/gdpr_churches_and_religious_associations, [decide_gdpr_churches_and_religious_associations/2]).

% ---- Subject registry ------------------------------------------------
gdpr_churches_and_religious_associations_subject(rules_continue_authority_not_specific).
gdpr_churches_and_religious_associations_subject(body_not_a_church).
gdpr_churches_and_religious_associations_subject(rules_not_applied_in_a_member_state).
gdpr_churches_and_religious_associations_subject(rules_not_comprehensive).
gdpr_churches_and_religious_associations_subject(rules_not_applied_at_entry_into_force).
gdpr_churches_and_religious_associations_subject(rules_not_brought_into_line).
gdpr_churches_and_religious_associations_subject(specific_authority_fulfils_chapter_vi).
gdpr_churches_and_religious_associations_subject(specific_authority_fails_chapter_vi).
gdpr_churches_and_religious_associations_subject(specific_authority_chapter_vi_not_stated).
gdpr_churches_and_religious_associations_subject(authority_specificity_not_stated).
gdpr_churches_and_religious_associations_subject(entry_into_force_not_attested).
gdpr_churches_and_religious_associations_subject(comprehensive_rules_unsure).
gdpr_churches_and_religious_associations_subject(bringing_into_line_unsure).
gdpr_churches_and_religious_associations_subject(body_status_not_stated).
gdpr_churches_and_religious_associations_subject(chapter_vi_stated_for_authority_not_specific).
gdpr_churches_and_religious_associations_subject(two_conditions_false).
gdpr_churches_and_religious_associations_subject(crisp_key_given_unsure).

% ---- Attested outside facts (plumbing) -------------------------------
entry_attested(Value, attested(Value, attestation(host, moment_of_the_question, statement_of_the_body, none))).
chapter_attested(Value, attested(Value, attestation(host, moment_of_the_question, statement_on_the_authority, none))).

% ---- Profiles --------------------------------------------------------
gdpr_churches_and_religious_associations_profile_for(rules_continue_authority_not_specific, Profile) :-
    entry_attested(true, Entry),
    Profile = [
        attribute(body_is_church_or_religious_association_or_community, true),
        attribute(rules_applied_in_a_member_state, true),
        attribute(comprehensive_rules_relating_to_protection_with_regard_to_processing, true),
        attribute(rules_applied_at_entry_into_force_of_the_regulation, Entry),
        attribute(rules_brought_into_line_with_the_regulation, true),
        attribute(supervisory_authority_is_specific, false)
    ].
gdpr_churches_and_religious_associations_profile_for(body_not_a_church, Profile) :-
    entry_attested(true, Entry),
    Profile = [
        attribute(body_is_church_or_religious_association_or_community, false),
        attribute(rules_applied_in_a_member_state, true),
        attribute(comprehensive_rules_relating_to_protection_with_regard_to_processing, true),
        attribute(rules_applied_at_entry_into_force_of_the_regulation, Entry),
        attribute(rules_brought_into_line_with_the_regulation, true),
        attribute(supervisory_authority_is_specific, false)
    ].
