% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/data_protection/gdpr_information_duties_headline_verdict.
%
% Sources: Regulation (EU) 2016/679 (GDPR) Arts 4, 13, 14 (consolidated text of
% 02016R0679-20160504) and Regulation (EEC, Euratom) No 1182/71 Art 3.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order.
% Definitions (Art 4) are recorded for reasoning and provenance; they never enter a CITES list.
% The 1182/71 keys are implements/1 markers only; they never enter a result.
% implements(Key) succeeds for every recorded key.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

implements(Key) :-
    citation(Key, _).

citation(eu_reg_2016_679_art_13_1, [label-'GDPR Art 13(1) chapeau', ref-'Regulation (EU) 2016/679 Art 13(1); unit 02016R0679-20160504#parag_013.001', verbatim-'the controller shall, at the time when personal data are obtained, provide the data subject with all of the following information']).
citation(eu_reg_2016_679_art_13_1_a, [label-'GDPR Art 13(1)(a)', ref-'Regulation (EU) 2016/679 Art 13(1)(a); unit 02016R0679-20160504#point_013.001_a', verbatim-'the identity and the contact details of the controller']).
citation(eu_reg_2016_679_art_13_1_b, [label-'GDPR Art 13(1)(b)', ref-'Regulation (EU) 2016/679 Art 13(1)(b); unit 02016R0679-20160504#point_013.001_b', verbatim-'the contact details of the data protection officer, where applicable']).
citation(eu_reg_2016_679_art_13_1_c, [label-'GDPR Art 13(1)(c)', ref-'Regulation (EU) 2016/679 Art 13(1)(c); unit 02016R0679-20160504#point_013.001_c', verbatim-'the purposes of the processing for which the personal data are intended as well as the legal basis for the processing']).
citation(eu_reg_2016_679_art_13_1_d, [label-'GDPR Art 13(1)(d)', ref-'Regulation (EU) 2016/679 Art 13(1)(d); unit 02016R0679-20160504#point_013.001_d', verbatim-'the legitimate interests pursued by the controller or by a third party']).
citation(eu_reg_2016_679_art_13_1_e, [label-'GDPR Art 13(1)(e)', ref-'Regulation (EU) 2016/679 Art 13(1)(e); unit 02016R0679-20160504#point_013.001_e', verbatim-'the recipients or categories of recipients of the personal data, if any']).
citation(eu_reg_2016_679_art_13_1_f, [label-'GDPR Art 13(1)(f)', ref-'Regulation (EU) 2016/679 Art 13(1)(f); unit 02016R0679-20160504#point_013.001_f', verbatim-'the fact that the controller intends to transfer personal data to a third country or international organisation']).
citation(eu_reg_2016_679_art_13_2_a, [label-'GDPR Art 13(2)(a)', ref-'Regulation (EU) 2016/679 Art 13(2)(a); unit 02016R0679-20160504#point_013.002_a', verbatim-'the period for which the personal data will be stored, or if that is not possible, the criteria used to determine that period']).
citation(eu_reg_2016_679_art_13_2_b, [label-'GDPR Art 13(2)(b)', ref-'Regulation (EU) 2016/679 Art 13(2)(b); unit 02016R0679-20160504#point_013.002_b', verbatim-'the existence of the right to request from the controller access to and rectification or erasure of personal data']).
citation(eu_reg_2016_679_art_13_2_c, [label-'GDPR Art 13(2)(c)', ref-'Regulation (EU) 2016/679 Art 13(2)(c); unit 02016R0679-20160504#point_013.002_c', verbatim-'the existence of the right to withdraw consent at any time']).
citation(eu_reg_2016_679_art_13_2_d, [label-'GDPR Art 13(2)(d)', ref-'Regulation (EU) 2016/679 Art 13(2)(d); unit 02016R0679-20160504#point_013.002_d', verbatim-'the right to lodge a complaint with a supervisory authority']).
citation(eu_reg_2016_679_art_13_2_e, [label-'GDPR Art 13(2)(e)', ref-'Regulation (EU) 2016/679 Art 13(2)(e); unit 02016R0679-20160504#point_013.002_e', verbatim-'whether the provision of personal data is a statutory or contractual requirement']).
citation(eu_reg_2016_679_art_13_2_f, [label-'GDPR Art 13(2)(f)', ref-'Regulation (EU) 2016/679 Art 13(2)(f); unit 02016R0679-20160504#point_013.002_f', verbatim-'the existence of automated decision-making, including profiling, referred to in Article 22(1) and (4)']).
citation(eu_reg_2016_679_art_13_3, [label-'GDPR Art 13(3) further processing', ref-'Regulation (EU) 2016/679 Art 13(3); unit 02016R0679-20160504#parag_013.003', verbatim-'the controller shall provide the data subject prior to that further processing with information on that other purpose']).
citation(eu_reg_2016_679_art_13_4, [label-'GDPR Art 13(4) data subject already has the information', ref-'Regulation (EU) 2016/679 Art 13(4); unit 02016R0679-20160504#parag_013.004', verbatim-'Paragraphs 1, 2 and 3 shall not apply where and insofar as the data subject already has the information.']).
citation(eu_reg_2016_679_art_14_1, [label-'GDPR Art 14(1) chapeau', ref-'Regulation (EU) 2016/679 Art 14(1); unit 02016R0679-20160504#parag_014.001', verbatim-'Where personal data have not been obtained from the data subject, the controller shall provide the data subject with the following information']).
citation(eu_reg_2016_679_art_14_1_a, [label-'GDPR Art 14(1)(a)', ref-'Regulation (EU) 2016/679 Art 14(1)(a); unit 02016R0679-20160504#point_014.001_a', verbatim-'the identity and the contact details of the controller']).
citation(eu_reg_2016_679_art_14_1_b, [label-'GDPR Art 14(1)(b)', ref-'Regulation (EU) 2016/679 Art 14(1)(b); unit 02016R0679-20160504#point_014.001_b', verbatim-'the contact details of the data protection officer, where applicable']).
citation(eu_reg_2016_679_art_14_1_c, [label-'GDPR Art 14(1)(c)', ref-'Regulation (EU) 2016/679 Art 14(1)(c); unit 02016R0679-20160504#point_014.001_c', verbatim-'the purposes of the processing for which the personal data are intended as well as the legal basis for the processing']).
citation(eu_reg_2016_679_art_14_1_d, [label-'GDPR Art 14(1)(d)', ref-'Regulation (EU) 2016/679 Art 14(1)(d); unit 02016R0679-20160504#point_014.001_d', verbatim-'the categories of personal data concerned']).
citation(eu_reg_2016_679_art_14_1_e, [label-'GDPR Art 14(1)(e)', ref-'Regulation (EU) 2016/679 Art 14(1)(e); unit 02016R0679-20160504#point_014.001_e', verbatim-'the recipients or categories of recipients of the personal data, if any']).
citation(eu_reg_2016_679_art_14_1_f, [label-'GDPR Art 14(1)(f)', ref-'Regulation (EU) 2016/679 Art 14(1)(f); unit 02016R0679-20160504#point_014.001_f', verbatim-'that the controller intends to transfer personal data to a recipient in a third country or international organisation']).
citation(eu_reg_2016_679_art_14_2_a, [label-'GDPR Art 14(2)(a)', ref-'Regulation (EU) 2016/679 Art 14(2)(a); unit 02016R0679-20160504#point_014.002_a', verbatim-'the period for which the personal data will be stored, or if that is not possible, the criteria used to determine that period']).
citation(eu_reg_2016_679_art_14_2_b, [label-'GDPR Art 14(2)(b)', ref-'Regulation (EU) 2016/679 Art 14(2)(b); unit 02016R0679-20160504#point_014.002_b', verbatim-'the legitimate interests pursued by the controller or by a third party']).
citation(eu_reg_2016_679_art_14_2_c, [label-'GDPR Art 14(2)(c)', ref-'Regulation (EU) 2016/679 Art 14(2)(c); unit 02016R0679-20160504#point_014.002_c', verbatim-'the existence of the right to request from the controller access to and rectification or erasure of personal data or restriction of processing concerning the data subject and to object to processing']).
citation(eu_reg_2016_679_art_14_2_d, [label-'GDPR Art 14(2)(d)', ref-'Regulation (EU) 2016/679 Art 14(2)(d); unit 02016R0679-20160504#point_014.002_d', verbatim-'the existence of the right to withdraw consent at any time']).
citation(eu_reg_2016_679_art_14_2_e, [label-'GDPR Art 14(2)(e)', ref-'Regulation (EU) 2016/679 Art 14(2)(e); unit 02016R0679-20160504#point_014.002_e', verbatim-'the right to lodge a complaint with a supervisory authority']).
citation(eu_reg_2016_679_art_14_2_f, [label-'GDPR Art 14(2)(f)', ref-'Regulation (EU) 2016/679 Art 14(2)(f); unit 02016R0679-20160504#point_014.002_f', verbatim-'from which source the personal data originate']).
citation(eu_reg_2016_679_art_14_2_g, [label-'GDPR Art 14(2)(g)', ref-'Regulation (EU) 2016/679 Art 14(2)(g); unit 02016R0679-20160504#point_014.002_g', verbatim-'the existence of automated decision-making, including profiling, referred to in Article 22(1) and (4)']).
citation(eu_reg_2016_679_art_14_3, [label-'GDPR Art 14(3) chapeau', ref-'Regulation (EU) 2016/679 Art 14(3); unit 02016R0679-20160504#parag_014.003', verbatim-'The controller shall provide the information referred to in paragraphs 1 and 2']).
citation(eu_reg_2016_679_art_14_3_a, [label-'GDPR Art 14(3)(a) reasonable period, at the latest one month', ref-'Regulation (EU) 2016/679 Art 14(3)(a); unit 02016R0679-20160504#point_014.003_a', verbatim-'within a reasonable period after obtaining the personal data, but at the latest within one month']).
citation(eu_reg_2016_679_art_14_3_b, [label-'GDPR Art 14(3)(b) first communication', ref-'Regulation (EU) 2016/679 Art 14(3)(b); unit 02016R0679-20160504#point_014.003_b', verbatim-'at the latest at the time of the first communication to that data subject']).
citation(eu_reg_2016_679_art_14_3_c, [label-'GDPR Art 14(3)(c) first disclosure', ref-'Regulation (EU) 2016/679 Art 14(3)(c); unit 02016R0679-20160504#point_014.003_c', verbatim-'at the latest when the personal data are first disclosed']).
citation(eu_reg_2016_679_art_14_4, [label-'GDPR Art 14(4) further processing', ref-'Regulation (EU) 2016/679 Art 14(4); unit 02016R0679-20160504#parag_014.004', verbatim-'the controller shall provide the data subject prior to that further processing with information on that other purpose']).
citation(eu_reg_2016_679_art_14_5, [label-'GDPR Art 14(5) chapeau', ref-'Regulation (EU) 2016/679 Art 14(5); unit 02016R0679-20160504#parag_014.005', verbatim-'Paragraphs 1 to 4 shall not apply where and insofar as']).
citation(eu_reg_2016_679_art_14_5_a, [label-'GDPR Art 14(5)(a) data subject already has the information', ref-'Regulation (EU) 2016/679 Art 14(5)(a); unit 02016R0679-20160504#point_014.005_a', verbatim-'the data subject already has the information']).
citation(eu_reg_2016_679_art_14_5_b, [label-'GDPR Art 14(5)(b) impossible or disproportionate effort', ref-'Regulation (EU) 2016/679 Art 14(5)(b); unit 02016R0679-20160504#point_014.005_b', verbatim-'the provision of such information proves impossible or would involve a disproportionate effort']).
citation(eu_reg_2016_679_art_14_5_c, [label-'GDPR Art 14(5)(c) obtaining or disclosure laid down by law', ref-'Regulation (EU) 2016/679 Art 14(5)(c); unit 02016R0679-20160504#point_014.005_c', verbatim-'obtaining or disclosure is expressly laid down by Union or Member State law to which the controller is subject']).
citation(eu_reg_2016_679_art_14_5_d, [label-'GDPR Art 14(5)(d) professional secrecy', ref-'Regulation (EU) 2016/679 Art 14(5)(d); unit 02016R0679-20160504#point_014.005_d', verbatim-'the personal data must remain confidential subject to an obligation of professional secrecy regulated by Union or Member State law']).
citation(eu_reg_2016_679_art_4_1, [label-'GDPR Art 4(1) definition of personal data and data subject', ref-'Regulation (EU) 2016/679 Art 4(1); unit 02016R0679-20160504#point_004_1', verbatim-'personal data means any information relating to an identified or identifiable natural person (data subject)']).
citation(eu_reg_2016_679_art_4_4, [label-'GDPR Art 4(4) definition of profiling', ref-'Regulation (EU) 2016/679 Art 4(4); unit 02016R0679-20160504#point_004_4', verbatim-'profiling means any form of automated processing of personal data']).
citation(eu_reg_2016_679_art_4_7, [label-'GDPR Art 4(7) definition of controller', ref-'Regulation (EU) 2016/679 Art 4(7); unit 02016R0679-20160504#point_004_7', verbatim-'controller means the natural or legal person, public authority, agency or other body which, alone or jointly with others, determines the purposes and means of the processing of personal data']).
citation(eu_reg_2016_679_art_4_9, [label-'GDPR Art 4(9) definition of recipient', ref-'Regulation (EU) 2016/679 Art 4(9); unit 02016R0679-20160504#point_004_9', verbatim-'recipient means a natural or legal person, public authority, agency or another body, to which the personal data are disclosed, whether a third party or not']).
citation(eu_reg_1971_1182_art_3, [label-'Regulation (EEC, Euratom) No 1182/71 Art 3 (periods), applied to the GDPR by operator order G4', ref-'CELEX 31971R1182, OJ L 124, 8.6.1971, Art 3', verbatim-'the day during which that event occurs or that action takes place shall not be considered as falling within the period in question']).
citation(eu_reg_1971_1182_art_3_1, [label-'Regulation 1182/71 Art 3(1) second subparagraph: the event day is not counted', ref-'CELEX 31971R1182, OJ L 124, 8.6.1971, Art 3(1)', verbatim-'the day during which that event occurs or that action takes place shall not be considered as falling within the period in question']).
citation(eu_reg_1971_1182_art_3_2_c, [label-'Regulation 1182/71 Art 3(2)(c): a period in months', ref-'CELEX 31971R1182, OJ L 124, 8.6.1971, Art 3(2)(c)', verbatim-'the period shall end with the expiry of the last hour of the last day of that month']).
citation(eu_reg_1971_1182_art_3_4, [label-'Regulation 1182/71 Art 3(4): a last day on a public holiday, Sunday or Saturday', ref-'CELEX 31971R1182, OJ L 124, 8.6.1971, Art 3(4)', verbatim-'the period shall end with the expiry of the last hour of the following working day']).

:- end_module(citations).
