% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/data_protection/gdpr_information_duties_headline_verdict.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% The verbatim pair is OMITTED while the key's entry in
% citations-sources.yaml is `status: unverified`.
%
% Instruments:
% - Regulation (EU) 2016/679 (GDPR), pinned consolidated text
%   02016R0679-20160504 (with the 2018 corrigendum): Arts 4(1), 4(4),
%   4(7), 4(9), 13 and 14.
% - Regulation (EEC, Euratom) No 1182/71 (CELEX 31971R1182, OJ L 124,
%   8.6.1971): Art 2(2), Art 3(1), Art 3(2)(c), Art 3(4), applied to the
%   GDPR's periods by the order (PERIODS, G4).
%
% CITES discipline (reading 13): only the GDPR Art 13 and Art 14 keys of
% the order's citation vocabulary ever enter a CITES list. The Art 4
% definitions, Art 13(4), Art 14(5) chapeau and (a), the paragraph
% chapeaux 13(2), 14(2), 14(3), 14(5) and every Regulation 1182/71 key
% are provenance only: they mark clauses with implements/1 and are never
% returned in a result.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

% implements(Key): the provenance marker. It succeeds for every recorded
% key and fails for a key not recorded here.
implements(Key) :-
    citation(Key, _).

% ---- GDPR Art 13: data collected from the data subject -------------
citation(eu_reg_2016_679_art_13_1, [label-'Regulation (EU) 2016/679 Art 13(1) (chapeau)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit parag_013.001)', verbatim-'Where personal data relating to a data subject are collected from the data subject, the controller shall, at the time when personal data are obtained, provide the data subject with all of the following information']).
citation(eu_reg_2016_679_art_13_1_a, [label-'Regulation (EU) 2016/679 Art 13(1)(a)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_013.001_a)', verbatim-'the identity and the contact details of the controller']).
citation(eu_reg_2016_679_art_13_1_b, [label-'Regulation (EU) 2016/679 Art 13(1)(b)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_013.001_b)', verbatim-'the contact details of the data protection officer, where applicable']).
citation(eu_reg_2016_679_art_13_1_c, [label-'Regulation (EU) 2016/679 Art 13(1)(c)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_013.001_c)', verbatim-'the purposes of the processing for which the personal data are intended as well as the legal basis for the processing']).
citation(eu_reg_2016_679_art_13_1_d, [label-'Regulation (EU) 2016/679 Art 13(1)(d)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_013.001_d)', verbatim-'where the processing is based on point (f) of Article 6(1), the legitimate interests pursued by the controller or by a third party']).
citation(eu_reg_2016_679_art_13_1_e, [label-'Regulation (EU) 2016/679 Art 13(1)(e)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_013.001_e)', verbatim-'the recipients or categories of recipients of the personal data, if any']).
citation(eu_reg_2016_679_art_13_1_f, [label-'Regulation (EU) 2016/679 Art 13(1)(f)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_013.001_f)', verbatim-'where applicable, the fact that the controller intends to transfer personal data to a third country or international organisation']).
citation(eu_reg_2016_679_art_13_2, [label-'Regulation (EU) 2016/679 Art 13(2) (chapeau)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit parag_013.002)', verbatim-'In addition to the information referred to in paragraph 1, the controller shall, at the time when personal data are obtained, provide the data subject with the following further information necessary to ensure fair and transparent processing']).
citation(eu_reg_2016_679_art_13_2_a, [label-'Regulation (EU) 2016/679 Art 13(2)(a)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_013.002_a)', verbatim-'the period for which the personal data will be stored, or if that is not possible, the criteria used to determine that period']).
citation(eu_reg_2016_679_art_13_2_b, [label-'Regulation (EU) 2016/679 Art 13(2)(b)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_013.002_b)', verbatim-'the existence of the right to request from the controller access to and rectification or erasure of personal data']).
citation(eu_reg_2016_679_art_13_2_c, [label-'Regulation (EU) 2016/679 Art 13(2)(c)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_013.002_c)', verbatim-'where the processing is based on point (a) of Article 6(1) or point (a) of Article 9(2), the existence of the right to withdraw consent at any time']).
citation(eu_reg_2016_679_art_13_2_d, [label-'Regulation (EU) 2016/679 Art 13(2)(d)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_013.002_d)', verbatim-'the right to lodge a complaint with a supervisory authority']).
citation(eu_reg_2016_679_art_13_2_e, [label-'Regulation (EU) 2016/679 Art 13(2)(e)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_013.002_e)', verbatim-'whether the provision of personal data is a statutory or contractual requirement']).
citation(eu_reg_2016_679_art_13_2_f, [label-'Regulation (EU) 2016/679 Art 13(2)(f)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_013.002_f)', verbatim-'the existence of automated decision-making, including profiling, referred to in Article 22(1) and (4)']).
citation(eu_reg_2016_679_art_13_3, [label-'Regulation (EU) 2016/679 Art 13(3) (further processing)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit parag_013.003)', verbatim-'the controller shall provide the data subject prior to that further processing with information on that other purpose and with any relevant further information as referred to in paragraph 2']).
citation(eu_reg_2016_679_art_13_4, [label-'Regulation (EU) 2016/679 Art 13(4) (data subject already has the information)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit parag_013.004)', verbatim-'Paragraphs 1, 2 and 3 shall not apply where and insofar as the data subject already has the information.']).

% ---- GDPR Art 14: data not obtained from the data subject ----------
citation(eu_reg_2016_679_art_14_1, [label-'Regulation (EU) 2016/679 Art 14(1) (chapeau)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit parag_014.001)', verbatim-'Where personal data have not been obtained from the data subject, the controller shall provide the data subject with the following information']).
citation(eu_reg_2016_679_art_14_1_a, [label-'Regulation (EU) 2016/679 Art 14(1)(a)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_014.001_a)', verbatim-'the identity and the contact details of the controller']).
citation(eu_reg_2016_679_art_14_1_b, [label-'Regulation (EU) 2016/679 Art 14(1)(b)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_014.001_b)', verbatim-'the contact details of the data protection officer, where applicable']).
citation(eu_reg_2016_679_art_14_1_c, [label-'Regulation (EU) 2016/679 Art 14(1)(c)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_014.001_c)', verbatim-'the purposes of the processing for which the personal data are intended as well as the legal basis for the processing']).
citation(eu_reg_2016_679_art_14_1_d, [label-'Regulation (EU) 2016/679 Art 14(1)(d)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_014.001_d)', verbatim-'the categories of personal data concerned']).
citation(eu_reg_2016_679_art_14_1_e, [label-'Regulation (EU) 2016/679 Art 14(1)(e)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_014.001_e)', verbatim-'the recipients or categories of recipients of the personal data, if any']).
citation(eu_reg_2016_679_art_14_1_f, [label-'Regulation (EU) 2016/679 Art 14(1)(f)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_014.001_f)', verbatim-'where applicable, that the controller intends to transfer personal data to a recipient in a third country or international organisation']).
citation(eu_reg_2016_679_art_14_2, [label-'Regulation (EU) 2016/679 Art 14(2) (chapeau)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit parag_014.002)', verbatim-'In addition to the information referred to in paragraph 1, the controller shall provide the data subject with the following information necessary to ensure fair and transparent processing in respect of the data subject']).
citation(eu_reg_2016_679_art_14_2_a, [label-'Regulation (EU) 2016/679 Art 14(2)(a)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_014.002_a)', verbatim-'the period for which the personal data will be stored, or if that is not possible, the criteria used to determine that period']).
citation(eu_reg_2016_679_art_14_2_b, [label-'Regulation (EU) 2016/679 Art 14(2)(b)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_014.002_b)', verbatim-'where the processing is based on point (f) of Article 6(1), the legitimate interests pursued by the controller or by a third party']).
citation(eu_reg_2016_679_art_14_2_c, [label-'Regulation (EU) 2016/679 Art 14(2)(c)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_014.002_c)', verbatim-'the existence of the right to request from the controller access to and rectification or erasure of personal data']).
citation(eu_reg_2016_679_art_14_2_d, [label-'Regulation (EU) 2016/679 Art 14(2)(d)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_014.002_d)', verbatim-'where processing is based on point (a) of Article 6(1) or point (a) of Article 9(2), the existence of the right to withdraw consent at any time']).
citation(eu_reg_2016_679_art_14_2_e, [label-'Regulation (EU) 2016/679 Art 14(2)(e)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_014.002_e)', verbatim-'the right to lodge a complaint with a supervisory authority']).
citation(eu_reg_2016_679_art_14_2_f, [label-'Regulation (EU) 2016/679 Art 14(2)(f)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_014.002_f)', verbatim-'from which source the personal data originate, and if applicable, whether it came from publicly accessible sources']).
citation(eu_reg_2016_679_art_14_2_g, [label-'Regulation (EU) 2016/679 Art 14(2)(g)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_014.002_g)', verbatim-'the existence of automated decision-making, including profiling, referred to in Article 22(1) and (4)']).
citation(eu_reg_2016_679_art_14_3, [label-'Regulation (EU) 2016/679 Art 14(3) (chapeau, time limits)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit parag_014.003)', verbatim-'The controller shall provide the information referred to in paragraphs 1 and 2']).
citation(eu_reg_2016_679_art_14_3_a, [label-'Regulation (EU) 2016/679 Art 14(3)(a)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_014.003_a)', verbatim-'within a reasonable period after obtaining the personal data, but at the latest within one month, having regard to the specific circumstances in which the personal data are processed']).
citation(eu_reg_2016_679_art_14_3_b, [label-'Regulation (EU) 2016/679 Art 14(3)(b)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_014.003_b)', verbatim-'if the personal data are to be used for communication with the data subject, at the latest at the time of the first communication to that data subject']).
citation(eu_reg_2016_679_art_14_3_c, [label-'Regulation (EU) 2016/679 Art 14(3)(c)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_014.003_c)', verbatim-'if a disclosure to another recipient is envisaged, at the latest when the personal data are first disclosed']).
citation(eu_reg_2016_679_art_14_4, [label-'Regulation (EU) 2016/679 Art 14(4) (further processing)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit parag_014.004)', verbatim-'Where the controller intends to further process the personal data for a purpose other than that for which the personal data were obtained']).
citation(eu_reg_2016_679_art_14_5, [label-'Regulation (EU) 2016/679 Art 14(5) (chapeau, exemptions)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit parag_014.005)', verbatim-'Paragraphs 1 to 4 shall not apply where and insofar as']).
citation(eu_reg_2016_679_art_14_5_a, [label-'Regulation (EU) 2016/679 Art 14(5)(a) (data subject already has the information)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_014.005_a)', verbatim-'the data subject already has the information']).
citation(eu_reg_2016_679_art_14_5_b, [label-'Regulation (EU) 2016/679 Art 14(5)(b) (impossible or disproportionate effort)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_014.005_b)', verbatim-'the provision of such information proves impossible or would involve a disproportionate effort']).
citation(eu_reg_2016_679_art_14_5_c, [label-'Regulation (EU) 2016/679 Art 14(5)(c) (obtaining or disclosure laid down by law)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_014.005_c)', verbatim-'obtaining or disclosure is expressly laid down by Union or Member State law to which the controller is subject']).
citation(eu_reg_2016_679_art_14_5_d, [label-'Regulation (EU) 2016/679 Art 14(5)(d) (professional secrecy)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_014.005_d)', verbatim-'where the personal data must remain confidential subject to an obligation of professional secrecy regulated by Union or Member State law, including a statutory obligation of secrecy']).

% ---- GDPR Art 4 definitions (reasoning only, never in CITES) -------
citation(eu_reg_2016_679_art_4_1, [label-'Regulation (EU) 2016/679 Art 4(1) definition of data subject (within personal data)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_004_1)', verbatim-'any information relating to an identified or identifiable natural person (data subject)']).
citation(eu_reg_2016_679_art_4_4, [label-'Regulation (EU) 2016/679 Art 4(4) definition of profiling', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_004_4)', verbatim-'any form of automated processing of personal data consisting of the use of personal data to evaluate certain personal aspects relating to a natural person']).
citation(eu_reg_2016_679_art_4_7, [label-'Regulation (EU) 2016/679 Art 4(7) definition of controller', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_004_7)', verbatim-'the natural or legal person, public authority, agency or other body which, alone or jointly with others, determines the purposes and means of the processing of personal data']).
citation(eu_reg_2016_679_art_4_9, [label-'Regulation (EU) 2016/679 Art 4(9) definition of recipient', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_004_9)', verbatim-'a natural or legal person, public authority, agency or another body, to which the personal data are disclosed, whether a third party or not']).

% ---- Regulation (EEC, Euratom) No 1182/71 (PERIODS; never in CITES) -
citation(eu_reg_1971_1182_art_3, [label-'Regulation (EEC, Euratom) No 1182/71 Art 3 (calculation of periods)', ref-'http://publications.europa.eu/resource/celex/31971R1182.ENG.fmx4 (Article 3)', verbatim-'Where a period expressed in days, weeks, months or years is to be calculated from the moment at which an event occurs or an action takes place']).
citation(eu_reg_1971_1182_art_3_1, [label-'Regulation (EEC, Euratom) No 1182/71 Art 3(1) second subparagraph (day of the event not counted)', ref-'http://publications.europa.eu/resource/celex/31971R1182.ENG.fmx4 (unit parag_003.001)', verbatim-'the day during which that event occurs or that action takes place shall not be considered as falling within the period in question']).
citation(eu_reg_1971_1182_art_3_2_c, [label-'Regulation (EEC, Euratom) No 1182/71 Art 3(2)(c) (end of a period in months)', ref-'http://publications.europa.eu/resource/celex/31971R1182.ENG.fmx4 (unit point_003.002_c)', verbatim-'If, in a period expressed in months or in years, the day on which it should expire does not occur in the last month, the period shall end with the expiry of the last hour of the last day of that month']).
citation(eu_reg_1971_1182_art_3_4, [label-'Regulation (EEC, Euratom) No 1182/71 Art 3(4) (last day on a Saturday, Sunday or public holiday)', ref-'http://publications.europa.eu/resource/celex/31971R1182.ENG.fmx4 (unit parag_003.004)', verbatim-'the period shall end with the expiry of the last hour of the following working day']).
citation(eu_reg_1971_1182_art_2_2, [label-'Regulation (EEC, Euratom) No 1182/71 Art 2(2) definition of working days', ref-'http://publications.europa.eu/resource/celex/31971R1182.ENG.fmx4 (unit parag_002.002)']).

test(a_recorded_key_is_implemented) :-
    implements(eu_reg_2016_679_art_14_3_a).
% (b) THE TEST WAS WRONG: eu_reg_2016_679_art_14_3 (the Art 14(3) chapeau) IS recorded above as a provenance key; GDPR Art 14 has no paragraph 6, so art_14_6 is truly unrecorded.
test(an_unrecorded_key_is_not_implemented, fail) :-
    implements(eu_reg_2016_679_art_14_6).

:- end_module(citations).
