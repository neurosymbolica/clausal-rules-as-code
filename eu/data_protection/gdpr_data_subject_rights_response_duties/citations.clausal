% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/data_protection/gdpr_data_subject_rights_response_duties.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% The verbatim pair is OMITTED while the key's entry in
% citations-sources.yaml is `status: unverified`; `status: verified`
% records carry a verbatim that is an exact substring of the pinned unit
% text (GDPR consolidated text 02016R0679-20160504; Regulation (EEC,
% Euratom) No 1182/71, Formex extracts of CELEX 31971R1182).
%
% Keys returned in results (the corpus lexicon's canonical keys) and keys
% recorded only for provenance markers (never returned) live side by side.
% The calendar keys eu_reg_1971_1182_art_3_1, _3_2_c and _3_4 are
% implements/1 markers only: they NEVER enter a CITES list.
% The five TARGET keys at the end name the outside law an outside fact
% stands for (the order's outside_facts table); they appear only as the
% second cite term of a cross_reference_unresolved referral and in
% resolution(cite(Target), not_attempted).
%
% PROVENANCE: every operative clause opens its body with implements(Key).
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

% ---- Regulation (EU) 2016/679, Article 12 ----------------------------

citation(eu_reg_2016_679_art_12_2, [label-'Regulation (EU) 2016/679 (GDPR) Art 12(2) second sentence (no refusal unless the controller cannot identify the data subject)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_012.002', verbatim-'In the cases referred to in Article 11(2), the controller shall not refuse to act on the request of the data subject for exercising his or her rights under Articles 15 to 22, unless the controller demonstrates that it is not in a position to identify the data subject.']).

citation(eu_reg_2016_679_art_12_3, [label-'Regulation (EU) 2016/679 (GDPR) Art 12(3) (one-month period, extension by two further months, notice of the extension)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_012.003', verbatim-'The controller shall provide information on action taken on a request under Articles 15 to 22 to the data subject without undue delay and in any event within one month of receipt of the request. That period may be extended by two further months where necessary, taking into account the complexity and number of the requests. The controller shall inform the data subject of any such extension within one month of receipt of the request, together with the reasons for the delay.']).

citation(eu_reg_2016_679_art_12_4, [label-'Regulation (EU) 2016/679 (GDPR) Art 12(4) (reasons for not taking action and remedies, within one month)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_012.004', verbatim-'If the controller does not take action on the request of the data subject, the controller shall inform the data subject without delay and at the latest within one month of receipt of the request of the reasons for not taking action and on the possibility of lodging a complaint with a supervisory authority and seeking a judicial remedy.']).

citation(eu_reg_2016_679_art_12_5, [label-'Regulation (EU) 2016/679 (GDPR) Art 12(5) (manifestly unfounded or excessive requests: reasonable fee or refusal)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_012.005 #point_012.005_a #point_012.005_b', verbatim-'Where requests from a data subject are manifestly unfounded or excessive, in particular because of their repetitive character, the controller may either:']).

citation(eu_reg_2016_679_art_12_6, [label-'Regulation (EU) 2016/679 (GDPR) Art 12(6) (reasonable doubts concerning identity, additional information)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_012.006', verbatim-'Without prejudice to Article 11, where the controller has reasonable doubts concerning the identity of the natural person making the request referred to in Articles 15 to 21, the controller may request the provision of additional information necessary to confirm the identity of the data subject.']).

% ---- Articles 15 to 18 ----------------------------------------------

citation(eu_reg_2016_679_art_15_1, [label-'Regulation (EU) 2016/679 (GDPR) Art 15(1) opening words (right of access)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_015.001', verbatim-'The data subject shall have the right to obtain from the controller confirmation as to whether or not personal data concerning him or her are being processed, and, where that is the case, access to the personal data and the following information:']).

citation(eu_reg_2016_679_art_16, [label-'Regulation (EU) 2016/679 (GDPR) Art 16 (right to rectification of inaccurate data and completion of incomplete data)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #art_016', verbatim-'The data subject shall have the right to obtain from the controller without undue delay the rectification of inaccurate personal data concerning him or her. Taking into account the purposes of the processing, the data subject shall have the right to have incomplete personal data completed, including by means of providing a supplementary statement.']).

citation(eu_reg_2016_679_art_17_1, [label-'Regulation (EU) 2016/679 (GDPR) Art 17(1) opening words (right to erasure where one of the grounds applies)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_017.001', verbatim-'The data subject shall have the right to obtain from the controller the erasure of personal data concerning him or her without undue delay and the controller shall have the obligation to erase personal data without undue delay where one of the following grounds applies:']).

citation(eu_reg_2016_679_art_17_1_a, [label-'Regulation (EU) 2016/679 (GDPR) Art 17(1)(a) (data no longer necessary)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_017.001', verbatim-'(a) the personal data are no longer necessary in relation to the purposes for which they were collected or otherwise processed;']).

citation(eu_reg_2016_679_art_17_1_b, [label-'Regulation (EU) 2016/679 (GDPR) Art 17(1)(b) (consent withdrawn, no other legal ground)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_017.001', verbatim-'(b) the data subject withdraws consent on which the processing is based according to point (a) of Article 6(1), or point (a) of Article 9(2), and where there is no other legal ground for the processing;']).

citation(eu_reg_2016_679_art_17_1_c, [label-'Regulation (EU) 2016/679 (GDPR) Art 17(1)(c) (objection under Art 21(1) without overriding grounds, or under Art 21(2))', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_017.001', verbatim-'(c) the data subject objects to the processing pursuant to Article 21(1) and there are no overriding legitimate grounds for the processing, or the data subject objects to the processing pursuant to Article 21(2);']).

citation(eu_reg_2016_679_art_17_1_d, [label-'Regulation (EU) 2016/679 (GDPR) Art 17(1)(d) (unlawful processing)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_017.001', verbatim-'(d) the personal data have been unlawfully processed;']).

citation(eu_reg_2016_679_art_17_1_e, [label-'Regulation (EU) 2016/679 (GDPR) Art 17(1)(e) (erasure for compliance with a legal obligation)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_017.001', verbatim-'(e) the personal data have to be erased for compliance with a legal obligation in Union or Member State law to which the controller is subject;']).

citation(eu_reg_2016_679_art_17_1_f, [label-'Regulation (EU) 2016/679 (GDPR) Art 17(1)(f) (information society services offer)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_017.001', verbatim-'(f) the personal data have been collected in relation to the offer of information society services referred to in Article 8(1).']).

citation(eu_reg_2016_679_art_17_3, [label-'Regulation (EU) 2016/679 (GDPR) Art 17(3) opening words (exceptions to erasure)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_017.003', verbatim-'Paragraphs 1 and 2 shall not apply to the extent that processing is necessary:']).

citation(eu_reg_2016_679_art_17_3_a, [label-'Regulation (EU) 2016/679 (GDPR) Art 17(3)(a) (freedom of expression and information)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_017.003', verbatim-'(a) for exercising the right of freedom of expression and information;']).

citation(eu_reg_2016_679_art_17_3_b, [label-'Regulation (EU) 2016/679 (GDPR) Art 17(3)(b) (legal obligation, public task or official authority)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_017.003', verbatim-'(b) for compliance with a legal obligation which requires processing by Union or Member State law to which the controller is subject or for the performance of a task carried out in the public interest or in the exercise of official authority vested in the controller;']).

citation(eu_reg_2016_679_art_17_3_c, [label-'Regulation (EU) 2016/679 (GDPR) Art 17(3)(c) (public health)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_017.003', verbatim-'(c) for reasons of public interest in the area of public health in accordance with points (h) and (i) of Article 9(2) as well as Article 9(3);']).

citation(eu_reg_2016_679_art_17_3_d, [label-'Regulation (EU) 2016/679 (GDPR) Art 17(3)(d) (archiving, research or statistics)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_017.003', verbatim-'(d) for archiving purposes in the public interest, scientific or historical research purposes or statistical purposes in accordance with Article 89(1) in so far as the right referred to in paragraph 1 is likely to render impossible or seriously impair the achievement of the objectives of that processing; or']).

citation(eu_reg_2016_679_art_17_3_e, [label-'Regulation (EU) 2016/679 (GDPR) Art 17(3)(e) (legal claims)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_017.003', verbatim-'(e) for the establishment, exercise or defence of legal claims.']).

citation(eu_reg_2016_679_art_18_1, [label-'Regulation (EU) 2016/679 (GDPR) Art 18(1) opening words (right to restriction of processing)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_018.001', verbatim-'The data subject shall have the right to obtain from the controller restriction of processing where one of the following applies:']).

citation(eu_reg_2016_679_art_18_1_a, [label-'Regulation (EU) 2016/679 (GDPR) Art 18(1)(a) (accuracy contested)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_018.001', verbatim-'(a) the accuracy of the personal data is contested by the data subject, for a period enabling the controller to verify the accuracy of the personal data;']).

citation(eu_reg_2016_679_art_18_1_b, [label-'Regulation (EU) 2016/679 (GDPR) Art 18(1)(b) (unlawful processing, erasure opposed)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_018.001', verbatim-'(b) the processing is unlawful and the data subject opposes the erasure of the personal data and requests the restriction of their use instead;']).

citation(eu_reg_2016_679_art_18_1_c, [label-'Regulation (EU) 2016/679 (GDPR) Art 18(1)(c) (controller no longer needs the data, required for legal claims)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_018.001', verbatim-'(c) the controller no longer needs the personal data for the purposes of the processing, but they are required by the data subject for the establishment, exercise or defence of legal claims;']).

citation(eu_reg_2016_679_art_18_1_d, [label-'Regulation (EU) 2016/679 (GDPR) Art 18(1)(d) (objection pending verification)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_018.001', verbatim-'(d) the data subject has objected to processing pursuant to Article 21(1) pending the verification whether the legitimate grounds of the controller override those of the data subject.']).

% ---- Article 19 -----------------------------------------------------

citation(eu_reg_2016_679_art_19, [label-'Regulation (EU) 2016/679 (GDPR) Art 19 (notification of rectification, erasure or restriction to recipients)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #art_019', verbatim-'The controller shall communicate any rectification or erasure of personal data or restriction of processing carried out in accordance with Article 16, Article 17(1) and Article 18 to each recipient to whom the personal data have been disclosed, unless this proves impossible or involves disproportionate effort. The controller shall inform the data subject about those recipients if the data subject requests it.']).

% ---- Article 20 -----------------------------------------------------

citation(eu_reg_2016_679_art_20_1, [label-'Regulation (EU) 2016/679 (GDPR) Art 20(1) (right to data portability)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_020.001', verbatim-'The data subject shall have the right to receive the personal data concerning him or her, which he or she has provided to a controller, in a structured, commonly used and machine-readable format and have the right to transmit those data to another controller without hindrance from the controller to which the personal data have been provided, where:']).

citation(eu_reg_2016_679_art_20_3, [label-'Regulation (EU) 2016/679 (GDPR) Art 20(3) second sentence (no portability for a public task or official authority)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_020.003', verbatim-'That right shall not apply to processing necessary for the performance of a task carried out in the public interest or in the exercise of official authority vested in the controller.']).

citation(eu_reg_2016_679_art_20_4, [label-'Regulation (EU) 2016/679 (GDPR) Art 20(4) (rights and freedoms of others)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_020.004', verbatim-'The right referred to in paragraph 1 shall not adversely affect the rights and freedoms of others.']).

% ---- Article 21 -----------------------------------------------------

citation(eu_reg_2016_679_art_21_1, [label-'Regulation (EU) 2016/679 (GDPR) Art 21(1) (objection to processing based on Art 6(1)(e) or (f))', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_021.001', verbatim-'The data subject shall have the right to object, on grounds relating to his or her particular situation, at any time to processing of personal data concerning him or her which is based on point (e) or (f) of Article 6(1), including profiling based on those provisions. The controller shall no longer process the personal data unless the controller demonstrates compelling legitimate grounds for the processing which override the interests, rights and freedoms of the data subject or for the establishment, exercise or defence of legal claims.']).

citation(eu_reg_2016_679_art_21_2, [label-'Regulation (EU) 2016/679 (GDPR) Art 21(2) (objection to direct marketing)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_021.002', verbatim-'Where personal data are processed for direct marketing purposes, the data subject shall have the right to object at any time to processing of personal data concerning him or her for such marketing, which includes profiling to the extent that it is related to such direct marketing.']).

citation(eu_reg_2016_679_art_21_3, [label-'Regulation (EU) 2016/679 (GDPR) Art 21(3) (no further processing for direct marketing)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_021.003', verbatim-'Where the data subject objects to processing for direct marketing purposes, the personal data shall no longer be processed for such purposes.']).

citation(eu_reg_2016_679_art_21_6, [label-'Regulation (EU) 2016/679 (GDPR) Art 21(6) (objection to research or statistics processing)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_021.006', verbatim-'Where personal data are processed for scientific or historical research purposes or statistical purposes pursuant to Article 89(1), the data subject, on grounds relating to his or her particular situation, shall have the right to object to processing of personal data concerning him or her, unless the processing is necessary for the performance of a task carried out for reasons of public interest.']).

% ---- Article 22 -----------------------------------------------------

citation(eu_reg_2016_679_art_22_1, [label-'Regulation (EU) 2016/679 (GDPR) Art 22(1) (right not to be subject to a solely automated decision)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_022.001', verbatim-'The data subject shall have the right not to be subject to a decision based solely on automated processing, including profiling, which produces legal effects concerning him or her or similarly significantly affects him or her.']).

citation(eu_reg_2016_679_art_22_2, [label-'Regulation (EU) 2016/679 (GDPR) Art 22(2) opening words (exceptions to Art 22(1))', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_022.002', verbatim-'Paragraph 1 shall not apply if the decision:']).

citation(eu_reg_2016_679_art_22_2_a, [label-'Regulation (EU) 2016/679 (GDPR) Art 22(2)(a) (necessary for a contract)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_022.002', verbatim-'(a) is necessary for entering into, or performance of, a contract between the data subject and a data controller;']).

citation(eu_reg_2016_679_art_22_2_b, [label-'Regulation (EU) 2016/679 (GDPR) Art 22(2)(b) (authorised by Union or Member State law with suitable measures)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_022.002', verbatim-'(b) is authorised by Union or Member State law to which the controller is subject and which also lays down suitable measures to safeguard the data subject''s rights and freedoms and legitimate interests; or']).

citation(eu_reg_2016_679_art_22_2_c, [label-'Regulation (EU) 2016/679 (GDPR) Art 22(2)(c) (explicit consent)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_022.002', verbatim-'(c) is based on the data subject''s explicit consent.']).

citation(eu_reg_2016_679_art_22_3, [label-'Regulation (EU) 2016/679 (GDPR) Art 22(3) (safeguards for Art 22(2)(a) and (c); deferred as a duty, read for the internal conditions only)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_022.003', verbatim-'In the cases referred to in points (a) and (c) of paragraph 2, the data controller shall implement suitable measures to safeguard the data subject''s rights and freedoms and legitimate interests, at least the right to obtain human intervention on the part of the controller, to express his or her point of view and to contest the decision.']).

citation(eu_reg_2016_679_art_22_4, [label-'Regulation (EU) 2016/679 (GDPR) Art 22(4) (bar on decisions based on special categories)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_022.004', verbatim-'Decisions referred to in paragraph 2 shall not be based on special categories of personal data referred to in Article 9(1), unless point (a) or (g) of Article 9(2) applies and suitable measures to safeguard the data subject''s rights and freedoms and legitimate interests are in place.']).

% ---- Article 23 -----------------------------------------------------

citation(eu_reg_2016_679_art_23_1, [label-'Regulation (EU) 2016/679 (GDPR) Art 23(1) opening words (restriction by a legislative measure)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 #parag_023.001', verbatim-'Union or Member State law to which the data controller or processor is subject may restrict by way of a legislative measure the scope of the obligations and rights provided for in Articles 12 to 22 and Article 34']).

% ---- Regulation (EEC, Euratom) No 1182/71 (periods) --------------------

citation(eu_reg_1971_1182_art_2_2, [label-'Regulation (EEC, Euratom) No 1182/71 Art 2(2) definition of working days', ref-'http://publications.europa.eu/resource/celex/31971R1182.ENG.fmx4 #parag_002.002', verbatim-'For the purposes of this Regulation, working days means all days other than public holidays, Sundays and Saturdays.']).

citation(eu_reg_1971_1182_art_3, [label-'Regulation (EEC, Euratom) No 1182/71 Art 3 (calculation of periods; public holidays taken into account)', ref-'http://publications.europa.eu/resource/celex/31971R1182.ENG.fmx4 #parag_003.004', verbatim-'Where the last day of a period expressed otherwise than in hours is a public holiday, Sunday or Saturday, the period shall end with the expiry of the last hour of the following working day.']).

citation(eu_reg_1971_1182_art_3_1, [label-'Regulation (EEC, Euratom) No 1182/71 Art 3(1) second subparagraph (day of the event not counted)', ref-'http://publications.europa.eu/resource/celex/31971R1182.ENG.fmx4 #parag_003.001', verbatim-'Where a period expressed in days, weeks, months or years is to be calculated from the moment at which an event occurs or an action takes place, the day during which that event occurs or that action takes place shall not be considered as falling within the period in question.']).

citation(eu_reg_1971_1182_art_3_2_c, [label-'Regulation (EEC, Euratom) No 1182/71 Art 3(2)(c) (end of a period in months)', ref-'http://publications.europa.eu/resource/celex/31971R1182.ENG.fmx4 #point_003.002_c', verbatim-'If, in a period expressed in months or in years, the day on which it should expire does not occur in the last month, the period shall end with the expiry of the last hour of the last day of that month;']).

citation(eu_reg_1971_1182_art_3_4, [label-'Regulation (EEC, Euratom) No 1182/71 Art 3(4) (last day on a Saturday, Sunday or public holiday)', ref-'http://publications.europa.eu/resource/celex/31971R1182.ENG.fmx4 #parag_003.004', verbatim-'Where the last day of a period expressed otherwise than in hours is a public holiday, Sunday or Saturday, the period shall end with the expiry of the last hour of the following working day. This provision shall not apply to periods calculated retroactively from a given date or event.']).

% ---- TARGETS of the outside facts (the order's outside_facts table) ----
% The outside law each fact stands for; not pinned, so unverified.

citation(union_or_member_state_law_requiring_erasure, [label-'Union or Member State law imposing on the controller a legal obligation to erase the personal data (target of GDPR Art 17(1)(e))', ref-'not pinned: the law named by the attested outside fact erasure_required_by_union_or_member_state_law']).

citation(union_or_member_state_law_requiring_processing, [label-'Union or Member State law requiring the processing (target of GDPR Art 17(3)(b) first limb)', ref-'not pinned: the law named by the attested outside fact processing_required_by_union_or_member_state_law']).

citation(union_or_member_state_law_authorising_automated_decision, [label-'Union or Member State law authorising the automated decision with suitable safeguards (target of GDPR Art 22(2)(b))', ref-'not pinned: the law named by the attested outside fact decision_authorised_by_union_or_member_state_law']).

citation(union_or_member_state_law_restricting_the_right, [label-'Union or Member State legislative measure restricting the right invoked (target of GDPR Art 23(1))', ref-'not pinned: the law named by the attested outside fact legislative_restriction_applies_to_the_right']).

citation(public_holidays_applicable_to_the_period, [label-'Public holidays taken into account under Regulation (EEC, Euratom) No 1182/71 Art 3(4) for this request (target of the outside fact public_holidays)', ref-'not pinned: a possible source is the Commission annual Official Journal C-series notice of public holidays (Regulation 1182/71 Art 2(1))']).

% ---- provenance marker ------------------------------------------------
% implements(Key): succeeds for every recorded key; a key not recorded fails.
implements(Key) :-
    citation(Key, _).

:- end_module(citations).
