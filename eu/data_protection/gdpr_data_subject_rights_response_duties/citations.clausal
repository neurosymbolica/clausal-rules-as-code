% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/data_protection/gdpr_data_subject_rights_response_duties.
%
% Sources: Regulation (EU) 2016/679 (GDPR), consolidated text 02016R0679-20160504
% (Arts 12, 15 to 23), and Regulation (EEC, Euratom) No 1182/71 Art 3 (periods).
%
% citation/2 record form: citation(Key, [label-'...', ref-'...', verbatim-'...']).
% implements(Key) succeeds for every recorded key; operative clauses open with it.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

implements(Key) :-
    citation(Key, _).

citation(eu_reg_2016_679_art_12_2, [label-'GDPR Art 12(2), second sentence (refusal only if unable to identify)', ref-'Regulation (EU) 2016/679 Art 12(2), unit 02016R0679-20160504#parag_012.002', verbatim-'the controller shall not refuse to act on the request of the data subject for exercising his or her rights under Articles 15 to 22']).
citation(eu_reg_2016_679_art_12_3, [label-'GDPR Art 12(3) (time limit and extension)', ref-'Regulation (EU) 2016/679 Art 12(3), unit 02016R0679-20160504#parag_012.003', verbatim-'without undue delay and in any event within one month of receipt of the request']).
citation(eu_reg_2016_679_art_12_4, [label-'GDPR Art 12(4) (reasons and remedies on refusal)', ref-'Regulation (EU) 2016/679 Art 12(4), unit 02016R0679-20160504#parag_012.004', verbatim-'reasons for not taking action and on the possibility of lodging a complaint with a supervisory authority and seeking a judicial remedy']).
citation(eu_reg_2016_679_art_12_5, [label-'GDPR Art 12(5) (free of charge; manifestly unfounded or excessive)', ref-'Regulation (EU) 2016/679 Art 12(5), unit 02016R0679-20160504#parag_012.005', verbatim-'The controller shall bear the burden of demonstrating the manifestly unfounded or excessive character of the request.']).
citation(eu_reg_2016_679_art_12_6, [label-'GDPR Art 12(6) (additional information to confirm identity)', ref-'Regulation (EU) 2016/679 Art 12(6), unit 02016R0679-20160504#parag_012.006', verbatim-'the controller may request the provision of additional information necessary to confirm the identity of the data subject']).
citation(eu_reg_2016_679_art_15_1, [label-'GDPR Art 15(1), opening words (right of access)', ref-'Regulation (EU) 2016/679 Art 15(1), unit 02016R0679-20160504#parag_015.001', verbatim-'The data subject shall have the right to obtain from the controller confirmation as to whether or not personal data concerning him or her are being processed']).
citation(eu_reg_2016_679_art_16, [label-'GDPR Art 16 (rectification)', ref-'Regulation (EU) 2016/679 Art 16, unit 02016R0679-20160504#art_016', verbatim-'the rectification of inaccurate personal data concerning him or her']).
citation(eu_reg_2016_679_art_17_1, [label-'GDPR Art 17(1) (right to erasure, grounds)', ref-'Regulation (EU) 2016/679 Art 17(1), unit 02016R0679-20160504#parag_017.001', verbatim-'the controller shall have the obligation to erase personal data without undue delay where one of the following grounds applies']).
citation(eu_reg_2016_679_art_17_1_a, [label-'GDPR Art 17(1)(a) (data no longer necessary)', ref-'Regulation (EU) 2016/679 Art 17(1)(a)', verbatim-'the personal data are no longer necessary in relation to the purposes for which they were collected or otherwise processed']).
citation(eu_reg_2016_679_art_17_1_b, [label-'GDPR Art 17(1)(b) (consent withdrawn, no other legal ground)', ref-'Regulation (EU) 2016/679 Art 17(1)(b)', verbatim-'the data subject withdraws consent on which the processing is based']).
citation(eu_reg_2016_679_art_17_1_c, [label-'GDPR Art 17(1)(c) (objection, no overriding legitimate grounds)', ref-'Regulation (EU) 2016/679 Art 17(1)(c)', verbatim-'the data subject objects to the processing pursuant to Article 21(1) and there are no overriding legitimate grounds for the processing']).
citation(eu_reg_2016_679_art_17_1_d, [label-'GDPR Art 17(1)(d) (unlawfully processed)', ref-'Regulation (EU) 2016/679 Art 17(1)(d)', verbatim-'the personal data have been unlawfully processed']).
citation(eu_reg_2016_679_art_17_1_e, [label-'GDPR Art 17(1)(e) (erasure for legal obligation)', ref-'Regulation (EU) 2016/679 Art 17(1)(e)', verbatim-'the personal data have to be erased for compliance with a legal obligation in Union or Member State law to which the controller is subject']).
citation(eu_reg_2016_679_art_17_1_f, [label-'GDPR Art 17(1)(f) (information society services offer)', ref-'Regulation (EU) 2016/679 Art 17(1)(f)', verbatim-'the personal data have been collected in relation to the offer of information society services referred to in Article 8(1)']).
citation(eu_reg_2016_679_art_17_3, [label-'GDPR Art 17(3) (exceptions to erasure)', ref-'Regulation (EU) 2016/679 Art 17(3), unit 02016R0679-20160504#parag_017.003', verbatim-'Paragraphs 1 and 2 shall not apply to the extent that processing is necessary']).
citation(eu_reg_2016_679_art_17_3_a, [label-'GDPR Art 17(3)(a) (freedom of expression and information)', ref-'Regulation (EU) 2016/679 Art 17(3)(a)', verbatim-'for exercising the right of freedom of expression and information']).
citation(eu_reg_2016_679_art_17_3_b, [label-'GDPR Art 17(3)(b) (legal obligation or public task)', ref-'Regulation (EU) 2016/679 Art 17(3)(b)', verbatim-'for the performance of a task carried out in the public interest or in the exercise of official authority vested in the controller']).
citation(eu_reg_2016_679_art_17_3_c, [label-'GDPR Art 17(3)(c) (public health)', ref-'Regulation (EU) 2016/679 Art 17(3)(c)', verbatim-'for reasons of public interest in the area of public health']).
citation(eu_reg_2016_679_art_17_3_d, [label-'GDPR Art 17(3)(d) (archiving, research, statistics)', ref-'Regulation (EU) 2016/679 Art 17(3)(d)', verbatim-'for archiving purposes in the public interest, scientific or historical research purposes or statistical purposes']).
citation(eu_reg_2016_679_art_17_3_e, [label-'GDPR Art 17(3)(e) (legal claims)', ref-'Regulation (EU) 2016/679 Art 17(3)(e)', verbatim-'for the establishment, exercise or defence of legal claims']).
citation(eu_reg_2016_679_art_18_1, [label-'GDPR Art 18(1) (restriction of processing)', ref-'Regulation (EU) 2016/679 Art 18(1), unit 02016R0679-20160504#parag_018.001', verbatim-'the right to obtain from the controller restriction of processing where one of the following applies']).
citation(eu_reg_2016_679_art_18_1_a, [label-'GDPR Art 18(1)(a) (accuracy contested)', ref-'Regulation (EU) 2016/679 Art 18(1)(a)', verbatim-'the accuracy of the personal data is contested by the data subject']).
citation(eu_reg_2016_679_art_18_1_b, [label-'GDPR Art 18(1)(b) (unlawful processing, erasure opposed)', ref-'Regulation (EU) 2016/679 Art 18(1)(b)', verbatim-'the processing is unlawful and the data subject opposes the erasure of the personal data']).
citation(eu_reg_2016_679_art_18_1_c, [label-'GDPR Art 18(1)(c) (data needed for legal claims)', ref-'Regulation (EU) 2016/679 Art 18(1)(c)', verbatim-'the controller no longer needs the personal data for the purposes of the processing']).
citation(eu_reg_2016_679_art_18_1_d, [label-'GDPR Art 18(1)(d) (objection pending verification)', ref-'Regulation (EU) 2016/679 Art 18(1)(d)', verbatim-'the data subject has objected to processing pursuant to Article 21(1) pending the verification']).
citation(eu_reg_2016_679_art_19, [label-'GDPR Art 19 (notification to recipients)', ref-'Regulation (EU) 2016/679 Art 19, unit 02016R0679-20160504#art_019', verbatim-'unless this proves impossible or involves disproportionate effort']).
citation(eu_reg_2016_679_art_20_1, [label-'GDPR Art 20(1) (data portability)', ref-'Regulation (EU) 2016/679 Art 20(1), unit 02016R0679-20160504#parag_020.001', verbatim-'in a structured, commonly used and machine-readable format']).
citation(eu_reg_2016_679_art_20_3, [label-'GDPR Art 20(3), second sentence (public task)', ref-'Regulation (EU) 2016/679 Art 20(3), unit 02016R0679-20160504#parag_020.003', verbatim-'That right shall not apply to processing necessary for the performance of a task carried out in the public interest']).
citation(eu_reg_2016_679_art_20_4, [label-'GDPR Art 20(4) (rights and freedoms of others)', ref-'Regulation (EU) 2016/679 Art 20(4), unit 02016R0679-20160504#parag_020.004', verbatim-'shall not adversely affect the rights and freedoms of others']).
citation(eu_reg_2016_679_art_21_1, [label-'GDPR Art 21(1) (objection, Art 6(1)(e) or (f))', ref-'Regulation (EU) 2016/679 Art 21(1), unit 02016R0679-20160504#parag_021.001', verbatim-'The controller shall no longer process the personal data unless the controller demonstrates compelling legitimate grounds']).
citation(eu_reg_2016_679_art_21_2, [label-'GDPR Art 21(2) (objection to direct marketing)', ref-'Regulation (EU) 2016/679 Art 21(2), unit 02016R0679-20160504#parag_021.002', verbatim-'the data subject shall have the right to object at any time to processing of personal data concerning him or her for such marketing']).
citation(eu_reg_2016_679_art_21_3, [label-'GDPR Art 21(3) (no further direct marketing processing)', ref-'Regulation (EU) 2016/679 Art 21(3), unit 02016R0679-20160504#parag_021.003', verbatim-'the personal data shall no longer be processed for such purposes']).
citation(eu_reg_2016_679_art_21_6, [label-'GDPR Art 21(6) (objection, research or statistics)', ref-'Regulation (EU) 2016/679 Art 21(6), unit 02016R0679-20160504#parag_021.006', verbatim-'unless the processing is necessary for the performance of a task carried out for reasons of public interest']).
citation(eu_reg_2016_679_art_22_1, [label-'GDPR Art 22(1) (automated individual decisions)', ref-'Regulation (EU) 2016/679 Art 22(1), unit 02016R0679-20160504#parag_022.001', verbatim-'the right not to be subject to a decision based solely on automated processing']).
citation(eu_reg_2016_679_art_22_2, [label-'GDPR Art 22(2) (exceptions to Art 22(1))', ref-'Regulation (EU) 2016/679 Art 22(2), unit 02016R0679-20160504#parag_022.002', verbatim-'Paragraph 1 shall not apply if the decision']).
citation(eu_reg_2016_679_art_22_2_a, [label-'GDPR Art 22(2)(a) (contract necessity)', ref-'Regulation (EU) 2016/679 Art 22(2)(a)', verbatim-'is necessary for entering into, or performance of, a contract between the data subject and a data controller']).
citation(eu_reg_2016_679_art_22_2_b, [label-'GDPR Art 22(2)(b) (authorised by law)', ref-'Regulation (EU) 2016/679 Art 22(2)(b)', verbatim-'is authorised by Union or Member State law to which the controller is subject']).
citation(eu_reg_2016_679_art_22_2_c, [label-'GDPR Art 22(2)(c) (explicit consent)', ref-'Regulation (EU) 2016/679 Art 22(2)(c)', verbatim-'is based on the data subject''s explicit consent']).
citation(eu_reg_2016_679_art_22_3, [label-'GDPR Art 22(3) (safeguards)', ref-'Regulation (EU) 2016/679 Art 22(3), unit 02016R0679-20160504#parag_022.003', verbatim-'at least the right to obtain human intervention on the part of the controller']).
citation(eu_reg_2016_679_art_22_4, [label-'GDPR Art 22(4) (special categories bar)', ref-'Regulation (EU) 2016/679 Art 22(4), unit 02016R0679-20160504#parag_022.004', verbatim-'shall not be based on special categories of personal data referred to in Article 9(1)']).
citation(eu_reg_2016_679_art_23_1, [label-'GDPR Art 23(1), opening words (legislative restriction)', ref-'Regulation (EU) 2016/679 Art 23(1), unit 02016R0679-20160504#parag_023.001', verbatim-'may restrict by way of a legislative measure the scope of the obligations and rights provided for in Articles 12 to 22']).
citation(union_or_member_state_law_requiring_erasure, [label-'Union or Member State law requiring erasure (target of the GDPR Art 17(1)(e) cross reference)', ref-'Regulation (EU) 2016/679 Art 17(1)(e)']).
citation(eu_reg_1971_1182_art_3, [label-'Regulation (EEC, Euratom) No 1182/71 Art 3 (rules on periods)', ref-'CELEX 31971R1182, OJ L 124, 8.6.1971, Art 3']).
citation(eu_reg_1971_1182_art_3_1, [label-'Regulation (EEC, Euratom) No 1182/71 Art 3(1), second subparagraph (day of event not counted)', ref-'CELEX 31971R1182, OJ L 124, 8.6.1971, Art 3(1)', verbatim-'the day during which that event occurs or that action takes place shall not be considered as falling within the period in question']).
citation(eu_reg_1971_1182_art_3_2_c, [label-'Regulation (EEC, Euratom) No 1182/71 Art 3(2)(c) (periods in months)', ref-'CELEX 31971R1182, OJ L 124, 8.6.1971, Art 3(2)(c)', verbatim-'the period shall end with the expiry of the last hour of the last day of that month']).
citation(eu_reg_1971_1182_art_3_4, [label-'Regulation (EEC, Euratom) No 1182/71 Art 3(4) (weekend or holiday shift)', ref-'CELEX 31971R1182, OJ L 124, 8.6.1971, Art 3(4)', verbatim-'the period shall end with the expiry of the last hour of the following working day']).

:- end_module(citations).
