% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% gdpr_data_subject_rights_response_duties.clausal -- the DETERMINATION for
% eu/data_protection/gdpr_data_subject_rights_response_duties.
% Sources: Regulation (EU) 2016/679 Arts 12, 15 to 23; periods by Regulation
% (EEC, Euratom) No 1182/71 Art 3 (applied to the GDPR, a lawyer point).
% Three-valued (strong Kleene) evaluation: met | unmet | open(Absent, Judged, Outside).
% =====================================================================

:- module(gdpr_data_subject_rights_response_duties, [
    decide_gdpr_data_subject_rights_response_duties/2,
    gdpr_data_subject_rights_response_duties_status/2,
    gdpr_data_subject_rights_response_duties_checklist/2,
    gdpr_data_subject_rights_response_duties_decision_resolvable/1,
    gdpr_data_subject_rights_response_duties_status_values/1,
    request_response_deadline/2,
    response_duties/2,
    recipient_notification/2,
    indeterminate/1,
    needs_legal_review/2,
    open_textured/2,
    cross_reference_unresolved/2,
    resolution/2,
    inputs_relied_on/1,
    provenance/2,
    suspended/1,
    input_problems/1,
    unknown_key/1,
    wrong_type/1,
    duplicate_key/1,
    attested/2,
    attestation/4,
    url/2,
    document/2,
    respond_with_action_taken/2,
    inform_of_extension_with_reasons/2,
    inform_of_reasons_and_remedies/2,
    communicate_to_each_recipient/1,
    inform_data_subject_of_recipients/1,
    recipient_notification_excused/1,
    recipient_notification_not_applicable/1
]).

:- use_module(library(clpz)).
:- use_module(library(reif), [memberd_t/3]).
:- use_module(formalize_lib, [profile_get/3, profile_lacks/2]).
:- use_module(eu/data_protection/gdpr_data_subject_rights_response_duties/kernel, [gdpr_data_subject_rights_response_duties_input_problems/2]).
:- use_module(eu/data_protection/gdpr_data_subject_rights_response_duties/citations, [implements/1]).

% ---- result constructors (exported data terms, no clauses) ------------
:- constructors([
    indeterminate(missing_keys),
    needs_legal_review(reason, context),
    open_textured(input, citation),
    cross_reference_unresolved(citation, target),
    resolution(target, status),
    inputs_relied_on(pairs),
    provenance(clause, citations),
    suspended(reason),
    input_problems(problems),
    unknown_key(key),
    wrong_type(key),
    duplicate_key(key),
    attested(value, attestation),
    attestation(by, at, reason, evidence),
    url(address, retrieved_at),
    document(upload_identifier, digest),
    respond_with_action_taken(period, citation),
    inform_of_extension_with_reasons(period, citation),
    inform_of_reasons_and_remedies(period, citation),
    communicate_to_each_recipient(citation),
    inform_data_subject_of_recipients(citation),
    recipient_notification_excused(citation),
    recipient_notification_not_applicable(citation)
]).

% ---- value facts -------------------------------------------------------
gdpr_data_subject_rights_response_duties_status_values([must_comply, need_not_comply]).

% period_months(Period, Months, Citation): the period counted from receipt.
period_months(first_period, 1, cite(eu_reg_2016_679_art_12_3)).
period_months(extended_period, 3, cite(eu_reg_2016_679_art_12_3)).

safeguard_conditions([human_intervention, express_point_of_view, contest_decision], cite(eu_reg_2016_679_art_22_3)).

% The contract key order (root_exports order).
contract_key_order([request_type, objection_ground_claimed, request_received_on, extension_claimed, controller_demonstrates_unable_to_identify_data_subject, identity_confirmed, personal_data_inaccurate, consent_is_the_basis_of_processing, consent_withdrawn, other_legal_ground_for_processing_exists, objection_under_art21_1_made, objection_under_art21_2_made, collected_in_relation_to_information_society_services_offer, accuracy_contested_by_data_subject, data_subject_opposes_erasure, data_required_by_data_subject_for_legal_claims, verification_of_overriding_grounds_pending, personal_data_provided_by_data_subject, processing_based_on_consent_or_contract, processing_carried_out_by_automated_means, processing_based_on_art6_1_e_or_f, processing_for_direct_marketing, processing_for_research_or_statistics_pursuant_to_art89_1, data_subject_gave_explicit_consent, decision_based_on_special_categories, special_category_condition_and_safeguards_met_for_decision, personal_data_disclosed_to_recipients, data_subject_asks_who_the_recipients_are, extension_necessary_for_complexity_and_number, reasonable_doubts_about_identity, request_manifestly_unfounded_or_excessive, personal_data_incomplete_in_light_of_purposes, data_no_longer_necessary_for_purposes, overriding_legitimate_grounds_exist, personal_data_unlawfully_processed, processing_necessary_for_freedom_of_expression_and_information, processing_necessary_for_public_task_or_official_authority, processing_necessary_for_public_health_in_accordance_with_art9_2_h_and_i, processing_for_archiving_research_or_statistics_in_accordance_with_art89_1, erasure_would_render_impossible_or_seriously_impair_processing_objectives, processing_necessary_for_legal_claims, controller_no_longer_needs_data_for_processing_purposes, transmission_would_adversely_affect_rights_and_freedoms_of_others, objection_grounds_relate_to_particular_situation, controller_demonstrates_compelling_legitimate_grounds, decision_based_solely_on_automated_processing, decision_produces_legal_or_similarly_significant_effects, decision_necessary_for_contract_with_data_subject, recipient_notification_impossible_or_disproportionate_effort, legislative_restriction_applies_to_the_right, erasure_required_by_union_or_member_state_law, processing_required_by_union_or_member_state_law, decision_authorised_by_union_or_member_state_law, public_holidays]).

% basis_cites(Basis, Citations): ready-made cite terms.
basis_cites(none, []).
basis_cites(art15_1, [cite(eu_reg_2016_679_art_15_1)]).
basis_cites(art16_inaccurate_data, [cite(eu_reg_2016_679_art_16)]).
basis_cites(art16_incomplete_data, [cite(eu_reg_2016_679_art_16)]).
basis_cites(art17_1_a, [cite(eu_reg_2016_679_art_17_1_a)]).
basis_cites(art17_1_b, [cite(eu_reg_2016_679_art_17_1_b)]).
basis_cites(art17_1_c, [cite(eu_reg_2016_679_art_17_1_c)]).
basis_cites(art17_1_d, [cite(eu_reg_2016_679_art_17_1_d)]).
basis_cites(art17_1_e, [cite(eu_reg_2016_679_art_17_1_e)]).
basis_cites(art17_1_f, [cite(eu_reg_2016_679_art_17_1_f)]).
basis_cites(art18_1_a, [cite(eu_reg_2016_679_art_18_1_a)]).
basis_cites(art18_1_b, [cite(eu_reg_2016_679_art_18_1_b)]).
basis_cites(art18_1_c, [cite(eu_reg_2016_679_art_18_1_c)]).
basis_cites(art18_1_d, [cite(eu_reg_2016_679_art_18_1_d)]).
basis_cites(art20_1, [cite(eu_reg_2016_679_art_20_1)]).
basis_cites(art21_1, [cite(eu_reg_2016_679_art_21_1)]).
basis_cites(art21_2, [cite(eu_reg_2016_679_art_21_2)]).
basis_cites(art21_6, [cite(eu_reg_2016_679_art_21_6)]).
basis_cites(art22_1, [cite(eu_reg_2016_679_art_22_1)]).

exception_cites(none, []).
exception_cites(art17_3_a, [cite(eu_reg_2016_679_art_17_3_a)]).
exception_cites(art17_3_b, [cite(eu_reg_2016_679_art_17_3_b)]).
exception_cites(art17_3_c, [cite(eu_reg_2016_679_art_17_3_c)]).
exception_cites(art17_3_d, [cite(eu_reg_2016_679_art_17_3_d)]).
exception_cites(art17_3_e, [cite(eu_reg_2016_679_art_17_3_e)]).
exception_cites(art20_3_public_task, [cite(eu_reg_2016_679_art_20_3)]).
exception_cites(art20_4_rights_of_others, [cite(eu_reg_2016_679_art_20_4)]).
exception_cites(art21_1_compelling_legitimate_grounds, [cite(eu_reg_2016_679_art_21_1)]).
exception_cites(art21_1_legal_claims, [cite(eu_reg_2016_679_art_21_1)]).
exception_cites(art21_6_public_interest_task, [cite(eu_reg_2016_679_art_21_6)]).
exception_cites(art22_2_a, [cite(eu_reg_2016_679_art_22_2_a)]).
exception_cites(art22_2_b, [cite(eu_reg_2016_679_art_22_2_b)]).
exception_cites(art22_2_c, [cite(eu_reg_2016_679_art_22_2_c)]).
exception_cites(art12_5_manifestly_unfounded_or_excessive, [cite(eu_reg_2016_679_art_12_5)]).
exception_cites(art12_2_unable_to_identify, [cite(eu_reg_2016_679_art_12_2)]).
exception_cites(art23_legislative_restriction, [cite(eu_reg_2016_679_art_23_1)]).

engagement_cite(access, cite(eu_reg_2016_679_art_15_1)).
engagement_cite(rectification, cite(eu_reg_2016_679_art_16)).
engagement_cite(erasure, cite(eu_reg_2016_679_art_17_1)).
engagement_cite(restriction, cite(eu_reg_2016_679_art_18_1)).
engagement_cite(portability, cite(eu_reg_2016_679_art_20_1)).
engagement_cite(objection_art21_1, cite(eu_reg_2016_679_art_21_1)).
engagement_cite(objection_art21_2, cite(eu_reg_2016_679_art_21_2)).
engagement_cite(objection_art21_6, cite(eu_reg_2016_679_art_21_6)).
engagement_cite(automated_decision, cite(eu_reg_2016_679_art_22_1)).

% Judgement keys each engagement reads (for the inputs_relied_on pairs).
engagement_keys(access, []).
engagement_keys(rectification, [personal_data_incomplete_in_light_of_purposes]).
engagement_keys(erasure, [data_no_longer_necessary_for_purposes, overriding_legitimate_grounds_exist, personal_data_unlawfully_processed]).
engagement_keys(restriction, [personal_data_unlawfully_processed, controller_no_longer_needs_data_for_processing_purposes]).
engagement_keys(portability, []).
engagement_keys(objection_art21_1, [objection_grounds_relate_to_particular_situation]).
engagement_keys(objection_art21_2, []).
engagement_keys(objection_art21_6, [objection_grounds_relate_to_particular_situation]).
engagement_keys(automated_decision, [decision_based_solely_on_automated_processing, decision_produces_legal_or_similarly_significant_effects]).

% Referral rows: referral_key(Kind, Input, cite(Key)).
referral_key(_, reasonable_doubts_about_identity, cite(eu_reg_2016_679_art_12_6)).
referral_key(_, request_manifestly_unfounded_or_excessive, cite(eu_reg_2016_679_art_12_5)).
referral_key(rectification, personal_data_incomplete_in_light_of_purposes, cite(eu_reg_2016_679_art_16)).
referral_key(erasure, data_no_longer_necessary_for_purposes, cite(eu_reg_2016_679_art_17_1_a)).
referral_key(erasure, overriding_legitimate_grounds_exist, cite(eu_reg_2016_679_art_17_1_c)).
referral_key(erasure, personal_data_unlawfully_processed, cite(eu_reg_2016_679_art_17_1_d)).
referral_key(erasure, processing_necessary_for_freedom_of_expression_and_information, cite(eu_reg_2016_679_art_17_3_a)).
referral_key(erasure, processing_necessary_for_public_task_or_official_authority, cite(eu_reg_2016_679_art_17_3_b)).
referral_key(erasure, processing_necessary_for_public_health_in_accordance_with_art9_2_h_and_i, cite(eu_reg_2016_679_art_17_3_c)).
referral_key(erasure, processing_for_archiving_research_or_statistics_in_accordance_with_art89_1, cite(eu_reg_2016_679_art_17_3_d)).
referral_key(erasure, erasure_would_render_impossible_or_seriously_impair_processing_objectives, cite(eu_reg_2016_679_art_17_3_d)).
referral_key(erasure, processing_necessary_for_legal_claims, cite(eu_reg_2016_679_art_17_3_e)).
referral_key(restriction, personal_data_unlawfully_processed, cite(eu_reg_2016_679_art_18_1_b)).
referral_key(restriction, controller_no_longer_needs_data_for_processing_purposes, cite(eu_reg_2016_679_art_18_1_c)).
referral_key(portability, processing_necessary_for_public_task_or_official_authority, cite(eu_reg_2016_679_art_20_3)).
referral_key(portability, transmission_would_adversely_affect_rights_and_freedoms_of_others, cite(eu_reg_2016_679_art_20_4)).
referral_key(objection_art21_1, objection_grounds_relate_to_particular_situation, cite(eu_reg_2016_679_art_21_1)).
referral_key(objection_art21_1, controller_demonstrates_compelling_legitimate_grounds, cite(eu_reg_2016_679_art_21_1)).
referral_key(objection_art21_1, processing_necessary_for_legal_claims, cite(eu_reg_2016_679_art_21_1)).
referral_key(objection_art21_6, objection_grounds_relate_to_particular_situation, cite(eu_reg_2016_679_art_21_6)).
referral_key(objection_art21_6, processing_necessary_for_public_task_or_official_authority, cite(eu_reg_2016_679_art_21_6)).
referral_key(automated_decision, decision_based_solely_on_automated_processing, cite(eu_reg_2016_679_art_22_1)).
referral_key(automated_decision, decision_produces_legal_or_similarly_significant_effects, cite(eu_reg_2016_679_art_22_1)).
referral_key(automated_decision, decision_necessary_for_contract_with_data_subject, cite(eu_reg_2016_679_art_22_2_a)).

% ---- profile reads and three-valued logic -------------------------------
key_value(Profile, Key, present(Value)) :-
    profile_get(Profile, Key, Value).
key_value(Profile, Key, absent) :-
    profile_lacks(Profile, Key).

required_value_status(present(true), _, met).
required_value_status(present(false), _, unmet).
required_value_status(present(unsure), Key, open([], [Key], [])).
required_value_status(absent, Key, open([Key], [], [])).

defeater_value_status(present(true), _, met).
defeater_value_status(present(false), _, unmet).
defeater_value_status(present(unsure), Key, open([], [Key], [])).
defeater_value_status(absent, _, unmet).

required_status(Profile, Key, Status) :-
    key_value(Profile, Key, Value),
    required_value_status(Value, Key, Status).

defeater_status(Profile, Key, Status) :-
    key_value(Profile, Key, Value),
    defeater_value_status(Value, Key, Status).

required_not_status(Profile, Key, Status) :-
    required_status(Profile, Key, Inner),
    negated_status(Inner, Status).

negated_status(met, unmet).
negated_status(unmet, met).
negated_status(open(AbsentKeys, JudgedKeys, OutsideKeys), open(AbsentKeys, JudgedKeys, OutsideKeys)).

% Outside facts: ENABLING (absent is open) and BLOCKING (absent is unmet).
blocking_fact_status(Profile, Key, Status) :-
    key_value(Profile, Key, Value),
    blocking_value_status(Value, Status).

blocking_value_status(present(attested(true, _)), met).
blocking_value_status(present(attested(false, _)), unmet).
blocking_value_status(absent, unmet).

enabling_fact_status(Profile, Key, Status) :-
    key_value(Profile, Key, Value),
    enabling_value_status(Value, Key, Status).

enabling_value_status(present(attested(true, _)), _, met).
enabling_value_status(present(attested(false, _)), _, unmet).
enabling_value_status(absent, Key, open([], [], [Key])).

conjoin_status(unmet, _, unmet).
conjoin_status(met, unmet, unmet).
conjoin_status(met, met, met).
conjoin_status(met, open(AbsentKeys, JudgedKeys, OutsideKeys), open(AbsentKeys, JudgedKeys, OutsideKeys)).
conjoin_status(open(_, _, _), unmet, unmet).
conjoin_status(open(AbsentKeys, JudgedKeys, OutsideKeys), met, open(AbsentKeys, JudgedKeys, OutsideKeys)).
conjoin_status(open(AbsentLeft, JudgedLeft, OutsideLeft), open(AbsentRight, JudgedRight, OutsideRight), open(AbsentKeys, JudgedKeys, OutsideKeys)) :-
    append(AbsentLeft, AbsentRight, AbsentKeys),
    append(JudgedLeft, JudgedRight, JudgedKeys),
    append(OutsideLeft, OutsideRight, OutsideKeys).

disjoin_status(met, _, met).
disjoin_status(unmet, met, met).
disjoin_status(unmet, unmet, unmet).
disjoin_status(unmet, open(AbsentKeys, JudgedKeys, OutsideKeys), open(AbsentKeys, JudgedKeys, OutsideKeys)).
disjoin_status(open(_, _, _), met, met).
disjoin_status(open(AbsentKeys, JudgedKeys, OutsideKeys), unmet, open(AbsentKeys, JudgedKeys, OutsideKeys)).
disjoin_status(open(AbsentLeft, JudgedLeft, OutsideLeft), open(AbsentRight, JudgedRight, OutsideRight), open(AbsentKeys, JudgedKeys, OutsideKeys)) :-
    append(AbsentLeft, AbsentRight, AbsentKeys),
    append(JudgedLeft, JudgedRight, JudgedKeys),
    append(OutsideLeft, OutsideRight, OutsideKeys).

% ---- engagement of each right -------------------------------------------
engagement_point(_, access, art15_1, met) :-
    implements(eu_reg_2016_679_art_15_1).

engagement_point(Profile, rectification, art16_inaccurate_data, Status) :-
    implements(eu_reg_2016_679_art_16),
    required_status(Profile, personal_data_inaccurate, Status).
engagement_point(Profile, rectification, art16_incomplete_data, Status) :-
    implements(eu_reg_2016_679_art_16),
    required_status(Profile, personal_data_incomplete_in_light_of_purposes, Status).

engagement_point(Profile, erasure, art17_1_a, Status) :-
    implements(eu_reg_2016_679_art_17_1),
    implements(eu_reg_2016_679_art_17_1_a),
    required_status(Profile, data_no_longer_necessary_for_purposes, Status).
engagement_point(Profile, erasure, art17_1_b, Status) :-
    implements(eu_reg_2016_679_art_17_1_b),
    required_status(Profile, consent_is_the_basis_of_processing, BasisStatus),
    required_status(Profile, consent_withdrawn, WithdrawnStatus),
    required_not_status(Profile, other_legal_ground_for_processing_exists, NoOtherStatus),
    conjoin_status(WithdrawnStatus, NoOtherStatus, InnerStatus),
    conjoin_status(BasisStatus, InnerStatus, Status).
engagement_point(Profile, erasure, art17_1_c, Status) :-
    implements(eu_reg_2016_679_art_17_1_c),
    required_status(Profile, objection_under_art21_1_made, ObjectionStatus),
    required_not_status(Profile, overriding_legitimate_grounds_exist, NoOverridingStatus),
    conjoin_status(ObjectionStatus, NoOverridingStatus, FirstLimbStatus),
    required_status(Profile, objection_under_art21_2_made, MarketingStatus),
    disjoin_status(FirstLimbStatus, MarketingStatus, Status).
engagement_point(Profile, erasure, art17_1_d, Status) :-
    implements(eu_reg_2016_679_art_17_1_d),
    required_status(Profile, personal_data_unlawfully_processed, Status).
engagement_point(Profile, erasure, art17_1_e, Status) :-
    implements(eu_reg_2016_679_art_17_1_e),
    enabling_fact_status(Profile, erasure_required_by_union_or_member_state_law, Status).
engagement_point(Profile, erasure, art17_1_f, Status) :-
    implements(eu_reg_2016_679_art_17_1_f),
    required_status(Profile, collected_in_relation_to_information_society_services_offer, Status).

engagement_point(Profile, restriction, art18_1_a, Status) :-
    implements(eu_reg_2016_679_art_18_1),
    implements(eu_reg_2016_679_art_18_1_a),
    required_status(Profile, accuracy_contested_by_data_subject, Status).
engagement_point(Profile, restriction, art18_1_b, Status) :-
    implements(eu_reg_2016_679_art_18_1_b),
    required_status(Profile, personal_data_unlawfully_processed, UnlawfulStatus),
    required_status(Profile, data_subject_opposes_erasure, OpposesStatus),
    conjoin_status(UnlawfulStatus, OpposesStatus, Status).
engagement_point(Profile, restriction, art18_1_c, Status) :-
    implements(eu_reg_2016_679_art_18_1_c),
    required_status(Profile, controller_no_longer_needs_data_for_processing_purposes, NoLongerNeedsStatus),
    required_status(Profile, data_required_by_data_subject_for_legal_claims, ClaimsStatus),
    conjoin_status(NoLongerNeedsStatus, ClaimsStatus, Status).
engagement_point(Profile, restriction, art18_1_d, Status) :-
    implements(eu_reg_2016_679_art_18_1_d),
    required_status(Profile, objection_under_art21_1_made, ObjectionStatus),
    required_status(Profile, verification_of_overriding_grounds_pending, PendingStatus),
    conjoin_status(ObjectionStatus, PendingStatus, Status).

engagement_point(Profile, portability, art20_1, Status) :-
    implements(eu_reg_2016_679_art_20_1),
    required_status(Profile, personal_data_provided_by_data_subject, ProvidedStatus),
    required_status(Profile, processing_based_on_consent_or_contract, BasedStatus),
    required_status(Profile, processing_carried_out_by_automated_means, AutomatedStatus),
    conjoin_status(BasedStatus, AutomatedStatus, InnerStatus),
    conjoin_status(ProvidedStatus, InnerStatus, Status).

engagement_point(Profile, objection_art21_1, art21_1, Status) :-
    implements(eu_reg_2016_679_art_21_1),
    required_status(Profile, processing_based_on_art6_1_e_or_f, BasedStatus),
    required_status(Profile, objection_grounds_relate_to_particular_situation, SituationStatus),
    conjoin_status(BasedStatus, SituationStatus, Status).
engagement_point(Profile, objection_art21_2, art21_2, Status) :-
    implements(eu_reg_2016_679_art_21_2),
    implements(eu_reg_2016_679_art_21_3),
    required_status(Profile, processing_for_direct_marketing, Status).
engagement_point(Profile, objection_art21_6, art21_6, Status) :-
    implements(eu_reg_2016_679_art_21_6),
    required_status(Profile, processing_for_research_or_statistics_pursuant_to_art89_1, ResearchStatus),
    required_status(Profile, objection_grounds_relate_to_particular_situation, SituationStatus),
    conjoin_status(ResearchStatus, SituationStatus, Status).

engagement_point(Profile, automated_decision, art22_1, Status) :-
    implements(eu_reg_2016_679_art_22_1),
    required_status(Profile, decision_based_solely_on_automated_processing, SolelyStatus),
    required_status(Profile, decision_produces_legal_or_similarly_significant_effects, EffectsStatus),
    conjoin_status(SolelyStatus, EffectsStatus, Status).

engagement(Profile, Kind, Status, Basis) :-
    findall(point(PointBasis, PointStatus), engagement_point(Profile, Kind, PointBasis, PointStatus), Points),
    points_status(Points, Status),
    first_met_basis(Points, Basis).

points_status([], unmet).
points_status([point(_, Status)|Points], Result) :-
    points_status(Points, RemainingStatus),
    disjoin_status(Status, RemainingStatus, Result).

first_met_basis([], none).
first_met_basis([point(Basis, met)|_], Basis).
first_met_basis([point(_, unmet)|Points], Basis) :-
    first_met_basis(Points, Basis).
first_met_basis([point(_, open(_, _, _))|Points], Basis) :-
    first_met_basis(Points, Basis).

% ---- exceptions -----------------------------------------------------------
% exception(Name, Status, Conditions, JudgementKeys)
specific_exception(Profile, erasure, exception(art17_3_a, Status, [], [processing_necessary_for_freedom_of_expression_and_information])) :-
    implements(eu_reg_2016_679_art_17_3),
    implements(eu_reg_2016_679_art_17_3_a),
    defeater_status(Profile, processing_necessary_for_freedom_of_expression_and_information, Status).
specific_exception(Profile, erasure, exception(art17_3_b, Status, [], [processing_necessary_for_public_task_or_official_authority])) :-
    implements(eu_reg_2016_679_art_17_3_b),
    blocking_fact_status(Profile, processing_required_by_union_or_member_state_law, FactStatus),
    defeater_status(Profile, processing_necessary_for_public_task_or_official_authority, TaskStatus),
    disjoin_status(FactStatus, TaskStatus, Status).
specific_exception(Profile, erasure, exception(art17_3_c, Status, [], [processing_necessary_for_public_health_in_accordance_with_art9_2_h_and_i])) :-
    implements(eu_reg_2016_679_art_17_3_c),
    defeater_status(Profile, processing_necessary_for_public_health_in_accordance_with_art9_2_h_and_i, Status).
specific_exception(Profile, erasure, exception(art17_3_d, Status, [], [processing_for_archiving_research_or_statistics_in_accordance_with_art89_1, erasure_would_render_impossible_or_seriously_impair_processing_objectives])) :-
    implements(eu_reg_2016_679_art_17_3_d),
    defeater_status(Profile, processing_for_archiving_research_or_statistics_in_accordance_with_art89_1, ArchivingStatus),
    defeater_status(Profile, erasure_would_render_impossible_or_seriously_impair_processing_objectives, ImpairStatus),
    conjoin_status(ArchivingStatus, ImpairStatus, Status).
specific_exception(Profile, erasure, exception(art17_3_e, Status, [], [processing_necessary_for_legal_claims])) :-
    implements(eu_reg_2016_679_art_17_3_e),
    defeater_status(Profile, processing_necessary_for_legal_claims, Status).

specific_exception(Profile, portability, exception(art20_3_public_task, Status, [], [processing_necessary_for_public_task_or_official_authority])) :-
    implements(eu_reg_2016_679_art_20_3),
    defeater_status(Profile, processing_necessary_for_public_task_or_official_authority, Status).
specific_exception(Profile, portability, exception(art20_4_rights_of_others, Status, [], [transmission_would_adversely_affect_rights_and_freedoms_of_others])) :-
    implements(eu_reg_2016_679_art_20_4),
    defeater_status(Profile, transmission_would_adversely_affect_rights_and_freedoms_of_others, Status).

specific_exception(Profile, objection_art21_1, exception(art21_1_compelling_legitimate_grounds, Status, [], [controller_demonstrates_compelling_legitimate_grounds])) :-
    implements(eu_reg_2016_679_art_21_1),
    defeater_status(Profile, controller_demonstrates_compelling_legitimate_grounds, Status).
specific_exception(Profile, objection_art21_1, exception(art21_1_legal_claims, Status, [], [processing_necessary_for_legal_claims])) :-
    implements(eu_reg_2016_679_art_21_1),
    defeater_status(Profile, processing_necessary_for_legal_claims, Status).

specific_exception(Profile, objection_art21_6, exception(art21_6_public_interest_task, Status, [], [processing_necessary_for_public_task_or_official_authority])) :-
    implements(eu_reg_2016_679_art_21_6),
    defeater_status(Profile, processing_necessary_for_public_task_or_official_authority, Status).

specific_exception(Profile, automated_decision, exception(art22_2_a, Status, Conditions, [decision_necessary_for_contract_with_data_subject])) :-
    implements(eu_reg_2016_679_art_22_2),
    implements(eu_reg_2016_679_art_22_2_a),
    safeguard_conditions(Conditions, _),
    defeater_status(Profile, decision_necessary_for_contract_with_data_subject, NecessaryStatus),
    special_category_bar_status(Profile, BarStatus),
    negated_status(BarStatus, NoBarStatus),
    conjoin_status(NecessaryStatus, NoBarStatus, Status).
specific_exception(Profile, automated_decision, exception(art22_2_b, Status, [], [])) :-
    implements(eu_reg_2016_679_art_22_2_b),
    blocking_fact_status(Profile, decision_authorised_by_union_or_member_state_law, AuthorisedStatus),
    special_category_bar_status(Profile, BarStatus),
    negated_status(BarStatus, NoBarStatus),
    conjoin_status(AuthorisedStatus, NoBarStatus, Status).
specific_exception(Profile, automated_decision, exception(art22_2_c, Status, Conditions, [])) :-
    implements(eu_reg_2016_679_art_22_2_c),
    safeguard_conditions(Conditions, _),
    defeater_status(Profile, data_subject_gave_explicit_consent, ConsentStatus),
    special_category_bar_status(Profile, BarStatus),
    negated_status(BarStatus, NoBarStatus),
    conjoin_status(ConsentStatus, NoBarStatus, Status).

special_category_bar_status(Profile, Status) :-
    implements(eu_reg_2016_679_art_22_4),
    defeater_status(Profile, decision_based_on_special_categories, SpecialStatus),
    required_not_status(Profile, special_category_condition_and_safeguards_met_for_decision, NotSafeguardedStatus),
    conjoin_status(SpecialStatus, NotSafeguardedStatus, Status).

common_exception(Profile, exception(art12_5_manifestly_unfounded_or_excessive, Status, [reasonable_fee_may_be_charged], [request_manifestly_unfounded_or_excessive])) :-
    implements(eu_reg_2016_679_art_12_5),
    defeater_status(Profile, request_manifestly_unfounded_or_excessive, Status).
common_exception(Profile, exception(art12_2_unable_to_identify, Status, [], [])) :-
    implements(eu_reg_2016_679_art_12_2),
    defeater_status(Profile, controller_demonstrates_unable_to_identify_data_subject, Status).
common_exception(Profile, exception(art23_legislative_restriction, Status, [], [])) :-
    implements(eu_reg_2016_679_art_23_1),
    blocking_fact_status(Profile, legislative_restriction_applies_to_the_right, Status).

exceptions(Profile, Kind, Items) :-
    findall(Item, specific_exception(Profile, Kind, Item), SpecificItems),
    findall(Item, common_exception(Profile, Item), CommonItems),
    append(SpecificItems, CommonItems, Items).

first_met_item([], none_met).
first_met_item([exception(Name, met, Conditions, Keys)|_], found(exception(Name, met, Conditions, Keys))).
first_met_item([exception(_, unmet, _, _)|Items], Found) :-
    first_met_item(Items, Found).
first_met_item([exception(_, open(_, _, _), _, _)|Items], Found) :-
    first_met_item(Items, Found).

% ---- the suspension (Art 12(6)) -------------------------------------------
suspension(Profile, Status) :-
    implements(eu_reg_2016_679_art_12_6),
    defeater_status(Profile, reasonable_doubts_about_identity, DoubtsStatus),
    required_not_status(Profile, identity_confirmed, NotConfirmedStatus),
    conjoin_status(DoubtsStatus, NotConfirmedStatus, Status).

% ---- the decision -----------------------------------------------------------
request_kind(Profile, Result) :-
    key_value(Profile, request_type, TypeValue),
    request_kind_of(TypeValue, Profile, Result).

request_kind_of(absent, _, missing(request_type)).
request_kind_of(present(access), _, kind(access)).
request_kind_of(present(rectification), _, kind(rectification)).
request_kind_of(present(erasure), _, kind(erasure)).
request_kind_of(present(restriction), _, kind(restriction)).
request_kind_of(present(portability), _, kind(portability)).
request_kind_of(present(automated_decision), _, kind(automated_decision)).
request_kind_of(present(objection), Profile, Result) :-
    key_value(Profile, objection_ground_claimed, GroundValue),
    objection_kind(GroundValue, Result).

objection_kind(absent, missing(objection_ground_claimed)).
objection_kind(present(art21_1), kind(objection_art21_1)).
objection_kind(present(art21_2), kind(objection_art21_2)).
objection_kind(present(art21_6), kind(objection_art21_6)).

decide_gdpr_data_subject_rights_response_duties(Profile, Verdict) :-
    gdpr_data_subject_rights_response_duties_input_problems(Profile, Problems),
    decide_with_problems(Problems, Profile, Verdict).

decide_with_problems([Problem|Problems], _, gdpr_data_subject_request_verdict(input_problems([Problem|Problems]), none, none, [], [])).
decide_with_problems([], Profile, Verdict) :-
    request_kind(Profile, KindResult),
    decide_kind(KindResult, Profile, Verdict).

decide_kind(missing(Key), _, gdpr_data_subject_request_verdict(indeterminate([Key]), none, none, [], [])).
decide_kind(kind(Kind), Profile, Verdict) :-
    engagement(Profile, Kind, EngagementStatus, EngagementBasis),
    suspension(Profile, SuspensionStatus),
    exceptions(Profile, Kind, Items),
    first_met_item(Items, Found),
    decide_engaged(EngagementStatus, EngagementBasis, SuspensionStatus, Items, Found, Kind, Profile, Verdict).

decide_engaged(unmet, _, _, _, _, _, _, gdpr_data_subject_request_verdict(need_not_comply, none, none, [], [])).
decide_engaged(met, Basis, Suspension, Items, Found, Kind, Profile, Verdict) :-
    decide_after_engagement(met, Basis, Suspension, Items, Found, Kind, Profile, Verdict).
decide_engaged(open(AbsentKeys, JudgedKeys, OutsideKeys), _, Suspension, Items, Found, Kind, Profile, Verdict) :-
    decide_after_engagement(open(AbsentKeys, JudgedKeys, OutsideKeys), none, Suspension, Items, Found, Kind, Profile, Verdict).

decide_after_engagement(_, Basis, _, _, found(exception(Name, _, Conditions, _)), _, _, gdpr_data_subject_request_verdict(need_not_comply, Basis, Name, Conditions, Citations)) :-
    verdict_citations(Basis, Name, Citations).
decide_after_engagement(_, _, met, _, none_met, _, _, gdpr_data_subject_request_verdict(suspended(art12_6_identity_not_confirmed), none, none, [], [])).
decide_after_engagement(EngagementStatus, Basis, unmet, Items, none_met, Kind, Profile, Verdict) :-
    settle(EngagementStatus, Basis, unmet, Items, Kind, Profile, Verdict).
decide_after_engagement(EngagementStatus, Basis, open(AbsentKeys, JudgedKeys, OutsideKeys), Items, none_met, Kind, Profile, Verdict) :-
    settle(EngagementStatus, Basis, open(AbsentKeys, JudgedKeys, OutsideKeys), Items, Kind, Profile, Verdict).

settle(EngagementStatus, Basis, Suspension, Items, Kind, Profile, Verdict) :-
    engagement_keys(Kind, EngagementKeys),
    item_limbs(Items, ItemLimbs),
    open_limbs([limb(EngagementStatus, EngagementKeys), limb(Suspension, [reasonable_doubts_about_identity])|ItemLimbs], Open, LimbKeys),
    settled(Open, Basis, LimbKeys, Kind, Profile, Verdict).

item_limbs([], []).
item_limbs([exception(_, Status, _, Keys)|Items], [limb(Status, Keys)|Limbs]) :-
    item_limbs(Items, Limbs).

open_limbs([], none_open, []).
open_limbs([limb(met, _)|Limbs], Open, LimbKeys) :-
    open_limbs(Limbs, Open, LimbKeys).
open_limbs([limb(unmet, _)|Limbs], Open, LimbKeys) :-
    open_limbs(Limbs, Open, LimbKeys).
open_limbs([limb(open(AbsentKeys, JudgedKeys, OutsideKeys), Keys)|Limbs], Open, LimbKeys) :-
    open_limbs(Limbs, RemainingOpen, RemainingKeys),
    merge_open(AbsentKeys, JudgedKeys, OutsideKeys, RemainingOpen, Open),
    append(Keys, RemainingKeys, LimbKeys).

merge_open(AbsentKeys, JudgedKeys, OutsideKeys, none_open, open(AbsentKeys, JudgedKeys, OutsideKeys)).
merge_open(AbsentLeft, JudgedLeft, OutsideLeft, open(AbsentRight, JudgedRight, OutsideRight), open(AbsentKeys, JudgedKeys, OutsideKeys)) :-
    append(AbsentLeft, AbsentRight, AbsentKeys),
    append(JudgedLeft, JudgedRight, JudgedKeys),
    append(OutsideLeft, OutsideRight, OutsideKeys).

settled(none_open, Basis, _, _, _, gdpr_data_subject_request_verdict(must_comply, Basis, none, [], Citations)) :-
    verdict_citations(Basis, none, Citations).
settled(open(AbsentKeys, JudgedKeys, OutsideKeys), _, LimbKeys, Kind, Profile, Verdict) :-
    referral_class(AbsentKeys, OutsideKeys, Class),
    referral(Class, AbsentKeys, JudgedKeys, OutsideKeys, LimbKeys, Kind, Profile, Verdict).

referral_class([_|_], _, absent).
referral_class([], [_|_], outside).
referral_class([], [], judgement).

referral(absent, AbsentKeys, _, _, _, _, _, gdpr_data_subject_request_verdict(indeterminate(OrderedKeys), none, none, [], [])) :-
    contract_key_order(Order),
    order_keys(Order, AbsentKeys, OrderedKeys).
referral(outside, _, _, OutsideKeys, LimbKeys, Kind, Profile, gdpr_data_subject_request_verdict(needs_legal_review(cross_reference_unresolved(cite(eu_reg_2016_679_art_17_1_e), cite(union_or_member_state_law_requiring_erasure)), [resolution(cite(union_or_member_state_law_requiring_erasure), not_attempted), inputs_relied_on(Pairs)]), none, none, [], [])) :-
    relied_pairs(Profile, Kind, LimbKeys, OutsideKeys, Pairs).
referral(judgement, _, JudgedKeys, OutsideKeys, LimbKeys, Kind, Profile, gdpr_data_subject_request_verdict(needs_legal_review(open_textured(Input, Citation), [inputs_relied_on(Pairs)]), none, none, [], [])) :-
    contract_key_order(Order),
    order_keys(Order, JudgedKeys, [Input|_]),
    referral_key(Kind, Input, Citation),
    relied_pairs(Profile, Kind, LimbKeys, OutsideKeys, Pairs).

relied_pairs(Profile, Kind, LimbKeys, OutsideKeys, Pairs) :-
    kind_pairs(Kind, BasePairs),
    contract_key_order(Order),
    order_keys(Order, LimbKeys, OrderedKeys),
    pairs_for(Profile, OrderedKeys, JudgementPairs),
    order_keys(Order, OutsideKeys, OrderedOutside),
    outside_pairs(OrderedOutside, OutsidePairs),
    append(BasePairs, JudgementPairs, FirstPairs),
    append(FirstPairs, OutsidePairs, Pairs).

kind_pairs(access, [request_type-access]).
kind_pairs(rectification, [request_type-rectification]).
kind_pairs(erasure, [request_type-erasure]).
kind_pairs(restriction, [request_type-restriction]).
kind_pairs(portability, [request_type-portability]).
kind_pairs(automated_decision, [request_type-automated_decision]).
kind_pairs(objection_art21_1, [request_type-objection, objection_ground_claimed-art21_1]).
kind_pairs(objection_art21_2, [request_type-objection, objection_ground_claimed-art21_2]).
kind_pairs(objection_art21_6, [request_type-objection, objection_ground_claimed-art21_6]).

pairs_for(_, [], []).
pairs_for(Profile, [Key|Keys], Pairs) :-
    key_value(Profile, Key, Value),
    pairs_for(Profile, Keys, RemainingPairs),
    add_pair(Value, Key, RemainingPairs, Pairs).

add_pair(absent, _, Pairs, Pairs).
add_pair(present(Value), Key, Pairs, [Key-Value|Pairs]).

outside_pairs([], []).
outside_pairs([Key|Keys], [Key-absent|Pairs]) :-
    outside_pairs(Keys, Pairs).

% order_keys(ContractOrder, Wanted, Ordered): Wanted keys in contract order, once each.
order_keys([], _, []).
order_keys([Key|Keys], Wanted, Ordered) :-
    memberd_t(Key, Wanted, IsWanted),
    order_keys(Keys, Wanted, RemainingOrdered),
    ordered_add(IsWanted, Key, RemainingOrdered, Ordered).

ordered_add(true, Key, Keys, [Key|Keys]).
ordered_add(false, _, Keys, Keys).

verdict_citations(Basis, Exception, Citations) :-
    basis_cites(Basis, BasisCitations),
    exception_cites(Exception, ExceptionCitations),
    append(BasisCitations, ExceptionCitations, Citations).

% ---- status projection and facade ---------------------------------------------
gdpr_data_subject_rights_response_duties_status(Profile, Status) :-
    decide_gdpr_data_subject_rights_response_duties(Profile, gdpr_data_subject_request_verdict(Status, _, _, _, _)).

gdpr_data_subject_rights_response_duties_decision_resolvable(Profile) :-
    decide_gdpr_data_subject_rights_response_duties(Profile, _).

% ---- checklist ----------------------------------------------------------------
gdpr_data_subject_rights_response_duties_checklist(Profile, Items) :-
    gdpr_data_subject_rights_response_duties_input_problems(Profile, Problems),
    checklist_with_problems(Problems, Profile, Items).

checklist_with_problems([_|_], _, []).
checklist_with_problems([], Profile, Items) :-
    request_kind(Profile, KindResult),
    checklist_for(KindResult, Profile, Items).

checklist_for(missing(_), _, []).
checklist_for(kind(Kind), Profile, [item(engagement, EngagementRow, EngagementCitation), item(identity_suspension, SuspensionRow, cite(eu_reg_2016_679_art_12_6))|ExceptionRows]) :-
    engagement(Profile, Kind, EngagementStatus, _),
    engagement_cite(Kind, EngagementCitation),
    row_status(EngagementStatus, EngagementRow),
    suspension(Profile, SuspensionStatus),
    row_status(SuspensionStatus, SuspensionRow),
    exceptions(Profile, Kind, Items),
    exception_rows(Items, ExceptionRows).

exception_rows([], []).
exception_rows([exception(Name, Status, _, _)|Items], [item(Name, Row, Citation)|Rows]) :-
    exception_cites(Name, [Citation]),
    row_status(Status, Row),
    exception_rows(Items, Rows).

row_status(met, met).
row_status(unmet, unmet).
row_status(open(AbsentKeys, JudgedKeys, OutsideKeys), unknown(Keys)) :-
    append(AbsentKeys, JudgedKeys, FirstKeys),
    append(FirstKeys, OutsideKeys, Keys).

% ---- the period (B) ----------------------------------------------------------------
applicable_response_period(Profile, Period) :-
    implements(eu_reg_2016_679_art_12_3),
    key_value(Profile, extension_claimed, Claimed),
    claimed_period(Claimed, Profile, Period).

claimed_period(absent, _, first_period).
claimed_period(present(false), _, first_period).
claimed_period(present(true), Profile, Period) :-
    key_value(Profile, extension_necessary_for_complexity_and_number, Necessary),
    necessity_period(Necessary, Period).

necessity_period(absent, indeterminate([extension_necessary_for_complexity_and_number])).
necessity_period(present(true), extended_period).
necessity_period(present(false), first_period).
necessity_period(present(unsure), needs_legal_review(open_textured(extension_necessary_for_complexity_and_number, cite(eu_reg_2016_679_art_12_3)), [inputs_relied_on([extension_necessary_for_complexity_and_number-unsure])])).

% ---- calendar (Regulation 1182/71 Art 3) -------------------------------------------
calendar_deadline(date(CalendarYear, CalendarMonth, DayNumber), Period, Holidays, Deadline) :-
    implements(eu_reg_1971_1182_art_3),
    implements(eu_reg_1971_1182_art_3_1),
    implements(eu_reg_1971_1182_art_3_2_c),
    period_months(Period, Months, _),
    ZeroBasedMonth #= CalendarMonth - 1 + Months,
    TargetYear #= CalendarYear + ZeroBasedMonth // 12,
    TargetMonth #= ZeroBasedMonth mod 12 + 1,
    month_length(TargetYear, TargetMonth, Length),
    clipped_day(DayNumber, Length, TargetDay),
    shift_to_working_day(date(TargetYear, TargetMonth, TargetDay), Holidays, Deadline).

clipped_day(DayNumber, Length, DayNumber) :-
    DayNumber #=< Length.
clipped_day(DayNumber, Length, Length) :-
    DayNumber #> Length.

shift_to_working_day(Date, Holidays, Result) :-
    implements(eu_reg_1971_1182_art_3_4),
    day_class(Date, Holidays, Class),
    shift_by_class(Class, Date, Holidays, Result).

shift_by_class(working, Date, _, Date).
shift_by_class(rest, Date, Holidays, Result) :-
    next_day(Date, NextDate),
    shift_to_working_day(NextDate, Holidays, Result).

day_class(Date, Holidays, Class) :-
    weekday_code(Date, WeekdayCode),
    memberd_t(Date, Holidays, IsHoliday),
    class_of(WeekdayCode, IsHoliday, Class).

% WeekdayCode: 0 Saturday, 1 Sunday, 2 Monday ... 6 Friday.
class_of(WeekdayCode, _, rest) :-
    WeekdayCode #< 2.
class_of(WeekdayCode, true, rest) :-
    WeekdayCode #>= 2.
class_of(WeekdayCode, false, working) :-
    WeekdayCode #>= 2.

weekday_code(date(CalendarYear, CalendarMonth, DayNumber), WeekdayCode) :-
    weekday_adjustment(CalendarYear, CalendarMonth, AdjustedYear, AdjustedMonth),
    Century #= AdjustedYear // 100,
    YearOfCentury #= AdjustedYear mod 100,
    WeekdayCode #= (DayNumber + (13 * (AdjustedMonth + 1)) // 5 + YearOfCentury + YearOfCentury // 4 + Century // 4 + 5 * Century) mod 7.

weekday_adjustment(CalendarYear, CalendarMonth, CalendarYear, CalendarMonth) :-
    CalendarMonth #>= 3.
weekday_adjustment(CalendarYear, CalendarMonth, AdjustedYear, AdjustedMonth) :-
    CalendarMonth #< 3,
    AdjustedYear #= CalendarYear - 1,
    AdjustedMonth #= CalendarMonth + 12.

next_day(date(CalendarYear, CalendarMonth, DayNumber), NextDate) :-
    month_length(CalendarYear, CalendarMonth, Length),
    next_day_in(Length, CalendarYear, CalendarMonth, DayNumber, NextDate).

next_day_in(Length, CalendarYear, CalendarMonth, DayNumber, date(CalendarYear, CalendarMonth, NextDayNumber)) :-
    DayNumber #< Length,
    NextDayNumber #= DayNumber + 1.
next_day_in(Length, CalendarYear, CalendarMonth, DayNumber, date(CalendarYear, NextMonth, 1)) :-
    DayNumber #= Length,
    CalendarMonth #< 12,
    NextMonth #= CalendarMonth + 1.
next_day_in(Length, CalendarYear, CalendarMonth, DayNumber, date(NextYear, 1, 1)) :-
    DayNumber #= Length,
    CalendarMonth #= 12,
    NextYear #= CalendarYear + 1.

month_length(_, 1, 31).
month_length(CalendarYear, 2, Length) :-
    february_length(CalendarYear, Length).
month_length(_, 3, 31).
month_length(_, 4, 30).
month_length(_, 5, 31).
month_length(_, 6, 30).
month_length(_, 7, 31).
month_length(_, 8, 31).
month_length(_, 9, 30).
month_length(_, 10, 31).
month_length(_, 11, 30).
month_length(_, 12, 31).

february_length(CalendarYear, 29) :-
    CalendarYear mod 400 #= 0.
february_length(CalendarYear, 29) :-
    CalendarYear mod 4 #= 0,
    CalendarYear mod 100 #> 0.
february_length(CalendarYear, 28) :-
    CalendarYear mod 4 #> 0.
february_length(CalendarYear, 28) :-
    CalendarYear mod 100 #= 0,
    CalendarYear mod 400 #> 0.

holiday_list(Profile, Holidays) :-
    key_value(Profile, public_holidays, Value),
    holiday_value(Value, Holidays).

holiday_value(absent, []).
holiday_value(present(attested(Holidays, _)), Holidays).

% ---- (C) request_response_deadline/2 ---------------------------------------------------
request_response_deadline(Profile, Deadline) :-
    gdpr_data_subject_rights_response_duties_input_problems(Profile, Problems),
    deadline_with_problems(Problems, Profile, Deadline).

deadline_with_problems([Problem|Problems], _, input_problems([Problem|Problems])).
deadline_with_problems([], Profile, Deadline) :-
    key_value(Profile, request_received_on, Received),
    deadline_with_receipt(Received, Profile, Deadline).

deadline_with_receipt(absent, _, indeterminate([request_received_on])).
deadline_with_receipt(present(Receipt), Profile, Deadline) :-
    decide_gdpr_data_subject_rights_response_duties(Profile, gdpr_data_subject_request_verdict(Comply, _, _, _, _)),
    deadline_for_comply(Comply, Receipt, Profile, Deadline).

deadline_for_comply(need_not_comply, Receipt, Profile, Deadline) :-
    holiday_list(Profile, Holidays),
    calendar_deadline(Receipt, first_period, Holidays, Deadline).
deadline_for_comply(must_comply, Receipt, Profile, Deadline) :-
    applicable_response_period(Profile, Period),
    holiday_list(Profile, Holidays),
    period_deadline(Period, Receipt, Holidays, Deadline).
deadline_for_comply(indeterminate(Keys), _, _, indeterminate(Keys)).
deadline_for_comply(needs_legal_review(Reason, Context), _, _, needs_legal_review(Reason, Context)).
deadline_for_comply(suspended(Reason), _, _, suspended(Reason)).
deadline_for_comply(input_problems(Problems), _, _, input_problems(Problems)).

period_deadline(first_period, Receipt, Holidays, Deadline) :-
    calendar_deadline(Receipt, first_period, Holidays, Deadline).
period_deadline(extended_period, Receipt, Holidays, Deadline) :-
    calendar_deadline(Receipt, extended_period, Holidays, Deadline).
period_deadline(indeterminate(Keys), _, _, indeterminate(Keys)).
period_deadline(needs_legal_review(Reason, Context), _, _, needs_legal_review(Reason, Context)).

% ---- (D) response_duties/2 --------------------------------------------------------------
response_duties(Profile, Duties) :-
    gdpr_data_subject_rights_response_duties_input_problems(Profile, Problems),
    duties_with_problems(Problems, Profile, Duties).

duties_with_problems([Problem|Problems], _, input_problems([Problem|Problems])).
duties_with_problems([], Profile, Duties) :-
    decide_gdpr_data_subject_rights_response_duties(Profile, gdpr_data_subject_request_verdict(Comply, _, _, _, _)),
    duties_for_comply(Comply, Profile, Duties).

duties_for_comply(must_comply, Profile, Duties) :-
    applicable_response_period(Profile, Period),
    period_duties(Period, Duties).
duties_for_comply(need_not_comply, _, [inform_of_reasons_and_remedies(first_period, cite(eu_reg_2016_679_art_12_4))]) :-
    implements(eu_reg_2016_679_art_12_4).
duties_for_comply(indeterminate(Keys), _, indeterminate(Keys)).
duties_for_comply(needs_legal_review(Reason, Context), _, needs_legal_review(Reason, Context)).
duties_for_comply(suspended(Reason), _, suspended(Reason)).
duties_for_comply(input_problems(Problems), _, input_problems(Problems)).

period_duties(first_period, [respond_with_action_taken(first_period, cite(eu_reg_2016_679_art_12_3))]).
period_duties(extended_period, [inform_of_extension_with_reasons(first_period, cite(eu_reg_2016_679_art_12_3)), respond_with_action_taken(extended_period, cite(eu_reg_2016_679_art_12_3))]).
period_duties(indeterminate(Keys), indeterminate(Keys)).
period_duties(needs_legal_review(Reason, Context), needs_legal_review(Reason, Context)).

% ---- (E) recipient_notification/2 ------------------------------------------------------
recipient_notification(Profile, Duties) :-
    gdpr_data_subject_rights_response_duties_input_problems(Profile, Problems),
    recipients_with_problems(Problems, Profile, Duties).

recipients_with_problems([Problem|Problems], _, input_problems([Problem|Problems])).
recipients_with_problems([], Profile, Duties) :-
    decide_gdpr_data_subject_rights_response_duties(Profile, gdpr_data_subject_request_verdict(Comply, _, _, _, _)),
    recipient_duties(Comply, Profile, Duties).

recipient_duties(need_not_comply, _, [recipient_notification_not_applicable(cite(eu_reg_2016_679_art_19))]).
recipient_duties(indeterminate(Keys), _, indeterminate(Keys)).
recipient_duties(needs_legal_review(Reason, Context), _, needs_legal_review(Reason, Context)).
recipient_duties(suspended(Reason), _, suspended(Reason)).
recipient_duties(input_problems(Problems), _, input_problems(Problems)).
recipient_duties(must_comply, Profile, Duties) :-
    request_kind(Profile, kind(Kind)),
    notification_scope(Kind, Scope),
    scope_duties(Scope, Profile, Duties).

notification_scope(rectification, covered).
notification_scope(erasure, covered).
notification_scope(restriction, covered).
notification_scope(access, not_covered).
notification_scope(portability, not_covered).
notification_scope(objection_art21_1, not_covered).
notification_scope(objection_art21_2, not_covered).
notification_scope(objection_art21_6, not_covered).
notification_scope(automated_decision, not_covered).

scope_duties(not_covered, _, [recipient_notification_not_applicable(cite(eu_reg_2016_679_art_19))]).
scope_duties(covered, Profile, Duties) :-
    implements(eu_reg_2016_679_art_19),
    key_value(Profile, personal_data_disclosed_to_recipients, Disclosed),
    disclosed_duties(Disclosed, Profile, Duties).

disclosed_duties(absent, _, indeterminate([personal_data_disclosed_to_recipients])).
disclosed_duties(present(false), _, [recipient_notification_not_applicable(cite(eu_reg_2016_679_art_19))]).
disclosed_duties(present(true), Profile, Duties) :-
    key_value(Profile, recipient_notification_impossible_or_disproportionate_effort, Effort),
    effort_duties(Effort, Profile, Duties).

effort_duties(absent, _, indeterminate([recipient_notification_impossible_or_disproportionate_effort])).
effort_duties(present(true), _, [recipient_notification_excused(cite(eu_reg_2016_679_art_19))]).
effort_duties(present(unsure), _, needs_legal_review(open_textured(recipient_notification_impossible_or_disproportionate_effort, cite(eu_reg_2016_679_art_19)), [inputs_relied_on([recipient_notification_impossible_or_disproportionate_effort-unsure])])).
effort_duties(present(false), Profile, Duties) :-
    key_value(Profile, data_subject_asks_who_the_recipients_are, Asks),
    asked_duties(Asks, Duties).

asked_duties(present(true), [communicate_to_each_recipient(cite(eu_reg_2016_679_art_19)), inform_data_subject_of_recipients(cite(eu_reg_2016_679_art_19))]).
asked_duties(present(false), [communicate_to_each_recipient(cite(eu_reg_2016_679_art_19))]).
asked_duties(absent, [communicate_to_each_recipient(cite(eu_reg_2016_679_art_19))]).

% ---- tests ------------------------------------------------------------------------------
test(access_must_comply) :-
    decide_gdpr_data_subject_rights_response_duties([attribute(request_type, access)], gdpr_data_subject_request_verdict(must_comply, art15_1, none, [], _)).
test(missing_request_type_is_indeterminate) :-
    decide_gdpr_data_subject_rights_response_duties([], gdpr_data_subject_request_verdict(indeterminate([request_type]), none, none, [], [])).
test(manifestly_excessive_request_need_not_comply) :-
    decide_gdpr_data_subject_rights_response_duties([attribute(request_type, access), attribute(request_manifestly_unfounded_or_excessive, true)], gdpr_data_subject_request_verdict(need_not_comply, art15_1, art12_5_manifestly_unfounded_or_excessive, [reasonable_fee_may_be_charged], _)).
test(manifestly_excessive_is_not_must_comply, fail) :-
    decide_gdpr_data_subject_rights_response_duties([attribute(request_type, access), attribute(request_manifestly_unfounded_or_excessive, true)], gdpr_data_subject_request_verdict(must_comply, _, _, _, _)).
test(unconfirmed_identity_suspends) :-
    decide_gdpr_data_subject_rights_response_duties([attribute(request_type, access), attribute(reasonable_doubts_about_identity, true), attribute(identity_confirmed, false)], gdpr_data_subject_request_verdict(suspended(art12_6_identity_not_confirmed), none, none, [], [])).
test(first_period_deadline_moves_off_sunday) :-
    request_response_deadline([attribute(request_type, access), attribute(request_received_on, date(2026, 10, 29))], date(2026, 11, 30)).
test(deadline_is_not_the_sunday, fail) :-
    request_response_deadline([attribute(request_type, access), attribute(request_received_on, date(2026, 10, 29))], date(2026, 11, 29)).
test(extended_deadline_clipped_to_month_end) :-
    calendar_deadline(date(2026, 1, 31), extended_period, [], date(2026, 4, 30)).
test(leap_year_deadline) :-
    calendar_deadline(date(2028, 1, 31), first_period, [], date(2028, 2, 29)).
test(year_end_receipt) :-
    calendar_deadline(date(2026, 12, 31), first_period, [], date(2027, 2, 1)).
test(attested_holiday_shifts_deadline) :-
    calendar_deadline(date(2026, 10, 29), first_period, [date(2026, 11, 30)], date(2026, 12, 1)).
test(extension_gives_extended_deadline) :-
    request_response_deadline([attribute(request_type, access), attribute(request_received_on, date(2026, 1, 31)), attribute(extension_claimed, true), attribute(extension_necessary_for_complexity_and_number, true)], date(2026, 4, 30)).
test(first_period_duty) :-
    response_duties([attribute(request_type, access)], [respond_with_action_taken(first_period, cite(eu_reg_2016_679_art_12_3))]).
test(refusal_duty) :-
    response_duties([attribute(request_type, access), attribute(controller_demonstrates_unable_to_identify_data_subject, true)], [inform_of_reasons_and_remedies(first_period, cite(eu_reg_2016_679_art_12_4))]).
test(access_has_no_recipient_duty) :-
    recipient_notification([attribute(request_type, access)], [recipient_notification_not_applicable(cite(eu_reg_2016_679_art_19))]).

:- end_module(gdpr_data_subject_rights_response_duties).
