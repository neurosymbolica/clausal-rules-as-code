% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% queries.clausal -- QUERY-COMBINATOR layer for eu/data_protection/gdpr_data_subject_rights_response_duties.
% A TOP-LAYER consumer: it imports the determination slice's PUBLIC
% predicates it calls, and nothing else.
%
% Query types this domain serves (registered in manifest.yaml query_interface):
%   #2  status: gdpr_data_subject_rights_response_duties_status/2 (the functor of
%       the internal decision: must_comply, need_not_comply, indeterminate,
%       needs_legal_review, suspended, input_problems).
%   #14 obligation_surfacing: response_duties/2 (Art 12(3) and 12(4) duties);
%       recipient_notification/2 (Art 19 duties) answers the same query type for
%       the communication to recipients. Both live in the determination slice
%       gdpr_data_subject_rights_response_duties.clausal and are exported by
%       the package facade.
%   #15 deadline: request_response_deadline/2 (Art 12(3) and 12(4), with the
%       calendar rule of Regulation (EEC, Euratom) No 1182/71 Art 3), also in
%       the slice.
%   #16 what-if: gdpr_data_subject_rights_response_duties_what_if/4 below.
%
% gdpr_data_subject_rights_response_duties_profile_keys/1: top-level profile key schema
% gdpr_data_subject_rights_response_duties_input_problems/2: the problems a profile has ([] = none)
%
% The profile is an ATTRIBUTE LIST, not a dict, so the kit's override_key/4
% (a dict operation) does not apply: the what-if override is list plumbing
% here. Every attribute(Key, _) item of the overridden key is dropped and one
% attribute(Key, Value) item is appended. Appending without dropping would
% leave the key twice, which the input check reports as duplicate_key(Key).
% =====================================================================

:- module(queries, [
    gdpr_data_subject_rights_response_duties_profile_keys/1,
    gdpr_data_subject_rights_response_duties_input_problems/2,
    gdpr_data_subject_rights_response_duties_what_if/4
]).

:- use_module(eu/data_protection/gdpr_data_subject_rights_response_duties/kernel, [gdpr_data_subject_rights_response_duties_input_problems/2]).
:- use_module(eu/data_protection/gdpr_data_subject_rights_response_duties/gdpr_data_subject_rights_response_duties, [gdpr_data_subject_rights_response_duties_status/2]).

% schema of top-level profile keys: the keys of the order's typed input contract, in its order
gdpr_data_subject_rights_response_duties_profile_keys([request_type, objection_ground_claimed, request_received_on, extension_claimed, controller_demonstrates_unable_to_identify_data_subject, identity_confirmed, personal_data_inaccurate, consent_is_the_basis_of_processing, consent_withdrawn, other_legal_ground_for_processing_exists, objection_under_art21_1_made, objection_under_art21_2_made, collected_in_relation_to_information_society_services_offer, accuracy_contested_by_data_subject, data_subject_opposes_erasure, data_required_by_data_subject_for_legal_claims, verification_of_overriding_grounds_pending, personal_data_provided_by_data_subject, processing_based_on_consent_or_contract, processing_carried_out_by_automated_means, processing_based_on_art6_1_e_or_f, processing_for_direct_marketing, processing_for_research_or_statistics_pursuant_to_art89_1, data_subject_gave_explicit_consent, decision_based_on_special_categories, special_category_condition_and_safeguards_met_for_decision, personal_data_disclosed_to_recipients, data_subject_asks_who_the_recipients_are, extension_necessary_for_complexity_and_number, reasonable_doubts_about_identity, request_manifestly_unfounded_or_excessive, personal_data_incomplete_in_light_of_purposes, data_no_longer_necessary_for_purposes, overriding_legitimate_grounds_exist, personal_data_unlawfully_processed, processing_necessary_for_freedom_of_expression_and_information, processing_necessary_for_public_task_or_official_authority, processing_necessary_for_public_health_in_accordance_with_art9_2_h_and_i, processing_for_archiving_research_or_statistics_in_accordance_with_art89_1, erasure_would_render_impossible_or_seriously_impair_processing_objectives, processing_necessary_for_legal_claims, controller_no_longer_needs_data_for_processing_purposes, transmission_would_adversely_affect_rights_and_freedoms_of_others, objection_grounds_relate_to_particular_situation, controller_demonstrates_compelling_legitimate_grounds, decision_based_solely_on_automated_processing, decision_produces_legal_or_similarly_significant_effects, decision_necessary_for_contract_with_data_subject, recipient_notification_impossible_or_disproportionate_effort, legislative_restriction_applies_to_the_right, erasure_required_by_union_or_member_state_law, processing_required_by_union_or_member_state_law, decision_authorised_by_union_or_member_state_law, public_holidays]).

% #16 what-if: re-evaluate with one key hypothetically overridden
gdpr_data_subject_rights_response_duties_what_if(Profile, OverriddenKey, NewValue, NewStatus) :-
    exclude(attribute_with_key(OverriddenKey), Profile, OtherAttributes),
    append(OtherAttributes, [attribute(OverriddenKey, NewValue)], Hypothesis),
    gdpr_data_subject_rights_response_duties_status(Hypothesis, NewStatus).

attribute_with_key(AttributeKey, attribute(ElementKey, _)) :-
    ElementKey == AttributeKey.

test(what_if_a_manifestly_excessive_access_request_is_refused) :-
    gdpr_data_subject_rights_response_duties_what_if([attribute(request_type, access)], request_manifestly_unfounded_or_excessive, true, Status),
    Status == need_not_comply.
test(what_if_replaces_the_key_instead_of_duplicating_it) :-
    gdpr_data_subject_rights_response_duties_what_if([attribute(request_type, access), attribute(request_manifestly_unfounded_or_excessive, true)], request_manifestly_unfounded_or_excessive, false, Status),
    Status == must_comply.
test(what_if_unconfirmed_identity_suspends) :-
    gdpr_data_subject_rights_response_duties_what_if([attribute(request_type, access), attribute(reasonable_doubts_about_identity, true), attribute(identity_confirmed, true)], identity_confirmed, false, Status),
    Status == suspended.

:- end_module(queries).
