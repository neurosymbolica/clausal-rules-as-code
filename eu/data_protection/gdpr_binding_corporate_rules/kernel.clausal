% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% kernel.clausal -- the SHARED FLOOR for eu/data_protection/gdpr_binding_corporate_rules (deontic family).
% DAG root of the determination-slices layout. It holds ONLY the
% PREDICATES that two or more files CALL. This package has ONE
% determination slice (gdpr_binding_corporate_rules.clausal), so no
% domain predicate is shared and none is defined here.
% Exception: the scaffold writes the order's input check
% gdpr_binding_corporate_rules_input_problems/2 here, exported, for the
% slice to import. It is profile plumbing from the typed input contract
% and decides no statutory condition, so it carries no implements/1 marker.
%
% Source: Regulation (EU) 2016/679 (GDPR), consolidated text
% 02016R0679-20160504: Art 4(20) (definition of binding corporate rules,
% citation key eu_reg_2016_679_art_4_20) and Art 47(2), opening words and
% points (a) to (n) (the content binding corporate rules shall specify at
% least, citation keys eu_reg_2016_679_art_47_2 and
% eu_reg_2016_679_art_47_2_a .. eu_reg_2016_679_art_47_2_n).
% a reading, not a lawyer's. Approval under Art 47(1) is NOT
% decided in this package.
%
% Atoms and data terms need NO declaration and NO import. The comment
% block below only RECORDS the result terms so every file spells them
% alike.
%
% Result terms built by the one slice (gdpr_binding_corporate_rules):
%
%   binding_corporate_rules_definition(Profile, Result, Citations)
%     Result: binding_corporate_rules | not_binding_corporate_rules
%             | indeterminate([Key])            (first absent Art 4(20) key)
%             | needs_legal_review(open_textured(Key, cite(eu_reg_2016_679_art_4_20)),
%                                  [inputs_relied_on(Pairs)])
%             | input_problems(Problems)
%     Citations: [cite(eu_reg_2016_679_art_4_20)] on a final answer, [] on a status.
%
%   binding_corporate_rules_content(Profile, Result, Citations)
%     Result: content_complete | content_incomplete
%             | indeterminate([Key])            (first absent point key, (a) to (n))
%             | needs_legal_review(open_textured(rules_specify_appropriate_data_protection_training,
%                                               cite(eu_reg_2016_679_art_47_2_n)),
%                                  [inputs_relied_on([rules_specify_appropriate_data_protection_training-unsure])])
%             | input_problems(Problems)
%     Citations: content_incomplete -> [cite(eu_reg_2016_679_art_47_2)];
%                content_complete -> the opening words and points (a) to (n),
%                fifteen cite(...) terms; [] on a status.
%
%   binding_corporate_rules_content_checklist(Profile, Items)
%     Items: fourteen checklist_item(Key, cite(Citation), State) terms, points
%            (a) to (n) in order, State one of met | unmet | open_by_absence
%            | open_by_judgement; or input_problems(Problems).
%
%   gdpr_binding_corporate_rules_verdict(Status, Citations)
%     the scaffold facade's wrapper: Status and Citations as returned by
%     binding_corporate_rules_definition/3.
%
%   Problems: [] or a list of duplicate_key(Key), wrong_type(Key),
%   unknown_key(Key) terms, or [wrong_type(profile)].
%   Pairs: Key-Value pairs of the judgement keys the query read, present in
%   the profile, in root_exports order (THE PAIRS RULE).
%   The bare atom indeterminate is NEVER written.
% =====================================================================

:- module(kernel, [gdpr_binding_corporate_rules_input_problems/2]).

:- use_module(library(reif), [memberd_t/3]).

% ---- input checks: the problems a profile has, if any -----------
% gdpr_binding_corporate_rules_input_problems(Profile, Problems): Problems = [] means the profile can be
% judged. Written from the order's typed input contract
% (input_contract.types.profile: attribute_list).
% Each public query calls this check first: it gives its normal answer only when
% Problems = [], and when Problems is not [] it gives the answer the order states for
% a profile with input problems.
% It gives exactly one answer for every Profile, and the answer is ground except for a
% Key named as given:
% - a Profile that is not an attribute list [attribute(Key, Value), ...] gives [wrong_type(profile)]:
%   an unbound Profile, a partial list, a list holding an unbound item or an item that is
%   not attribute(_, _);
% - a Key that is not an atom (a number, a string, a compound term, an unbound variable)
%   is a key outside the contract: unknown_key(Key), Key as given;
% - otherwise, for each contract key in the contract's key order, duplicate_key(Key) when
%   the key occurs more than once in Profile (whatever its values: none of them is read,
%   so it is never also wrong_type(Key)), else wrong_type(Key) when its one value is
%   outside its type; then unknown_key(Key) for each key outside the contract, in the
%   order of its first occurrence in Profile. Each key is named once. An absent key is
%   not a problem.
% Every step is complementary clauses: exactly one clause holds for each input.
gdpr_binding_corporate_rules_input_problems(Profile, Problems) :-
    attribute_list_t(Profile, IsAttributeList),
    profile_problems(IsAttributeList, Profile, Problems).

profile_problems(false, _, [wrong_type(profile)]).
profile_problems(true, Profile, Problems) :-
    Keys = [policies_are_personal_data_protection_policies, policies_adhered_to_by_adhering_party, adhering_party_is_controller_or_processor, adhering_party_established_on_territory_of_member_state, policies_cover_transfers_to_third_countries, recipients_are_controllers_or_processors, transfers_within_group_of_undertakings_or_group_of_enterprises, rules_specify_group_structure_and_contact_details, rules_specify_data_transfers, rules_specify_legally_binding_nature, rules_specify_application_of_general_data_protection_principles, rules_specify_data_subject_rights_and_means_to_exercise_them, rules_specify_acceptance_of_liability_for_members_outside_union, rules_specify_how_information_is_provided_to_data_subjects, rules_specify_tasks_of_compliance_monitoring_persons, rules_specify_complaint_procedures, rules_specify_compliance_verification_mechanisms, rules_specify_change_reporting_and_recording_mechanisms, rules_specify_cooperation_mechanism_with_supervisory_authority, rules_specify_reporting_of_third_country_legal_requirements, rules_specify_appropriate_data_protection_training],
    unknown_keys(Profile, Keys, UnknownKeyProblems),
    key_problems(Keys, Profile, UnknownKeyProblems, Problems).

% The contract: each key and the type of its value.
key_type(policies_are_personal_data_protection_policies, boolean).
key_type(policies_adhered_to_by_adhering_party, boolean).
key_type(adhering_party_is_controller_or_processor, judgement).
key_type(adhering_party_established_on_territory_of_member_state, boolean).
key_type(policies_cover_transfers_to_third_countries, boolean).
key_type(recipients_are_controllers_or_processors, judgement).
key_type(transfers_within_group_of_undertakings_or_group_of_enterprises, judgement).
key_type(rules_specify_group_structure_and_contact_details, boolean).
key_type(rules_specify_data_transfers, boolean).
key_type(rules_specify_legally_binding_nature, boolean).
key_type(rules_specify_application_of_general_data_protection_principles, boolean).
key_type(rules_specify_data_subject_rights_and_means_to_exercise_them, boolean).
key_type(rules_specify_acceptance_of_liability_for_members_outside_union, boolean).
key_type(rules_specify_how_information_is_provided_to_data_subjects, boolean).
key_type(rules_specify_tasks_of_compliance_monitoring_persons, boolean).
key_type(rules_specify_complaint_procedures, boolean).
key_type(rules_specify_compliance_verification_mechanisms, boolean).
key_type(rules_specify_change_reporting_and_recording_mechanisms, boolean).
key_type(rules_specify_cooperation_mechanism_with_supervisory_authority, boolean).
key_type(rules_specify_reporting_of_third_country_legal_requirements, boolean).
key_type(rules_specify_appropriate_data_protection_training, judgement).

% attribute_list_t(Term, T): T is true when Term is a list of attribute(Key, Value)
% items, whatever each Key is; false for anything else, an unbound Term or item included.
attribute_list_t(Term, false) :-
    var(Term).
attribute_list_t(Term, true) :-
    Term == [].
attribute_list_t(Term, T) :-
    nonvar(Term),
    Term = [Element|Elements],
    attribute_t(Element, ElementIsAttribute),
    attribute_list_t(Elements, ElementsAreAttributes),
    truth_and(ElementIsAttribute, ElementsAreAttributes, T).
attribute_list_t(Term, false) :-
    nonvar(Term),
    Term \== [],
    Term \= [_|_].

attribute_t(Element, false) :-
    var(Element).
attribute_t(Element, true) :-
    nonvar(Element),
    Element = attribute(_, _).
attribute_t(Element, false) :-
    nonvar(Element),
    Element \= attribute(_, _).

% Unknown keys, in profile order, each once: Known grows by each key named. A key is
% known when it is identical (==) to one in Known, so an unbound Key is never bound:
% the same variable twice is one unknown key, two different variables are two.
unknown_keys([], _, []).
unknown_keys([attribute(Key, _)|Elements], Known, Problems) :-
    known_t(Key, Known, IsKnown),
    name_unknown_key(IsKnown, Key, Known, Elements, Problems).

known_t(_, [], false).
known_t(Key, [Known|_], true) :-
    Known == Key.
known_t(Key, [Known|Knowns], T) :-
    Known \== Key,
    known_t(Key, Knowns, T).

name_unknown_key(true, _, Known, Elements, Problems) :-
    unknown_keys(Elements, Known, Problems).
name_unknown_key(false, Key, Known, Elements, [unknown_key(Key)|Problems]) :-
    unknown_keys(Elements, [Key|Known], Problems).

% Contract keys, in contract order: duplicate_key(Key) when the key occurs more than once
% (none of its values is read), else wrong_type(Key) when its one value is outside the
% key's type. An absent key has no value to check.
key_problems([], _, Problems, Problems).
key_problems([Key|Keys], Profile, LaterProblems, Problems) :-
    key_type(Key, Type),
    key_occurrences(Profile, Key, Occurrences),
    key_problems(Keys, Profile, LaterProblems, KeyProblems),
    name_key_problem(Occurrences, Key, Type, Profile, KeyProblems, Problems).

% key_occurrences(Elements, Key, Occurrences): none, one or many items give Key.
key_occurrences([], _, none).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey == Key,
    key_occurrences(Elements, Key, RestOccurrences),
    one_more_occurrence(RestOccurrences, Occurrences).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey \== Key,
    key_occurrences(Elements, Key, Occurrences).

one_more_occurrence(none, one).
one_more_occurrence(one, many).
one_more_occurrence(many, many).

name_key_problem(none, _, _, _, Problems, Problems).
name_key_problem(many, Key, _, _, Problems, [duplicate_key(Key)|Problems]).
name_key_problem(one, Key, Type, Profile, KeyProblems, Problems) :-
    values_in_type_t(Profile, Key, Type, InType),
    name_wrong_type(InType, Key, KeyProblems, Problems).

name_wrong_type(true, _, Problems, Problems).
name_wrong_type(false, Key, Problems, [wrong_type(Key)|Problems]).

% values_in_type_t(Elements, Key, Type, T): T is true when every value Elements gives Key is
% in Type (true when Elements gives Key none).
values_in_type_t([], _, _, true).
values_in_type_t([attribute(ElementKey, Value)|Elements], Key, Type, T) :-
    ElementKey == Key,
    value_in_type_t(Type, Value, ValueInType),
    values_in_type_t(Elements, Key, Type, RestInType),
    truth_and(ValueInType, RestInType, T).
values_in_type_t([attribute(ElementKey, _)|Elements], Key, Type, T) :-
    ElementKey \== Key,
    values_in_type_t(Elements, Key, Type, T).

% A value with an unbound part is outside every type; a ground one is checked.
value_in_type_t(Type, Value, T) :-
    term_variables(Value, Variables),
    ground_value_in_type_t(Variables, Type, Value, T).

ground_value_in_type_t([_|_], _, _, false).
ground_value_in_type_t([], Type, Value, T) :-
    in_type_t(Type, Value, T).

% in_type_t(Type, Value, T): one clause per type, for a ground Value.
in_type_t(judgement, Value, T) :-
    in_type_t(one_of([boolean, enum([unsure])]), Value, T).

in_type_t(boolean, Value, T) :-
    memberd_t(Value, [true, false], T).

in_type_t(enum(Values), Value, T) :-
    memberd_t(Value, Values, T).

in_type_t(one_of(Types), Value, T) :-
    in_some_type_t(Types, Value, T).

truth_and(true, T, T).
truth_and(false, _, false).

% in_some_type_t(Types, Value, T): T is true when Value is in at least one of Types.
in_some_type_t([], _, false).
in_some_type_t([Type|Types], Value, T) :-
    in_type_t(Type, Value, InType),
    in_some_type_t(Types, Value, InAnother),
    truth_or(InType, InAnother, T).

truth_or(true, _, true).
truth_or(false, T, T).

:- end_module(kernel).
