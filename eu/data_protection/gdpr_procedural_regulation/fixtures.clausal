% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% fixtures.clausal -- representative profiles for eu/data_protection/gdpr_procedural_regulation.
% A TOP-LAYER consumer: it imports the determination slice's PUBLIC predicate
% it calls. Profile keys and subject ids are atoms and need no import.
%
% A profile is an ATTRIBUTE LIST [attribute(Key, Value), ...] (the order's typed
% input contract). Each route of THE LIMBS has a positive subject and a
% one-unit near-miss control that flips exactly one key:
%   admissibility    : admissible_data_subject_complaint / inadmissible_missing_description;
%                      admissible_article_80_1_complaint / inadmissible_missing_mandate;
%                      admissible_article_80_2_complaint_without_mandate_key (point (c)
%                      not read for an Art 80(2) body); lodger_not_stated (indeterminate);
%   prior request    : prior_request_made / prior_request_not_made;
%                      prior_request_not_required; prior_request_unsure (lawyer);
%   early resolution : early_resolution_by_receiving_authority / early_resolution_by_lead_authority
%                      / early_resolution_objected; early_resolution_outside_chapter_iii_rights;
%                      early_resolution_infringement_not_ended;
%   simple procedure : simple_procedure_available / simple_procedure_objected /
%                      simple_procedure_scope_doubt / local_case_under_article_56_2;
%                      simple_procedure_scope_doubt_without_local_statement (absent referral);
%                      simple_procedure_cooperation_unsure (lawyer);
%   draft decision   : draft_decision_base_limit / draft_decision_suspended_and_extended /
%                      draft_decision_unjustified_extension / draft_decision_complexity_unsure;
%                      simple_procedure_draft_decision_without_extension /
%                      simple_procedure_extension_with_national_statement /
%                      simple_procedure_extension_refused_by_national_law /
%                      simple_procedure_extension_without_national_statement;
%   late step        : late_step_under_this_regulation / late_step_under_national_law /
%                      late_step_without_source_statement;
%   input check      : malformed_profile_duplicates_and_unknown.
% The temporal boundary pairs (2027-04-01 / 02 / 03) and the sixteen time-limit
% rows are arguments, not profiles: tests/test_public_interface.clausal asserts them.
% =====================================================================

:- module(fixtures, [
    gdpr_procedural_regulation_subject/1,
    gdpr_procedural_regulation_profile_for/2,
    gdpr_procedural_regulation_assess/2
]).

:- use_module(eu/data_protection/gdpr_procedural_regulation/gdpr_procedural_regulation, [decide_gdpr_procedural_regulation/2]).

% ---- Subject registry ------------------------------------------------
gdpr_procedural_regulation_subject(admissible_data_subject_complaint).
gdpr_procedural_regulation_subject(inadmissible_missing_description).
gdpr_procedural_regulation_subject(admissible_article_80_1_complaint).
gdpr_procedural_regulation_subject(inadmissible_missing_mandate).
gdpr_procedural_regulation_subject(admissible_article_80_2_complaint_without_mandate_key).
gdpr_procedural_regulation_subject(lodger_not_stated).
gdpr_procedural_regulation_subject(prior_request_made).
gdpr_procedural_regulation_subject(prior_request_not_made).
gdpr_procedural_regulation_subject(prior_request_not_required).
gdpr_procedural_regulation_subject(prior_request_unsure).
gdpr_procedural_regulation_subject(early_resolution_by_receiving_authority).
gdpr_procedural_regulation_subject(early_resolution_by_lead_authority).
gdpr_procedural_regulation_subject(early_resolution_objected).
gdpr_procedural_regulation_subject(early_resolution_outside_chapter_iii_rights).
gdpr_procedural_regulation_subject(early_resolution_infringement_not_ended).
gdpr_procedural_regulation_subject(local_case_under_article_56_2).
gdpr_procedural_regulation_subject(simple_procedure_available).
gdpr_procedural_regulation_subject(simple_procedure_objected).
gdpr_procedural_regulation_subject(simple_procedure_scope_doubt).
gdpr_procedural_regulation_subject(simple_procedure_scope_doubt_without_local_statement).
gdpr_procedural_regulation_subject(simple_procedure_cooperation_unsure).
gdpr_procedural_regulation_subject(draft_decision_base_limit).
gdpr_procedural_regulation_subject(draft_decision_suspended_and_extended).
gdpr_procedural_regulation_subject(draft_decision_unjustified_extension).
gdpr_procedural_regulation_subject(draft_decision_complexity_unsure).
gdpr_procedural_regulation_subject(simple_procedure_draft_decision_without_extension).
gdpr_procedural_regulation_subject(simple_procedure_extension_with_national_statement).
gdpr_procedural_regulation_subject(simple_procedure_extension_refused_by_national_law).
gdpr_procedural_regulation_subject(simple_procedure_extension_without_national_statement).
gdpr_procedural_regulation_subject(late_step_under_this_regulation).
gdpr_procedural_regulation_subject(late_step_under_national_law).
gdpr_procedural_regulation_subject(late_step_without_source_statement).
gdpr_procedural_regulation_subject(malformed_profile_duplicates_and_unknown).

% ---- Profiles: complaint admissibility (Art 4(1), (2), (5)) ----------
gdpr_procedural_regulation_profile_for(admissible_data_subject_complaint, [
    attribute(complaint_lodged_by, data_subject),
    attribute(lodging_person_name_and_contact_details_included, true),
    attribute(controller_or_processor_identification_information_included, true),
    attribute(alleged_infringement_description_included, true)
]).
% near miss: the description of the alleged infringement is not included (point (e)).
gdpr_procedural_regulation_profile_for(inadmissible_missing_description, [
    attribute(complaint_lodged_by, data_subject),
    attribute(lodging_person_name_and_contact_details_included, true),
    attribute(controller_or_processor_identification_information_included, true),
    attribute(alleged_infringement_description_included, false)
]).
gdpr_procedural_regulation_profile_for(admissible_article_80_1_complaint, [
    attribute(complaint_lodged_by, article_80_1_body),
    attribute(lodging_person_name_and_contact_details_included, true),
    attribute(proof_of_proper_constitution_included, true),
    attribute(proof_of_data_subject_mandate_included, true),
    attribute(controller_or_processor_identification_information_included, true),
    attribute(alleged_infringement_description_included, true)
]).
% near miss: the proof of a data subject's mandate is not included (point (c)).
gdpr_procedural_regulation_profile_for(inadmissible_missing_mandate, [
    attribute(complaint_lodged_by, article_80_1_body),
    attribute(lodging_person_name_and_contact_details_included, true),
    attribute(proof_of_proper_constitution_included, true),
    attribute(proof_of_data_subject_mandate_included, false),
    attribute(controller_or_processor_identification_information_included, true),
    attribute(alleged_infringement_description_included, true)
]).
% an Art 80(2) body: point (b) applies, point (c) is not read.
gdpr_procedural_regulation_profile_for(admissible_article_80_2_complaint_without_mandate_key, [
    attribute(complaint_lodged_by, article_80_2_body),
    attribute(lodging_person_name_and_contact_details_included, true),
    attribute(proof_of_proper_constitution_included, true),
    attribute(controller_or_processor_identification_information_included, true),
    attribute(alleged_infringement_description_included, true)
]).
% near miss of the data subject complaint: who lodges is not stated.
gdpr_procedural_regulation_profile_for(lodger_not_stated, [
    attribute(lodging_person_name_and_contact_details_included, true),
    attribute(controller_or_processor_identification_information_included, true),
    attribute(alleged_infringement_description_included, true)
]).

% ---- Profiles: the prior request (Art 4(3)) --------------------------
gdpr_procedural_regulation_profile_for(prior_request_made, [
    attribute(complaint_concerns_right_exercised_by_request, true),
    attribute(request_made_to_controller_before_complaint, true)
]).
gdpr_procedural_regulation_profile_for(prior_request_not_made, [
    attribute(complaint_concerns_right_exercised_by_request, true),
    attribute(request_made_to_controller_before_complaint, false)
]).
gdpr_procedural_regulation_profile_for(prior_request_not_required, [
    attribute(complaint_concerns_right_exercised_by_request, false),
    attribute(request_made_to_controller_before_complaint, false)
]).
gdpr_procedural_regulation_profile_for(prior_request_unsure, [
    attribute(complaint_concerns_right_exercised_by_request, unsure),
    attribute(request_made_to_controller_before_complaint, false)
]).

% ---- Profiles: early resolution (Art 5(1) to (4), (6)) ---------------
gdpr_procedural_regulation_profile_for(early_resolution_by_receiving_authority, [
    attribute(complaint_concerns_chapter_iii_rights, true),
    attribute(end_of_infringement_established_on_supporting_evidence, true),
    attribute(complainant_objected_to_early_resolution_in_time, false),
    attribute(early_resolution_procedure_before, receiving_authority)
]).
gdpr_procedural_regulation_profile_for(early_resolution_by_lead_authority, [
    attribute(complaint_concerns_chapter_iii_rights, true),
    attribute(end_of_infringement_established_on_supporting_evidence, true),
    attribute(complainant_objected_to_early_resolution_in_time, false),
    attribute(early_resolution_procedure_before, lead_authority)
]).
% near miss: the complainant objected within the four weeks.
gdpr_procedural_regulation_profile_for(early_resolution_objected, [
    attribute(complaint_concerns_chapter_iii_rights, true),
    attribute(end_of_infringement_established_on_supporting_evidence, true),
    attribute(complainant_objected_to_early_resolution_in_time, true),
    attribute(early_resolution_procedure_before, receiving_authority)
]).
gdpr_procedural_regulation_profile_for(early_resolution_outside_chapter_iii_rights, [
    attribute(complaint_concerns_chapter_iii_rights, false),
    attribute(end_of_infringement_established_on_supporting_evidence, true),
    attribute(complainant_objected_to_early_resolution_in_time, false),
    attribute(early_resolution_procedure_before, receiving_authority)
]).
gdpr_procedural_regulation_profile_for(early_resolution_infringement_not_ended, [
    attribute(complaint_concerns_chapter_iii_rights, true),
    attribute(end_of_infringement_established_on_supporting_evidence, false),
    attribute(complainant_objected_to_early_resolution_in_time, false),
    attribute(early_resolution_procedure_before, receiving_authority)
]).

% ---- Profiles: the simple cooperation procedure (Art 6(1), (3), (5)) --
gdpr_procedural_regulation_profile_for(local_case_under_article_56_2, [
    attribute(case_handled_under_article_56_2, attested(true, attestation(supervisory_authority_officer, attested_at, reason_stated, none))),
    attribute(lead_authority_considers_no_reasonable_doubt_as_to_scope, true),
    attribute(issues_addressable_without_additional_cooperation, true),
    attribute(concerned_authority_objected_to_simple_procedure_in_time, false)
]).
gdpr_procedural_regulation_profile_for(simple_procedure_available, [
    attribute(case_handled_under_article_56_2, attested(false, attestation(supervisory_authority_officer, attested_at, reason_stated, none))),
    attribute(lead_authority_considers_no_reasonable_doubt_as_to_scope, true),
    attribute(issues_addressable_without_additional_cooperation, true),
    attribute(concerned_authority_objected_to_simple_procedure_in_time, false)
]).
% near miss: another supervisory authority concerned objected within two weeks.
gdpr_procedural_regulation_profile_for(simple_procedure_objected, [
    attribute(case_handled_under_article_56_2, attested(false, attestation(supervisory_authority_officer, attested_at, reason_stated, none))),
    attribute(lead_authority_considers_no_reasonable_doubt_as_to_scope, true),
    attribute(issues_addressable_without_additional_cooperation, true),
    attribute(concerned_authority_objected_to_simple_procedure_in_time, true)
]).
% near miss: the lead authority has a doubt as to the scope (point (a)).
gdpr_procedural_regulation_profile_for(simple_procedure_scope_doubt, [
    attribute(case_handled_under_article_56_2, attested(false, attestation(supervisory_authority_officer, attested_at, reason_stated, none))),
    attribute(lead_authority_considers_no_reasonable_doubt_as_to_scope, false),
    attribute(issues_addressable_without_additional_cooperation, true),
    attribute(concerned_authority_objected_to_simple_procedure_in_time, false)
]).
gdpr_procedural_regulation_profile_for(simple_procedure_scope_doubt_without_local_statement, [
    attribute(lead_authority_considers_no_reasonable_doubt_as_to_scope, false),
    attribute(issues_addressable_without_additional_cooperation, true),
    attribute(concerned_authority_objected_to_simple_procedure_in_time, false)
]).
gdpr_procedural_regulation_profile_for(simple_procedure_cooperation_unsure, [
    attribute(case_handled_under_article_56_2, attested(false, attestation(supervisory_authority_officer, attested_at, reason_stated, none))),
    attribute(lead_authority_considers_no_reasonable_doubt_as_to_scope, true),
    attribute(issues_addressable_without_additional_cooperation, unsure),
    attribute(concerned_authority_objected_to_simple_procedure_in_time, false)
]).

% ---- Profiles: the draft decision time limit (Art 6(1), 12) ----------
gdpr_procedural_regulation_profile_for(draft_decision_base_limit, [
    attribute(simple_cooperation_procedure_applied, false),
    attribute(draft_decision_time_limit_extended, false),
    attribute(board_request_under_article_11_6_made, false)
]).
gdpr_procedural_regulation_profile_for(draft_decision_suspended_and_extended, [
    attribute(simple_cooperation_procedure_applied, false),
    attribute(draft_decision_time_limit_extended, true),
    attribute(board_request_under_article_11_6_made, true),
    attribute(extension_justified_by_exceptional_complexity, true)
]).
% near miss: the extension is not justified by exceptional complexity.
gdpr_procedural_regulation_profile_for(draft_decision_unjustified_extension, [
    attribute(simple_cooperation_procedure_applied, false),
    attribute(draft_decision_time_limit_extended, true),
    attribute(board_request_under_article_11_6_made, false),
    attribute(extension_justified_by_exceptional_complexity, false)
]).
gdpr_procedural_regulation_profile_for(draft_decision_complexity_unsure, [
    attribute(simple_cooperation_procedure_applied, false),
    attribute(draft_decision_time_limit_extended, true),
    attribute(board_request_under_article_11_6_made, false),
    attribute(extension_justified_by_exceptional_complexity, unsure)
]).
gdpr_procedural_regulation_profile_for(simple_procedure_draft_decision_without_extension, [
    attribute(simple_cooperation_procedure_applied, true),
    attribute(draft_decision_time_limit_extended, false)
]).
gdpr_procedural_regulation_profile_for(simple_procedure_extension_with_national_statement, [
    attribute(simple_cooperation_procedure_applied, true),
    attribute(draft_decision_time_limit_extended, true),
    attribute(national_law_requires_domestic_proceedings_after_time_limit, attested(true, attestation(supervisory_authority_officer, attested_at, reason_stated, none)))
]).
% near miss: national law does not require the domestic proceedings.
gdpr_procedural_regulation_profile_for(simple_procedure_extension_refused_by_national_law, [
    attribute(simple_cooperation_procedure_applied, true),
    attribute(draft_decision_time_limit_extended, true),
    attribute(national_law_requires_domestic_proceedings_after_time_limit, attested(false, attestation(supervisory_authority_officer, attested_at, reason_stated, none)))
]).
gdpr_procedural_regulation_profile_for(simple_procedure_extension_without_national_statement, [
    attribute(simple_cooperation_procedure_applied, true),
    attribute(draft_decision_time_limit_extended, true)
]).

% ---- Profiles: a step taken late (Art 14) ----------------------------
gdpr_procedural_regulation_profile_for(late_step_under_this_regulation, [
    attribute(time_limit_set_by_this_regulation_or_article_65_6, attested(true, attestation(supervisory_authority_officer, attested_at, reason_stated, none)))
]).
% near miss: the missed time limit was set by another provision.
gdpr_procedural_regulation_profile_for(late_step_under_national_law, [
    attribute(time_limit_set_by_this_regulation_or_article_65_6, attested(false, attestation(supervisory_authority_officer, attested_at, reason_stated, none)))
]).
gdpr_procedural_regulation_profile_for(late_step_without_source_statement, []).

% ---- Profile: THE INPUT CHECK ----------------------------------------
gdpr_procedural_regulation_profile_for(malformed_profile_duplicates_and_unknown, [
    attribute(complaint_lodged_by, data_subject),
    attribute(complaint_lodged_by, data_subject),
    attribute(lodging_person_name_and_contact_details_included, unsure),
    attribute(colour, blue)
]).

% ---- Convenience wrapper ---------------------------------------------
gdpr_procedural_regulation_assess(Subject, Result) :-
    gdpr_procedural_regulation_profile_for(Subject, Profile),
    decide_gdpr_procedural_regulation(Profile, Result).

:- end_module(fixtures).
