% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% fixtures.clausal -- representative profiles for eu/data_protection/gdpr_procedural_regulation.
% A TOP-LAYER consumer: it imports the one slice predicate it calls
% (decide_gdpr_procedural_regulation/2, for the assess wrapper).
%
% A profile is an ATTRIBUTE LIST [attribute(Key, Value), ...] (the order's
% typed input contract). Outside facts are attested(Value, attestation(By,
% At, Reason, Evidence)) terms. Each route of each query has a positive
% subject and a one-unit near-miss control that differs in one key and gets
% another verdict:
%   admissibility: data subject admissible / description missing;
%     Art 80(1) body admissible / mandate missing; Art 80(2) body
%     admissible / constitution missing; lodger missing (indeterminate);
%   prior request: made / not made; not required; judgement unsure;
%   early resolution: outside Chapter III rights; not devoid of purpose;
%     objected; resolved before the receiving / the lead authority;
%   simple procedure: local case; scope in doubt; objected / available;
%     cooperation need unsure; local-case statement missing;
%   draft decision: 15 months / justified extension / unjustified extension
%     with a Board request; complexity unsure; 12 months / justified /
%     unjustified extension; national-law statement missing;
%   late step: time limit of this Regulation / of another provision /
%     statement missing;
%   input check: a duplicate key and an unknown key.
% The date boundaries of temporal_application are arguments, not profile
% keys: the public-interface tests pair 1, 2 and 3 April 2027 directly.
% The scaffold's generic test stubs read the profile todo_baseline_subject:
% it is the admissible data-subject complaint, a profile only (not a
% registered subject).
% =====================================================================

:- module(fixtures, [
    gdpr_procedural_regulation_subject/1,
    gdpr_procedural_regulation_profile_for/2,
    gdpr_procedural_regulation_assess/2
]).

:- use_module(eu/data_protection/gdpr_procedural_regulation/gdpr_procedural_regulation, [decide_gdpr_procedural_regulation/2]).

% ---- Subject registry ------------------------------------------------
gdpr_procedural_regulation_subject(admissible_data_subject_complaint).
gdpr_procedural_regulation_subject(data_subject_complaint_without_description).
gdpr_procedural_regulation_subject(admissible_article_80_1_body_complaint).
gdpr_procedural_regulation_subject(article_80_1_body_complaint_without_mandate).
gdpr_procedural_regulation_subject(admissible_article_80_2_body_complaint).
gdpr_procedural_regulation_subject(article_80_2_body_complaint_without_constitution).
gdpr_procedural_regulation_subject(complaint_without_lodger).
gdpr_procedural_regulation_subject(prior_request_made_complaint).
gdpr_procedural_regulation_subject(prior_request_not_made_complaint).
gdpr_procedural_regulation_subject(right_not_exercised_by_request_complaint).
gdpr_procedural_regulation_subject(right_exercised_by_request_unclear_complaint).
gdpr_procedural_regulation_subject(complaint_outside_chapter_iii_rights).
gdpr_procedural_regulation_subject(complaint_not_devoid_of_purpose_case).
gdpr_procedural_regulation_subject(early_resolution_objected_case).
gdpr_procedural_regulation_subject(early_resolution_before_receiving_authority).
gdpr_procedural_regulation_subject(early_resolution_before_lead_authority).
gdpr_procedural_regulation_subject(local_case_under_article_56_2).
gdpr_procedural_regulation_subject(scope_in_doubt_case).
gdpr_procedural_regulation_subject(simple_procedure_objected_case).
gdpr_procedural_regulation_subject(simple_procedure_open_case).
gdpr_procedural_regulation_subject(additional_cooperation_need_unclear_case).
gdpr_procedural_regulation_subject(local_case_statement_missing_case).
gdpr_procedural_regulation_subject(standard_draft_decision_case).
gdpr_procedural_regulation_subject(justified_extension_case).
gdpr_procedural_regulation_subject(unjustified_extension_with_board_request_case).
gdpr_procedural_regulation_subject(extension_complexity_unclear_case).
gdpr_procedural_regulation_subject(simple_procedure_draft_decision_case).
gdpr_procedural_regulation_subject(simple_procedure_justified_extension_case).
gdpr_procedural_regulation_subject(simple_procedure_unjustified_extension_case).
gdpr_procedural_regulation_subject(national_law_statement_missing_case).
gdpr_procedural_regulation_subject(late_step_after_regulation_time_limit).
gdpr_procedural_regulation_subject(late_step_after_other_time_limit).
gdpr_procedural_regulation_subject(late_step_statement_missing_case).
gdpr_procedural_regulation_subject(malformed_profile_case).

% ---- Profile read by the scaffold's generic test stubs ----------------
gdpr_procedural_regulation_profile_for(todo_baseline_subject, [
    attribute(complaint_lodged_by, data_subject),
    attribute(lodging_person_name_and_contact_details_included, true),
    attribute(controller_or_processor_identification_information_included, true),
    attribute(alleged_infringement_description_included, true)
]).

