% ---- Profiles: prior request (Art 4(3)) -------------------------------
gdpr_procedural_regulation_profile_for(prior_request_made_complaint, [
    attribute(complaint_concerns_right_exercised_by_request, true),
    attribute(request_made_to_controller_before_complaint, true)
]).
gdpr_procedural_regulation_profile_for(prior_request_not_made_complaint, [
    attribute(complaint_concerns_right_exercised_by_request, true),
    attribute(request_made_to_controller_before_complaint, false)
]).
gdpr_procedural_regulation_profile_for(right_not_exercised_by_request_complaint, [
    attribute(complaint_concerns_right_exercised_by_request, false)
]).
gdpr_procedural_regulation_profile_for(right_exercised_by_request_unclear_complaint, [
    attribute(complaint_concerns_right_exercised_by_request, unsure),
    attribute(request_made_to_controller_before_complaint, true)
]).

