% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/data_protection/gdpr_procedural_regulation.
%
% Instrument: Regulation (EU) 2025/2518 laying down additional procedural
% rules relating to the enforcement of Regulation (EU) 2016/679 (the GDPR
% Procedural Regulation), OJ L, 12.12.2025, CELEX 32025R2518. Each
% verbatim is an exact substring of the pinned unit text of the act as
% published.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% The verbatim pair is OMITTED where the key's entry in
% citations-sources.yaml is `status: unverified`.
%
% Three records are not provisions of Regulation (EU) 2025/2518 but the
% TARGETS of the outside facts (cite(TARGET) in a
% cross_reference_unresolved referral): article_56_2_local_case_statement,
% national_domestic_proceedings_statement, time_limit_source_statement.
% One record, eu_reg_2016_679_art_80, names the GDPR provision whose
% bodies the admissibility rule distinguishes; it is a provenance marker
% only and is never returned in a result.
%
% PROVENANCE: every operative clause opens its body with implements(Key),
% Key one of the records below.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

implements(Key) :-
    citation(Key, _).

% ---- Article 4: complaints ------------------------------------------
citation(eu_reg_2025_2518_art_4_1, [label-'Regulation (EU) 2025/2518 Art 4(1), first subparagraph (admissibility of a complaint concerning cross-border processing)', ref-'https://eur-lex.europa.eu/eli/reg/2025/2518/oj', verbatim-'A complaint on the basis of Regulation (EU) 2016/679 concerning cross-border processing shall be admissible provided that it includes the following information']).
citation(eu_reg_2025_2518_art_4_1_a, [label-'Regulation (EU) 2025/2518 Art 4(1), first subparagraph, point (a) (name and contact details of the person lodging the complaint)', ref-'https://eur-lex.europa.eu/eli/reg/2025/2518/oj', verbatim-'the name and contact details of the person lodging the complaint']).
citation(eu_reg_2025_2518_art_4_1_b, [label-'Regulation (EU) 2025/2518 Art 4(1), first subparagraph, point (b) (proof of proper constitution of an Article 80 body)', ref-'https://eur-lex.europa.eu/eli/reg/2025/2518/oj', verbatim-'proof that that body, organisation or association has been properly constituted in accordance with the law of a Member State']).
citation(eu_reg_2025_2518_art_4_1_c, [label-'Regulation (EU) 2025/2518 Art 4(1), first subparagraph, point (c) (proof of a mandate of a data subject, Article 80(1) GDPR)', ref-'https://eur-lex.europa.eu/eli/reg/2025/2518/oj', verbatim-'proof that that body, organisation or association is acting on the basis of a mandate of a data subject']).
citation(eu_reg_2025_2518_art_4_1_d, [label-'Regulation (EU) 2025/2518 Art 4(1), first subparagraph, point (d) (information facilitating identification of the controller or processor)', ref-'https://eur-lex.europa.eu/eli/reg/2025/2518/oj', verbatim-'information which facilitates the identification of the controller or processor that is the subject of the complaint']).
citation(eu_reg_2025_2518_art_4_1_e, [label-'Regulation (EU) 2025/2518 Art 4(1), first subparagraph, point (e) (description of the alleged infringement)', ref-'https://eur-lex.europa.eu/eli/reg/2025/2518/oj', verbatim-'a description of the alleged infringement of Regulation (EU) 2016/679']).
citation(eu_reg_2025_2518_art_4_2, [label-'Regulation (EU) 2025/2518 Art 4(2) (declaration of inadmissibility within two weeks)', ref-'https://eur-lex.europa.eu/eli/reg/2025/2518/oj', verbatim-'it shall, within two weeks of receiving that complaint, declare that complaint inadmissible and inform the complainant of the reasons thereof']).
citation(eu_reg_2025_2518_art_4_3, [label-'Regulation (EU) 2025/2518 Art 4(3) (prior request to the controller)', ref-'https://eur-lex.europa.eu/eli/reg/2025/2518/oj', verbatim-'that request shall be made to the controller before that complaint is lodged']).
citation(eu_reg_2025_2518_art_4_5, [label-'Regulation (EU) 2025/2518 Art 4(5) (transmission within six weeks; admissibility binding on the lead supervisory authority)', ref-'https://eur-lex.europa.eu/eli/reg/2025/2518/oj', verbatim-'no later than six weeks from the receipt of that complaint and inform the complainant of that transmission. The determination of admissibility of a complaint by the supervisory authority with which that complaint has been lodged shall be binding on the lead supervisory authority']).
citation(eu_reg_2025_2518_art_4_6, [label-'Regulation (EU) 2025/2518 Art 4(6) (confirmation of competence or referral to the Board within six weeks)', ref-'https://eur-lex.europa.eu/eli/reg/2025/2518/oj', verbatim-'Within six weeks of the receipt of a complaint, the supervisory authority presumed to be competent to act as lead supervisory authority shall either confirm its competence']).

% ---- Article 5: early resolution ------------------------------------
citation(eu_reg_2025_2518_art_5_1, [label-'Regulation (EU) 2025/2518 Art 5(1), first subparagraph (early resolution of a complaint concerning Chapter III GDPR rights)', ref-'https://eur-lex.europa.eu/eli/reg/2025/2518/oj', verbatim-'may, where appropriate, be resolved through a procedure allowing for its early resolution']).
citation(eu_reg_2025_2518_art_5_1_a, [label-'Regulation (EU) 2025/2518 Art 5(1), first subparagraph, point (a) (early resolution by the authority with which the complaint was lodged)', ref-'https://eur-lex.europa.eu/eli/reg/2025/2518/oj', verbatim-'the supervisory authority with which the complaint has been lodged, after it has determined by way of preliminary conclusion that the complaint concerns cross-border processing']).
citation(eu_reg_2025_2518_art_5_1_b, [label-'Regulation (EU) 2025/2518 Art 5(1), first subparagraph, point (b) (early resolution by the lead supervisory authority)', ref-'https://eur-lex.europa.eu/eli/reg/2025/2518/oj', verbatim-'the lead supervisory authority to which the complaint has been transmitted, at any time before the submission of the preliminary findings']).
citation(eu_reg_2025_2518_art_5_2, [label-'Regulation (EU) 2025/2518 Art 5(2), opening words (complaint devoid of purpose once the infringement is established to have ended)', ref-'https://eur-lex.europa.eu/eli/reg/2025/2518/oj', verbatim-'establishes, based on supporting evidence, that the alleged infringement has been brought to an end, that supervisory authority shall consider the complaint devoid of purpose']).
citation(eu_reg_2025_2518_art_5_2_c, [label-'Regulation (EU) 2025/2518 Art 5(2), second subparagraph, point (c) (objection to the early resolution within four weeks)', ref-'https://eur-lex.europa.eu/eli/reg/2025/2518/oj', verbatim-'of the possibility for the complainant to submit an objection to the early resolution within four weeks of receiving such information']).
citation(eu_reg_2025_2518_art_5_3, [label-'Regulation (EU) 2025/2518 Art 5(3) (resolution established by the receiving authority within two weeks)', ref-'https://eur-lex.europa.eu/eli/reg/2025/2518/oj', verbatim-'that supervisory authority shall, within two weeks of the expiry of that time limit, establish that the complaint has been resolved']).
citation(eu_reg_2025_2518_art_5_4, [label-'Regulation (EU) 2025/2518 Art 5(4) (draft decision establishing resolution by the lead authority within four weeks)', ref-'https://eur-lex.europa.eu/eli/reg/2025/2518/oj', verbatim-'that lead supervisory authority shall submit a draft decision in accordance with Article 60(3) of Regulation (EU) 2016/679 within four weeks of the expiry of that time limit']).
citation(eu_reg_2025_2518_art_5_6, [label-'Regulation (EU) 2025/2518 Art 5(6) (Articles 10 to 20 do not apply to complaints resolved early)', ref-'https://eur-lex.europa.eu/eli/reg/2025/2518/oj', verbatim-'Articles 10 to 20 do not apply to complaints resolved pursuant to this Article.']).

% ---- Article 6: simple cooperation procedure ------------------------
citation(eu_reg_2025_2518_art_6_1, [label-'Regulation (EU) 2025/2518 Art 6(1) (simple cooperation procedure; draft decision within the Art 12(6) time limit)', ref-'https://eur-lex.europa.eu/eli/reg/2025/2518/oj', verbatim-'it may cooperate with the other supervisory authorities concerned through a simple cooperation procedure']).
citation(eu_reg_2025_2518_art_6_1_a, [label-'Regulation (EU) 2025/2518 Art 6(1), first subparagraph, point (a) (no reasonable doubt as to the scope of the investigation)', ref-'https://eur-lex.europa.eu/eli/reg/2025/2518/oj', verbatim-'it considers that no reasonable doubt exists as to the scope of the investigation']).
citation(eu_reg_2025_2518_art_6_1_b, [label-'Regulation (EU) 2025/2518 Art 6(1), first subparagraph, point (b) (issues not requiring the additional cooperation of a complex investigation)', ref-'https://eur-lex.europa.eu/eli/reg/2025/2518/oj', verbatim-'the legal and factual issues identified by the lead supervisory authority do not require the additional cooperation with the other supervisory authorities concerned that would be required for the purposes of a complex investigation']).
citation(eu_reg_2025_2518_art_6_2, [label-'Regulation (EU) 2025/2518 Art 6(2) (notification of the simple cooperation procedure within six weeks)', ref-'https://eur-lex.europa.eu/eli/reg/2025/2518/oj', verbatim-'within six weeks of the lead supervisory authority confirming its competence pursuant to Article 4(6) of this Regulation']).
citation(eu_reg_2025_2518_art_6_3, [label-'Regulation (EU) 2025/2518 Art 6(3) (objection to the simple cooperation procedure within two weeks)', ref-'https://eur-lex.europa.eu/eli/reg/2025/2518/oj', verbatim-'Where any of the other supervisory authorities concerned object to the application of the simple cooperation procedure within two weeks of being notified thereof, that procedure shall not apply']).
citation(eu_reg_2025_2518_art_6_5, [label-'Regulation (EU) 2025/2518 Art 6(5) (Chapter III does not apply to cases handled under Article 56(2) GDPR)', ref-'https://eur-lex.europa.eu/eli/reg/2025/2518/oj', verbatim-'Chapter III does not apply to cases handled by the supervisory authority concerned pursuant to Article 56(2) of Regulation (EU) 2016/679.']).

% ---- Article 10: summary of key issues ------------------------------
citation(eu_reg_2025_2518_art_10_3, [label-'Regulation (EU) 2025/2518 Art 10(3) (summary of key issues within three months)', ref-'https://eur-lex.europa.eu/eli/reg/2025/2518/oj', verbatim-'within three months of the lead supervisory authority confirming its competence pursuant to Article 4(6) of this Regulation']).
citation(eu_reg_2025_2518_art_10_4, [label-'Regulation (EU) 2025/2518 Art 10(4) (comments on the summary of key issues within four weeks, extendable by two weeks)', ref-'https://eur-lex.europa.eu/eli/reg/2025/2518/oj', verbatim-'The supervisory authorities concerned may provide comments on the summary of key issues within four weeks of receipt of that summary. The lead supervisory authority may extend that period by two weeks']).
citation(eu_reg_2025_2518_art_10_5, [label-'Regulation (EU) 2025/2518 Art 10(5) (response to comments within four weeks, extendable by two weeks)', ref-'https://eur-lex.europa.eu/eli/reg/2025/2518/oj', verbatim-'The lead supervisory authority shall respond to those comments within four weeks of the expiry of the period referred to in paragraph 4']).

% ---- Article 12: draft decision time limits -------------------------
citation(eu_reg_2025_2518_art_12_1, [label-'Regulation (EU) 2025/2518 Art 12(1) (draft decision within 15 months)', ref-'https://eur-lex.europa.eu/eli/reg/2025/2518/oj', verbatim-'The lead supervisory authority shall submit a draft decision pursuant to Article 60(3) of Regulation (EU) 2016/679 within 15 months of the lead supervisory authority confirming its competence']).
citation(eu_reg_2025_2518_art_12_2, [label-'Regulation (EU) 2025/2518 Art 12(2) (suspension of the time limit on a request under Article 11(6))', ref-'https://eur-lex.europa.eu/eli/reg/2025/2518/oj', verbatim-'the time limit referred to in paragraph 1 of this Article shall be suspended until the Board has adopted its binding decision']).
citation(eu_reg_2025_2518_art_12_3, [label-'Regulation (EU) 2025/2518 Art 12(3) (one extension of no longer than 12 months for exceptional complexity; information at least four weeks before expiry)', ref-'https://eur-lex.europa.eu/eli/reg/2025/2518/oj', verbatim-'On an exceptional basis, the lead supervisory authority may extend the time limit referred to in paragraph 1 once, for a period of no longer than 12 months, due to the complexity of the case.']).
citation(eu_reg_2025_2518_art_12_4, [label-'Regulation (EU) 2025/2518 Art 12(4) (objection to the extension within two weeks)', ref-'https://eur-lex.europa.eu/eli/reg/2025/2518/oj', verbatim-'Any supervisory authority concerned may submit an objection to the extension of the time limit within two weeks of being informed thereof pursuant to paragraph 3.']).
citation(eu_reg_2025_2518_art_12_6, [label-'Regulation (EU) 2025/2518 Art 12(6) (draft decision within 12 months under the simple cooperation procedure; one extension of no longer than two months)', ref-'https://eur-lex.europa.eu/eli/reg/2025/2518/oj', verbatim-'within 12 months of the lead supervisory authority confirming its competence pursuant to Article 4(6) of this Regulation']).

% ---- Article 14: late procedural steps ------------------------------
citation(eu_reg_2025_2518_art_14, [label-'Regulation (EU) 2025/2518 Art 14 (legality and validity of procedural steps taken after a time limit)', ref-'https://eur-lex.europa.eu/eli/reg/2025/2518/oj', verbatim-'taking such a step after the expiry of that time limit shall not affect the legality or validity of that procedural step or of the final decision']).

% ---- Articles 36 and 37: application in time ------------------------
citation(eu_reg_2025_2518_art_36, [label-'Regulation (EU) 2025/2518 Art 36 (transitional provisions for Chapters III to VI)', ref-'https://eur-lex.europa.eu/eli/reg/2025/2518/oj', verbatim-'Chapters III and IV shall apply to ex officio investigations opened after 2 April 2027 and to complaint-based investigations where the complaint was lodged after 2 April 2027.']).
citation(eu_reg_2025_2518_art_37_2, [label-'Regulation (EU) 2025/2518 Art 37(2) (date of application)', ref-'https://eur-lex.europa.eu/eli/reg/2025/2518/oj', verbatim-'This Regulation shall apply from 2 April 2027.']).

% ---- Provision applied but not returned in a result -----------------
citation(eu_reg_2016_679_art_80, [label-'Regulation (EU) 2016/679 Art 80(1) and (2) (representation of data subjects by a not-for-profit body, organisation or association)', ref-'https://eur-lex.europa.eu/eli/reg/2016/679/oj']).

% ---- Outside-fact targets (cite(TARGET) in a referral) --------------
citation(article_56_2_local_case_statement, [label-'Statement that the case is handled by the supervisory authority concerned under Regulation (EU) 2016/679 Art 56(2) (outside fact read by Regulation (EU) 2025/2518 Art 6(5))', ref-'https://eur-lex.europa.eu/eli/reg/2016/679/oj']).
citation(national_domestic_proceedings_statement, [label-'Statement of the national law of the lead supervisory authority on prior or subsequent domestic proceedings (outside fact read by Regulation (EU) 2025/2518 Art 12(6), second subparagraph)', ref-'https://eur-lex.europa.eu/eli/reg/2025/2518/oj']).
citation(time_limit_source_statement, [label-'Classification of the time limit a late step missed as set by Regulation (EU) 2025/2518 or by Regulation (EU) 2016/679 Art 65(6) (outside fact read by Regulation (EU) 2025/2518 Art 14)', ref-'https://eur-lex.europa.eu/eli/reg/2025/2518/oj']).

:- end_module(citations).
