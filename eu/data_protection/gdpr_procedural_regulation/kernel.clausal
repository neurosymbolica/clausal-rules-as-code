% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% kernel.clausal -- the SHARED FLOOR for eu/data_protection/gdpr_procedural_regulation (deontic family).
%
% Source: Regulation (EU) 2025/2518 (GDPR Procedural Regulation), CELEX
% 32025R2518, OJ L, 12.12.2025 -- Arts 4, 5, 6, 10, 12, 14, 36 and 37(2)
% as pinned by the order. The kernel decides no statutory condition: it
% holds only the input check, which the scaffold writes here from the
% order's typed input contract (INTERFACE - THE INPUT CHECK) and which the
% determination slice and queries.clausal import:
%   :- use_module(eu/data_protection/gdpr_procedural_regulation/kernel,
%                 [gdpr_procedural_regulation_input_problems/2]).
%
% There is one determination slice (gdpr_procedural_regulation.clausal),
% so no rule predicate is shared and nothing else lives here. A predicate
% moves here only when a SECOND file calls it.
%
% Atoms and data terms need NO declaration and NO import. The comment
% block below only RECORDS the result terms so every file spells them alike.
%
% RESULT TERMS (the order's called contract; every query yields exactly
% ONE solution; CITATIONS is a set-like list of cite(Key) terms):
%   complaint_admissibility(Profile, Result, Citations)
%       Result: admissible | inadmissible | status compound.
%   prior_request_condition(Profile, Result, Citations)
%       Result: prior_request_not_required | prior_request_made |
%               prior_request_not_made | status compound.
%   early_resolution(Profile, Result, Citations)
%       Result: early_resolution_not_available | complaint_not_devoid_of_purpose |
%               early_resolution_objected |
%               resolution_established_by_receiving_authority |
%               draft_decision_establishing_resolution | status compound.
%   simple_cooperation_procedure(Profile, Result, Basis, Citations)
%       Result: chapter_iii_not_applicable | simple_procedure_not_available |
%               simple_procedure_excluded_by_objection |
%               simple_procedure_available | status compound.
%       Basis: [outside_fact(case_handled_under_article_56_2, Attested)] on a
%              final Result, [] otherwise.
%   draft_decision_time_limit(Profile, Result, Basis, Citations)
%       Result: draft_decision_limit(Months, Extension), Months 15 or 12,
%               Extension no_extension | extension(up_to, N, months), N 12 or 2;
%               or a status compound.
%       Basis: suspended_until_board_binding_decision, extension_not_permitted
%              (in that order, each at most once), then
%              outside_fact(national_law_requires_domestic_proceedings_after_time_limit,
%              Attested) where the limbs copy it; possibly [].
%   late_step_effect(Profile, Result, Basis, Citations)
%       Result: legality_and_validity_not_affected | not_governed_by_article_14 |
%               status compound.
%       Basis: [outside_fact(time_limit_set_by_this_regulation_or_article_65_6,
%              Attested)] on a final Result, [] otherwise.
%   procedural_time_limit(Profile, Step, Limit, Citations)
%       Limit: limit(N, Unit, Relation, Event, Extension), Unit weeks | months,
%              Relation within | at_least_before, Extension no_extension |
%              extension(exactly, N2, Unit2) | extension(up_to, N2, Unit2);
%              or input_problems(Problems).
%   temporal_application(Profile, Part, EventDate, Result, Citations)
%       Result: part_applies | part_does_not_apply | input_problems(Problems).
%   Facade: gdpr_procedural_regulation_verdict(Status, Citations), Status the
%       complaint_admissibility Result.
%
% STATUS COMPOUNDS (never written bare):
%   indeterminate([Key])  -- one missing judgement or crisp key;
%   needs_legal_review(open_textured(Key, cite(Citation)),
%                      [inputs_relied_on([Key-unsure])]);
%   needs_legal_review(cross_reference_unresolved(cite(Citation), cite(Target)),
%                      [resolution(cite(Target), not_attempted),
%                       inputs_relied_on([Key-absent])]);
%   input_problems(Problems), Problems drawn from duplicate_key(Key),
%                      wrong_type(Key) and unknown_key(Key).
% Every non-final status carries Basis [] and Citations [].
% =====================================================================

:- module(kernel, [gdpr_procedural_regulation_input_problems/2]).

:- use_module(library(reif), [memberd_t/3]).

% ---- input checks: the problems a profile has, if any -----------
% gdpr_procedural_regulation_input_problems(Profile, Problems): Problems = [] means the profile can be
% judged. Written from the order's typed input contract
% (input_contract.types.profile: attribute_list).
% Each public query calls this check first: it gives its normal answer only when
% Problems = [], and when Problems is not [] it gives the answer the order states for
% a profile with input problems.
% It gives exactly one answer for every Profile, and the answer is ground except for a
% Key named as given:
% - a Profile that is not an attribute list [attribute(Key, Value), ...] gives [wrong_type(profile)]:
%   an unbound Profile, a partial list, a list holding an unbound item or an item that is
%   not attribute(_, _);
% - a Key that is not an atom (a number, a string, a compound term, an unbound variable)
%   is a key outside the contract: unknown_key(Key), Key as given;
% - otherwise, for each contract key in the contract's key order, duplicate_key(Key) when
%   the key occurs more than once in Profile (whatever its values: none of them is read,
%   so it is never also wrong_type(Key)), else wrong_type(Key) when its one value is
%   outside its type; then unknown_key(Key) for each key outside the contract, in the
%   order of its first occurrence in Profile. Each key is named once. An absent key is
%   not a problem.
% Every step is complementary clauses: exactly one clause holds for each input.
gdpr_procedural_regulation_input_problems(Profile, Problems) :-
    attribute_list_t(Profile, IsAttributeList),
    profile_problems(IsAttributeList, Profile, Problems).

profile_problems(false, _, [wrong_type(profile)]).
profile_problems(true, Profile, Problems) :-
    Keys = [complaint_lodged_by, lodging_person_name_and_contact_details_included, proof_of_proper_constitution_included, proof_of_data_subject_mandate_included, controller_or_processor_identification_information_included, alleged_infringement_description_included, complaint_concerns_right_exercised_by_request, request_made_to_controller_before_complaint, complaint_concerns_chapter_iii_rights, end_of_infringement_established_on_supporting_evidence, complainant_objected_to_early_resolution_in_time, early_resolution_procedure_before, case_handled_under_article_56_2, lead_authority_considers_no_reasonable_doubt_as_to_scope, issues_addressable_without_additional_cooperation, concerned_authority_objected_to_simple_procedure_in_time, simple_cooperation_procedure_applied, draft_decision_time_limit_extended, board_request_under_article_11_6_made, extension_justified_by_exceptional_complexity, national_law_requires_domestic_proceedings_after_time_limit, time_limit_set_by_this_regulation_or_article_65_6],
    unknown_keys(Profile, Keys, UnknownKeyProblems),
    key_problems(Keys, Profile, UnknownKeyProblems, Problems).

% The contract: each key and the type of its value.
key_type(complaint_lodged_by, complaint_lodged_by_atom).
key_type(lodging_person_name_and_contact_details_included, boolean).
key_type(proof_of_proper_constitution_included, boolean).
key_type(proof_of_data_subject_mandate_included, boolean).
key_type(controller_or_processor_identification_information_included, boolean).
key_type(alleged_infringement_description_included, boolean).
key_type(complaint_concerns_right_exercised_by_request, judgement).
key_type(request_made_to_controller_before_complaint, boolean).
key_type(complaint_concerns_chapter_iii_rights, boolean).
key_type(end_of_infringement_established_on_supporting_evidence, boolean).
key_type(complainant_objected_to_early_resolution_in_time, boolean).
key_type(early_resolution_procedure_before, early_resolution_procedure_before_atom).
key_type(case_handled_under_article_56_2, outside_fact).
key_type(lead_authority_considers_no_reasonable_doubt_as_to_scope, boolean).
key_type(issues_addressable_without_additional_cooperation, judgement).
key_type(concerned_authority_objected_to_simple_procedure_in_time, boolean).
key_type(simple_cooperation_procedure_applied, boolean).
key_type(draft_decision_time_limit_extended, boolean).
key_type(board_request_under_article_11_6_made, boolean).
key_type(extension_justified_by_exceptional_complexity, judgement).
key_type(national_law_requires_domestic_proceedings_after_time_limit, outside_fact).
key_type(time_limit_set_by_this_regulation_or_article_65_6, outside_fact).

% attribute_list_t(Term, T): T is true when Term is a list of attribute(Key, Value)
% items, whatever each Key is; false for anything else, an unbound Term or item included.
attribute_list_t(Term, false) :-
    var(Term).
attribute_list_t(Term, true) :-
    Term == [].
attribute_list_t(Term, T) :-
    nonvar(Term),
    Term = [Element|Elements],
    attribute_t(Element, ElementIsAttribute),
    attribute_list_t(Elements, ElementsAreAttributes),
    truth_and(ElementIsAttribute, ElementsAreAttributes, T).
attribute_list_t(Term, false) :-
    nonvar(Term),
    Term \== [],
    Term \= [_|_].

attribute_t(Element, false) :-
    var(Element).
attribute_t(Element, true) :-
    nonvar(Element),
    Element = attribute(_, _).
attribute_t(Element, false) :-
    nonvar(Element),
    Element \= attribute(_, _).

% Unknown keys, in profile order, each once: Known grows by each key named. A key is
% known when it is identical (==) to one in Known, so an unbound Key is never bound:
% the same variable twice is one unknown key, two different variables are two.
unknown_keys([], _, []).
unknown_keys([attribute(Key, _)|Elements], Known, Problems) :-
    known_t(Key, Known, IsKnown),
    name_unknown_key(IsKnown, Key, Known, Elements, Problems).

known_t(_, [], false).
known_t(Key, [Known|_], true) :-
    Known == Key.
known_t(Key, [Known|Knowns], T) :-
    Known \== Key,
    known_t(Key, Knowns, T).

name_unknown_key(true, _, Known, Elements, Problems) :-
    unknown_keys(Elements, Known, Problems).
name_unknown_key(false, Key, Known, Elements, [unknown_key(Key)|Problems]) :-
    unknown_keys(Elements, [Key|Known], Problems).

% Contract keys, in contract order: duplicate_key(Key) when the key occurs more than once
% (none of its values is read), else wrong_type(Key) when its one value is outside the
% key's type. An absent key has no value to check.
key_problems([], _, Problems, Problems).
key_problems([Key|Keys], Profile, LaterProblems, Problems) :-
    key_type(Key, Type),
    key_occurrences(Profile, Key, Occurrences),
    key_problems(Keys, Profile, LaterProblems, KeyProblems),
    name_key_problem(Occurrences, Key, Type, Profile, KeyProblems, Problems).

% key_occurrences(Elements, Key, Occurrences): none, one or many items give Key.
key_occurrences([], _, none).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey == Key,
    key_occurrences(Elements, Key, RestOccurrences),
    one_more_occurrence(RestOccurrences, Occurrences).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey \== Key,
    key_occurrences(Elements, Key, Occurrences).

one_more_occurrence(none, one).
one_more_occurrence(one, many).
one_more_occurrence(many, many).

name_key_problem(none, _, _, _, Problems, Problems).
name_key_problem(many, Key, _, _, Problems, [duplicate_key(Key)|Problems]).
name_key_problem(one, Key, Type, Profile, KeyProblems, Problems) :-
    values_in_type_t(Profile, Key, Type, InType),
    name_wrong_type(InType, Key, KeyProblems, Problems).

name_wrong_type(true, _, Problems, Problems).
name_wrong_type(false, Key, Problems, [wrong_type(Key)|Problems]).

% values_in_type_t(Elements, Key, Type, T): T is true when every value Elements gives Key is
% in Type (true when Elements gives Key none).
values_in_type_t([], _, _, true).
values_in_type_t([attribute(ElementKey, Value)|Elements], Key, Type, T) :-
    ElementKey == Key,
    value_in_type_t(Type, Value, ValueInType),
    values_in_type_t(Elements, Key, Type, RestInType),
    truth_and(ValueInType, RestInType, T).
values_in_type_t([attribute(ElementKey, _)|Elements], Key, Type, T) :-
    ElementKey \== Key,
    values_in_type_t(Elements, Key, Type, T).

% A value with an unbound part is outside every type; a ground one is checked.
value_in_type_t(Type, Value, T) :-
    term_variables(Value, Variables),
    ground_value_in_type_t(Variables, Type, Value, T).

ground_value_in_type_t([_|_], _, _, false).
ground_value_in_type_t([], Type, Value, T) :-
    in_type_t(Type, Value, T).

% in_type_t(Type, Value, T): one clause per type, for a ground Value.
in_type_t(complaint_lodged_by_atom, Value, T) :-
    in_type_t(enum([data_subject, article_80_1_body, article_80_2_body]), Value, T).

in_type_t(judgement, Value, T) :-
    in_type_t(one_of([boolean, enum([unsure])]), Value, T).

in_type_t(early_resolution_procedure_before_atom, Value, T) :-
    in_type_t(enum([receiving_authority, lead_authority]), Value, T).

in_type_t(outside_fact, Value, T) :-
    in_type_t(attested(boolean), Value, T).

in_type_t(boolean, Value, T) :-
    memberd_t(Value, [true, false], T).

in_type_t(enum(Values), Value, T) :-
    memberd_t(Value, Values, T).

in_type_t(one_of(Types), Value, T) :-
    in_some_type_t(Types, Value, T).

in_type_t(attested(Type), Value, T) :-
    attested_t(Value, Type, T).

truth_and(true, T, T).
truth_and(false, _, false).

% in_some_type_t(Types, Value, T): T is true when Value is in at least one of Types.
in_some_type_t([], _, false).
in_some_type_t([Type|Types], Value, T) :-
    in_type_t(Type, Value, InType),
    in_some_type_t(Types, Value, InAnother),
    truth_or(InType, InAnother, T).

truth_or(true, _, true).
truth_or(false, T, T).

% attested_t(Value, Type, T): T is true when Value is
% attested(AttestedValue, attestation(By, At, Reason, Evidence)) with AttestedValue in Type.
% By, At, Reason and Evidence come from the host and are not checked.
attested_t(attested(AttestedValue, Attestation), Type, T) :-
    attestation_t(Attestation, IsAttestation),
    attested_value_t(IsAttestation, Type, AttestedValue, T).
attested_t(Value, _, false) :-
    Value \= attested(_, _).

attestation_t(attestation(_, _, _, _), true).
attestation_t(Value, false) :-
    Value \= attestation(_, _, _, _).

attested_value_t(false, _, _, false).
attested_value_t(true, Type, AttestedValue, T) :-
    in_type_t(Type, AttestedValue, T).

:- end_module(kernel).
