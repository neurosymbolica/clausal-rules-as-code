% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_input_mode.clausal -- INPUT MODE: public predicates called with the
% result argument BOUND (the answer given, not read out), and input
% tolerance: malformed profiles and arguments get exactly the input
% problems THE INPUT CHECK states, before any route.
% Run: python -m clausal.testing eu/data_protection/gdpr_procedural_regulation/tests/test_input_mode.clausal
% =====================================================================
:- module(test_input_mode, []).
:- use_module(eu/data_protection/gdpr_procedural_regulation/gdpr_procedural_regulation, [
    complaint_admissibility/3,
    prior_request_condition/3,
    early_resolution/3,
    simple_cooperation_procedure/4,
    draft_decision_time_limit/4,
    late_step_effect/4,
    procedural_time_limit/4,
    temporal_application/5,
    gdpr_procedural_regulation_status/2
]).
:- use_module(eu/data_protection/gdpr_procedural_regulation/kernel, [gdpr_procedural_regulation_input_problems/2]).
:- use_module(eu/data_protection/gdpr_procedural_regulation/fixtures, [gdpr_procedural_regulation_profile_for/2]).

fixture(Subject, Profile) :-
    gdpr_procedural_regulation_profile_for(Subject, Profile).

% ---- bound results, one per query -------------------------------------
test(admissible_with_the_result_bound) :-
    fixture(admissible_data_subject_complaint, Profile),
    complaint_admissibility(Profile, admissible, _).
test(inadmissible_with_result_and_citations_bound) :-
    fixture(article_80_1_body_complaint_without_mandate, Profile),
    complaint_admissibility(Profile, inadmissible, [cite(eu_reg_2025_2518_art_4_1), cite(eu_reg_2025_2518_art_4_2), cite(eu_reg_2025_2518_art_4_5)]).
test(admissible_is_rejected_when_bound_on_an_inadmissible_complaint, fail) :-
    fixture(article_80_1_body_complaint_without_mandate, Profile),
    complaint_admissibility(Profile, admissible, _).
test(facade_status_with_the_result_bound) :-
    fixture(admissible_article_80_2_body_complaint, Profile),
    gdpr_procedural_regulation_status(Profile, admissible).
test(prior_request_not_made_with_the_result_bound) :-
    fixture(prior_request_not_made_complaint, Profile),
    prior_request_condition(Profile, prior_request_not_made, [cite(eu_reg_2025_2518_art_4_3)]).
test(early_resolution_before_the_lead_authority_with_the_result_bound) :-
    fixture(early_resolution_before_lead_authority, Profile),
    early_resolution(Profile, draft_decision_establishing_resolution, _).
test(simple_procedure_excluded_with_the_result_bound) :-
    fixture(simple_procedure_objected_case, Profile),
    simple_cooperation_procedure(Profile, simple_procedure_excluded_by_objection, [outside_fact(case_handled_under_article_56_2, _)], [cite(eu_reg_2025_2518_art_6_3)]).
test(draft_decision_limit_with_the_result_bound) :-
    fixture(simple_procedure_justified_extension_case, Profile),
    draft_decision_time_limit(Profile, draft_decision_limit(12, extension(up_to, 2, months)), _, _).
test(late_step_effect_with_the_result_bound) :-
    fixture(late_step_after_regulation_time_limit, Profile),
    late_step_effect(Profile, legality_and_validity_not_affected, _, [cite(eu_reg_2025_2518_art_14)]).
test(procedural_time_limit_fully_bound) :-
    procedural_time_limit([], object_to_simple_cooperation_procedure, limit(2, weeks, within, notification_of_simple_cooperation_procedure, no_extension), [cite(eu_reg_2025_2518_art_6_3)]).
test(temporal_application_with_the_result_bound) :-
    temporal_application([], dispute_resolution_and_urgency, date(2027, 4, 2), part_does_not_apply, [cite(eu_reg_2025_2518_art_36), cite(eu_reg_2025_2518_art_37_2)]).
test(temporal_application_bound_wrong_result_is_rejected, fail) :-
    temporal_application([], dispute_resolution_and_urgency, date(2027, 4, 2), part_applies, _).

% ---- input tolerance: the profile -------------------------------------
test(a_list_holding_a_foreign_element_is_not_an_attribute_list) :-
    gdpr_procedural_regulation_input_problems([attribute(complaint_lodged_by, data_subject), colour], [wrong_type(profile)]).
test(a_number_key_is_an_unknown_key) :-
    gdpr_procedural_regulation_input_problems([attribute(42, true)], [unknown_key(42)]).
test(a_compound_key_is_an_unknown_key_as_given) :-
    gdpr_procedural_regulation_input_problems([attribute(given(key), true)], [unknown_key(given(key))]).
test(a_repeated_key_is_a_duplicate_only_then_unknown_keys) :-
    fixture(malformed_profile_case, Profile),
    gdpr_procedural_regulation_input_problems(Profile, [duplicate_key(complaint_lodged_by), unknown_key(complaint_reference)]).
test(wrong_types_come_before_unknown_keys) :-
    gdpr_procedural_regulation_input_problems([attribute(colour, red), attribute(complaint_lodged_by, nobody)], [wrong_type(complaint_lodged_by), unknown_key(colour)]).
test(an_unknown_key_blocks_an_otherwise_admissible_complaint) :-
    fixture(admissible_data_subject_complaint, Profile),
    complaint_admissibility([attribute(colour, red)|Profile], input_problems([unknown_key(colour)]), []).
test(a_malformed_key_the_query_does_not_read_still_blocks) :-
    late_step_effect([attribute(complaint_lodged_by, nobody)], input_problems([wrong_type(complaint_lodged_by)]), [], []).
test(a_crisp_key_given_unsure_is_a_wrong_type) :-
    gdpr_procedural_regulation_input_problems([attribute(simple_cooperation_procedure_applied, unsure)], [wrong_type(simple_cooperation_procedure_applied)]).
test(a_judgement_given_unsure_is_accepted) :-
    gdpr_procedural_regulation_input_problems([attribute(issues_addressable_without_additional_cooperation, unsure)], []).
test(a_bare_outside_fact_is_a_wrong_type) :-
    simple_cooperation_procedure([attribute(case_handled_under_article_56_2, true)], input_problems([wrong_type(case_handled_under_article_56_2)]), [], []).
test(an_attested_crisp_key_is_a_wrong_type) :-
    gdpr_procedural_regulation_input_problems([attribute(draft_decision_time_limit_extended, attested(true, attestation(host, instant, reason, none)))], [wrong_type(draft_decision_time_limit_extended)]).
test(an_attestation_with_three_arguments_is_a_wrong_type) :-
    gdpr_procedural_regulation_input_problems([attribute(time_limit_set_by_this_regulation_or_article_65_6, attested(true, attestation(host, instant, reason)))], [wrong_type(time_limit_set_by_this_regulation_or_article_65_6)]).
test(url_and_document_evidence_are_accepted) :-
    fixture(simple_procedure_justified_extension_case, UrlProfile),
    gdpr_procedural_regulation_input_problems(UrlProfile, []),
    fixture(late_step_after_other_time_limit, DocumentProfile),
    gdpr_procedural_regulation_input_problems(DocumentProfile, []).
test(the_order_of_attributes_does_not_change_the_answer) :-
    fixture(admissible_article_80_1_body_complaint, Profile),
    reverse(Profile, ReversedProfile),
    complaint_admissibility(Profile, Result, _),
    complaint_admissibility(ReversedProfile, ReversedResult, _),
    Result == ReversedResult.

% ---- input tolerance: the arguments ------------------------------------
test(an_unknown_step_is_a_wrong_type) :-
    procedural_time_limit([], file_appeal, input_problems([wrong_type(step)]), []).
test(profile_problems_come_before_the_step_problem) :-
    procedural_time_limit([attribute(colour, red)], file_appeal, input_problems([unknown_key(colour), wrong_type(step)]), []).
test(the_twenty_ninth_of_february_2027_is_not_a_day) :-
    temporal_application([], cooperation_and_files, date(2027, 2, 29), input_problems([wrong_type(event_date)]), []).
test(a_thirteenth_month_is_not_a_day) :-
    temporal_application([], cooperation_and_files, date(2027, 13, 1), input_problems([wrong_type(event_date)]), []).
test(a_century_year_not_divisible_by_400_is_not_leap) :-
    temporal_application([], complaints_and_early_resolution, date(1900, 2, 29), input_problems([wrong_type(event_date)]), []).
test(the_year_2000_is_leap) :-
    temporal_application([], complaints_and_early_resolution, date(2000, 2, 29), part_does_not_apply, _).
test(profile_part_and_date_problems_in_order) :-
    temporal_application([attribute(colour, red)], chapter_nine, date(2027, 4, 31), input_problems([unknown_key(colour), wrong_type(part), wrong_type(event_date)]), []).

:- end_module(test_input_mode).
