% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_robustness.clausal -- ROBUSTNESS of the input check gdpr_procedural_regulation_input_problems/2 for a
% PROFILE that is an attribute list [attribute(Key, Value), ...]: an empty list, a
% value that is not a list, an unknown key and a value outside its type each get exactly
% one answer. Written by the scaffold from the order's typed input contract
% (input_contract.types.profile: attribute_list), not by the producer;
% do not edit or delete.
% Run: python -m clausal.testing eu/data_protection/gdpr_procedural_regulation/tests/test_robustness.clausal
% =====================================================================
:- module(test_robustness, []).
:- use_module(eu/data_protection/gdpr_procedural_regulation/queries, [gdpr_procedural_regulation_input_problems/2]).

test(an_empty_attribute_list_gets_exactly_one_answer) :-
    findall(Problems, gdpr_procedural_regulation_input_problems([], Problems), Answers),
    Answers == [[]].

test(a_profile_that_is_not_a_list_gets_one_non_empty_answer) :-
    findall(Problems, gdpr_procedural_regulation_input_problems(not_a_profile, Problems), Answers),
    Answers = [[_|_]].

test(an_unknown_key_is_named) :-
    findall(Problems, gdpr_procedural_regulation_input_problems([attribute(not_a_key_of_the_contract, data_subject)], Problems), Answers),
    Answers = [Problems],
    memberchk(unknown_key(not_a_key_of_the_contract), Problems).

test(a_value_outside_the_type_of_complaint_lodged_by_is_named) :-
    findall(Problems, gdpr_procedural_regulation_input_problems([attribute(complaint_lodged_by, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(complaint_lodged_by), Problems).

test(a_value_outside_the_type_of_lodging_person_name_and_contact_details_included_is_named) :-
    findall(Problems, gdpr_procedural_regulation_input_problems([attribute(lodging_person_name_and_contact_details_included, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(lodging_person_name_and_contact_details_included), Problems).

test(a_value_outside_the_type_of_complaint_concerns_right_exercised_by_request_is_named) :-
    findall(Problems, gdpr_procedural_regulation_input_problems([attribute(complaint_concerns_right_exercised_by_request, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(complaint_concerns_right_exercised_by_request), Problems).

:- end_module(test_robustness).
