% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% queries.clausal -- QUERY-COMBINATOR layer for eu/data_protection/gdpr_procedural_regulation.
% A TOP-LAYER consumer: it imports the determination slice's PUBLIC
% predicates it calls, and nothing else.
%
% The order's query types are served by the contract queries of the
% determination slice (gdpr_procedural_regulation.clausal), which the package
% facade re-exports:
%   #3  status determination : complaint_admissibility/3 (and the facade
%                              decide_gdpr_procedural_regulation/2 and
%                              gdpr_procedural_regulation_status/2);
%   #13 compliance check     : simple_cooperation_procedure/4 (may the lead
%                              authority use the simple procedure),
%                              prior_request_condition/3, late_step_effect/4
%                              (consequence of a step taken late, Art 14);
%   #15 deadline             : procedural_time_limit/4, draft_decision_time_limit/4,
%                              temporal_application/5 (never a computed end date:
%                              period_end_dates is deferred).
%
% This layer adds only:
%   gdpr_procedural_regulation_what_if/4      (#16 what-if): override one key -> re-evaluate
%                                             the admissibility status. The profile is an
%                                             ATTRIBUTE LIST, not a dict, so the kit's
%                                             override_key/4 (dict-only) does not apply:
%                                             the override is a local list rewrite (logic
%                                             fix: override_key raised type_error(dict, _)).
%   gdpr_procedural_regulation_profile_keys/1: the twenty-two profile keys, contract order
%   gdpr_procedural_regulation_input_problems/2: THE INPUT CHECK, re-exported as the
%                                             scaffold wrote it in the kernel
%   the ROOT EXPORTS of the order: the bare result, BASIS, LIMIT, EXTENSION and
%   EVENT atoms as 0-arity facts, and the RESULT CONSTRUCTORS as predicates that
%   hold exactly for the terms the queries can return. Every constructor is DERIVED
%   from the slice's own queries (probe profiles, the time-limit rows), so the
%   vocabulary has one source of truth. None decides a statutory condition.
% =====================================================================

:- module(queries, [
    gdpr_procedural_regulation_profile_keys/1,
    gdpr_procedural_regulation_input_problems/2,
    gdpr_procedural_regulation_what_if/4,
    admissible/0,
    inadmissible/0,
    prior_request_not_required/0,
    prior_request_made/0,
    prior_request_not_made/0,
    early_resolution_not_available/0,
    complaint_not_devoid_of_purpose/0,
    early_resolution_objected/0,
    resolution_established_by_receiving_authority/0,
    draft_decision_establishing_resolution/0,
    chapter_iii_not_applicable/0,
    simple_procedure_not_available/0,
    simple_procedure_excluded_by_objection/0,
    simple_procedure_available/0,
    legality_and_validity_not_affected/0,
    not_governed_by_article_14/0,
    part_applies/0,
    part_does_not_apply/0,
    suspended_until_board_binding_decision/0,
    extension_not_permitted/0,
    no_extension/0,
    up_to/0,
    exactly/0,
    weeks/0,
    months/0,
    within/0,
    at_least_before/0,
    receipt_of_complaint/0,
    complainant_receiving_early_resolution_information/0,
    expiry_of_objection_time_limit/0,
    confirmation_of_competence_or_board_binding_decision/0,
    notification_of_simple_cooperation_procedure/0,
    receipt_of_summary_of_key_issues/0,
    expiry_of_comment_period/0,
    expiry_of_draft_decision_time_limit/0,
    being_informed_of_extension/0,
    expiry_of_simple_procedure_time_limit/0,
    date/3,
    draft_decision_limit/2,
    extension/3,
    limit/5,
    indeterminate/1,
    needs_legal_review/2,
    open_textured/2,
    cross_reference_unresolved/2,
    resolution/2,
    inputs_relied_on/1,
    outside_fact/2,
    attested/2,
    attestation/4,
    url/2,
    document/2,
    input_problems/1,
    unknown_key/1,
    wrong_type/1,
    duplicate_key/1
]).

:- use_module(library(reif), [memberd_t/3]).
:- use_module(eu/data_protection/gdpr_procedural_regulation/kernel, [gdpr_procedural_regulation_input_problems/2]).
:- use_module(eu/data_protection/gdpr_procedural_regulation/gdpr_procedural_regulation, [
    gdpr_procedural_regulation_status/2,
    prior_request_condition/3,
    simple_cooperation_procedure/4,
    draft_decision_time_limit/4,
    late_step_effect/4,
    procedural_time_limit/4,
    temporal_application/5
]).

% schema of top-level profile keys: the keys of the order's typed input contract, in its order
gdpr_procedural_regulation_profile_keys([complaint_lodged_by, lodging_person_name_and_contact_details_included, proof_of_proper_constitution_included, proof_of_data_subject_mandate_included, controller_or_processor_identification_information_included, alleged_infringement_description_included, complaint_concerns_right_exercised_by_request, request_made_to_controller_before_complaint, complaint_concerns_chapter_iii_rights, end_of_infringement_established_on_supporting_evidence, complainant_objected_to_early_resolution_in_time, early_resolution_procedure_before, case_handled_under_article_56_2, lead_authority_considers_no_reasonable_doubt_as_to_scope, issues_addressable_without_additional_cooperation, concerned_authority_objected_to_simple_procedure_in_time, simple_cooperation_procedure_applied, draft_decision_time_limit_extended, board_request_under_article_11_6_made, extension_justified_by_exceptional_complexity, national_law_requires_domestic_proceedings_after_time_limit, time_limit_set_by_this_regulation_or_article_65_6]).

% #16 what-if: re-evaluate the admissibility status with one key hypothetically overridden
% (logic fix: the attribute-list profile is rewritten locally; override_key/4 needs a dict)
gdpr_procedural_regulation_what_if(Profile, OverriddenKey, NewValue, NewStatus) :-
    attribute_override(Profile, OverriddenKey, NewValue, Hypothesis),
    gdpr_procedural_regulation_status(Hypothesis, NewStatus).

% attribute_override(Profile, Key, Value, Hypothesis): every attribute(Key, _) dropped,
% then attribute(Key, Value) added once.
attribute_override(Profile, OverriddenKey, NewValue, Hypothesis) :-
    attributes_without_key(Profile, OverriddenKey, Remaining),
    append(Remaining, [attribute(OverriddenKey, NewValue)], Hypothesis).

attributes_without_key([], _, []).
attributes_without_key([attribute(ElementKey, ElementValue)|Elements], OverriddenKey, [attribute(ElementKey, ElementValue)|Remaining]) :-
    ElementKey \== OverriddenKey,
    attributes_without_key(Elements, OverriddenKey, Remaining).
attributes_without_key([attribute(ElementKey, _)|Elements], OverriddenKey, Remaining) :-
    ElementKey == OverriddenKey,
    attributes_without_key(Elements, OverriddenKey, Remaining).

% =====================================================================
% ROOT EXPORTS: the bare atoms of the called contract
% =====================================================================

% complaint_admissibility/3 results
admissible.
inadmissible.
% prior_request_condition/3 results
prior_request_not_required.
prior_request_made.
prior_request_not_made.
% early_resolution/3 results
early_resolution_not_available.
complaint_not_devoid_of_purpose.
early_resolution_objected.
resolution_established_by_receiving_authority.
draft_decision_establishing_resolution.
% simple_cooperation_procedure/4 results
chapter_iii_not_applicable.
simple_procedure_not_available.
simple_procedure_excluded_by_objection.
simple_procedure_available.
% late_step_effect/4 results
legality_and_validity_not_affected.
not_governed_by_article_14.
% temporal_application/5 results
part_applies.
part_does_not_apply.
% draft_decision_time_limit/4 BASIS atoms
suspended_until_board_binding_decision.
extension_not_permitted.
% LIMIT and EXTENSION atoms
no_extension.
up_to.
exactly.
weeks.
months.
within.
at_least_before.
% EVENT atoms of THE TIME LIMITS
receipt_of_complaint.
complainant_receiving_early_resolution_information.
expiry_of_objection_time_limit.
confirmation_of_competence_or_board_binding_decision.
notification_of_simple_cooperation_procedure.
receipt_of_summary_of_key_issues.
expiry_of_comment_period.
expiry_of_draft_decision_time_limit.
being_informed_of_extension.
expiry_of_simple_procedure_time_limit.

% =====================================================================
% RESULT CONSTRUCTORS: each holds for the terms the queries can return
% =====================================================================

% The sixteen step atoms of THE TIME LIMITS (host-supplied arguments).
time_limit_steps([declare_complaint_inadmissible, transmit_complaint_to_presumed_lead_authority, confirm_competence_or_refer_to_board, object_to_early_resolution, establish_early_resolution, submit_early_resolution_draft_decision, notify_simple_cooperation_procedure, object_to_simple_cooperation_procedure, provide_summary_of_key_issues, comment_on_summary_of_key_issues, respond_to_comments_on_summary_of_key_issues, submit_draft_decision, inform_of_draft_decision_extension, object_to_draft_decision_extension, submit_draft_decision_in_simple_procedure, inform_of_simple_procedure_extension]).

% The argument names of THE INPUT CHECK that are not profile keys.
argument_name(profile).
argument_name(step).
argument_name(part).
argument_name(event_date).

% The two rows that time the draft decision.
draft_decision_step(submit_draft_decision).
draft_decision_step(submit_draft_decision_in_simple_procedure).

% date(Y, M, D): a real Gregorian day, as the temporal query accepts it.
date(YearNumber, MonthNumber, DayNumber) :-
    temporal_application([], complaints_and_early_resolution, date(YearNumber, MonthNumber, DayNumber), Result, _),
    application_result(Result).

application_result(part_applies).
application_result(part_does_not_apply).

% limit/5: each distinct LIMIT of THE TIME LIMITS, once.
limit(Length, TimeUnit, Relation, Event, Extension) :-
    findall(LimitTerm, stated_limit(LimitTerm), LimitTerms),
    sort(LimitTerms, DistinctLimits),
    member(limit(Length, TimeUnit, Relation, Event, Extension), DistinctLimits).

stated_limit(LimitTerm) :-
    time_limit_steps(ProceduralSteps),
    member(ProceduralStep, ProceduralSteps),
    procedural_time_limit([], ProceduralStep, LimitTerm, _).

% extension/3: each distinct extension a row allows, once.
extension(ExtensionKind, Length, TimeUnit) :-
    findall(StatedExtension, limit(_, _, _, _, StatedExtension), StatedExtensions),
    sort(StatedExtensions, DistinctExtensions),
    member(extension(ExtensionKind, Length, TimeUnit), DistinctExtensions).

% draft_decision_limit/2: the base limits and the ceilings of their extensions.
draft_decision_limit(Months, no_extension) :-
    draft_decision_step(ProceduralStep),
    procedural_time_limit([], ProceduralStep, limit(Months, months, within, _, _), _).
draft_decision_limit(Months, extension(up_to, Ceiling, months)) :-
    draft_decision_step(ProceduralStep),
    procedural_time_limit([], ProceduralStep, limit(Months, months, within, _, extension(up_to, Ceiling, months)), _).

% indeterminate([Key]): one judgement, enumeration or crisp key, never an outside fact.
indeterminate([ProfileKey]) :-
    gdpr_procedural_regulation_profile_keys(ProfileKeys),
    member(ProfileKey, ProfileKeys),
    findall(OutsideKey, outside_fact_key(OutsideKey), OutsideKeys),
    memberd_t(ProfileKey, OutsideKeys, false).

% One probe per referral row of the order; each yields that row's referral.
referral_answer(Answer) :-
    prior_request_condition([attribute(complaint_concerns_right_exercised_by_request, unsure),
                             attribute(request_made_to_controller_before_complaint, true)],
                            Answer,
                            _).
referral_answer(Answer) :-
    simple_cooperation_procedure([attribute(case_handled_under_article_56_2, attested(false, attestation(probe_author, probe_moment, probe_reason, none))),
                                  attribute(lead_authority_considers_no_reasonable_doubt_as_to_scope, true),
                                  attribute(issues_addressable_without_additional_cooperation, unsure),
                                  attribute(concerned_authority_objected_to_simple_procedure_in_time, false)],
                                 Answer,
                                 _,
                                 _).
referral_answer(Answer) :-
    simple_cooperation_procedure([attribute(lead_authority_considers_no_reasonable_doubt_as_to_scope, false)],
                                 Answer,
                                 _,
                                 _).
referral_answer(Answer) :-
    draft_decision_time_limit([attribute(simple_cooperation_procedure_applied, false),
                               attribute(draft_decision_time_limit_extended, true),
                               attribute(board_request_under_article_11_6_made, false),
                               attribute(extension_justified_by_exceptional_complexity, unsure)],
                              Answer,
                              _,
                              _).
referral_answer(Answer) :-
    draft_decision_time_limit([attribute(simple_cooperation_procedure_applied, true),
                               attribute(draft_decision_time_limit_extended, true)],
                              Answer,
                              _,
                              _).
referral_answer(Answer) :-
    late_step_effect([], Answer, _, _).

needs_legal_review(Reason, Context) :-
    findall(Answer, referral_answer(Answer), Answers),
    sort(Answers, DistinctAnswers),
    member(needs_legal_review(Reason, Context), DistinctAnswers).

open_textured(Input, Citation) :-
    needs_legal_review(open_textured(Input, Citation), _).

cross_reference_unresolved(Citation, Target) :-
    needs_legal_review(cross_reference_unresolved(Citation, Target), _).

resolution(Target, ResolutionStatus) :-
    needs_legal_review(cross_reference_unresolved(_, Target), Context),
    member(resolution(Target, ResolutionStatus), Context).

inputs_relied_on(InputPairs) :-
    needs_legal_review(_, Context),
    member(inputs_relied_on(InputPairs), Context).

% The three outside-fact keys: those an absent referral relies on.
outside_fact_key(ProfileKey) :-
    inputs_relied_on([ProfileKey-absent]).

outside_fact(ProfileKey, attested(AttestedValue, Attestation)) :-
    outside_fact_key(ProfileKey),
    attested(AttestedValue, Attestation).

% attested/2: a well-formed attested term, as THE INPUT CHECK accepts it.
attested(AttestedValue, Attestation) :-
    gdpr_procedural_regulation_input_problems([attribute(time_limit_set_by_this_regulation_or_article_65_6, attested(AttestedValue, Attestation))], []).

attestation(Author, Moment, Reason, Evidence) :-
    attested(true, attestation(Author, Moment, Reason, Evidence)).

url(Address, RetrievedAt) :-
    ground(url(Address, RetrievedAt)).

document(UploadIdentifier, ContentDigest) :-
    ground(document(UploadIdentifier, ContentDigest)).

% input_problems/1 and its items.
input_problems([Problem|Problems]) :-
    maplist(input_problem, [Problem|Problems]).

input_problem(duplicate_key(ProfileKey)) :-
    duplicate_key(ProfileKey).
input_problem(wrong_type(ArgumentName)) :-
    wrong_type(ArgumentName).
input_problem(unknown_key(ProfileKey)) :-
    unknown_key(ProfileKey).

unknown_key(ProfileKey) :-
    gdpr_procedural_regulation_input_problems([attribute(ProfileKey, true)], [unknown_key(ProfileKey)]).

wrong_type(ArgumentName) :-
    argument_name(ArgumentName).
wrong_type(ProfileKey) :-
    gdpr_procedural_regulation_profile_keys(ProfileKeys),
    member(ProfileKey, ProfileKeys).

duplicate_key(ProfileKey) :-
    gdpr_procedural_regulation_profile_keys(ProfileKeys),
    member(ProfileKey, ProfileKeys).

:- end_module(queries).
