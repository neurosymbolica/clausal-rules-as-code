% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% queries.clausal -- QUERY-COMBINATOR layer for eu/data_protection/gdpr_art6_lawful_basis.
% A TOP-LAYER consumer: it imports the determination slice's PUBLIC
% predicates it calls, and nothing else.
%
% Source: Regulation (EU) 2016/679 (GDPR) Art 6(1), Art 6(3) first sentence
% and Art 6(4); pinned consolidated English Formex text 02016R0679-20160504.
%
% The declared query types are served by the slice
% gdpr_art6_lawful_basis.clausal and re-exported by the package facade:
%   #2 eligibility          -- lawful_basis_status/4 and
%                              decide_gdpr_art6_lawful_basis/2 (eligible |
%                              ineligible | indeterminate([Key]) |
%                              needs_legal_review/2 | input_problems/1), with
%                              cited CITATIONS;
%   #3 status_determination -- purpose_compatibility/4 (Art 6(4)) and
%                              gdpr_art6_lawful_basis_status/2;
%   #7 justification        -- gdpr_art6_lawful_basis_checklist/2, one
%                              item(Way, Status, cite(Point)) per considered way.
% This layer adds:
%   gdpr_art6_lawful_basis_what_if/4      (#16 what-if): replace one key -> re-evaluate
%   gdpr_art6_lawful_basis_profile_keys/1: top-level profile key schema
%   gdpr_art6_lawful_basis_input_problems/2: the problems a profile has ([] = none),
%     re-exported from the kernel as the scaffold wrote it.
%   The order's own result atoms (eligible/0, ..., compatibility_not_ascertained/0)
%   and its result constructors (indeterminate/1, ..., duplicate_key/1). The
%   constructors are DATA: they are exported and declared below, and have no
%   clauses.
%
% The what-if works on the ATTRIBUTE LIST the order types (not a dict, so the
% kit's dict-based override_key/4 does not apply): every entry of the key is
% removed, then one entry with the new value is added, so no duplicate is
% created; the value atom absent only removes the key. A term that is not an
% attribute list is evaluated as given (it answers input_problems). Exactly one
% solution for every input. List plumbing only: no statutory marker.
% =====================================================================

:- module(queries, [
    gdpr_art6_lawful_basis_profile_keys/1,
    gdpr_art6_lawful_basis_input_problems/2,
    gdpr_art6_lawful_basis_what_if/4,
    eligible/0,
    ineligible/0,
    purpose_compatible/0,
    purpose_not_compatible/0,
    compatibility_test_not_engaged/0,
    compatibility_not_ascertained/0,
    indeterminate/1,
    needs_legal_review/2,
    open_textured/2,
    cross_reference_unresolved/2,
    resolution/2,
    inputs_relied_on/1,
    provenance/2,
    outside_fact/2,
    flagged/2,
    attested/2,
    attestation/4,
    url/2,
    document/2,
    input_problems/1,
    unknown_key/1,
    wrong_type/1,
    duplicate_key/1
]).

:- use_module(eu/data_protection/gdpr_art6_lawful_basis/kernel, [gdpr_art6_lawful_basis_input_problems/2]).
:- use_module(eu/data_protection/gdpr_art6_lawful_basis/gdpr_art6_lawful_basis, [gdpr_art6_lawful_basis_status/2]).

% ---- the order's result constructors (INPUT CONTRACT, RESULT CONSTRUCTORS) --
% Exported, never called as queries: data, with no clauses.
:- constructors([
    indeterminate(missing_keys),
    needs_legal_review(reason, context),
    open_textured(key, citation),
    cross_reference_unresolved(citation, target),
    resolution(target, status),
    inputs_relied_on(pairs),
    provenance(clause, citations),
    outside_fact(key, attested),
    flagged(key, attested),
    input_problems(problems),
    unknown_key(key),
    wrong_type(key),
    duplicate_key(key)
]).

% schema of top-level profile keys: the keys of the order's typed input contract, in its order
gdpr_art6_lawful_basis_profile_keys([basis_claimed, consent_given_and_conditions_met, contract_necessary, legal_obligation_necessary, legal_obligation_laid_down_by_law, vital_interests_necessary, public_interest_task_necessary, public_interest_task_laid_down_by_law, processing_by_public_authority_in_its_tasks, legitimate_interests_pursued, interests_overridden, child_data_subject, special_category, new_purpose_processing, compatible_purpose, link_between_purposes_taken_into_account, collection_context_taken_into_account, nature_of_data_taken_into_account, possible_consequences_taken_into_account, appropriate_safeguards_taken_into_account]).

% #16 what-if: re-evaluate lawful_basis_status/4 with one key hypothetically replaced
gdpr_art6_lawful_basis_what_if(Profile, OverriddenKey, NewValue, NewStatus) :-
    gdpr_art6_lawful_basis_input_problems(Profile, Problems),
    what_if_by_shape(Problems, Profile, OverriddenKey, NewValue, NewStatus).

% A term that is not an attribute list cannot be edited: it is evaluated as given.
what_if_by_shape([wrong_type(profile)], Profile, _, _, NewStatus) :-
    gdpr_art6_lawful_basis_status(Profile, NewStatus).
what_if_by_shape(Problems, Profile, OverriddenKey, NewValue, NewStatus) :-
    dif(Problems, [wrong_type(profile)]),
    without_key(Profile, OverriddenKey, Remaining),
    with_value(NewValue, OverriddenKey, Remaining, Hypothesis),
    gdpr_art6_lawful_basis_status(Hypothesis, NewStatus).

% Every entry of the key is removed (keys compared by identity, never unified).
without_key([], _, []).
without_key([attribute(ElementKey, _)|Elements], OverriddenKey, Remaining) :-
    ElementKey == OverriddenKey,
    without_key(Elements, OverriddenKey, Remaining).
without_key([attribute(ElementKey, ElementValue)|Elements], OverriddenKey, [attribute(ElementKey, ElementValue)|Remaining]) :-
    ElementKey \== OverriddenKey,
    without_key(Elements, OverriddenKey, Remaining).

% The atom absent removes the key; any other value is added once.
with_value(NewValue, _, Remaining, Remaining) :-
    NewValue == absent.
with_value(NewValue, OverriddenKey, Remaining, Hypothesis) :-
    NewValue \== absent,
    append(Remaining, [attribute(OverriddenKey, NewValue)], Hypothesis).

% ---- the order's own result atoms (INTERFACE - THE CALLED CONTRACT) ------
% Data only: each is a result atom the queries return; nothing calls these.
eligible.
ineligible.
purpose_compatible.
purpose_not_compatible.
compatibility_test_not_engaged.
compatibility_not_ascertained.

test(profile_keys_are_twenty) :-
    gdpr_art6_lawful_basis_profile_keys(ProfileKeys),
    length(ProfileKeys, 20).
test(what_if_makes_contract_necessary) :-
    gdpr_art6_lawful_basis_what_if([attribute(basis_claimed, contract), attribute(contract_necessary, false)], contract_necessary, true, eligible).
test(what_if_absent_removes_the_key) :-
    gdpr_art6_lawful_basis_what_if([attribute(basis_claimed, contract), attribute(contract_necessary, true)], contract_necessary, absent, indeterminate([contract_necessary])).
test(what_if_replaces_a_duplicated_key) :-
    gdpr_art6_lawful_basis_what_if([attribute(contract_necessary, true), attribute(contract_necessary, false)], contract_necessary, true, eligible).
test(what_if_on_a_partial_list_reports_the_profile) :-
    gdpr_art6_lawful_basis_what_if([attribute(contract_necessary, true)|_], contract_necessary, true, input_problems([wrong_type(profile)])).
test(what_if_gives_exactly_one_solution) :-
    findall(NewStatus, gdpr_art6_lawful_basis_what_if([], vital_interests_necessary, true, NewStatus), Statuses),
    Statuses == [eligible].
test(result_atoms_are_defined) :-
    eligible,
    ineligible,
    purpose_compatible,
    purpose_not_compatible,
    compatibility_test_not_engaged,
    compatibility_not_ascertained.

:- end_module(queries).
