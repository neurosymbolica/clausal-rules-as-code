% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_load.clausal -- LOAD: the shared floor of
% eu/data_protection/gdpr_art6_lawful_basis loads (kernel and citations),
% the result terms the order pins build and destructure, the verdict
% atoms are distinct, and the real citation records resolve.
% Self-contained: the determination slices are not referenced here.
% Run: cd <corpus root> && python -m clausal.testing \
%      eu/data_protection/gdpr_art6_lawful_basis/tests/test_load.clausal
% =====================================================================
:- module(test_load, []).
:- use_module(eu/data_protection/gdpr_art6_lawful_basis/kernel, [gdpr_art6_lawful_basis_input_problems/2, gdpr_art6_lawful_basis_root_keys/1]).
:- use_module(eu/data_protection/gdpr_art6_lawful_basis/citations, [citation/2, implements/1, gdpr_art6_lawful_basis_outside_fact_entry/3, gdpr_art6_lawful_basis_referable/1]).

% ---- the kernel loads and its input check answers -----------------

test(the_root_keys_are_the_twenty_in_order) :-
    gdpr_art6_lawful_basis_root_keys(Keys),
    length(Keys, 20),
    Keys = [First|_],
    First == basis_claimed,
    last(Keys, Last),
    Last == appropriate_safeguards_taken_into_account.

test(an_empty_profile_has_exactly_one_answer_and_no_problem) :-
    findall(Problems, gdpr_art6_lawful_basis_input_problems([], Problems), Answers),
    Answers == [[]].

test(a_well_formed_profile_has_no_problem) :-
    gdpr_art6_lawful_basis_input_problems(
        [attribute(basis_claimed, consent),
         attribute(consent_given_and_conditions_met, attested(true, attestation(by, at, reason, none))),
         attribute(contract_necessary, unsure),
         attribute(new_purpose_processing, false)],
        Problems),
    Problems == [].

test(a_crisp_key_given_unsure_is_wrong_type) :-
    gdpr_art6_lawful_basis_input_problems(
        [attribute(new_purpose_processing, unsure)],
        Problems),
    Problems == [wrong_type(new_purpose_processing)].

test(a_crisp_key_given_true_is_not_wrong_type) :-
    gdpr_art6_lawful_basis_input_problems(
        [attribute(new_purpose_processing, true)],
        Problems),
    Problems == [].

test(a_profile_that_is_not_a_list_is_wrong_type) :-
    gdpr_art6_lawful_basis_input_problems(profile, Problems),
    Problems == [wrong_type(profile)].

% ---- the result terms build and destructure ------------------------

test(the_indeterminate_status_carries_one_key) :-
    Result = indeterminate([contract_necessary]),
    Result = indeterminate([Key]),
    Key == contract_necessary.

test(the_open_textured_referral_destructures) :-
    Result = needs_legal_review(
        open_textured(interests_overridden, cite(eu_reg_2016_679_art_6_1_f)),
        [inputs_relied_on([interests_overridden-unsure])]),
    Result = needs_legal_review(open_textured(Key, cite(Citation)), [inputs_relied_on(Pairs)]),
    Key == interests_overridden,
    Citation == eu_reg_2016_679_art_6_1_f,
    Pairs == [interests_overridden-unsure].

test(the_absent_referral_destructures) :-
    Result = needs_legal_review(
        cross_reference_unresolved(cite(eu_reg_2016_679_art_6_1_a), cite(consent_basis_statement)),
        [resolution(cite(consent_basis_statement), not_attempted),
         inputs_relied_on([consent_given_and_conditions_met-absent])]),
    Result = needs_legal_review(
        cross_reference_unresolved(cite(Citation), cite(Target)),
        [resolution(cite(Target), Status), inputs_relied_on([Key-Value])]),
    Citation == eu_reg_2016_679_art_6_1_a,
    Target == consent_basis_statement,
    Status == not_attempted,
    Key == consent_given_and_conditions_met,
    Value == absent.

test(the_basis_items_carry_the_attested_term) :-
    Attested = attested(true, attestation(by, at, reason, none)),
    Basis = [outside_fact(consent_given_and_conditions_met, Attested), flagged(special_category, Attested)],
    Basis = [outside_fact(FactKey, FactAttested), flagged(FlagKey, FlagAttested)],
    FactKey == consent_given_and_conditions_met,
    FlagKey == special_category,
    FactAttested == Attested,
    FlagAttested = attested(Value, attestation(_, _, _, Evidence)),
    Value == true,
    Evidence == none.

test(the_verdict_term_carries_status_and_citations) :-
    Verdict = gdpr_art6_lawful_basis_verdict(eligible, [cite(eu_reg_2016_679_art_6_1), cite(eu_reg_2016_679_art_6_1_b)]),
    Verdict = gdpr_art6_lawful_basis_verdict(Status, Citations),
    Status == eligible,
    Citations == [cite(eu_reg_2016_679_art_6_1), cite(eu_reg_2016_679_art_6_1_b)].

test(the_input_problems_status_destructures) :-
    Result = input_problems([duplicate_key(contract_necessary), wrong_type(special_category), unknown_key(colour)]),
    Result = input_problems([duplicate_key(First), wrong_type(Second), unknown_key(Third)]),
    First == contract_necessary,
    Second == special_category,
    Third == colour.

% ---- the verdict atoms are distinct --------------------------------

test(the_lawful_basis_atoms_are_distinct) :-
    dif(eligible, ineligible).

test(the_compatibility_atoms_are_distinct) :-
    dif(purpose_compatible, purpose_not_compatible),
    dif(purpose_compatible, compatibility_test_not_engaged),
    dif(purpose_compatible, compatibility_not_ascertained),
    dif(purpose_not_compatible, compatibility_test_not_engaged),
    dif(purpose_not_compatible, compatibility_not_ascertained),
    dif(compatibility_test_not_engaged, compatibility_not_ascertained).

test(the_six_result_atoms_are_six) :-
    Atoms = [eligible, ineligible, purpose_compatible, purpose_not_compatible, compatibility_test_not_engaged, compatibility_not_ascertained],
    sort(Atoms, Sorted),
    length(Sorted, 6).

test(eligible_does_not_unify_with_ineligible, fail) :-
    eligible = ineligible.

test(eligible_unifies_with_itself) :-
    eligible = eligible.

% ---- the real citation records resolve -----------------------------

test(the_umbrella_citation_is_recorded) :-
    citation(eu_reg_2016_679_art_6_1, Record),
    Record = [label-_, ref-_, verbatim-_].

test(every_pinned_citation_atom_is_recorded) :-
    Keys = [eu_reg_2016_679_art_6_1,
            eu_reg_2016_679_art_6_1_a,
            eu_reg_2016_679_art_6_1_b,
            eu_reg_2016_679_art_6_1_c,
            eu_reg_2016_679_art_6_1_d,
            eu_reg_2016_679_art_6_1_e,
            eu_reg_2016_679_art_6_1_f,
            eu_reg_2016_679_art_6_1_second_subpara,
            eu_reg_2016_679_art_6_3,
            eu_reg_2016_679_art_6_4,
            eu_reg_2016_679_art_6_4_a,
            eu_reg_2016_679_art_6_4_b,
            eu_reg_2016_679_art_6_4_c,
            eu_reg_2016_679_art_6_4_d,
            eu_reg_2016_679_art_6_4_e,
            eu_reg_2016_679_art_9_1],
    maplist(implements, Keys).

test(a_shortened_citation_is_not_recorded, fail) :-
    citation(art_6_1, _).

test(the_public_task_outside_fact_entry_resolves) :-
    gdpr_art6_lawful_basis_outside_fact_entry(public_interest_task_laid_down_by_law, Citation, Target),
    Citation == cite(eu_reg_2016_679_art_6_3),
    Target == public_interest_task_law_statement.

test(the_referable_outside_facts_are_three) :-
    findall(Key, gdpr_art6_lawful_basis_referable(Key), Keys),
    Keys == [consent_given_and_conditions_met, legal_obligation_laid_down_by_law, public_interest_task_laid_down_by_law].

test(special_category_is_not_referable, fail) :-
    gdpr_art6_lawful_basis_referable(special_category).

:- end_module(test_load).
