% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/data_protection/gdpr_art6_lawful_basis.
% Instrument: Regulation (EU) 2016/679 (GDPR), pinned consolidated English
% Formex text 02016R0679-20160504 (Art 6 fetched 2026-09-05; Art 9 fetched
% 2026-11-14).
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% Each verbatim is an exact substring of the pinned unit text.
%
% The keys are the corpus lexicon's canonical atoms (_lexicon/citations.yaml).
% The ten Art 6 keys are returned in CITATIONS; eu_reg_2016_679_art_9_1
% is the outside-fact citation of special_category, marked by the clause that
% flags it, and is never returned in a result. The three statement targets
% (consent_basis_statement, legal_obligation_law_statement,
% public_interest_task_law_statement) are the TARGETS of THE ABSENT REFERRAL:
% each record names the provision the host's statement answers. The deferred
% units (Art 4(11), Art 6(2), Art 6(4)(a) to (e), Art 7, Art 8) are applied by
% no rule and get no key.
%
% PROVENANCE: every operative clause opens its body with implements(Key).
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

implements(Key) :-
    citation(Key, _).

citation(eu_reg_2016_679_art_6_1, [label-'Regulation (EU) 2016/679 (GDPR) Art 6(1) first words (lawful only if at least one of points (a) to (f) applies)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit parag_006.001)', verbatim-'Processing shall be lawful only if and to the extent that at least one of the following applies:']).

citation(eu_reg_2016_679_art_6_1_a, [label-'Regulation (EU) 2016/679 (GDPR) Art 6(1)(a) consent', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_006.001_a)', verbatim-'the data subject has given consent to the processing of his or her personal data for one or more specific purposes;']).

citation(eu_reg_2016_679_art_6_1_b, [label-'Regulation (EU) 2016/679 (GDPR) Art 6(1)(b) necessary for a contract', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_006.001_b)', verbatim-'processing is necessary for the performance of a contract to which the data subject is party or in order to take steps at the request of the data subject prior to entering into a contract;']).

citation(eu_reg_2016_679_art_6_1_c, [label-'Regulation (EU) 2016/679 (GDPR) Art 6(1)(c) necessary for compliance with a legal obligation', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_006.001_c)', verbatim-'processing is necessary for compliance with a legal obligation to which the controller is subject;']).

citation(eu_reg_2016_679_art_6_1_d, [label-'Regulation (EU) 2016/679 (GDPR) Art 6(1)(d) necessary to protect vital interests', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_006.001_d)', verbatim-'processing is necessary in order to protect the vital interests of the data subject or of another natural person;']).

citation(eu_reg_2016_679_art_6_1_e, [label-'Regulation (EU) 2016/679 (GDPR) Art 6(1)(e) necessary for a task in the public interest or official authority', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_006.001_e)', verbatim-'processing is necessary for the performance of a task carried out in the public interest or in the exercise of official authority vested in the controller;']).

citation(eu_reg_2016_679_art_6_1_f, [label-'Regulation (EU) 2016/679 (GDPR) Art 6(1)(f) legitimate interests, unless overridden (in particular where the data subject is a child)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_006.001_f)', verbatim-'processing is necessary for the purposes of the legitimate interests pursued by the controller or by a third party, except where such interests are overridden by the interests or fundamental rights and freedoms of the data subject which require protection of personal data, in particular where the data subject is a child.']).

citation(eu_reg_2016_679_art_6_1_second_subpara, [label-'Regulation (EU) 2016/679 (GDPR) Art 6(1) last subparagraph (point (f) not for public authorities in the performance of their tasks)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit parag_006.001)', verbatim-'Point (f) of the first subparagraph shall not apply to processing carried out by public authorities in the performance of their tasks.']).

citation(eu_reg_2016_679_art_6_3, [label-'Regulation (EU) 2016/679 (GDPR) Art 6(3) first sentence (basis of points (c) and (e) laid down by Union or Member State law)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit parag_006.003)', verbatim-'The basis for the processing referred to in point (c) and (e) of paragraph 1 shall be laid down by:']).

citation(eu_reg_2016_679_art_6_4, [label-'Regulation (EU) 2016/679 (GDPR) Art 6(4) first words (compatibility of processing for another purpose)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit parag_006.004)', verbatim-'in order to ascertain whether processing for another purpose is compatible with the purpose for which the personal data are initially collected, take into account, inter alia:']).

citation(eu_reg_2016_679_art_9_1, [label-'Regulation (EU) 2016/679 (GDPR) Art 9(1) special categories of personal data (flagged only; Art 9 deferred)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit parag_009.001)', verbatim-'Processing of personal data revealing racial or ethnic origin, political opinions, religious or philosophical beliefs, or trade union membership']).

% ---- targets of THE ABSENT REFERRAL: the host's statements ---------------

citation(consent_basis_statement, [label-'Regulation (EU) 2016/679 (GDPR) Art 6(1)(a) consent: the host''s attested statement that consent was given with its conditions met (answer of the consent package gdpr-consent-conditions)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit point_006.001_a)', verbatim-'the data subject has given consent to the processing of his or her personal data']).

citation(legal_obligation_law_statement, [label-'Regulation (EU) 2016/679 (GDPR) Art 6(3) first sentence for Art 6(1)(c): the host''s attested statement that the legal obligation is laid down by Union law or Member State law to which the controller is subject', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit parag_006.003)', verbatim-'The basis for the processing referred to in point (c) and (e) of paragraph 1 shall be laid down by:']).

citation(public_interest_task_law_statement, [label-'Regulation (EU) 2016/679 (GDPR) Art 6(3) first sentence for Art 6(1)(e): the host''s attested statement that the task or official authority is laid down by Union law or Member State law to which the controller is subject', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit parag_006.003)', verbatim-'The basis for the processing referred to in point (c) and (e) of paragraph 1 shall be laid down by:']).

:- end_module(citations).
