% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% queries.clausal -- QUERY-COMBINATOR layer for eu/data_protection/gdpr_accountability_security.
% A TOP-LAYER consumer: it imports the determination slice's PUBLIC
% predicates it calls, and nothing else.
%
% Source: Regulation (EU) 2016/679 (GDPR), consolidated text 02016R0679-20160504
% (pinned 2026-11-11): Art 5(2), 24(1)-(2), 25(1)-(2), 26(1)-(2), 32(1), (2), (4).
%
% Query types this domain serves, and where each lives:
%   #2 eligibility    decide_gdpr_accountability_security/2 and
%                     gdpr_accountability_security_status/2 (the slice): compliant |
%                     review_required | not_compliant | input_problems(Problems)
%   #7 justification  gdpr_accountability_security_checklist/2 (the slice): one
%                     item(Duty, Status, cite(Key)) per duty, met items cited too
%   #16 what-if       gdpr_accountability_security_what_if/4 (here): override one key
%                     of the ATTRIBUTE LIST profile, then re-decide. The kit's
%                     override_key/4 works on dicts only and raises type_error(dict, _)
%                     on an attribute list, so the override is written here over
%                     attribute(Key, Value) items.
%   called contract   duty_status/5, non_binding_items/3,
%                     joint_controller_arrangement/3,
%                     joint_controller_arrangement_content/4 (the slice)
%
% gdpr_accountability_security_profile_keys/1: top-level profile key schema
% gdpr_accountability_security_input_problems/2: the problems a profile has ([] = none),
%   re-exported from the kernel as the scaffold wrote it.
%
% RESULT CONSTRUCTORS and ROOT ATOMS: the order names its result atoms, its
% result constructors, its seventeen profile keys, its seven duty atoms, its two
% topic atoms and the judgement value unsure as package-root exports. The root
% atoms are defined here as facts; the result constructors are DATA and have no
% clauses: they are exported and their fields are named by the constructors
% declaration below.
%
% This layer decides no statutory condition (it delegates every decision to
% the slice), so it carries no implements/1 marker. The order hands every
% open-textured judgement ('appropriate', 'jointly determine') to the user
% through attested outside facts and the unsure judgement value; no query here
% invents a crisp test for one.
% =====================================================================

:- module(queries, [
    gdpr_accountability_security_profile_keys/1,
    gdpr_accountability_security_input_problems/2,
    gdpr_accountability_security_what_if/4,
    met/0,
    not_met/0,
    not_joint_controllers/0,
    arrangement_not_required/0,
    arrangement_in_place/0,
    arrangement_missing/0,
    content_requirements_met/0,
    content_requirements_not_met/0,
    indeterminate/1,
    needs_legal_review/2,
    open_textured/2,
    cross_reference_unresolved/2,
    resolution/2,
    inputs_relied_on/1,
    provenance/2,
    outside_fact/2,
    attested/2,
    attestation/4,
    url/2,
    document/2,
    non_binding_item/2,
    input_problems/1,
    unknown_key/1,
    wrong_type/1,
    duplicate_key/1,
    accountability_demonstrated/0,
    controller_measures_implemented_and_reviewed/0,
    data_protection_policies_implemented/0,
    by_design_measures_implemented/0,
    by_default_only_necessary_data_processed/0,
    security_level_appropriate_to_risk/0,
    authorised_persons_process_only_on_instructions/0,
    controllers_jointly_determine_purposes_and_means/0,
    responsibilities_set_by_union_or_member_state_law/0,
    arrangement_between_controllers_exists/0,
    arrangement_reflects_roles_and_relationships/0,
    essence_of_arrangement_made_available/0,
    by_default_amount_collected_limited_to_necessary/0,
    by_default_extent_of_processing_limited_to_necessary/0,
    by_default_storage_period_limited_to_necessary/0,
    by_default_accessibility_limited_to_necessary/0,
    by_default_not_accessible_to_indefinite_number_without_intervention/0,
    accountability/0,
    controller_measures/0,
    data_protection_policies/0,
    data_protection_by_design/0,
    data_protection_by_default/0,
    security_of_processing/0,
    processing_on_instructions/0,
    accountability_principles/0,
    security_measures/0,
    unsure/0
]).

:- use_module(eu/data_protection/gdpr_accountability_security/kernel, [gdpr_accountability_security_input_problems/2]).
:- use_module(eu/data_protection/gdpr_accountability_security/gdpr_accountability_security, [gdpr_accountability_security_status/2]).

% ---- result constructors (exported, data only, no clauses) -------------
:- constructors([
    indeterminate(missing_keys),
    needs_legal_review(reason, context),
    open_textured(input, citation),
    cross_reference_unresolved(citation, target),
    resolution(target, resolution),
    inputs_relied_on(pairs),
    provenance(source, detail),
    outside_fact(key, attested),
    attested(value, attestation),
    attestation(by, at, reason, evidence),
    url(location, retrieved_at),
    document(upload_identifier, digest),
    non_binding_item(name, citation),
    input_problems(problems),
    unknown_key(key),
    wrong_type(key),
    duplicate_key(key)
]).

% schema of top-level profile keys: the keys of the order's typed input contract, in its order
gdpr_accountability_security_profile_keys([accountability_demonstrated, controller_measures_implemented_and_reviewed, data_protection_policies_implemented, by_design_measures_implemented, by_default_only_necessary_data_processed, security_level_appropriate_to_risk, authorised_persons_process_only_on_instructions, controllers_jointly_determine_purposes_and_means, responsibilities_set_by_union_or_member_state_law, arrangement_between_controllers_exists, arrangement_reflects_roles_and_relationships, essence_of_arrangement_made_available, by_default_amount_collected_limited_to_necessary, by_default_extent_of_processing_limited_to_necessary, by_default_storage_period_limited_to_necessary, by_default_accessibility_limited_to_necessary, by_default_not_accessible_to_indefinite_number_without_intervention]).

% #16 what-if: re-evaluate with one key hypothetically overridden
gdpr_accountability_security_what_if(Profile, OverriddenKey, NewValue, NewStatus) :-
    override_attribute(Profile, OverriddenKey, NewValue, Hypothesis),
    gdpr_accountability_security_status(Hypothesis, NewStatus).

% override_attribute(Profile, Key, Value, Hypothesis): every item for Key is
% dropped and attribute(Key, Value) is added at the end. Other items are kept
% as they are (a foreign item too, so the input check still sees it).
override_attribute(Profile, Key, Value, Hypothesis) :-
    remove_key(Profile, Key, Kept),
    append(Kept, [attribute(Key, Value)], Hypothesis).

remove_key([], _, []).
remove_key([Element|Elements], Key, Kept) :-
    nonvar(Element),
    Element = attribute(ElementKey, _),
    ElementKey == Key,
    remove_key(Elements, Key, Kept).
remove_key([Element|Elements], Key, [Element|Kept]) :-
    nonvar(Element),
    Element = attribute(ElementKey, _),
    ElementKey \== Key,
    remove_key(Elements, Key, Kept).
remove_key([Element|Elements], Key, [Element|Kept]) :-
    nonvar(Element),
    Element \= attribute(_, _),
    remove_key(Elements, Key, Kept).
remove_key([Element|Elements], Key, [Element|Kept]) :-
    var(Element),
    remove_key(Elements, Key, Kept).

% ---- result atoms (INTERFACE - THE CALLED CONTRACT) -------------------
met.
not_met.
not_joint_controllers.
arrangement_not_required.
arrangement_in_place.
arrangement_missing.
content_requirements_met.
content_requirements_not_met.

% ---- root atoms: the seventeen profile keys, in root_exports order ------
accountability_demonstrated.
controller_measures_implemented_and_reviewed.
data_protection_policies_implemented.
by_design_measures_implemented.
by_default_only_necessary_data_processed.
security_level_appropriate_to_risk.
authorised_persons_process_only_on_instructions.
controllers_jointly_determine_purposes_and_means.
responsibilities_set_by_union_or_member_state_law.
arrangement_between_controllers_exists.
arrangement_reflects_roles_and_relationships.
essence_of_arrangement_made_available.
by_default_amount_collected_limited_to_necessary.
by_default_extent_of_processing_limited_to_necessary.
by_default_storage_period_limited_to_necessary.
by_default_accessibility_limited_to_necessary.
by_default_not_accessible_to_indefinite_number_without_intervention.

% ---- root atoms: the seven duties, the two topics, the judgement value ---
accountability.
controller_measures.
data_protection_policies.
data_protection_by_design.
data_protection_by_default.
security_of_processing.
processing_on_instructions.
accountability_principles.
security_measures.
unsure.

:- end_module(queries).
