% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/data_protection/gdpr_accountability_security.
%
% Source: Regulation (EU) 2016/679 (GDPR), consolidated text 02016R0679-20160504
% (fmx4 cut by tools/pin_statute.py, fetched 2026-11-11). Keys are the CANONICAL
% lexicon keys (_lexicon/citations.yaml); never shortened.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% Each verbatim is an exact substring of the pinned unit text.
%
% A clause cites a key with a cite(Key) term; cite(...) is data and needs no
% import. Every operative clause opens its body with implements(Key).
%
% REFERRAL TARGETS: the eight outside statements a cross_reference_unresolved
% referral points to (cite(TARGET)). They are statements supplied by a human or
% another system, not statutory text, so each record is unverified and carries
% no verbatim.
%
% Deferred, pinned but not recorded (no limb reads them): Art 24(3), 25(3),
% 26(3), 32(3).
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

% implements(Key): the provenance marker; succeeds exactly for a recorded key.
implements(Key) :-
    citation(Key, _).

% ---- Art 5(1): principles (non-binding items, reported only) ----
citation(eu_reg_2016_679_art_5_1_a, [label-'Regulation (EU) 2016/679 (GDPR) Art 5(1)(a) lawfulness, fairness and transparency', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'processed lawfully, fairly and in a transparent manner in relation to the data subject (lawfulness, fairness and transparency)']).
citation(eu_reg_2016_679_art_5_1_b, [label-'Regulation (EU) 2016/679 (GDPR) Art 5(1)(b) purpose limitation', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'collected for specified, explicit and legitimate purposes and not further processed in a manner that is incompatible with those purposes']).
citation(eu_reg_2016_679_art_5_1_c, [label-'Regulation (EU) 2016/679 (GDPR) Art 5(1)(c) data minimisation', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'adequate, relevant and limited to what is necessary in relation to the purposes for which they are processed (data minimisation)']).
citation(eu_reg_2016_679_art_5_1_d, [label-'Regulation (EU) 2016/679 (GDPR) Art 5(1)(d) accuracy', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'accurate and, where necessary, kept up to date']).
citation(eu_reg_2016_679_art_5_1_e, [label-'Regulation (EU) 2016/679 (GDPR) Art 5(1)(e) storage limitation', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'kept in a form which permits identification of data subjects for no longer than is necessary for the purposes for which the personal data are processed']).
citation(eu_reg_2016_679_art_5_1_f, [label-'Regulation (EU) 2016/679 (GDPR) Art 5(1)(f) integrity and confidentiality', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'processed in a manner that ensures appropriate security of the personal data']).

% ---- Art 5(2): accountability (duty accountability) ----
citation(eu_reg_2016_679_art_5_2, [label-'Regulation (EU) 2016/679 (GDPR) Art 5(2) accountability', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'The controller shall be responsible for, and be able to demonstrate compliance with, paragraph 1 (accountability).']).

% ---- Art 24: responsibility of the controller ----
citation(eu_reg_2016_679_art_24_1, [label-'Regulation (EU) 2016/679 (GDPR) Art 24(1) technical and organisational measures of the controller, reviewed and updated', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'the controller shall implement appropriate technical and organisational measures to ensure and to be able to demonstrate that processing is performed in accordance with this Regulation. Those measures shall be reviewed and updated where necessary.']).
citation(eu_reg_2016_679_art_24_2, [label-'Regulation (EU) 2016/679 (GDPR) Art 24(2) data protection policies where proportionate', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'Where proportionate in relation to processing activities, the measures referred to in paragraph 1 shall include the implementation of appropriate data protection policies by the controller.']).

% ---- Art 25: data protection by design and by default ----
citation(eu_reg_2016_679_art_25_1, [label-'Regulation (EU) 2016/679 (GDPR) Art 25(1) data protection by design', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'implement appropriate technical and organisational measures, such as pseudonymisation, which are designed to implement data-protection principles']).
citation(eu_reg_2016_679_art_25_2, [label-'Regulation (EU) 2016/679 (GDPR) Art 25(2) data protection by default', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'only personal data which are necessary for each specific purpose of the processing are processed. That obligation applies to the amount of personal data collected, the extent of their processing, the period of their storage and their accessibility.']).

% ---- Art 26: joint controllers ----
citation(eu_reg_2016_679_art_26_1, [label-'Regulation (EU) 2016/679 (GDPR) Art 26(1) joint controllers and their arrangement', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'Where two or more controllers jointly determine the purposes and means of processing, they shall be joint controllers.']).
citation(eu_reg_2016_679_art_26_2, [label-'Regulation (EU) 2016/679 (GDPR) Art 26(2) content of the joint-controller arrangement and its essence made available', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'The essence of the arrangement shall be made available to the data subject.']).

% ---- Art 32: security of processing ----
citation(eu_reg_2016_679_art_32_1, [label-'Regulation (EU) 2016/679 (GDPR) Art 32(1) level of security appropriate to the risk', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'the controller and the processor shall implement appropriate technical and organisational measures to ensure a level of security appropriate to the risk']).
citation(eu_reg_2016_679_art_32_1_a, [label-'Regulation (EU) 2016/679 (GDPR) Art 32(1)(a) pseudonymisation and encryption', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'the pseudonymisation and encryption of personal data']).
citation(eu_reg_2016_679_art_32_1_b, [label-'Regulation (EU) 2016/679 (GDPR) Art 32(1)(b) confidentiality, integrity, availability and resilience', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'the ability to ensure the ongoing confidentiality, integrity, availability and resilience of processing systems and services']).
citation(eu_reg_2016_679_art_32_1_c, [label-'Regulation (EU) 2016/679 (GDPR) Art 32(1)(c) restoring availability and access', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'the ability to restore the availability and access to personal data in a timely manner in the event of a physical or technical incident']).
citation(eu_reg_2016_679_art_32_1_d, [label-'Regulation (EU) 2016/679 (GDPR) Art 32(1)(d) regular testing, assessing and evaluating', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'a process for regularly testing, assessing and evaluating the effectiveness of technical and organisational measures for ensuring the security of the processing']).
citation(eu_reg_2016_679_art_32_2, [label-'Regulation (EU) 2016/679 (GDPR) Art 32(2) risks taken into account in assessing the level of security', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'In assessing the appropriate level of security account shall be taken in particular of the risks that are presented by processing']).
citation(eu_reg_2016_679_art_32_4, [label-'Regulation (EU) 2016/679 (GDPR) Art 32(4) processing only on instructions of the controller', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'any natural person acting under the authority of the controller or the processor who has access to personal data does not process them except on instructions from the controller']).

% ---- Referral targets: the outside statements (unverified, no verbatim) ----
citation(controller_compliance_demonstration, [label-'Regulation (EU) 2016/679 (GDPR) Art 5(2) outside statement accountability_demonstrated (referral target)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504']).
citation(controller_measures_statement, [label-'Regulation (EU) 2016/679 (GDPR) Art 24(1) outside statement controller_measures_implemented_and_reviewed (referral target)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504']).
citation(data_protection_policies_statement, [label-'Regulation (EU) 2016/679 (GDPR) Art 24(2) outside statement data_protection_policies_implemented (referral target)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504']).
citation(by_design_measures_statement, [label-'Regulation (EU) 2016/679 (GDPR) Art 25(1) outside statement by_design_measures_implemented (referral target)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504']).
citation(by_default_necessity_statement, [label-'Regulation (EU) 2016/679 (GDPR) Art 25(2) outside statement by_default_only_necessary_data_processed (referral target)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504']).
citation(security_level_statement, [label-'Regulation (EU) 2016/679 (GDPR) Art 32(1) and (2) outside statement security_level_appropriate_to_risk (referral target)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504']).
citation(processing_instructions_statement, [label-'Regulation (EU) 2016/679 (GDPR) Art 32(4) outside statement authorised_persons_process_only_on_instructions (referral target)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504']).
citation(arrangement_roles_statement, [label-'Regulation (EU) 2016/679 (GDPR) Art 26(2) first sentence outside statement arrangement_reflects_roles_and_relationships (referral target)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504']).

:- end_module(citations).
