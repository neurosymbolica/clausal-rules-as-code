% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% fixtures.clausal -- representative subjects for eu/data_protection/gdpr_arts33_34_breach_notification.
% A TOP-LAYER consumer: it imports only the slice's PUBLIC predicate it calls.
% Profile keys and subject ids are atoms and need no import.
%
% A profile is an ATTRIBUTE LIST [attribute(Key, Value), ...]. Each subject is
% breach_fixture(Subject, Profile, HoursElapsed); its case is
% case(Profile, HoursElapsed), the case of the slice facade. Each route of
% breach_notification_verdict/4 has a positive subject and a one-unit
% near-miss control:
% - timely_at_the_period_end (72 hours, eligible) and
%   late_one_hour_past_without_reasons (73 hours, no reasons for the delay,
%   notification_requirement_not_met(reasons_for_delay));
% - unlikely_risk_notified_late (ineligible) and
%   risk_notified_late_with_justified_reasons (J1 false, eligible);
% - late_with_unjustified_reasons (justified false, a referral);
% - notified_inside_the_period_without_undue_delay (eligible) and
%   notified_inside_the_period_with_undue_delay
%   (notification_requirement_not_met(without_undue_delay));
% - risk_judgement_missing (indeterminate) and risk_judgement_unsure (a
%   referral on J1);
% - negative_hours_elapsed and contradictory_risk_judgements (input problems).
% =====================================================================

:- module(fixtures, [
    gdpr_arts33_34_breach_notification_subject/1,
    gdpr_arts33_34_breach_notification_profile_for/2,
    gdpr_arts33_34_breach_notification_assess/2
]).

:- use_module(eu/data_protection/gdpr_arts33_34_breach_notification/breach_notification_verdict, [decide_breach_notification_verdict/2]).

% ---- Subjects: profile and hours elapsed -----------------------------
% The 72-hour boundary: at 72 hours the reasons key is not read, so it is
% left out (a stated false would make a probe that sets
% delay_justified_by_reasons true a contradictory pair of reading (8)).
breach_fixture(timely_at_the_period_end, [
    attribute(party_role, controller),
    attribute(breach_unlikely_to_result_in_risk, false),
    attribute(notification_made_without_undue_delay, true)
], 72).
% Near miss: one hour later, with no reasons for the delay.
breach_fixture(late_one_hour_past_without_reasons, [
    attribute(party_role, controller),
    attribute(breach_unlikely_to_result_in_risk, false),
    attribute(notification_made_without_undue_delay, true),
    attribute(notification_accompanied_by_reasons_for_delay, false)
], 73).
% J1 true: no Art 33(1) duty, whatever the hours.
breach_fixture(unlikely_risk_notified_late, [
    attribute(party_role, controller),
    attribute(breach_unlikely_to_result_in_risk, true),
    attribute(notification_accompanied_by_reasons_for_delay, true),
    attribute(delay_justified_by_reasons, true)
], 100).
% Near miss: J1 false, the reasons justify the delay.
breach_fixture(risk_notified_late_with_justified_reasons, [
    attribute(party_role, controller),
    attribute(breach_unlikely_to_result_in_risk, false),
    attribute(notification_accompanied_by_reasons_for_delay, true),
    attribute(delay_justified_by_reasons, true)
], 100).
% The reasons do not justify the delay: never ineligible, a referral.
breach_fixture(late_with_unjustified_reasons, [
    attribute(party_role, controller),
    attribute(breach_unlikely_to_result_in_risk, false),
    attribute(notification_accompanied_by_reasons_for_delay, true),
    attribute(delay_justified_by_reasons, false)
], 100).
% Inside the period, without undue delay.
breach_fixture(notified_inside_the_period_without_undue_delay, [
    attribute(party_role, controller),
    attribute(breach_unlikely_to_result_in_risk, false),
    attribute(notification_made_without_undue_delay, true)
], 10).
% Near miss: inside the period, but unduly delayed (reading (4)).
breach_fixture(notified_inside_the_period_with_undue_delay, [
    attribute(party_role, controller),
    attribute(breach_unlikely_to_result_in_risk, false),
    attribute(notification_made_without_undue_delay, false)
], 10).
% The always needed judgement is absent.
breach_fixture(risk_judgement_missing, [
    attribute(party_role, controller),
    attribute(notification_made_without_undue_delay, true)
], 10).
% Near miss: the judgement is present but unsure.
breach_fixture(risk_judgement_unsure, [
    attribute(party_role, controller),
    attribute(breach_unlikely_to_result_in_risk, unsure),
    attribute(notification_made_without_undue_delay, true)
], 10).
% Input problems: a negative argument, and the contradictory risk pair.
breach_fixture(negative_hours_elapsed, [
    attribute(party_role, controller),
    attribute(breach_unlikely_to_result_in_risk, false),
    attribute(notification_made_without_undue_delay, true)
], -1).
breach_fixture(contradictory_risk_judgements, [
    attribute(party_role, controller),
    attribute(breach_unlikely_to_result_in_risk, true),
    attribute(breach_likely_to_result_in_high_risk, true)
], 10).

% ---- Subject registry ------------------------------------------------
gdpr_arts33_34_breach_notification_subject(Subject) :-
    breach_fixture(Subject, _, _).

% ---- Profiles --------------------------------------------------------
gdpr_arts33_34_breach_notification_profile_for(Subject, Profile) :-
    breach_fixture(Subject, Profile, _).

% ---- Convenience wrapper ---------------------------------------------
gdpr_arts33_34_breach_notification_assess(Subject, Result) :-
    breach_fixture(Subject, Profile, HoursElapsed),
    decide_breach_notification_verdict(case(Profile, HoursElapsed), Result).

:- end_module(fixtures).
