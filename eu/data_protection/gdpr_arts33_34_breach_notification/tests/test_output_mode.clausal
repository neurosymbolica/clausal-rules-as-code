% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_output_mode.clausal -- OUTPUT MODE: the result argument unbound and
% read out, at every route boundary (72 / 73 hours, month ends, leap days,
% the end of the date range) and for every answer form. Each query yields
% exactly ONE solution (COUNTING).
% Run: python -m clausal.testing eu/data_protection/gdpr_arts33_34_breach_notification/tests/test_output_mode.clausal
% =====================================================================
:- module(test_output_mode, []).
:- use_module(eu/data_protection/gdpr_arts33_34_breach_notification/breach_notification_verdict, [
    decide_breach_notification_verdict/2,
    breach_notification_verdict/4,
    notification_obligation/2,
    authority_notification_deadline/3,
    authority_notification_period_end/3,
    authority_notification_content_check/2,
    data_subject_communication_check/2
]).

% ---- breach_notification_verdict/4 -----------------------------------------
test(at_zero_hours_without_undue_delay_is_eligible) :-
    breach_notification_verdict([attribute(breach_unlikely_to_result_in_risk, false), attribute(notification_made_without_undue_delay, true)], 0, Verdict, Citations),
    Verdict == eligible,
    Citations == [cite(eu_reg_2016_679_art_33_1)].
test(at_72_hours_is_inside_the_period) :-
    findall(Verdict, breach_notification_verdict([attribute(breach_unlikely_to_result_in_risk, false), attribute(notification_made_without_undue_delay, true)], 72, Verdict, _), Verdicts),
    Verdicts == [eligible].
test(at_73_hours_the_reasons_key_is_read) :-
    findall(Verdict-Citations, breach_notification_verdict([attribute(breach_unlikely_to_result_in_risk, false), attribute(notification_made_without_undue_delay, true)], 73, Verdict, Citations), Answers),
    Answers == [indeterminate([notification_accompanied_by_reasons_for_delay])-[]].
test(an_unsure_undue_delay_refers_with_the_timing_context) :-
    breach_notification_verdict([attribute(breach_unlikely_to_result_in_risk, false), attribute(notification_made_without_undue_delay, unsure)], 40, Verdict, Citations),
    Verdict == needs_legal_review(open_textured(notification_made_without_undue_delay, cite(eu_reg_2016_679_art_33_1)), [inputs_relied_on([hours_elapsed-40, breach_unlikely_to_result_in_risk-false, notification_made_without_undue_delay-unsure])]),
    Citations == [].
test(an_unsure_risk_refers_inside_the_period) :-
    breach_notification_verdict([attribute(breach_unlikely_to_result_in_risk, unsure), attribute(notification_made_without_undue_delay, true)], 10, Verdict, Citations),
    Verdict = needs_legal_review(open_textured(breach_unlikely_to_result_in_risk, cite(eu_reg_2016_679_art_33_1)), [inputs_relied_on([breach_unlikely_to_result_in_risk-unsure])|_]),
    Citations == [].
test(an_absent_justification_is_named) :-
    breach_notification_verdict([attribute(breach_unlikely_to_result_in_risk, unsure), attribute(notification_accompanied_by_reasons_for_delay, true)], 80, Verdict, _),
    Verdict == indeterminate([delay_justified_by_reasons]).
test(an_unsure_justification_refers_with_the_timing_context) :-
    breach_notification_verdict([attribute(breach_unlikely_to_result_in_risk, false), attribute(notification_accompanied_by_reasons_for_delay, true), attribute(delay_justified_by_reasons, unsure)], 90, Verdict, _),
    Verdict == needs_legal_review(open_textured(delay_justified_by_reasons, cite(eu_reg_2016_679_art_33_1)), [inputs_relied_on([hours_elapsed-90, breach_unlikely_to_result_in_risk-false, delay_justified_by_reasons-unsure])]).
test(the_facade_carries_the_citation) :-
    decide_breach_notification_verdict(case([attribute(breach_unlikely_to_result_in_risk, true)], 5), breach_notification_verdict_verdict(Status, Citations)),
    Status == ineligible,
    Citations == [cite(eu_reg_2016_679_art_33_1)].

% ---- authority_notification_deadline/3 and period_end/3 -------------------
test(the_deadline_crosses_a_month_end) :-
    findall(Deadline-Hours, authority_notification_deadline(date(2025, 10, 31), Deadline, Hours), [Deadline-Hours]),
    Deadline = date(2025, 11, 3),
    Hours == 72.
test(the_deadline_lands_on_a_leap_day) :-
    authority_notification_deadline(date(2032, 2, 26), Deadline, _),
    Deadline = date(2032, 2, 29).
test(the_deadline_crosses_a_year_end) :-
    authority_notification_deadline(date(2025, 12, 30), Deadline, _),
    Deadline = date(2026, 1, 2).
test(the_deadline_is_never_shifted_for_a_weekend) :-
    authority_notification_deadline(date(2026, 11, 18), Deadline, _),
    Deadline = date(2026, 11, 21).
test(the_last_awareness_day_in_range_has_a_deadline) :-
    authority_notification_deadline(date(9999, 12, 28), Deadline, _),
    Deadline = date(9999, 12, 31).
test(the_end_of_the_range_is_wrong_type) :-
    authority_notification_deadline(date(9999, 12, 31), Deadline, Hours),
    Deadline == input_problems([wrong_type(awareness_date)]),
    Hours == 72.
test(awareness_at_ten_ends_at_eleven) :-
    findall(PeriodEnd, authority_notification_period_end(date(2025, 10, 31), 10, PeriodEnd), [PeriodEnd]),
    PeriodEnd = period_end(date(2025, 11, 3), EndHour),
    EndHour == 11.
test(awareness_at_midnight_ends_at_one) :-
    authority_notification_period_end(date(2032, 2, 27), 0, PeriodEnd),
    PeriodEnd = period_end(date(2032, 3, 1), EndHour),
    EndHour == 1.
test(awareness_in_the_last_hour_ends_at_the_end_of_the_day) :-
    authority_notification_period_end(date(2025, 12, 30), 23, PeriodEnd),
    PeriodEnd = period_end(date(2026, 1, 2), EndHour),
    EndHour == 24.

% ---- notification_obligation/2 ---------------------------------------------
test(a_present_no_decision_shows_no_default) :-
    findall(Obligation, notification_obligation([attribute(party_role, controller), attribute(breach_unlikely_to_result_in_risk, true), attribute(supervisory_authority_decision_on_communication, no_decision)], Obligation), Obligations),
    Obligations == [[no_notification_required(cite(eu_reg_2016_679_art_33_1)), document_breach(cite(eu_reg_2016_679_art_33_5)), no_communication_required(cite(eu_reg_2016_679_art_34_1))]].
test(no_high_risk_gives_no_communication_with_the_default_shown) :-
    notification_obligation([attribute(party_role, controller), attribute(breach_unlikely_to_result_in_risk, false), attribute(breach_likely_to_result_in_high_risk, false)], Obligation),
    Obligation == [notify_supervisory_authority(cite(eu_reg_2016_679_art_33_1)), document_breach(cite(eu_reg_2016_679_art_33_5)), no_communication_required(cite(eu_reg_2016_679_art_34_1)), inputs_relied_on([supervisory_authority_decision_on_communication-no_decision])].
test(point_a_decides_the_exemption) :-
    notification_obligation([attribute(party_role, controller), attribute(breach_unlikely_to_result_in_risk, false), attribute(breach_likely_to_result_in_high_risk, true), attribute(appropriate_protection_measures_applied_to_affected_data, true)], Obligation),
    Obligation == [notify_supervisory_authority(cite(eu_reg_2016_679_art_33_1)), document_breach(cite(eu_reg_2016_679_art_33_5)), no_communication_required(cite(eu_reg_2016_679_art_34_3_a)), inputs_relied_on([supervisory_authority_decision_on_communication-no_decision])].
test(point_b_decides_while_point_a_is_absent) :-
    notification_obligation([attribute(party_role, controller), attribute(breach_unlikely_to_result_in_risk, false), attribute(breach_likely_to_result_in_high_risk, true), attribute(subsequent_measures_ensure_high_risk_no_longer_likely, true)], Obligation),
    Obligation == [notify_supervisory_authority(cite(eu_reg_2016_679_art_33_1)), document_breach(cite(eu_reg_2016_679_art_33_5)), no_communication_required(cite(eu_reg_2016_679_art_34_3_b)), inputs_relied_on([supervisory_authority_decision_on_communication-no_decision])].
test(an_absent_high_risk_judgement_is_named_alone) :-
    notification_obligation([attribute(party_role, controller), attribute(breach_unlikely_to_result_in_risk, false)], Obligation),
    Obligation == indeterminate([breach_likely_to_result_in_high_risk]).
test(an_unsure_high_risk_refers_with_the_default_pair) :-
    notification_obligation([attribute(party_role, controller), attribute(breach_unlikely_to_result_in_risk, false), attribute(breach_likely_to_result_in_high_risk, unsure), attribute(appropriate_protection_measures_applied_to_affected_data, false), attribute(subsequent_measures_ensure_high_risk_no_longer_likely, false), attribute(communication_would_involve_disproportionate_effort, false)], Obligation),
    Obligation == needs_legal_review(open_textured(breach_likely_to_result_in_high_risk, cite(eu_reg_2016_679_art_34_1)), [inputs_relied_on([breach_unlikely_to_result_in_risk-false, breach_likely_to_result_in_high_risk-unsure, supervisory_authority_decision_on_communication-no_decision])]).
test(an_unsure_effort_refers_with_every_pair_read) :-
    notification_obligation([attribute(party_role, controller), attribute(breach_unlikely_to_result_in_risk, false), attribute(breach_likely_to_result_in_high_risk, true), attribute(appropriate_protection_measures_applied_to_affected_data, false), attribute(subsequent_measures_ensure_high_risk_no_longer_likely, false), attribute(communication_would_involve_disproportionate_effort, unsure)], Obligation),
    Obligation == needs_legal_review(open_textured(communication_would_involve_disproportionate_effort, cite(eu_reg_2016_679_art_34_3_c)), [inputs_relied_on([breach_unlikely_to_result_in_risk-false, breach_likely_to_result_in_high_risk-true, supervisory_authority_decision_on_communication-no_decision, appropriate_protection_measures_applied_to_affected_data-false, subsequent_measures_ensure_high_risk_no_longer_likely-false, communication_would_involve_disproportionate_effort-unsure])]).
test(a_decision_on_point_c_governs) :-
    notification_obligation([attribute(party_role, controller), attribute(breach_unlikely_to_result_in_risk, false), attribute(supervisory_authority_decision_on_communication, decided_point_c_condition_met)], Obligation),
    Obligation == [notify_supervisory_authority(cite(eu_reg_2016_679_art_33_1)), document_breach(cite(eu_reg_2016_679_art_33_5)), public_communication_or_similar_measure(cite(eu_reg_2016_679_art_34_4))].
test(an_unsure_risk_under_a_decision_carries_no_default_pair) :-
    notification_obligation([attribute(party_role, controller), attribute(breach_unlikely_to_result_in_risk, unsure), attribute(supervisory_authority_decision_on_communication, required_communication)], Obligation),
    Obligation == needs_legal_review(open_textured(breach_unlikely_to_result_in_risk, cite(eu_reg_2016_679_art_33_1)), [inputs_relied_on([breach_unlikely_to_result_in_risk-unsure])]).

% ---- content checks --------------------------------------------------------
test(missing_items_without_phases_are_not_met) :-
    authority_notification_content_check([attribute(notification_describes_nature_of_breach, true), attribute(notification_gives_categories_and_approximate_numbers, true), attribute(notification_gives_contact_point, false), attribute(notification_describes_likely_consequences, true), attribute(notification_describes_measures_taken_or_proposed, true), attribute(notification_describes_mitigation_measures, true), attribute(information_not_possible_to_provide_at_the_same_time, false)], Result),
    Result == requirements_not_met([contact_point]).
test(a_missing_mitigation_is_not_met_in_the_communication) :-
    data_subject_communication_check([attribute(communication_made_without_undue_delay, true), attribute(communication_describes_nature_in_clear_and_plain_language, true), attribute(communication_gives_contact_point, true), attribute(communication_describes_likely_consequences, true), attribute(communication_describes_measures_taken_or_proposed, true), attribute(communication_describes_mitigation_measures, false), attribute(mitigation_measures_appropriate, true)], Result),
    Result == requirements_not_met([mitigation_measures]).
test(an_unsure_communication_delay_refers) :-
    data_subject_communication_check([attribute(communication_made_without_undue_delay, unsure), attribute(communication_describes_nature_in_clear_and_plain_language, true), attribute(communication_gives_contact_point, true), attribute(communication_describes_likely_consequences, true), attribute(communication_describes_measures_taken_or_proposed, true), attribute(communication_describes_mitigation_measures, true)], Result),
    Result == needs_legal_review(open_textured(communication_made_without_undue_delay, cite(eu_reg_2016_679_art_34_1)), [inputs_relied_on([communication_made_without_undue_delay-unsure])]).
test(absent_communication_keys_are_all_named) :-
    data_subject_communication_check([attribute(communication_made_without_undue_delay, true)], Result),
    Result == indeterminate([communication_describes_nature_in_clear_and_plain_language, communication_gives_contact_point, communication_describes_likely_consequences, communication_describes_measures_taken_or_proposed, communication_describes_mitigation_measures]).

:- end_module(test_output_mode).
