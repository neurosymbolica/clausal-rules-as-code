% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% fixtures.clausal -- representative profiles for eu/data_protection/gdpr_data_subject_rights_articles_15_to_18_decision_and_exception.
% A TOP-LAYER consumer: imports only the slice predicate it calls.
%
% A profile is an attribute list [attribute(Key, Value), ...] (the order's
% INTERFACE - THE PROFILE); outside facts are attested(Value,
% attestation(by, at, reason, none)).
%
% Every route has a positive subject and a ONE-UNIT near-miss control
% (one key added, removed or flipped) that gets a different verdict: each
% BASIS, each EXCEPTION, the suspension, each referral kind, the missing-key
% route and each input-problem kind. The expected verdicts live in
% tests/test_public_interface.clausal.
% =====================================================================

:- module(fixtures, [
    gdpr_data_subject_rights_articles_15_to_18_decision_and_exception_subject/1,
    gdpr_data_subject_rights_articles_15_to_18_decision_and_exception_profile_for/2,
    gdpr_data_subject_rights_articles_15_to_18_decision_and_exception_assess/2
]).

:- use_module(eu/data_protection/gdpr_data_subject_rights_articles_15_to_18_decision_and_exception/request_exception, [decide_request_exception/2]).

% ---- Subject registry: every subject with a profile, once -------------
gdpr_data_subject_rights_articles_15_to_18_decision_and_exception_subject(Subject) :-
    subject_profile(Subject, _).

gdpr_data_subject_rights_articles_15_to_18_decision_and_exception_profile_for(Subject, Profile) :-
    subject_profile(Subject, Profile).

% ---- Building blocks ------------------------------------------------------
attested_fact(Value, attested(Value, attestation(by, at, reason, none))).

% The Art 17(1) ground keys of an erasure request (the outside fact of
% point (e) is added by each subject).
erasure_ground_items(NoLongerNecessary,
                     ConsentBasis,
                     ConsentWithdrawn,
                     OtherGround,
                     DirectMarketingObjection,
                     [attribute(request_type, erasure),
                      attribute(data_no_longer_necessary_for_purposes, NoLongerNecessary),
                      attribute(consent_is_the_basis_of_processing, ConsentBasis),
                      attribute(consent_withdrawn, ConsentWithdrawn),
                      attribute(other_legal_ground_for_processing_exists, OtherGround),
                      attribute(objection_under_art21_1_made, false),
                      attribute(objection_under_art21_2_made, DirectMarketingObjection),
                      attribute(personal_data_unlawfully_processed, false),
                      attribute(collected_in_relation_to_information_society_services_offer, false)]).

erasure_with_law(NoLongerNecessary, ConsentBasis, ConsentWithdrawn, OtherGround, DirectMarketingObjection, LawValue, Profile) :-
    erasure_ground_items(NoLongerNecessary, ConsentBasis, ConsentWithdrawn, OtherGround, DirectMarketingObjection, Items),
    attested_fact(LawValue, Attested),
    append(Items, [attribute(erasure_required_by_union_or_member_state_law, Attested)], Profile).

% ---- Access (Art 15(1)) and the common limbs ----------------------------
subject_profile(access_request, [attribute(request_type, access)]).
subject_profile(access_request_manifestly_unfounded, [attribute(request_type, access), attribute(request_manifestly_unfounded_or_excessive, true)]).
subject_profile(access_request_not_manifestly_unfounded, [attribute(request_type, access), attribute(request_manifestly_unfounded_or_excessive, false)]).
subject_profile(access_request_controller_cannot_identify, [attribute(request_type, access), attribute(controller_demonstrates_unable_to_identify_data_subject, true)]).
subject_profile(access_request_controller_can_identify, [attribute(request_type, access), attribute(controller_demonstrates_unable_to_identify_data_subject, false)]).
subject_profile(access_request_legislative_restriction, [attribute(request_type, access), attribute(legislative_restriction_applies_to_the_right, Attested)]) :-
    attested_fact(true, Attested).
subject_profile(access_request_no_legislative_restriction, [attribute(request_type, access), attribute(legislative_restriction_applies_to_the_right, Attested)]) :-
    attested_fact(false, Attested).
subject_profile(access_request_identity_unconfirmed, [attribute(request_type, access), attribute(reasonable_doubts_about_identity, true), attribute(identity_confirmed, false)]).
subject_profile(access_request_identity_confirmed, [attribute(request_type, access), attribute(reasonable_doubts_about_identity, true), attribute(identity_confirmed, true)]).
subject_profile(access_request_identity_doubts_unsure, [attribute(request_type, access), attribute(reasonable_doubts_about_identity, unsure), attribute(identity_confirmed, false)]).
subject_profile(access_request_identity_not_confirmed_without_doubts, [attribute(request_type, access), attribute(identity_confirmed, false)]).

% ---- Request type absent and input problems -----------------------------
subject_profile(request_type_not_given, []).
subject_profile(access_request_unknown_key, [attribute(request_type, access), attribute(favourite_colour, blue)]).
subject_profile(access_request_wrong_type, [attribute(request_type, access), attribute(identity_confirmed, unsure)]).
subject_profile(access_request_duplicate_key, [attribute(request_type, access), attribute(request_type, access)]).
subject_profile(profile_not_an_attribute_list, not_a_profile).

% ---- Rectification (Art 16) ---------------------------------------------
subject_profile(rectification_inaccurate_data, [attribute(request_type, rectification), attribute(personal_data_inaccurate, true), attribute(personal_data_incomplete_in_light_of_purposes, false)]).
subject_profile(rectification_incomplete_data, [attribute(request_type, rectification), attribute(personal_data_inaccurate, false), attribute(personal_data_incomplete_in_light_of_purposes, true)]).
subject_profile(rectification_accurate_and_complete_data, [attribute(request_type, rectification), attribute(personal_data_inaccurate, false), attribute(personal_data_incomplete_in_light_of_purposes, false)]).
subject_profile(rectification_completeness_unsure, [attribute(request_type, rectification), attribute(personal_data_inaccurate, false), attribute(personal_data_incomplete_in_light_of_purposes, unsure)]).

% ---- Erasure grounds (Art 17(1)) ----------------------------------------
subject_profile(erasure_facts_missing, [attribute(request_type, erasure)]).
subject_profile(erasure_data_no_longer_necessary, [attribute(request_type, erasure), attribute(data_no_longer_necessary_for_purposes, true)]).
subject_profile(erasure_no_ground, Profile) :-
    erasure_with_law(false, false, false, false, false, false, Profile).
subject_profile(erasure_no_ground_law_not_attested, Profile) :-
    erasure_ground_items(false, false, false, false, false, Profile).
subject_profile(erasure_required_by_law, Profile) :-
    erasure_with_law(false, false, false, false, false, true, Profile).
subject_profile(erasure_consent_withdrawn, Profile) :-
    erasure_with_law(false, true, true, false, false, false, Profile).
subject_profile(erasure_consent_withdrawn_other_ground, Profile) :-
    erasure_with_law(false, true, true, true, false, false, Profile).
subject_profile(erasure_objection_direct_marketing, Profile) :-
    erasure_with_law(false, false, false, false, true, false, Profile).
subject_profile(erasure_ground_unsure, Profile) :-
    erasure_with_law(unsure, false, false, false, false, false, Profile).

% ---- Erasure exceptions (Art 17(3)) -------------------------------------
subject_profile(erasure_freedom_of_expression, [attribute(request_type, erasure), attribute(data_no_longer_necessary_for_purposes, true), attribute(processing_necessary_for_freedom_of_expression_and_information, true)]).
subject_profile(erasure_freedom_of_expression_not_necessary, [attribute(request_type, erasure), attribute(data_no_longer_necessary_for_purposes, true), attribute(processing_necessary_for_freedom_of_expression_and_information, false)]).
subject_profile(erasure_public_task, [attribute(request_type, erasure), attribute(data_no_longer_necessary_for_purposes, true), attribute(processing_necessary_for_public_task_or_official_authority, true)]).
subject_profile(erasure_public_task_not_necessary, [attribute(request_type, erasure), attribute(data_no_longer_necessary_for_purposes, true), attribute(processing_necessary_for_public_task_or_official_authority, false)]).
subject_profile(erasure_law_requires_processing, [attribute(request_type, erasure), attribute(data_no_longer_necessary_for_purposes, true), attribute(processing_required_by_union_or_member_state_law, Attested)]) :-
    attested_fact(true, Attested).
subject_profile(erasure_law_does_not_require_processing, [attribute(request_type, erasure), attribute(data_no_longer_necessary_for_purposes, true), attribute(processing_required_by_union_or_member_state_law, Attested)]) :-
    attested_fact(false, Attested).
subject_profile(erasure_public_health, [attribute(request_type, erasure), attribute(data_no_longer_necessary_for_purposes, true), attribute(processing_necessary_for_public_health_in_accordance_with_art9_2_h_and_i, true)]).
subject_profile(erasure_public_health_not_necessary, [attribute(request_type, erasure), attribute(data_no_longer_necessary_for_purposes, true), attribute(processing_necessary_for_public_health_in_accordance_with_art9_2_h_and_i, false)]).
subject_profile(erasure_archiving_impairs_objectives, [attribute(request_type, erasure), attribute(data_no_longer_necessary_for_purposes, true), attribute(processing_for_archiving_research_or_statistics_in_accordance_with_art89_1, true), attribute(erasure_would_render_impossible_or_seriously_impair_processing_objectives, true)]).
subject_profile(erasure_archiving_without_impairment, [attribute(request_type, erasure), attribute(data_no_longer_necessary_for_purposes, true), attribute(processing_for_archiving_research_or_statistics_in_accordance_with_art89_1, true), attribute(erasure_would_render_impossible_or_seriously_impair_processing_objectives, false)]).
subject_profile(erasure_legal_claims, [attribute(request_type, erasure), attribute(data_no_longer_necessary_for_purposes, true), attribute(processing_necessary_for_legal_claims, true)]).
subject_profile(erasure_legal_claims_not_necessary, [attribute(request_type, erasure), attribute(data_no_longer_necessary_for_purposes, true), attribute(processing_necessary_for_legal_claims, false)]).

% ---- Restriction (Art 18(1)) ---------------------------------------------
subject_profile(restriction_accuracy_contested, [attribute(request_type, restriction), attribute(accuracy_contested_by_data_subject, true), attribute(personal_data_unlawfully_processed, false), attribute(controller_no_longer_needs_data_for_processing_purposes, false), attribute(objection_under_art21_1_made, false)]).
subject_profile(restriction_no_situation, [attribute(request_type, restriction), attribute(accuracy_contested_by_data_subject, false), attribute(personal_data_unlawfully_processed, false), attribute(controller_no_longer_needs_data_for_processing_purposes, false), attribute(objection_under_art21_1_made, false)]).
subject_profile(restriction_legal_claims, [attribute(request_type, restriction), attribute(accuracy_contested_by_data_subject, false), attribute(personal_data_unlawfully_processed, false), attribute(controller_no_longer_needs_data_for_processing_purposes, true), attribute(data_required_by_data_subject_for_legal_claims, true), attribute(objection_under_art21_1_made, false)]).
subject_profile(restriction_legal_claims_not_required, [attribute(request_type, restriction), attribute(accuracy_contested_by_data_subject, false), attribute(personal_data_unlawfully_processed, false), attribute(controller_no_longer_needs_data_for_processing_purposes, true), attribute(data_required_by_data_subject_for_legal_claims, false), attribute(objection_under_art21_1_made, false)]).
subject_profile(restriction_objection_pending_verification, [attribute(request_type, restriction), attribute(accuracy_contested_by_data_subject, false), attribute(personal_data_unlawfully_processed, false), attribute(controller_no_longer_needs_data_for_processing_purposes, false), attribute(objection_under_art21_1_made, true), attribute(verification_of_overriding_grounds_pending, true)]).
subject_profile(restriction_objection_verification_done, [attribute(request_type, restriction), attribute(accuracy_contested_by_data_subject, false), attribute(personal_data_unlawfully_processed, false), attribute(controller_no_longer_needs_data_for_processing_purposes, false), attribute(objection_under_art21_1_made, true), attribute(verification_of_overriding_grounds_pending, false)]).
subject_profile(restriction_unlawfulness_unsure, [attribute(request_type, restriction), attribute(accuracy_contested_by_data_subject, false), attribute(personal_data_unlawfully_processed, unsure), attribute(data_subject_opposes_erasure, true), attribute(controller_no_longer_needs_data_for_processing_purposes, false), attribute(objection_under_art21_1_made, false)]).
subject_profile(restriction_lawful_processing, [attribute(request_type, restriction), attribute(accuracy_contested_by_data_subject, false), attribute(personal_data_unlawfully_processed, false), attribute(data_subject_opposes_erasure, true), attribute(controller_no_longer_needs_data_for_processing_purposes, false), attribute(objection_under_art21_1_made, false)]).

% ---- Convenience wrapper ---------------------------------------------
gdpr_data_subject_rights_articles_15_to_18_decision_and_exception_assess(Subject, Result) :-
    subject_profile(Subject, Profile),
    decide_request_exception(Profile, Result).

:- end_module(fixtures).
