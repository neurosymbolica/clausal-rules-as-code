% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/data_protection/gdpr_data_subject_rights_articles_15_to_18_decision_and_exception.
%
% Instrument: Regulation (EU) 2016/679 of the European Parliament and of the
% Council (General Data Protection Regulation), consolidated text
% 02016R0679-20160504 (in force from 2016-05-04).
%
% Keys follow the corpus lexicon's canonical spelling eu_reg_2016_679_art_...
% (the order's CITATION VOCABULARY); the referral citations of a result use
% ONLY those listed keys. The keys this order does not list (Art 12(2),
% 12(5)(a), 12(5)(b), 15(1), the umbrella paragraphs 17(1), 17(3), 18(1), the
% points 17(1)(b), (f), 18(1)(a), (d), and Art 23(1)) are recorded here so
% that every operative clause can name the provision it decides.
% lint: allow C6 corpus-lexicon-key (the segments reg and art are the
% lexicon's canonical citation spelling, mandated by the order)
%
% The three target keys union_or_member_state_law_requiring_erasure,
% union_or_member_state_law_requiring_processing and
% union_or_member_state_law_restricting_the_right name the OUTSIDE law an
% outside fact points to (the `target` of the outside_facts: rows). They are
% recorded for the cite(TARGET) of a cross_reference_unresolved answer and of
% its resolution(cite(TARGET), not_attempted); they quote nothing, so they
% are unverified and carry no verbatim.
%
% Reasoning-only provisions (Art 4, Art 6(1), Art 9(2), Art 11(2), Art 12(1),
% Art 12(2) first sentence, Art 89(1)) are not recorded: no rule of this
% order decides or applies them (reading (17)).
%
% citation/2 record form: citation(Key, [label-'...', ref-'...', verbatim-'...']).
% implements(Key) succeeds for every recorded key and fails for any other.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

% ---- Article 12: transparent information, communication and modalities ----

citation(eu_reg_2016_679_art_12_2, [label-'Regulation (EU) 2016/679 (GDPR) Art 12(2), second sentence (refusal only where the controller cannot identify the data subject)', ref-'CELEX 02016R0679-20160504, unit parag_012.002', verbatim-'In the cases referred to in Article 11(2), the controller shall not refuse to act on the request of the data subject for exercising his or her rights under Articles 15 to 22, unless the controller demonstrates that it is not in a position to identify the data subject.']).

citation(eu_reg_2016_679_art_12_5, [label-'Regulation (EU) 2016/679 (GDPR) Art 12(5) (requests manifestly unfounded or excessive; burden on the controller)', ref-'CELEX 02016R0679-20160504, unit parag_012.005', verbatim-'Where requests from a data subject are manifestly unfounded or excessive, in particular because of their repetitive character, the controller may either:']).

citation(eu_reg_2016_679_art_12_5_a, [label-'Regulation (EU) 2016/679 (GDPR) Art 12(5)(a) (reasonable fee)', ref-'CELEX 02016R0679-20160504, unit point_012.005_a', verbatim-'charge a reasonable fee taking into account the administrative costs of providing the information or communication or taking the action requested']).

citation(eu_reg_2016_679_art_12_5_b, [label-'Regulation (EU) 2016/679 (GDPR) Art 12(5)(b) (refusal to act)', ref-'CELEX 02016R0679-20160504, unit point_012.005_b', verbatim-'refuse to act on the request']).

citation(eu_reg_2016_679_art_12_6, [label-'Regulation (EU) 2016/679 (GDPR) Art 12(6) (reasonable doubts concerning the identity of the requester)', ref-'CELEX 02016R0679-20160504, unit parag_012.006', verbatim-'where the controller has reasonable doubts concerning the identity of the natural person making the request referred to in Articles 15 to 21, the controller may request the provision of additional information necessary to confirm the identity of the data subject']).

% ---- Article 15: right of access by the data subject ----

citation(eu_reg_2016_679_art_15_1, [label-'Regulation (EU) 2016/679 (GDPR) Art 15(1), opening words (right to confirmation and access)', ref-'CELEX 02016R0679-20160504, unit parag_015.001', verbatim-'The data subject shall have the right to obtain from the controller confirmation as to whether or not personal data concerning him or her are being processed, and, where that is the case, access to the personal data']).

% ---- Article 16: right to rectification ----

citation(eu_reg_2016_679_art_16, [label-'Regulation (EU) 2016/679 (GDPR) Art 16 (rectification of inaccurate data; completion of incomplete data)', ref-'CELEX 02016R0679-20160504, unit art_016', verbatim-'The data subject shall have the right to obtain from the controller without undue delay the rectification of inaccurate personal data concerning him or her.']).

% ---- Article 17(1): right to erasure, the grounds ----

citation(eu_reg_2016_679_art_17_1, [label-'Regulation (EU) 2016/679 (GDPR) Art 17(1), opening words (erasure where one of the grounds applies)', ref-'CELEX 02016R0679-20160504, unit parag_017.001', verbatim-'the controller shall have the obligation to erase personal data without undue delay where one of the following grounds applies']).

citation(eu_reg_2016_679_art_17_1_a, [label-'Regulation (EU) 2016/679 (GDPR) Art 17(1)(a) (data no longer necessary)', ref-'CELEX 02016R0679-20160504, unit parag_017.001 point (a)', verbatim-'the personal data are no longer necessary in relation to the purposes for which they were collected or otherwise processed']).

citation(eu_reg_2016_679_art_17_1_b, [label-'Regulation (EU) 2016/679 (GDPR) Art 17(1)(b) (consent withdrawn and no other legal ground)', ref-'CELEX 02016R0679-20160504, unit parag_017.001 point (b)', verbatim-'the data subject withdraws consent on which the processing is based according to point (a) of Article 6(1), or point (a) of Article 9(2), and where there is no other legal ground for the processing']).

citation(eu_reg_2016_679_art_17_1_c, [label-'Regulation (EU) 2016/679 (GDPR) Art 17(1)(c) (objection under Art 21(1) without overriding grounds, or under Art 21(2))', ref-'CELEX 02016R0679-20160504, unit parag_017.001 point (c)', verbatim-'the data subject objects to the processing pursuant to Article 21(1) and there are no overriding legitimate grounds for the processing, or the data subject objects to the processing pursuant to Article 21(2)']).

citation(eu_reg_2016_679_art_17_1_d, [label-'Regulation (EU) 2016/679 (GDPR) Art 17(1)(d) (unlawful processing)', ref-'CELEX 02016R0679-20160504, unit parag_017.001 point (d)', verbatim-'the personal data have been unlawfully processed']).

citation(eu_reg_2016_679_art_17_1_e, [label-'Regulation (EU) 2016/679 (GDPR) Art 17(1)(e) (erasure required by a legal obligation in Union or Member State law)', ref-'CELEX 02016R0679-20160504, unit parag_017.001 point (e)', verbatim-'the personal data have to be erased for compliance with a legal obligation in Union or Member State law to which the controller is subject']).

citation(eu_reg_2016_679_art_17_1_f, [label-'Regulation (EU) 2016/679 (GDPR) Art 17(1)(f) (data collected in relation to an offer of information society services)', ref-'CELEX 02016R0679-20160504, unit parag_017.001 point (f)', verbatim-'the personal data have been collected in relation to the offer of information society services referred to in Article 8(1)']).

% ---- Article 17(3): exceptions to erasure ----

citation(eu_reg_2016_679_art_17_3, [label-'Regulation (EU) 2016/679 (GDPR) Art 17(3), opening words (paragraphs 1 and 2 do not apply)', ref-'CELEX 02016R0679-20160504, unit parag_017.003', verbatim-'Paragraphs 1 and 2 shall not apply to the extent that processing is necessary:']).

citation(eu_reg_2016_679_art_17_3_a, [label-'Regulation (EU) 2016/679 (GDPR) Art 17(3)(a) (freedom of expression and information)', ref-'CELEX 02016R0679-20160504, unit parag_017.003 point (a)', verbatim-'for exercising the right of freedom of expression and information']).

citation(eu_reg_2016_679_art_17_3_b, [label-'Regulation (EU) 2016/679 (GDPR) Art 17(3)(b) (legal obligation requiring processing; public interest task or official authority)', ref-'CELEX 02016R0679-20160504, unit parag_017.003 point (b)', verbatim-'for compliance with a legal obligation which requires processing by Union or Member State law to which the controller is subject or for the performance of a task carried out in the public interest or in the exercise of official authority vested in the controller']).

citation(eu_reg_2016_679_art_17_3_c, [label-'Regulation (EU) 2016/679 (GDPR) Art 17(3)(c) (public interest in the area of public health)', ref-'CELEX 02016R0679-20160504, unit parag_017.003 point (c)', verbatim-'for reasons of public interest in the area of public health in accordance with points (h) and (i) of Article 9(2) as well as Article 9(3)']).

citation(eu_reg_2016_679_art_17_3_d, [label-'Regulation (EU) 2016/679 (GDPR) Art 17(3)(d) (archiving, research or statistics where erasure would impair the objectives)', ref-'CELEX 02016R0679-20160504, unit parag_017.003 point (d)', verbatim-'for archiving purposes in the public interest, scientific or historical research purposes or statistical purposes in accordance with Article 89(1) in so far as the right referred to in paragraph 1 is likely to render impossible or seriously impair the achievement of the objectives of that processing']).

citation(eu_reg_2016_679_art_17_3_e, [label-'Regulation (EU) 2016/679 (GDPR) Art 17(3)(e) (legal claims)', ref-'CELEX 02016R0679-20160504, unit parag_017.003 point (e)', verbatim-'for the establishment, exercise or defence of legal claims']).

% ---- Article 18(1): right to restriction of processing ----

citation(eu_reg_2016_679_art_18_1, [label-'Regulation (EU) 2016/679 (GDPR) Art 18(1), opening words (restriction where one of the situations applies)', ref-'CELEX 02016R0679-20160504, unit parag_018.001', verbatim-'The data subject shall have the right to obtain from the controller restriction of processing where one of the following applies:']).

citation(eu_reg_2016_679_art_18_1_a, [label-'Regulation (EU) 2016/679 (GDPR) Art 18(1)(a) (accuracy contested)', ref-'CELEX 02016R0679-20160504, unit parag_018.001 point (a)', verbatim-'the accuracy of the personal data is contested by the data subject, for a period enabling the controller to verify the accuracy of the personal data']).

citation(eu_reg_2016_679_art_18_1_b, [label-'Regulation (EU) 2016/679 (GDPR) Art 18(1)(b) (unlawful processing, erasure opposed)', ref-'CELEX 02016R0679-20160504, unit parag_018.001 point (b)', verbatim-'the processing is unlawful and the data subject opposes the erasure of the personal data and requests the restriction of their use instead']).

citation(eu_reg_2016_679_art_18_1_c, [label-'Regulation (EU) 2016/679 (GDPR) Art 18(1)(c) (controller no longer needs the data; data subject needs them for legal claims)', ref-'CELEX 02016R0679-20160504, unit parag_018.001 point (c)', verbatim-'the controller no longer needs the personal data for the purposes of the processing, but they are required by the data subject for the establishment, exercise or defence of legal claims']).

citation(eu_reg_2016_679_art_18_1_d, [label-'Regulation (EU) 2016/679 (GDPR) Art 18(1)(d) (objection under Art 21(1) pending verification)', ref-'CELEX 02016R0679-20160504, unit parag_018.001 point (d)', verbatim-'the data subject has objected to processing pursuant to Article 21(1) pending the verification whether the legitimate grounds of the controller override those of the data subject']).

% ---- Article 23(1): restrictions by legislative measure ----

citation(eu_reg_2016_679_art_23_1, [label-'Regulation (EU) 2016/679 (GDPR) Art 23(1), opening words (restriction by a legislative measure)', ref-'CELEX 02016R0679-20160504, unit parag_023.001', verbatim-'Union or Member State law to which the data controller or processor is subject may restrict by way of a legislative measure the scope of the obligations and rights provided for in Articles 12 to 22 and Article 34']).

% ---- Cross-reference targets: the outside law an outside fact points to ----

citation(union_or_member_state_law_requiring_erasure, [label-'Union or Member State law imposing on the controller a legal obligation to erase the personal data (target of Regulation (EU) 2016/679 Art 17(1)(e))', ref-'not resolved: no fetcher exists; the law is supplied only as the attested outside fact erasure_required_by_union_or_member_state_law']).

citation(union_or_member_state_law_requiring_processing, [label-'Union or Member State law to which the controller is subject that requires the processing (target of Regulation (EU) 2016/679 Art 17(3)(b), first limb)', ref-'not resolved: no fetcher exists; the law is supplied only as the attested outside fact processing_required_by_union_or_member_state_law']).

citation(union_or_member_state_law_restricting_the_right, [label-'Union or Member State legislative measure restricting the right invoked (target of Regulation (EU) 2016/679 Art 23(1))', ref-'not resolved: no fetcher exists; the measure is supplied only as the attested outside fact legislative_restriction_applies_to_the_right']).

% ---- Provenance marker ----
% implements(Key): opens every operative clause; succeeds for a recorded key only.
implements(Key) :-
    citation(Key, _).

test(a_referral_key_is_recorded) :-
    implements(eu_reg_2016_679_art_17_3_d).
test(the_art23_outside_fact_key_is_recorded) :-
    implements(eu_reg_2016_679_art_23_1).
test(a_cross_reference_target_is_recorded) :-
    implements(union_or_member_state_law_requiring_erasure).
test(an_unrecorded_key_is_refused, fail) :-
    implements(eu_reg_2016_679_art_99).
test(the_placeholder_key_is_gone, fail) :-
    implements(eu_todo_primary_source).

:- end_module(citations).
