    attribute(processed_under_professional_secrecy, false)
]).

% ---- Art 9(2)(i) ---------------------------------------------------------
gdpr_special_categories_profile_for(public_health_law, [
    attribute(exception_claimed, art9_2_i),
    attribute(concerns_health, true),
    attribute(criminal_offence_data_present, false),
    attribute(processing_necessary, true),
    attribute(public_health_public_interest, true),
    attribute(public_health_law_basis_exists, AttestedTrue),
    attribute(suitable_and_specific_measures, true)
]) :-
    attested_true(AttestedTrue).
gdpr_special_categories_profile_for(public_health_law_attested_false, [
    attribute(exception_claimed, art9_2_i),
    attribute(concerns_health, true),
    attribute(criminal_offence_data_present, false),
    attribute(processing_necessary, true),
    attribute(public_health_public_interest, true),
    attribute(public_health_law_basis_exists, AttestedFalse),
    attribute(suitable_and_specific_measures, true)
]) :-
    attested_false(AttestedFalse).

% ---- Art 9(2)(j) ---------------------------------------------------------
gdpr_special_categories_profile_for(research_archiving, [
    attribute(exception_claimed, art9_2_j),
    attribute(genetic_data_present, true),
    attribute(criminal_offence_data_present, false),
    attribute(processing_necessary, true),
    attribute(purpose_is_archiving_research_or_statistics, true),
    attribute(accordance_with_article_89_1, true),
    attribute(research_archiving_statistics_law_basis_exists, AttestedTrue),
    attribute(authorising_law_proportionate_and_respects_essence, true),
    attribute(suitable_and_specific_measures, true)
]) :-
    attested_true(AttestedTrue).
gdpr_special_categories_profile_for(research_without_article_89, [
    attribute(exception_claimed, art9_2_j),
    attribute(genetic_data_present, true),
    attribute(criminal_offence_data_present, false),
    attribute(processing_necessary, true),
    attribute(purpose_is_archiving_research_or_statistics, true),
    attribute(accordance_with_article_89_1, false),
    attribute(research_archiving_statistics_law_basis_exists, AttestedTrue),
    attribute(authorising_law_proportionate_and_respects_essence, true),
    attribute(suitable_and_specific_measures, true)
]) :-
    attested_true(AttestedTrue).

% ---- Art 10 ----------------------------------------------------------------
gdpr_special_categories_profile_for(criminal_official_authority, Profile) :-
    no_category_attributes(Categories),
    append(Categories, [
        attribute(criminal_offence_data_present, true),
        attribute(processing_under_official_authority_control, true)
    ], Profile).
gdpr_special_categories_profile_for(criminal_no_route, Profile) :-
    attested_false(AttestedFalse),
    no_category_attributes(Categories),
    append(Categories, [
        attribute(criminal_offence_data_present, true),
        attribute(processing_under_official_authority_control, false),
        attribute(criminal_data_authorising_law_exists, AttestedFalse)
    ], Profile).
gdpr_special_categories_profile_for(criminal_authorised_by_law, Profile) :-
    attested_true(AttestedTrue),
    no_category_attributes(Categories),
    append(Categories, [
        attribute(criminal_offence_data_present, true),
        attribute(processing_under_official_authority_control, false),
        attribute(comprehensive_register_of_criminal_convictions, false),
        attribute(criminal_data_authorising_law_exists, AttestedTrue),
        attribute(criminal_data_law_safeguards_appropriate, true)
    ], Profile).
gdpr_special_categories_profile_for(criminal_register_defeats_law, Profile) :-
    attested_true(AttestedTrue),
    no_category_attributes(Categories),
    append(Categories, [
        attribute(criminal_offence_data_present, true),
        attribute(processing_under_official_authority_control, false),
        attribute(comprehensive_register_of_criminal_convictions, true),
        attribute(criminal_data_authorising_law_exists, AttestedTrue),
        attribute(criminal_data_law_safeguards_appropriate, true)
    ], Profile).
gdpr_special_categories_profile_for(criminal_scope_absent, Profile) :-
    no_category_attributes(Categories),
    append(Categories, [attribute(processing_under_official_authority_control, true)], Profile).

% ---- Art 9(4) ----------------------------------------------------------------
gdpr_special_categories_profile_for(further_conditions_attested_false, [attribute(member_state_further_conditions_exist, AttestedFalse)|Consent]) :-
    attested_false(AttestedFalse),
    explicit_consent_attributes(Consent).
gdpr_special_categories_profile_for(further_conditions_attested_true, [attribute(member_state_further_conditions_exist, AttestedTrue)|Consent]) :-
    attested_true(AttestedTrue),
    explicit_consent_attributes(Consent).
gdpr_special_categories_profile_for(health_unsure_further_conditions, [
    attribute(exception_claimed, art9_2_a),
    attribute(reveals_political_opinions, true),
    attribute(genetic_data_present, false),
    attribute(biometric_data_present, false),
    attribute(concerns_health, unsure),
    attribute(criminal_offence_data_present, false),
    attribute(explicit_consent_given, true),
    attribute(consent_purposes_specified, true),
    attribute(consent_satisfies_definition, true),
    attribute(member_state_further_conditions_exist, AttestedFalse)
]) :-
    attested_false(AttestedFalse).
gdpr_special_categories_profile_for(health_false_further_conditions, [
    attribute(exception_claimed, art9_2_a),
    attribute(reveals_political_opinions, true),
    attribute(genetic_data_present, false),
    attribute(biometric_data_present, false),
    attribute(concerns_health, false),
    attribute(criminal_offence_data_present, false),
    attribute(explicit_consent_given, true),
    attribute(consent_purposes_specified, true),
    attribute(consent_satisfies_definition, true),
    attribute(member_state_further_conditions_exist, AttestedFalse)
]) :-
    attested_false(AttestedFalse).

% ---- Art 9(1) scope: biometric pair and unsure judgements ------------------
gdpr_special_categories_profile_for(biometric_without_identification, [
    attribute(reveals_racial_or_ethnic_origin, false),
    attribute(reveals_political_opinions, false),
    attribute(reveals_religious_or_philosophical_beliefs, false),
    attribute(reveals_trade_union_membership, false),
    attribute(genetic_data_present, false),
    attribute(biometric_data_present, true),
    attribute(biometric_used_for_unique_identification, false),
    attribute(concerns_health, false),
    attribute(concerns_sex_life_or_sexual_orientation, false),
    attribute(criminal_offence_data_present, false)
]).
gdpr_special_categories_profile_for(biometric_with_identification, [
    attribute(reveals_racial_or_ethnic_origin, false),
    attribute(reveals_political_opinions, false),
    attribute(reveals_religious_or_philosophical_beliefs, false),
    attribute(reveals_trade_union_membership, false),
    attribute(genetic_data_present, false),
    attribute(biometric_data_present, true),
    attribute(biometric_used_for_unique_identification, true),
    attribute(concerns_health, false),
    attribute(concerns_sex_life_or_sexual_orientation, false),
    attribute(criminal_offence_data_present, false)
]).
gdpr_special_categories_profile_for(scope_unsure_referral, [
    attribute(genetic_data_present, false),
    attribute(biometric_data_present, false),
    attribute(criminal_offence_data_present, false),
    attribute(concerns_health, false),
    attribute(concerns_sex_life_or_sexual_orientation, unsure),
    attribute(reveals_political_opinions, false),
    attribute(reveals_racial_or_ethnic_origin, false),
    attribute(reveals_religious_or_philosophical_beliefs, unsure),
    attribute(reveals_trade_union_membership, unsure)
]).
gdpr_special_categories_profile_for(scope_settled_false, [
    attribute(genetic_data_present, false),
    attribute(biometric_data_present, false),
    attribute(criminal_offence_data_present, false),
    attribute(concerns_health, false),
    attribute(concerns_sex_life_or_sexual_orientation, false),
    attribute(reveals_political_opinions, false),
    attribute(reveals_racial_or_ethnic_origin, false),
    attribute(reveals_religious_or_philosophical_beliefs, false),
    attribute(reveals_trade_union_membership, false)
]).

% ---- Input problems -----------------------------------------------------------
gdpr_special_categories_profile_for(duplicate_and_unknown_keys, [
    attribute(concerns_health, true),
    attribute(concerns_health, false),
    attribute(colour, red)
]).
gdpr_special_categories_profile_for(wrong_type_value, [
    attribute(genetic_data_present, unsure),
    attribute(criminal_offence_data_present, false)
]).

% ---- Convenience wrapper ---------------------------------------------
gdpr_special_categories_assess(Subject, Result) :-
    gdpr_special_categories_profile_for(Subject, Profile),
    decide_processing_permitted(Profile, Result).

% ---- tests ----------------------------------------------------------------
test(every_subject_has_exactly_one_profile) :-
    findall(Subject, gdpr_special_categories_subject(Subject), Subjects),
    maplist(one_profile, Subjects).

one_profile(Subject) :-
    findall(Profile, gdpr_special_categories_profile_for(Subject, Profile), Profiles),
    length(Profiles, 1).

test(subjects_are_registered_once) :-
    findall(Subject, gdpr_special_categories_subject(Subject), Subjects),
    sort(Subjects, Unique),
    length(Subjects, Count),
    length(Unique, Count).

:- end_module(fixtures).
