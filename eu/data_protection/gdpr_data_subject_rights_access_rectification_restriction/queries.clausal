% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% queries.clausal -- QUERY layer: compliance check (#13), justification (#7),
% what-if over an attribute-list profile, the profile key schema, and the
% input check re-exported from the kernel.
% =====================================================================

:- module(queries, [
    gdpr_data_subject_rights_access_rectification_restriction_profile_keys/1,
    gdpr_data_subject_rights_access_rectification_restriction_input_problems/2,
    gdpr_data_subject_rights_access_rectification_restriction_what_if/4,
    gdpr_data_subject_rights_access_rectification_restriction_compliance_check/2,
    gdpr_data_subject_rights_access_rectification_restriction_justification/2
]).

:- use_module(eu/data_protection/gdpr_data_subject_rights_access_rectification_restriction/kernel, [gdpr_data_subject_rights_access_rectification_restriction_input_problems/2]).
:- use_module(eu/data_protection/gdpr_data_subject_rights_access_rectification_restriction/request_basis, [
    decide_data_subject_request/2,
    request_basis_checklist/2
]).

gdpr_data_subject_rights_access_rectification_restriction_profile_keys([request_type, objection_ground_claimed, request_received_on, extension_claimed, controller_demonstrates_unable_to_identify_data_subject, identity_confirmed, personal_data_inaccurate, consent_is_the_basis_of_processing, consent_withdrawn, other_legal_ground_for_processing_exists, objection_under_art21_1_made, objection_under_art21_2_made, collected_in_relation_to_information_society_services_offer, accuracy_contested_by_data_subject, data_subject_opposes_erasure, data_required_by_data_subject_for_legal_claims, verification_of_overriding_grounds_pending, personal_data_provided_by_data_subject, processing_based_on_consent_or_contract, processing_carried_out_by_automated_means, processing_based_on_art6_1_e_or_f, processing_for_direct_marketing, processing_for_research_or_statistics_pursuant_to_art89_1, data_subject_gave_explicit_consent, decision_based_on_special_categories, special_category_condition_and_safeguards_met_for_decision, personal_data_disclosed_to_recipients, data_subject_asks_who_the_recipients_are, extension_necessary_for_complexity_and_number, reasonable_doubts_about_identity, request_manifestly_unfounded_or_excessive, personal_data_incomplete_in_light_of_purposes, data_no_longer_necessary_for_purposes, overriding_legitimate_grounds_exist, personal_data_unlawfully_processed, processing_necessary_for_freedom_of_expression_and_information, processing_necessary_for_public_task_or_official_authority, processing_necessary_for_public_health_in_accordance_with_art9_2_h_and_i, processing_for_archiving_research_or_statistics_in_accordance_with_art89_1, erasure_would_render_impossible_or_seriously_impair_processing_objectives, processing_necessary_for_legal_claims, controller_no_longer_needs_data_for_processing_purposes, transmission_would_adversely_affect_rights_and_freedoms_of_others, objection_grounds_relate_to_particular_situation, controller_demonstrates_compelling_legitimate_grounds, decision_based_solely_on_automated_processing, decision_produces_legal_or_similarly_significant_effects, decision_necessary_for_contract_with_data_subject, recipient_notification_impossible_or_disproportionate_effort, legislative_restriction_applies_to_the_right, erasure_required_by_union_or_member_state_law, processing_required_by_union_or_member_state_law, decision_authorised_by_union_or_member_state_law, public_holidays]).

% compliance check (#13): is the controller obliged to act on the request in the
% current state? One outcome atom for every profile.
gdpr_data_subject_rights_access_rectification_restriction_compliance_check(Profile, Outcome) :-
    decide_data_subject_request(Profile, gdpr_data_subject_request_verdict(Comply, _, _, _, _)),
    comply_outcome(Comply, Outcome).

comply_outcome(must_comply, controller_must_comply).
comply_outcome(need_not_comply, controller_need_not_comply).
comply_outcome(indeterminate(_), undetermined).
comply_outcome(needs_legal_review(_, _), legal_review_required).
comply_outcome(suspended(_), suspended_pending_identity).
comply_outcome(input_problems(_), input_problems_found).

% justification (#7): the checklist, one row per limb, each with cite(...) provenance
gdpr_data_subject_rights_access_rectification_restriction_justification(Profile, Items) :-
    request_basis_checklist(Profile, Items).

% what-if: re-evaluate with one attribute hypothetically replaced (or added);
% the answer is the COMPLY field of the verdict under the hypothesis.
gdpr_data_subject_rights_access_rectification_restriction_what_if(Profile, OverriddenKey, NewValue, NewComply) :-
    override_attribute(Profile, OverriddenKey, NewValue, Hypothesis),
    decide_data_subject_request(Hypothesis, gdpr_data_subject_request_verdict(NewComply, _, _, _, _)).

override_attribute([], Key, Value, [attribute(Key, Value)]).
override_attribute([attribute(Key, _)|Rest], Key, Value, [attribute(Key, Value)|Rest]).
override_attribute([attribute(OtherKey, OtherValue)|Rest], Key, Value, [attribute(OtherKey, OtherValue)|Others]) :-
    dif(OtherKey, Key),
    override_attribute(Rest, Key, Value, Others).

:- end_module(queries).
