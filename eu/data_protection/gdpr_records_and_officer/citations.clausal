% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/data_protection/gdpr_records_and_officer.
%
% Instrument: Regulation (EU) 2016/679 of the European Parliament and of the
% Council (General Data Protection Regulation), consolidated text
% 02016R0679-20160504 (CELEX 02016R0679-20160504).
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% Each verbatim is an exact substring of the pinned text (chosen to hold no
% apostrophe or quotation mark, which the source may set typographically).
%
% CITED IN ANSWERS: the Art 30, 37, 38 and 39 keys, exactly as the order's
% citation vocabulary spells them.
% REASONING ONLY (never returned in a cite term of an answer):
%   eu_reg_2016_679_art_4_7   definition of controller (reading (1));
%   eu_reg_2016_679_art_4_8   definition of processor (reading (1));
%   eu_reg_2016_679_art_4_18  definition of enterprise (reading (2), Q28);
%   eu_reg_2016_679_art_37_1  chapeau of Art 37(1), the any-one-limb rule;
%   eu_reg_2016_679_art_39_1  chapeau of Art 39(1), the at-least floor.
%
% PROVENANCE: every operative clause opens its body with implements(Key).
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

% implements(Key): the provenance marker; succeeds for every recorded key.
implements(Key) :-
    citation(Key, _).

% ---- definitions (reasoning only) -----------------------------------
citation(eu_reg_2016_679_art_4_7, [label-'Regulation (EU) 2016/679 Art 4(7) definition of controller', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#point_004_7', verbatim-'means the natural or legal person, public authority, agency or other body which, alone or jointly with others, determines the purposes and means of the processing of personal data']).
citation(eu_reg_2016_679_art_4_8, [label-'Regulation (EU) 2016/679 Art 4(8) definition of processor', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#point_004_8', verbatim-'means a natural or legal person, public authority, agency or other body which processes personal data on behalf of the controller']).
citation(eu_reg_2016_679_art_4_18, [label-'Regulation (EU) 2016/679 Art 4(18) definition of enterprise', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#point_004_18', verbatim-'means a natural or legal person engaged in an economic activity, irrespective of its legal form']).

% ---- Art 30: records of processing activities -----------------------
citation(eu_reg_2016_679_art_30_1, [label-'Regulation (EU) 2016/679 Art 30(1) chapeau (controller record)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#parag_030.001', verbatim-'shall maintain a record of processing activities under its responsibility']).
citation(eu_reg_2016_679_art_30_1_a, [label-'Regulation (EU) 2016/679 Art 30(1)(a) (name and contact details)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#point_030.001_a', verbatim-'the name and contact details of the controller and, where applicable, the joint controller']).
citation(eu_reg_2016_679_art_30_1_b, [label-'Regulation (EU) 2016/679 Art 30(1)(b) (purposes of the processing)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#point_030.001_b', verbatim-'the purposes of the processing']).
citation(eu_reg_2016_679_art_30_1_c, [label-'Regulation (EU) 2016/679 Art 30(1)(c) (categories of data subjects and of personal data)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#point_030.001_c', verbatim-'a description of the categories of data subjects and of the categories of personal data']).
citation(eu_reg_2016_679_art_30_1_d, [label-'Regulation (EU) 2016/679 Art 30(1)(d) (categories of recipients)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#point_030.001_d', verbatim-'the categories of recipients to whom the personal data have been or will be disclosed including recipients in third countries or international organisations']).
citation(eu_reg_2016_679_art_30_1_e, [label-'Regulation (EU) 2016/679 Art 30(1)(e) (third-country transfers and Art 49(1) safeguards documentation)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#point_030.001_e', verbatim-'where applicable, transfers of personal data to a third country or an international organisation, including the identification of that third country or international organisation']).
citation(eu_reg_2016_679_art_30_1_f, [label-'Regulation (EU) 2016/679 Art 30(1)(f) (envisaged time limits for erasure, where possible)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#point_030.001_f', verbatim-'where possible, the envisaged time limits for erasure of the different categories of data']).
citation(eu_reg_2016_679_art_30_1_g, [label-'Regulation (EU) 2016/679 Art 30(1)(g) (description of security measures, where possible)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#point_030.001_g', verbatim-'where possible, a general description of the technical and organisational security measures referred to in Article 32(1)']).
citation(eu_reg_2016_679_art_30_2, [label-'Regulation (EU) 2016/679 Art 30(2) chapeau (processor record)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#parag_030.002', verbatim-'shall maintain a record of all categories of processing activities carried out on behalf of a controller']).
citation(eu_reg_2016_679_art_30_2_a, [label-'Regulation (EU) 2016/679 Art 30(2)(a) (name and contact details)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#point_030.002_a', verbatim-'the name and contact details of the processor or processors and of each controller on behalf of which the processor is acting']).
citation(eu_reg_2016_679_art_30_2_b, [label-'Regulation (EU) 2016/679 Art 30(2)(b) (categories of processing)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#point_030.002_b', verbatim-'the categories of processing carried out on behalf of each controller']).
citation(eu_reg_2016_679_art_30_2_c, [label-'Regulation (EU) 2016/679 Art 30(2)(c) (third-country transfers and Art 49(1) safeguards documentation)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#point_030.002_c', verbatim-'where applicable, transfers of personal data to a third country or an international organisation, including the identification of that third country or international organisation']).
citation(eu_reg_2016_679_art_30_2_d, [label-'Regulation (EU) 2016/679 Art 30(2)(d) (description of security measures, where possible)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#point_030.002_d', verbatim-'where possible, a general description of the technical and organisational security measures referred to in Article 32(1)']).
citation(eu_reg_2016_679_art_30_5, [label-'Regulation (EU) 2016/679 Art 30(5) (exemption below 250 persons and its four triggers)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#parag_030.005', verbatim-'shall not apply to an enterprise or an organisation employing fewer than 250 persons unless the processing it carries out is likely to result in a risk to the rights and freedoms of data subjects']).

% ---- Art 37: designation of the data protection officer -------------
citation(eu_reg_2016_679_art_37_1, [label-'Regulation (EU) 2016/679 Art 37(1) chapeau (designation in any case where a limb holds)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#parag_037.001', verbatim-'The controller and the processor shall designate a data protection officer in any case where']).
citation(eu_reg_2016_679_art_37_1_a, [label-'Regulation (EU) 2016/679 Art 37(1)(a) (public authority or body, except courts in their judicial capacity)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#point_037.001_a', verbatim-'the processing is carried out by a public authority or body, except for courts acting in their judicial capacity']).
citation(eu_reg_2016_679_art_37_1_b, [label-'Regulation (EU) 2016/679 Art 37(1)(b) (core activities of regular and systematic monitoring on a large scale)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#point_037.001_b', verbatim-'require regular and systematic monitoring of data subjects on a large scale']).
citation(eu_reg_2016_679_art_37_1_c, [label-'Regulation (EU) 2016/679 Art 37(1)(c) (core activities of large-scale processing of Art 9 or Art 10 data)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#point_037.001_c', verbatim-'consist of processing on a large scale of special categories of data pursuant to Article 9 or personal data relating to criminal convictions and offences referred to in Article 10']).
citation(eu_reg_2016_679_art_37_4, [label-'Regulation (EU) 2016/679 Art 37(4) (designation where required by Union or Member State law)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#parag_037.004', verbatim-'where required by Union or Member State law shall, designate a data protection officer']).

% ---- Art 38: position of the data protection officer ----------------
citation(eu_reg_2016_679_art_38_1, [label-'Regulation (EU) 2016/679 Art 38(1) (involvement, properly and in a timely manner)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#parag_038.001', verbatim-'ensure that the data protection officer is involved, properly and in a timely manner, in all issues which relate to the protection of personal data']).
citation(eu_reg_2016_679_art_38_2, [label-'Regulation (EU) 2016/679 Art 38(2) (resources and access)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#parag_038.002', verbatim-'by providing resources necessary to carry out those tasks and access to personal data and processing operations']).
citation(eu_reg_2016_679_art_38_3, [label-'Regulation (EU) 2016/679 Art 38(3) (no instructions, no dismissal or penalty, direct reporting to the highest management level)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#parag_038.003', verbatim-'does not receive any instructions regarding the exercise of those tasks']).
citation(eu_reg_2016_679_art_38_6, [label-'Regulation (EU) 2016/679 Art 38(6) second sentence (no conflict of interests from other tasks and duties)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#parag_038.006', verbatim-'shall ensure that any such tasks and duties do not result in a conflict of interests']).

% ---- Art 39(1): tasks of the data protection officer ----------------
citation(eu_reg_2016_679_art_39_1, [label-'Regulation (EU) 2016/679 Art 39(1) chapeau (at least the following tasks)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#parag_039.001', verbatim-'The data protection officer shall have at least the following tasks']).
citation(eu_reg_2016_679_art_39_1_a, [label-'Regulation (EU) 2016/679 Art 39(1)(a) (inform and advise)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#point_039.001_a', verbatim-'to inform and advise the controller or the processor and the employees who carry out processing of their obligations pursuant to this Regulation']).
citation(eu_reg_2016_679_art_39_1_b, [label-'Regulation (EU) 2016/679 Art 39(1)(b) (monitor compliance)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#point_039.001_b', verbatim-'to monitor compliance with this Regulation']).
citation(eu_reg_2016_679_art_39_1_c, [label-'Regulation (EU) 2016/679 Art 39(1)(c) (advice on the data protection impact assessment)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#point_039.001_c', verbatim-'to provide advice where requested as regards the data protection impact assessment and monitor its performance pursuant to Article 35']).
citation(eu_reg_2016_679_art_39_1_d, [label-'Regulation (EU) 2016/679 Art 39(1)(d) (cooperate with the supervisory authority)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#point_039.001_d', verbatim-'to cooperate with the supervisory authority']).
citation(eu_reg_2016_679_art_39_1_e, [label-'Regulation (EU) 2016/679 Art 39(1)(e) (contact point for the supervisory authority)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#point_039.001_e', verbatim-'to act as the contact point for the supervisory authority on issues relating to processing']).

:- end_module(citations).
