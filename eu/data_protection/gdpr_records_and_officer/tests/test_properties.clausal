% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_properties.clausal -- structural PROPERTIES over the subject set.
% Totality: every registered subject yields a verdict.
% Determinism: every query yields EXACTLY ONE solution per subject (the
% scorer counts every solution).
% Invariants: the status is in the vocabulary, a record_required verdict
% carries citations, no obligation is [], and a key an entry does not
% read never changes that entry's answer. Each property has a falsifier.
% Run: python -m clausal.testing eu/data_protection/gdpr_records_and_officer/tests/test_properties.clausal
% =====================================================================
:- module(test_properties, []).
:- use_module(eu/data_protection/gdpr_records_and_officer/gdpr_records_and_officer, [
    decide_gdpr_records_and_officer/2,
    gdpr_records_and_officer_status/2,
    gdpr_records_and_officer_status_values/1,
    record_obligation/2,
    record_missing_items/2,
    data_protection_officer_designation/2,
    officer_missing_tasks/2,
    data_protection_officer_outside_facts/2,
    officer_position_status/5
]).
:- use_module(eu/data_protection/gdpr_records_and_officer/fixtures, [
    gdpr_records_and_officer_subject/1,
    gdpr_records_and_officer_profile_for/2
]).

position_duties([involvement, resources_and_access, no_instructions_or_penalty, direct_reporting, conflict_of_interests]).

fixture_subjects(Subjects) :-
    findall(Subject, gdpr_records_and_officer_subject(Subject), Subjects).

exactly_one_solution(Goal) :-
    findall(Goal, Goal, Solutions),
    length(Solutions, 1).

subject_classifies(Subject) :-
    gdpr_records_and_officer_subject(Subject),
    gdpr_records_and_officer_profile_for(Subject, Profile),
    decide_gdpr_records_and_officer(Profile, _Verdict).

subject_is_deterministic(Subject) :-
    gdpr_records_and_officer_profile_for(Subject, Profile),
    exactly_one_solution(decide_gdpr_records_and_officer(Profile, _Verdict)),
    exactly_one_solution(record_obligation(Profile, _Obligation)),
    exactly_one_solution(record_missing_items(Profile, _MissingItems)),
    exactly_one_solution(data_protection_officer_designation(Profile, _Designation)),
    exactly_one_solution(officer_missing_tasks(Profile, _MissingTasks)),
    exactly_one_solution(data_protection_officer_outside_facts(Profile, _OutsideFacts)),
    position_duties(Duties),
    maplist(duty_is_deterministic(Profile), Duties).

duty_is_deterministic(Profile, Duty) :-
    exactly_one_solution(officer_position_status(Profile, Duty, _Result, _Basis, _Citations)).

subject_status_is_in_the_vocabulary(Subject) :-
    gdpr_records_and_officer_profile_for(Subject, Profile),
    gdpr_records_and_officer_status(Profile, Status),
    gdpr_records_and_officer_status_values(StatusValues),
    member(Status, StatusValues).

% Entry 1 does not read the officer keys.
entry_one_ignores_an_officer_key(Subject) :-
    gdpr_records_and_officer_profile_for(Subject, Profile),
    record_obligation(Profile, ObligationBefore),
    record_missing_items(Profile, MissingBefore),
    append(Profile, [attribute(officer_other_tasks_result_in_conflict_of_interests, true)], Extended),
    record_obligation(Extended, ObligationAfter),
    record_missing_items(Extended, MissingAfter),
    ObligationBefore == ObligationAfter,
    MissingBefore == MissingAfter.

% Entry 2 does not read the Art 38 facts.
entry_two_ignores_an_article_38_fact(Subject) :-
    gdpr_records_and_officer_profile_for(Subject, Profile),
    data_protection_officer_designation(Profile, DesignationBefore),
    append(Profile, [attribute(officer_reports_to_highest_management_level, attested(true, attestation(property_host, property_moment, property_reason, none)))], Extended),
    data_protection_officer_designation(Extended, DesignationAfter),
    DesignationBefore == DesignationAfter.

% Entry 3 reads only the key of its duty.
entry_three_reads_only_its_key(Subject) :-
    gdpr_records_and_officer_profile_for(Subject, Profile),
    officer_position_status(Profile, involvement, ResultBefore, BasisBefore, CitationsBefore),
    append(Profile, [attribute(officer_other_tasks_result_in_conflict_of_interests, false)], Extended),
    officer_position_status(Extended, involvement, ResultAfter, BasisAfter, CitationsAfter),
    ResultBefore == ResultAfter,
    BasisBefore == BasisAfter,
    CitationsBefore == CitationsAfter.

% sort/2 collapses a subject that classifies more than once.
test(totality_every_subject_classifies) :-
    fixture_subjects(Subjects),
    sort(Subjects, SubjectSet),
    findall(Subject, subject_classifies(Subject), ClassifiedSubjects),
    sort(ClassifiedSubjects, SubjectSet).

test(determinism_every_query_has_exactly_one_solution) :-
    fixture_subjects(Subjects),
    maplist(subject_is_deterministic, Subjects).

test(determinism_falsifier_two_solutions_are_rejected, fail) :-
    exactly_one_solution(member(_Element, [first, second])).

test(every_status_is_in_the_vocabulary) :-
    fixture_subjects(Subjects),
    maplist(subject_status_is_in_the_vocabulary, Subjects).

test(no_subject_gets_an_empty_obligation, fail) :-
    gdpr_records_and_officer_subject(Subject),
    gdpr_records_and_officer_profile_for(Subject, Profile),
    record_obligation(Profile, []).

test(no_record_required_verdict_lacks_a_citation, fail) :-
    gdpr_records_and_officer_subject(Subject),
    gdpr_records_and_officer_profile_for(Subject, Profile),
    decide_gdpr_records_and_officer(Profile, gdpr_records_and_officer_verdict(record_required, [])).

test(a_record_required_verdict_carries_a_citation) :-
    gdpr_records_and_officer_profile_for(controller_at_ceiling_250, Profile),
    decide_gdpr_records_and_officer(Profile, gdpr_records_and_officer_verdict(record_required, [_FirstCitation|_OtherCitations])).

test(entry_one_is_unchanged_by_an_officer_key) :-
    fixture_subjects(Subjects),
    maplist(entry_one_ignores_an_officer_key, Subjects).

test(entry_two_is_unchanged_by_an_article_38_fact) :-
    fixture_subjects(Subjects),
    maplist(entry_two_ignores_an_article_38_fact, Subjects).

test(entry_three_is_unchanged_by_another_duty_key) :-
    fixture_subjects(Subjects),
    maplist(entry_three_reads_only_its_key, Subjects).

test(entry_three_falsifier_its_own_key_changes_the_answer) :-
    officer_position_status([], conflict_of_interests, ResultAbsent, _BasisAbsent, _CitationsAbsent),
    officer_position_status([attribute(officer_other_tasks_result_in_conflict_of_interests, false)], conflict_of_interests, ResultPresent, _BasisPresent, _CitationsPresent),
    ResultAbsent \== ResultPresent.

:- end_module(test_properties).
