% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_robustness.clausal -- ROBUSTNESS of the input check gdpr_records_and_officer_input_problems/2 for a
% PROFILE that is an attribute list [attribute(Key, Value), ...]: an empty list, a
% value that is not a list, an unknown key and a value outside its type each get exactly
% one answer. Written by the scaffold from the order's typed input contract
% (input_contract.types.profile: attribute_list), not by the producer;
% do not edit or delete.
% Run: python -m clausal.testing eu/data_protection/gdpr_records_and_officer/tests/test_robustness.clausal
% =====================================================================
:- module(test_robustness, []).
:- use_module(eu/data_protection/gdpr_records_and_officer/queries, [gdpr_records_and_officer_input_problems/2]).

test(an_empty_attribute_list_gets_exactly_one_answer) :-
    findall(Problems, gdpr_records_and_officer_input_problems([], Problems), Answers),
    Answers == [[]].

test(a_profile_that_is_not_a_list_gets_one_non_empty_answer) :-
    findall(Problems, gdpr_records_and_officer_input_problems(not_a_profile, Problems), Answers),
    Answers = [[_|_]].

test(an_unknown_key_is_named) :-
    findall(Problems, gdpr_records_and_officer_input_problems([attribute(not_a_key_of_the_contract, true)], Problems), Answers),
    Answers = [Problems],
    memberchk(unknown_key(not_a_key_of_the_contract), Problems).

test(a_value_outside_the_type_of_acts_as_controller_is_named) :-
    findall(Problems, gdpr_records_and_officer_input_problems([attribute(acts_as_controller, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(acts_as_controller), Problems).

test(a_value_outside_the_type_of_controller_erasure_time_limits_possible_is_named) :-
    findall(Problems, gdpr_records_and_officer_input_problems([attribute(controller_erasure_time_limits_possible, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(controller_erasure_time_limits_possible), Problems).

test(a_value_outside_the_type_of_persons_employed_is_named) :-
    findall(Problems, gdpr_records_and_officer_input_problems([attribute(persons_employed, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(persons_employed), Problems).

:- end_module(test_robustness).
