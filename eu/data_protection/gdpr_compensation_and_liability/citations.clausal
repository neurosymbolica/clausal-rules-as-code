% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/data_protection/gdpr_compensation_and_liability.
%
% Instrument: Regulation (EU) 2016/679 (General Data Protection Regulation),
% Article 82, consolidated text 02016R0679-20160504 (pinned unit text, fmx4
% cut by tools/pin_statute.py, fetched 2026-11-12).
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% Each verbatim below is an exact substring of the pinned unit text and the
% entry in citations-sources.yaml is `status: verified`.
%
% LOAD-BEARING keys (the only citation atoms a RESULT may return):
%   eu_reg_2016_679_art_82_1  Art 82(1)  the right to compensation
%   eu_reg_2016_679_art_82_2  Art 82(2)  controller and processor limbs
%   eu_reg_2016_679_art_82_3  Art 82(3)  the exemption
% CROSS-REFERENCE TARGET (the outside fact of Art 82(3); appears only as
% cite(non_responsibility_statement) inside a cross_reference_unresolved
% referral and its resolution/2 item):
%   non_responsibility_statement
% DEFERRED keys (quoted for the deferral record, no limb, never returned):
%   eu_reg_2016_679_art_82_4  Art 82(4)  joint liability for the entire damage
%   eu_reg_2016_679_art_82_5  Art 82(5)  recourse between liable parties
%   eu_reg_2016_679_art_82_6  Art 82(6)  the competent courts
%
% PROVENANCE: every operative clause opens its body with implements(Key),
% Key one of the keys recorded here. implements/1 succeeds for every
% recorded key and fails for any other (a misspelt key fails, it never lies).
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

citation(eu_reg_2016_679_art_82_1, [label-'Regulation (EU) 2016/679 (GDPR) Art 82(1) right to receive compensation for material or non-material damage', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'Any person who has suffered material or non-material damage as a result of an infringement of this Regulation shall have the right to receive compensation from the controller or processor for the damage suffered.']).

citation(eu_reg_2016_679_art_82_2, [label-'Regulation (EU) 2016/679 (GDPR) Art 82(2) liability of the controller involved in processing and of the processor', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'Any controller involved in processing shall be liable for the damage caused by processing which infringes this Regulation. A processor shall be liable for the damage caused by processing only where it has not complied with obligations of this Regulation specifically directed to processors or where it has acted outside or contrary to lawful instructions of the controller.']).

citation(eu_reg_2016_679_art_82_3, [label-'Regulation (EU) 2016/679 (GDPR) Art 82(3) exemption from liability on proof of no responsibility for the event', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'A controller or processor shall be exempt from liability under paragraph 2 if it proves that it is not in any way responsible for the event giving rise to the damage.']).

citation(non_responsibility_statement, [label-'Regulation (EU) 2016/679 (GDPR) Art 82(3) statement that the party is not in any way responsible for the event giving rise to the damage (outside-fact target)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'if it proves that it is not in any way responsible for the event giving rise to the damage']).

citation(eu_reg_2016_679_art_82_4, [label-'Regulation (EU) 2016/679 (GDPR) Art 82(4) joint liability for the entire damage (deferred)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'Where more than one controller or processor, or both a controller and a processor, are involved in the same processing and where they are, under paragraphs 2 and 3, responsible for any damage caused by processing, each controller or processor shall be held liable for the entire damage in order to ensure effective compensation of the data subject.']).

citation(eu_reg_2016_679_art_82_5, [label-'Regulation (EU) 2016/679 (GDPR) Art 82(5) recourse of the party that paid full compensation (deferred)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'Where a controller or processor has, in accordance with paragraph 4, paid full compensation for the damage suffered, that controller or processor shall be entitled to claim back from the other controllers or processors involved in the same processing that part of the compensation corresponding to their part of responsibility for the damage, in accordance with the conditions set out in paragraph 2.']).

citation(eu_reg_2016_679_art_82_6, [label-'Regulation (EU) 2016/679 (GDPR) Art 82(6) courts competent for compensation proceedings (deferred)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'Court proceedings for exercising the right to receive compensation shall be brought before the courts competent under the law of the Member State referred to in Article 79(2).']).

% implements(Key): the provenance marker. Succeeds for every recorded key.
implements(Key) :-
    citation(Key, _).

test(a_load_bearing_key_is_recorded) :-
    implements(eu_reg_2016_679_art_82_1).
test(the_exemption_key_is_recorded) :-
    implements(eu_reg_2016_679_art_82_3).
test(a_shortened_key_is_not_recorded, fail) :-
    implements(art_82_1).

:- end_module(citations).
