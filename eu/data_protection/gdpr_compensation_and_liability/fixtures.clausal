% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% fixtures.clausal -- representative profiles for eu/data_protection/gdpr_compensation_and_liability.
% A TOP-LAYER consumer: import the determination slice's PUBLIC predicates
% you call -- that is the whole import list. Profile keys and subject ids
% are atoms and need no import.
%
% A profile is the order's ATTRIBUTE LIST [attribute(KEY, VALUE), ...]
% (INTERFACE - THE PROFILE AND THE ATOMS). There are no numeric thresholds
% in Art 82, so the near-miss controls are ONE-KEY changes: each control
% differs from its positive case in exactly one key and gets another answer.
%
% Routes (INTERFACE - THE LIMBS) and their subjects:
%   step 11 liable_for_damage      controller_liable, processor_liable_by_breach,
%                                  processor_liable_by_instructions
%   step 10 exempt_from_liability  controller_exempt          (control of controller_liable)
%   step 6  not_liable_for_damage  controller_not_involved    (control of controller_liable)
%                                  processor_outside_both_false (control of processor_liable_by_instructions)
%   step 1  right_not_established  damage_false_role_absent   (control of judgement_absent)
%   step 2  right_not_established  infringement_false_outside_caller (control of controller_not_involved, Q8)
%   step 3  right_not_established  causation_false            (control of controller_liable)
%   step 4  indeterminate          judgement_absent
%   step 5  indeterminate          role_absent, controller_involvement_absent,
%                                  processor_keys_absent, processor_second_key_absent
%   step 7  needs_legal_review     outside_caller_unsure      (control of controller_not_involved)
%   step 8  needs_legal_review     controller_statement_absent (control of controller_liable),
%                                  inside_statement_absent_with_unsure
%   step 9  needs_legal_review     inside_unsure              (control of controller_liable)
%   step 0  input_problems         input_wrong_type_crisp_unsure, input_duplicate_key,
%                                  input_unknown_key, input_not_attribute_list,
%                                  input_unbound_value
% =====================================================================

:- module(fixtures, [
    gdpr_compensation_and_liability_subject/1,
    gdpr_compensation_and_liability_profile_for/2,
    gdpr_compensation_and_liability_assess/2
]).

:- use_module(eu/data_protection/gdpr_compensation_and_liability/gdpr_compensation_and_liability, [decide_gdpr_compensation_and_liability/2]).

% ---- Subject registry ------------------------------------------------
gdpr_compensation_and_liability_subject(controller_liable).
gdpr_compensation_and_liability_subject(controller_exempt).
gdpr_compensation_and_liability_subject(controller_not_involved).
gdpr_compensation_and_liability_subject(controller_statement_absent).
gdpr_compensation_and_liability_subject(processor_liable_by_breach).
gdpr_compensation_and_liability_subject(processor_liable_by_instructions).
gdpr_compensation_and_liability_subject(processor_outside_both_false).
gdpr_compensation_and_liability_subject(damage_false_role_absent).
gdpr_compensation_and_liability_subject(infringement_false_outside_caller).
gdpr_compensation_and_liability_subject(causation_false).
gdpr_compensation_and_liability_subject(judgement_absent).
gdpr_compensation_and_liability_subject(role_absent).
gdpr_compensation_and_liability_subject(controller_involvement_absent).
gdpr_compensation_and_liability_subject(processor_keys_absent).
gdpr_compensation_and_liability_subject(processor_second_key_absent).
gdpr_compensation_and_liability_subject(outside_caller_unsure).
gdpr_compensation_and_liability_subject(inside_statement_absent_with_unsure).
gdpr_compensation_and_liability_subject(inside_unsure).
gdpr_compensation_and_liability_subject(input_wrong_type_crisp_unsure).
gdpr_compensation_and_liability_subject(input_duplicate_key).
gdpr_compensation_and_liability_subject(input_unknown_key).
gdpr_compensation_and_liability_subject(input_not_attribute_list).
gdpr_compensation_and_liability_subject(input_unbound_value).

% ---- Profiles --------------------------------------------------------
% Step 11: an involved controller, three conditions true, statement attested false.
gdpr_compensation_and_liability_profile_for(controller_liable, [
    attribute(party_role, controller),
    attribute(involved_in_the_processing, true),
    attribute(damage_suffered, true),
    attribute(infringement_of_the_regulation_occurred, true),
    attribute(damage_resulted_from_the_infringement, true),
    attribute(not_in_any_way_responsible_for_the_event, attested(false, attestation(host_operator, recorded_at, reason_given, none)))
]).
% Step 10: control of controller_liable, the statement attested true.
gdpr_compensation_and_liability_profile_for(controller_exempt, [
    attribute(party_role, controller),
    attribute(involved_in_the_processing, true),
    attribute(damage_suffered, true),
    attribute(infringement_of_the_regulation_occurred, true),
    attribute(damage_resulted_from_the_infringement, true),
    attribute(not_in_any_way_responsible_for_the_event, attested(true, attestation(host_operator, recorded_at, reason_given, url(evidence_address, retrieved_at))))
]).
% Step 6: control of controller_liable, the controller not involved (Q9).
gdpr_compensation_and_liability_profile_for(controller_not_involved, [
    attribute(party_role, controller),
    attribute(involved_in_the_processing, false),
    attribute(damage_suffered, true),
    attribute(infringement_of_the_regulation_occurred, true),
    attribute(damage_resulted_from_the_infringement, true),
    attribute(not_in_any_way_responsible_for_the_event, attested(false, attestation(host_operator, recorded_at, reason_given, none)))
]).
% Step 8: control of controller_liable, the statement absent.
gdpr_compensation_and_liability_profile_for(controller_statement_absent, [
    attribute(party_role, controller),
    attribute(involved_in_the_processing, true),
    attribute(damage_suffered, true),
    attribute(infringement_of_the_regulation_occurred, true),
    attribute(damage_resulted_from_the_infringement, true)
]).
% Step 11: a processor that breached processor obligations; the second
% processor key is absent and never needed.
gdpr_compensation_and_liability_profile_for(processor_liable_by_breach, [
    attribute(party_role, processor),
    attribute(processor_breached_obligations_directed_to_processors, true),
    attribute(damage_suffered, true),
    attribute(infringement_of_the_regulation_occurred, true),
    attribute(damage_resulted_from_the_infringement, true),
    attribute(not_in_any_way_responsible_for_the_event, attested(false, attestation(host_operator, recorded_at, reason_given, document(upload_identifier, content_hash))))
]).
% Step 11: a processor that acted outside lawful instructions.
gdpr_compensation_and_liability_profile_for(processor_liable_by_instructions, [
    attribute(party_role, processor),
    attribute(processor_breached_obligations_directed_to_processors, false),
    attribute(processor_acted_outside_or_contrary_to_lawful_instructions, true),
    attribute(damage_suffered, true),
    attribute(infringement_of_the_regulation_occurred, true),
    attribute(damage_resulted_from_the_infringement, true),
    attribute(not_in_any_way_responsible_for_the_event, attested(false, attestation(host_operator, recorded_at, reason_given, none)))
]).
% Step 6: control of processor_liable_by_instructions, both processor keys false.
gdpr_compensation_and_liability_profile_for(processor_outside_both_false, [
    attribute(party_role, processor),
    attribute(processor_breached_obligations_directed_to_processors, false),
    attribute(processor_acted_outside_or_contrary_to_lawful_instructions, false),
    attribute(damage_suffered, true),
    attribute(infringement_of_the_regulation_occurred, true),
    attribute(damage_resulted_from_the_infringement, true),
    attribute(not_in_any_way_responsible_for_the_event, attested(false, attestation(host_operator, recorded_at, reason_given, none)))
]).
% Step 1: damage judged false decides whatever else is absent or unsure.
gdpr_compensation_and_liability_profile_for(damage_false_role_absent, [
    attribute(damage_suffered, false),
    attribute(infringement_of_the_regulation_occurred, unsure)
]).
% Step 2: control of controller_not_involved, infringement false (Q8).
gdpr_compensation_and_liability_profile_for(infringement_false_outside_caller, [
    attribute(party_role, controller),
    attribute(involved_in_the_processing, false),
    attribute(damage_suffered, true),
    attribute(infringement_of_the_regulation_occurred, false),
    attribute(damage_resulted_from_the_infringement, true),
    attribute(not_in_any_way_responsible_for_the_event, attested(false, attestation(host_operator, recorded_at, reason_given, none)))
]).
% Step 3: control of controller_liable, causation false.
gdpr_compensation_and_liability_profile_for(causation_false, [
    attribute(party_role, controller),
    attribute(involved_in_the_processing, true),
    attribute(damage_suffered, true),
    attribute(infringement_of_the_regulation_occurred, true),
    attribute(damage_resulted_from_the_infringement, false),
    attribute(not_in_any_way_responsible_for_the_event, attested(false, attestation(host_operator, recorded_at, reason_given, none)))
]).
% Step 4: control of damage_false_role_absent, damage true, the next judgement absent.
gdpr_compensation_and_liability_profile_for(judgement_absent, [
    attribute(damage_suffered, true),
    attribute(infringement_of_the_regulation_occurred, unsure)
]).
% Step 5: the role absent.
gdpr_compensation_and_liability_profile_for(role_absent, [
    attribute(damage_suffered, true),
    attribute(infringement_of_the_regulation_occurred, true),
    attribute(damage_resulted_from_the_infringement, true)
]).
% Step 5: a controller, its involvement absent; the processor keys are not
% the controller's and are never named.
gdpr_compensation_and_liability_profile_for(controller_involvement_absent, [
    attribute(party_role, controller),
    attribute(processor_breached_obligations_directed_to_processors, false),
    attribute(damage_suffered, true),
    attribute(infringement_of_the_regulation_occurred, true),
    attribute(damage_resulted_from_the_infringement, true)
]).
% Step 5: a processor, both processor keys absent.
gdpr_compensation_and_liability_profile_for(processor_keys_absent, [
    attribute(party_role, processor),
    attribute(involved_in_the_processing, true),
    attribute(damage_suffered, true),
    attribute(infringement_of_the_regulation_occurred, true),
    attribute(damage_resulted_from_the_infringement, true)
]).
% Step 5: a processor, the first processor key false, the second absent.
gdpr_compensation_and_liability_profile_for(processor_second_key_absent, [
    attribute(party_role, processor),
    attribute(processor_breached_obligations_directed_to_processors, false),
    attribute(damage_suffered, true),
    attribute(infringement_of_the_regulation_occurred, true),
    attribute(damage_resulted_from_the_infringement, true)
]).
% Step 7: control of controller_not_involved, damage unsure; the statement
% is absent and not read for a caller outside Art 82(2).
gdpr_compensation_and_liability_profile_for(outside_caller_unsure, [
    attribute(party_role, controller),
    attribute(involved_in_the_processing, false),
    attribute(damage_suffered, unsure),
    attribute(infringement_of_the_regulation_occurred, true),
    attribute(damage_resulted_from_the_infringement, true)
]).
% Step 8 before step 9: inside, statement absent, a judgement unsure.
gdpr_compensation_and_liability_profile_for(inside_statement_absent_with_unsure, [
    attribute(party_role, controller),
    attribute(involved_in_the_processing, true),
    attribute(damage_suffered, true),
    attribute(infringement_of_the_regulation_occurred, unsure),
    attribute(damage_resulted_from_the_infringement, true)
]).
% Step 9: control of controller_liable, causation unsure.
gdpr_compensation_and_liability_profile_for(inside_unsure, [
    attribute(party_role, controller),
    attribute(involved_in_the_processing, true),
    attribute(damage_suffered, true),
    attribute(infringement_of_the_regulation_occurred, true),
    attribute(damage_resulted_from_the_infringement, unsure),
    attribute(not_in_any_way_responsible_for_the_event, attested(false, attestation(host_operator, recorded_at, reason_given, none)))
]).
% Step 0: a crisp key given unsure.
gdpr_compensation_and_liability_profile_for(input_wrong_type_crisp_unsure, [
    attribute(party_role, controller),
    attribute(involved_in_the_processing, unsure),
    attribute(damage_suffered, true)
]).
% Step 0: a judgement key given twice.
gdpr_compensation_and_liability_profile_for(input_duplicate_key, [
    attribute(damage_suffered, true),
    attribute(damage_suffered, true)
]).
% Step 0: a key outside the eight.
gdpr_compensation_and_liability_profile_for(input_unknown_key, [
    attribute(damage_suffered, true),
    attribute(colour, red)
]).
% Step 0: not an attribute list.
gdpr_compensation_and_liability_profile_for(input_not_attribute_list, [
    damage_suffered-true
]).
% Step 0: an unbound value.
gdpr_compensation_and_liability_profile_for(input_unbound_value, [
    attribute(damage_suffered, _UnboundValue)
]).

% ---- Convenience wrapper ---------------------------------------------
gdpr_compensation_and_liability_assess(Subject, Result) :-
    gdpr_compensation_and_liability_profile_for(Subject, Profile),
    decide_gdpr_compensation_and_liability(Profile, Result).

:- end_module(fixtures).
