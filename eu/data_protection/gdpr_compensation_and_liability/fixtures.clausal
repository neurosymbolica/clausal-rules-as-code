% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% fixtures.clausal -- representative profiles for eu/data_protection/gdpr_compensation_and_liability.
% A TOP-LAYER consumer: it imports the determination slice's PUBLIC
% predicate it calls. Profile keys and subject ids are atoms and need no
% import.
%
% A profile is an ATTRIBUTE LIST [attribute(Key, Value), ...] (the order's
% typed input contract). Article 82 has no numeric threshold, so the
% near-miss controls differ from their positive case by ONE key (one value
% changed, removed or added), and get a different result:
%   liable_controller  <-> exempt_controller (statement attested true)
%   liable_controller  <-> not_liable_uninvolved_controller (involvement false)
%   liable_controller  <-> right_not_established_no_damage (damage false)
%   liable_controller  <-> right_not_established_no_infringement
%   liable_controller  <-> right_not_established_no_causation
%   liable_controller  <-> referred_statement_absent (statement removed)
%   liable_controller  <-> referred_inside_unsure (damage unsure)
%   liable_controller  <-> indeterminate_judgement_absent (causation removed)
%   liable_controller  <-> indeterminate_role_absent (role removed)
%   liable_controller  <-> indeterminate_involvement_absent (involvement removed)
%   liable_controller  <-> input_problem_unknown_key / _wrong_type / _duplicate_key
%   liable_processor_breach <-> not_liable_processor (breach false)
%   liable_processor_instructions <-> indeterminate_processor_ground_absent
%   not_liable_uninvolved_controller <-> referred_outside_unsure
%   not_liable_uninvolved_controller <-> right_not_established_outside_caller (Q8)
%
% todo_baseline_subject: the baseline profile the scaffold's mode tests
% read (input, output, negative controls, robustness). It is the profile of
% liable_controller and is NOT registered as a subject, so the subject
% sweeps are unchanged.
% =====================================================================

:- module(fixtures, [
    gdpr_compensation_and_liability_subject/1,
    gdpr_compensation_and_liability_profile_for/2,
    gdpr_compensation_and_liability_assess/2
]).

:- use_module(eu/data_protection/gdpr_compensation_and_liability/gdpr_compensation_and_liability, [decide_gdpr_compensation_and_liability/2]).

% ---- Subject registry ------------------------------------------------
gdpr_compensation_and_liability_subject(liable_controller).
gdpr_compensation_and_liability_subject(exempt_controller).
gdpr_compensation_and_liability_subject(liable_processor_breach).
gdpr_compensation_and_liability_subject(not_liable_processor).
gdpr_compensation_and_liability_subject(liable_processor_instructions).
gdpr_compensation_and_liability_subject(indeterminate_processor_ground_absent).
gdpr_compensation_and_liability_subject(not_liable_uninvolved_controller).
gdpr_compensation_and_liability_subject(right_not_established_no_damage).
gdpr_compensation_and_liability_subject(right_not_established_no_infringement).
gdpr_compensation_and_liability_subject(right_not_established_no_causation).
gdpr_compensation_and_liability_subject(right_not_established_outside_caller).
gdpr_compensation_and_liability_subject(indeterminate_judgement_absent).
gdpr_compensation_and_liability_subject(indeterminate_role_absent).
gdpr_compensation_and_liability_subject(indeterminate_involvement_absent).
gdpr_compensation_and_liability_subject(referred_outside_unsure).
gdpr_compensation_and_liability_subject(referred_statement_absent).
gdpr_compensation_and_liability_subject(referred_inside_unsure).
gdpr_compensation_and_liability_subject(input_problem_unknown_key).
gdpr_compensation_and_liability_subject(input_problem_wrong_type).
gdpr_compensation_and_liability_subject(input_problem_duplicate_key).

% ---- Profiles --------------------------------------------------------
% The baseline profile read by the scaffold's mode tests (step 11).
gdpr_compensation_and_liability_profile_for(todo_baseline_subject, [
        attribute(party_role, controller),
        attribute(involved_in_the_processing, true),
        attribute(damage_suffered, true),
        attribute(infringement_of_the_regulation_occurred, true),
        attribute(damage_resulted_from_the_infringement, true),
        attribute(not_in_any_way_responsible_for_the_event, attested(false, attestation(host, at, reason, none)))
    ]).
% Step 11: a controller involved, all true, statement attested false.
gdpr_compensation_and_liability_profile_for(liable_controller, [
        attribute(party_role, controller),
        attribute(involved_in_the_processing, true),
        attribute(damage_suffered, true),
        attribute(infringement_of_the_regulation_occurred, true),
        attribute(damage_resulted_from_the_infringement, true),
        attribute(not_in_any_way_responsible_for_the_event, attested(false, attestation(host, at, reason, none)))
    ]).
% Step 10: the same, statement attested true.
gdpr_compensation_and_liability_profile_for(exempt_controller, [
        attribute(party_role, controller),
        attribute(involved_in_the_processing, true),
        attribute(damage_suffered, true),
        attribute(infringement_of_the_regulation_occurred, true),
        attribute(damage_resulted_from_the_infringement, true),
        attribute(not_in_any_way_responsible_for_the_event, attested(true, attestation(host, at, reason, document(upload_identifier, checksum))))
    ]).
% Step 11: a processor that breached obligations directed to processors.
gdpr_compensation_and_liability_profile_for(liable_processor_breach, [
        attribute(party_role, processor),
        attribute(processor_breached_obligations_directed_to_processors, true),
        attribute(processor_acted_outside_or_contrary_to_lawful_instructions, false),
        attribute(damage_suffered, true),
        attribute(infringement_of_the_regulation_occurred, true),
        attribute(damage_resulted_from_the_infringement, true),
        attribute(not_in_any_way_responsible_for_the_event, attested(false, attestation(host, at, reason, none)))
    ]).
% Step 6: a processor with neither ground.
gdpr_compensation_and_liability_profile_for(not_liable_processor, [
        attribute(party_role, processor),
        attribute(processor_breached_obligations_directed_to_processors, false),
        attribute(processor_acted_outside_or_contrary_to_lawful_instructions, false),
        attribute(damage_suffered, true),
        attribute(infringement_of_the_regulation_occurred, true),
        attribute(damage_resulted_from_the_infringement, true),
        attribute(not_in_any_way_responsible_for_the_event, attested(false, attestation(host, at, reason, none)))
    ]).
% Step 11: a processor that acted outside lawful instructions; the other ground is not needed.
gdpr_compensation_and_liability_profile_for(liable_processor_instructions, [
        attribute(party_role, processor),
        attribute(processor_acted_outside_or_contrary_to_lawful_instructions, true),
        attribute(damage_suffered, true),
        attribute(infringement_of_the_regulation_occurred, true),
        attribute(damage_resulted_from_the_infringement, true),
        attribute(not_in_any_way_responsible_for_the_event, attested(false, attestation(host, at, reason, url(address, retrieved_at))))
    ]).
% Step 5: a processor with one ground false and the other absent.
gdpr_compensation_and_liability_profile_for(indeterminate_processor_ground_absent, [
        attribute(party_role, processor),
        attribute(processor_breached_obligations_directed_to_processors, false),
        attribute(damage_suffered, true),
        attribute(infringement_of_the_regulation_occurred, true),
        attribute(damage_resulted_from_the_infringement, true),
        attribute(not_in_any_way_responsible_for_the_event, attested(false, attestation(host, at, reason, url(address, retrieved_at))))
    ]).
% Step 6 (Q9): a controller not involved in the processing.
gdpr_compensation_and_liability_profile_for(not_liable_uninvolved_controller, [
        attribute(party_role, controller),
        attribute(involved_in_the_processing, false),
        attribute(damage_suffered, true),
        attribute(infringement_of_the_regulation_occurred, true),
        attribute(damage_resulted_from_the_infringement, true),
        attribute(not_in_any_way_responsible_for_the_event, attested(false, attestation(host, at, reason, none)))
    ]).
% Step 1: no damage.
gdpr_compensation_and_liability_profile_for(right_not_established_no_damage, [
        attribute(party_role, controller),
        attribute(involved_in_the_processing, true),
        attribute(damage_suffered, false),
        attribute(infringement_of_the_regulation_occurred, true),
        attribute(damage_resulted_from_the_infringement, true),
        attribute(not_in_any_way_responsible_for_the_event, attested(false, attestation(host, at, reason, none)))
    ]).
% Step 2: no infringement.
gdpr_compensation_and_liability_profile_for(right_not_established_no_infringement, [
        attribute(party_role, controller),
        attribute(involved_in_the_processing, true),
        attribute(damage_suffered, true),
        attribute(infringement_of_the_regulation_occurred, false),
        attribute(damage_resulted_from_the_infringement, true),
        attribute(not_in_any_way_responsible_for_the_event, attested(false, attestation(host, at, reason, none)))
    ]).
% Step 3: no causal link.
gdpr_compensation_and_liability_profile_for(right_not_established_no_causation, [
        attribute(party_role, controller),
        attribute(involved_in_the_processing, true),
        attribute(damage_suffered, true),
        attribute(infringement_of_the_regulation_occurred, true),
        attribute(damage_resulted_from_the_infringement, false),
        attribute(not_in_any_way_responsible_for_the_event, attested(false, attestation(host, at, reason, none)))
    ]).
% Step 3 (Q8): outside Art 82(2) and a false condition: right_not_established wins.
gdpr_compensation_and_liability_profile_for(right_not_established_outside_caller, [
        attribute(party_role, controller),
        attribute(involved_in_the_processing, false),
        attribute(damage_suffered, true),
        attribute(infringement_of_the_regulation_occurred, true),
        attribute(damage_resulted_from_the_infringement, false),
        attribute(not_in_any_way_responsible_for_the_event, attested(false, attestation(host, at, reason, none)))
    ]).
% Step 4: the causal judgement absent.
gdpr_compensation_and_liability_profile_for(indeterminate_judgement_absent, [
        attribute(party_role, controller),
        attribute(involved_in_the_processing, true),
        attribute(damage_suffered, true),
        attribute(infringement_of_the_regulation_occurred, true),
        attribute(not_in_any_way_responsible_for_the_event, attested(false, attestation(host, at, reason, none)))
    ]).
% Step 5: the role absent.
gdpr_compensation_and_liability_profile_for(indeterminate_role_absent, [
        attribute(involved_in_the_processing, true),
        attribute(damage_suffered, true),
        attribute(infringement_of_the_regulation_occurred, true),
        attribute(damage_resulted_from_the_infringement, true),
        attribute(not_in_any_way_responsible_for_the_event, attested(false, attestation(host, at, reason, none)))
    ]).
% Step 5: the controller's involvement absent.
gdpr_compensation_and_liability_profile_for(indeterminate_involvement_absent, [
        attribute(party_role, controller),
        attribute(damage_suffered, true),
        attribute(infringement_of_the_regulation_occurred, true),
        attribute(damage_resulted_from_the_infringement, true),
        attribute(not_in_any_way_responsible_for_the_event, attested(false, attestation(host, at, reason, none)))
    ]).
% Step 7: outside Art 82(2), the infringement unsure.
gdpr_compensation_and_liability_profile_for(referred_outside_unsure, [
        attribute(party_role, controller),
        attribute(involved_in_the_processing, false),
        attribute(damage_suffered, true),
        attribute(infringement_of_the_regulation_occurred, unsure),
        attribute(damage_resulted_from_the_infringement, true),
        attribute(not_in_any_way_responsible_for_the_event, attested(false, attestation(host, at, reason, none)))
    ]).
% Step 8: inside Art 82(2), the statement absent.
gdpr_compensation_and_liability_profile_for(referred_statement_absent, [
        attribute(party_role, controller),
        attribute(involved_in_the_processing, true),
        attribute(damage_suffered, true),
        attribute(infringement_of_the_regulation_occurred, true),
        attribute(damage_resulted_from_the_infringement, true)
    ]).
% Step 9: inside Art 82(2), the statement present, damage unsure.
gdpr_compensation_and_liability_profile_for(referred_inside_unsure, [
        attribute(party_role, controller),
        attribute(involved_in_the_processing, true),
        attribute(damage_suffered, unsure),
        attribute(infringement_of_the_regulation_occurred, true),
        attribute(damage_resulted_from_the_infringement, true),
        attribute(not_in_any_way_responsible_for_the_event, attested(false, attestation(host, at, reason, none)))
    ]).
% Step 0: a key outside the contract.
gdpr_compensation_and_liability_profile_for(input_problem_unknown_key, [
        attribute(party_role, controller),
        attribute(involved_in_the_processing, true),
        attribute(damage_suffered, true),
        attribute(infringement_of_the_regulation_occurred, true),
        attribute(damage_resulted_from_the_infringement, true),
        attribute(not_in_any_way_responsible_for_the_event, attested(false, attestation(host, at, reason, none))),
        attribute(colour, blue)
    ]).
% Step 0: a crisp key given unsure.
gdpr_compensation_and_liability_profile_for(input_problem_wrong_type, [
        attribute(party_role, controller),
        attribute(involved_in_the_processing, unsure),
        attribute(damage_suffered, true),
        attribute(infringement_of_the_regulation_occurred, true),
        attribute(damage_resulted_from_the_infringement, true),
        attribute(not_in_any_way_responsible_for_the_event, attested(false, attestation(host, at, reason, none)))
    ]).
% Step 0: a judgement key given twice.
gdpr_compensation_and_liability_profile_for(input_problem_duplicate_key, [
        attribute(party_role, controller),
        attribute(involved_in_the_processing, true),
        attribute(damage_suffered, true),
        attribute(damage_suffered, true),
        attribute(infringement_of_the_regulation_occurred, true),
        attribute(damage_resulted_from_the_infringement, true),
        attribute(not_in_any_way_responsible_for_the_event, attested(false, attestation(host, at, reason, none)))
    ]).

% ---- Convenience wrapper ---------------------------------------------
gdpr_compensation_and_liability_assess(Subject, Result) :-
    gdpr_compensation_and_liability_profile_for(Subject, Profile),
    decide_gdpr_compensation_and_liability(Profile, Result).

:- end_module(fixtures).
