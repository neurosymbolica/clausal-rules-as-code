% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% kernel.clausal -- the SHARED FLOOR for eu/data_protection/gdpr_compensation_and_liability (deontic family).
% Source: Regulation (EU) 2016/679 (GDPR), Article 82(1) to (3)
% (pinned consolidated text 02016R0679-20160504, units parag_082.001 to
% parag_082.003); Article 82(4) to (6) are quoted in citations.clausal for
% the deferral and have no limb.
%
% DAG root of the determination-slices layout. It holds ONLY the
% PREDICATES that two or more files CALL. The one shared predicate is the
% order's input check gdpr_compensation_and_liability_input_problems/2,
% written by the scaffold from the order's typed input contract and called
% first by the slice, the queries and the facade:
%   :- use_module(eu/data_protection/gdpr_compensation_and_liability/kernel, [gdpr_compensation_and_liability_input_problems/2]).
% The input check decides no statutory condition (it is profile plumbing
% against the input contract), so its clauses carry no implements/1 marker.
%
% deontic family: a liable_for_damage answer reads as the obligation of the
% caller (the bearer) to compensate the person who suffered the damage; the
% other final answers say that the obligation does not arise under
% Art 82(1) to (3) on the facts given.
%
% Atoms and data terms need NO declaration and NO import. The comment block
% below only RECORDS the result terms so every file spells them alike.
%
% RESULT TERMS
%
% The step ladder (INTERFACE - THE LIMBS, steps 0 to 11):
%   compensation_liability(Profile, Result, Basis, Citations)
%     Profile   -- attribute list [attribute(Key, Value), ...], read only
%                  with profile_get/3;
%     Result    -- a FINAL atom: right_not_established | not_liable_for_damage
%                  | exempt_from_liability | liable_for_damage;
%                  or a NON-FINAL compound (never written bare):
%                    input_problems(Problems)  Problems a non-empty list of
%                      duplicate_key(Key), wrong_type(Key), unknown_key(Key),
%                      or [wrong_type(profile)];
%                    indeterminate([Key])      the FIRST missing needed key
%                      (operator's the ruling);
%                    needs_legal_review(Reason, Context) with Reason
%                      open_textured(Key, cite(eu_reg_2016_679_art_82_1)) and
%                      Context [inputs_relied_on(Pairs)], or Reason
%                      cross_reference_unresolved(cite(eu_reg_2016_679_art_82_3),
%                      cite(non_responsibility_statement)) and Context
%                      [resolution(cite(non_responsibility_statement), not_attempted),
%                       inputs_relied_on(Pairs)];
%     Basis     -- [] or [outside_fact(not_in_any_way_responsible_for_the_event,
%                  attested(true|false, attestation(By, At, Reason, Evidence)))],
%                  the attested term copied exactly as supplied;
%     Citations -- a set-like list of cite(Key) terms, Key one of
%                  eu_reg_2016_679_art_82_1 | eu_reg_2016_679_art_82_2 |
%                  eu_reg_2016_679_art_82_3 (empty for a non-final Result).
%   Pairs are Key-Value pairs of the three judgement keys in contract order,
%   plus not_in_any_way_responsible_for_the_event-absent last for a
%   cross_reference_unresolved referral (THE PAIRS RULE).
%
% The slice verdict (one per determination slice):
%   gdpr_compensation_and_liability_verdict(Status, Citations)
%     Status    -- the Result term of the ladder above;
%     Citations -- the cite(Key) list of the ladder above.
%
% The justification checklist rows (query type #7):
%   item(RequirementId, Status, cite(Key)), Status met | unmet(Reason) |
%   unknown([Key]).
%
% Spell every result and verdict atom exactly as REQUIRED PUBLIC
% PREDICATES and the order pin it: an atom spelled differently is a
% DIFFERENT atom, and nothing will warn you.
% =====================================================================

:- module(kernel, [gdpr_compensation_and_liability_input_problems/2]).

:- use_module(library(reif), [memberd_t/3]).

% ---- input checks: the problems a profile has, if any -----------
% gdpr_compensation_and_liability_input_problems(Profile, Problems): Problems = [] means the profile can be
% judged. Written from the order's typed input contract
% (input_contract.types.profile: attribute_list).
% Each public query calls this check first: it gives its normal answer only when
% Problems = [], and when Problems is not [] it gives the answer the order states for
% a profile with input problems.
% It gives exactly one answer for every Profile, and the answer is ground except for a
% Key named as given:
% - a Profile that is not an attribute list [attribute(Key, Value), ...] gives [wrong_type(profile)]:
%   an unbound Profile, a partial list, a list holding an unbound item or an item that is
%   not attribute(_, _);
% - a Key that is not an atom (a number, a string, a compound term, an unbound variable)
%   is a key outside the contract: unknown_key(Key), Key as given;
% - otherwise, for each contract key in the contract's key order, duplicate_key(Key) when
%   the key occurs more than once in Profile (whatever its values: none of them is read,
%   so it is never also wrong_type(Key)), else wrong_type(Key) when its one value is
%   outside its type; then unknown_key(Key) for each key outside the contract, in the
%   order of its first occurrence in Profile. Each key is named once. An absent key is
%   not a problem.
% Every step is complementary clauses: exactly one clause holds for each input.
gdpr_compensation_and_liability_input_problems(Profile, Problems) :-
    attribute_list_t(Profile, IsAttributeList),
    profile_problems(IsAttributeList, Profile, Problems).

profile_problems(false, _, [wrong_type(profile)]).
profile_problems(true, Profile, Problems) :-
    Keys = [party_role, involved_in_the_processing, processor_breached_obligations_directed_to_processors, processor_acted_outside_or_contrary_to_lawful_instructions, damage_suffered, infringement_of_the_regulation_occurred, damage_resulted_from_the_infringement, not_in_any_way_responsible_for_the_event],
    unknown_keys(Profile, Keys, UnknownKeyProblems),
    key_problems(Keys, Profile, UnknownKeyProblems, Problems).

% The contract: each key and the type of its value.
key_type(party_role, party_role).
key_type(involved_in_the_processing, boolean).
key_type(processor_breached_obligations_directed_to_processors, boolean).
key_type(processor_acted_outside_or_contrary_to_lawful_instructions, boolean).
key_type(damage_suffered, judgement).
key_type(infringement_of_the_regulation_occurred, judgement).
key_type(damage_resulted_from_the_infringement, judgement).
key_type(not_in_any_way_responsible_for_the_event, outside_fact).

% attribute_list_t(Term, T): T is true when Term is a list of attribute(Key, Value)
% items, whatever each Key is; false for anything else, an unbound Term or item included.
attribute_list_t(Term, false) :-
    var(Term).
attribute_list_t(Term, true) :-
    Term == [].
attribute_list_t(Term, T) :-
    nonvar(Term),
    Term = [Element|Elements],
    attribute_t(Element, ElementIsAttribute),
    attribute_list_t(Elements, ElementsAreAttributes),
    truth_and(ElementIsAttribute, ElementsAreAttributes, T).
attribute_list_t(Term, false) :-
    nonvar(Term),
    Term \== [],
    Term \= [_|_].

attribute_t(Element, false) :-
    var(Element).
attribute_t(Element, true) :-
    nonvar(Element),
    Element = attribute(_, _).
attribute_t(Element, false) :-
    nonvar(Element),
    Element \= attribute(_, _).

% Unknown keys, in profile order, each once: Known grows by each key named. A key is
% known when it is identical (==) to one in Known, so an unbound Key is never bound:
% the same variable twice is one unknown key, two different variables are two.
unknown_keys([], _, []).
unknown_keys([attribute(Key, _)|Elements], Known, Problems) :-
    known_t(Key, Known, IsKnown),
    name_unknown_key(IsKnown, Key, Known, Elements, Problems).

known_t(_, [], false).
known_t(Key, [Known|_], true) :-
    Known == Key.
known_t(Key, [Known|Knowns], T) :-
    Known \== Key,
    known_t(Key, Knowns, T).

name_unknown_key(true, _, Known, Elements, Problems) :-
    unknown_keys(Elements, Known, Problems).
name_unknown_key(false, Key, Known, Elements, [unknown_key(Key)|Problems]) :-
    unknown_keys(Elements, [Key|Known], Problems).

% Contract keys, in contract order: duplicate_key(Key) when the key occurs more than once
% (none of its values is read), else wrong_type(Key) when its one value is outside the
% key's type. An absent key has no value to check.
key_problems([], _, Problems, Problems).
key_problems([Key|Keys], Profile, LaterProblems, Problems) :-
    key_type(Key, Type),
    key_occurrences(Profile, Key, Occurrences),
    key_problems(Keys, Profile, LaterProblems, KeyProblems),
    name_key_problem(Occurrences, Key, Type, Profile, KeyProblems, Problems).

% key_occurrences(Elements, Key, Occurrences): none, one or many items give Key.
key_occurrences([], _, none).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey == Key,
    key_occurrences(Elements, Key, RestOccurrences),
    one_more_occurrence(RestOccurrences, Occurrences).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey \== Key,
    key_occurrences(Elements, Key, Occurrences).

one_more_occurrence(none, one).
one_more_occurrence(one, many).
one_more_occurrence(many, many).

name_key_problem(none, _, _, _, Problems, Problems).
name_key_problem(many, Key, _, _, Problems, [duplicate_key(Key)|Problems]).
name_key_problem(one, Key, Type, Profile, KeyProblems, Problems) :-
    values_in_type_t(Profile, Key, Type, InType),
    name_wrong_type(InType, Key, KeyProblems, Problems).

name_wrong_type(true, _, Problems, Problems).
name_wrong_type(false, Key, Problems, [wrong_type(Key)|Problems]).

% values_in_type_t(Elements, Key, Type, T): T is true when every value Elements gives Key is
% in Type (true when Elements gives Key none).
values_in_type_t([], _, _, true).
values_in_type_t([attribute(ElementKey, Value)|Elements], Key, Type, T) :-
    ElementKey == Key,
    value_in_type_t(Type, Value, ValueInType),
    values_in_type_t(Elements, Key, Type, RestInType),
    truth_and(ValueInType, RestInType, T).
values_in_type_t([attribute(ElementKey, _)|Elements], Key, Type, T) :-
    ElementKey \== Key,
    values_in_type_t(Elements, Key, Type, T).

% A value with an unbound part is outside every type; a ground one is checked.
value_in_type_t(Type, Value, T) :-
    term_variables(Value, Variables),
    ground_value_in_type_t(Variables, Type, Value, T).

ground_value_in_type_t([_|_], _, _, false).
ground_value_in_type_t([], Type, Value, T) :-
    in_type_t(Type, Value, T).

% in_type_t(Type, Value, T): one clause per type, for a ground Value.
in_type_t(party_role, Value, T) :-
    in_type_t(enum([controller, processor]), Value, T).

in_type_t(judgement, Value, T) :-
    in_type_t(one_of([boolean, enum([unsure])]), Value, T).

in_type_t(outside_fact, Value, T) :-
    in_type_t(attested(boolean), Value, T).

in_type_t(boolean, Value, T) :-
    memberd_t(Value, [true, false], T).

in_type_t(enum(Values), Value, T) :-
    memberd_t(Value, Values, T).

in_type_t(one_of(Types), Value, T) :-
    in_some_type_t(Types, Value, T).

in_type_t(attested(Type), Value, T) :-
    attested_t(Value, Type, T).

truth_and(true, T, T).
truth_and(false, _, false).

% in_some_type_t(Types, Value, T): T is true when Value is in at least one of Types.
in_some_type_t([], _, false).
in_some_type_t([Type|Types], Value, T) :-
    in_type_t(Type, Value, InType),
    in_some_type_t(Types, Value, InAnother),
    truth_or(InType, InAnother, T).

truth_or(true, _, true).
truth_or(false, T, T).

% attested_t(Value, Type, T): T is true when Value is
% attested(AttestedValue, attestation(By, At, Reason, Evidence)) with AttestedValue in Type.
% By, At, Reason and Evidence come from the host and are not checked.
attested_t(attested(AttestedValue, Attestation), Type, T) :-
    attestation_t(Attestation, IsAttestation),
    attested_value_t(IsAttestation, Type, AttestedValue, T).
attested_t(Value, _, false) :-
    Value \= attested(_, _).

attestation_t(attestation(_, _, _, _), true).
attestation_t(Value, false) :-
    Value \= attestation(_, _, _, _).

attested_value_t(false, _, _, false).
attested_value_t(true, Type, AttestedValue, T) :-
    in_type_t(Type, AttestedValue, T).

test(a_well_formed_profile_has_no_problem) :-
    gdpr_compensation_and_liability_input_problems([attribute(party_role, controller), attribute(damage_suffered, unsure)], []).
test(an_empty_profile_has_no_problem) :-
    gdpr_compensation_and_liability_input_problems([], []).
test(a_term_that_is_not_a_list_is_not_a_profile) :-
    gdpr_compensation_and_liability_input_problems(profile, [wrong_type(profile)]).
test(a_repeated_key_is_a_duplicate_only) :-
    gdpr_compensation_and_liability_input_problems([attribute(damage_suffered, true), attribute(damage_suffered, maybe)], [duplicate_key(damage_suffered)]).
test(an_unsure_crisp_key_is_a_wrong_type) :-
    gdpr_compensation_and_liability_input_problems([attribute(involved_in_the_processing, unsure)], [wrong_type(involved_in_the_processing)]).
test(a_key_outside_the_contract_is_unknown) :-
    gdpr_compensation_and_liability_input_problems([attribute(colour, blue)], [unknown_key(colour)]).
test(an_attested_statement_is_well_formed) :-
    gdpr_compensation_and_liability_input_problems([attribute(not_in_any_way_responsible_for_the_event, attested(true, attestation(host, today, proved, none)))], []).
test(an_attestation_holding_a_variable_is_a_wrong_type) :-
    gdpr_compensation_and_liability_input_problems([attribute(not_in_any_way_responsible_for_the_event, attested(true, attestation(host, today, proved, _)))], [wrong_type(not_in_any_way_responsible_for_the_event)]).
test(a_well_formed_profile_is_not_refused, fail) :-
    gdpr_compensation_and_liability_input_problems([attribute(party_role, processor)], [_|_]).

:- end_module(kernel).
