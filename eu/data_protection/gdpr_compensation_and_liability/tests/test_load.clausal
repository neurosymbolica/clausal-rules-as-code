% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_load.clausal -- LOAD: the shared floor of
% eu/data_protection/gdpr_compensation_and_liability loads (kernel and
% citations), the result terms the order pins build and destructure, the
% four final result atoms are distinct, and the real citation records of
% Regulation (EU) 2016/679 Art 82(1) to (3) resolve.
% The determination slices do not exist yet at this phase, so this test
% references only the kernel and the citations module.
% Run: cd <corpus root> && python -m clausal.testing \
%      eu/data_protection/gdpr_compensation_and_liability/tests/test_load.clausal
% =====================================================================
:- module(test_load, []).
:- use_module(eu/data_protection/gdpr_compensation_and_liability/kernel, [gdpr_compensation_and_liability_input_problems/2]).
:- use_module(eu/data_protection/gdpr_compensation_and_liability/citations, [citation/2, implements/1]).

% ---- the final result atoms are distinct ------------------------
test(the_final_result_atoms_are_distinct) :-
    dif(right_not_established, not_liable_for_damage),
    dif(right_not_established, exempt_from_liability),
    dif(right_not_established, liable_for_damage),
    dif(not_liable_for_damage, exempt_from_liability),
    dif(not_liable_for_damage, liable_for_damage),
    dif(exempt_from_liability, liable_for_damage).

test(the_party_role_atoms_are_distinct) :-
    dif(controller, processor).

test(the_judgement_values_are_distinct) :-
    dif(true, unsure),
    dif(false, unsure),
    dif(true, false).

test(the_markers_are_distinct) :-
    dif(absent, not_attempted).

% ---- the slice verdict term builds and destructures --------------
test(the_verdict_term_carries_status_and_citations) :-
    Verdict = gdpr_compensation_and_liability_verdict(liable_for_damage, [cite(eu_reg_2016_679_art_82_1), cite(eu_reg_2016_679_art_82_2), cite(eu_reg_2016_679_art_82_3)]),
    Verdict = gdpr_compensation_and_liability_verdict(Status, Citations),
    Status == liable_for_damage,
    Citations == [cite(eu_reg_2016_679_art_82_1), cite(eu_reg_2016_679_art_82_2), cite(eu_reg_2016_679_art_82_3)].

test(a_final_verdict_does_not_unify_with_another_final_atom, fail) :-
    gdpr_compensation_and_liability_verdict(liable_for_damage, []) = gdpr_compensation_and_liability_verdict(exempt_from_liability, []).

% ---- the non-final result compounds build and destructure --------
test(the_indeterminate_term_names_one_key) :-
    Result = indeterminate([damage_suffered]),
    Result = indeterminate([MissingKey]),
    MissingKey == damage_suffered.

test(the_open_textured_referral_destructures) :-
    Pairs = [damage_suffered-unsure, infringement_of_the_regulation_occurred-true, damage_resulted_from_the_infringement-true],
    Result = needs_legal_review(open_textured(damage_suffered, cite(eu_reg_2016_679_art_82_1)), [inputs_relied_on(Pairs)]),
    Result = needs_legal_review(open_textured(Input, cite(CitationKey)), [inputs_relied_on(ReliedPairs)]),
    Input == damage_suffered,
    CitationKey == eu_reg_2016_679_art_82_1,
    ReliedPairs == Pairs.

test(the_cross_reference_referral_destructures) :-
    Pairs = [damage_suffered-true, infringement_of_the_regulation_occurred-true, damage_resulted_from_the_infringement-true, not_in_any_way_responsible_for_the_event-absent],
    Result = needs_legal_review(cross_reference_unresolved(cite(eu_reg_2016_679_art_82_3), cite(non_responsibility_statement)), [resolution(cite(non_responsibility_statement), not_attempted), inputs_relied_on(Pairs)]),
    Result = needs_legal_review(cross_reference_unresolved(cite(CitationKey), cite(TargetKey)), [resolution(cite(ResolvedTarget), ResolutionStatus), inputs_relied_on(ReliedPairs)]),
    CitationKey == eu_reg_2016_679_art_82_3,
    TargetKey == non_responsibility_statement,
    ResolvedTarget == non_responsibility_statement,
    ResolutionStatus == not_attempted,
    ReliedPairs == Pairs.

test(the_basis_copies_the_attested_statement) :-
    Attested = attested(false, attestation(host, at_time, statement_given, url(address, retrieved_at))),
    Basis = [outside_fact(not_in_any_way_responsible_for_the_event, Attested)],
    Basis = [outside_fact(FactKey, attested(AttestedValue, attestation(_, _, _, Evidence)))],
    FactKey == not_in_any_way_responsible_for_the_event,
    AttestedValue == false,
    Evidence == url(address, retrieved_at).

test(the_input_problems_term_destructures) :-
    Result = input_problems([duplicate_key(damage_suffered), wrong_type(party_role), unknown_key(colour)]),
    Result = input_problems([First, Second, Third]),
    First == duplicate_key(damage_suffered),
    Second == wrong_type(party_role),
    Third == unknown_key(colour).

% ---- the kernel's input check loads and answers -----------------
test(the_input_check_accepts_a_well_formed_profile) :-
    gdpr_compensation_and_liability_input_problems([attribute(party_role, processor), attribute(processor_breached_obligations_directed_to_processors, true), attribute(damage_suffered, true)], []).

test(the_input_check_refuses_a_term_that_is_not_a_list) :-
    gdpr_compensation_and_liability_input_problems(not_a_profile, [wrong_type(profile)]).

test(the_input_check_names_a_wrong_party_role) :-
    gdpr_compensation_and_liability_input_problems([attribute(party_role, data_subject)], [wrong_type(party_role)]).

test(a_wrong_party_role_is_not_accepted, fail) :-
    gdpr_compensation_and_liability_input_problems([attribute(party_role, data_subject)], []).

% ---- the real citation records resolve --------------------------
test(the_right_to_compensation_record_resolves) :-
    citation(eu_reg_2016_679_art_82_1, _Record).

test(the_liability_limbs_record_resolves) :-
    citation(eu_reg_2016_679_art_82_2, _Record).

test(the_exemption_record_resolves) :-
    citation(eu_reg_2016_679_art_82_3, _Record).

test(the_outside_fact_target_record_resolves) :-
    citation(non_responsibility_statement, _Record).

test(the_provenance_marker_holds_for_a_recorded_key) :-
    implements(eu_reg_2016_679_art_82_1).

test(a_shortened_citation_key_is_not_recorded, fail) :-
    citation(gdpr_art_82_1, _Record).

:- end_module(test_load).
