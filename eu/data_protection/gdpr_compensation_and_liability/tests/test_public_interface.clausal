% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_public_interface.clausal -- the package's PUBLIC surface, exercised
% through the generated package facade (what an external caller sees).
% Each fixture subject resolves to its EXPECTED verdict (status and
% citations), the checklist of each well-formed subject is non-empty and
% cited per item, and every near-miss control gets a different verdict
% from its positive case.
% Run: python -m clausal.testing eu/data_protection/gdpr_compensation_and_liability/tests/test_public_interface.clausal
% =====================================================================
:- module(test_public_interface, []).
:- use_module(eu/data_protection/gdpr_compensation_and_liability, [
    compensation_liability/4,
    decide_gdpr_compensation_and_liability/2,
    gdpr_compensation_and_liability_status/2,
    gdpr_compensation_and_liability_checklist/2,
    gdpr_compensation_and_liability_decision_resolvable/1,
    gdpr_compensation_and_liability_status_values/1,
    gdpr_compensation_and_liability_subject/1,
    gdpr_compensation_and_liability_profile_for/2,
    gdpr_compensation_and_liability_assess/2
]).

% ---- the expected verdict of every fixture subject --------------------
expected_verdict(liable_controller, liable_for_damage, [cite(eu_reg_2016_679_art_82_1), cite(eu_reg_2016_679_art_82_2), cite(eu_reg_2016_679_art_82_3)]).
expected_verdict(exempt_controller, exempt_from_liability, [cite(eu_reg_2016_679_art_82_2), cite(eu_reg_2016_679_art_82_3)]).
expected_verdict(liable_processor_breach, liable_for_damage, [cite(eu_reg_2016_679_art_82_1), cite(eu_reg_2016_679_art_82_2), cite(eu_reg_2016_679_art_82_3)]).
expected_verdict(not_liable_processor, not_liable_for_damage, [cite(eu_reg_2016_679_art_82_2)]).
expected_verdict(liable_processor_instructions, liable_for_damage, [cite(eu_reg_2016_679_art_82_1), cite(eu_reg_2016_679_art_82_2), cite(eu_reg_2016_679_art_82_3)]).
expected_verdict(indeterminate_processor_ground_absent, indeterminate([processor_acted_outside_or_contrary_to_lawful_instructions]), []).
expected_verdict(not_liable_uninvolved_controller, not_liable_for_damage, [cite(eu_reg_2016_679_art_82_2)]).
expected_verdict(right_not_established_no_damage, right_not_established, [cite(eu_reg_2016_679_art_82_1)]).
expected_verdict(right_not_established_no_infringement, right_not_established, [cite(eu_reg_2016_679_art_82_1)]).
expected_verdict(right_not_established_no_causation, right_not_established, [cite(eu_reg_2016_679_art_82_1)]).
expected_verdict(right_not_established_outside_caller, right_not_established, [cite(eu_reg_2016_679_art_82_1)]).
expected_verdict(indeterminate_judgement_absent, indeterminate([damage_resulted_from_the_infringement]), []).
expected_verdict(indeterminate_role_absent, indeterminate([party_role]), []).
expected_verdict(indeterminate_involvement_absent, indeterminate([involved_in_the_processing]), []).
expected_verdict(referred_outside_unsure, needs_legal_review(open_textured(infringement_of_the_regulation_occurred, cite(eu_reg_2016_679_art_82_1)), [inputs_relied_on([damage_suffered-true, infringement_of_the_regulation_occurred-unsure, damage_resulted_from_the_infringement-true])]), []).
expected_verdict(referred_statement_absent, needs_legal_review(cross_reference_unresolved(cite(eu_reg_2016_679_art_82_3), cite(non_responsibility_statement)), [resolution(cite(non_responsibility_statement), not_attempted), inputs_relied_on([damage_suffered-true, infringement_of_the_regulation_occurred-true, damage_resulted_from_the_infringement-true, not_in_any_way_responsible_for_the_event-absent])]), []).
expected_verdict(referred_inside_unsure, needs_legal_review(open_textured(damage_suffered, cite(eu_reg_2016_679_art_82_1)), [inputs_relied_on([damage_suffered-unsure, infringement_of_the_regulation_occurred-true, damage_resulted_from_the_infringement-true])]), []).
expected_verdict(input_problem_unknown_key, input_problems([unknown_key(colour)]), []).
expected_verdict(input_problem_wrong_type, input_problems([wrong_type(involved_in_the_processing)]), []).
expected_verdict(input_problem_duplicate_key, input_problems([duplicate_key(damage_suffered)]), []).

% ---- the near-miss pairs: positive case, one-key control --------------
near_miss(liable_controller, exempt_controller).
near_miss(liable_controller, not_liable_uninvolved_controller).
near_miss(liable_controller, right_not_established_no_damage).
near_miss(liable_controller, right_not_established_no_infringement).
near_miss(liable_controller, right_not_established_no_causation).
near_miss(liable_controller, referred_statement_absent).
near_miss(liable_controller, referred_inside_unsure).
near_miss(liable_controller, indeterminate_judgement_absent).
near_miss(liable_controller, indeterminate_role_absent).
near_miss(liable_controller, indeterminate_involvement_absent).
near_miss(liable_controller, input_problem_unknown_key).
near_miss(liable_controller, input_problem_wrong_type).
near_miss(liable_controller, input_problem_duplicate_key).
near_miss(liable_processor_breach, not_liable_processor).
near_miss(liable_processor_instructions, indeterminate_processor_ground_absent).
near_miss(not_liable_uninvolved_controller, referred_outside_unsure).
near_miss(not_liable_uninvolved_controller, right_not_established_outside_caller).

% ---- the subjects whose profile passes the input check ----------------
well_formed_subject(liable_controller).
well_formed_subject(exempt_controller).
well_formed_subject(liable_processor_breach).
well_formed_subject(not_liable_processor).
well_formed_subject(liable_processor_instructions).
well_formed_subject(indeterminate_processor_ground_absent).
well_formed_subject(not_liable_uninvolved_controller).
well_formed_subject(right_not_established_no_damage).
well_formed_subject(right_not_established_no_infringement).
well_formed_subject(right_not_established_no_causation).
well_formed_subject(right_not_established_outside_caller).
well_formed_subject(indeterminate_judgement_absent).
well_formed_subject(indeterminate_role_absent).
well_formed_subject(indeterminate_involvement_absent).
well_formed_subject(referred_outside_unsure).
well_formed_subject(referred_statement_absent).
well_formed_subject(referred_inside_unsure).

resolves_as_expected(Subject) :-
    expected_verdict(Subject, Status, Citations),
    findall(Verdict, gdpr_compensation_and_liability_assess(Subject, Verdict), Verdicts),
    Verdicts == [gdpr_compensation_and_liability_verdict(Status, Citations)].

near_miss_differs(Positive-Control) :-
    gdpr_compensation_and_liability_assess(Positive, gdpr_compensation_and_liability_verdict(PositiveStatus, _)),
    gdpr_compensation_and_liability_assess(Control, gdpr_compensation_and_liability_verdict(ControlStatus, _)),
    PositiveStatus \== ControlStatus.

cited_item(item(_, _, cite(Key))) :-
    atom(Key).

checklist_is_cited(Subject) :-
    gdpr_compensation_and_liability_profile_for(Subject, Profile),
    gdpr_compensation_and_liability_checklist(Profile, [FirstItem|OtherItems]),
    maplist(cited_item, [FirstItem|OtherItems]).

final_status_is_listed(Subject) :-
    gdpr_compensation_and_liability_assess(Subject, gdpr_compensation_and_liability_verdict(Status, _)),
    gdpr_compensation_and_liability_status_values(StatusValues),
    member(Status, StatusValues).

% compensation_liability/4 through the facade, on a fixture profile.
liability_of(Subject, Result, Basis, Citations) :-
    gdpr_compensation_and_liability_profile_for(Subject, Profile),
    compensation_liability(Profile, Result, Basis, Citations).

% ---- the sweep over every subject ---------------------------------------
test(every_subject_has_an_expected_verdict_and_back) :-
    findall(Subject, gdpr_compensation_and_liability_subject(Subject), Subjects),
    findall(Subject, expected_verdict(Subject, _, _), ExpectedSubjects),
    msort(Subjects, SortedSubjects),
    msort(ExpectedSubjects, SortedExpected),
    SortedSubjects == SortedExpected.
test(every_subject_resolves_to_its_expected_verdict) :-
    findall(Subject, gdpr_compensation_and_liability_subject(Subject), Subjects),
    Subjects = [_|_],
    maplist(resolves_as_expected, Subjects).
test(every_near_miss_control_gets_a_different_verdict) :-
    findall(Positive-Control, near_miss(Positive, Control), Pairs),
    Pairs = [_|_],
    maplist(near_miss_differs, Pairs).
test(every_well_formed_subject_has_a_cited_non_empty_checklist) :-
    findall(Subject, well_formed_subject(Subject), Subjects),
    maplist(checklist_is_cited, Subjects).
test(every_final_subject_is_in_the_status_vocabulary) :-
    maplist(final_status_is_listed, [liable_controller, exempt_controller, liable_processor_breach, not_liable_processor, liable_processor_instructions, not_liable_uninvolved_controller, right_not_established_no_damage, right_not_established_outside_caller]).

% ---- compensation_liability/4: one case per outcome, with its basis -----
test(compensation_liability_gives_liable_for_damage_with_the_attested_basis) :-
    liability_of(liable_controller, Result, Basis, Citations),
    Result == liable_for_damage,
    Basis == [outside_fact(not_in_any_way_responsible_for_the_event, attested(false, attestation(host, at, reason, none)))],
    Citations == [cite(eu_reg_2016_679_art_82_1), cite(eu_reg_2016_679_art_82_2), cite(eu_reg_2016_679_art_82_3)].
test(compensation_liability_gives_exempt_from_liability_copying_the_document_evidence) :-
    liability_of(exempt_controller, Result, Basis, Citations),
    Result == exempt_from_liability,
    Basis == [outside_fact(not_in_any_way_responsible_for_the_event, attested(true, attestation(host, at, reason, document(upload_identifier, checksum))))],
    Citations == [cite(eu_reg_2016_679_art_82_2), cite(eu_reg_2016_679_art_82_3)].
test(compensation_liability_exempt_basis_holds_the_document) :-
    liability_of(exempt_controller, exempt_from_liability, [outside_fact(_, attested(true, attestation(_, _, _, document(UploadIdentifier, Checksum))))], _),
    UploadIdentifier == upload_identifier,
    Checksum == checksum.
test(compensation_liability_liable_basis_holds_no_document, fail) :-
    liability_of(liable_controller, _, [outside_fact(_, attested(_, attestation(_, _, _, document(_, _))))], _).
test(compensation_liability_gives_not_liable_for_damage) :-
    liability_of(not_liable_processor, not_liable_for_damage, [], [cite(eu_reg_2016_679_art_82_2)]).
test(compensation_liability_gives_right_not_established) :-
    liability_of(right_not_established_no_infringement, right_not_established, [], [cite(eu_reg_2016_679_art_82_1)]).
test(compensation_liability_gives_indeterminate_naming_one_key) :-
    liability_of(indeterminate_role_absent, indeterminate([party_role]), [], []).
test(compensation_liability_gives_an_open_textured_referral) :-
    liability_of(referred_inside_unsure, needs_legal_review(open_textured(damage_suffered, cite(eu_reg_2016_679_art_82_1)), [inputs_relied_on([damage_suffered-unsure, infringement_of_the_regulation_occurred-true, damage_resulted_from_the_infringement-true])]), [], []).
test(compensation_liability_gives_a_cross_reference_referral) :-
    liability_of(referred_statement_absent, needs_legal_review(cross_reference_unresolved(cite(eu_reg_2016_679_art_82_3), cite(non_responsibility_statement)), [resolution(cite(non_responsibility_statement), not_attempted), inputs_relied_on([damage_suffered-true, infringement_of_the_regulation_occurred-true, damage_resulted_from_the_infringement-true, not_in_any_way_responsible_for_the_event-absent])]), [], []).
test(compensation_liability_gives_input_problems) :-
    liability_of(input_problem_duplicate_key, input_problems([duplicate_key(damage_suffered)]), [], []).
test(compensation_liability_gives_exactly_one_answer_per_subject) :-
    findall(Subject, gdpr_compensation_and_liability_subject(Subject), Subjects),
    maplist(has_one_liability_answer, Subjects).
test(compensation_liability_referral_context_holds_the_resolution) :-
    liability_of(referred_statement_absent, needs_legal_review(_, Context), _, _),
    member(resolution(cite(non_responsibility_statement), not_attempted), Context).
% provenance/2 is an optional, unscored context item: this order writes none.
test(compensation_liability_referral_context_carries_no_provenance_item, fail) :-
    liability_of(referred_statement_absent, needs_legal_review(_, Context), _, _),
    member(provenance(_, _), Context).
test(a_provenance_item_builds_and_destructures) :-
    Item = provenance(eu_reg_2016_679_art_82_3, attested),
    Item = provenance(CitationKey, Kind),
    CitationKey == eu_reg_2016_679_art_82_3,
    Kind == attested.

has_one_liability_answer(Subject) :-
    gdpr_compensation_and_liability_profile_for(Subject, Profile),
    findall(Result-Basis-Citations, compensation_liability(Profile, Result, Basis, Citations), Answers),
    length(Answers, 1).

% ---- per subject: the concrete status atom, paired with a negative -------
test(liable_controller_is_liable_for_damage) :-
    gdpr_compensation_and_liability_assess(liable_controller, gdpr_compensation_and_liability_verdict(liable_for_damage, _)).
test(liable_controller_is_not_exempt, fail) :-
    gdpr_compensation_and_liability_assess(liable_controller, gdpr_compensation_and_liability_verdict(exempt_from_liability, _)).
test(exempt_controller_is_exempt_from_liability) :-
    gdpr_compensation_and_liability_assess(exempt_controller, gdpr_compensation_and_liability_verdict(exempt_from_liability, _)).
test(exempt_controller_is_not_liable_for_damage, fail) :-
    gdpr_compensation_and_liability_assess(exempt_controller, gdpr_compensation_and_liability_verdict(liable_for_damage, _)).
test(liable_processor_breach_is_liable_for_damage) :-
    gdpr_compensation_and_liability_assess(liable_processor_breach, gdpr_compensation_and_liability_verdict(liable_for_damage, _)).
test(not_liable_processor_is_not_liable_for_damage) :-
    gdpr_compensation_and_liability_assess(not_liable_processor, gdpr_compensation_and_liability_verdict(not_liable_for_damage, _)).
test(not_liable_processor_is_not_liable_status_only, fail) :-
    gdpr_compensation_and_liability_assess(not_liable_processor, gdpr_compensation_and_liability_verdict(liable_for_damage, _)).
test(liable_processor_instructions_is_liable_for_damage) :-
    gdpr_compensation_and_liability_assess(liable_processor_instructions, gdpr_compensation_and_liability_verdict(liable_for_damage, _)).
test(a_processor_with_one_ground_absent_names_it) :-
    gdpr_compensation_and_liability_assess(indeterminate_processor_ground_absent, gdpr_compensation_and_liability_verdict(indeterminate([processor_acted_outside_or_contrary_to_lawful_instructions]), [])).
test(an_uninvolved_controller_is_not_liable_for_damage) :-
    gdpr_compensation_and_liability_assess(not_liable_uninvolved_controller, gdpr_compensation_and_liability_verdict(not_liable_for_damage, [cite(eu_reg_2016_679_art_82_2)])).
test(an_uninvolved_controller_is_not_liable_status_only, fail) :-
    gdpr_compensation_and_liability_assess(not_liable_uninvolved_controller, gdpr_compensation_and_liability_verdict(liable_for_damage, _)).
test(no_damage_is_right_not_established) :-
    gdpr_compensation_and_liability_assess(right_not_established_no_damage, gdpr_compensation_and_liability_verdict(right_not_established, [cite(eu_reg_2016_679_art_82_1)])).
test(no_infringement_is_right_not_established) :-
    gdpr_compensation_and_liability_assess(right_not_established_no_infringement, gdpr_compensation_and_liability_verdict(right_not_established, _)).
test(no_causation_is_right_not_established) :-
    gdpr_compensation_and_liability_assess(right_not_established_no_causation, gdpr_compensation_and_liability_verdict(right_not_established, _)).
test(an_outside_caller_with_a_false_condition_is_right_not_established) :-
    gdpr_compensation_and_liability_assess(right_not_established_outside_caller, gdpr_compensation_and_liability_verdict(right_not_established, _)).
test(an_outside_caller_with_a_false_condition_is_not_not_liable, fail) :-
    gdpr_compensation_and_liability_assess(right_not_established_outside_caller, gdpr_compensation_and_liability_verdict(not_liable_for_damage, _)).
test(an_absent_judgement_is_named) :-
    gdpr_compensation_and_liability_assess(indeterminate_judgement_absent, gdpr_compensation_and_liability_verdict(indeterminate([damage_resulted_from_the_infringement]), [])).
test(an_absent_role_is_named) :-
    gdpr_compensation_and_liability_assess(indeterminate_role_absent, gdpr_compensation_and_liability_verdict(indeterminate([party_role]), [])).
test(an_absent_involvement_is_named) :-
    gdpr_compensation_and_liability_assess(indeterminate_involvement_absent, gdpr_compensation_and_liability_verdict(indeterminate([involved_in_the_processing]), [])).
test(an_outside_caller_with_an_unsure_judgement_is_referred) :-
    gdpr_compensation_and_liability_assess(referred_outside_unsure, gdpr_compensation_and_liability_verdict(needs_legal_review(open_textured(infringement_of_the_regulation_occurred, cite(eu_reg_2016_679_art_82_1)), _), [])).
test(an_outside_caller_with_an_unsure_judgement_is_not_not_liable, fail) :-
    gdpr_compensation_and_liability_assess(referred_outside_unsure, gdpr_compensation_and_liability_verdict(not_liable_for_damage, _)).
test(an_absent_statement_is_a_cross_reference_referral) :-
    gdpr_compensation_and_liability_assess(referred_statement_absent, gdpr_compensation_and_liability_verdict(needs_legal_review(cross_reference_unresolved(cite(eu_reg_2016_679_art_82_3), cite(non_responsibility_statement)), _), [])).
test(an_absent_statement_is_not_liable_for_damage, fail) :-
    gdpr_compensation_and_liability_assess(referred_statement_absent, gdpr_compensation_and_liability_verdict(liable_for_damage, _)).
test(an_inside_caller_with_an_unsure_judgement_is_referred) :-
    gdpr_compensation_and_liability_assess(referred_inside_unsure, gdpr_compensation_and_liability_verdict(needs_legal_review(open_textured(damage_suffered, cite(eu_reg_2016_679_art_82_1)), _), [])).
test(an_unknown_key_is_an_input_problem) :-
    gdpr_compensation_and_liability_assess(input_problem_unknown_key, gdpr_compensation_and_liability_verdict(input_problems([unknown_key(colour)]), [])).
test(an_input_problem_gets_no_final_answer, fail) :-
    gdpr_compensation_and_liability_assess(input_problem_unknown_key, gdpr_compensation_and_liability_verdict(liable_for_damage, _)).
test(a_wrong_type_is_an_input_problem) :-
    gdpr_compensation_and_liability_assess(input_problem_wrong_type, gdpr_compensation_and_liability_verdict(input_problems([wrong_type(involved_in_the_processing)]), [])).
test(a_duplicate_key_is_an_input_problem) :-
    gdpr_compensation_and_liability_assess(input_problem_duplicate_key, gdpr_compensation_and_liability_verdict(input_problems([duplicate_key(damage_suffered)]), [])).

% ---- the other public predicates ------------------------------------
test(the_status_projection_agrees_with_the_verdict) :-
    gdpr_compensation_and_liability_profile_for(exempt_controller, Profile),
    gdpr_compensation_and_liability_status(Profile, exempt_from_liability),
    decide_gdpr_compensation_and_liability(Profile, gdpr_compensation_and_liability_verdict(exempt_from_liability, _)).
test(every_subject_is_resolvable) :-
    findall(Subject, gdpr_compensation_and_liability_subject(Subject), Subjects),
    maplist(subject_is_resolvable, Subjects).
test(the_checklist_of_the_liable_controller_is_all_met) :-
    gdpr_compensation_and_liability_profile_for(liable_controller, Profile),
    gdpr_compensation_and_liability_checklist(Profile, Items),
    findall(Status, member(item(_, Status, _), Items), Statuses),
    Statuses == [met, met, met, met, met].
test(the_checklist_of_the_exempt_controller_shows_the_exemption) :-
    gdpr_compensation_and_liability_profile_for(exempt_controller, Profile),
    gdpr_compensation_and_liability_checklist(Profile, Items),
    member(item(no_exemption_under_article_82_3, unmet(exempt_on_attested_statement), cite(eu_reg_2016_679_art_82_3)), Items).
test(the_baseline_fixture_is_liable_and_has_a_checklist) :-
    gdpr_compensation_and_liability_profile_for(todo_baseline_subject, Profile),
    gdpr_compensation_and_liability_status(Profile, liable_for_damage),
    gdpr_compensation_and_liability_checklist(Profile, [_|_]),
    gdpr_compensation_and_liability_decision_resolvable(Profile).

subject_is_resolvable(Subject) :-
    gdpr_compensation_and_liability_profile_for(Subject, Profile),
    gdpr_compensation_and_liability_decision_resolvable(Profile).

:- end_module(test_public_interface).
