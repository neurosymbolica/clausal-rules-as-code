% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% queries.clausal -- QUERY-COMBINATOR layer for eu/data_protection/gdpr_compensation_and_liability.
% A TOP-LAYER consumer: it imports the determination slice's PUBLIC
% predicates it calls, and nothing else.
%
% Query types this domain serves (manifest query_interface):
%   #2 eligibility   decide_gdpr_compensation_and_liability/2 (slice): the
%                    verdict of compensation_liability/4 with its CITATIONS,
%                    and the cited checklist
%                    gdpr_compensation_and_liability_checklist/2.
%                    Mapping: liable_for_damage is the positive verdict;
%                    exempt_from_liability, not_liable_for_damage and
%                    right_not_established are negative; indeterminate/1,
%                    needs_legal_review/2 and input_problems/1 are the
%                    non-final (indeterminate) answers.
%   #7 justification gdpr_compensation_and_liability_checklist/2 (slice):
%                    every item carries cite(...) provenance, met items
%                    included.
%   #16 what-if      gdpr_compensation_and_liability_what_if/4 (here):
%                    override one key, re-evaluate.
%
% gdpr_compensation_and_liability_profile_keys/1: top-level profile key schema
% gdpr_compensation_and_liability_input_problems/2: the problems a profile has ([] = none)
%
% The open-textured judgements are never decided here: a what-if only
% re-asks the slice with the caller's hypothetical judgement or statement.
%
% The profile of this order is an ATTRIBUTE LIST [attribute(KEY, VALUE), ...],
% not a dict, so the override is the list plumbing attribute_override/4
% below: every entry of the key is replaced by the one new entry, so the
% hypothesis never carries a duplicate key. (kit override_key/4 is written
% for dict profiles; the working notes (not published) records the attribute-list override as a
% candidate for kit promotion.) Plumbing only: no statutory marker.
% =====================================================================

:- module(queries, [
    gdpr_compensation_and_liability_profile_keys/1,
    gdpr_compensation_and_liability_input_problems/2,
    gdpr_compensation_and_liability_what_if/4
]).

:- use_module(eu/data_protection/gdpr_compensation_and_liability/kernel, [gdpr_compensation_and_liability_input_problems/2]).
:- use_module(eu/data_protection/gdpr_compensation_and_liability/gdpr_compensation_and_liability, [gdpr_compensation_and_liability_status/2]).

% schema of top-level profile keys: the keys of the order's typed input contract, in its order
gdpr_compensation_and_liability_profile_keys([party_role, involved_in_the_processing, processor_breached_obligations_directed_to_processors, processor_acted_outside_or_contrary_to_lawful_instructions, damage_suffered, infringement_of_the_regulation_occurred, damage_resulted_from_the_infringement, not_in_any_way_responsible_for_the_event]).

% #16 what-if: re-evaluate with one key hypothetically overridden
gdpr_compensation_and_liability_what_if(Profile, OverriddenKey, NewValue, NewStatus) :-
    attribute_override(Profile, OverriddenKey, NewValue, Hypothesis),
    gdpr_compensation_and_liability_status(Hypothesis, NewStatus).

% attribute_override(Profile, Key, Value, Hypothesis): every attribute(Key, _)
% is dropped and attribute(Key, Value) is added once at the end.
attribute_override([], Key, Value, [attribute(Key, Value)]).
attribute_override([attribute(ElementKey, _)|Elements], Key, Value, Hypothesis) :-
    ElementKey == Key,
    attribute_override(Elements, Key, Value, Hypothesis).
attribute_override([attribute(ElementKey, ElementValue)|Elements], Key, Value, [attribute(ElementKey, ElementValue)|Hypothesis]) :-
    ElementKey \== Key,
    attribute_override(Elements, Key, Value, Hypothesis).

test(the_override_replaces_an_existing_entry) :-
    attribute_override([attribute(damage_suffered, true), attribute(party_role, controller)], damage_suffered, false, Hypothesis),
    Hypothesis == [attribute(party_role, controller), attribute(damage_suffered, false)].
test(the_override_adds_an_absent_entry) :-
    attribute_override([], party_role, processor, Hypothesis),
    Hypothesis == [attribute(party_role, processor)].
test(the_override_collapses_a_duplicate_key) :-
    attribute_override([attribute(damage_suffered, true), attribute(damage_suffered, false)], damage_suffered, unsure, Hypothesis),
    Hypothesis == [attribute(damage_suffered, unsure)].
test(a_false_judgement_by_what_if_refutes_the_right) :-
    gdpr_compensation_and_liability_what_if([attribute(damage_suffered, true)], damage_suffered, false, right_not_established).
test(a_true_judgement_by_what_if_is_not_refuted, fail) :-
    gdpr_compensation_and_liability_what_if([attribute(damage_suffered, false)], damage_suffered, true, right_not_established).
test(a_true_judgement_by_what_if_names_the_next_key) :-
    gdpr_compensation_and_liability_what_if([attribute(damage_suffered, false)], damage_suffered, true, indeterminate([infringement_of_the_regulation_occurred])).
test(the_key_schema_has_eight_keys) :-
    gdpr_compensation_and_liability_profile_keys(Keys),
    length(Keys, 8).

:- end_module(queries).
