% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% kernel.clausal -- the SHARED FLOOR for eu/data_protection/gdpr_information_duties_timing (deontic family).
% DAG root of the determination-slices layout:
%   kernel -> citations -> parameters -> information_deadline_basis
%          -> information_timing_verdict -> queries -> fixtures -> facade
%
% Sources (the law the slices formalize; this floor decides none of it):
%   - Regulation (EU) 2016/679 (GDPR) Art 13(1), chapeau (consolidated text
%     02016R0679-20160504, unit parag_013.001): information 'at the time
%     when personal data are obtained';
%   - Regulation (EU) 2016/679 (GDPR) Art 14(3)(a), (b) and (c) (units
%     parag_014.003, point_014.003_a to point_014.003_c): the three upper
%     bounds, the earliest applicable one binding (Q1, ruled 2026-11-01);
%   - Regulation (EEC, Euratom) No 1182/71 Art 3(1) second subparagraph,
%     Art 3(2)(c) and Art 3(4) (CELEX 31971R1182), applied to the GDPR by
%     the G4 order for the one-month period of Art 14(3)(a).
%
% WHAT LIVES HERE, and why:
%   1. gdpr_information_duties_timing_input_problems/2 -- the input check
%      (K) written by the scaffold from the typed input contract; every
%      relation (D), (E), (F) calls it first. Kept exactly as written.
%   2. gdpr_information_duties_timing_date_order/3 -- the comparison of two
%      date(Year, Month, Day) terms by Year, then Month, then Day, as
%      integers (reading 5: dates are compared by value, never as strings
%      or floats). Both slices call it: information_deadline_basis to pick
%      the earliest applicable limb of Art 14(3), information_timing_verdict
%      to compare provision_date with DEADLINE. It is comparison plumbing,
%      not a statutory condition, and the kernel sits BELOW citations in
%      the DAG, so it carries no implements/1 marker: the slice clauses
%      that apply it to a statutory bound carry the marker of that bound.
%   Everything else (the route, the limb dates, the one-month calendar
%   rule, the reasonable-period judgement, the checklists) is owned by the
%   one slice that decides it.
%
% Atoms and data terms need NO declaration and NO import. The result
% terms are RECORDED here so that every file spells them alike:
%
%   information_deadline_basis_verdict(Status, Citations)
%     Status: one of the bare atoms art13_1 | art14_3_a | art14_3_b |
%       art14_3_c (the limb that fixes DEADLINE; on a tie the first of
%       (a), (b), (c)), or the compound indeterminate(MissingKeys)
%       (MissingKeys a non-empty list of bare profile-key atoms in
%       root_exports order, no duplicates), or the compound
%       input_problems(Problems) (Problems the non-empty list of (K)).
%     Citations: [cite(Key)] for the limb of Status, Key one of
%       eu_reg_2016_679_art_13_1 | eu_reg_2016_679_art_14_3_a |
%       eu_reg_2016_679_art_14_3_b | eu_reg_2016_679_art_14_3_c;
%       [] for every non-final Status.
%
%   information_timing_verdict_verdict(Status, Citations)
%     Status: the bare atom timely or late, or a non-final compound:
%       indeterminate(MissingKeys);
%       needs_legal_review(open_textured(provided_within_reasonable_period,
%           cite(eu_reg_2016_679_art_14_3_a)),
%         [inputs_relied_on(Pairs), provenance(Clause, CitationList)])
%         where Pairs are the Key-Value pairs of the judgement keys read
%         (here [provided_within_reasonable_period-unsure]) and the
%         trailing provenance/2 is optional and unscored;
%       input_problems(Problems).
%     Citations: [cite(eu_reg_2016_679_art_13_1)] on the Art 13 route;
%       [cite(K)] for the limb of the basis on the Art 14 route
%       (_a when provided_within_reasonable_period is false); [] for
%       every non-final Status.
%
%   information_deadline/2 answers DEADLINE as date(Year, Month, Day) of
%   bare integers, or indeterminate(MissingKeys), or input_problems(P).
%
%   Checklist rows are formalize_lib item(Id, Status, cite(Key)) terms,
%   Status met | unmet(Reason) | unknown(Keys) | inapplicable.
%
% The bare atom indeterminate is NEVER written (atom-shadowing trap).
% The atoms true and false are the crisp values; unsure is the third
% value of a judgement. No as-of date is carried (Q12).
% =====================================================================

:- module(kernel, [gdpr_information_duties_timing_input_problems/2, gdpr_information_duties_timing_date_order/3]).

:- use_module(library(reif), [memberd_t/3]).

% ---- input checks: the problems a profile has, if any -----------
% gdpr_information_duties_timing_input_problems(Profile, Problems): Problems = [] means the profile can be
% judged. Written from the order's typed input contract
% (input_contract.types.profile: attribute_list).
% Each public query calls this check first: it gives its normal answer only when
% Problems = [], and when Problems is not [] it gives the answer the order states for
% a profile with input problems.
% It gives exactly one answer for every Profile, and the answer is ground:
% - a Profile that is not an attribute list [attribute(Key, Value), ...] with a ground
%   Key in every item gives [wrong_type(profile)];
% - otherwise, for each contract key in the contract's key order, duplicate_key(Key) when
%   the key occurs more than once in Profile (whatever its values: none of them is read,
%   so it is never also wrong_type(Key)), else wrong_type(Key) when its one value is
%   outside its type; then unknown_key(Key) for each key outside the contract, in the
%   order of its first occurrence in Profile. Each key is named once. An absent key is
%   not a problem.
% Every step is complementary clauses: exactly one clause holds for each input.
gdpr_information_duties_timing_input_problems(Profile, Problems) :-
    attribute_list_t(Profile, IsAttributeList),
    profile_problems(IsAttributeList, Profile, Problems).

profile_problems(false, _, [wrong_type(profile)]).
profile_problems(true, Profile, Problems) :-
    Keys = [personal_data_collected_from_data_subject, items_provided, items_data_subject_already_has, data_protection_officer_designated, processing_based_on_legitimate_interests, recipients_exist, transfer_intended, processing_based_on_consent, automated_decision_making_under_article_22, obtaining_date, provision_date, data_used_for_communication_with_data_subject, first_communication_date, disclosure_to_another_recipient_envisaged, first_disclosure_date, provided_within_reasonable_period, provision_impossible_or_disproportionate_effort, protective_measures_taken, obtaining_or_disclosure_laid_down_by_law, professional_secrecy_obligation_by_law, further_processing_for_another_purpose_intended, further_processing_start_date, further_processing_information_date, further_processing_items_provided, paragraph_2_information_relevant_to_further_processing, public_holidays],
    unknown_keys(Profile, Keys, UnknownKeyProblems),
    key_problems(Keys, Profile, UnknownKeyProblems, Problems).

% The contract: each key and the type of its value.
key_type(personal_data_collected_from_data_subject, boolean).
key_type(items_provided, list(item_provided)).
key_type(items_data_subject_already_has, list(item)).
key_type(data_protection_officer_designated, boolean).
key_type(processing_based_on_legitimate_interests, boolean).
key_type(recipients_exist, boolean).
key_type(transfer_intended, boolean).
key_type(processing_based_on_consent, boolean).
key_type(automated_decision_making_under_article_22, judgement).
key_type(obtaining_date, date).
key_type(provision_date, date).
key_type(data_used_for_communication_with_data_subject, boolean).
key_type(first_communication_date, date).
key_type(disclosure_to_another_recipient_envisaged, boolean).
key_type(first_disclosure_date, date).
key_type(provided_within_reasonable_period, judgement).
key_type(provision_impossible_or_disproportionate_effort, judgement).
key_type(protective_measures_taken, boolean).
key_type(obtaining_or_disclosure_laid_down_by_law, outside_fact).
key_type(professional_secrecy_obligation_by_law, outside_fact).
key_type(further_processing_for_another_purpose_intended, boolean).
key_type(further_processing_start_date, date).
key_type(further_processing_information_date, date).
key_type(further_processing_items_provided, list(item)).
key_type(paragraph_2_information_relevant_to_further_processing, judgement).
key_type(public_holidays, public_holidays_fact).

% attribute_list_t(Term, T): T is true when Term is a list of attribute(Key, Value)
% items, each Key ground; false for anything else, an unbound Term included.
attribute_list_t(Term, false) :-
    var(Term).
attribute_list_t(Term, true) :-
    Term == [].
attribute_list_t(Term, T) :-
    nonvar(Term),
    Term = [Element|Elements],
    attribute_t(Element, ElementIsAttribute),
    attribute_list_t(Elements, ElementsAreAttributes),
    truth_and(ElementIsAttribute, ElementsAreAttributes, T).
attribute_list_t(Term, false) :-
    nonvar(Term),
    Term \== [],
    Term \= [_|_].

attribute_t(Element, false) :-
    var(Element).
attribute_t(Element, T) :-
    nonvar(Element),
    Element = attribute(Key, _),
    term_variables(Key, Variables),
    no_variables_t(Variables, T).
attribute_t(Element, false) :-
    nonvar(Element),
    Element \= attribute(_, _).

no_variables_t([], true).
no_variables_t([_|_], false).

% Unknown keys, in profile order, each once: Known grows by each key named.
unknown_keys([], _, []).
unknown_keys([attribute(Key, _)|Elements], Known, Problems) :-
    memberd_t(Key, Known, IsKnown),
    name_unknown_key(IsKnown, Key, Known, Elements, Problems).

name_unknown_key(true, _, Known, Elements, Problems) :-
    unknown_keys(Elements, Known, Problems).
name_unknown_key(false, Key, Known, Elements, [unknown_key(Key)|Problems]) :-
    unknown_keys(Elements, [Key|Known], Problems).

% Contract keys, in contract order: duplicate_key(Key) when the key occurs more than once
% (none of its values is read), else wrong_type(Key) when its one value is outside the
% key's type. An absent key has no value to check.
key_problems([], _, Problems, Problems).
key_problems([Key|Keys], Profile, LaterProblems, Problems) :-
    key_type(Key, Type),
    key_occurrences(Profile, Key, Occurrences),
    key_problems(Keys, Profile, LaterProblems, KeyProblems),
    name_key_problem(Occurrences, Key, Type, Profile, KeyProblems, Problems).

% key_occurrences(Elements, Key, Occurrences): none, one or many items give Key.
key_occurrences([], _, none).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey == Key,
    key_occurrences(Elements, Key, RestOccurrences),
    one_more_occurrence(RestOccurrences, Occurrences).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey \== Key,
    key_occurrences(Elements, Key, Occurrences).

one_more_occurrence(none, one).
one_more_occurrence(one, many).
one_more_occurrence(many, many).

name_key_problem(none, _, _, _, Problems, Problems).
name_key_problem(many, Key, _, _, Problems, [duplicate_key(Key)|Problems]).
name_key_problem(one, Key, Type, Profile, KeyProblems, Problems) :-
    values_in_type_t(Profile, Key, Type, InType),
    name_wrong_type(InType, Key, KeyProblems, Problems).

name_wrong_type(true, _, Problems, Problems).
name_wrong_type(false, Key, Problems, [wrong_type(Key)|Problems]).

% values_in_type_t(Elements, Key, Type, T): T is true when every value Elements gives Key is
% in Type (true when Elements gives Key none).
values_in_type_t([], _, _, true).
values_in_type_t([attribute(ElementKey, Value)|Elements], Key, Type, T) :-
    ElementKey == Key,
    value_in_type_t(Type, Value, ValueInType),
    values_in_type_t(Elements, Key, Type, RestInType),
    truth_and(ValueInType, RestInType, T).
values_in_type_t([attribute(ElementKey, _)|Elements], Key, Type, T) :-
    ElementKey \== Key,
    values_in_type_t(Elements, Key, Type, T).

% A value with an unbound part is outside every type; a ground one is checked.
value_in_type_t(Type, Value, T) :-
    term_variables(Value, Variables),
    ground_value_in_type_t(Variables, Type, Value, T).

ground_value_in_type_t([_|_], _, _, false).
ground_value_in_type_t([], Type, Value, T) :-
    in_type_t(Type, Value, T).

% in_type_t(Type, Value, T): one clause per type, for a ground Value.
in_type_t(item_provided, Value, T) :-
    in_type_t(enum([controller_identity_and_contact_details, data_protection_officer_contact_details, purposes_and_legal_basis, legitimate_interests, recipients_or_categories_of_recipients, third_country_transfer_information, categories_of_personal_data, storage_period_or_criteria, data_subject_rights, right_to_withdraw_consent, right_to_lodge_complaint, statutory_or_contractual_requirement, source_of_personal_data, automated_decision_making_information]), Value, T).

in_type_t(item, Value, T) :-
    in_type_t(enum([controller_identity_and_contact_details, data_protection_officer_contact_details, purposes_and_legal_basis, legitimate_interests, recipients_or_categories_of_recipients, third_country_transfer_information, categories_of_personal_data, storage_period_or_criteria, data_subject_rights, right_to_withdraw_consent, right_to_lodge_complaint, statutory_or_contractual_requirement, source_of_personal_data, automated_decision_making_information, other_purpose_information]), Value, T).

in_type_t(judgement, Value, T) :-
    in_type_t(one_of([boolean, enum([unsure])]), Value, T).

in_type_t(outside_fact, Value, T) :-
    in_type_t(attested(boolean), Value, T).

in_type_t(public_holidays_fact, Value, T) :-
    in_type_t(attested(list(date)), Value, T).

in_type_t(boolean, Value, T) :-
    memberd_t(Value, [true, false], T).

in_type_t(date, Value, T) :-
    calendar_date_t(Value, T).

in_type_t(enum(Values), Value, T) :-
    memberd_t(Value, Values, T).

in_type_t(one_of(Types), Value, T) :-
    in_some_type_t(Types, Value, T).

in_type_t(list(Type), Value, T) :-
    list_in_type_t(Value, Type, T).

in_type_t(attested(Type), Value, T) :-
    attested_t(Value, Type, T).

truth_and(true, T, T).
truth_and(false, _, false).

% in_some_type_t(Types, Value, T): T is true when Value is in at least one of Types.
in_some_type_t([], _, false).
in_some_type_t([Type|Types], Value, T) :-
    in_type_t(Type, Value, InType),
    in_some_type_t(Types, Value, InAnother),
    truth_or(InType, InAnother, T).

truth_or(true, _, true).
truth_or(false, T, T).

% list_in_type_t(Value, Type, T): T is true when Value is a list whose every element is in Type.
list_in_type_t(Value, _, true) :-
    Value == [].
list_in_type_t([Element|Elements], Type, T) :-
    in_type_t(Type, Element, ElementInType),
    list_in_type_t(Elements, Type, ElementsInType),
    truth_and(ElementInType, ElementsInType, T).
list_in_type_t(Value, _, false) :-
    Value \== [],
    Value \= [_|_].

% attested_t(Value, Type, T): T is true when Value is
% attested(AttestedValue, attestation(By, At, Reason, Evidence)) with AttestedValue in Type.
% By, At, Reason and Evidence come from the host and are not checked.
attested_t(attested(AttestedValue, Attestation), Type, T) :-
    attestation_t(Attestation, IsAttestation),
    attested_value_t(IsAttestation, Type, AttestedValue, T).
attested_t(Value, _, false) :-
    Value \= attested(_, _).

attestation_t(attestation(_, _, _, _), true).
attestation_t(Value, false) :-
    Value \= attestation(_, _, _, _).

attested_value_t(false, _, _, false).
attested_value_t(true, Type, AttestedValue, T) :-
    in_type_t(Type, AttestedValue, T).

% integer_t(Value, T): for a ground Value, T is true when it is an integer and false when it is a
% float, an atom or a compound term.
integer_t(Value, true) :-
    integer(Value).
integer_t(Value, false) :-
    float(Value).
integer_t(Value, false) :-
    atom(Value).
integer_t(Value, false) :-
    compound(Value).

% calendar_date_t(Value, T): T is true when Value is date(Year, Month, DayNumber), three
% integers that name a real day of the Gregorian calendar.
calendar_date_t(date(Year, Month, DayNumber), T) :-
    integer_t(Year, YearIsInteger),
    integer_t(Month, MonthIsInteger),
    integer_t(DayNumber, DayNumberIsInteger),
    truth_and(YearIsInteger, MonthIsInteger, YearAndMonthAreIntegers),
    truth_and(YearAndMonthAreIntegers, DayNumberIsInteger, AllAreIntegers),
    calendar_day_t(AllAreIntegers, Year, Month, DayNumber, T).
calendar_date_t(Value, false) :-
    Value \= date(_, _, _).

calendar_day_t(false, _, _, _, false).
calendar_day_t(true, Year, Month, DayNumber, T) :-
    between_t(1, 12, Month, IsMonth),
    day_of_month_t(IsMonth, Year, Month, DayNumber, T).

day_of_month_t(false, _, _, _, false).
day_of_month_t(true, Year, Month, DayNumber, T) :-
    month_length(Year, Month, Length),
    between_t(1, Length, DayNumber, T).

between_t(Lowest, Highest, Number, true) :-
    Number >= Lowest,
    Number =< Highest.
between_t(Lowest, _, Number, false) :-
    Number < Lowest.
between_t(_, Highest, Number, false) :-
    Number > Highest.

month_length(_, 1, 31).
month_length(Year, 2, Length) :-
    leap_year_t(Year, IsLeapYear),
    february_length(IsLeapYear, Length).
month_length(_, 3, 31).
month_length(_, 4, 30).
month_length(_, 5, 31).
month_length(_, 6, 30).
month_length(_, 7, 31).
month_length(_, 8, 31).
month_length(_, 9, 30).
month_length(_, 10, 31).
month_length(_, 11, 30).
month_length(_, 12, 31).

february_length(true, 29).
february_length(false, 28).

% The remainders are computed first and compared one at a time.
leap_year_t(Year, IsLeapYear) :-
    FourYearRemainder is Year mod 4,
    CenturyRemainder is Year mod 100,
    FourCenturyRemainder is Year mod 400,
    gregorian_leap_year_t(FourYearRemainder, CenturyRemainder, FourCenturyRemainder,
                          IsLeapYear).

gregorian_leap_year_t(_, _, 0, true).
gregorian_leap_year_t(0, CenturyRemainder, _, true) :-
    CenturyRemainder =\= 0.
gregorian_leap_year_t(_, 0, FourCenturyRemainder, false) :-
    FourCenturyRemainder =\= 0.
gregorian_leap_year_t(FourYearRemainder, _, _, false) :-
    FourYearRemainder =\= 0.

% ---- shared: the order of two calendar dates ---------------------
% gdpr_information_duties_timing_date_order(FirstDate, SecondDate, Order): Order is
% before, same or after, comparing date(Year, Month, Day) terms by Year, then Month,
% then Day, each as an integer (reading 5: by value, never as strings or floats).
% Called only on dates the input check has accepted (three integers of a real
% calendar day), so compare/3 orders them numerically. Exactly one solution.
gdpr_information_duties_timing_date_order(
        date(FirstYear, FirstMonth, FirstDay),
        date(SecondYear, SecondMonth, SecondDay),
        Order) :-
    compare(YearComparison, FirstYear, SecondYear),
    compare(MonthComparison, FirstMonth, SecondMonth),
    compare(DayComparison, FirstDay, SecondDay),
    lexicographic_order(YearComparison, MonthComparison, DayComparison, Order).

lexicographic_order((<), _, _, before).
lexicographic_order((>), _, _, after).
lexicographic_order((=), (<), _, before).
lexicographic_order((=), (>), _, after).
lexicographic_order((=), (=), (<), before).
lexicographic_order((=), (=), (=), same).
lexicographic_order((=), (=), (>), after).

% ---- tests ---------------------------------------------------------
test(an_empty_profile_has_no_problem) :-
    gdpr_information_duties_timing_input_problems([], []).
test(a_well_typed_profile_has_no_problem) :-
    gdpr_information_duties_timing_input_problems(
        [attribute(personal_data_collected_from_data_subject, false),
         attribute(obtaining_date, date(2028, 2, 29)),
         attribute(provided_within_reasonable_period, unsure),
         attribute(items_provided, []),
         attribute(public_holidays,
                   attested([date(2027, 2, 1)], attestation(host, moment, reason, none)))],
        []).
test(a_crisp_flag_given_true_has_no_problem) :-
    gdpr_information_duties_timing_input_problems(
        [attribute(personal_data_collected_from_data_subject, true)],
        []).
test(a_crisp_flag_given_unsure_is_wrong_type) :-
    gdpr_information_duties_timing_input_problems(
        [attribute(personal_data_collected_from_data_subject, unsure)],
        [wrong_type(personal_data_collected_from_data_subject)]).
test(a_crisp_flag_given_unsure_is_not_well_formed, fail) :-
    gdpr_information_duties_timing_input_problems(
        [attribute(personal_data_collected_from_data_subject, unsure)],
        []).
test(a_date_that_is_not_a_calendar_day_is_wrong_type) :-
    gdpr_information_duties_timing_input_problems(
        [attribute(obtaining_date, date(2026, 2, 29))],
        [wrong_type(obtaining_date)]).
test(a_leap_day_is_a_calendar_day) :-
    gdpr_information_duties_timing_input_problems(
        [attribute(obtaining_date, date(2028, 2, 29))],
        []).
test(a_repeated_key_is_a_duplicate_only) :-
    gdpr_information_duties_timing_input_problems(
        [attribute(obtaining_date, date(2026, 1, 15)),
         attribute(obtaining_date, not_a_date)],
        [duplicate_key(obtaining_date)]).
test(an_unknown_key_is_named_once) :-
    gdpr_information_duties_timing_input_problems(
        [attribute(as_of_date, first), attribute(as_of_date, second)],
        [unknown_key(as_of_date)]).
test(other_purpose_information_is_not_an_item_provided) :-
    gdpr_information_duties_timing_input_problems(
        [attribute(items_provided, [other_purpose_information])],
        [wrong_type(items_provided)]).
test(a_malformed_holiday_list_is_wrong_type) :-
    gdpr_information_duties_timing_input_problems(
        [attribute(public_holidays,
                   attested([date(2027, 2, 30)], attestation(host, moment, reason, none)))],
        [wrong_type(public_holidays)]).
test(problems_follow_contract_order_then_unknown_keys) :-
    gdpr_information_duties_timing_input_problems(
        [attribute(zebra, 1),
         attribute(provision_date, not_a_date),
         attribute(personal_data_collected_from_data_subject, yes)],
        [wrong_type(personal_data_collected_from_data_subject),
         wrong_type(provision_date),
         unknown_key(zebra)]).
test(a_term_that_is_not_an_attribute_list_is_wrong_type_profile) :-
    gdpr_information_duties_timing_input_problems(profile, [wrong_type(profile)]).
test(the_input_check_has_exactly_one_answer) :-
    findall(Problems,
            gdpr_information_duties_timing_input_problems(
                [attribute(obtaining_date, date(2026, 1, 15))], Problems),
            Answers),
    Answers == [[]].
test(an_earlier_year_is_before) :-
    gdpr_information_duties_timing_date_order(date(2026, 12, 31), date(2027, 1, 1), before).
test(a_later_day_is_after) :-
    gdpr_information_duties_timing_date_order(date(2026, 2, 16), date(2026, 2, 15), after).
test(day_two_is_before_day_fifteen) :-
    gdpr_information_duties_timing_date_order(date(2026, 2, 2), date(2026, 2, 15), before).
test(day_two_is_not_after_day_fifteen, fail) :-
    gdpr_information_duties_timing_date_order(date(2026, 2, 2), date(2026, 2, 15), after).
test(the_same_date_is_same) :-
    gdpr_information_duties_timing_date_order(date(2026, 3, 2), date(2026, 3, 2), same).
test(the_date_order_has_exactly_one_answer) :-
    findall(Order,
            gdpr_information_duties_timing_date_order(date(2026, 3, 2), date(2026, 3, 2), Order),
            Orders),
    Orders == [same].

:- end_module(kernel).
