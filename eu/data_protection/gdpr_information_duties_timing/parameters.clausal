% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% parameters.clausal -- the PROVENANCE records of the sourced figures of
% eu/data_protection/gdpr_information_duties_timing. PROVENANCE ONLY: this file references each figure by
% name and holds no value, and the logic modules do not import it.
%
% If parameters-sources.yaml is the COMMISSIONING REGISTER (its first line
% says so), then for EACH of its keys:
%   1. the VALUE is a fact in the determination slice that READS it
%      (that slice's .clausal file), never here;
%   2. this file holds its provenance record, a fact:
%        parameter_source(<key>, [label-'...', ref-'...', verbatim-'...']).
%      with the verbatim pair OMITTED while the yaml entry is
%      `status: unverified`.
%
% The register lists no commissioned key. One figure of this domain is added
% after it: the one-month period of GDPR Art 14(3)(a), declared once as
% :- constant_value(art_14_3_a_period_months, 1). in the slice that reads it
% (information_deadline_basis.clausal) and counted by the calendar rule of
% Regulation (EEC, Euratom) No 1182/71 Art 3(2)(c).
% =====================================================================

:- module(parameters, [parameter_source/2]).

parameter_source(art_14_3_a_period_months, [
    label-'Regulation (EU) 2016/679 (GDPR) Art 14(3)(a), the one-month upper bound (a period in months, counted by Regulation (EEC, Euratom) No 1182/71 Art 3(2)(c))',
    ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit 02016R0679-20160504#point_014.003_a)',
    verbatim-'but at the latest within one month'
]).

:- end_module(parameters).
