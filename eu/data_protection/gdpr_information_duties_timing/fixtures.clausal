% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% fixtures.clausal -- representative profiles for eu/data_protection/gdpr_information_duties_timing.
% A TOP-LAYER consumer: it imports only the slice predicate it calls. Profile keys,
% subject ids and values are atoms and data terms and need no import.
%
% A profile is an ATTRIBUTE LIST [attribute(Key, Value), ...]; dates are date(Y, M, D)
% terms of integers. Every route has a positive case and a one-day near-miss control:
%   Art 13(1)        provision on the obtaining day / one day after it;
%   Art 14(3)(a)     on the limb (a) last day (Sunday 2026-02-15 moved to Monday
%                    2026-02-16) / one day after it;
%   Art 14(3)(b)     on the first communication day / one day after it;
%   Art 14(3)(c)     on the first disclosure day / one day after it;
%   Art 3(4) holiday on the day moved over the attested holiday 2027-02-01 / one day after;
%   leap year        on 2028-02-29 / on 2028-03-01;
%   holidays absent  (P): on A0 / one day after A0 (the referral);
%   judgement        provided_within_reasonable_period false / unsure;
%   input check      unread keys accepted / other_purpose_information in items_provided
%                    and a duplicate key refused;
%   route unknown    the route key named.
% Attestations carry fixture placeholders: BY and AT come from the host in real use.
% =====================================================================

:- module(fixtures, [
    gdpr_information_duties_timing_subject/1,
    gdpr_information_duties_timing_profile_for/2,
    gdpr_information_duties_timing_assess/2
]).

:- use_module(eu/data_protection/gdpr_information_duties_timing/information_timing_verdict, [decide_information_timing_verdict/2]).

% ---- Subject registry ------------------------------------------------
gdpr_information_duties_timing_subject(art13_on_obtaining_day).
gdpr_information_duties_timing_subject(art13_day_after_obtaining).
gdpr_information_duties_timing_subject(art13_with_unread_keys).
gdpr_information_duties_timing_subject(art14_limb_a_last_day).
gdpr_information_duties_timing_subject(art14_limb_a_day_after).
gdpr_information_duties_timing_subject(art14_first_communication_day).
gdpr_information_duties_timing_subject(art14_day_after_first_communication).
gdpr_information_duties_timing_subject(art14_first_disclosure_day).
gdpr_information_duties_timing_subject(art14_day_after_first_disclosure).
gdpr_information_duties_timing_subject(art14_attested_holiday_shift).
gdpr_information_duties_timing_subject(art14_day_after_attested_holiday_shift).
gdpr_information_duties_timing_subject(art14_leap_day).
gdpr_information_duties_timing_subject(art14_day_after_leap_day).
gdpr_information_duties_timing_subject(art14_holidays_absent_on_limb_a_day).
gdpr_information_duties_timing_subject(art14_holidays_absent_after_limb_a_day).
gdpr_information_duties_timing_subject(art14_reasonable_period_false).
gdpr_information_duties_timing_subject(art14_reasonable_period_unsure).
gdpr_information_duties_timing_subject(route_unknown).
gdpr_information_duties_timing_subject(items_provided_wrong_type).
gdpr_information_duties_timing_subject(route_key_duplicated).

% ---- Profiles: Art 13(1) ----------------------------------------------
gdpr_information_duties_timing_profile_for(art13_on_obtaining_day, [
    attribute(personal_data_collected_from_data_subject, true),
    attribute(obtaining_date, date(2026, 3, 10)),
    attribute(provision_date, date(2026, 3, 10))
]).
gdpr_information_duties_timing_profile_for(art13_day_after_obtaining, [
    attribute(personal_data_collected_from_data_subject, true),
    attribute(obtaining_date, date(2026, 3, 10)),
    attribute(provision_date, date(2026, 3, 11))
]).
gdpr_information_duties_timing_profile_for(art13_with_unread_keys, [
    attribute(personal_data_collected_from_data_subject, true),
    attribute(items_provided, [controller_identity_and_contact_details, purposes_and_legal_basis]),
    attribute(items_data_subject_already_has, [other_purpose_information]),
    attribute(automated_decision_making_under_article_22, unsure),
    attribute(obtaining_date, date(2026, 3, 10)),
    attribute(provision_date, date(2026, 3, 10)),
    attribute(obtaining_or_disclosure_laid_down_by_law, attested(true, attestation(fixture_host, fixture_time, fixture_reason, none)))
]).

% ---- Profiles: Art 14(3)(a), public holidays attested ------------------
gdpr_information_duties_timing_profile_for(art14_limb_a_last_day, [
    attribute(personal_data_collected_from_data_subject, false),
    attribute(obtaining_date, date(2026, 1, 15)),
    attribute(provision_date, date(2026, 2, 16)),
    attribute(data_used_for_communication_with_data_subject, false),
    attribute(disclosure_to_another_recipient_envisaged, false),
    attribute(provided_within_reasonable_period, true),
    attribute(public_holidays, attested([], attestation(fixture_host, fixture_time, fixture_reason, none)))
]).
gdpr_information_duties_timing_profile_for(art14_limb_a_day_after, [
    attribute(personal_data_collected_from_data_subject, false),
    attribute(obtaining_date, date(2026, 1, 15)),
    attribute(provision_date, date(2026, 2, 17)),
    attribute(data_used_for_communication_with_data_subject, false),
    attribute(disclosure_to_another_recipient_envisaged, false),
    attribute(provided_within_reasonable_period, true),
    attribute(public_holidays, attested([], attestation(fixture_host, fixture_time, fixture_reason, none)))
]).

% ---- Profiles: Art 14(3)(b) --------------------------------------------
gdpr_information_duties_timing_profile_for(art14_first_communication_day, [
    attribute(personal_data_collected_from_data_subject, false),
    attribute(obtaining_date, date(2026, 1, 15)),
    attribute(provision_date, date(2026, 1, 20)),
    attribute(data_used_for_communication_with_data_subject, true),
    attribute(first_communication_date, date(2026, 1, 20)),
    attribute(disclosure_to_another_recipient_envisaged, false),
    attribute(provided_within_reasonable_period, true),
    attribute(public_holidays, attested([], attestation(fixture_host, fixture_time, fixture_reason, none)))
]).
gdpr_information_duties_timing_profile_for(art14_day_after_first_communication, [
    attribute(personal_data_collected_from_data_subject, false),
    attribute(obtaining_date, date(2026, 1, 15)),
    attribute(provision_date, date(2026, 1, 21)),
    attribute(data_used_for_communication_with_data_subject, true),
    attribute(first_communication_date, date(2026, 1, 20)),
    attribute(disclosure_to_another_recipient_envisaged, false),
    attribute(provided_within_reasonable_period, true),
    attribute(public_holidays, attested([], attestation(fixture_host, fixture_time, fixture_reason, none)))
]).

% ---- Profiles: Art 14(3)(c); the disclosure day is an event date, never shifted ----
gdpr_information_duties_timing_profile_for(art14_first_disclosure_day, [
    attribute(personal_data_collected_from_data_subject, false),
    attribute(obtaining_date, date(2026, 1, 15)),
    attribute(provision_date, date(2026, 2, 1)),
    attribute(data_used_for_communication_with_data_subject, false),
    attribute(disclosure_to_another_recipient_envisaged, true),
    attribute(first_disclosure_date, date(2026, 2, 1)),
    attribute(provided_within_reasonable_period, true),
    attribute(public_holidays, attested([], attestation(fixture_host, fixture_time, fixture_reason, none)))
]).
gdpr_information_duties_timing_profile_for(art14_day_after_first_disclosure, [
    attribute(personal_data_collected_from_data_subject, false),
    attribute(obtaining_date, date(2026, 1, 15)),
    attribute(provision_date, date(2026, 2, 2)),
    attribute(data_used_for_communication_with_data_subject, false),
    attribute(disclosure_to_another_recipient_envisaged, true),
    attribute(first_disclosure_date, date(2026, 2, 1)),
    attribute(provided_within_reasonable_period, true),
    attribute(public_holidays, attested([], attestation(fixture_host, fixture_time, fixture_reason, none)))
]).

% ---- Profiles: Reg 1182/71 Art 3(4), an attested public holiday ---------
gdpr_information_duties_timing_profile_for(art14_attested_holiday_shift, [
    attribute(personal_data_collected_from_data_subject, false),
    attribute(obtaining_date, date(2026, 12, 31)),
    attribute(provision_date, date(2027, 2, 2)),
    attribute(data_used_for_communication_with_data_subject, false),
    attribute(disclosure_to_another_recipient_envisaged, false),
    attribute(provided_within_reasonable_period, true),
    attribute(public_holidays, attested([date(2027, 2, 1)], attestation(fixture_host, fixture_time, fixture_reason, none)))
]).
gdpr_information_duties_timing_profile_for(art14_day_after_attested_holiday_shift, [
    attribute(personal_data_collected_from_data_subject, false),
    attribute(obtaining_date, date(2026, 12, 31)),
    attribute(provision_date, date(2027, 2, 3)),
    attribute(data_used_for_communication_with_data_subject, false),
    attribute(disclosure_to_another_recipient_envisaged, false),
    attribute(provided_within_reasonable_period, true),
    attribute(public_holidays, attested([date(2027, 2, 1)], attestation(fixture_host, fixture_time, fixture_reason, none)))
]).

% ---- Profiles: the Gregorian leap day (Art 3(2)(c), capped date) --------
gdpr_information_duties_timing_profile_for(art14_leap_day, [
    attribute(personal_data_collected_from_data_subject, false),
    attribute(obtaining_date, date(2028, 1, 31)),
    attribute(provision_date, date(2028, 2, 29)),
    attribute(data_used_for_communication_with_data_subject, false),
    attribute(disclosure_to_another_recipient_envisaged, false),
    attribute(provided_within_reasonable_period, true),
    attribute(public_holidays, attested([], attestation(fixture_host, fixture_time, fixture_reason, none)))
]).
gdpr_information_duties_timing_profile_for(art14_day_after_leap_day, [
    attribute(personal_data_collected_from_data_subject, false),
    attribute(obtaining_date, date(2028, 1, 31)),
    attribute(provision_date, date(2028, 3, 1)),
    attribute(data_used_for_communication_with_data_subject, false),
    attribute(disclosure_to_another_recipient_envisaged, false),
    attribute(provided_within_reasonable_period, true),
    attribute(public_holidays, attested([], attestation(fixture_host, fixture_time, fixture_reason, none)))
]).

% ---- Profiles: public_holidays absent (THE ANSWERS (P)) ------------------
gdpr_information_duties_timing_profile_for(art14_holidays_absent_on_limb_a_day, [
    attribute(personal_data_collected_from_data_subject, false),
    attribute(obtaining_date, date(2026, 1, 15)),
    attribute(provision_date, date(2026, 2, 16)),
    attribute(data_used_for_communication_with_data_subject, false),
    attribute(disclosure_to_another_recipient_envisaged, false),
    attribute(provided_within_reasonable_period, true)
]).
gdpr_information_duties_timing_profile_for(art14_holidays_absent_after_limb_a_day, [
