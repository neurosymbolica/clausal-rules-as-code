% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/data_protection/gdpr_art36_3_consultation_request.
%
% Instrument: Regulation (EU) 2016/679 of the European Parliament and of the
% Council (General Data Protection Regulation), consolidated text
% 02016R0679-20160504 (CELEX 02016R0679-20160504), pinned units of Article 36.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% The verbatim pair is OMITTED while the key's entry in
% citations-sources.yaml is `status: unverified`.
%
% Keys RETURNED in results (canonical lexicon atoms, never shortened):
%   eu_reg_2016_679_art_36_3, eu_reg_2016_679_art_36_3_a ... _f.
% Key used only as a referral TARGET inside cite(...):
%   controller_and_processor_roles_statement.
% Keys RECORDED for provisions read but never returned:
%   eu_reg_2016_679_art_36_1 (reading (1): which consultation),
%   eu_reg_2016_679_art_36_5 (reading (1), Q1: a Member State law
%   consultation is not governed by Art 36(3)).
%
% PROVENANCE: every operative clause opens its body with implements(Key),
% Key a key recorded here.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

citation(eu_reg_2016_679_art_36_3, [label-'Regulation (EU) 2016/679 Art 36(3), opening words (what the controller provides when consulting under Art 36(1))', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#parag_036.003', verbatim-'When consulting the supervisory authority pursuant to paragraph 1, the controller shall provide the supervisory authority with:']).

citation(eu_reg_2016_679_art_36_3_a, [label-'Regulation (EU) 2016/679 Art 36(3)(a) (respective responsibilities of controller, joint controllers and processors)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#point_036.003_a', verbatim-'where applicable, the respective responsibilities of the controller, joint controllers and processors involved in the processing, in particular for processing within a group of undertakings']).

citation(eu_reg_2016_679_art_36_3_b, [label-'Regulation (EU) 2016/679 Art 36(3)(b) (purposes and means of the intended processing)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#point_036.003_b', verbatim-'the purposes and means of the intended processing']).

citation(eu_reg_2016_679_art_36_3_c, [label-'Regulation (EU) 2016/679 Art 36(3)(c) (measures and safeguards protecting the rights and freedoms of data subjects)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#point_036.003_c', verbatim-'the measures and safeguards provided to protect the rights and freedoms of data subjects pursuant to this Regulation']).

citation(eu_reg_2016_679_art_36_3_d, [label-'Regulation (EU) 2016/679 Art 36(3)(d) (contact details of the data protection officer)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#point_036.003_d', verbatim-'where applicable, the contact details of the data protection officer']).

citation(eu_reg_2016_679_art_36_3_e, [label-'Regulation (EU) 2016/679 Art 36(3)(e) (the data protection impact assessment under Article 35)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#point_036.003_e', verbatim-'the data protection impact assessment provided for in Article 35']).

citation(eu_reg_2016_679_art_36_3_f, [label-'Regulation (EU) 2016/679 Art 36(3)(f) (any other information requested by the supervisory authority)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#point_036.003_f', verbatim-'any other information requested by the supervisory authority']).

citation(eu_reg_2016_679_art_36_1, [label-'Regulation (EU) 2016/679 Art 36(1) (duty to consult the supervisory authority prior to processing; read only to identify the consultation, decided elsewhere)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#parag_036.001', verbatim-'The controller shall consult the supervisory authority prior to processing where a data protection impact assessment under Article 35 indicates that the processing would result in a high risk in the absence of measures taken by the controller to mitigate the risk.']).

citation(eu_reg_2016_679_art_36_5, [label-'Regulation (EU) 2016/679 Art 36(5) (consultation and prior authorisation under Member State law; read only for reading (1) and Q1, decided elsewhere)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504#parag_036.005', verbatim-'Member State law may require controllers to consult with, and obtain prior authorisation from, the supervisory authority in relation to processing by a controller for the performance of a task carried out by the controller in the public interest, including processing in relation to social protection and public health.']).

citation(controller_and_processor_roles_statement, [label-'Referral target: determination of controller, joint controller and processor roles under Regulation (EU) 2016/679 Art 4(7), Art 4(8), Art 26 and Art 28 (not decided in this order)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504']).

% implements(Key): the provenance marker. Succeeds for every recorded key and
% fails for a key not recorded here.
implements(Key) :-
    citation(Key, _).

:- end_module(citations).
