% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% fixtures.clausal -- representative profiles for eu/data_protection/gdpr_art36_3_consultation_request.
% A TOP-LAYER consumer: import the determination slice's PUBLIC predicates
% you call -- that is the whole import list. Profile keys and subject ids
% are atoms and need no import.
%
% A profile is an ATTRIBUTE LIST [attribute(Key, Value), ...] (the order's typed
% input contract). Art 36(3) has no numeric threshold, so each route is paired
% with a ONE-KEY near-miss control instead of an at/below-threshold pair:
%   complete_sole_controller            / incomplete_missing_assessment         (point (e))
%   complete_joint_controllers          / joint_controllers_responsibilities_missing (point (a))
%   complete_joint_controllers          / officer_contact_details_missing       (point (d))
%   complete_joint_controllers          / other_information_missing             (point (f))
%   complete_sole_controller            / member_state_law_consultation         (reading (1))
%   complete_sole_controller            / consultation_footing_unstated         (step 1)
%   roles_attested_sole_controller      / roles_unattested_referral             (absent referral)
%   officer_not_designated              / officer_designation_unknown           (deciding key named)
%   missing_item_with_settled_responsibilities / missing_item_with_open_responsibilities
%                                       (status incomplete in both; the items query names a key)
%   complete_sole_controller            / malformed_attested_crisp_key          (input check)
% =====================================================================

:- module(fixtures, [
    gdpr_art36_3_consultation_request_subject/1,
    gdpr_art36_3_consultation_request_profile_for/2,
    gdpr_art36_3_consultation_request_assess/2
]).

:- use_module(eu/data_protection/gdpr_art36_3_consultation_request/gdpr_art36_3_consultation_request, [decide_gdpr_art36_3_consultation_request/2]).

% ---- Subject registry ------------------------------------------------
gdpr_art36_3_consultation_request_subject(complete_sole_controller).
gdpr_art36_3_consultation_request_subject(incomplete_missing_assessment).
gdpr_art36_3_consultation_request_subject(complete_joint_controllers).
gdpr_art36_3_consultation_request_subject(joint_controllers_responsibilities_missing).
gdpr_art36_3_consultation_request_subject(officer_contact_details_missing).
gdpr_art36_3_consultation_request_subject(other_information_missing).
gdpr_art36_3_consultation_request_subject(member_state_law_consultation).
gdpr_art36_3_consultation_request_subject(consultation_footing_unstated).
gdpr_art36_3_consultation_request_subject(roles_unattested_referral).
gdpr_art36_3_consultation_request_subject(roles_attested_sole_controller).
gdpr_art36_3_consultation_request_subject(officer_designation_unknown).
gdpr_art36_3_consultation_request_subject(officer_not_designated).
gdpr_art36_3_consultation_request_subject(missing_item_with_open_responsibilities).
gdpr_art36_3_consultation_request_subject(missing_item_with_settled_responsibilities).
gdpr_art36_3_consultation_request_subject(malformed_attested_crisp_key).

% ---- Profiles --------------------------------------------------------
% A sole controller (attested), no officer designated, nothing else requested.
gdpr_art36_3_consultation_request_profile_for(complete_sole_controller, [
    attribute(consultation_under_article_36_1, true),
    attribute(joint_controllers_or_processors_involved, attested(false, attestation(privacy_counsel, attestation_moment, role_review, none))),
    attribute(purposes_and_means_provided, true),
    attribute(measures_and_safeguards_provided, true),
    attribute(data_protection_officer_designated, false),
    attribute(impact_assessment_provided, true),
    attribute(other_information_requested_by_supervisory_authority, false)
]).

% Near miss: the impact assessment is not provided.
gdpr_art36_3_consultation_request_profile_for(incomplete_missing_assessment, [
    attribute(consultation_under_article_36_1, true),
    attribute(joint_controllers_or_processors_involved, attested(false, attestation(privacy_counsel, attestation_moment, role_review, none))),
    attribute(purposes_and_means_provided, true),
    attribute(measures_and_safeguards_provided, true),
    attribute(data_protection_officer_designated, false),
    attribute(impact_assessment_provided, false),
    attribute(other_information_requested_by_supervisory_authority, false)
]).

% Every item applies and every item is provided.
gdpr_art36_3_consultation_request_profile_for(complete_joint_controllers, [
    attribute(consultation_under_article_36_1, true),
    attribute(joint_controllers_or_processors_involved, attested(true, attestation(privacy_counsel, attestation_moment, role_review, none))),
    attribute(respective_responsibilities_provided, true),
    attribute(purposes_and_means_provided, true),
    attribute(measures_and_safeguards_provided, true),
    attribute(data_protection_officer_designated, true),
    attribute(data_protection_officer_contact_details_provided, true),
    attribute(impact_assessment_provided, true),
    attribute(other_information_requested_by_supervisory_authority, true),
    attribute(requested_other_information_provided, true)
]).

% Near miss: point (a) applies and the responsibilities are not stated.
gdpr_art36_3_consultation_request_profile_for(joint_controllers_responsibilities_missing, [
    attribute(consultation_under_article_36_1, true),
    attribute(joint_controllers_or_processors_involved, attested(true, attestation(privacy_counsel, attestation_moment, role_review, none))),
    attribute(respective_responsibilities_provided, false),
    attribute(purposes_and_means_provided, true),
    attribute(measures_and_safeguards_provided, true),
    attribute(data_protection_officer_designated, true),
    attribute(data_protection_officer_contact_details_provided, true),
    attribute(impact_assessment_provided, true),
    attribute(other_information_requested_by_supervisory_authority, true),
    attribute(requested_other_information_provided, true)
]).

% Near miss: an officer is designated and the contact details are not given.
gdpr_art36_3_consultation_request_profile_for(officer_contact_details_missing, [
    attribute(consultation_under_article_36_1, true),
    attribute(joint_controllers_or_processors_involved, attested(true, attestation(privacy_counsel, attestation_moment, role_review, none))),
    attribute(respective_responsibilities_provided, true),
    attribute(purposes_and_means_provided, true),
    attribute(measures_and_safeguards_provided, true),
    attribute(data_protection_officer_designated, true),
    attribute(data_protection_officer_contact_details_provided, false),
    attribute(impact_assessment_provided, true),
    attribute(other_information_requested_by_supervisory_authority, true),
    attribute(requested_other_information_provided, true)
]).

% Near miss: the authority asked for other information and it is not provided.
gdpr_art36_3_consultation_request_profile_for(other_information_missing, [
    attribute(consultation_under_article_36_1, true),
    attribute(joint_controllers_or_processors_involved, attested(true, attestation(privacy_counsel, attestation_moment, role_review, none))),
    attribute(respective_responsibilities_provided, true),
    attribute(purposes_and_means_provided, true),
    attribute(measures_and_safeguards_provided, true),
    attribute(data_protection_officer_designated, true),
    attribute(data_protection_officer_contact_details_provided, true),
    attribute(impact_assessment_provided, true),
    attribute(other_information_requested_by_supervisory_authority, true),
    attribute(requested_other_information_provided, false)
]).

% Near miss: the consultation is on another footing (Member State law, Art 36(5)).
gdpr_art36_3_consultation_request_profile_for(member_state_law_consultation, [
    attribute(consultation_under_article_36_1, false),
    attribute(joint_controllers_or_processors_involved, attested(false, attestation(privacy_counsel, attestation_moment, role_review, none))),
    attribute(purposes_and_means_provided, true),
    attribute(measures_and_safeguards_provided, true),
    attribute(data_protection_officer_designated, false),
    attribute(impact_assessment_provided, true),
    attribute(other_information_requested_by_supervisory_authority, false)
]).

% Near miss: the footing of the consultation is not stated.
gdpr_art36_3_consultation_request_profile_for(consultation_footing_unstated, [
    attribute(joint_controllers_or_processors_involved, attested(false, attestation(privacy_counsel, attestation_moment, role_review, none))),
    attribute(purposes_and_means_provided, true),
    attribute(measures_and_safeguards_provided, true),
    attribute(data_protection_officer_designated, false),
    attribute(impact_assessment_provided, true),
    attribute(other_information_requested_by_supervisory_authority, false)
]).

% Responsibilities not stated and nobody attested the roles: referral.
gdpr_art36_3_consultation_request_profile_for(roles_unattested_referral, [
    attribute(consultation_under_article_36_1, true),
    attribute(respective_responsibilities_provided, false),
    attribute(purposes_and_means_provided, true),
    attribute(measures_and_safeguards_provided, true),
    attribute(data_protection_officer_designated, false),
    attribute(impact_assessment_provided, true),
    attribute(other_information_requested_by_supervisory_authority, false)
]).

% Control: the same request with the sole controller attested.
gdpr_art36_3_consultation_request_profile_for(roles_attested_sole_controller, [
    attribute(consultation_under_article_36_1, true),
    attribute(joint_controllers_or_processors_involved, attested(false, attestation(privacy_counsel, attestation_moment, role_review, none))),
    attribute(respective_responsibilities_provided, false),
    attribute(purposes_and_means_provided, true),
    attribute(measures_and_safeguards_provided, true),
    attribute(data_protection_officer_designated, false),
    attribute(impact_assessment_provided, true),
    attribute(other_information_requested_by_supervisory_authority, false)
]).

% Contact details stated as not given, designation unknown: the designation is asked.
gdpr_art36_3_consultation_request_profile_for(officer_designation_unknown, [
    attribute(consultation_under_article_36_1, true),
    attribute(respective_responsibilities_provided, true),
    attribute(purposes_and_means_provided, true),
    attribute(measures_and_safeguards_provided, true),
    attribute(data_protection_officer_contact_details_provided, false),
    attribute(impact_assessment_provided, true),
    attribute(other_information_requested_by_supervisory_authority, false)
]).

% Control: no officer designated, so point (d) does not apply.
gdpr_art36_3_consultation_request_profile_for(officer_not_designated, [
    attribute(consultation_under_article_36_1, true),
    attribute(respective_responsibilities_provided, true),
    attribute(purposes_and_means_provided, true),
    attribute(measures_and_safeguards_provided, true),
    attribute(data_protection_officer_designated, false),
    attribute(data_protection_officer_contact_details_provided, false),
    attribute(impact_assessment_provided, true),
    attribute(other_information_requested_by_supervisory_authority, false)
]).

% Purposes and means missing, point (a) still open: status incomplete, items ask.
gdpr_art36_3_consultation_request_profile_for(missing_item_with_open_responsibilities, [
    attribute(consultation_under_article_36_1, true),
    attribute(purposes_and_means_provided, false),
    attribute(measures_and_safeguards_provided, true),
    attribute(data_protection_officer_designated, false),
    attribute(impact_assessment_provided, true),
    attribute(other_information_requested_by_supervisory_authority, false)
]).

% Control: the responsibilities are stated, so the list is whole.
gdpr_art36_3_consultation_request_profile_for(missing_item_with_settled_responsibilities, [
    attribute(consultation_under_article_36_1, true),
    attribute(respective_responsibilities_provided, true),
    attribute(purposes_and_means_provided, false),
    attribute(measures_and_safeguards_provided, true),
    attribute(data_protection_officer_designated, false),
    attribute(impact_assessment_provided, true),
    attribute(other_information_requested_by_supervisory_authority, false)
]).

% Malformed: a crisp key given the attested wrapper.
gdpr_art36_3_consultation_request_profile_for(malformed_attested_crisp_key, [
    attribute(consultation_under_article_36_1, true),
    attribute(joint_controllers_or_processors_involved, attested(false, attestation(privacy_counsel, attestation_moment, role_review, none))),
    attribute(purposes_and_means_provided, attested(true, attestation(privacy_counsel, attestation_moment, role_review, none))),
    attribute(measures_and_safeguards_provided, true),
    attribute(data_protection_officer_designated, false),
    attribute(impact_assessment_provided, true),
    attribute(other_information_requested_by_supervisory_authority, false)
]).

% ---- Convenience wrapper ---------------------------------------------
gdpr_art36_3_consultation_request_assess(Subject, Result) :-
    gdpr_art36_3_consultation_request_profile_for(Subject, Profile),
    decide_gdpr_art36_3_consultation_request(Profile, Result).

:- end_module(fixtures).
