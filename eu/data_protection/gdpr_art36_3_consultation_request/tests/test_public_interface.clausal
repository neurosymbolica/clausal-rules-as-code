% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_public_interface.clausal -- the package's PUBLIC surface, exercised
% through the generated package facade (what an external caller sees).
% Each fixture subject resolves to its EXPECTED status and item list; every
% near-miss control gets a different status from its positive case.
% Run: python -m clausal.testing eu/data_protection/gdpr_art36_3_consultation_request/tests/test_public_interface.clausal
% =====================================================================
:- module(test_public_interface, []).
:- use_module(eu/data_protection/gdpr_art36_3_consultation_request, [
    consultation_request_status/4,
    missing_consultation_request_items/4,
    gdpr_art36_3_consultation_request_input_problems/2,
    gdpr_art36_3_consultation_request_what_if/4,
    decide_gdpr_art36_3_consultation_request/2,
    gdpr_art36_3_consultation_request_status/2,
    gdpr_art36_3_consultation_request_checklist/2,
    gdpr_art36_3_consultation_request_decision_resolvable/1,
    gdpr_art36_3_consultation_request_status_values/1,
    gdpr_art36_3_consultation_request_subject/1,
    gdpr_art36_3_consultation_request_profile_for/2,
    gdpr_art36_3_consultation_request_assess/2
]).

% ---- expected answers, one row per subject, in registry order ---------
roles_referral(needs_legal_review(cross_reference_unresolved(cite(eu_reg_2016_679_art_36_3_a), cite(controller_and_processor_roles_statement)), [resolution(cite(controller_and_processor_roles_statement), not_attempted), inputs_relied_on([joint_controllers_or_processors_involved-absent])])).

expected_status(complete_sole_controller, consultation_request_complete).
expected_status(incomplete_missing_assessment, consultation_request_incomplete).
expected_status(complete_joint_controllers, consultation_request_complete).
expected_status(joint_controllers_responsibilities_missing, consultation_request_incomplete).
expected_status(officer_contact_details_missing, consultation_request_incomplete).
expected_status(other_information_missing, consultation_request_incomplete).
expected_status(member_state_law_consultation, not_governed_by_article_36_3).
expected_status(consultation_footing_unstated, indeterminate([consultation_under_article_36_1])).
expected_status(roles_unattested_referral, Referral) :-
    roles_referral(Referral).
expected_status(roles_attested_sole_controller, consultation_request_complete).
expected_status(officer_designation_unknown, indeterminate([data_protection_officer_designated])).
expected_status(officer_not_designated, consultation_request_complete).
expected_status(missing_item_with_open_responsibilities, consultation_request_incomplete).
expected_status(missing_item_with_settled_responsibilities, consultation_request_incomplete).
expected_status(malformed_attested_crisp_key, input_problems([wrong_type(purposes_and_means_provided)])).

expected_items(complete_sole_controller, []).
expected_items(incomplete_missing_assessment, [data_protection_impact_assessment]).
expected_items(complete_joint_controllers, []).
expected_items(joint_controllers_responsibilities_missing, [respective_responsibilities]).
expected_items(officer_contact_details_missing, [data_protection_officer_contact_details]).
expected_items(other_information_missing, [other_requested_information]).
expected_items(member_state_law_consultation, not_governed_by_article_36_3).
expected_items(consultation_footing_unstated, indeterminate([consultation_under_article_36_1])).
expected_items(roles_unattested_referral, Referral) :-
    roles_referral(Referral).
expected_items(roles_attested_sole_controller, []).
expected_items(officer_designation_unknown, indeterminate([data_protection_officer_designated])).
expected_items(officer_not_designated, []).
expected_items(missing_item_with_open_responsibilities, indeterminate([respective_responsibilities_provided])).
expected_items(missing_item_with_settled_responsibilities, [purposes_and_means]).
expected_items(malformed_attested_crisp_key, input_problems([wrong_type(purposes_and_means_provided)])).

near_miss_pairs([
    complete_sole_controller-incomplete_missing_assessment,
    complete_joint_controllers-joint_controllers_responsibilities_missing,
    complete_joint_controllers-officer_contact_details_missing,
    complete_joint_controllers-other_information_missing,
    complete_sole_controller-member_state_law_consultation,
    complete_sole_controller-consultation_footing_unstated,
    roles_attested_sole_controller-roles_unattested_referral,
    officer_not_designated-officer_designation_unknown,
    complete_sole_controller-malformed_attested_crisp_key
]).

statuses_differ(Positive-Control) :-
    gdpr_art36_3_consultation_request_assess(Positive, gdpr_art36_3_consultation_request_verdict(PositiveStatus, _)),
    gdpr_art36_3_consultation_request_assess(Control, gdpr_art36_3_consultation_request_verdict(ControlStatus, _)),
    dif(PositiveStatus, ControlStatus).

seven_citations([cite(eu_reg_2016_679_art_36_3), cite(eu_reg_2016_679_art_36_3_a), cite(eu_reg_2016_679_art_36_3_b), cite(eu_reg_2016_679_art_36_3_c), cite(eu_reg_2016_679_art_36_3_d), cite(eu_reg_2016_679_art_36_3_e), cite(eu_reg_2016_679_art_36_3_f)]).

% A complete request whose roles statement carries the given evidence.
profile_with_evidence(Evidence, [
    attribute(consultation_under_article_36_1, true),
    attribute(joint_controllers_or_processors_involved, attested(true, attestation(privacy_counsel, attestation_moment, role_review, Evidence))),
    attribute(respective_responsibilities_provided, false),
    attribute(purposes_and_means_provided, true),
    attribute(measures_and_safeguards_provided, true),
    attribute(data_protection_officer_designated, false),
    attribute(impact_assessment_provided, true),
    attribute(other_information_requested_by_supervisory_authority, false)
]).

% ---- every subject: its status, once, as expected ---------------------
test(every_subject_gets_its_expected_status_once) :-
    findall(Subject-Status, (gdpr_art36_3_consultation_request_subject(Subject), gdpr_art36_3_consultation_request_assess(Subject, gdpr_art36_3_consultation_request_verdict(Status, _))), Actual),
    findall(Subject-Status, (gdpr_art36_3_consultation_request_subject(Subject), expected_status(Subject, Status)), Expected),
    Actual == Expected.

test(every_subject_gets_its_expected_items_once) :-
    findall(Subject-Items, (gdpr_art36_3_consultation_request_subject(Subject), gdpr_art36_3_consultation_request_profile_for(Subject, Profile), missing_consultation_request_items(Profile, Items, _, _)), Actual),
    findall(Subject-Items, (gdpr_art36_3_consultation_request_subject(Subject), expected_items(Subject, Items)), Expected),
    Actual == Expected.

test(the_status_projection_agrees_with_the_contract_query) :-
    findall(Subject-Status, (gdpr_art36_3_consultation_request_subject(Subject), gdpr_art36_3_consultation_request_profile_for(Subject, Profile), gdpr_art36_3_consultation_request_status(Profile, Status)), Projected),
    findall(Subject-Result, (gdpr_art36_3_consultation_request_subject(Subject), gdpr_art36_3_consultation_request_profile_for(Subject, Profile), consultation_request_status(Profile, Result, _, _)), Direct),
    Projected == Direct.

test(every_subject_has_a_non_empty_checklist) :-
    findall(Subject, gdpr_art36_3_consultation_request_subject(Subject), Subjects),
    findall(Subject, (gdpr_art36_3_consultation_request_subject(Subject), gdpr_art36_3_consultation_request_profile_for(Subject, Profile), gdpr_art36_3_consultation_request_checklist(Profile, [_|_])), WithChecklist),
    WithChecklist == Subjects.

test(every_near_miss_control_gets_a_different_status) :-
    near_miss_pairs(Pairs),
    maplist(statuses_differ, Pairs).

% ---- concrete per-route assertions, each negative paired --------------
test(complete_sole_controller_is_complete) :-
    gdpr_art36_3_consultation_request_assess(complete_sole_controller, gdpr_art36_3_consultation_request_verdict(consultation_request_complete, Citations)),
    seven_citations(Expected),
    Citations == Expected.
test(complete_sole_controller_is_not_incomplete, fail) :-
    gdpr_art36_3_consultation_request_assess(complete_sole_controller, gdpr_art36_3_consultation_request_verdict(consultation_request_incomplete, _)).
test(missing_assessment_is_incomplete) :-
    gdpr_art36_3_consultation_request_assess(incomplete_missing_assessment, gdpr_art36_3_consultation_request_verdict(consultation_request_incomplete, _)).
test(missing_assessment_is_not_complete, fail) :-
    gdpr_art36_3_consultation_request_assess(incomplete_missing_assessment, gdpr_art36_3_consultation_request_verdict(consultation_request_complete, _)).
test(member_state_law_consultation_is_not_governed) :-
    gdpr_art36_3_consultation_request_profile_for(member_state_law_consultation, Profile),
    findall(Result-Basis-Citations, consultation_request_status(Profile, Result, Basis, Citations), Answers),
    Answers == [not_governed_by_article_36_3-[]-[cite(eu_reg_2016_679_art_36_3)]].
test(member_state_law_consultation_is_not_incomplete, fail) :-
    gdpr_art36_3_consultation_request_assess(member_state_law_consultation, gdpr_art36_3_consultation_request_verdict(consultation_request_incomplete, _)).
test(unattested_roles_are_referred_with_empty_basis_and_citations) :-
    gdpr_art36_3_consultation_request_profile_for(roles_unattested_referral, Profile),
    roles_referral(Referral),
    findall(Result-Basis-Citations, consultation_request_status(Profile, Result, Basis, Citations), Answers),
    Answers == [Referral-[]-[]].
test(unattested_roles_are_not_complete, fail) :-
    gdpr_art36_3_consultation_request_assess(roles_unattested_referral, gdpr_art36_3_consultation_request_verdict(consultation_request_complete, _)).
test(an_absent_designation_is_named_with_empty_basis) :-
    gdpr_art36_3_consultation_request_profile_for(officer_designation_unknown, Profile),
    consultation_request_status(Profile, Result, Basis, Citations),
    Result == indeterminate([data_protection_officer_designated]),
    Basis == [],
    Citations == [].
test(a_malformed_profile_gets_only_its_problems) :-
    gdpr_art36_3_consultation_request_profile_for(malformed_attested_crisp_key, Profile),
    gdpr_art36_3_consultation_request_input_problems(Profile, Problems),
    Problems == [wrong_type(purposes_and_means_provided)],
    consultation_request_status(Profile, Result, Basis, Citations),
    Result == input_problems([wrong_type(purposes_and_means_provided)]),
    Basis == [],
    Citations == [].
test(a_well_formed_fixture_has_no_input_problem) :-
    gdpr_art36_3_consultation_request_profile_for(complete_joint_controllers, Profile),
    gdpr_art36_3_consultation_request_input_problems(Profile, Problems),
    Problems == [].

% ---- input check: duplicate keys and the evidence forms ----------------
test(a_repeated_key_is_a_duplicate_key) :-
    gdpr_art36_3_consultation_request_input_problems([attribute(consultation_under_article_36_1, true), attribute(impact_assessment_provided, true), attribute(impact_assessment_provided, false)], Problems),
    Problems == [duplicate_key(impact_assessment_provided)].
test(a_repeated_key_with_equal_values_is_a_duplicate_key) :-
    gdpr_art36_3_consultation_request_input_problems([attribute(purposes_and_means_provided, true), attribute(purposes_and_means_provided, true)], Problems),
    Problems == [duplicate_key(purposes_and_means_provided)].
test(a_duplicate_key_gives_input_problems_in_both_queries) :-
    Profile = [attribute(consultation_under_article_36_1, true), attribute(consultation_under_article_36_1, false)],
    findall(Result-Basis-Citations, consultation_request_status(Profile, Result, Basis, Citations), StatusAnswers),
    StatusAnswers == [input_problems([duplicate_key(consultation_under_article_36_1)])-[]-[]],
    findall(Items-ItemsBasis-ItemsCitations, missing_consultation_request_items(Profile, Items, ItemsBasis, ItemsCitations), ItemsAnswers),
    ItemsAnswers == [input_problems([duplicate_key(consultation_under_article_36_1)])-[]-[]].
test(a_single_key_is_not_a_duplicate_key, fail) :-
    gdpr_art36_3_consultation_request_input_problems([attribute(impact_assessment_provided, true)], [duplicate_key(impact_assessment_provided)]).
test(url_evidence_is_well_formed) :-
    profile_with_evidence(url('https://example.org/roles', retrieved_moment), Profile),
    gdpr_art36_3_consultation_request_input_problems(Profile, Problems),
    Problems == [].
test(url_evidence_is_copied_into_the_basis) :-
    Attested = attested(true, attestation(privacy_counsel, attestation_moment, role_review, url('https://example.org/roles', retrieved_moment))),
    profile_with_evidence(url('https://example.org/roles', retrieved_moment), Profile),
    findall(Result-Basis, consultation_request_status(Profile, Result, Basis, _), Answers),
    Answers == [consultation_request_incomplete-[outside_fact(joint_controllers_or_processors_involved, Attested)]].
test(document_evidence_is_well_formed) :-
    profile_with_evidence(document(upload_identifier, sha256_digest), Profile),
    gdpr_art36_3_consultation_request_input_problems(Profile, Problems),
    Problems == [].
test(document_evidence_gives_the_items_list) :-
    Attested = attested(true, attestation(privacy_counsel, attestation_moment, role_review, document(upload_identifier, sha256_digest))),
    profile_with_evidence(document(upload_identifier, sha256_digest), Profile),
    findall(Items-Basis, missing_consultation_request_items(Profile, Items, Basis, _), Answers),
    Answers == [[respective_responsibilities]-[outside_fact(joint_controllers_or_processors_involved, Attested)]].

% ---- basis: the outside fact is copied exactly when it is read ---------
test(a_read_sole_controller_attestation_is_copied) :-
    gdpr_art36_3_consultation_request_profile_for(complete_sole_controller, Profile),
    consultation_request_status(Profile, _, Basis, _),
    Basis == [outside_fact(joint_controllers_or_processors_involved, attested(false, attestation(privacy_counsel, attestation_moment, role_review, none)))].
test(a_missing_responsibilities_basis_copies_the_joint_attestation) :-
    gdpr_art36_3_consultation_request_profile_for(joint_controllers_responsibilities_missing, Profile),
    missing_consultation_request_items(Profile, Items, Basis, Citations),
    Items == [respective_responsibilities],
    Basis == [outside_fact(joint_controllers_or_processors_involved, attested(true, attestation(privacy_counsel, attestation_moment, role_review, none)))],
    seven_citations(Expected),
    Citations == Expected.
test(an_unread_attestation_is_not_copied) :-
    gdpr_art36_3_consultation_request_profile_for(complete_joint_controllers, Profile),
    consultation_request_status(Profile, Result, Basis, _),
    Result == consultation_request_complete,
    Basis == [].

% ---- justification: each checklist row carries its point's cite --------
test(the_checklist_cites_each_point) :-
    gdpr_art36_3_consultation_request_profile_for(officer_contact_details_missing, Profile),
    gdpr_art36_3_consultation_request_checklist(Profile, Checklist),
    length(Checklist, 6),
    member(item(data_protection_officer_contact_details, missing, cite(eu_reg_2016_679_art_36_3_d)), Checklist),
    member(item(respective_responsibilities, satisfied, cite(eu_reg_2016_679_art_36_3_a)), Checklist).

% ---- what-if through the facade ----------------------------------------
test(what_if_providing_the_assessment_completes_the_request) :-
    gdpr_art36_3_consultation_request_profile_for(incomplete_missing_assessment, Profile),
    findall(Status, gdpr_art36_3_consultation_request_what_if(Profile, impact_assessment_provided, true, Status), Statuses),
    Statuses == [consultation_request_complete].
test(what_if_attesting_the_roles_resolves_the_referral) :-
    gdpr_art36_3_consultation_request_profile_for(roles_unattested_referral, Profile),
    gdpr_art36_3_consultation_request_what_if(Profile, joint_controllers_or_processors_involved, attested(true, attestation(privacy_counsel, attestation_moment, role_review, none)), Status),
    Status == consultation_request_incomplete.

% ---- resolvability and the verdict vocabulary --------------------------
test(a_complete_fixture_is_resolvable) :-
    gdpr_art36_3_consultation_request_profile_for(complete_sole_controller, Profile),
    gdpr_art36_3_consultation_request_decision_resolvable(Profile).
test(a_referred_fixture_is_not_resolvable, fail) :-
    gdpr_art36_3_consultation_request_profile_for(roles_unattested_referral, Profile),
    gdpr_art36_3_consultation_request_decision_resolvable(Profile).
test(the_decide_verdict_is_one_answer) :-
    gdpr_art36_3_consultation_request_profile_for(other_information_missing, Profile),
    findall(Verdict, decide_gdpr_art36_3_consultation_request(Profile, Verdict), Verdicts),
    length(Verdicts, 1).
test(the_status_values_are_the_three_final_atoms) :-
    gdpr_art36_3_consultation_request_status_values(Values),
    Values == [consultation_request_complete, consultation_request_incomplete, not_governed_by_article_36_3].

:- end_module(test_public_interface).
