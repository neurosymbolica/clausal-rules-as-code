% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/data_protection/gdpr_cooperation_with_the_supervisory_authority.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% The verbatim pair is OMITTED while the key's entry in
% citations-sources.yaml is `status: unverified`; `status: verified`
% requires a non-empty ref AND a verbatim that is an exact substring of
% the source. In a quoted atom an apostrophe is written twice ('').
%
% Keys (CANONICAL lexicon scheme, _lexicon/citations.yaml):
%   eu_reg_2016_679_art_31 -- Regulation (EU) 2016/679 (GDPR) Art 31, the
%     whole article (one paragraph), pinned unit 02016R0679-20160504#art_031.
%     The only load-bearing provision: who is bound, 'on request', 'in the
%     performance of its tasks', 'shall cooperate'.
%   cooperation_statement -- the TARGET of the outside fact cooperation_given:
%     the attested statement that the caller cooperated with the request. It
%     is not a provision; it is named only in cross_reference_unresolved/2 and
%     resolution/2 of the step-5 referral.
%
% PROVENANCE: every operative clause opens its body with implements(Key),
% Key a key recorded here.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

citation(eu_reg_2016_679_art_31, [label-'Regulation (EU) 2016/679 (General Data Protection Regulation) Art 31 (cooperation with the supervisory authority)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'The controller and the processor and, where applicable, their representatives, shall cooperate, on request, with the supervisory authority in the performance of its tasks.']).

citation(cooperation_statement, [label-'Attested statement of cooperation with the request of the supervisory authority (outside fact cooperation_given, Regulation (EU) 2016/679 Art 31)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504']).

% implements(Key): the provenance marker; succeeds for every recorded key and
% fails for a key not recorded here.
implements(Key) :-
    citation(Key, _).

:- end_module(citations).
