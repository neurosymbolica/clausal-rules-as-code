% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% queries.clausal -- QUERY-COMBINATOR layer for eu/data_protection/gdpr_cooperation_with_the_supervisory_authority.
% A TOP-LAYER consumer: it imports the determination slice's PUBLIC
% predicates it calls, and nothing else.
%
% Source: Regulation (EU) 2016/679 (GDPR) Art 31, pinned unit
% 02016R0679-20160504#art_031, citation key eu_reg_2016_679_art_31.
%
% Query types this order serves:
%   #2 eligibility   -- gdpr_cooperation_with_the_supervisory_authority_status/2
%                       and decide_gdpr_cooperation_with_the_supervisory_authority/2
%                       (owned by the slice; the verdict atoms are
%                       cooperation_met | cooperation_not_met |
%                       cooperation_not_required, or a compound
%                       indeterminate/1, needs_legal_review/2, input_problems/1).
%   #7 justification -- gdpr_cooperation_with_the_supervisory_authority_checklist/2
%                       (owned by the slice; every item carries
%                       cite(eu_reg_2016_679_art_31)).
%   #16 what-if      -- gdpr_cooperation_with_the_supervisory_authority_what_if/4
%                       below: override one key, re-evaluate the status.
%
% The profile is an ATTRIBUTE LIST, not a dict, so the what-if override
% replaces the attribute(Key, _) item of the list (or appends one when the
% key is absent); kit/query_combinators' override_key/4 works on dicts.
%
% gdpr_cooperation_with_the_supervisory_authority_profile_keys/1: the six
%   contract keys, in root_exports / input_contract order.
% gdpr_cooperation_with_the_supervisory_authority_input_problems/2: the
%   kernel's input check, re-exported as the scaffold wrote it.
% ROOT EXPORTS: the six profile key atoms and the judgement value unsure
%   are declared here as bare atoms (arity 0) so the package root exposes
%   them; the three result atoms are declared by the slice.
%
% The judgement request_is_in_performance_of_authority_tasks is handed to
% the caller: no query here invents a crisp test for it. These clauses
% decide nothing statutory themselves (they only re-run the slice), so
% they carry no provenance marker.
% =====================================================================

:- module(queries, [
    gdpr_cooperation_with_the_supervisory_authority_profile_keys/1,
    gdpr_cooperation_with_the_supervisory_authority_input_problems/2,
    gdpr_cooperation_with_the_supervisory_authority_what_if/4,
    acts_as_controller/0,
    acts_as_processor/0,
    acts_as_representative_of_controller_or_processor/0,
    authority_request_made/0,
    request_is_in_performance_of_authority_tasks/0,
    cooperation_given/0,
    unsure/0
]).

:- use_module(eu/data_protection/gdpr_cooperation_with_the_supervisory_authority/kernel, [gdpr_cooperation_with_the_supervisory_authority_input_problems/2]).
:- use_module(eu/data_protection/gdpr_cooperation_with_the_supervisory_authority/gdpr_cooperation_with_the_supervisory_authority, [gdpr_cooperation_with_the_supervisory_authority_status/2]).

% ---- root exports: the profile key atoms and the judgement value ------
acts_as_controller.
acts_as_processor.
acts_as_representative_of_controller_or_processor.
authority_request_made.
request_is_in_performance_of_authority_tasks.
cooperation_given.
unsure.

% schema of top-level profile keys: the keys of the order's typed input contract, in its order
gdpr_cooperation_with_the_supervisory_authority_profile_keys([
    acts_as_controller,
    acts_as_processor,
    acts_as_representative_of_controller_or_processor,
    authority_request_made,
    request_is_in_performance_of_authority_tasks,
    cooperation_given
]).

% #16 what-if: re-evaluate with one key hypothetically overridden
gdpr_cooperation_with_the_supervisory_authority_what_if(Profile, OverriddenKey, NewValue, NewStatus) :-
    override_attribute(Profile, OverriddenKey, NewValue, Hypothesis),
    gdpr_cooperation_with_the_supervisory_authority_status(Hypothesis, NewStatus).

% override_attribute(Elements, OverriddenKey, NewValue, Hypothesis): the first
% attribute(OverriddenKey, _) item replaced, or one appended when the key is absent.
override_attribute([], OverriddenKey, NewValue, [attribute(OverriddenKey, NewValue)]).
override_attribute([attribute(ElementKey, _)|Elements], OverriddenKey, NewValue, [attribute(OverriddenKey, NewValue)|Elements]) :-
    ElementKey == OverriddenKey.
override_attribute([attribute(ElementKey, ElementValue)|Elements], OverriddenKey, NewValue, [attribute(ElementKey, ElementValue)|Remaining]) :-
    ElementKey \== OverriddenKey,
    override_attribute(Elements, OverriddenKey, NewValue, Remaining).

:- end_module(queries).
