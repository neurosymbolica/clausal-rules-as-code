% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% fixtures.clausal -- representative profiles for eu/data_protection/gdpr_cooperation_with_the_supervisory_authority.
% A TOP-LAYER consumer: it imports only the slice predicate it calls.
% Profile keys and subject ids are atoms and need no import.
%
% A profile is an ATTRIBUTE LIST [attribute(Key, Value), ...] (INTERFACE -
% THE PROFILE AND THE ATOMS). Art 31 states no figure, so there is no
% threshold to straddle: each route (step 0 to step 8 of INTERFACE - THE
% LIMBS) has a positive subject and a near-miss control that differs from
% it in ONE key and gets a different verdict.
%
%   step 0  wrong_type_role_key / wrong_type_control
%           duplicate_role_key / duplicate_control
%           unknown_key_given / unknown_key_control
%   step 1  no_request_made / request_made_and_cooperated
%   step 2  request_outside_authority_tasks / request_within_authority_tasks
%   step 3  caller_not_bound / representative_alone_bound
%   step 4  processor_key_missing / processor_key_given
%           request_key_missing / request_key_given
%   step 5  cooperation_statement_absent / cooperation_statement_attested_false
%           unsure_and_statement_absent / unsure_and_statement_given
%   step 6  tasks_judgement_unsure / tasks_judgement_true
%   step 7  request_made_and_cooperated (above)
%   step 8  cooperation_statement_attested_false (above)
% =====================================================================

:- module(fixtures, [
    gdpr_cooperation_with_the_supervisory_authority_subject/1,
    gdpr_cooperation_with_the_supervisory_authority_profile_for/2,
    gdpr_cooperation_with_the_supervisory_authority_assess/2
]).

:- use_module(eu/data_protection/gdpr_cooperation_with_the_supervisory_authority/gdpr_cooperation_with_the_supervisory_authority, [decide_gdpr_cooperation_with_the_supervisory_authority/2]).

% ---- Subject registry ------------------------------------------------
gdpr_cooperation_with_the_supervisory_authority_subject(wrong_type_role_key).
gdpr_cooperation_with_the_supervisory_authority_subject(wrong_type_control).
gdpr_cooperation_with_the_supervisory_authority_subject(duplicate_role_key).
gdpr_cooperation_with_the_supervisory_authority_subject(duplicate_control).
gdpr_cooperation_with_the_supervisory_authority_subject(unknown_key_given).
gdpr_cooperation_with_the_supervisory_authority_subject(unknown_key_control).
gdpr_cooperation_with_the_supervisory_authority_subject(no_request_made).
gdpr_cooperation_with_the_supervisory_authority_subject(request_made_and_cooperated).
gdpr_cooperation_with_the_supervisory_authority_subject(request_outside_authority_tasks).
gdpr_cooperation_with_the_supervisory_authority_subject(request_within_authority_tasks).
gdpr_cooperation_with_the_supervisory_authority_subject(caller_not_bound).
gdpr_cooperation_with_the_supervisory_authority_subject(representative_alone_bound).
gdpr_cooperation_with_the_supervisory_authority_subject(processor_key_missing).
gdpr_cooperation_with_the_supervisory_authority_subject(processor_key_given).
gdpr_cooperation_with_the_supervisory_authority_subject(request_key_missing).
gdpr_cooperation_with_the_supervisory_authority_subject(request_key_given).
gdpr_cooperation_with_the_supervisory_authority_subject(cooperation_statement_absent).
gdpr_cooperation_with_the_supervisory_authority_subject(cooperation_statement_attested_false).
gdpr_cooperation_with_the_supervisory_authority_subject(unsure_and_statement_absent).
gdpr_cooperation_with_the_supervisory_authority_subject(unsure_and_statement_given).
gdpr_cooperation_with_the_supervisory_authority_subject(tasks_judgement_unsure).
gdpr_cooperation_with_the_supervisory_authority_subject(tasks_judgement_true).

% ---- Profiles --------------------------------------------------------
% Step 0: a crisp role key given unsure; the control gives it true.
gdpr_cooperation_with_the_supervisory_authority_profile_for(wrong_type_role_key,
    [attribute(acts_as_controller, unsure),
     attribute(authority_request_made, false)]).
gdpr_cooperation_with_the_supervisory_authority_profile_for(wrong_type_control,
    [attribute(acts_as_controller, true),
     attribute(authority_request_made, false)]).

% Step 0: a contract key given twice (equal values); the control gives it once.
gdpr_cooperation_with_the_supervisory_authority_profile_for(duplicate_role_key,
    [attribute(acts_as_controller, true),
     attribute(acts_as_controller, true),
     attribute(authority_request_made, false)]).
gdpr_cooperation_with_the_supervisory_authority_profile_for(duplicate_control,
    [attribute(acts_as_controller, true),
     attribute(authority_request_made, false)]).

% Step 0: a key outside the six, repeated; the control leaves it out.
gdpr_cooperation_with_the_supervisory_authority_profile_for(unknown_key_given,
    [attribute(as_of_date, monday),
     attribute(acts_as_controller, true),
     attribute(as_of_date, tuesday),
     attribute(authority_request_made, false)]).
gdpr_cooperation_with_the_supervisory_authority_profile_for(unknown_key_control,
    [attribute(acts_as_controller, true),
     attribute(authority_request_made, false)]).

% Step 1: no request; the control has the request made (and the rest given).
gdpr_cooperation_with_the_supervisory_authority_profile_for(no_request_made,
    [attribute(acts_as_controller, true),
     attribute(authority_request_made, false),
     attribute(request_is_in_performance_of_authority_tasks, true),
     attribute(cooperation_given, attested(true, attestation(compliance_desk, received_2026_11_12, reply_sent, none)))]).
gdpr_cooperation_with_the_supervisory_authority_profile_for(request_made_and_cooperated,
    [attribute(acts_as_controller, true),
     attribute(authority_request_made, true),
     attribute(request_is_in_performance_of_authority_tasks, true),
     attribute(cooperation_given, attested(true, attestation(compliance_desk, received_2026_11_12, reply_sent, none)))]).

% Step 2: the request is judged outside the tasks; the control judges it within.
gdpr_cooperation_with_the_supervisory_authority_profile_for(request_outside_authority_tasks,
    [attribute(acts_as_processor, true),
     attribute(authority_request_made, true),
     attribute(request_is_in_performance_of_authority_tasks, false),
     attribute(cooperation_given, attested(true, attestation(compliance_desk, received_2026_11_12, reply_sent, none)))]).
gdpr_cooperation_with_the_supervisory_authority_profile_for(request_within_authority_tasks,
    [attribute(acts_as_processor, true),
     attribute(authority_request_made, true),
     attribute(request_is_in_performance_of_authority_tasks, true),
     attribute(cooperation_given, attested(true, attestation(compliance_desk, received_2026_11_12, reply_sent, none)))]).

% Step 3: all three role keys false; the control makes the representative true.
gdpr_cooperation_with_the_supervisory_authority_profile_for(caller_not_bound,
    [attribute(acts_as_controller, false),
     attribute(acts_as_processor, false),
     attribute(acts_as_representative_of_controller_or_processor, false),
     attribute(authority_request_made, true),
     attribute(request_is_in_performance_of_authority_tasks, true),
     attribute(cooperation_given, attested(true, attestation(compliance_desk, received_2026_11_12, reply_sent, none)))]).
gdpr_cooperation_with_the_supervisory_authority_profile_for(representative_alone_bound,
    [attribute(acts_as_controller, false),
     attribute(acts_as_processor, false),
     attribute(acts_as_representative_of_controller_or_processor, true),
     attribute(authority_request_made, true),
     attribute(request_is_in_performance_of_authority_tasks, true),
     attribute(cooperation_given, attested(true, attestation(compliance_desk, received_2026_11_12, reply_sent, none)))]).

% Step 4: controller false and processor absent; the control gives processor true.
gdpr_cooperation_with_the_supervisory_authority_profile_for(processor_key_missing,
    [attribute(acts_as_controller, false),
     attribute(authority_request_made, true),
     attribute(request_is_in_performance_of_authority_tasks, true),
     attribute(cooperation_given, attested(true, attestation(compliance_desk, received_2026_11_12, reply_sent, none)))]).
gdpr_cooperation_with_the_supervisory_authority_profile_for(processor_key_given,
    [attribute(acts_as_controller, false),
     attribute(acts_as_processor, true),
     attribute(authority_request_made, true),
     attribute(request_is_in_performance_of_authority_tasks, true),
     attribute(cooperation_given, attested(true, attestation(compliance_desk, received_2026_11_12, reply_sent, none)))]).

% Step 4: a role true and the request key absent; the control gives it false.
gdpr_cooperation_with_the_supervisory_authority_profile_for(request_key_missing,
    [attribute(acts_as_controller, true)]).
gdpr_cooperation_with_the_supervisory_authority_profile_for(request_key_given,
    [attribute(acts_as_controller, true),
     attribute(authority_request_made, false)]).

% Step 5: the attested statement absent; the control attests false (step 8).
gdpr_cooperation_with_the_supervisory_authority_profile_for(cooperation_statement_absent,
    [attribute(acts_as_controller, true),
     attribute(authority_request_made, true),
     attribute(request_is_in_performance_of_authority_tasks, true)]).
gdpr_cooperation_with_the_supervisory_authority_profile_for(cooperation_statement_attested_false,
    [attribute(acts_as_controller, true),
     attribute(authority_request_made, true),
     attribute(request_is_in_performance_of_authority_tasks, true),
     attribute(cooperation_given, attested(false, attestation(compliance_desk, received_2026_11_12, no_reply_sent, document(upload_seven, digest_seven))))]).

% Step 5 before step 6: judgement unsure and statement absent; the control gives
% the statement (step 6).
gdpr_cooperation_with_the_supervisory_authority_profile_for(unsure_and_statement_absent,
    [attribute(acts_as_controller, true),
     attribute(authority_request_made, true),
     attribute(request_is_in_performance_of_authority_tasks, unsure)]).
gdpr_cooperation_with_the_supervisory_authority_profile_for(unsure_and_statement_given,
    [attribute(acts_as_controller, true),
     attribute(authority_request_made, true),
     attribute(request_is_in_performance_of_authority_tasks, unsure),
     attribute(cooperation_given, attested(true, attestation(compliance_desk, received_2026_11_12, reply_sent, none)))]).

% Step 6: judgement unsure with the statement given; the control judges true.
gdpr_cooperation_with_the_supervisory_authority_profile_for(tasks_judgement_unsure,
    [attribute(acts_as_representative_of_controller_or_processor, true),
     attribute(authority_request_made, true),
     attribute(request_is_in_performance_of_authority_tasks, unsure),
     attribute(cooperation_given, attested(true, attestation(compliance_desk, received_2026_11_12, reply_sent, url(address_seven, retrieved_2026_11_12))))]).
gdpr_cooperation_with_the_supervisory_authority_profile_for(tasks_judgement_true,
    [attribute(acts_as_representative_of_controller_or_processor, true),
     attribute(authority_request_made, true),
     attribute(request_is_in_performance_of_authority_tasks, true),
     attribute(cooperation_given, attested(true, attestation(compliance_desk, received_2026_11_12, reply_sent, url(address_seven, retrieved_2026_11_12))))]).

% ---- Convenience wrapper ---------------------------------------------
gdpr_cooperation_with_the_supervisory_authority_assess(Subject, Result) :-
    gdpr_cooperation_with_the_supervisory_authority_profile_for(Subject, Profile),
    decide_gdpr_cooperation_with_the_supervisory_authority(Profile, Result).

:- end_module(fixtures).
