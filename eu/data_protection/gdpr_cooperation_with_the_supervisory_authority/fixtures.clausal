% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% fixtures.clausal -- representative profiles for eu/data_protection/gdpr_cooperation_with_the_supervisory_authority.
% A TOP-LAYER consumer: it imports the determination slice's PUBLIC
% predicate it calls -- that is the whole import list. Profile keys and
% subject ids are atoms and need no import.
%
% A profile is an ATTRIBUTE LIST [attribute(Key, Value), ...] (the order's
% typed input contract). Art 31 has no numeric threshold, so the near-miss
% controls are ONE-KEY flips: each route has a positive subject and a
% control that differs from it in a single key and gets another verdict.
%
% Routes (INTERFACE - THE LIMBS) and their subjects:
%   step 7 cooperation_met           controller_cooperated, representative_cooperated,
%                                    request_inside_tasks
%   step 8 cooperation_not_met       controller_refused (control of controller_cooperated)
%   step 1 cooperation_not_required  no_request (control: controller_cooperated),
%                                    no_request_roles_absent
%   step 2 cooperation_not_required  request_outside_tasks (control: request_inside_tasks)
%   step 3 cooperation_not_required  not_bound (control: representative_cooperated)
%   step 4 indeterminate([Key])      role_unknown (control: role_stated_false),
%                                    two_keys_missing
%   step 5 cross_reference_unresolved statement_missing_true, statement_missing_unsure
%                                    (control: controller_cooperated)
%   step 6 open_textured             judgement_unsure (control: controller_cooperated)
%   step 0 input_problems            duplicate_and_unknown, wrong_types
%                                    (control: controller_cooperated)
% =====================================================================

:- module(fixtures, [
    gdpr_cooperation_with_the_supervisory_authority_subject/1,
    gdpr_cooperation_with_the_supervisory_authority_profile_for/2,
    gdpr_cooperation_with_the_supervisory_authority_assess/2
]).

:- use_module(eu/data_protection/gdpr_cooperation_with_the_supervisory_authority/gdpr_cooperation_with_the_supervisory_authority, [decide_gdpr_cooperation_with_the_supervisory_authority/2]).

% ---- Subject registry ------------------------------------------------
gdpr_cooperation_with_the_supervisory_authority_subject(controller_cooperated).
gdpr_cooperation_with_the_supervisory_authority_subject(controller_refused).
gdpr_cooperation_with_the_supervisory_authority_subject(representative_cooperated).
gdpr_cooperation_with_the_supervisory_authority_subject(not_bound).
gdpr_cooperation_with_the_supervisory_authority_subject(no_request).
gdpr_cooperation_with_the_supervisory_authority_subject(no_request_roles_absent).
gdpr_cooperation_with_the_supervisory_authority_subject(request_inside_tasks).
gdpr_cooperation_with_the_supervisory_authority_subject(request_outside_tasks).
gdpr_cooperation_with_the_supervisory_authority_subject(role_unknown).
gdpr_cooperation_with_the_supervisory_authority_subject(role_stated_false).
gdpr_cooperation_with_the_supervisory_authority_subject(two_keys_missing).
gdpr_cooperation_with_the_supervisory_authority_subject(statement_missing_true).
gdpr_cooperation_with_the_supervisory_authority_subject(statement_missing_unsure).
gdpr_cooperation_with_the_supervisory_authority_subject(judgement_unsure).
gdpr_cooperation_with_the_supervisory_authority_subject(duplicate_and_unknown).
gdpr_cooperation_with_the_supervisory_authority_subject(wrong_types).

% ---- Profiles --------------------------------------------------------
% Step 7: a controller, on a request within the tasks, attested cooperating.
gdpr_cooperation_with_the_supervisory_authority_profile_for(controller_cooperated, Profile) :-
    Profile = [
        attribute(acts_as_controller, true),
        attribute(acts_as_processor, false),
        attribute(acts_as_representative_of_controller_or_processor, false),
        attribute(authority_request_made, true),
        attribute(request_is_in_performance_of_authority_tasks, true),
        attribute(cooperation_given, attested(true, attestation(compliance_officer, recorded_on_twelfth_november, response_sent, none)))
    ].
% Step 8 control: one key flipped -- the attested statement says false.
gdpr_cooperation_with_the_supervisory_authority_profile_for(controller_refused, Profile) :-
    Profile = [
        attribute(acts_as_controller, true),
        attribute(acts_as_processor, false),
        attribute(acts_as_representative_of_controller_or_processor, false),
        attribute(authority_request_made, true),
        attribute(request_is_in_performance_of_authority_tasks, true),
        attribute(cooperation_given, attested(false, attestation(compliance_officer, recorded_on_twelfth_november, no_response_sent, none)))
    ].
% Step 7 through the representative alone (reading 1, Q4).
gdpr_cooperation_with_the_supervisory_authority_profile_for(representative_cooperated, Profile) :-
    Profile = [
        attribute(acts_as_controller, false),
        attribute(acts_as_processor, false),
        attribute(acts_as_representative_of_controller_or_processor, true),
        attribute(authority_request_made, true),
        attribute(request_is_in_performance_of_authority_tasks, true),
        attribute(cooperation_given, attested(true, attestation(union_representative, recorded_on_twelfth_november, documents_supplied, document(upload_identifier_one, digest_value_one))))
    ].
% Step 3 control of representative_cooperated: the one true role flipped to false.
gdpr_cooperation_with_the_supervisory_authority_profile_for(not_bound, Profile) :-
    Profile = [
        attribute(acts_as_controller, false),
        attribute(acts_as_processor, false),
        attribute(acts_as_representative_of_controller_or_processor, false),
        attribute(authority_request_made, true),
        attribute(request_is_in_performance_of_authority_tasks, true),
        attribute(cooperation_given, attested(true, attestation(union_representative, recorded_on_twelfth_november, documents_supplied, document(upload_identifier_one, digest_value_one))))
    ].
% Step 1 control of controller_cooperated: no request was made.
gdpr_cooperation_with_the_supervisory_authority_profile_for(no_request, Profile) :-
    Profile = [
        attribute(acts_as_controller, true),
        attribute(acts_as_processor, false),
        attribute(acts_as_representative_of_controller_or_processor, false),
        attribute(authority_request_made, false),
        attribute(request_is_in_performance_of_authority_tasks, true),
        attribute(cooperation_given, attested(true, attestation(compliance_officer, recorded_on_twelfth_november, response_sent, none)))
    ].
% Step 1 decides before the absent role keys are read.
gdpr_cooperation_with_the_supervisory_authority_profile_for(no_request_roles_absent, Profile) :-
    Profile = [
        attribute(authority_request_made, false)
    ].
% Step 7 with the request key present and the judgement true.
gdpr_cooperation_with_the_supervisory_authority_profile_for(request_inside_tasks, Profile) :-
    Profile = [
        attribute(acts_as_processor, true),
        attribute(authority_request_made, true),
        attribute(request_is_in_performance_of_authority_tasks, true),
        attribute(cooperation_given, attested(true, attestation(processor_officer, recorded_on_twelfth_november, access_granted, url(address_of_record, retrieved_on_twelfth_november))))
    ].
% Step 2 control of request_inside_tasks: the judgement flipped to false.
gdpr_cooperation_with_the_supervisory_authority_profile_for(request_outside_tasks, Profile) :-
    Profile = [
        attribute(acts_as_processor, true),
        attribute(authority_request_made, true),
        attribute(request_is_in_performance_of_authority_tasks, false),
        attribute(cooperation_given, attested(true, attestation(processor_officer, recorded_on_twelfth_november, access_granted, url(address_of_record, retrieved_on_twelfth_november))))
    ].
% Step 4: no role true, the controller key absent -- named first.
gdpr_cooperation_with_the_supervisory_authority_profile_for(role_unknown, Profile) :-
    Profile = [
        attribute(acts_as_processor, false),
        attribute(acts_as_representative_of_controller_or_processor, false),
        attribute(authority_request_made, true),
        attribute(request_is_in_performance_of_authority_tasks, true),
        attribute(cooperation_given, attested(true, attestation(compliance_officer, recorded_on_twelfth_november, response_sent, none)))
    ].
% Step 3 control of role_unknown: the controller key supplied as false.
gdpr_cooperation_with_the_supervisory_authority_profile_for(role_stated_false, Profile) :-
    Profile = [
        attribute(acts_as_controller, false),
        attribute(acts_as_processor, false),
        attribute(acts_as_representative_of_controller_or_processor, false),
        attribute(authority_request_made, true),
        attribute(request_is_in_performance_of_authority_tasks, true),
        attribute(cooperation_given, attested(true, attestation(compliance_officer, recorded_on_twelfth_november, response_sent, none)))
    ].
% Step 4, bound: only the first of the two missing keys is named.
gdpr_cooperation_with_the_supervisory_authority_profile_for(two_keys_missing, Profile) :-
    Profile = [
        attribute(acts_as_controller, true)
    ].
% Step 5: the outside fact is absent, judgement true.
gdpr_cooperation_with_the_supervisory_authority_profile_for(statement_missing_true, Profile) :-
    Profile = [
        attribute(acts_as_controller, true),
        attribute(acts_as_processor, false),
        attribute(acts_as_representative_of_controller_or_processor, false),
        attribute(authority_request_made, true),
        attribute(request_is_in_performance_of_authority_tasks, true)
    ].
% Step 5 before step 6: the outside fact is absent, judgement unsure.
gdpr_cooperation_with_the_supervisory_authority_profile_for(statement_missing_unsure, Profile) :-
    Profile = [
        attribute(acts_as_controller, true),
        attribute(acts_as_processor, false),
        attribute(acts_as_representative_of_controller_or_processor, false),
        attribute(authority_request_made, true),
        attribute(request_is_in_performance_of_authority_tasks, unsure)
    ].
% Step 6: the judgement unsure, the statement present -- a lawyer decides.
gdpr_cooperation_with_the_supervisory_authority_profile_for(judgement_unsure, Profile) :-
    Profile = [
        attribute(acts_as_controller, true),
        attribute(acts_as_processor, false),
        attribute(acts_as_representative_of_controller_or_processor, false),
        attribute(authority_request_made, true),
        attribute(request_is_in_performance_of_authority_tasks, unsure),
        attribute(cooperation_given, attested(true, attestation(compliance_officer, recorded_on_twelfth_november, response_sent, none)))
    ].
% Step 0: a repeated contract key and a key outside the six.
gdpr_cooperation_with_the_supervisory_authority_profile_for(duplicate_and_unknown, Profile) :-
    Profile = [
        attribute(acts_as_controller, true),
        attribute(acts_as_controller, true),
        attribute(authority_request_made, true),
        attribute(colour, blue)
    ].
% Step 0: a crisp key given unsure and an outside fact that is not attested(...).
gdpr_cooperation_with_the_supervisory_authority_profile_for(wrong_types, Profile) :-
    Profile = [
        attribute(acts_as_controller, true),
        attribute(acts_as_processor, unsure),
        attribute(authority_request_made, true),
        attribute(request_is_in_performance_of_authority_tasks, true),
        attribute(cooperation_given, yes)
    ].

% ---- Convenience wrapper ---------------------------------------------
gdpr_cooperation_with_the_supervisory_authority_assess(Subject, Result) :-
    gdpr_cooperation_with_the_supervisory_authority_profile_for(Subject, Profile),
    decide_gdpr_cooperation_with_the_supervisory_authority(Profile, Result).

:- end_module(fixtures).
