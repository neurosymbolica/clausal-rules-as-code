% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_properties.clausal -- structural PROPERTIES over the subject set.
% Totality and determinism: every registered subject yields exactly one
% answer from every query and from the facade. Citation completeness:
% every cite(Key) returned is a recorded citation. Domain invariants:
% item order, the confirmation first, and keys a query does not read never
% change its answer.
% Run: python -m clausal.testing eu/data_protection/gdpr_art15_access_copy/tests/test_properties.clausal
% =====================================================================
:- module(test_properties, []).
:- use_module(eu/data_protection/gdpr_art15_access_copy/gdpr_art15_access_copy, [
    decide_gdpr_art15_access_copy/2,
    access_answer_items/4,
    access_answer_items_missing/4,
    copy_scope/3,
    copy_fee/3,
    information_form/3
]).
:- use_module(eu/data_protection/gdpr_art15_access_copy/fixtures, [
    gdpr_art15_access_copy_subject/1,
    gdpr_art15_access_copy_profile_for/2
]).
:- use_module(eu/data_protection/gdpr_art15_access_copy/citations, [citation/2]).

query_name(decide).
query_name(items).
query_name(missing).
query_name(scope).
query_name(fee).
query_name(form).

query_answer(decide, Profile, Verdict) :-
    decide_gdpr_art15_access_copy(Profile, Verdict).
query_answer(items, Profile, answer(Result, Basis, Citations)) :-
    access_answer_items(Profile, Result, Basis, Citations).
query_answer(missing, Profile, answer(Result, Basis, Citations)) :-
    access_answer_items_missing(Profile, Result, Basis, Citations).
query_answer(scope, Profile, answer(Result, Citations)) :-
    copy_scope(Profile, Result, Citations).
query_answer(fee, Profile, answer(Result, Citations)) :-
    copy_fee(Profile, Result, Citations).
query_answer(form, Profile, answer(Result, Citations)) :-
    information_form(Profile, Result, Citations).

answer_count(Query, Subject, Count) :-
    query_name(Query),
    gdpr_art15_access_copy_subject(Subject),
    gdpr_art15_access_copy_profile_for(Subject, Profile),
    findall(Answer, query_answer(Query, Profile, Answer), Answers),
    length(Answers, Count).

subject_classifies(Subject) :-
    gdpr_art15_access_copy_subject(Subject),
    gdpr_art15_access_copy_profile_for(Subject, Profile),
    decide_gdpr_art15_access_copy(Profile, _Verdict).

% sort/2 collapses a subject that classifies more than once.
test(totality_every_subject_classifies) :-
    findall(Subject, gdpr_art15_access_copy_subject(Subject), Subjects),
    sort(Subjects, SubjectSet),
    findall(Subject, subject_classifies(Subject), ClassifiedSubjects),
    sort(ClassifiedSubjects, SubjectSet).

% Every (query, subject) pair counts exactly one solution: a zero (not
% total) or a two (not deterministic) would leave another count in the set.
test(determinism_every_query_answers_each_subject_exactly_once) :-
    findall(Count, answer_count(_Query, _Subject, Count), Counts),
    sort(Counts, [1]).

% ---- citation completeness -------------------------------------------
answer_citations(answer(_, _, Citations), Citations).
answer_citations(answer(_, Citations), Citations).
answer_citations(gdpr_art15_access_copy_verdict(_, Citations), Citations).

returned_citation(Key) :-
    query_name(Query),
    gdpr_art15_access_copy_subject(Subject),
    gdpr_art15_access_copy_profile_for(Subject, Profile),
    query_answer(Query, Profile, Answer),
    answer_citations(Answer, Citations),
    member(cite(Key), Citations).

recorded_citation(Key) :-
    citation(Key, _Record).

test(every_returned_citation_is_recorded) :-
    findall(Key, returned_citation(Key), Keys),
    sort(Keys, Distinct),
    Distinct = [_|_],
    maplist(recorded_citation, Distinct).

% ---- item order and the confirmation first ---------------------------
item_order([confirmation_of_processing, access_to_personal_data, purposes_of_processing, categories_of_personal_data, recipients_or_categories_of_recipients, storage_period_or_criteria, rights_to_rectification_erasure_restriction_and_objection, right_to_lodge_complaint, source_of_personal_data, automated_decision_making_information, transfer_safeguards_information, copy_of_personal_data]).

ordered_within([], _).
ordered_within([Item|Items], [Item|Order]) :-
    ordered_within(Items, Order).
ordered_within([Item|Items], [Other|Order]) :-
    dif(Item, Other),
    ordered_within([Item|Items], Order).

list_result(Subject, [Item|Items]) :-
    gdpr_art15_access_copy_subject(Subject),
    gdpr_art15_access_copy_profile_for(Subject, Profile),
    access_answer_items(Profile, [Item|Items], _, _).
list_result(Subject, [Item|Items]) :-
    gdpr_art15_access_copy_subject(Subject),
    gdpr_art15_access_copy_profile_for(Subject, Profile),
    access_answer_items_missing(Profile, [Item|Items], _, _).

ordered_list_result(Subject, Result) :-
    list_result(Subject, Result),
    item_order(Order),
    ordered_within(Result, Order).

test(every_item_list_is_in_item_order_each_item_once) :-
    findall(Subject-Result, list_result(Subject, Result), Results),
    Results = [_|_],
    findall(Subject-Result, ordered_list_result(Subject, Result), OrderedResults),
    OrderedResults == Results.

test(every_owed_list_opens_with_the_confirmation) :-
    findall(First,
            ( gdpr_art15_access_copy_subject(Subject),
              gdpr_art15_access_copy_profile_for(Subject, Profile),
              access_answer_items(Profile, [First|_], _, _)
            ),
            Firsts),
    sort(Firsts, [confirmation_of_processing]).

% ---- keys a query does not read never change its answer -------------
settled_items_profile([
    attribute(items_provided, []),
    attribute(personal_data_concerning_data_subject_processed, true),
    attribute(disclosure_to_recipients_made_or_envisaged, false),
    attribute(some_personal_data_not_collected_from_data_subject, false),
    attribute(source_information_available, false),
    attribute(automated_decision_making_referred_to_in_article_22, attested(false, attestation(host, recorded_at, attested_by_caller, none))),
    attribute(transfer_to_third_country_or_international_organisation, false)
]).

test(the_items_query_never_reads_the_article_15_4_judgement) :-
    settled_items_profile(Base),
    findall(answer(Result, Basis, Citations),
            ( member(Judgement, [true, false, unsure]),
              access_answer_items([attribute(copy_would_adversely_affect_rights_and_freedoms_of_others, Judgement)|Base], Result, Basis, Citations)
            ),
            Answers),
    length(Answers, 3),
    sort(Answers, [_]).

test(the_missing_query_never_reads_the_copy_fee_or_form_keys) :-
    settled_items_profile(Base),
    findall(answer(Result, Basis, Citations),
            ( member(Flag, [true, false]),
              access_answer_items_missing([attribute(further_copy_requested, Flag), attribute(request_made_by_electronic_means, Flag), attribute(copy_would_adversely_affect_rights_and_freedoms_of_others, Flag)|Base], Result, Basis, Citations)
            ),
            Answers),
    length(Answers, 2),
    sort(Answers, [_]).

test(the_copy_scope_never_reads_the_fee_key) :-
    findall(Result,
            ( member(Flag, [true, false]),
              copy_scope([attribute(personal_data_concerning_data_subject_processed, true), attribute(copy_would_adversely_affect_rights_and_freedoms_of_others, true), attribute(further_copy_requested, Flag)], Result, _)
            ),
            Results),
    Results == [copy_limited_by_rights_and_freedoms_of_others, copy_limited_by_rights_and_freedoms_of_others].

test(the_form_never_reads_the_other_form_key_without_an_electronic_request) :-
    findall(Result,
            ( member(Flag, [true, false]),
              information_form([attribute(request_made_by_electronic_means, false), attribute(other_form_requested_by_data_subject, Flag)], Result, _)
            ),
            Results),
    Results == [no_electronic_request, no_electronic_request].

:- end_module(test_properties).
