% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% kernel.clausal -- the SHARED FLOOR for eu/dora_ict_incident_management_process (deontic family).
% Source: Regulation (EU) 2022/2554 (DORA), Article 17 (ICT-related incident
% management process: paragraphs 1, 2 and 3, points (a) to (f)) and
% Article 18(2) (classification of cyber threats as significant), pinned
% text 32022R2554 (original OJ text as published).
%
% DAG root of the determination-slices layout. It holds ONLY the
% PREDICATES that two or more files CALL. This order has ONE determination
% slice (dora_ict_incident_management_process.clausal), so no logic
% predicate is shared. The exception is the order's input check,
% dora_ict_incident_management_process_input_problems/2, which the scaffold
% writes here from the typed input contract and exports for every slice
% and for queries.clausal to import.
%
% Atoms and data terms need NO declaration and NO import. Nothing
% vocabulary-shaped lives here; the comment block below only RECORDS the
% result terms so every file spells them alike.
%
% RESULT TERMS (INTERFACE - THE CALLED CONTRACT). Each query takes PROFILE
% and returns RESULT and CITATIONS; each call yields exactly ONE solution.
%   ict_incident_management_process_duties_required(Profile, Result, Citations)
%     Result: required(Duties)  -- Duties all ten duty atoms in duty order;
%             or input_problems(Problems).
%   ict_incident_management_process_duties_complete(Profile, Result, Citations)
%     Result: complete | incomplete (bare atoms, final answers);
%             or a status compound.
%   ict_incident_management_process_duties_outstanding(Profile, Result, Citations)
%     Result: none_outstanding (bare atom, final answer)
%             | outstanding(Duties) -- Duties the failing duties in duty order;
%             or a status compound.
%   Status compounds (never final; Citations always []):
%     indeterminate([Key])        -- exactly one bare missing key atom;
%                                    the bare atom indeterminate is never written;
%     needs_legal_review(open_textured(Key, cite(CitationKey)),
%                        [inputs_relied_on(Pairs)])
%                                 -- Key the first unsure judgement key,
%                                    CitationKey its duty's citation key,
%                                    Pairs every present Key-Value in
%                                    root_exports order; an unscored
%                                    provenance(Clause, Citations) item may
%                                    follow inputs_relied_on(Pairs);
%     input_problems(Problems)    -- Problems from the input check below:
%                                    duplicate_key(Key), wrong_type(Key),
%                                    unknown_key(Key), or [wrong_type(profile)].
%   Citations of a final answer are cite(Key) terms (a set; order not
%   scored). THE FIXED CITATIONS (complete, incomplete, none_outstanding,
%   required(_)):
%     [cite(eu_reg_2022_2554_art_17_1), cite(eu_reg_2022_2554_art_17_2),
%      cite(eu_reg_2022_2554_art_17_3), cite(eu_reg_2022_2554_art_18_2)]
%   outstanding(Duties) cites each outstanding duty's own key, once each.
%
% Facade verdict term of the slice:
%   dora_ict_incident_management_process_verdict(Status, Citations)
%     Status: complete | incomplete | indeterminate | needs_legal_review
%             | input_problems (the principal functor name of the Result of
%             ict_incident_management_process_duties_complete);
%     Citations: that query's citations.
%
% Duty atoms (duty order = printed order of the text = key order):
%   incident_management_process, recording_of_incidents_and_significant_cyber_threats,
%   monitoring_handling_and_follow_up_procedures, early_warning_indicators,
%   identification_and_classification_procedures, incident_roles_and_responsibilities,
%   communication_and_escalation_plans,
%   reporting_to_senior_management_and_management_body,
%   incident_response_procedures, classification_of_significant_cyber_threats.
% Judgement values: the atoms true, false and unsure.
% =====================================================================

:- module(kernel, [dora_ict_incident_management_process_input_problems/2]).

:- use_module(library(reif), [memberd_t/3]).

% ---- input checks: the problems a profile has, if any -----------
% dora_ict_incident_management_process_input_problems(Profile, Problems): Problems = [] means the profile can be
% judged. Written from the order's typed input contract
% (input_contract.types.profile: attribute_list).
% Each public query calls this check first: it gives its normal answer only when
% Problems = [], and when Problems is not [] it gives the answer the order states for
% a profile with input problems.
% It gives exactly one answer for every Profile, and the answer is ground except for a
% Key named as given:
% - a Profile that is not an attribute list [attribute(Key, Value), ...] gives [wrong_type(profile)]:
%   an unbound Profile, a partial list, a list holding an unbound item or an item that is
%   not attribute(_, _);
% - a Key that is not an atom (a number, a string, a compound term, an unbound variable)
%   is a key outside the contract: unknown_key(Key), Key as given;
% - otherwise, for each contract key in the contract's key order, duplicate_key(Key) when
%   the key occurs more than once in Profile (whatever its values: none of them is read,
%   so it is never also wrong_type(Key)), else wrong_type(Key) when its one value is
%   outside its type; then unknown_key(Key) for each key outside the contract, in the
%   order of its first occurrence in Profile. Each key is named once. An absent key is
%   not a problem.
% Every step is complementary clauses: exactly one clause holds for each input.
dora_ict_incident_management_process_input_problems(Profile, Problems) :-
    attribute_list_t(Profile, IsAttributeList),
    profile_problems(IsAttributeList, Profile, Problems).

profile_problems(false, _, [wrong_type(profile)]).
profile_problems(true, Profile, Problems) :-
    Keys = [ict_related_incident_management_process_defined_established_and_implemented, all_ict_related_incidents_and_significant_cyber_threats_recorded, procedures_for_monitoring_handling_follow_up_and_root_causes_established, early_warning_indicators_put_in_place, procedures_to_identify_track_log_categorise_and_classify_incidents_established, roles_and_responsibilities_for_incident_types_and_scenarios_assigned, communication_notification_escalation_and_counterpart_information_plans_set_out, major_incidents_reported_to_senior_management_and_management_body_informed, incident_response_procedures_established, cyber_threats_classified_as_significant_on_the_article_18_2_criteria],
    unknown_keys(Profile, Keys, UnknownKeyProblems),
    key_problems(Keys, Profile, UnknownKeyProblems, Problems).

% The contract: each key and the type of its value.
key_type(ict_related_incident_management_process_defined_established_and_implemented, judgement).
key_type(all_ict_related_incidents_and_significant_cyber_threats_recorded, judgement).
key_type(procedures_for_monitoring_handling_follow_up_and_root_causes_established, judgement).
key_type(early_warning_indicators_put_in_place, judgement).
key_type(procedures_to_identify_track_log_categorise_and_classify_incidents_established, judgement).
key_type(roles_and_responsibilities_for_incident_types_and_scenarios_assigned, judgement).
key_type(communication_notification_escalation_and_counterpart_information_plans_set_out, judgement).
key_type(major_incidents_reported_to_senior_management_and_management_body_informed, judgement).
key_type(incident_response_procedures_established, judgement).
key_type(cyber_threats_classified_as_significant_on_the_article_18_2_criteria, judgement).

% attribute_list_t(Term, T): T is true when Term is a list of attribute(Key, Value)
% items, whatever each Key is; false for anything else, an unbound Term or item included.
attribute_list_t(Term, false) :-
    var(Term).
attribute_list_t(Term, true) :-
    Term == [].
attribute_list_t(Term, T) :-
    nonvar(Term),
    Term = [Element|Elements],
    attribute_t(Element, ElementIsAttribute),
    attribute_list_t(Elements, ElementsAreAttributes),
    truth_and(ElementIsAttribute, ElementsAreAttributes, T).
attribute_list_t(Term, false) :-
    nonvar(Term),
    Term \== [],
    Term \= [_|_].

attribute_t(Element, false) :-
    var(Element).
attribute_t(Element, true) :-
    nonvar(Element),
    Element = attribute(_, _).
attribute_t(Element, false) :-
    nonvar(Element),
    Element \= attribute(_, _).

% Unknown keys, in profile order, each once: Known grows by each key named. A key is
% known when it is identical (==) to one in Known, so an unbound Key is never bound:
% the same variable twice is one unknown key, two different variables are two.
unknown_keys([], _, []).
unknown_keys([attribute(Key, _)|Elements], Known, Problems) :-
    known_t(Key, Known, IsKnown),
    name_unknown_key(IsKnown, Key, Known, Elements, Problems).

known_t(_, [], false).
known_t(Key, [Known|_], true) :-
    Known == Key.
known_t(Key, [Known|Knowns], T) :-
    Known \== Key,
    known_t(Key, Knowns, T).

name_unknown_key(true, _, Known, Elements, Problems) :-
    unknown_keys(Elements, Known, Problems).
name_unknown_key(false, Key, Known, Elements, [unknown_key(Key)|Problems]) :-
    unknown_keys(Elements, [Key|Known], Problems).

% Contract keys, in contract order: duplicate_key(Key) when the key occurs more than once
% (none of its values is read), else wrong_type(Key) when its one value is outside the
% key's type. An absent key has no value to check.
key_problems([], _, Problems, Problems).
key_problems([Key|Keys], Profile, LaterProblems, Problems) :-
    key_type(Key, Type),
    key_occurrences(Profile, Key, Occurrences),
    key_problems(Keys, Profile, LaterProblems, KeyProblems),
    name_key_problem(Occurrences, Key, Type, Profile, KeyProblems, Problems).

% key_occurrences(Elements, Key, Occurrences): none, one or many items give Key.
key_occurrences([], _, none).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey == Key,
    key_occurrences(Elements, Key, RestOccurrences),
    one_more_occurrence(RestOccurrences, Occurrences).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey \== Key,
    key_occurrences(Elements, Key, Occurrences).

one_more_occurrence(none, one).
one_more_occurrence(one, many).
one_more_occurrence(many, many).

name_key_problem(none, _, _, _, Problems, Problems).
name_key_problem(many, Key, _, _, Problems, [duplicate_key(Key)|Problems]).
name_key_problem(one, Key, Type, Profile, KeyProblems, Problems) :-
    values_in_type_t(Profile, Key, Type, InType),
    name_wrong_type(InType, Key, KeyProblems, Problems).

name_wrong_type(true, _, Problems, Problems).
name_wrong_type(false, Key, Problems, [wrong_type(Key)|Problems]).

% values_in_type_t(Elements, Key, Type, T): T is true when every value Elements gives Key is
% in Type (true when Elements gives Key none).
values_in_type_t([], _, _, true).
values_in_type_t([attribute(ElementKey, Value)|Elements], Key, Type, T) :-
    ElementKey == Key,
    value_in_type_t(Type, Value, ValueInType),
    values_in_type_t(Elements, Key, Type, RestInType),
    truth_and(ValueInType, RestInType, T).
values_in_type_t([attribute(ElementKey, _)|Elements], Key, Type, T) :-
    ElementKey \== Key,
    values_in_type_t(Elements, Key, Type, T).

% A value with an unbound part is outside every type; a ground one is checked.
value_in_type_t(Type, Value, T) :-
    term_variables(Value, Variables),
    ground_value_in_type_t(Variables, Type, Value, T).

ground_value_in_type_t([_|_], _, _, false).
ground_value_in_type_t([], Type, Value, T) :-
    in_type_t(Type, Value, T).

% in_type_t(Type, Value, T): one clause per type, for a ground Value.
in_type_t(judgement, Value, T) :-
    in_type_t(one_of([boolean, enum([unsure])]), Value, T).

in_type_t(boolean, Value, T) :-
    memberd_t(Value, [true, false], T).

in_type_t(enum(Values), Value, T) :-
    memberd_t(Value, Values, T).

in_type_t(one_of(Types), Value, T) :-
    in_some_type_t(Types, Value, T).

truth_and(true, T, T).
truth_and(false, _, false).

% in_some_type_t(Types, Value, T): T is true when Value is in at least one of Types.
in_some_type_t([], _, false).
in_some_type_t([Type|Types], Value, T) :-
    in_type_t(Type, Value, InType),
    in_some_type_t(Types, Value, InAnother),
    truth_or(InType, InAnother, T).

truth_or(true, _, true).
truth_or(false, T, T).

test(an_empty_profile_has_no_problem) :-
    dora_ict_incident_management_process_input_problems([], []).
test(a_judgement_key_with_a_judgement_value_has_no_problem) :-
    dora_ict_incident_management_process_input_problems([attribute(early_warning_indicators_put_in_place, unsure)], []).
test(a_non_list_profile_is_wrong_type_profile) :-
    dora_ict_incident_management_process_input_problems(not_a_list, [wrong_type(profile)]).
test(an_unbound_profile_is_wrong_type_profile) :-
    dora_ict_incident_management_process_input_problems(_, [wrong_type(profile)]).
test(a_value_outside_the_judgement_type_is_wrong_type) :-
    dora_ict_incident_management_process_input_problems([attribute(early_warning_indicators_put_in_place, yes)], [wrong_type(early_warning_indicators_put_in_place)]).
test(a_repeated_contract_key_is_duplicate_key_only) :-
    dora_ict_incident_management_process_input_problems([attribute(incident_response_procedures_established, true), attribute(incident_response_procedures_established, maybe)], [duplicate_key(incident_response_procedures_established)]).
test(a_key_outside_the_contract_is_unknown_key) :-
    dora_ict_incident_management_process_input_problems([attribute(colour, red)], [unknown_key(colour)]).

:- end_module(kernel).
