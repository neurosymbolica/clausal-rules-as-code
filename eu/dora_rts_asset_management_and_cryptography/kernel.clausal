% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% kernel.clausal -- the SHARED FLOOR for eu/dora_rts_asset_management_and_cryptography (deontic family).
% DAG root of the determination-slices layout. It holds ONLY the
% PREDICATES that two or more files CALL.
%
% Source: Commission Delegated Regulation (EU) 2024/1774 (RTS on the ICT
% risk management framework), Articles 4 to 7 (ICT asset management;
% encryption, cryptographic controls and cryptographic key management),
% and Regulation (EU) 2022/2554 (DORA) Article 16(1), first subparagraph
% (the gate of every query, reading (2)). The input check below rests on
% the order's typed input contract, not on an article.
%
% Shared here: the order's input check
% dora_rts_asset_management_and_cryptography_input_problems/2. The scaffold
% writes it here from the typed input contract. It is called by the
% determination slice and re-exported by queries.clausal. Nothing
% single-caller lives here. The duty table, the referral rows, the fixed
% citations and the relied-on pairs are used only by the one determination
% slice (dora_rts_asset_management_and_cryptography.clausal), so they live there.
%
% Atoms and data terms need NO declaration and NO import. The comment
% block below only RECORDS the result terms, so that every file spells
% them alike.
%
% RESULT TERMS (the called contract; each query yields exactly ONE solution):
%   rts_asset_management_and_cryptography_duties_required(Profile, Result, Citations)
%     Result is one of:
%     - required(Duties): Duties is a non-empty list of duty atoms in DUTY ORDER;
%     - simplified_framework_entity;
%     - a status compound.
%   rts_asset_management_and_cryptography_duties_complete(Profile, Result, Citations)
%     Result is one of: complete | incomplete | simplified_framework_entity |
%     a status compound.
%   rts_asset_management_and_cryptography_duties_outstanding(Profile, Result, Citations)
%     Result is one of:
%     - none_outstanding;
%     - outstanding(Duties): the failing duties in DUTY ORDER;
%     - simplified_framework_entity;
%     - a status compound.
%   Status compounds (Citations is always []):
%     - indeterminate([Key]): exactly one bare key atom. The bare atom
%       indeterminate is never written.
%     - needs_legal_review(open_textured(Key, cite(CitationKey)),
%           [inputs_relied_on(Pairs)]): Pairs is every Key-Value present in
%       Profile, in contract order. One unscored
%       provenance(Clause, Citations) item may follow.
%     - input_problems(Problems): Problems are duplicate_key(Key),
%       wrong_type(Key) and unknown_key(Key) terms, in the order the check
%       below fixes.
%   Citations of a final answer are cite(Key) terms:
%     - the fixed fourteen paragraph keys (eu_reg_2024_1774_art_4_1 ...
%       eu_reg_2024_1774_art_7_5) for required, complete, incomplete and
%       none_outstanding;
%     - each failing duty's own key, written once, for outstanding;
%     - [cite(eu_reg_2022_2554_art_16_1)] for simplified_framework_entity.
%   Facade verdict, which wraps the completeness query:
%     dora_rts_asset_management_and_cryptography_verdict(Status, Citations)
%
% Spell every result and verdict atom exactly as the REQUIRED PUBLIC
% PREDICATES and the order pin it.
% =====================================================================

:- module(kernel, [dora_rts_asset_management_and_cryptography_input_problems/2]).

:- use_module(library(reif), [memberd_t/3]).

% ---- input checks: the problems a profile has, if any -----------
% dora_rts_asset_management_and_cryptography_input_problems(Profile, Problems): Problems = [] means the profile can be
% judged. Written from the order's typed input contract
% (input_contract.types.profile: attribute_list).
% Each public query calls this check first: it gives its normal answer only when
% Problems = [], and when Problems is not [] it gives the answer the order states for
% a profile with input problems.
% It gives exactly one answer for every Profile, and the answer is ground except for a
% Key named as given:
% - a Profile that is not an attribute list [attribute(Key, Value), ...] gives [wrong_type(profile)]:
%   an unbound Profile, a partial list, a list holding an unbound item or an item that is
%   not attribute(_, _);
% - a Key that is not an atom (a number, a string, a compound term, an unbound variable)
%   is a key outside the contract: unknown_key(Key), Key as given;
% - otherwise, for each contract key in the contract's key order, duplicate_key(Key) when
%   the key occurs more than once in Profile (whatever its values: none of them is read,
%   so it is never also wrong_type(Key)), else wrong_type(Key) when its one value is
%   outside its type; then unknown_key(Key) for each key outside the contract, in the
%   order of its first occurrence in Profile. Each key is named once. An absent key is
%   not a problem.
% Every step is complementary clauses: exactly one clause holds for each input.
dora_rts_asset_management_and_cryptography_input_problems(Profile, Problems) :-
    attribute_list_t(Profile, IsAttributeList),
    profile_problems(IsAttributeList, Profile, Problems).

profile_problems(false, _, [wrong_type(profile)]).
profile_problems(true, Profile, Problems) :-
    Keys = [financial_entity_is_article_16_1_entity, financial_entity_is_microenterprise, ict_asset_management_policy_developed_documented_and_implemented, asset_policy_prescribes_monitoring_and_management_of_asset_lifecycle, asset_policy_prescribes_records_of_ict_assets, asset_policy_prescribes_records_for_legacy_system_risk_assessment, ict_asset_management_procedure_developed_documented_and_implemented, asset_procedure_specifies_criticality_assessment_criteria, encryption_policy_developed_documented_and_implemented, encryption_policy_designed_on_data_classification_and_ict_risk_assessment, encryption_policy_has_rules_for_data_at_rest_and_in_transit, encryption_policy_has_rules_for_data_in_use_where_necessary, encryption_policy_has_rules_for_network_connections_and_external_traffic, encryption_policy_has_rules_for_cryptographic_key_management, data_in_use_protected_where_its_encryption_is_not_possible, encryption_policy_has_criteria_for_selecting_cryptographic_techniques, mitigation_and_monitoring_where_leading_practices_or_standards_not_followed, encryption_policy_has_provisions_for_updating_cryptographic_technology, mitigation_and_monitoring_where_cryptographic_technology_not_updated, encryption_policy_requires_recording_of_mitigation_measures_with_reasons, key_management_policy_has_requirements_for_whole_key_lifecycle, key_protection_controls_identified_and_implemented, key_protection_controls_designed_on_data_classification_and_ict_risk_assessment, key_replacement_methods_developed_and_implemented, certificate_register_created_maintained_and_kept_up_to_date, certificates_renewed_promptly_before_expiration],
    unknown_keys(Profile, Keys, UnknownKeyProblems),
    key_problems(Keys, Profile, UnknownKeyProblems, Problems).

% The contract: each key and the type of its value.
key_type(financial_entity_is_article_16_1_entity, fact).
key_type(financial_entity_is_microenterprise, fact).
key_type(ict_asset_management_policy_developed_documented_and_implemented, judgement).
key_type(asset_policy_prescribes_monitoring_and_management_of_asset_lifecycle, judgement).
key_type(asset_policy_prescribes_records_of_ict_assets, judgement).
key_type(asset_policy_prescribes_records_for_legacy_system_risk_assessment, judgement).
key_type(ict_asset_management_procedure_developed_documented_and_implemented, judgement).
key_type(asset_procedure_specifies_criticality_assessment_criteria, judgement).
key_type(encryption_policy_developed_documented_and_implemented, judgement).
key_type(encryption_policy_designed_on_data_classification_and_ict_risk_assessment, judgement).
key_type(encryption_policy_has_rules_for_data_at_rest_and_in_transit, judgement).
key_type(encryption_policy_has_rules_for_data_in_use_where_necessary, judgement).
key_type(encryption_policy_has_rules_for_network_connections_and_external_traffic, judgement).
key_type(encryption_policy_has_rules_for_cryptographic_key_management, judgement).
key_type(data_in_use_protected_where_its_encryption_is_not_possible, judgement).
key_type(encryption_policy_has_criteria_for_selecting_cryptographic_techniques, judgement).
key_type(mitigation_and_monitoring_where_leading_practices_or_standards_not_followed, judgement).
key_type(encryption_policy_has_provisions_for_updating_cryptographic_technology, judgement).
key_type(mitigation_and_monitoring_where_cryptographic_technology_not_updated, judgement).
key_type(encryption_policy_requires_recording_of_mitigation_measures_with_reasons, judgement).
key_type(key_management_policy_has_requirements_for_whole_key_lifecycle, judgement).
key_type(key_protection_controls_identified_and_implemented, judgement).
key_type(key_protection_controls_designed_on_data_classification_and_ict_risk_assessment, judgement).
key_type(key_replacement_methods_developed_and_implemented, judgement).
key_type(certificate_register_created_maintained_and_kept_up_to_date, judgement).
key_type(certificates_renewed_promptly_before_expiration, judgement).

% attribute_list_t(Term, T): T is true when Term is a list of attribute(Key, Value)
% items, whatever each Key is; false for anything else, an unbound Term or item included.
attribute_list_t(Term, false) :-
    var(Term).
attribute_list_t(Term, true) :-
    Term == [].
attribute_list_t(Term, T) :-
    nonvar(Term),
    Term = [Element|Elements],
    attribute_t(Element, ElementIsAttribute),
    attribute_list_t(Elements, ElementsAreAttributes),
    truth_and(ElementIsAttribute, ElementsAreAttributes, T).
attribute_list_t(Term, false) :-
    nonvar(Term),
    Term \== [],
    Term \= [_|_].

attribute_t(Element, false) :-
    var(Element).
attribute_t(Element, true) :-
    nonvar(Element),
    Element = attribute(_, _).
attribute_t(Element, false) :-
    nonvar(Element),
    Element \= attribute(_, _).

% Unknown keys, in profile order, each once: Known grows by each key named. A key is
% known when it is identical (==) to one in Known, so an unbound Key is never bound:
% the same variable twice is one unknown key, two different variables are two.
unknown_keys([], _, []).
unknown_keys([attribute(Key, _)|Elements], Known, Problems) :-
    known_t(Key, Known, IsKnown),
    name_unknown_key(IsKnown, Key, Known, Elements, Problems).

known_t(_, [], false).
known_t(Key, [Known|_], true) :-
    Known == Key.
known_t(Key, [Known|Knowns], T) :-
    Known \== Key,
    known_t(Key, Knowns, T).

name_unknown_key(true, _, Known, Elements, Problems) :-
    unknown_keys(Elements, Known, Problems).
name_unknown_key(false, Key, Known, Elements, [unknown_key(Key)|Problems]) :-
    unknown_keys(Elements, [Key|Known], Problems).

% Contract keys, in contract order: duplicate_key(Key) when the key occurs more than once
% (none of its values is read), else wrong_type(Key) when its one value is outside the
% key's type. An absent key has no value to check.
key_problems([], _, Problems, Problems).
key_problems([Key|Keys], Profile, LaterProblems, Problems) :-
    key_type(Key, Type),
    key_occurrences(Profile, Key, Occurrences),
    key_problems(Keys, Profile, LaterProblems, KeyProblems),
    name_key_problem(Occurrences, Key, Type, Profile, KeyProblems, Problems).

% key_occurrences(Elements, Key, Occurrences): none, one or many items give Key.
key_occurrences([], _, none).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey == Key,
    key_occurrences(Elements, Key, RestOccurrences),
    one_more_occurrence(RestOccurrences, Occurrences).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey \== Key,
    key_occurrences(Elements, Key, Occurrences).

one_more_occurrence(none, one).
one_more_occurrence(one, many).
one_more_occurrence(many, many).

name_key_problem(none, _, _, _, Problems, Problems).
name_key_problem(many, Key, _, _, Problems, [duplicate_key(Key)|Problems]).
name_key_problem(one, Key, Type, Profile, KeyProblems, Problems) :-
    values_in_type_t(Profile, Key, Type, InType),
    name_wrong_type(InType, Key, KeyProblems, Problems).

name_wrong_type(true, _, Problems, Problems).
name_wrong_type(false, Key, Problems, [wrong_type(Key)|Problems]).

% values_in_type_t(Elements, Key, Type, T): T is true when every value Elements gives Key is
% in Type (true when Elements gives Key none).
values_in_type_t([], _, _, true).
values_in_type_t([attribute(ElementKey, Value)|Elements], Key, Type, T) :-
    ElementKey == Key,
    value_in_type_t(Type, Value, ValueInType),
    values_in_type_t(Elements, Key, Type, RestInType),
    truth_and(ValueInType, RestInType, T).
values_in_type_t([attribute(ElementKey, _)|Elements], Key, Type, T) :-
    ElementKey \== Key,
    values_in_type_t(Elements, Key, Type, T).

% A value with an unbound part is outside every type; a ground one is checked.
value_in_type_t(Type, Value, T) :-
    term_variables(Value, Variables),
    ground_value_in_type_t(Variables, Type, Value, T).

ground_value_in_type_t([_|_], _, _, false).
ground_value_in_type_t([], Type, Value, T) :-
    in_type_t(Type, Value, T).

% in_type_t(Type, Value, T): one clause per type, for a ground Value.
in_type_t(fact, Value, T) :-
    in_type_t(boolean, Value, T).

in_type_t(judgement, Value, T) :-
    in_type_t(one_of([boolean, enum([unsure])]), Value, T).

in_type_t(boolean, Value, T) :-
    memberd_t(Value, [true, false], T).

in_type_t(enum(Values), Value, T) :-
    memberd_t(Value, Values, T).

in_type_t(one_of(Types), Value, T) :-
    in_some_type_t(Types, Value, T).

truth_and(true, T, T).
truth_and(false, _, false).

% in_some_type_t(Types, Value, T): T is true when Value is in at least one of Types.
in_some_type_t([], _, false).
in_some_type_t([Type|Types], Value, T) :-
    in_type_t(Type, Value, InType),
    in_some_type_t(Types, Value, InAnother),
    truth_or(InType, InAnother, T).

truth_or(true, _, true).
truth_or(false, T, T).

:- end_module(kernel).
