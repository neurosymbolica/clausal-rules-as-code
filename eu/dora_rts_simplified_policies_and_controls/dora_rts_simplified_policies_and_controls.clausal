% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% dora_rts_simplified_policies_and_controls.clausal -- the "dora_rts_simplified_policies_and_controls" DETERMINATION for
% eu/dora_rts_simplified_policies_and_controls, self-contained top to bottom: the duty table
% (each row carrying ready-made cite(Key) terms), the gate reading, the
% three contract queries, the checklist and the verdict assembly.
%
% Source: Commission Delegated Regulation (EU) 2024/1774 (the RTS), Title
% III, Articles 28 to 35, gated by Regulation (EU) 2022/2554 (DORA),
% Article 16(1), first subparagraph (pinned original OJ texts).
%
% Readings (the drafter's, not a lawyer's): the gate is a crisp caller
% fact; every duty is one tri-state caller judgement (true, false,
% unsure); unsure is handed to a lawyer as open_textured/2, never decided
% by an invented crisp test. Precedence: input problems, then the gate,
% then (complete) a failing duty, then the first absent duty key, then
% the first unsure duty key. The fixed twenty citations ride every final
% answer of required, complete, incomplete and none_outstanding.
% =====================================================================

:- module(dora_rts_simplified_policies_and_controls, [
    simplified_policies_and_controls_duties_required/3,
    simplified_policies_and_controls_duties_complete/3,
    simplified_policies_and_controls_duties_outstanding/3,
    decide_dora_rts_simplified_policies_and_controls/2,
    dora_rts_simplified_policies_and_controls_status/2,
    dora_rts_simplified_policies_and_controls_checklist/2,
    dora_rts_simplified_policies_and_controls_decision_resolvable/1,
    dora_rts_simplified_policies_and_controls_status_values/1
]).

:- use_module(library(reif), [memberd_t/3]).
:- use_module(formalize_lib, [profile_get/3, profile_lacks/2]).
:- use_module(eu/dora_rts_simplified_policies_and_controls/kernel, [dora_rts_simplified_policies_and_controls_input_problems/2]).
:- use_module(eu/dora_rts_simplified_policies_and_controls/citations, [implements/1]).

% ---- statutory VALUE facts owned by this determination ---------------
% The verdict vocabulary (status functors and atoms of the complete query).
dora_rts_simplified_policies_and_controls_status_values([complete, incomplete, not_article_16_1_entity, indeterminate, needs_legal_review, input_problems]).

% THE FIXED CITATIONS (reading 15).
fixed_citations([
    cite(eu_reg_2022_2554_art_16_1),
    cite(eu_reg_2024_1774_art_28_1),
    cite(eu_reg_2024_1774_art_28_2),
    cite(eu_reg_2024_1774_art_28_4),
    cite(eu_reg_2024_1774_art_28_5),
    cite(eu_reg_2024_1774_art_28_6),
    cite(eu_reg_2024_1774_art_29_1),
    cite(eu_reg_2024_1774_art_29_2),
    cite(eu_reg_2024_1774_art_30_1),
    cite(eu_reg_2024_1774_art_30_2),
    cite(eu_reg_2024_1774_art_31_1),
    cite(eu_reg_2024_1774_art_31_2),
    cite(eu_reg_2024_1774_art_31_3),
    cite(eu_reg_2024_1774_art_31_4),
    cite(eu_reg_2024_1774_art_32_1),
    cite(eu_reg_2024_1774_art_32_2),
    cite(eu_reg_2024_1774_art_32_3),
    cite(eu_reg_2024_1774_art_33),
    cite(eu_reg_2024_1774_art_34),
    cite(eu_reg_2024_1774_art_35)
]).

% The gate key (reading 1).
gate_key(financial_entity_is_article_16_1_entity).

% THE FIFTY-ONE DUTIES, in DUTY ORDER: duty(DutyAtom, ProfileKey, Citations).
% The first citation of each row is its referral citation.
duty(internal_governance_and_control_framework, simplified_internal_governance_and_control_framework_in_place, [cite(eu_reg_2024_1774_art_28_1)]).
duty(management_body_overall_responsibility, management_body_bears_overall_responsibility_for_simplified_framework, [cite(eu_reg_2024_1774_art_28_2)]).
duty(ict_roles_and_responsibilities, management_body_set_ict_roles_and_responsibilities, [cite(eu_reg_2024_1774_art_28_2)]).
duty(information_security_objectives_and_ict_requirements, management_body_set_information_security_objectives_and_ict_requirements, [cite(eu_reg_2024_1774_art_28_2)]).
duty(approval_of_classification_risks_and_impact_analysis, management_body_approves_and_reviews_classification_risks_and_impact_analysis, [cite(eu_reg_2024_1774_art_28_2)]).
duty(approval_of_continuity_plans_and_recovery_measures, management_body_approves_and_reviews_continuity_plans_and_recovery_measures, [cite(eu_reg_2024_1774_art_28_2)]).
duty(yearly_digital_operational_resilience_budget, management_body_allocates_and_reviews_resilience_budget_yearly, [cite(eu_reg_2024_1774_art_28_2)]).
duty(policies_and_measures_of_title_iii, management_body_specifies_and_implements_title_iii_policies_and_measures, [cite(eu_reg_2024_1774_art_28_2)]).
duty(asset_protection_procedures_protocols_and_tools, management_body_identifies_and_implements_asset_protection_procedures, [cite(eu_reg_2024_1774_art_28_2)]).
duty(staff_ict_risk_knowledge_and_skills, management_body_keeps_staff_ict_risk_knowledge_up_to_date, [cite(eu_reg_2024_1774_art_28_2)]).
duty(reporting_arrangements_to_management_body, management_body_established_reporting_arrangements, [cite(eu_reg_2024_1774_art_28_2)]).
duty(segregation_and_independence_of_control_functions, control_and_internal_audit_functions_segregated_and_independent, [cite(eu_reg_2024_1774_art_28_4)]).
duty(internal_audit_of_simplified_framework, simplified_framework_subject_to_internal_audit, [cite(eu_reg_2024_1774_art_28_5)]).
duty(remediation_of_critical_audit_findings, critical_ict_audit_findings_verified_and_remediated, [cite(eu_reg_2024_1774_art_28_6)]).
duty(information_security_policy, information_security_policy_developed_documented_and_implemented, [cite(eu_reg_2024_1774_art_29_1)]).
duty(ict_security_measures, ict_security_measures_established_and_implemented, [cite(eu_reg_2024_1774_art_29_2)]).
duty(classification_of_functions_and_assets, critical_functions_and_supporting_assets_identified_classified_and_documented, [cite(eu_reg_2024_1774_art_30_1)]).
duty(functions_supported_by_third_party_providers, critical_functions_supported_by_third_party_providers_identified, [cite(eu_reg_2024_1774_art_30_2)]).
duty(risk_tolerance_levels, framework_determines_ict_risk_tolerance_levels, [cite(eu_reg_2024_1774_art_31_1)]).
duty(identification_and_assessment_of_ict_risks, framework_identifies_and_assesses_ict_risks, [cite(eu_reg_2024_1774_art_31_1)]).
duty(mitigation_strategies, framework_specifies_mitigation_strategies, [cite(eu_reg_2024_1774_art_31_1)]).
duty(monitoring_of_mitigation_effectiveness, framework_monitors_mitigation_effectiveness, [cite(eu_reg_2024_1774_art_31_1)]).
duty(assessment_of_change_test_and_incident_risks, framework_assesses_risks_from_changes_tests_and_incidents, [cite(eu_reg_2024_1774_art_31_1)]).
duty(periodic_ict_risk_assessment, ict_risk_assessment_carried_out_and_documented_periodically, [cite(eu_reg_2024_1774_art_31_2)]).
duty(threat_and_vulnerability_monitoring, threats_and_vulnerabilities_monitored_and_risk_scenarios_reviewed, [cite(eu_reg_2024_1774_art_31_3)]).
duty(incident_response_alert_thresholds, incident_response_alert_thresholds_and_criteria_set, [cite(eu_reg_2024_1774_art_31_4)]).
duty(physical_security_measures, physical_security_measures_identified_and_implemented, [cite(eu_reg_2024_1774_art_32_1)]).
duty(protection_of_premises_and_data_centres, premises_and_data_centres_protected, [cite(eu_reg_2024_1774_art_32_2), cite(eu_reg_2024_1774_art_32_3)]).
duty(access_control_procedures, access_control_procedures_developed_enforced_and_reviewed, [cite(eu_reg_2024_1774_art_33)]).
duty(need_to_know_access_rights, access_rights_managed_on_need_to_know_and_least_privilege, [cite(eu_reg_2024_1774_art_33)]).
duty(user_accountability, user_accountability_ensured, [cite(eu_reg_2024_1774_art_33)]).
duty(account_management_procedures, account_management_procedures_in_place, [cite(eu_reg_2024_1774_art_33)]).
duty(authentication_methods, authentication_methods_commensurate_and_strong_where_required, [cite(eu_reg_2024_1774_art_33)]).
duty(periodic_review_of_access_rights, access_rights_reviewed_and_withdrawn_when_not_required, [cite(eu_reg_2024_1774_art_33)]).
duty(lifecycle_of_ict_assets, ict_asset_lifecycle_monitored_and_managed, [cite(eu_reg_2024_1774_art_34)]).
duty(third_party_support_of_ict_assets, third_party_support_of_ict_assets_monitored, [cite(eu_reg_2024_1774_art_34)]).
duty(capacity_management, ict_capacity_requirements_and_availability_measures_identified, [cite(eu_reg_2024_1774_art_34)]).
duty(vulnerability_scanning_and_patching, vulnerability_scanning_performed_and_patches_deployed, [cite(eu_reg_2024_1774_art_34)]).
duty(legacy_ict_asset_risks, legacy_and_unsupported_ict_asset_risks_managed, [cite(eu_reg_2024_1774_art_34)]).
duty(event_logging, access_operations_and_change_events_logged, [cite(eu_reg_2024_1774_art_34)]).
duty(anomalous_activity_monitoring, anomalous_activities_monitored_and_analysed, [cite(eu_reg_2024_1774_art_34)]).
duty(cyber_threat_information_monitoring, cyber_threat_information_monitored, [cite(eu_reg_2024_1774_art_34)]).
duty(leakage_malicious_code_and_vulnerability_detection, leakages_malicious_code_and_vulnerabilities_identified, [cite(eu_reg_2024_1774_art_34)]).
duty(network_and_data_safeguards, network_and_data_security_safeguards_developed_and_implemented, [cite(eu_reg_2024_1774_art_35)]).
duty(protection_of_data_in_use_transit_and_rest, data_in_use_in_transit_and_at_rest_protected, [cite(eu_reg_2024_1774_art_35)]).
duty(security_of_software_media_systems_and_endpoints, software_storage_media_and_endpoint_security_measures_implemented, [cite(eu_reg_2024_1774_art_35)]).
duty(prevention_of_unauthorised_connections, unauthorised_connections_prevented_and_network_traffic_secured, [cite(eu_reg_2024_1774_art_35)]).
duty(security_of_network_transmissions, data_secured_during_network_transmissions, [cite(eu_reg_2024_1774_art_35)]).
duty(secure_data_deletion, secure_data_deletion_process_in_place, [cite(eu_reg_2024_1774_art_35)]).
duty(secure_disposal_of_storage_devices, secure_storage_device_disposal_process_in_place, [cite(eu_reg_2024_1774_art_35)]).
duty(teleworking_and_private_devices, teleworking_and_private_device_measures_implemented, [cite(eu_reg_2024_1774_art_35)]).

% The contract keys in root_exports order: the gate, then the duty keys.
contract_key(Key) :-
    gate_key(Key).
contract_key(Key) :-
    duty(_, Key, _).

% ---- profile reading: presence first, then value ----------------------
key_state(Profile, Key, absent) :-
    profile_lacks(Profile, Key).
key_state(Profile, Key, Value) :-
    profile_get(Profile, Key, Value).

% ---- the gate: DORA Art 16(1), first subparagraph ---------------------
gate_state(Profile, State) :-
    implements(eu_reg_2022_2554_art_16_1),
    gate_key(GateKey),
    key_state(Profile, GateKey, State).

% ---- the duties: one entry per duty, in DUTY ORDER --------------------
duty_entries(Profile, Entries) :-
    findall(Entry,
            ( duty(Duty, Key, Citations),
              duty_state(Profile, duty_row(Duty, Key, Citations), Entry)
            ),
            Entries).

% Each duty applies when the gate is true; its state is the caller's judgement.
duty_state(Profile, duty_row(Duty, Key, _Citations), duty_entry(Duty, Key, State)) :-
    key_state(Profile, Key, State).

entry_states(Entries, States) :-
    findall(State, member(duty_entry(_, _, State), Entries), States).

% The first entry, in duty order, whose state is Wanted.
first_key_with([duty_entry(_, Key, State)|_], State, Key).
first_key_with([duty_entry(_, _, State)|Entries], Wanted, Key) :-
    dif(State, Wanted),
    first_key_with(Entries, Wanted, Key).

failing_duties(Entries, Duties) :-
    findall(Duty, member(duty_entry(Duty, _, false), Entries), Duties).

duties_citations(Duties, Citations) :-
    findall(Citation,
            ( member(Duty, Duties),
              duty(Duty, _, DutyCitations),
              member(Citation, DutyCitations)
            ),
            AllCitations),
    sort(AllCitations, Citations).

% PAIRS: every present Key-Value, in root_exports order, values as given.
inputs_pairs(Profile, Pairs) :-
    findall(Key-Value,
            ( contract_key(Key),
              profile_get(Profile, Key, Value)
            ),
            Pairs).

% The referral for an unsure judgement key (open_textured, first citation).
referral(Profile, Key, needs_legal_review(open_textured(Key, Citation), [inputs_relied_on(Pairs)])) :-
    duty(_, Key, [Citation|_]),
    inputs_pairs(Profile, Pairs).

% ---- (A) simplified_policies_and_controls_duties_required/3 -----------
simplified_policies_and_controls_duties_required(Profile, Result, Citations) :-
    dora_rts_simplified_policies_and_controls_input_problems(Profile, Problems),
    required_from_problems(Problems, Profile, Result, Citations).

required_from_problems([Problem|Problems], _, input_problems([Problem|Problems]), []).
required_from_problems([], Profile, Result, Citations) :-
    gate_state(Profile, Gate),
    required_from_gate(Gate, Result, Citations).

required_from_gate(false, not_article_16_1_entity, [cite(eu_reg_2022_2554_art_16_1)]) :-
    implements(eu_reg_2022_2554_art_16_1).
required_from_gate(absent, indeterminate([financial_entity_is_article_16_1_entity]), []).
required_from_gate(true, required(Duties), Citations) :-
    implements(eu_reg_2022_2554_art_16_1),
    findall(Duty, duty(Duty, _, _), Duties),
    fixed_citations(Citations).

% ---- (B) simplified_policies_and_controls_duties_complete/3 -----------
simplified_policies_and_controls_duties_complete(Profile, Result, Citations) :-
    dora_rts_simplified_policies_and_controls_input_problems(Profile, Problems),
    complete_from_problems(Problems, Profile, Result, Citations).

complete_from_problems([Problem|Problems], _, input_problems([Problem|Problems]), []).
complete_from_problems([], Profile, Result, Citations) :-
    gate_state(Profile, Gate),
    complete_from_gate(Gate, Profile, Result, Citations).

complete_from_gate(false, _, not_article_16_1_entity, [cite(eu_reg_2022_2554_art_16_1)]) :-
    implements(eu_reg_2022_2554_art_16_1).
complete_from_gate(absent, _, indeterminate([financial_entity_is_article_16_1_entity]), []).
complete_from_gate(true, Profile, Result, Citations) :-
    duty_entries(Profile, Entries),
    entry_states(Entries, States),
    memberd_t(false, States, HasFalse),
    memberd_t(absent, States, HasAbsent),
    memberd_t(unsure, States, HasUnsure),
    complete_from_flags(HasFalse, HasAbsent, HasUnsure, Profile, Entries, Result, Citations).

% (S1) a failing duty decides before any absent or unsure key.
complete_from_flags(true, _, _, _, _, incomplete, Citations) :-
    implements(eu_reg_2024_1774_art_28_1),
    fixed_citations(Citations).
% (S2) the first absent duty key.
complete_from_flags(false, true, _, _, Entries, indeterminate([Key]), []) :-
    first_key_with(Entries, absent, Key).
% (S3) the first unsure duty key goes to a lawyer.
complete_from_flags(false, false, true, Profile, Entries, Review, []) :-
    first_key_with(Entries, unsure, Key),
    referral(Profile, Key, Review).
% (S4) every duty performed.
complete_from_flags(false, false, false, _, _, complete, Citations) :-
    implements(eu_reg_2024_1774_art_28_1),
    fixed_citations(Citations).

% ---- (C) simplified_policies_and_controls_duties_outstanding/3 --------
simplified_policies_and_controls_duties_outstanding(Profile, Result, Citations) :-
    dora_rts_simplified_policies_and_controls_input_problems(Profile, Problems),
    outstanding_from_problems(Problems, Profile, Result, Citations).

outstanding_from_problems([Problem|Problems], _, input_problems([Problem|Problems]), []).
outstanding_from_problems([], Profile, Result, Citations) :-
    gate_state(Profile, Gate),
    outstanding_from_gate(Gate, Profile, Result, Citations).

outstanding_from_gate(false, _, not_article_16_1_entity, [cite(eu_reg_2022_2554_art_16_1)]) :-
    implements(eu_reg_2022_2554_art_16_1).
outstanding_from_gate(absent, _, indeterminate([financial_entity_is_article_16_1_entity]), []).
outstanding_from_gate(true, Profile, Result, Citations) :-
    duty_entries(Profile, Entries),
    entry_states(Entries, States),
    memberd_t(absent, States, HasAbsent),
    memberd_t(unsure, States, HasUnsure),
    memberd_t(false, States, HasFalse),
    outstanding_from_flags(HasAbsent, HasUnsure, HasFalse, Profile, Entries, Result, Citations).

% (M1) the first absent duty key: every duty must be known.
outstanding_from_flags(true, _, _, _, Entries, indeterminate([Key]), []) :-
    first_key_with(Entries, absent, Key).
% (M2) the first unsure duty key goes to a lawyer.
outstanding_from_flags(false, true, _, Profile, Entries, Review, []) :-
    first_key_with(Entries, unsure, Key),
    referral(Profile, Key, Review).
% (M3) no duty fails.
outstanding_from_flags(false, false, false, _, _, none_outstanding, Citations) :-
    implements(eu_reg_2024_1774_art_28_1),
    fixed_citations(Citations).
% (M3) the failing duties, in duty order, with their own citations.
outstanding_from_flags(false, false, true, _, Entries, outstanding(Duties), Citations) :-
    implements(eu_reg_2024_1774_art_28_1),
    failing_duties(Entries, Duties),
    duties_citations(Duties, Citations).

% ---- facade: verdict, status, checklist --------------------------------
decide_dora_rts_simplified_policies_and_controls(Profile, dora_rts_simplified_policies_and_controls_verdict(Status, Citations)) :-
    simplified_policies_and_controls_duties_complete(Profile, Status, Citations).

dora_rts_simplified_policies_and_controls_status(Profile, Status) :-
    decide_dora_rts_simplified_policies_and_controls(Profile, dora_rts_simplified_policies_and_controls_verdict(Status, _Citations)).

dora_rts_simplified_policies_and_controls_decision_resolvable(Profile) :-
    decide_dora_rts_simplified_policies_and_controls(Profile, _Verdict).

% One item for the gate, then (gate true) one item per duty, each with its cite.
dora_rts_simplified_policies_and_controls_checklist(Profile, Items) :-
    dora_rts_simplified_policies_and_controls_input_problems(Profile, Problems),
    checklist_from_problems(Problems, Profile, Items).

checklist_from_problems([_|_], _, []).
checklist_from_problems([], Profile, Items) :-
    gate_state(Profile, Gate),
    checklist_from_gate(Gate, Profile, Items).

checklist_from_gate(false, _, [item(article_16_1_entity, unmet(not_article_16_1_entity), cite(eu_reg_2022_2554_art_16_1))]).
checklist_from_gate(absent, _, [item(article_16_1_entity, unknown([financial_entity_is_article_16_1_entity]), cite(eu_reg_2022_2554_art_16_1))]).
checklist_from_gate(true, Profile, [item(article_16_1_entity, met, cite(eu_reg_2022_2554_art_16_1))|DutyItems]) :-
    duty_entries(Profile, Entries),
    findall(Item,
            ( member(Entry, Entries),
              entry_item(Entry, Item)
            ),
            DutyItems).

entry_item(duty_entry(Duty, Key, State), item(Duty, Status, Citation)) :-
    duty(Duty, Key, [Citation|_]),
    state_status(State, Key, Status).

state_status(true, _, met).
state_status(false, _, unmet(duty_not_performed)).
state_status(unsure, Key, unknown([Key])).
state_status(absent, Key, unknown([Key])).

% ---- tests -------------------------------------------------------------
profile_with(ChangedKey, ChangedValue, Profile) :-
    findall(attribute(Key, Value),
            ( contract_key(Key),
              value_for(Key, ChangedKey, ChangedValue, Value)
            ),
            Profile).

value_for(Key, Key, Value, Value).
value_for(Key, ChangedKey, _, true) :-
    dif(Key, ChangedKey).

profile_without(DroppedKey, Profile) :-
    findall(attribute(Key, true),
            ( contract_key(Key),
              dif(Key, DroppedKey)
            ),
            Profile).

all_true_profile(Profile) :-
    findall(attribute(Key, true), contract_key(Key), Profile).

test(fifty_one_duties) :-
    findall(Duty, duty(Duty, _, _), Duties),
    length(Duties, 51).

test(all_true_is_complete_once) :-
    all_true_profile(Profile),
    findall(Result-Citations, simplified_policies_and_controls_duties_complete(Profile, Result, Citations), Answers),
    fixed_citations(Fixed),
    Answers == [complete-Fixed].

test(all_true_is_none_outstanding) :-
    all_true_profile(Profile),
    findall(Result, simplified_policies_and_controls_duties_outstanding(Profile, Result, _), Results),
    Results == [none_outstanding].

test(required_lists_every_duty_once) :-
    all_true_profile(Profile),
    findall(Result, simplified_policies_and_controls_duties_required(Profile, Result, _), [required(Duties)]),
    length(Duties, 51).

test(gate_false_is_not_article_16_1_entity) :-
    profile_with(financial_entity_is_article_16_1_entity, false, Profile),
    simplified_policies_and_controls_duties_complete(Profile, not_article_16_1_entity, [cite(eu_reg_2022_2554_art_16_1)]).

test(gate_absent_is_indeterminate) :-
    profile_without(financial_entity_is_article_16_1_entity, Profile),
    simplified_policies_and_controls_duties_required(Profile, indeterminate([financial_entity_is_article_16_1_entity]), []).

test(a_false_duty_is_incomplete) :-
    profile_with(user_accountability_ensured, false, Profile),
    simplified_policies_and_controls_duties_complete(Profile, incomplete, _).

test(a_false_duty_is_not_complete, fail) :-
    profile_with(user_accountability_ensured, false, Profile),
    simplified_policies_and_controls_duties_complete(Profile, complete, _).

test(a_false_duty_is_outstanding_with_its_citation) :-
    profile_with(premises_and_data_centres_protected, false, Profile),
    simplified_policies_and_controls_duties_outstanding(Profile, outstanding([protection_of_premises_and_data_centres]), Citations),
    Citations == [cite(eu_reg_2024_1774_art_32_2), cite(eu_reg_2024_1774_art_32_3)].

test(an_absent_duty_is_named) :-
    profile_without(event_logging_placeholder_never_a_key, _),
    profile_without(access_operations_and_change_events_logged, Profile),
    simplified_policies_and_controls_duties_complete(Profile, indeterminate([access_operations_and_change_events_logged]), []).

test(an_unsure_duty_is_referred) :-
    profile_with(cyber_threat_information_monitored, unsure, Profile),
    simplified_policies_and_controls_duties_complete(Profile, needs_legal_review(open_textured(cyber_threat_information_monitored, cite(eu_reg_2024_1774_art_34)), [inputs_relied_on(Pairs)]), []),
    length(Pairs, 52).

test(a_wrong_type_is_an_input_problem) :-
    profile_with(financial_entity_is_article_16_1_entity, unsure, Profile),
    simplified_policies_and_controls_duties_complete(Profile, input_problems([wrong_type(financial_entity_is_article_16_1_entity)]), []).

test(checklist_has_a_row_per_duty_and_the_gate) :-
    all_true_profile(Profile),
    dora_rts_simplified_policies_and_controls_checklist(Profile, Items),
    length(Items, 52).

:- end_module(dora_rts_simplified_policies_and_controls).
