% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% fixtures.clausal -- representative profiles for eu/dora_information_sharing_arrangements.
% A TOP-LAYER consumer: it imports only the slice predicate it calls.
% Profile keys and subject ids are atoms and need no import.
%
% A profile is an ATTRIBUTE LIST [attribute(Key, Value), ...] (the order's
% typed input contract). There are no thresholds in Article 45, so each
% route is paired with a ONE-KEY near-miss control instead of an
% at-threshold / just-below pair:
%
%   information_sharing_within_article_45/3
%     all_conditions_met (within)        <-> paragraph_2_false (outside:
%                                            one key flipped to false)
%     community_false_with_absent_others (outside, false decides alone)
%                                        <-> community_absent (indeterminate:
%                                            the same key absent)
%     first_absent_before_unsure (indeterminate before an unsure key)
%     point_c_unsure_referral (needs_legal_review, Art 45(1)(c))
%                                        <-> all_conditions_met (point (c) true)
%   membership_notification_duty/3
%     all_conditions_met (notify participation upon validation)
%     cessation_effective_true (notify cessation) <-> cessation_arrangement_false
%                                            (no duty: arrangement false)
%     no_event_with_unsure_arrangement (no duty, the event decides alone)
%     event_absent_arrangement_unsure (indeterminate membership_event)
%     arrangement_absent (indeterminate arrangement key)
%     arrangement_unsure_referral (needs_legal_review, Art 45(3))
%                                        <-> all_conditions_met (arrangement true)
%   input check (both queries)
%     duplicate_and_unknown_keys, wrong_type_value, non_list_profile,
%     unbound_value.
% =====================================================================

:- module(fixtures, [
    dora_information_sharing_arrangements_subject/1,
    dora_information_sharing_arrangements_profile_for/2,
    dora_information_sharing_arrangements_assess/2
]).

:- use_module(eu/dora_information_sharing_arrangements/dora_information_sharing_arrangements, [decide_dora_information_sharing_arrangements/2]).

% ---- Subject registry ------------------------------------------------
dora_information_sharing_arrangements_subject(all_conditions_met).
dora_information_sharing_arrangements_subject(paragraph_2_false).
dora_information_sharing_arrangements_subject(community_false_with_absent_others).
dora_information_sharing_arrangements_subject(community_absent).
dora_information_sharing_arrangements_subject(first_absent_before_unsure).
dora_information_sharing_arrangements_subject(point_c_unsure_referral).
dora_information_sharing_arrangements_subject(cessation_effective_true).
dora_information_sharing_arrangements_subject(cessation_arrangement_false).
dora_information_sharing_arrangements_subject(no_event_with_unsure_arrangement).
dora_information_sharing_arrangements_subject(event_absent_arrangement_unsure).
dora_information_sharing_arrangements_subject(arrangement_absent).
dora_information_sharing_arrangements_subject(arrangement_unsure_referral).
dora_information_sharing_arrangements_subject(duplicate_and_unknown_keys).
dora_information_sharing_arrangements_subject(wrong_type_value).
dora_information_sharing_arrangements_subject(non_list_profile).
dora_information_sharing_arrangements_subject(unbound_value).

% ---- Profiles --------------------------------------------------------
% All five conditions true; membership validated in an arrangement referred
% to in Art 45(1).
dora_information_sharing_arrangements_profile_for(all_conditions_met, [
    attribute(information_is_cyber_threat_information_and_intelligence, true),
    attribute(sharing_aims_to_enhance_digital_operational_resilience, true),
    attribute(sharing_takes_place_within_trusted_community_of_financial_entities, true),
    attribute(arrangement_protects_sensitive_information_and_has_rules_of_conduct, true),
    attribute(arrangement_defines_participation_conditions_and_appropriate_details, true),
    attribute(membership_event, membership_validated),
    attribute(arrangement_is_information_sharing_arrangement_referred_to_in_article_45_1, true)
]).
% Near miss: Art 45(2) judged false; the notification duty is unaffected (Q3).
dora_information_sharing_arrangements_profile_for(paragraph_2_false, [
    attribute(information_is_cyber_threat_information_and_intelligence, true),
    attribute(sharing_aims_to_enhance_digital_operational_resilience, true),
    attribute(sharing_takes_place_within_trusted_community_of_financial_entities, true),
    attribute(arrangement_protects_sensitive_information_and_has_rules_of_conduct, true),
    attribute(arrangement_defines_participation_conditions_and_appropriate_details, false),
    attribute(membership_event, membership_validated),
    attribute(arrangement_is_information_sharing_arrangement_referred_to_in_article_45_1, true)
]).
% A false condition decides alone, the other conditions absent.
dora_information_sharing_arrangements_profile_for(community_false_with_absent_others, [
    attribute(sharing_takes_place_within_trusted_community_of_financial_entities, false)
]).
% Near miss: the trusted-community judgement absent, all others true.
dora_information_sharing_arrangements_profile_for(community_absent, [
    attribute(information_is_cyber_threat_information_and_intelligence, true),
    attribute(sharing_aims_to_enhance_digital_operational_resilience, true),
    attribute(arrangement_protects_sensitive_information_and_has_rules_of_conduct, true),
    attribute(arrangement_defines_participation_conditions_and_appropriate_details, true),
    attribute(membership_event, membership_validated),
    attribute(arrangement_is_information_sharing_arrangement_referred_to_in_article_45_1, true)
]).
% An absent key is named before an earlier unsure key is referred.
dora_information_sharing_arrangements_profile_for(first_absent_before_unsure, [
    attribute(information_is_cyber_threat_information_and_intelligence, unsure),
    attribute(sharing_aims_to_enhance_digital_operational_resilience, true)
]).
% Point (c) unsure, every other condition true: refer to a lawyer.
dora_information_sharing_arrangements_profile_for(point_c_unsure_referral, [
    attribute(arrangement_protects_sensitive_information_and_has_rules_of_conduct, unsure),
    attribute(information_is_cyber_threat_information_and_intelligence, true),
    attribute(sharing_aims_to_enhance_digital_operational_resilience, true),
    attribute(sharing_takes_place_within_trusted_community_of_financial_entities, true),
    attribute(arrangement_defines_participation_conditions_and_appropriate_details, true)
]).
% Cessation of membership has taken effect, arrangement referred to in Art 45(1).
dora_information_sharing_arrangements_profile_for(cessation_effective_true, [
    attribute(membership_event, membership_cessation_took_effect),
    attribute(arrangement_is_information_sharing_arrangement_referred_to_in_article_45_1, true)
]).
% Near miss: the arrangement is not one referred to in Art 45(1).
dora_information_sharing_arrangements_profile_for(cessation_arrangement_false, [
    attribute(membership_event, membership_cessation_took_effect),
    attribute(arrangement_is_information_sharing_arrangement_referred_to_in_article_45_1, false)
]).
% No membership event decides alone, the arrangement judgement unsure.
dora_information_sharing_arrangements_profile_for(no_event_with_unsure_arrangement, [
    attribute(membership_event, no_membership_event),
    attribute(arrangement_is_information_sharing_arrangement_referred_to_in_article_45_1, unsure)
]).
% Event absent: named before the unsure arrangement judgement is referred.
dora_information_sharing_arrangements_profile_for(event_absent_arrangement_unsure, [
    attribute(arrangement_is_information_sharing_arrangement_referred_to_in_article_45_1, unsure)
]).
% Membership validated, the arrangement judgement absent.
dora_information_sharing_arrangements_profile_for(arrangement_absent, [
    attribute(membership_event, membership_validated)
]).
% Membership validated, the arrangement judgement unsure: refer.
dora_information_sharing_arrangements_profile_for(arrangement_unsure_referral, [
    attribute(arrangement_is_information_sharing_arrangement_referred_to_in_article_45_1, unsure),
    attribute(membership_event, membership_validated)
]).
% Input check: a repeated contract key and a key outside the contract.
dora_information_sharing_arrangements_profile_for(duplicate_and_unknown_keys, [
    attribute(membership_event, membership_validated),
    attribute(entity_size, large),
    attribute(membership_event, membership_validated)
]).
% Input check: a value outside its type.
dora_information_sharing_arrangements_profile_for(wrong_type_value, [
    attribute(membership_event, true)
]).
% Input check: a profile that is not an attribute list.
dora_information_sharing_arrangements_profile_for(non_list_profile, not_an_attribute_list).
% Input check: an unbound value of a contract key.
dora_information_sharing_arrangements_profile_for(unbound_value, [
    attribute(sharing_aims_to_enhance_digital_operational_resilience, _UnboundValue)
]).

% ---- Convenience wrapper ---------------------------------------------
dora_information_sharing_arrangements_assess(Subject, Result) :-
    dora_information_sharing_arrangements_profile_for(Subject, Profile),
    decide_dora_information_sharing_arrangements(Profile, Result).

:- end_module(fixtures).
