% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_input_mode.clausal -- INPUT MODE: public predicates called with the
% result argument BOUND (verdict given, not read out), and input
% tolerance of the kernel's input check (odd profiles, odd keys, odd
% values), as THE INPUT CHECK states it.
% Run: python -m clausal.testing eu/dora_information_sharing_arrangements/tests/test_input_mode.clausal
% =====================================================================
:- module(test_input_mode, []).
:- use_module(eu/dora_information_sharing_arrangements/dora_information_sharing_arrangements, [
    dora_information_sharing_arrangements_status/2,
    dora_information_sharing_arrangements_status_values/1,
    information_sharing_within_article_45/3,
    membership_notification_duty/3
]).
:- use_module(eu/dora_information_sharing_arrangements/kernel, [dora_information_sharing_arrangements_input_problems/2]).
:- use_module(eu/dora_information_sharing_arrangements/fixtures, [dora_information_sharing_arrangements_profile_for/2]).

condition_citations([cite(eu_reg_2022_2554_art_45_1), cite(eu_reg_2022_2554_art_45_1_a), cite(eu_reg_2022_2554_art_45_1_b), cite(eu_reg_2022_2554_art_45_1_c), cite(eu_reg_2022_2554_art_45_2)]).

% ---- bound verdicts --------------------------------------------------
test(status_holds_with_the_verdict_bound) :-
    dora_information_sharing_arrangements_profile_for(all_conditions_met, Profile),
    dora_information_sharing_arrangements_status(Profile, sharing_within_article_45).

test(every_other_bound_status_is_rejected, fail) :-
    dora_information_sharing_arrangements_profile_for(all_conditions_met, Profile),
    dora_information_sharing_arrangements_status_values(StatusValues),
    member(Other, StatusValues),
    dif(Other, sharing_within_article_45),
    dora_information_sharing_arrangements_status(Profile, Other).

test(outside_holds_bound_with_its_citations) :-
    dora_information_sharing_arrangements_profile_for(paragraph_2_false, Profile),
    condition_citations(Citations),
    information_sharing_within_article_45(Profile, sharing_outside_article_45, Citations).

test(within_is_rejected_bound_on_the_near_miss, fail) :-
    dora_information_sharing_arrangements_profile_for(paragraph_2_false, Profile),
    information_sharing_within_article_45(Profile, sharing_within_article_45, _Citations).

test(missing_key_holds_bound) :-
    dora_information_sharing_arrangements_profile_for(community_absent, Profile),
    information_sharing_within_article_45(Profile, indeterminate([sharing_takes_place_within_trusted_community_of_financial_entities]), []).

test(cessation_notice_holds_bound) :-
    dora_information_sharing_arrangements_profile_for(cessation_effective_true, Profile),
    membership_notification_duty(Profile, notify_cessation_once_effective, [cite(eu_reg_2022_2554_art_45_3)]).

test(no_duty_holds_bound) :-
    dora_information_sharing_arrangements_profile_for(cessation_arrangement_false, Profile),
    membership_notification_duty(Profile, no_notification_duty, [cite(eu_reg_2022_2554_art_45_3)]).

test(status_compound_carries_no_citation, fail) :-
    dora_information_sharing_arrangements_profile_for(arrangement_absent, Profile),
    membership_notification_duty(Profile, indeterminate(_MissingKeys), [_|_]).

% ---- input tolerance -------------------------------------------------
test(an_unbound_profile_is_not_an_attribute_list) :-
    findall(Problems, dora_information_sharing_arrangements_input_problems(_Profile, Problems), Answers),
    Answers == [[wrong_type(profile)]].

test(a_partial_list_is_not_an_attribute_list) :-
    findall(Problems, dora_information_sharing_arrangements_input_problems([attribute(membership_event, membership_validated)|_Tail], Problems), Answers),
    Answers == [[wrong_type(profile)]].

test(a_non_attribute_element_is_not_an_attribute_list) :-
    dora_information_sharing_arrangements_input_problems([attribute(membership_event, membership_validated), membership_event-true], [wrong_type(profile)]).

test(a_non_list_profile_is_refused_by_the_duty_query) :-
    findall(Result-Citations, membership_notification_duty(not_an_attribute_list, Result, Citations), Answers),
    Answers == [input_problems([wrong_type(profile)])-[]].

test(an_unbound_key_is_unknown_as_given) :-
    information_sharing_within_article_45([attribute(Key, anything)], input_problems([unknown_key(Reported)]), []),
    Reported == Key.

test(the_same_unbound_key_twice_is_one_unknown_key) :-
    dora_information_sharing_arrangements_input_problems([attribute(Key, one), attribute(Key, two)], Problems),
    Problems = [unknown_key(Reported)],
    Reported == Key.

test(two_distinct_unbound_keys_are_two_unknown_keys) :-
    dora_information_sharing_arrangements_input_problems([attribute(FirstKey, one), attribute(SecondKey, two)], Problems),
    Problems = [unknown_key(FirstReported), unknown_key(SecondReported)],
    FirstReported == FirstKey,
    SecondReported == SecondKey.

test(an_unknown_key_value_is_not_checked) :-
    dora_information_sharing_arrangements_input_problems([attribute(entity_size, _AnyValue)], [unknown_key(entity_size)]).

test(a_number_key_is_unknown) :-
    dora_information_sharing_arrangements_input_problems([attribute(7, true), attribute(7.0, true)], [unknown_key(7), unknown_key(7.0)]).

test(a_float_value_is_wrong_type) :-
    dora_information_sharing_arrangements_input_problems([attribute(membership_event, 1.0)], [wrong_type(membership_event)]).

test(an_unbound_value_of_a_contract_key_is_wrong_type) :-
    dora_information_sharing_arrangements_input_problems([attribute(arrangement_is_information_sharing_arrangement_referred_to_in_article_45_1, _UnboundValue)], [wrong_type(arrangement_is_information_sharing_arrangement_referred_to_in_article_45_1)]).

test(a_duplicate_key_reads_none_of_its_values) :-
    dora_information_sharing_arrangements_input_problems([attribute(sharing_aims_to_enhance_digital_operational_resilience, true), attribute(sharing_aims_to_enhance_digital_operational_resilience, not_a_judgement)], [duplicate_key(sharing_aims_to_enhance_digital_operational_resilience)]).

test(problems_come_in_contract_order_then_unknown_keys) :-
    Profile = [
        attribute(zeta_key, 1),
        attribute(membership_event, wrong_event),
        attribute(information_is_cyber_threat_information_and_intelligence, true),
        attribute(information_is_cyber_threat_information_and_intelligence, false),
        attribute(alpha_key, 2),
        attribute(zeta_key, 3)
    ],
    findall(Problems, dora_information_sharing_arrangements_input_problems(Profile, Problems), Answers),
    Answers == [[duplicate_key(information_is_cyber_threat_information_and_intelligence), wrong_type(membership_event), unknown_key(zeta_key), unknown_key(alpha_key)]].

test(an_empty_profile_has_no_problem) :-
    dora_information_sharing_arrangements_input_problems([], []).

test(an_irrelevant_present_key_is_still_checked) :-
    membership_notification_duty([attribute(membership_event, no_membership_event), attribute(sharing_aims_to_enhance_digital_operational_resilience, maybe)], input_problems([wrong_type(sharing_aims_to_enhance_digital_operational_resilience)]), []).

:- end_module(test_input_mode).
