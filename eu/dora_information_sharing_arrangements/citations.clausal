% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/dora_information_sharing_arrangements.
%
% Instrument: Regulation (EU) 2022/2554 of the European Parliament and of
% the Council of 14 December 2022 on digital operational resilience for the
% financial sector (DORA), CELEX 32022R2554, original OJ text as published,
% OJ L 333, 27.12.2022, p. 1 (pin folder
% eu/dora_information_sharing_arrangements/sources/).
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% Each verbatim below is the pinned unit text of 32022R2554, quoted in the
% order; each key is `status: verified` in citations-sources.yaml.
%
% The keys are the canonical lexicon keys (_lexicon/citations.yaml). The
% heading of Article 45 (unit 32022R2554#art_045) carries no rule and is
% deferred: no key is recorded for it.
%
% PROVENANCE: every operative clause opens its body with implements(Key),
% Key one of the keys recorded here.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

% Art 45(1), lead words [32022R2554#parag_045.001]: the permission and the
% condition that the information is cyber threat information and intelligence.
citation(eu_reg_2022_2554_art_45_1, [label-'Regulation (EU) 2022/2554 (DORA) Art 45(1), lead words (cyber threat information and intelligence)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (unit 32022R2554#parag_045.001)', verbatim-'Financial entities may exchange amongst themselves cyber threat information and intelligence, including indicators of compromise, tactics, techniques, and procedures, cyber security alerts and configuration tools, to the extent that such information and intelligence sharing:']).

% Art 45(1)(a) [32022R2554#point_045.001_a]: the aim of enhancing digital
% operational resilience.
citation(eu_reg_2022_2554_art_45_1_a, [label-'Regulation (EU) 2022/2554 (DORA) Art 45(1)(a) (aim to enhance digital operational resilience)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (unit 32022R2554#point_045.001_a)', verbatim-'aims to enhance the digital operational resilience of financial entities, in particular through raising awareness in relation to cyber threats, limiting or impeding the cyber threats’ ability to spread, supporting defence capabilities, threat detection techniques, mitigation strategies or response and recovery stages;']).

% Art 45(1)(b) [32022R2554#point_045.001_b]: within trusted communities of
% financial entities.
citation(eu_reg_2022_2554_art_45_1_b, [label-'Regulation (EU) 2022/2554 (DORA) Art 45(1)(b) (trusted communities of financial entities)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (unit 32022R2554#point_045.001_b)', verbatim-'takes places within trusted communities of financial entities;']).

% Art 45(1)(c) [32022R2554#point_045.001_c]: arrangements that protect the
% sensitive information and are governed by rules of conduct.
citation(eu_reg_2022_2554_art_45_1_c, [label-'Regulation (EU) 2022/2554 (DORA) Art 45(1)(c) (protective information-sharing arrangements governed by rules of conduct)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (unit 32022R2554#point_045.001_c)', verbatim-'is implemented through information-sharing arrangements that protect the potentially sensitive nature of the information shared, and that are governed by rules of conduct in full respect of business confidentiality, protection of personal data in accordance with Regulation (EU) 2016/679 and guidelines on competition policy.']).

% Art 45(2) [32022R2554#parag_045.002]: what the arrangements define, for
% point (c).
citation(eu_reg_2022_2554_art_45_2, [label-'Regulation (EU) 2022/2554 (DORA) Art 45(2) (conditions for participation and details of the arrangements)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (unit 32022R2554#parag_045.002)', verbatim-'For the purpose of paragraph 1, point (c), the information-sharing arrangements shall define the conditions for participation and, where appropriate, shall set out the details on the involvement of public authorities and the capacity in which they may be associated to the information-sharing arrangements, on the involvement of ICT third-party service providers, and on operational elements, including the use of dedicated IT platforms.']).

% Art 45(3) [32022R2554#parag_045.003]: the notification of participation
% and of cessation of membership.
citation(eu_reg_2022_2554_art_45_3, [label-'Regulation (EU) 2022/2554 (DORA) Art 45(3) (notification of participation and of cessation of membership)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (unit 32022R2554#parag_045.003)', verbatim-'Financial entities shall notify competent authorities of their participation in the information-sharing arrangements referred to in paragraph 1, upon validation of their membership, or, as applicable, of the cessation of their membership, once it takes effect.']).

% implements(Key): the provenance marker; succeeds for every recorded key,
% fails for a key not recorded here.
implements(Key) :-
    citation(Key, _).

:- end_module(citations).
