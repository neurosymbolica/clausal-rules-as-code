% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/dma_art_6_9_10_portability_and_business_data_order.
%
% Instrument: Regulation (EU) 2022/1925 (Digital Markets Act), the pinned
% original act 32022R1925, OJ L 265, 12.10.2022, source xhtml sha256
% d6af21a4f11c2b001b0486391fbd0813deba32305fb0d3865fbceccd45b827eb.
% No corrigendum is pinned or read (open question Q12).
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% The verbatim pair is OMITTED while the key's entry in
% citations-sources.yaml is `status: unverified`.
%
% Five provision keys (the canonical lexicon spelling, never shortened):
%   eu_reg_2022_1925_art_6_1, eu_reg_2022_1925_art_6_9,
%   eu_reg_2022_1925_art_6_10, eu_reg_2022_1925_art_2_25,
%   eu_reg_2022_1925_art_2_32.
% Two referral TARGETS, which are not provisions of the pinned act and
% appear only inside cross_reference_unresolved/2 and resolution/2:
%   commission_designation_decision (the Art 3(9) designation decision,
%   reached from Art 6(1)); digital_markets_business_user_data_sharing_consent_statement
%   (the end users' opt-in consent, reached from Art 6(10) and Art 2(32)).
%
% PROVENANCE: every operative clause opens its body with implements(Key).
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

citation(eu_reg_2022_1925_art_6_1, [label-'Regulation (EU) 2022/1925 (Digital Markets Act) Art 6(1), obligations apply to each core platform service listed in the designation decision', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R1925#parag_006.001', verbatim-'shall comply with all obligations set out in this Article with respect to each of its core platform services listed in the designation decision pursuant to Article 3(9).']).

citation(eu_reg_2022_1925_art_6_9, [label-'Regulation (EU) 2022/1925 (Digital Markets Act) Art 6(9), effective portability of end user data', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R1925#parag_006.009', verbatim-'The gatekeeper shall provide end users and third parties authorised by an end user, at their request and free of charge, with effective portability of data provided by the end user or generated through the activity of the end user in the context of the use of the relevant core platform service, including by providing, free of charge, tools to facilitate the effective exercise of such data portability, and including by the provision of continuous and real-time access to such data.']).

citation(eu_reg_2022_1925_art_6_10, [label-'Regulation (EU) 2022/1925 (Digital Markets Act) Art 6(10), business user access to and use of data, with the personal data conditions of the second subparagraph', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R1925#parag_006.010', verbatim-'The gatekeeper shall provide business users and third parties authorised by a business user, at their request, free of charge, with effective, high-quality, continuous and real-time access to, and use of, aggregated and non-aggregated data, including personal data, that is provided for or generated in the context of the use of the relevant core platform services or services provided together with, or in support of, the relevant core platform services by those business users and the end users engaging with the products or services provided by those business users. With regard to personal data, the gatekeeper shall provide for such access to, and use of, personal data only where the data are directly connected with the use effectuated by the end users in respect of the products or services offered by the relevant business user through the relevant core platform service, and when the end users opt in to such sharing by giving their consent.']).

citation(eu_reg_2022_1925_art_2_25, [label-'Regulation (EU) 2022/1925 (Digital Markets Act) Art 2(25), definition of personal data', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R1925#point_002_25', verbatim-'means personal data as defined in Article 4, point (1), of Regulation (EU) 2016/679']).

citation(eu_reg_2022_1925_art_2_32, [label-'Regulation (EU) 2022/1925 (Digital Markets Act) Art 2(32), definition of consent', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R1925#point_002_32', verbatim-'means consent as defined in Article 4, point (11), of Regulation (EU) 2016/679']).

citation(commission_designation_decision, [label-'Referral target: Commission designation decision under Article 3(9) of Regulation (EU) 2022/1925 listing the core platform service (outside fact, reached from Art 6(1))', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R1925']).

citation(digital_markets_business_user_data_sharing_consent_statement, [label-'Referral target: statement that the end users opted in to the sharing by giving consent within the meaning of Art 2(32) of Regulation (EU) 2022/1925 (outside fact, reached from Art 6(10))', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R1925']).

% implements(Key): the provenance marker; succeeds for every recorded key and
% fails for a key not recorded here.
implements(Key) :-
    citation(Key, _).

:- end_module(citations).
