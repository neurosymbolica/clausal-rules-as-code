dma_art_6_9_10_portability_and_business_data_order_profile_for(input_crisp_key_unsure, [
        attribute(end_user_data_portability_free_of_charge, unsure)
    ]).

% ---- Baseline profile read by the scaffold's mode tests --------------
% Not in the subject registry: the same profile as the met portability
