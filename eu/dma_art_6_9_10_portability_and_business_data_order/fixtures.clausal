% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% fixtures.clausal -- representative profiles for eu/dma_art_6_9_10_portability_and_business_data_order.
% A TOP-LAYER consumer: it imports only the slice predicate it calls.
%
% A profile is an ATTRIBUTE LIST [attribute(Key, Value), ...] (the order's
% typed input contract). The order sets no figure, so there is no numeric
% threshold: each route has a positive subject and a one-key near-miss
% control that flips exactly one value (true to false, a statement to its
% opposite, a value to absent or unsure), named in the comment above it.
% Outside facts are attested statements as a host would supply them.
% =====================================================================

:- module(fixtures, [
    dma_art_6_9_10_portability_and_business_data_order_subject/1,
    dma_art_6_9_10_portability_and_business_data_order_profile_for/2,
    dma_art_6_9_10_portability_and_business_data_order_assess/2
]).

:- use_module(eu/dma_art_6_9_10_portability_and_business_data_order/dma_art_6_9_10_portability_and_business_data_order, [decide_dma_art_6_9_10_portability_and_business_data_order/2]).

% ---- Attested statements --------------------------------------------
listed_statement(attested(true, attestation(host_operator, '2026-11-19T10:00:00Z', listed_in_designation_decision, none))).
not_listed_statement(attested(false, attestation(host_operator, '2026-11-19T10:00:00Z', not_listed_in_designation_decision, none))).
consent_given_statement(attested(true, attestation(host_operator, '2026-11-19T10:00:00Z', end_users_opted_in, none))).
consent_refused_statement(attested(false, attestation(host_operator, '2026-11-19T10:00:00Z', end_users_did_not_opt_in, none))).

