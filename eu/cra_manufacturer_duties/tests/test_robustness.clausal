% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_robustness.clausal -- ROBUSTNESS of the input check cra_manufacturer_duties_input_problems/2 for a
% PROFILE that is an attribute list [attribute(Key, Value), ...]: an empty list, a
% value that is not a list, an unknown key and a value outside its type each get exactly
% one answer. Written by the scaffold from the order's typed input contract
% (input_contract.types.profile: attribute_list), not by the producer;
% do not edit or delete.
% Run: python -m clausal.testing eu/cra_manufacturer_duties/tests/test_robustness.clausal
% =====================================================================
:- module(test_robustness, []).
:- use_module(eu/cra_manufacturer_duties/queries, [cra_manufacturer_duties_input_problems/2]).

test(an_empty_attribute_list_gets_exactly_one_answer) :-
    findall(Problems, cra_manufacturer_duties_input_problems([], Problems), Answers),
    Answers == [[]].

test(a_profile_that_is_not_a_list_gets_one_non_empty_answer) :-
    findall(Problems, cra_manufacturer_duties_input_problems(not_a_profile, Problems), Answers),
    Answers = [[_|_]].

test(an_unknown_key_is_named) :-
    findall(Problems, cra_manufacturer_duties_input_problems([attribute(not_a_key_of_the_contract, true)], Problems), Answers),
    Answers = [Problems],
    memberchk(unknown_key(not_a_key_of_the_contract), Problems).

test(a_value_outside_the_type_of_placing_on_market_date_is_named) :-
    findall(Problems, cra_manufacturer_duties_input_problems([attribute(placing_on_market_date, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(placing_on_market_date), Problems).

test(a_value_outside_the_type_of_substantially_modified_on_or_after_application_date_is_named) :-
    findall(Problems, cra_manufacturer_duties_input_problems([attribute(substantially_modified_on_or_after_application_date, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(substantially_modified_on_or_after_application_date), Problems).

test(a_value_outside_the_type_of_expected_use_time_in_months_is_named) :-
    findall(Problems, cra_manufacturer_duties_input_problems([attribute(expected_use_time_in_months, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(expected_use_time_in_months), Problems).

:- end_module(test_robustness).
