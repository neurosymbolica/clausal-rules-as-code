dma_art_5_2_data_combination_order_profile_for(consent_absent, Profile) :-
    stated(true, Designation),
    stated(false, OtherBasis),
    Profile = [
        attribute(designated_as_gatekeeper_for_core_platform_service, Designation),
        attribute(practice_under_article_5_2, combining_personal_data),
        attribute(end_user_presented_with_specific_choice, true),
