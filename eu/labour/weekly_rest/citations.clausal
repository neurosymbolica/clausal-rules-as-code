% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/labour/weekly_rest.
%
% Instrument: Directive 2003/88/EC of the European Parliament and of the
% Council of 4 November 2003 concerning certain aspects of the organisation
% of working time (Working Time Directive), OJ L 299, 18.11.2003, CELEX
% 32003L0088 -- the original act (no English consolidation exists; a later
% amendment is not in the pin, reading (13)). Pinned EUR-Lex HTML, raw
% sha256 0d23ad4953be900de8a614fea4022aa46086e0bdc2fdfd6d0fde0cd84429e4b6.
% Unit ids are the converter's names from the printed numbering.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% Each verbatim is an exact substring of the pinned unit text; quotation
% marks and apostrophes of the source are left outside the quoted span.
%
% The keys are the CANONICAL lexicon keys (_lexicon/citations.yaml); they
% are never shortened or re-spelled.
% lint: canonical-citation-lexicon
%
% PROVENANCE: every operative clause opens its body with implements(Key),
% Key one recorded below.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

% Art 2(1), unit parag_002.001: definition of working time.
citation(eu_dir_2003_88_art_2_1, [label-'Directive 2003/88/EC Art 2(1) definition of working time', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32003L0088#parag_002.001', verbatim-'carrying out his activity or duties, in accordance with national laws and/or practice']).

% Art 2(2), unit parag_002.002: definition of rest period.
citation(eu_dir_2003_88_art_2_2, [label-'Directive 2003/88/EC Art 2(2) definition of rest period', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32003L0088#parag_002.002', verbatim-'means any period which is not working time']).

% Art 2(7), unit parag_002.007: definition of mobile worker.
citation(eu_dir_2003_88_art_2_7, [label-'Directive 2003/88/EC Art 2(7) definition of mobile worker', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32003L0088#parag_002.007', verbatim-'means any worker employed as a member of travelling or flying personnel by an undertaking which operates transport services for passengers or goods by road, air or inland waterway']).

% Art 5, first subparagraph, unit subpara_005_1: the weekly rest of 24 hours plus 11 hours.
citation(eu_dir_2003_88_art_5_first_subpara, [label-'Directive 2003/88/EC Art 5, first subparagraph (minimum weekly rest period of 24 hours plus the 11 hours of daily rest)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32003L0088#subpara_005_1', verbatim-'per each seven-day period, every worker is entitled to a minimum uninterrupted rest period of 24 hours plus the 11 hours']).

% Art 5, second subparagraph, unit subpara_005_2: the reduced minimum of 24 hours.
citation(eu_dir_2003_88_art_5_second_subpara, [label-'Directive 2003/88/EC Art 5, second subparagraph (reduced minimum rest period of 24 hours)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32003L0088#subpara_005_2', verbatim-'If objective, technical or work organisation conditions so justify, a minimum rest period of 24 hours may be applied.']).

% Art 16(a), unit point_016_a: reference period for Art 5.
citation(eu_dir_2003_88_art_16_a, [label-'Directive 2003/88/EC Art 16(a) (reference period for the weekly rest period, not exceeding 14 days)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32003L0088#point_016_a', verbatim-'for the application of Article 5 (weekly rest period), a reference period not exceeding 14 days']).

% Art 17(1), opening words, unit parag_017.001: derogation where working time is not measured.
citation(eu_dir_2003_88_art_17_1, [label-'Directive 2003/88/EC Art 17(1), opening words (derogation from Articles 3 to 6, 8 and 16)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32003L0088#parag_017.001', verbatim-'Member States may derogate from Articles 3 to 6, 8 and 16 when, on account of the specific characteristics of the activity concerned, the duration of the working time is not measured and/or predetermined or can be determined by the workers themselves']).

% Art 17(3), opening words, unit parag_017.003: derogations in the listed activities.
citation(eu_dir_2003_88_art_17_3, [label-'Directive 2003/88/EC Art 17(3), opening words (derogation from Articles 3, 4, 5, 8 and 16)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32003L0088#parag_017.003', verbatim-'In accordance with paragraph 2 of this Article derogations may be made from Articles 3, 4, 5, 8 and 16']).

% Art 17(4), opening words, unit parag_017.004: derogations for shift work and split work.
citation(eu_dir_2003_88_art_17_4, [label-'Directive 2003/88/EC Art 17(4), opening words (derogation from Articles 3 and 5)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32003L0088#parag_017.004', verbatim-'In accordance with paragraph 2 of this Article derogations may be made from Articles 3 and 5']).

% Art 18, first subparagraph, unit subpara_018_1: derogation by collective agreement.
citation(eu_dir_2003_88_art_18_first_subpara, [label-'Directive 2003/88/EC Art 18, first subparagraph (derogation by collective agreement at national or regional level)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32003L0088#subpara_018_1', verbatim-'Derogations may be made from Articles 3, 4, 5, 8 and 16 by means of collective agreements or agreements concluded between the two sides of industry at national or regional level']).

% Art 18, second subparagraph, unit subpara_018_2: derogation at the appropriate collective level.
citation(eu_dir_2003_88_art_18_second_subpara, [label-'Directive 2003/88/EC Art 18, second subparagraph (derogation by collective agreement at the appropriate collective level)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32003L0088#subpara_018_2', verbatim-'allow derogations from Articles 3, 4, 5, 8 and 16 by way of collective agreements or agreements concluded between the two sides of industry at the appropriate collective level']).

% Art 20(1), first subparagraph, unit parag_020.001: Art 5 does not apply to mobile workers.
citation(eu_dir_2003_88_art_20_1, [label-'Directive 2003/88/EC Art 20(1), first subparagraph (Articles 3, 4, 5 and 8 do not apply to mobile workers)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32003L0088#parag_020.001', verbatim-'Articles 3, 4, 5 and 8 shall not apply to mobile workers.']).

% Art 21(1), first subparagraph, unit parag_021.001: Art 5 does not apply on seagoing fishing vessels.
citation(eu_dir_2003_88_art_21_1, [label-'Directive 2003/88/EC Art 21(1), first subparagraph (Articles 3 to 6 and 8 do not apply to workers on board seagoing fishing vessels)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32003L0088#parag_021.001', verbatim-'Articles 3 to 6 and 8 shall not apply to any worker on board a seagoing fishing vessel flying the flag of a Member State.']).

% implements(Key): the provenance marker; succeeds for every recorded key
% and fails for a key not recorded here.
implements(Key) :-
    citation(Key, _).

:- end_module(citations).
