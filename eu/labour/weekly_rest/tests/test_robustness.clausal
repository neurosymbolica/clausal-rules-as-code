% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_robustness.clausal -- ROBUSTNESS of the input check weekly_rest_input_problems/2 for a
% PROFILE that is an attribute list [attribute(Key, Value), ...]: an empty list, a
% value that is not a list, an unknown key and a value outside its type each get exactly
% one answer. Written by the scaffold from the order's typed input contract
% (input_contract.types.profile: attribute_list), not by the producer;
% do not edit or delete.
% Run: python -m clausal.testing eu/labour/weekly_rest/tests/test_robustness.clausal
% =====================================================================
:- module(test_robustness, []).
:- use_module(eu/labour/weekly_rest/queries, [weekly_rest_input_problems/2]).

test(an_empty_attribute_list_gets_exactly_one_answer) :-
    findall(Problems, weekly_rest_input_problems([], Problems), Answers),
    Answers == [[]].

test(a_profile_that_is_not_a_list_gets_one_non_empty_answer) :-
    findall(Problems, weekly_rest_input_problems(not_a_profile, Problems), Answers),
    Answers = [[_|_]].

test(an_unknown_key_is_named) :-
    findall(Problems, weekly_rest_input_problems([attribute(not_a_key_of_the_contract, true)], Problems), Answers),
    Answers = [Problems],
    memberchk(unknown_key(not_a_key_of_the_contract), Problems).

test(a_value_outside_the_type_of_on_call_on_site_counts_as_working_time_is_named) :-
    findall(Problems, weekly_rest_input_problems([attribute(on_call_on_site_counts_as_working_time, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(on_call_on_site_counts_as_working_time), Problems).

test(a_value_outside_the_type_of_weekly_rest_minimum_is_named) :-
    findall(Problems, weekly_rest_input_problems([attribute(weekly_rest_minimum, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(weekly_rest_minimum), Problems).

:- end_module(test_robustness).
