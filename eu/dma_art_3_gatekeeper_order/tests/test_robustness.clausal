% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_robustness.clausal -- ROBUSTNESS of the input check dma_art_3_gatekeeper_order_input_problems/2 for a
% PROFILE that is an attribute list [attribute(Key, Value), ...]: an empty list, a
% value that is not a list, an unknown key and a value outside its type each get exactly
% one answer. Written by the scaffold from the order's typed input contract
% (input_contract.types.profile: attribute_list), not by the producer;
% do not edit or delete.
% Run: python -m clausal.testing eu/dma_art_3_gatekeeper_order/tests/test_robustness.clausal
% =====================================================================
:- module(test_robustness, []).
:- use_module(eu/dma_art_3_gatekeeper_order/queries, [dma_art_3_gatekeeper_order_input_problems/2]).

test(an_empty_attribute_list_gets_exactly_one_answer) :-
    findall(Problems, dma_art_3_gatekeeper_order_input_problems([], Problems), Answers),
    Answers == [[]].

test(a_profile_that_is_not_a_list_gets_one_non_empty_answer) :-
    findall(Problems, dma_art_3_gatekeeper_order_input_problems(not_a_profile, Problems), Answers),
    Answers = [[_|_]].

test(an_unknown_key_is_named) :-
    findall(Problems, dma_art_3_gatekeeper_order_input_problems([attribute(not_a_key_of_the_contract, 5)], Problems), Answers),
    Answers = [Problems],
    memberchk(unknown_key(not_a_key_of_the_contract), Problems).

test(a_value_outside_the_type_of_market_capitalisation_eur_most_recent_financial_year_is_named) :-
    findall(Problems, dma_art_3_gatekeeper_order_input_problems([attribute(market_capitalisation_eur_most_recent_financial_year, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(market_capitalisation_eur_most_recent_financial_year), Problems).

test(a_value_outside_the_type_of_rebuttal_arguments_presented_is_named) :-
    findall(Problems, dma_art_3_gatekeeper_order_input_problems([attribute(rebuttal_arguments_presented, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(rebuttal_arguments_presented), Problems).

test(a_value_outside_the_type_of_rebuttal_accepted_by_commission_is_named) :-
    findall(Problems, dma_art_3_gatekeeper_order_input_problems([attribute(rebuttal_accepted_by_commission, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(rebuttal_accepted_by_commission), Problems).

:- end_module(test_robustness).
