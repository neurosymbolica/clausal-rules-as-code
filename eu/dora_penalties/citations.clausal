% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/dora_penalties.
%
% Instrument: Regulation (EU) 2022/2554 of the European Parliament and of
% the Council of 14 December 2022 on digital operational resilience for
% the financial sector (DORA), CELEX 32022R2554, the original OJ text as
% published (OJ L 333, 27.12.2022, p. 1). Pin folder
% eu/dora_penalties/sources/. Each verbatim below is an exact substring of
% the pinned unit text.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
%
% Keys returned in answers are the canonical lexicon keys of the order's
% CITATION VOCABULARY. The deferred units (Art 50(1), Art 51(1)) are
% recorded so that a clause relying on them has a key to name; they are
% never returned in a result.
%
% PROVENANCE: every operative clause opens its body with implements(Key),
% Key one recorded here. implements/1 succeeds for every recorded key and
% fails for any other, so a misspelt key never lies.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

implements(Key) :-
    citation(Key, _).

% ---- Article 50: administrative penalties and remedial measures ----

% Deferred: the general clause (reading 3 relies on it for the place of
% Art 50(2) point (c)); never returned in a result.
citation(eu_reg_2022_2554_art_50_1, [
    label-'Regulation (EU) 2022/2554 (DORA) Art 50(1), general clause on supervisory, investigatory and sanctioning powers',
    ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj',
    verbatim-'Competent authorities shall have all supervisory, investigatory and sanctioning powers necessary to fulfil their duties under this Regulation.'
]).

citation(eu_reg_2022_2554_art_50_2_a, [
    label-'Regulation (EU) 2022/2554 (DORA) Art 50(2)(a), power of access to documents and data',
    ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj',
    verbatim-'have access to any document or data held in any form that the competent authority considers relevant for the performance of its duties and receive or take a copy of it'
]).

citation(eu_reg_2022_2554_art_50_2_b, [
    label-'Regulation (EU) 2022/2554 (DORA) Art 50(2)(b), with points (i) and (ii), power to carry out on-site inspections or investigations',
    ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj',
    verbatim-'carry out on-site inspections or investigations, which shall include but shall not be limited to'
]).

citation(eu_reg_2022_2554_art_50_2_c, [
    label-'Regulation (EU) 2022/2554 (DORA) Art 50(2)(c), power to require corrective and remedial measures',
    ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj',
    verbatim-'require corrective and remedial measures for breaches of the requirements of this Regulation'
]).

citation(eu_reg_2022_2554_art_50_3, [
    label-'Regulation (EU) 2022/2554 (DORA) Art 50(3), first sentence, duty to lay down rules for administrative penalties and remedial measures',
    ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj',
    verbatim-'Member States shall lay down rules establishing appropriate administrative penalties and remedial measures for breaches of this Regulation'
]).

citation(eu_reg_2022_2554_art_50_4_a, [
    label-'Regulation (EU) 2022/2554 (DORA) Art 50(4)(a), cease and desist order',
    ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj',
    verbatim-'issue an order requiring the natural or legal person to cease conduct that is in breach of this Regulation and to desist from a repetition of that conduct'
]).

citation(eu_reg_2022_2554_art_50_4_b, [
    label-'Regulation (EU) 2022/2554 (DORA) Art 50(4)(b), cessation of a practice or conduct',
    ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj',
    verbatim-'require the temporary or permanent cessation of any practice or conduct that the competent authority considers to be contrary to the provisions of this Regulation and prevent repetition of that practice or conduct'
]).

citation(eu_reg_2022_2554_art_50_4_c, [
    label-'Regulation (EU) 2022/2554 (DORA) Art 50(4)(c), measures to ensure continued compliance',
    ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj',
    verbatim-'adopt any type of measure, including of pecuniary nature, to ensure that financial entities continue to comply with legal requirements'
]).

citation(eu_reg_2022_2554_art_50_4_d, [
    label-'Regulation (EU) 2022/2554 (DORA) Art 50(4)(d), requiring existing data traffic records insofar as permitted by national law',
    ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj',
    verbatim-'require, insofar as permitted by national law, existing data traffic records held by a telecommunication operator'
]).

citation(eu_reg_2022_2554_art_50_4_e, [
    label-'Regulation (EU) 2022/2554 (DORA) Art 50(4)(e), public notices',
    ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj',
    verbatim-'issue public notices, including public statements indicating the identity of the natural or legal person and the nature of the breach'
]).

citation(eu_reg_2022_2554_art_50_5, [
    label-'Regulation (EU) 2022/2554 (DORA) Art 50(5), extension to members of the management body and other responsible individuals',
    ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj',
    verbatim-'Member States shall confer on competent authorities the power to apply the administrative penalties and remedial measures, subject to the conditions provided for in national law, to members of the management body, and to other individuals who under national law are responsible for the breach'
]).

citation(eu_reg_2022_2554_art_50_6, [
    label-'Regulation (EU) 2022/2554 (DORA) Art 50(6), reasoned decision and right of appeal',
    ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj',
    verbatim-'Member States shall ensure that any decision imposing administrative penalties or remedial measures set out in paragraph 2, point (c), is properly reasoned and is subject to a right of appeal.'
]).

% ---- Article 51: exercise of the powers ----

% Deferred: the ways of exercising the powers; never returned in a result.
citation(eu_reg_2022_2554_art_51_1, [
    label-'Regulation (EU) 2022/2554 (DORA) Art 51(1), ways of exercising the powers under national legal frameworks',
    ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj',
    verbatim-'Competent authorities shall exercise the powers to impose administrative penalties and remedial measures referred to in Article 50 in accordance with their national legal frameworks'
]).

citation(eu_reg_2022_2554_art_51_2, [
    label-'Regulation (EU) 2022/2554 (DORA) Art 51(2), lead words, intent or negligence and all other relevant circumstances',
    ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj',
    verbatim-'shall take into account the extent to which the breach is intentional or results from negligence, and all other relevant circumstances, including the following, where appropriate'
]).

citation(eu_reg_2022_2554_art_51_2_a, [
    label-'Regulation (EU) 2022/2554 (DORA) Art 51(2)(a), materiality, gravity and duration of the breach',
    ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj',
    verbatim-'the materiality, gravity and the duration of the breach'
]).

citation(eu_reg_2022_2554_art_51_2_b, [
    label-'Regulation (EU) 2022/2554 (DORA) Art 51(2)(b), degree of responsibility',
    ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj',
    verbatim-'the degree of responsibility of the natural or legal person responsible for the breach'
]).

citation(eu_reg_2022_2554_art_51_2_c, [
    label-'Regulation (EU) 2022/2554 (DORA) Art 51(2)(c), financial strength',
    ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj',
    verbatim-'the financial strength of the responsible natural or legal person'
]).

citation(eu_reg_2022_2554_art_51_2_d, [
    label-'Regulation (EU) 2022/2554 (DORA) Art 51(2)(d), profits gained or losses avoided',
    ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj',
    verbatim-'the importance of profits gained or losses avoided by the responsible natural or legal person, insofar as they can be determined'
]).

citation(eu_reg_2022_2554_art_51_2_e, [
    label-'Regulation (EU) 2022/2554 (DORA) Art 51(2)(e), losses for third parties',
    ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj',
    verbatim-'the losses for third parties caused by the breach, insofar as they can be determined'
]).

citation(eu_reg_2022_2554_art_51_2_f, [
    label-'Regulation (EU) 2022/2554 (DORA) Art 51(2)(f), level of cooperation with the competent authority',
    ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj',
    verbatim-'the level of cooperation of the responsible natural or legal person with the competent authority'
]).

citation(eu_reg_2022_2554_art_51_2_g, [
    label-'Regulation (EU) 2022/2554 (DORA) Art 51(2)(g), previous breaches',
    ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj',
    verbatim-'previous breaches by the responsible natural or legal person'
]).

% ---- Article 52: criminal penalties ----

citation(eu_reg_2022_2554_art_52_1, [
    label-'Regulation (EU) 2022/2554 (DORA) Art 52(1), option not to lay down administrative rules for criminally penalised breaches',
    ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj',
    verbatim-'Member States may decide not to lay down rules for administrative penalties or remedial measures for breaches that are subject to criminal penalties under their national law.'
]).

citation(eu_reg_2022_2554_art_52_2, [
    label-'Regulation (EU) 2022/2554 (DORA) Art 52(2), liaison with judicial, prosecuting or criminal justice authorities',
    ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj',
    verbatim-'Where Member States have chosen to lay down criminal penalties for breaches of this Regulation, they shall ensure that appropriate measures are in place so that competent authorities have all the necessary powers to liaise with judicial, prosecuting, or criminal justice authorities within their jurisdiction'
]).

:- end_module(citations).
