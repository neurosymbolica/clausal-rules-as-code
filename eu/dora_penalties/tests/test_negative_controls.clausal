% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_negative_controls.clausal -- NEGATIVE CONTROLS.
% For each route: a POSITIVE case paired with a near-miss NEGATIVE control
% (one condition changed -> a different answer), proving the route is
% LOAD-BEARING and a wrong answer is NOT produced. A negative states "no
% solution" as `test(Name, fail) :- Goal.`, and each is paired with a
% positive test over the same case, so a misspelt atom shows up.
% Run: python -m clausal.testing eu/dora_penalties/tests/test_negative_controls.clausal
% =====================================================================
:- module(test_negative_controls, []).
:- use_module(eu/dora_penalties/dora_penalties, [
    administrative_penalty_rules_required/3,
    minimum_powers/2,
    penalty_decision_safeguards/2,
    circumstances_to_take_into_account/2,
    criminal_penalty_liaison_duties/2,
    dora_penalties_status/2,
    dora_penalties_status_values/1
]).
:- use_module(eu/dora_penalties/fixtures, [dora_penalties_profile_for/2]).

test(the_status_table_has_a_near_miss_atom) :-
    dora_penalties_status_values(StatusValues),
    StatusValues = [_, _|_].

test(the_near_miss_atoms_are_table_atoms) :-
    dora_penalties_status_values(StatusValues),
    member(required, StatusValues),
    member(not_required_criminal_penalties, StatusValues),
    member(indeterminate, StatusValues),
    member(input_problems, StatusValues).

% ---- (A4) the option used vs (A5) not used ------------------------------
test(a4_option_used_not_required) :-
    dora_penalties_profile_for(option_used, Profile),
    dora_penalties_status(Profile, not_required_criminal_penalties).
test(a5_option_not_used_required) :-
    dora_penalties_profile_for(option_not_used, Profile),
    dora_penalties_status(Profile, required).
test(a5_option_not_used_is_not_not_required, fail) :-
    dora_penalties_profile_for(option_not_used, Profile),
    dora_penalties_status(Profile, not_required_criminal_penalties).
test(a4_option_used_is_not_required, fail) :-
    dora_penalties_profile_for(option_used, Profile),
    dora_penalties_status(Profile, required).

% ---- (A2) breach not criminally penalised --------------------------------
test(a2_breach_not_criminal_required_with_art_50_3) :-
    dora_penalties_profile_for(breach_not_criminally_penalised, Profile),
    administrative_penalty_rules_required(Profile, required, [cite(eu_reg_2022_2554_art_50_3)]).
test(a2_choice_true_does_not_defeat, fail) :-
    dora_penalties_profile_for(breach_not_criminally_penalised, Profile),
    administrative_penalty_rules_required(Profile, not_required_criminal_penalties, _).

% ---- (A3) choice absent ------------------------------------------------
test(a3_choice_absent_named) :-
    dora_penalties_profile_for(breach_criminal_choice_absent, Profile),
    administrative_penalty_rules_required(Profile, indeterminate([member_state_chose_no_administrative_rules_for_criminally_penalised_breaches]), []).
test(a3_choice_present_is_not_indeterminate, fail) :-
    dora_penalties_profile_for(option_used, Profile),
    dora_penalties_status(Profile, indeterminate).

% ---- (A1) breach key absent --------------------------------------------
test(a1_breach_absent_named) :-
    dora_penalties_profile_for(breach_key_absent, Profile),
    administrative_penalty_rules_required(Profile, indeterminate([breach_subject_to_criminal_penalties_under_national_law]), []).
test(a1_choice_behind_breach_not_named, fail) :-
    administrative_penalty_rules_required([], indeterminate([member_state_chose_no_administrative_rules_for_criminally_penalised_breaches]), _).

% ---- (A0) input problems -----------------------------------------------
test(a0_unsure_fact_is_input_problem) :-
    dora_penalties_profile_for(fact_key_unsure, Profile),
    dora_penalties_status(Profile, input_problems).
test(a0_unsure_fact_gets_no_final_answer, fail) :-
    dora_penalties_profile_for(fact_key_unsure, Profile),
    dora_penalties_status(Profile, not_required_criminal_penalties).
test(a0_duplicate_is_input_problem) :-
    dora_penalties_profile_for(duplicate_breach_key, Profile),
    minimum_powers(Profile, input_problems([duplicate_key(breach_subject_to_criminal_penalties_under_national_law)])).
test(a0_unknown_key_is_input_problem) :-
    dora_penalties_profile_for(unknown_key_given, Profile),
    criminal_penalty_liaison_duties(Profile, input_problems([unknown_key(colour)])).
test(a0_unknown_key_gets_no_duties, fail) :-
    dora_penalties_profile_for(unknown_key_given, Profile),
    criminal_penalty_liaison_duties(Profile, [_|_]).

% ---- (P4) the option drops the penalty powers ---------------------------
test(p4_option_not_used_lists_penalties) :-
    dora_penalties_profile_for(option_not_used, Profile),
    minimum_powers(Profile, Powers),
    member(power(penalty, cease_and_desist_order, cite(eu_reg_2022_2554_art_50_4_a)), Powers).
test(p4_option_used_lists_no_penalty, fail) :-
    dora_penalties_profile_for(option_used, Profile),
    minimum_powers(Profile, Powers),
    member(power(penalty, _, _), Powers).
test(p4_option_used_keeps_point_c) :-
    dora_penalties_profile_for(option_used, Profile),
    minimum_powers(Profile, Powers),
    member(power(supervisory, require_corrective_and_remedial_measures, cite(eu_reg_2022_2554_art_50_2_c)), Powers).

% ---- Art 50(4)(d): data traffic records ---------------------------------
test(point_d_listed_when_permitted) :-
    dora_penalties_profile_for(option_not_used, Profile),
    minimum_powers(Profile, Powers),
    member(power(penalty, require_data_traffic_records, cite(eu_reg_2022_2554_art_50_4_d)), Powers).
test(point_d_not_listed_when_not_permitted, fail) :-
    dora_penalties_profile_for(no_criminal_penalties_laid_down, Profile),
    minimum_powers(Profile, Powers),
    member(power(penalty, require_data_traffic_records, _), Powers).
test(point_d_absent_named) :-
    minimum_powers([attribute(breach_subject_to_criminal_penalties_under_national_law, false)], indeterminate([national_law_permits_requiring_data_traffic_records])).

% ---- Art 50(5): the extension ------------------------------------------
test(extension_listed_for_legal_person) :-
    dora_penalties_profile_for(option_used, Profile),
    minimum_powers(Profile, Powers),
    member(power(extension, management_body_and_responsible_individuals, cite(eu_reg_2022_2554_art_50_5)), Powers).
test(extension_not_listed_otherwise, fail) :-
    dora_penalties_profile_for(no_criminal_penalties_laid_down, Profile),
    minimum_powers(Profile, Powers),
    member(power(extension, _, _), Powers).
test(extension_absent_named_last) :-
    minimum_powers([attribute(breach_subject_to_criminal_penalties_under_national_law, false), attribute(national_law_permits_requiring_data_traffic_records, true)], indeterminate([measures_applied_to_legal_person])).

% ---- (D) safeguards ----------------------------------------------------
test(d3_safeguards_for_point_c) :-
    dora_penalties_profile_for(option_not_used, Profile),
    penalty_decision_safeguards(Profile, [properly_reasoned(cite(eu_reg_2022_2554_art_50_6)), right_of_appeal(cite(eu_reg_2022_2554_art_50_6))]).
test(d2_no_safeguards_otherwise) :-
    dora_penalties_profile_for(no_criminal_penalties_laid_down, Profile),
    penalty_decision_safeguards(Profile, []).
test(d2_no_safeguard_listed, fail) :-
    dora_penalties_profile_for(no_criminal_penalties_laid_down, Profile),
    penalty_decision_safeguards(Profile, [_|_]).

% ---- (L) liaison duties ------------------------------------------------
test(l3_duties_when_laid_down) :-
    dora_penalties_profile_for(option_not_used, Profile),
    criminal_penalty_liaison_duties(Profile, [receive_criminal_proceedings_information(cite(eu_reg_2022_2554_art_52_2)), provide_information_to_authorities_and_esas(cite(eu_reg_2022_2554_art_52_2))]).
test(l2_no_duties_otherwise) :-
    dora_penalties_profile_for(no_criminal_penalties_laid_down, Profile),
    criminal_penalty_liaison_duties(Profile, []).
test(l2_no_duty_listed, fail) :-
    dora_penalties_profile_for(no_criminal_penalties_laid_down, Profile),
    criminal_penalty_liaison_duties(Profile, [_|_]).

% ---- (C) circumstances -------------------------------------------------
test(c3_settled_list) :-
    dora_penalties_profile_for(option_not_used, Profile),
    circumstances_to_take_into_account(Profile, [circumstance(intent_or_negligence, cite(eu_reg_2022_2554_art_51_2))|_]).
test(c2_unsure_referred) :-
    dora_penalties_profile_for(judgement_unsure, Profile),
    circumstances_to_take_into_account(Profile, needs_legal_review(open_textured(degree_of_responsibility_relevant, cite(eu_reg_2022_2554_art_51_2_b)), _)).
test(c2_unsure_gets_no_list, fail) :-
    dora_penalties_profile_for(judgement_unsure, Profile),
    circumstances_to_take_into_account(Profile, [_|_]).
test(c3_false_point_not_listed, fail) :-
    dora_penalties_profile_for(option_not_used, Profile),
    circumstances_to_take_into_account(Profile, Circumstances),
    member(circumstance(degree_of_responsibility, _), Circumstances).
test(c3_true_point_listed) :-
    dora_penalties_profile_for(option_not_used, Profile),
    circumstances_to_take_into_account(Profile, Circumstances),
    member(circumstance(previous_breaches, cite(eu_reg_2022_2554_art_51_2_g)), Circumstances).
test(c1_absent_before_unsure) :-
    circumstances_to_take_into_account([attribute(breach_materiality_gravity_duration_relevant, unsure)], indeterminate([degree_of_responsibility_relevant])).
test(c1_absent_is_not_referred, fail) :-
    circumstances_to_take_into_account([attribute(breach_materiality_gravity_duration_relevant, unsure)], needs_legal_review(_, _)).

:- end_module(test_negative_controls).
