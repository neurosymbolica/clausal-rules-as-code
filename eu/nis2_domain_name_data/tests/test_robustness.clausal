% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_robustness.clausal -- ROBUSTNESS of the input check nis2_domain_name_data_input_problems/2 for a
% PROFILE that is an attribute list [attribute(Key, Value), ...]: an empty list, a
% value that is not a list, an unknown key and a value outside its type each get exactly
% one answer. Written by the scaffold from the order's typed input contract
% (input_contract.types.profile: attribute_list), not by the producer;
% do not edit or delete.
% Run: python -m clausal.testing eu/nis2_domain_name_data/tests/test_robustness.clausal
% =====================================================================
:- module(test_robustness, []).
:- use_module(eu/nis2_domain_name_data/queries, [nis2_domain_name_data_input_problems/2]).

test(an_empty_attribute_list_gets_exactly_one_answer) :-
    findall(Problems, nis2_domain_name_data_input_problems([], Problems), Answers),
    Answers == [[]].

test(a_profile_that_is_not_a_list_gets_one_non_empty_answer) :-
    findall(Problems, nis2_domain_name_data_input_problems(not_a_profile, Problems), Answers),
    Answers = [[_|_]].

test(an_unknown_key_is_named) :-
    findall(Problems, nis2_domain_name_data_input_problems([attribute(not_a_key_of_the_contract, tld_name_registry)], Problems), Answers),
    Answers = [Problems],
    memberchk(unknown_key(not_a_key_of_the_contract), Problems).

test(a_value_outside_the_type_of_provider_type_is_named) :-
    findall(Problems, nis2_domain_name_data_input_problems([attribute(provider_type, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(provider_type), Problems).

test(a_value_outside_the_type_of_point_of_contact_email_address_differs_from_registrant_is_named) :-
    findall(Problems, nis2_domain_name_data_input_problems([attribute(point_of_contact_email_address_differs_from_registrant, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(point_of_contact_email_address_differs_from_registrant), Problems).

test(a_value_outside_the_type_of_registration_data_is_personal_data_is_named) :-
    findall(Problems, nis2_domain_name_data_input_problems([attribute(registration_data_is_personal_data, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(registration_data_is_personal_data), Problems).

:- end_module(test_robustness).
