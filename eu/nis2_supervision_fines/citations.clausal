% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/nis2_supervision_fines.
% Instrument: Directive (EU) 2022/2555 of the European Parliament and of the
% Council of 14 December 2022 (NIS 2 Directive), OJ L 333, 27.12.2022, CELEX
% 32022L2555. Pinned unit text: the original OJ text (raw sha256
% 6ee66d5c419d9a056fb98d94083cacf9b818803bd6b416435718e0d4919cb589).
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% Every key here is `status: verified` in citations-sources.yaml: its
% verbatim is an exact substring of the pinned unit text.
%
% The keys are the corpus lexicon's canonical keys (_lexicon/citations.yaml),
% the citation_vocabulary of the order. A clause cites a key with a
% `cite(Key)` term; cite(...) is data and needs no import.
%
% PROVENANCE: every operative clause opens its body with implements(Key);
% implements/1 succeeds for every key recorded here and fails for any other.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

implements(Key) :-
    citation(Key, _).

% ---- Art 32(2): supervisory powers over essential entities -----------
citation(eu_dir_2022_2555_art_32_2_a, [label-'Directive (EU) 2022/2555 Art 32(2)(a) (essential entities: on-site inspections and off-site supervision)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj 32022L2555#point_032.002_a', verbatim-'on-site inspections and off-site supervision, including random checks conducted by trained professionals']).
citation(eu_dir_2022_2555_art_32_2_b, [label-'Directive (EU) 2022/2555 Art 32(2)(b) (essential entities: regular and targeted security audits)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj 32022L2555#point_032.002_b', verbatim-'regular and targeted security audits carried out by an independent body or a competent authority']).
citation(eu_dir_2022_2555_art_32_2_c, [label-'Directive (EU) 2022/2555 Art 32(2)(c) (essential entities: ad hoc audits)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj 32022L2555#point_032.002_c', verbatim-'ad hoc audits, including where justified on the ground of a significant incident or an infringement of this Directive by the essential entity']).
citation(eu_dir_2022_2555_art_32_2_d, [label-'Directive (EU) 2022/2555 Art 32(2)(d) (essential entities: security scans)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj 32022L2555#point_032.002_d', verbatim-'security scans based on objective, non-discriminatory, fair and transparent risk assessment criteria, where necessary with the cooperation of the entity concerned']).
citation(eu_dir_2022_2555_art_32_2_e, [label-'Directive (EU) 2022/2555 Art 32(2)(e) (essential entities: requests for information)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj 32022L2555#point_032.002_e', verbatim-'requests for information necessary to assess the cybersecurity risk-management measures adopted by the entity concerned']).
citation(eu_dir_2022_2555_art_32_2_f, [label-'Directive (EU) 2022/2555 Art 32(2)(f) (essential entities: requests to access data, documents and information)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj 32022L2555#point_032.002_f', verbatim-'requests to access data, documents and information necessary to carry out their supervisory tasks']).
citation(eu_dir_2022_2555_art_32_2_g, [label-'Directive (EU) 2022/2555 Art 32(2)(g) (essential entities: requests for evidence of implementation of cybersecurity policies)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj 32022L2555#point_032.002_g', verbatim-'requests for evidence of implementation of cybersecurity policies, such as the results of security audits carried out by a qualified auditor']).

% ---- Art 32(4): enforcement powers over essential entities -----------
citation(eu_dir_2022_2555_art_32_4_a, [label-'Directive (EU) 2022/2555 Art 32(4)(a) (essential entities: warnings)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj 32022L2555#point_032.004_a', verbatim-'issue warnings about infringements of this Directive by the entities concerned']).
citation(eu_dir_2022_2555_art_32_4_b, [label-'Directive (EU) 2022/2555 Art 32(4)(b) (essential entities: binding instructions or remedy orders)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj 32022L2555#point_032.004_b', verbatim-'adopt binding instructions, including with regard to measures necessary to prevent or remedy an incident']).
citation(eu_dir_2022_2555_art_32_4_c, [label-'Directive (EU) 2022/2555 Art 32(4)(c) (essential entities: cease and desist orders)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj 32022L2555#point_032.004_c', verbatim-'order the entities concerned to cease conduct that infringes this Directive and desist from repeating that conduct']).
citation(eu_dir_2022_2555_art_32_4_d, [label-'Directive (EU) 2022/2555 Art 32(4)(d) (essential entities: orders to comply with Article 21 or Article 23)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj 32022L2555#point_032.004_d', verbatim-'order the entities concerned to ensure that their cybersecurity risk-management measures comply with Article 21 or to fulfil the reporting obligations laid down in Article 23']).
citation(eu_dir_2022_2555_art_32_4_e, [label-'Directive (EU) 2022/2555 Art 32(4)(e) (essential entities: orders to inform potentially affected persons)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj 32022L2555#point_032.004_e', verbatim-'order the entities concerned to inform the natural or legal persons with regard to which they provide services or carry out activities which are potentially affected by a significant cyber threat']).
citation(eu_dir_2022_2555_art_32_4_f, [label-'Directive (EU) 2022/2555 Art 32(4)(f) (essential entities: orders to implement security audit recommendations)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj 32022L2555#point_032.004_f', verbatim-'order the entities concerned to implement the recommendations provided as a result of a security audit within a reasonable deadline']).
citation(eu_dir_2022_2555_art_32_4_g, [label-'Directive (EU) 2022/2555 Art 32(4)(g) (essential entities: monitoring officer)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj 32022L2555#point_032.004_g', verbatim-'designate a monitoring officer with well-defined tasks for a determined period of time to oversee the compliance of the entities concerned with Articles 21 and 23']).
citation(eu_dir_2022_2555_art_32_4_h, [label-'Directive (EU) 2022/2555 Art 32(4)(h) (essential entities: publication orders)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj 32022L2555#point_032.004_h', verbatim-'order the entities concerned to make public aspects of infringements of this Directive in a specified manner']).
citation(eu_dir_2022_2555_art_32_4_i, [label-'Directive (EU) 2022/2555 Art 32(4)(i) (essential entities: administrative fine pursuant to Article 34)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj 32022L2555#point_032.004_i', verbatim-'of an administrative fine pursuant to Article 34 in addition to any of the measures referred to in points (a) to (h) of this paragraph']).

% ---- Art 32(5): escalation powers over essential entities ------------
citation(eu_dir_2022_2555_art_32_5, [label-'Directive (EU) 2022/2555 Art 32(5) (further powers where enforcement measures are ineffective; not applicable to public administration entities)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj 32022L2555#parag_032.005', verbatim-'Where enforcement measures adopted pursuant to paragraph 4, points (a) to (d) and (f), are ineffective']).
citation(eu_dir_2022_2555_art_32_5_a, [label-'Directive (EU) 2022/2555 Art 32(5)(a) (temporary suspension of a certification or authorisation)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj 32022L2555#point_032.005_a', verbatim-'to suspend temporarily a certification or authorisation concerning part or all of the relevant services provided or activities carried out by the essential entity']).
citation(eu_dir_2022_2555_art_32_5_b, [label-'Directive (EU) 2022/2555 Art 32(5)(b) (request for a temporary ban from managerial functions)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj 32022L2555#point_032.005_b', verbatim-'prohibit temporarily any natural person who is responsible for discharging managerial responsibilities at chief executive officer or legal representative level in the essential entity from exercising managerial functions in that entity']).

% ---- Art 33(2): supervisory powers over important entities -----------
citation(eu_dir_2022_2555_art_33_2_a, [label-'Directive (EU) 2022/2555 Art 33(2)(a) (important entities: on-site inspections and off-site ex post supervision)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj 32022L2555#point_033.002_a', verbatim-'on-site inspections and off-site ex post supervision conducted by trained professionals']).
citation(eu_dir_2022_2555_art_33_2_b, [label-'Directive (EU) 2022/2555 Art 33(2)(b) (important entities: targeted security audits)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj 32022L2555#point_033.002_b', verbatim-'targeted security audits carried out by an independent body or a competent authority']).
citation(eu_dir_2022_2555_art_33_2_c, [label-'Directive (EU) 2022/2555 Art 33(2)(c) (important entities: security scans)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj 32022L2555#point_033.002_c', verbatim-'security scans based on objective, non-discriminatory, fair and transparent risk assessment criteria, where necessary with the cooperation of the entity concerned']).
citation(eu_dir_2022_2555_art_33_2_d, [label-'Directive (EU) 2022/2555 Art 33(2)(d) (important entities: requests for information, ex post)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj 32022L2555#point_033.002_d', verbatim-'requests for information necessary to assess, ex post, the cybersecurity risk-management measures adopted by the entity concerned']).
citation(eu_dir_2022_2555_art_33_2_e, [label-'Directive (EU) 2022/2555 Art 33(2)(e) (important entities: requests to access data, documents and information)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj 32022L2555#point_033.002_e', verbatim-'requests to access data, documents and information necessary to carry out their supervisory tasks']).
citation(eu_dir_2022_2555_art_33_2_f, [label-'Directive (EU) 2022/2555 Art 33(2)(f) (important entities: requests for evidence of implementation of cybersecurity policies)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj 32022L2555#point_033.002_f', verbatim-'requests for evidence of implementation of cybersecurity policies, such as the results of security audits carried out by a qualified auditor']).

% ---- Art 33(4): enforcement powers over important entities -----------
citation(eu_dir_2022_2555_art_33_4_a, [label-'Directive (EU) 2022/2555 Art 33(4)(a) (important entities: warnings)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj 32022L2555#point_033.004_a', verbatim-'issue warnings about infringements of this Directive by the entities concerned']).
citation(eu_dir_2022_2555_art_33_4_b, [label-'Directive (EU) 2022/2555 Art 33(4)(b) (important entities: binding instructions or remedy orders)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj 32022L2555#point_033.004_b', verbatim-'adopt binding instructions or an order requiring the entities concerned to remedy the deficiencies identified or the infringement of this Directive']).
citation(eu_dir_2022_2555_art_33_4_c, [label-'Directive (EU) 2022/2555 Art 33(4)(c) (important entities: cease and desist orders)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj 32022L2555#point_033.004_c', verbatim-'order the entities concerned to cease conduct that infringes this Directive and desist from repeating that conduct']).
citation(eu_dir_2022_2555_art_33_4_d, [label-'Directive (EU) 2022/2555 Art 33(4)(d) (important entities: orders to comply with Article 21 or Article 23)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj 32022L2555#point_033.004_d', verbatim-'order the entities concerned to ensure that their cybersecurity risk-management measures comply with Article 21 or to fulfil the reporting obligations laid down in Article 23']).
citation(eu_dir_2022_2555_art_33_4_e, [label-'Directive (EU) 2022/2555 Art 33(4)(e) (important entities: orders to inform potentially affected persons)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj 32022L2555#point_033.004_e', verbatim-'order the entities concerned to inform the natural or legal persons with regard to which they provide services or carry out activities which are potentially affected by a significant cyber threat']).
citation(eu_dir_2022_2555_art_33_4_f, [label-'Directive (EU) 2022/2555 Art 33(4)(f) (important entities: orders to implement security audit recommendations)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj 32022L2555#point_033.004_f', verbatim-'order the entities concerned to implement the recommendations provided as a result of a security audit within a reasonable deadline']).
citation(eu_dir_2022_2555_art_33_4_g, [label-'Directive (EU) 2022/2555 Art 33(4)(g) (important entities: publication orders)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj 32022L2555#point_033.004_g', verbatim-'order the entities concerned to make public aspects of infringements of this Directive in a specified manner']).
citation(eu_dir_2022_2555_art_33_4_h, [label-'Directive (EU) 2022/2555 Art 33(4)(h) (important entities: administrative fine pursuant to Article 34)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj 32022L2555#point_033.004_h', verbatim-'of an administrative fine pursuant to Article 34 in addition to any of the measures referred to in points (a) to (g) of this paragraph']).

% ---- Art 34(4), 34(5): floors of the national maximum fine -----------
citation(eu_dir_2022_2555_art_34_4, [label-'Directive (EU) 2022/2555 Art 34(4) (essential entities: national maximum fine of at least EUR 10 000 000 or 2 % of worldwide turnover, whichever is higher)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj 32022L2555#parag_034.004', verbatim-'of the total worldwide annual turnover in the preceding financial year of the undertaking to which the essential entity belongs, whichever is higher']).
citation(eu_dir_2022_2555_art_34_5, [label-'Directive (EU) 2022/2555 Art 34(5) (important entities: national maximum fine of at least EUR 7 000 000 or 1,4 % of worldwide turnover, whichever is higher)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj 32022L2555#parag_034.005', verbatim-'of the total worldwide annual turnover in the preceding financial year of the undertaking to which the important entity belongs, whichever is higher']).

% ---- Art 35: infringements entailing a personal data breach ----------
citation(eu_dir_2022_2555_art_35_1, [label-'Directive (EU) 2022/2555 Art 35(1) (duty to inform the GDPR supervisory authorities of an infringement that can entail a notifiable personal data breach)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj 32022L2555#parag_035.001', verbatim-'they shall, without undue delay, inform the supervisory authorities as referred to in Article 55 or 56 of that Regulation']).
citation(eu_dir_2022_2555_art_35_2, [label-'Directive (EU) 2022/2555 Art 35(2) (a GDPR Article 58(2)(i) fine for the same conduct bars the Article 34 fine, not the enforcement measures)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj 32022L2555#parag_035.002', verbatim-'the competent authorities shall not impose an administrative fine pursuant to Article 34 of this Directive for an infringement referred to in paragraph 1 of this Article arising from the same conduct']).
citation(eu_dir_2022_2555_art_35_3, [label-'Directive (EU) 2022/2555 Art 35(3) (duty to inform the supervisory authority of the own Member State)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj 32022L2555#parag_035.003', verbatim-'the competent authority shall inform the supervisory authority established in its own Member State of the potential data breach referred to in paragraph 1']).

test(a_recorded_key_is_implemented) :-
    implements(eu_dir_2022_2555_art_34_4).
test(an_unrecorded_key_is_not_implemented, fail) :-
    implements(eu_dir_2022_2555_art_34).

:- end_module(citations).
