% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% kernel.clausal -- the SHARED FLOOR for eu/nis2_supervision_fines (deontic family).
% Source: Directive (EU) 2022/2555 (NIS 2 Directive), Articles 32(2), 32(4),
% 32(5), 33(2), 33(4), 34(4), 34(5) and 35(1) to (3) (OJ L 333, 27.12.2022;
% CELEX 32022L2555). This file decides no statutory condition: it holds the
% typed input check of the order and the PAIRS rule of the order.
%
% DAG root of the determination-slices layout. It holds ONLY the
% PREDICATES that two or more files CALL:
%   nis2_supervision_fines_input_problems/2 -- THE INPUT CHECK (the slice
%       uses it as limb (0) of every query; the facade uses it for the
%       invalid_profile verdict). Written by the scaffold from the typed
%       input contract; kept as written.
%   nis2_supervision_fines_relied_pairs/3 -- THE PAIRS RULE: the Key-Value
%       pairs of the listed judgement keys that are PRESENT in the profile,
%       in the order given (callers pass root_exports order). Plumbing only.
%
% Atoms and data terms need NO declaration and NO import. The block below
% RECORDS the result terms so every file spells them alike.
%
% Result terms of the five contracted queries (built in the slice
% nis2_supervision_fines.clausal):
%   fine_ceiling_floor(Profile, Ceiling, Citations)
%     Ceiling: minimum_national_maximum(AmountEur, Basis) -- AmountEur an
%       integer of whole euros, Basis fixed_amount | turnover_percentage;
%       or no_union_minimum; or a status compound.
%   minimum_powers(Profile, Powers)
%     Powers: ONE list of power(Kind, Measure, cite(Key)) -- Kind
%       supervision | enforcement | escalation; or a status compound alone.
%   escalation_powers_exercisable(Profile, Result, Citations)
%     Result: exercisable | not_exercisable(Reason) -- Reason
%       important_entity | public_administration_entity |
%       measures_not_ineffective | no_deadline_set |
%       action_taken_within_deadline; or a status compound.
%   fine_barred_by_gdpr_fine(Profile, Result, Citations)
%     Result: fine_barred | fine_not_barred | a status compound.
%   data_protection_authority_information(Profile, Duty)
%     Duty: ONE list ([] for no duty) of
%       inform_gdpr_supervisory_authorities(cite(Key)) then, when it applies,
%       inform_supervisory_authority_in_own_member_state(cite(Key));
%       or a status compound alone.
%   Citations: a flat list of cite(Key) terms, [] for a non-final answer.
%
% Status compounds (never written as bare atoms):
%   indeterminate([Key])            -- exactly ONE needed absent key
%   needs_legal_review(open_textured(Key, cite(CitationKey)),
%                      [inputs_relied_on(Pairs)])
%                                   -- Pairs Key-Value, root_exports order
%   input_problems(Problems)        -- Problems from the input check, items
%                                      duplicate_key(Key) | wrong_type(Key) |
%                                      unknown_key(Key)
%
% Facade result term (one per determination slice):
%   nis2_supervision_fines_verdict(Status, Citations)
%     Status: eligible | ineligible | indeterminate | invalid_profile
%     Citations: a list of cite(Key) terms.
% Judgement value besides true and false: unsure.
% =====================================================================

:- module(kernel, [
    nis2_supervision_fines_input_problems/2,
    nis2_supervision_fines_relied_pairs/3
]).

:- use_module(library(reif), [memberd_t/3]).
:- use_module(formalize_lib, [profile_get/3, profile_lacks/2]).

% ---- input checks: the problems a profile has, if any -----------
% nis2_supervision_fines_input_problems(Profile, Problems): Problems = [] means the profile can be
% judged. Written from the order's typed input contract
% (input_contract.types.profile: attribute_list).
% Each public query calls this check first: it gives its normal answer only when
% Problems = [], and when Problems is not [] it gives the answer the order states for
% a profile with input problems.
% It gives exactly one answer for every Profile, and the answer is ground:
% - a Profile that is not an attribute list [attribute(Key, Value), ...] with a ground
%   Key in every item gives [wrong_type(profile)];
% - otherwise, for each contract key in the contract's key order, duplicate_key(Key) when
%   the key occurs more than once in Profile (whatever its values: none of them is read,
%   so it is never also wrong_type(Key)), else wrong_type(Key) when its one value is
%   outside its type; then unknown_key(Key) for each key outside the contract, in the
%   order of its first occurrence in Profile. Each key is named once. An absent key is
%   not a problem.
% Every step is complementary clauses: exactly one clause holds for each input.
nis2_supervision_fines_input_problems(Profile, Problems) :-
    attribute_list_t(Profile, IsAttributeList),
    profile_problems(IsAttributeList, Profile, Problems).

profile_problems(false, _, [wrong_type(profile)]).
profile_problems(true, Profile, Problems) :-
    Keys = [entity_class, infringed_provision, worldwide_annual_turnover_eur, entity_is_public_administration, earlier_measures_ineffective, deadline_set_for_necessary_action, required_action_taken_within_deadline, infringement_may_entail_notifiable_personal_data_breach, authority_became_aware_in_supervision_or_enforcement, data_protection_authority_in_other_member_state, gdpr_fine_imposed_under_art_58_2_i, gdpr_fine_for_same_conduct],
    unknown_keys(Profile, Keys, UnknownKeyProblems),
    key_problems(Keys, Profile, UnknownKeyProblems, Problems).

% The contract: each key and the type of its value.
key_type(entity_class, enum([essential, important])).
key_type(infringed_provision, enum([art_21, art_23, other])).
key_type(worldwide_annual_turnover_eur, non_negative_integer).
key_type(entity_is_public_administration, boolean).
key_type(earlier_measures_ineffective, judgement).
key_type(deadline_set_for_necessary_action, boolean).
key_type(required_action_taken_within_deadline, boolean).
key_type(infringement_may_entail_notifiable_personal_data_breach, judgement).
key_type(authority_became_aware_in_supervision_or_enforcement, boolean).
key_type(data_protection_authority_in_other_member_state, boolean).
key_type(gdpr_fine_imposed_under_art_58_2_i, boolean).
key_type(gdpr_fine_for_same_conduct, judgement).

% attribute_list_t(Term, T): T is true when Term is a list of attribute(Key, Value)
% items, each Key ground; false for anything else, an unbound Term included.
attribute_list_t(Term, false) :-
    var(Term).
attribute_list_t(Term, true) :-
    Term == [].
attribute_list_t(Term, T) :-
    nonvar(Term),
    Term = [Element|Elements],
    attribute_t(Element, ElementIsAttribute),
    attribute_list_t(Elements, ElementsAreAttributes),
    truth_and(ElementIsAttribute, ElementsAreAttributes, T).
attribute_list_t(Term, false) :-
    nonvar(Term),
    Term \== [],
    Term \= [_|_].

attribute_t(Element, false) :-
    var(Element).
attribute_t(Element, T) :-
    nonvar(Element),
    Element = attribute(Key, _),
    term_variables(Key, Variables),
    no_variables_t(Variables, T).
attribute_t(Element, false) :-
    nonvar(Element),
    Element \= attribute(_, _).

no_variables_t([], true).
no_variables_t([_|_], false).

% Unknown keys, in profile order, each once: Known grows by each key named.
unknown_keys([], _, []).
unknown_keys([attribute(Key, _)|Elements], Known, Problems) :-
    memberd_t(Key, Known, IsKnown),
    name_unknown_key(IsKnown, Key, Known, Elements, Problems).

name_unknown_key(true, _, Known, Elements, Problems) :-
    unknown_keys(Elements, Known, Problems).
name_unknown_key(false, Key, Known, Elements, [unknown_key(Key)|Problems]) :-
    unknown_keys(Elements, [Key|Known], Problems).

% Contract keys, in contract order: duplicate_key(Key) when the key occurs more than once
% (none of its values is read), else wrong_type(Key) when its one value is outside the
% key's type. An absent key has no value to check.
key_problems([], _, Problems, Problems).
key_problems([Key|Keys], Profile, LaterProblems, Problems) :-
    key_type(Key, Type),
    key_occurrences(Profile, Key, Occurrences),
    key_problems(Keys, Profile, LaterProblems, KeyProblems),
    name_key_problem(Occurrences, Key, Type, Profile, KeyProblems, Problems).

% key_occurrences(Elements, Key, Occurrences): none, one or many items give Key.
key_occurrences([], _, none).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey == Key,
    key_occurrences(Elements, Key, RestOccurrences),
    one_more_occurrence(RestOccurrences, Occurrences).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey \== Key,
    key_occurrences(Elements, Key, Occurrences).

one_more_occurrence(none, one).
one_more_occurrence(one, many).
one_more_occurrence(many, many).

name_key_problem(none, _, _, _, Problems, Problems).
name_key_problem(many, Key, _, _, Problems, [duplicate_key(Key)|Problems]).
name_key_problem(one, Key, Type, Profile, KeyProblems, Problems) :-
    values_in_type_t(Profile, Key, Type, InType),
    name_wrong_type(InType, Key, KeyProblems, Problems).

name_wrong_type(true, _, Problems, Problems).
name_wrong_type(false, Key, Problems, [wrong_type(Key)|Problems]).

% values_in_type_t(Elements, Key, Type, T): T is true when every value Elements gives Key is
% in Type (true when Elements gives Key none).
values_in_type_t([], _, _, true).
values_in_type_t([attribute(ElementKey, Value)|Elements], Key, Type, T) :-
    ElementKey == Key,
    value_in_type_t(Type, Value, ValueInType),
    values_in_type_t(Elements, Key, Type, RestInType),
    truth_and(ValueInType, RestInType, T).
values_in_type_t([attribute(ElementKey, _)|Elements], Key, Type, T) :-
    ElementKey \== Key,
    values_in_type_t(Elements, Key, Type, T).

% A value with an unbound part is outside every type; a ground one is checked.
value_in_type_t(Type, Value, T) :-
    term_variables(Value, Variables),
    ground_value_in_type_t(Variables, Type, Value, T).

ground_value_in_type_t([_|_], _, _, false).
ground_value_in_type_t([], Type, Value, T) :-
    in_type_t(Type, Value, T).

% in_type_t(Type, Value, T): one clause per type, for a ground Value.
in_type_t(judgement, Value, T) :-
    in_type_t(one_of([boolean, enum([unsure])]), Value, T).

in_type_t(boolean, Value, T) :-
    memberd_t(Value, [true, false], T).

in_type_t(enum(Values), Value, T) :-
    memberd_t(Value, Values, T).

in_type_t(one_of(Types), Value, T) :-
    in_some_type_t(Types, Value, T).

in_type_t(non_negative_integer, Value, T) :-
    non_negative_integer_t(Value, T).

truth_and(true, T, T).
truth_and(false, _, false).

% in_some_type_t(Types, Value, T): T is true when Value is in at least one of Types.
in_some_type_t([], _, false).
in_some_type_t([Type|Types], Value, T) :-
    in_type_t(Type, Value, InType),
    in_some_type_t(Types, Value, InAnother),
    truth_or(InType, InAnother, T).

truth_or(true, _, true).
truth_or(false, T, T).

% integer_t(Value, T): for a ground Value, T is true when it is an integer and false when it is a
% float, an atom or a compound term.
integer_t(Value, true) :-
    integer(Value).
integer_t(Value, false) :-
    float(Value).
integer_t(Value, false) :-
    atom(Value).
integer_t(Value, false) :-
    compound(Value).

% non_negative_integer_t(Value, T): for a ground Value, T is true when it is an integer of 0 or
% more.
non_negative_integer_t(Value, T) :-
    integer_t(Value, IsInteger),
    not_below_zero_t(IsInteger, Value, T).

not_below_zero_t(false, _, false).
not_below_zero_t(true, Value, true) :-
    Value >= 0.
not_below_zero_t(true, Value, false) :-
    Value < 0.

% ---- THE PAIRS RULE (plumbing; decides nothing statutory) ---------
% nis2_supervision_fines_relied_pairs(Profile, JudgementKeys, Pairs): Pairs are the
% Key-Value pairs of the JudgementKeys that are PRESENT in Profile, in the order of
% JudgementKeys (callers pass them in root_exports order), unsure values included.
% Called only on a profile the input check passed, so each present key has one value.
nis2_supervision_fines_relied_pairs(_, [], []).
nis2_supervision_fines_relied_pairs(Profile, [Key|Keys], [Key-Value|Pairs]) :-
    profile_get(Profile, Key, Value),
    nis2_supervision_fines_relied_pairs(Profile, Keys, Pairs).
nis2_supervision_fines_relied_pairs(Profile, [Key|Keys], Pairs) :-
    profile_lacks(Profile, Key),
    nis2_supervision_fines_relied_pairs(Profile, Keys, Pairs).

% ---- tests -----------------------------------------------------------
test(a_well_formed_profile_has_no_problem) :-
    nis2_supervision_fines_input_problems([attribute(entity_class, essential), attribute(earlier_measures_ineffective, unsure)], []).
test(the_empty_profile_has_no_problem) :-
    nis2_supervision_fines_input_problems([], []).
test(a_repeated_key_is_a_duplicate_only) :-
    nis2_supervision_fines_input_problems([attribute(entity_class, essential), attribute(entity_class, wrong)], [duplicate_key(entity_class)]).
test(a_crisp_key_given_unsure_is_wrong_type) :-
    nis2_supervision_fines_input_problems([attribute(entity_is_public_administration, unsure)], [wrong_type(entity_is_public_administration)]).
test(a_negative_turnover_is_wrong_type) :-
    nis2_supervision_fines_input_problems([attribute(worldwide_annual_turnover_eur, -1)], [wrong_type(worldwide_annual_turnover_eur)]).
test(an_unknown_key_is_named_once) :-
    nis2_supervision_fines_input_problems([attribute(foo, 1), attribute(foo, 2)], [unknown_key(foo)]).
test(contract_problems_come_before_unknown_keys) :-
    nis2_supervision_fines_input_problems([attribute(foo, 1), attribute(gdpr_fine_for_same_conduct, maybe), attribute(entity_class, big)], [wrong_type(entity_class), wrong_type(gdpr_fine_for_same_conduct), unknown_key(foo)]).
test(a_non_list_is_not_a_profile) :-
    nis2_supervision_fines_input_problems(not_a_list, [wrong_type(profile)]).
test(a_list_with_a_bare_atom_is_not_a_profile) :-
    nis2_supervision_fines_input_problems([attribute(entity_class, essential), stray], [wrong_type(profile)]).
test(pairs_follow_the_given_key_order) :-
    nis2_supervision_fines_relied_pairs([attribute(gdpr_fine_for_same_conduct, unsure), attribute(infringement_may_entail_notifiable_personal_data_breach, true)], [infringement_may_entail_notifiable_personal_data_breach, gdpr_fine_for_same_conduct], [infringement_may_entail_notifiable_personal_data_breach-true, gdpr_fine_for_same_conduct-unsure]).
test(pairs_skip_an_absent_key) :-
    nis2_supervision_fines_relied_pairs([attribute(earlier_measures_ineffective, unsure)], [infringement_may_entail_notifiable_personal_data_breach, earlier_measures_ineffective], [earlier_measures_ineffective-unsure]).

:- end_module(kernel).
