% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% queries.clausal -- QUERY-COMBINATOR layer for eu/nis2_governance_risk_measures.
% A TOP-LAYER consumer: it imports the determination slices' PUBLIC
% predicates it calls, and nothing else.
%
% nis2_governance_risk_measures_what_if/4      (#16 what-if): override one key -> re-evaluate
% nis2_governance_risk_measures_profile_keys/1: top-level profile key schema
% nis2_governance_risk_measures_input_problems/2: the problems a profile has ([] = none)
%
% The eligibility verdict (#2) and the cited checklist (#7 justification) are
% served by the slice predicates nis2_governance_risk_measures_status/2,
% decide_nis2_governance_risk_measures/2 and nis2_governance_risk_measures_checklist/2,
% re-exposed by the package facade.
% The profile is an attribute list, so the what-if override is written over
% attribute(Key, Value) elements.
% =====================================================================

:- module(queries, [
    nis2_governance_risk_measures_profile_keys/1,
    nis2_governance_risk_measures_input_problems/2,
    nis2_governance_risk_measures_what_if/4
]).

:- use_module(eu/nis2_governance_risk_measures/kernel, [nis2_governance_risk_measures_input_problems/2]).
:- use_module(eu/nis2_governance_risk_measures/nis2_governance_risk_measures, [nis2_governance_risk_measures_status/2]).

% schema of top-level profile keys: the keys of the order's typed input contract, in its order
nis2_governance_risk_measures_profile_keys([entity_class, multi_factor_authentication_and_secured_communications_appropriate, relevant_european_or_international_standards_apply, coordinated_supply_chain_risk_assessment_carried_out, non_compliance_with_the_art_21_2_measures_found]).

% #16 what-if: re-evaluate with one key hypothetically overridden
nis2_governance_risk_measures_what_if(Profile, OverriddenKey, NewValue, NewStatus) :-
    override_attribute(Profile, OverriddenKey, NewValue, Hypothesis),
    nis2_governance_risk_measures_status(Hypothesis, NewStatus).

% override_attribute(Profile, Key, Value, NewProfile): every item for Key is dropped
% and one attribute(Key, Value) is appended.
override_attribute(Profile, Key, Value, NewProfile) :-
    drop_attribute(Profile, Key, Kept),
    append(Kept, [attribute(Key, Value)], NewProfile).

drop_attribute([], _, []).
drop_attribute([attribute(ElementKey, _)|Elements], Key, Kept) :-
    ElementKey == Key,
    drop_attribute(Elements, Key, Kept).
drop_attribute([attribute(ElementKey, ElementValue)|Elements], Key, [attribute(ElementKey, ElementValue)|Kept]) :-
    ElementKey \== Key,
    drop_attribute(Elements, Key, Kept).
drop_attribute([Element|Elements], Key, [Element|Kept]) :-
    Element \= attribute(_, _),
    drop_attribute(Elements, Key, Kept).

:- end_module(queries).
