% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_result_constructors.clausal -- the provenance/2 result constructor.
% provenance/2 is DATA (a term constructor), not a procedure, so it is built
% and destructured here, never called as a goal.
% Run: python -m clausal.testing eu/nis2_governance_risk_measures/tests/test_result_constructors.clausal
% =====================================================================
:- module(test_result_constructors, []).
:- use_module(eu/nis2_governance_risk_measures, [
    risk_management_measures/2
]).

test(provenance_term_holds_a_clause_and_its_citations) :-
    Term = provenance(point_j_unsure, [cite(eu_dir_2022_2555_art_21_2_j)]),
    Term = provenance(Clause, Citations),
    Clause == point_j_unsure,
    Citations == [cite(eu_dir_2022_2555_art_21_2_j)].

test(provenance_binds_its_two_arguments) :-
    Term = provenance(Clause, Citations),
    Term = provenance(point_j_unsure, [cite(eu_dir_2022_2555_art_21_2_j)]),
    Clause == point_j_unsure,
    Citations == [cite(eu_dir_2022_2555_art_21_2_j)].

test(provenance_with_empty_citations_destructures) :-
    Term = provenance(deciding_clause, []),
    Term = provenance(deciding_clause, Citations),
    Citations == [].

test(provenance_may_trail_the_pairs_of_a_referral) :-
    risk_management_measures(
        [attribute(entity_class, important_entity),
         attribute(multi_factor_authentication_and_secured_communications_appropriate, unsure)],
        needs_legal_review(open_textured(_, _), [inputs_relied_on(Pairs)|_Provenance])),
    Pairs == [multi_factor_authentication_and_secured_communications_appropriate-unsure].

:- end_module(test_result_constructors).
