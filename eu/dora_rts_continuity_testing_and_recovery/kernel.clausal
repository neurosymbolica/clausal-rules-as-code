% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% kernel.clausal -- the SHARED FLOOR for eu/dora_rts_continuity_testing_and_recovery (deontic family).
% DAG root of the determination-slices layout. It holds ONLY the
% PREDICATES that two or more files CALL.
%
% Source: Commission Delegated Regulation (EU) 2024/1774 (the RTS on ICT
% risk management tools, methods, processes and policies), Articles 25
% (testing of the ICT business continuity plans) and 26 (ICT response and
% recovery plans), pinned text 32024R1774; Regulation (EU) 2022/2554
% (DORA), Article 16(1), first subparagraph (the entities to which
% Articles 5 to 15 of DORA do not apply), pinned text 32022R2554.
% The input check below formalises no provision: it is the order's typed
% input contract (INTERFACE - THE INPUT CHECK), so it carries no marker.
%
% The ONE shared predicate is the order's input check
% dora_rts_continuity_testing_and_recovery_input_problems/2, written here by
% the scaffold from the typed input contract. The slice
% dora_rts_continuity_testing_and_recovery.clausal, queries.clausal (which
% re-exports it), the package facade and the fixtures all call it, and
% import it by its full path:
%   :- use_module(eu/dora_rts_continuity_testing_and_recovery/kernel,
%                 [dora_rts_continuity_testing_and_recovery_input_problems/2]).
% Everything else (the duty table, the condition states, the key-naming
% steps, the referral rows, the fixed citations) has ONE caller, the slice,
% and lives there.
%
% deontic family: each of the twenty-three duties of RTS Articles 25 and 26
% is an obligation whose application turns on at most one condition, and
% whose performance is one caller judgement (true, false or unsure).
%
% Atoms and data terms need NO declaration and NO import. This block only
% RECORDS the result terms so every file spells them alike.
%
% Slice result term (the scaffold's verdict term):
%   dora_rts_continuity_testing_and_recovery_verdict(Status, Citations)
%     Status    -- the RESULT of rts_continuity_testing_and_recovery_duties_complete/3:
%                  complete | incomplete | simplified_framework_entity
%                  | indeterminate([Key]) | needs_legal_review(Reason, Context)
%                  | input_problems(Problems)
%     Citations -- a list of cite(Key) terms ([] for every status compound).
%
% Query results (each query yields exactly ONE solution):
%   rts_continuity_testing_and_recovery_duties_required/3:
%     required(Duties)               -- Duties a non-empty list of duty atoms
%                                       in DUTY ORDER; Citations the paragraph
%                                       key of each listed duty, once each.
%     simplified_framework_entity    -- Citations [cite(eu_reg_2022_2554_art_16_1)].
%   rts_continuity_testing_and_recovery_duties_complete/3:
%     complete | incomplete          -- Citations THE FIXED CITATIONS (the nine
%                                       paragraph keys Art 25(1)-(5), 26(1)-(4)).
%     simplified_framework_entity    -- as above.
%   rts_continuity_testing_and_recovery_duties_outstanding/3:
%     none_outstanding               -- Citations THE FIXED CITATIONS.
%     outstanding(Duties)            -- Duties non-empty, in DUTY ORDER;
%                                       Citations each outstanding duty's own
%                                       citation keys, once each.
%     simplified_framework_entity    -- as above.
%
% Status compounds (never final, Citations always []; the bare atom
% indeterminate is NEVER written):
%   indeterminate([Key])             -- exactly one bare missing key atom.
%   needs_legal_review(open_textured(Key, cite(CitationKey)),
%                      [inputs_relied_on(Pairs)])
%                                    -- Key the unsure judgement key,
%                                       CitationKey its referral citation (the
%                                       duty's first citation); Pairs every
%                                       Key-Value present in the profile, in
%                                       root_exports order; an unscored
%                                       provenance(Clause, Citations) may follow.
%   input_problems(Problems)         -- Problems from this kernel's input check:
%                                       duplicate_key(Key), wrong_type(Key),
%                                       unknown_key(Key), or [wrong_type(profile)].
% =====================================================================

:- module(kernel, [dora_rts_continuity_testing_and_recovery_input_problems/2]).

:- use_module(library(reif), [memberd_t/3]).

% ---- input checks: the problems a profile has, if any -----------
% dora_rts_continuity_testing_and_recovery_input_problems(Profile, Problems): Problems = [] means the profile can be
% judged. Written from the order's typed input contract
% (input_contract.types.profile: attribute_list).
% Each public query calls this check first: it gives its normal answer only when
% Problems = [], and when Problems is not [] it gives the answer the order states for
% a profile with input problems.
% It gives exactly one answer for every Profile, and the answer is ground except for a
% Key named as given:
% - a Profile that is not an attribute list [attribute(Key, Value), ...] gives [wrong_type(profile)]:
%   an unbound Profile, a partial list, a list holding an unbound item or an item that is
%   not attribute(_, _);
% - a Key that is not an atom (a number, a string, a compound term, an unbound variable)
%   is a key outside the contract: unknown_key(Key), Key as given;
% - otherwise, for each contract key in the contract's key order, duplicate_key(Key) when
%   the key occurs more than once in Profile (whatever its values: none of them is read,
%   so it is never also wrong_type(Key)), else wrong_type(Key) when its one value is
%   outside its type; then unknown_key(Key) for each key outside the contract, in the
%   order of its first occurrence in Profile. Each key is named once. An absent key is
%   not a problem.
% Every step is complementary clauses: exactly one clause holds for each input.
dora_rts_continuity_testing_and_recovery_input_problems(Profile, Problems) :-
    attribute_list_t(Profile, IsAttributeList),
    profile_problems(IsAttributeList, Profile, Problems).

profile_problems(false, _, [wrong_type(profile)]).
profile_problems(true, Profile, Problems) :-
    Keys = [financial_entity_is_article_16_1_entity, financial_entity_is_microenterprise, dora_entity_type, financial_entity_uses_ict_services_of_ict_third_party_service_providers, continuity_testing_takes_into_account_business_impact_analysis_and_ict_risk_assessment, continuity_testing_assesses_continuity_of_critical_or_important_functions, continuity_testing_based_on_scenarios_including_severe_but_plausible_scenarios, continuity_testing_contains_testing_of_ict_services_of_ict_third_party_service_providers, continuity_testing_contains_switchover_scenarios, continuity_testing_challenges_assumptions_of_business_continuity_plans, continuity_testing_contains_procedures_to_verify_ability_to_respond, continuity_testing_involves_clearing_members_external_providers_and_interdependent_institutions, continuity_testing_involves_users_utilities_market_infrastructures_and_interdependent_institutions, continuity_test_results_documented, continuity_test_deficiencies_analysed_addressed_and_reported_to_management_body, response_and_recovery_plans_take_into_account_business_impact_analysis, response_and_recovery_plans_specify_activation_and_deactivation_conditions_and_exceptions, response_and_recovery_plans_describe_actions_for_ict_systems_and_services_supporting_critical_or_important_functions, response_and_recovery_plans_designed_to_meet_recovery_objectives, response_and_recovery_plans_documented_available_and_accessible_with_roles_and_responsibilities, response_and_recovery_plans_provide_short_term_and_long_term_recovery_options, response_and_recovery_plans_lay_down_objectives_and_conditions_of_successful_execution, response_and_recovery_plans_identify_relevant_scenarios, response_and_recovery_plans_develop_scenarios_on_current_threat_information_and_lessons_learned, listed_disruption_scenarios_duly_taken_into_account, response_and_recovery_plans_consider_alternative_options_where_primary_recovery_measures_may_not_be_feasible, continuity_measures_for_ict_third_party_service_provider_failures_considered_and_implemented],
    unknown_keys(Profile, Keys, UnknownKeyProblems),
    key_problems(Keys, Profile, UnknownKeyProblems, Problems).

% The contract: each key and the type of its value.
key_type(financial_entity_is_article_16_1_entity, fact).
key_type(financial_entity_is_microenterprise, fact).
key_type(dora_entity_type, entity_type).
key_type(financial_entity_uses_ict_services_of_ict_third_party_service_providers, fact).
key_type(continuity_testing_takes_into_account_business_impact_analysis_and_ict_risk_assessment, judgement).
key_type(continuity_testing_assesses_continuity_of_critical_or_important_functions, judgement).
key_type(continuity_testing_based_on_scenarios_including_severe_but_plausible_scenarios, judgement).
key_type(continuity_testing_contains_testing_of_ict_services_of_ict_third_party_service_providers, judgement).
key_type(continuity_testing_contains_switchover_scenarios, judgement).
key_type(continuity_testing_challenges_assumptions_of_business_continuity_plans, judgement).
key_type(continuity_testing_contains_procedures_to_verify_ability_to_respond, judgement).
key_type(continuity_testing_involves_clearing_members_external_providers_and_interdependent_institutions, judgement).
key_type(continuity_testing_involves_users_utilities_market_infrastructures_and_interdependent_institutions, judgement).
key_type(continuity_test_results_documented, judgement).
key_type(continuity_test_deficiencies_analysed_addressed_and_reported_to_management_body, judgement).
key_type(response_and_recovery_plans_take_into_account_business_impact_analysis, judgement).
key_type(response_and_recovery_plans_specify_activation_and_deactivation_conditions_and_exceptions, judgement).
key_type(response_and_recovery_plans_describe_actions_for_ict_systems_and_services_supporting_critical_or_important_functions, judgement).
key_type(response_and_recovery_plans_designed_to_meet_recovery_objectives, judgement).
key_type(response_and_recovery_plans_documented_available_and_accessible_with_roles_and_responsibilities, judgement).
key_type(response_and_recovery_plans_provide_short_term_and_long_term_recovery_options, judgement).
key_type(response_and_recovery_plans_lay_down_objectives_and_conditions_of_successful_execution, judgement).
key_type(response_and_recovery_plans_identify_relevant_scenarios, judgement).
key_type(response_and_recovery_plans_develop_scenarios_on_current_threat_information_and_lessons_learned, judgement).
key_type(listed_disruption_scenarios_duly_taken_into_account, judgement).
key_type(response_and_recovery_plans_consider_alternative_options_where_primary_recovery_measures_may_not_be_feasible, judgement).
key_type(continuity_measures_for_ict_third_party_service_provider_failures_considered_and_implemented, judgement).

% attribute_list_t(Term, T): T is true when Term is a list of attribute(Key, Value)
% items, whatever each Key is; false for anything else, an unbound Term or item included.
attribute_list_t(Term, false) :-
    var(Term).
attribute_list_t(Term, true) :-
    Term == [].
attribute_list_t(Term, T) :-
    nonvar(Term),
    Term = [Element|Elements],
    attribute_t(Element, ElementIsAttribute),
    attribute_list_t(Elements, ElementsAreAttributes),
    truth_and(ElementIsAttribute, ElementsAreAttributes, T).
attribute_list_t(Term, false) :-
    nonvar(Term),
    Term \== [],
    Term \= [_|_].

attribute_t(Element, false) :-
    var(Element).
attribute_t(Element, true) :-
    nonvar(Element),
    Element = attribute(_, _).
attribute_t(Element, false) :-
    nonvar(Element),
    Element \= attribute(_, _).

% Unknown keys, in profile order, each once: Known grows by each key named. A key is
% known when it is identical (==) to one in Known, so an unbound Key is never bound:
% the same variable twice is one unknown key, two different variables are two.
unknown_keys([], _, []).
unknown_keys([attribute(Key, _)|Elements], Known, Problems) :-
    known_t(Key, Known, IsKnown),
    name_unknown_key(IsKnown, Key, Known, Elements, Problems).

known_t(_, [], false).
known_t(Key, [Known|_], true) :-
    Known == Key.
known_t(Key, [Known|Knowns], T) :-
    Known \== Key,
    known_t(Key, Knowns, T).

name_unknown_key(true, _, Known, Elements, Problems) :-
    unknown_keys(Elements, Known, Problems).
name_unknown_key(false, Key, Known, Elements, [unknown_key(Key)|Problems]) :-
    unknown_keys(Elements, [Key|Known], Problems).

% Contract keys, in contract order: duplicate_key(Key) when the key occurs more than once
% (none of its values is read), else wrong_type(Key) when its one value is outside the
% key's type. An absent key has no value to check.
key_problems([], _, Problems, Problems).
key_problems([Key|Keys], Profile, LaterProblems, Problems) :-
    key_type(Key, Type),
    key_occurrences(Profile, Key, Occurrences),
    key_problems(Keys, Profile, LaterProblems, KeyProblems),
    name_key_problem(Occurrences, Key, Type, Profile, KeyProblems, Problems).

% key_occurrences(Elements, Key, Occurrences): none, one or many items give Key.
key_occurrences([], _, none).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey == Key,
    key_occurrences(Elements, Key, RestOccurrences),
    one_more_occurrence(RestOccurrences, Occurrences).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey \== Key,
    key_occurrences(Elements, Key, Occurrences).

one_more_occurrence(none, one).
one_more_occurrence(one, many).
one_more_occurrence(many, many).

name_key_problem(none, _, _, _, Problems, Problems).
name_key_problem(many, Key, _, _, Problems, [duplicate_key(Key)|Problems]).
name_key_problem(one, Key, Type, Profile, KeyProblems, Problems) :-
    values_in_type_t(Profile, Key, Type, InType),
    name_wrong_type(InType, Key, KeyProblems, Problems).

name_wrong_type(true, _, Problems, Problems).
name_wrong_type(false, Key, Problems, [wrong_type(Key)|Problems]).

% values_in_type_t(Elements, Key, Type, T): T is true when every value Elements gives Key is
% in Type (true when Elements gives Key none).
values_in_type_t([], _, _, true).
values_in_type_t([attribute(ElementKey, Value)|Elements], Key, Type, T) :-
    ElementKey == Key,
    value_in_type_t(Type, Value, ValueInType),
    values_in_type_t(Elements, Key, Type, RestInType),
    truth_and(ValueInType, RestInType, T).
values_in_type_t([attribute(ElementKey, _)|Elements], Key, Type, T) :-
    ElementKey \== Key,
    values_in_type_t(Elements, Key, Type, T).

% A value with an unbound part is outside every type; a ground one is checked.
value_in_type_t(Type, Value, T) :-
    term_variables(Value, Variables),
    ground_value_in_type_t(Variables, Type, Value, T).

ground_value_in_type_t([_|_], _, _, false).
ground_value_in_type_t([], Type, Value, T) :-
    in_type_t(Type, Value, T).

% in_type_t(Type, Value, T): one clause per type, for a ground Value.
in_type_t(fact, Value, T) :-
    in_type_t(boolean, Value, T).

in_type_t(entity_type, Value, T) :-
    in_type_t(enum([credit_institution, institution_exempted_pursuant_to_directive_2013_36, payment_institution, exempted_payment_institution, account_information_service_provider, electronic_money_institution, exempted_electronic_money_institution, investment_firm, crypto_asset_service_provider, issuer_of_asset_referenced_tokens, central_securities_depository, central_counterparty, trading_venue, trade_repository, manager_of_alternative_investment_funds, management_company, data_reporting_service_provider, insurance_undertaking, reinsurance_undertaking, insurance_intermediary, reinsurance_intermediary, ancillary_insurance_intermediary, institution_for_occupational_retirement_provision, credit_rating_agency, administrator_of_critical_benchmarks, crowdfunding_service_provider, securitisation_repository, ict_third_party_service_provider, none_of_the_listed_types]), Value, T).

in_type_t(judgement, Value, T) :-
    in_type_t(one_of([boolean, enum([unsure])]), Value, T).

in_type_t(boolean, Value, T) :-
    memberd_t(Value, [true, false], T).

in_type_t(enum(Values), Value, T) :-
    memberd_t(Value, Values, T).

in_type_t(one_of(Types), Value, T) :-
    in_some_type_t(Types, Value, T).

truth_and(true, T, T).
truth_and(false, _, false).

% in_some_type_t(Types, Value, T): T is true when Value is in at least one of Types.
in_some_type_t([], _, false).
in_some_type_t([Type|Types], Value, T) :-
    in_type_t(Type, Value, InType),
    in_some_type_t(Types, Value, InAnother),
    truth_or(InType, InAnother, T).

truth_or(true, _, true).
truth_or(false, T, T).

:- end_module(kernel).
