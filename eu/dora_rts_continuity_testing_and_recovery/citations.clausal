% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/dora_rts_continuity_testing_and_recovery.
%
% Instruments (pinned texts, the original OJ texts as published; pin folder
% eu/dora_rts_continuity_testing_and_recovery/sources/):
%   - Commission Delegated Regulation (EU) 2024/1774 of 13 March 2024 (the
%     RTS on ICT risk management tools, methods, processes and policies),
%     CELEX 32024R1774: Article 25 (testing of the ICT business continuity
%     plans) and Article 26 (ICT response and recovery plans).
%   - Regulation (EU) 2022/2554 (DORA), CELEX 32022R2554, OJ L 333,
%     27.12.2022, p. 1: Article 16(1), first subparagraph (the gate).
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order. Each
% verbatim is an exact substring of the pinned unit text the order quotes
% (each yaml entry is status: verified).
%
% Keys are the canonical lexicon keys (_lexicon/citations.yaml); no other
% spelling is ever returned. The paragraph keys carry the duties of their
% lead sentences; the point keys carry the duties of their points (the
% duty's own key is its first citation, THE LIMBS).
%
% PROVENANCE: implements(Key) succeeds for every recorded key and fails for
% any other, so a misspelt marker makes its clause fail instead of lying.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

implements(Key) :-
    citation(Key, _).

% ---- Regulation (EU) 2022/2554 (DORA) -------------------------------

citation(eu_reg_2022_2554_art_16_1, [label-'Regulation (EU) 2022/2554 (DORA) Art 16(1), first subparagraph (entities to which Articles 5 to 15 do not apply)', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj (CELEX 32022R2554, unit parag_016.001)', verbatim-'Articles 5 to 15 of this Regulation shall not apply to small and non-interconnected investment firms, payment institutions exempted pursuant to Directive (EU) 2015/2366']).

% ---- Delegated Regulation (EU) 2024/1774, Article 25 ----------------

citation(eu_reg_2024_1774_art_25_1, [label-'Delegated Regulation (EU) 2024/1774 Art 25(1) (testing takes into account the business impact analysis and the ICT risk assessment)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj (CELEX 32024R1774, unit parag_025.001)', verbatim-'When testing the ICT business continuity plans in accordance with Article 11(6), of Regulation (EU) 2022/2554, financial entities shall take into account']).

citation(eu_reg_2024_1774_art_25_2, [label-'Delegated Regulation (EU) 2024/1774 Art 25(2), first sentence and closing sentences (testing assesses continuity of critical or important functions)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj (CELEX 32024R1774, unit parag_025.002)', verbatim-'Financial entities shall assess through the testing of their ICT business continuity plans referred to in paragraph 1 whether they are able to ensure the continuity of the financial entity']).

citation(eu_reg_2024_1774_art_25_2_a, [label-'Delegated Regulation (EU) 2024/1774 Art 25(2), point (a) (test scenarios including severe but plausible scenarios)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj (CELEX 32024R1774, unit point_025.002_a)', verbatim-'be performed on the basis of test scenarios that simulate potential disruptions, including an adequate set of severe but plausible scenarios']).

citation(eu_reg_2024_1774_art_25_2_b, [label-'Delegated Regulation (EU) 2024/1774 Art 25(2), point (b) (testing of ICT services of ICT third-party service providers)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj (CELEX 32024R1774, unit point_025.002_b)', verbatim-'contain the testing of ICT services provided by ICT third-party service providers, where applicable']).

citation(eu_reg_2024_1774_art_25_2_c, [label-'Delegated Regulation (EU) 2024/1774 Art 25(2), point (c) (switchover scenarios, entities other than microenterprises)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj (CELEX 32024R1774, unit point_025.002_c)', verbatim-'contain scenarios of switchover from primary ICT infrastructure to the redundant capacity, backups and redundant facilities']).

citation(eu_reg_2024_1774_art_25_2_d, [label-'Delegated Regulation (EU) 2024/1774 Art 25(2), point (d) (challenge the assumptions of the business continuity plans)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj (CELEX 32024R1774, unit point_025.002_d)', verbatim-'be designed to challenge the assumptions on which the business continuity plans are based, including governance arrangements and crisis communication plans']).

citation(eu_reg_2024_1774_art_25_2_e, [label-'Delegated Regulation (EU) 2024/1774 Art 25(2), point (e) (procedures to verify the ability to respond)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj (CELEX 32024R1774, unit point_025.002_e)', verbatim-'contain procedures to verify the ability of the financial entities']).

citation(eu_reg_2024_1774_art_25_3, [label-'Delegated Regulation (EU) 2024/1774 Art 25(3), lead words (central counterparties involve parties in the testing)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj (CELEX 32024R1774, unit parag_025.003)', verbatim-'In addition to the requirements referred to in paragraph 2, central counterparties shall involve in the testing of their ICT business continuity plans referred to in paragraph 1']).

citation(eu_reg_2024_1774_art_25_3_a, [label-'Delegated Regulation (EU) 2024/1774 Art 25(3), point (a) (clearing members)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj (CELEX 32024R1774, unit point_025.003_a)', verbatim-'clearing members']).

citation(eu_reg_2024_1774_art_25_3_b, [label-'Delegated Regulation (EU) 2024/1774 Art 25(3), point (b) (external providers)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj (CELEX 32024R1774, unit point_025.003_b)', verbatim-'external providers']).

citation(eu_reg_2024_1774_art_25_3_c, [label-'Delegated Regulation (EU) 2024/1774 Art 25(3), point (c) (interdependent institutions in the financial infrastructure)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj (CELEX 32024R1774, unit point_025.003_c)', verbatim-'relevant institutions in the financial infrastructure with which central counterparties have identified interdependencies in their business continuity policies']).

citation(eu_reg_2024_1774_art_25_4, [label-'Delegated Regulation (EU) 2024/1774 Art 25(4), lead words (central securities depositories involve parties in the testing, as appropriate)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj (CELEX 32024R1774, unit parag_025.004)', verbatim-'central securities depositories shall involve in the testing of their ICT business continuity plans referred to in paragraph 1, as appropriate']).

citation(eu_reg_2024_1774_art_25_4_a, [label-'Delegated Regulation (EU) 2024/1774 Art 25(4), point (a) (users of the central securities depositories)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj (CELEX 32024R1774, unit point_025.004_a)', verbatim-'users of the central securities depositories']).

citation(eu_reg_2024_1774_art_25_4_b, [label-'Delegated Regulation (EU) 2024/1774 Art 25(4), point (b) (critical utilities and critical service providers)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj (CELEX 32024R1774, unit point_025.004_b)', verbatim-'critical utilities and critical service providers']).

citation(eu_reg_2024_1774_art_25_4_c, [label-'Delegated Regulation (EU) 2024/1774 Art 25(4), point (c) (other central securities depositories)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj (CELEX 32024R1774, unit point_025.004_c)', verbatim-'other central securities depositories']).

citation(eu_reg_2024_1774_art_25_4_d, [label-'Delegated Regulation (EU) 2024/1774 Art 25(4), point (d) (other market infrastructures)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj (CELEX 32024R1774, unit point_025.004_d)', verbatim-'other market infrastructures']).

citation(eu_reg_2024_1774_art_25_4_e, [label-'Delegated Regulation (EU) 2024/1774 Art 25(4), point (e) (other interdependent institutions)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj (CELEX 32024R1774, unit point_025.004_e)', verbatim-'any other institutions with which central securities depositories have identified interdependencies in their business continuity policy']).

citation(eu_reg_2024_1774_art_25_5, [label-'Delegated Regulation (EU) 2024/1774 Art 25(5) (test results documented; deficiencies analysed, addressed and reported to the management body)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj (CELEX 32024R1774, unit parag_025.005)', verbatim-'Any identified deficiencies resulting from that testing shall be analysed, addressed, and reported to the management body']).

% ---- Delegated Regulation (EU) 2024/1774, Article 26 ----------------

citation(eu_reg_2024_1774_art_26_1, [label-'Delegated Regulation (EU) 2024/1774 Art 26(1), first sentence and closing sentence (plans take into account the business impact analysis)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj (CELEX 32024R1774, unit parag_026.001)', verbatim-'When developing the ICT response and recovery plans referred to in Article 11(3) of Regulation (EU) 2022/2554, financial entities shall take into account the results of the financial entity']).

citation(eu_reg_2024_1774_art_26_1_a, [label-'Delegated Regulation (EU) 2024/1774 Art 26(1), point (a) (activation and deactivation conditions and exceptions)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj (CELEX 32024R1774, unit point_026.001_a)', verbatim-'specify the conditions prompting their activation or deactivation, and any exceptions for such activation or deactivation']).

citation(eu_reg_2024_1774_art_26_1_b, [label-'Delegated Regulation (EU) 2024/1774 Art 26(1), point (b) (actions for ICT systems and services supporting critical or important functions)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj (CELEX 32024R1774, unit point_026.001_b)', verbatim-'describe what actions are to be taken to ensure the availability, integrity, continuity, and recovery of at least ICT systems and services supporting critical or important functions of the financial entity']).

citation(eu_reg_2024_1774_art_26_1_c, [label-'Delegated Regulation (EU) 2024/1774 Art 26(1), point (c) (designed to meet the recovery objectives)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj (CELEX 32024R1774, unit point_026.001_c)', verbatim-'be designed to meet the recovery objectives of the operations of the financial entities']).

citation(eu_reg_2024_1774_art_26_1_d, [label-'Delegated Regulation (EU) 2024/1774 Art 26(1), point (d) (documented, available and readily accessible)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj (CELEX 32024R1774, unit point_026.001_d)', verbatim-'be documented and made available to the staff involved in the execution of ICT response and recovery plans and be readily accessible in case of emergency']).

citation(eu_reg_2024_1774_art_26_1_e, [label-'Delegated Regulation (EU) 2024/1774 Art 26(1), point (e) (short-term and long-term recovery options)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj (CELEX 32024R1774, unit point_026.001_e)', verbatim-'provide for both short-term and long-term recovery options, including partial systems recovery']).

citation(eu_reg_2024_1774_art_26_1_f, [label-'Delegated Regulation (EU) 2024/1774 Art 26(1), point (f) (objectives and conditions of successful execution)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj (CELEX 32024R1774, unit point_026.001_f)', verbatim-'lay down the objectives of ICT response and recovery plans and the conditions to declare a successful execution of those plans']).

citation(eu_reg_2024_1774_art_26_2, [label-'Delegated Regulation (EU) 2024/1774 Art 26(2), first to third sentences (plans identify and develop scenarios; listed scenarios duly taken into account)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj (CELEX 32024R1774, unit parag_026.002)', verbatim-'The ICT response and recovery plans referred to in paragraph 1 shall identify relevant scenarios, including scenarios of severe business disruptions and increased likelihood of occurrence of disruption']).

citation(eu_reg_2024_1774_art_26_2_a, [label-'Delegated Regulation (EU) 2024/1774 Art 26(2), point (a) (cyber-attacks and switchovers)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj (CELEX 32024R1774, unit point_026.002_a)', verbatim-'cyber-attacks and switchovers between the primary ICT infrastructure and the redundant capacity, backups, and redundant facilities']).

citation(eu_reg_2024_1774_art_26_2_b, [label-'Delegated Regulation (EU) 2024/1774 Art 26(2), point (b) (deterioration or failure of a critical or important function)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj (CELEX 32024R1774, unit point_026.002_b)', verbatim-'scenarios in which the quality of the provision of a critical or important function deteriorates to an unacceptable level or fails']).

citation(eu_reg_2024_1774_art_26_2_c, [label-'Delegated Regulation (EU) 2024/1774 Art 26(2), point (c) (failure of premises and data centres)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj (CELEX 32024R1774, unit point_026.002_c)', verbatim-'partial or total failure of premises, including office and business premises, and data centres']).

citation(eu_reg_2024_1774_art_26_2_d, [label-'Delegated Regulation (EU) 2024/1774 Art 26(2), point (d) (failure of ICT assets or communication infrastructure)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj (CELEX 32024R1774, unit point_026.002_d)', verbatim-'substantial failure of ICT assets or of the communication infrastructure']).

citation(eu_reg_2024_1774_art_26_2_e, [label-'Delegated Regulation (EU) 2024/1774 Art 26(2), point (e) (non-availability of staff)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj (CELEX 32024R1774, unit point_026.002_e)', verbatim-'the non-availability of a critical number of staff or staff members in charge of guaranteeing the continuity of operations']).

citation(eu_reg_2024_1774_art_26_2_f, [label-'Delegated Regulation (EU) 2024/1774 Art 26(2), point (f) (climate, environment, natural disasters, pandemics, physical attacks)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj (CELEX 32024R1774, unit point_026.002_f)', verbatim-'impact of climate change and environment degradation related events, natural disasters, pandemics, and physical attacks, including intrusions and terrorist attacks']).

citation(eu_reg_2024_1774_art_26_2_g, [label-'Delegated Regulation (EU) 2024/1774 Art 26(2), point (g) (insider attacks)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj (CELEX 32024R1774, unit point_026.002_g)', verbatim-'insider attacks']).

citation(eu_reg_2024_1774_art_26_2_h, [label-'Delegated Regulation (EU) 2024/1774 Art 26(2), point (h) (political and social instability)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj (CELEX 32024R1774, unit point_026.002_h)', verbatim-'political and social instability, including, where relevant, in the ICT third-party service provider']).

citation(eu_reg_2024_1774_art_26_2_i, [label-'Delegated Regulation (EU) 2024/1774 Art 26(2), point (i) (widespread power outages)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj (CELEX 32024R1774, unit point_026.002_i)', verbatim-'widespread power outages']).

citation(eu_reg_2024_1774_art_26_3, [label-'Delegated Regulation (EU) 2024/1774 Art 26(3) (alternative options where primary recovery measures may not be feasible)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj (CELEX 32024R1774, unit parag_026.003)', verbatim-'Where the primary recovery measures may not be feasible in the short term because of costs, risks, logistics, or unforeseen circumstances, the ICT response and recovery plans referred to in paragraph 1 shall consider alternative options']).

citation(eu_reg_2024_1774_art_26_4, [label-'Delegated Regulation (EU) 2024/1774 Art 26(4) (continuity measures for failures of ICT third-party service providers)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj (CELEX 32024R1774, unit parag_026.004)', verbatim-'financial entities shall consider and implement continuity measures to mitigate failures of ICT third-party service providers of ICT services supporting critical or important functions of the financial entity']).

:- end_module(citations).
