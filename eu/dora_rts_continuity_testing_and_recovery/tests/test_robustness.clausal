% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_robustness.clausal -- ROBUSTNESS of the input check dora_rts_continuity_testing_and_recovery_input_problems/2 for a
% PROFILE that is an attribute list [attribute(Key, Value), ...]: an empty list, a
% value that is not a list, an unknown key and a value outside its type each get exactly
% one answer. Written by the scaffold from the order's typed input contract
% (input_contract.types.profile: attribute_list), not by the producer;
% do not edit or delete.
% Run: python -m clausal.testing eu/dora_rts_continuity_testing_and_recovery/tests/test_robustness.clausal
% =====================================================================
:- module(test_robustness, []).
:- use_module(eu/dora_rts_continuity_testing_and_recovery/queries, [dora_rts_continuity_testing_and_recovery_input_problems/2]).

test(an_empty_attribute_list_gets_exactly_one_answer) :-
    findall(Problems, dora_rts_continuity_testing_and_recovery_input_problems([], Problems), Answers),
    Answers == [[]].

test(a_profile_that_is_not_a_list_gets_one_non_empty_answer) :-
    findall(Problems, dora_rts_continuity_testing_and_recovery_input_problems(not_a_profile, Problems), Answers),
    Answers = [[_|_]].

test(an_unknown_key_is_named) :-
    findall(Problems, dora_rts_continuity_testing_and_recovery_input_problems([attribute(not_a_key_of_the_contract, true)], Problems), Answers),
    Answers = [Problems],
    memberchk(unknown_key(not_a_key_of_the_contract), Problems).

test(a_value_outside_the_type_of_financial_entity_is_article_16_1_entity_is_named) :-
    findall(Problems, dora_rts_continuity_testing_and_recovery_input_problems([attribute(financial_entity_is_article_16_1_entity, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(financial_entity_is_article_16_1_entity), Problems).

test(a_value_outside_the_type_of_dora_entity_type_is_named) :-
    findall(Problems, dora_rts_continuity_testing_and_recovery_input_problems([attribute(dora_entity_type, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(dora_entity_type), Problems).

test(a_value_outside_the_type_of_continuity_testing_takes_into_account_business_impact_analysis_and_ict_risk_assessment_is_named) :-
    findall(Problems, dora_rts_continuity_testing_and_recovery_input_problems([attribute(continuity_testing_takes_into_account_business_impact_analysis_and_ict_risk_assessment, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(continuity_testing_takes_into_account_business_impact_analysis_and_ict_risk_assessment), Problems).

:- end_module(test_robustness).
