% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% queries.clausal -- QUERY-COMBINATOR layer for eu/dora_rts_continuity_testing_and_recovery.
% A TOP-LAYER consumer: it imports the determination slice's PUBLIC
% predicates it calls, and nothing else.
%
% dora_rts_continuity_testing_and_recovery_profile_keys/1     top-level profile key schema (root_exports order)
% dora_rts_continuity_testing_and_recovery_input_problems/2   the problems a profile has ([] = none), re-exported
%                                                             from the kernel as the scaffold wrote it
% dora_rts_continuity_testing_and_recovery_what_if/4          (#16 what-if): override one key -> re-evaluate.
%     The profile is an ATTRIBUTE LIST, not a dict, so kit/query_combinators'
%     override_key/4 (dict-only: it raised type_error(dict, ...)) cannot be
%     used; the override is the local list plumbing overridden_profile/4.
% dora_rts_continuity_testing_and_recovery_compliance_check/2 (#13 compliance_check): does the entity's
%     current state comply with the duties of RTS Articles 25 and 26 that
%     apply to it; read from rts_continuity_testing_and_recovery_duties_outstanding/3:
%       none_outstanding            -> compliance_verdict(compliant, [], Citations)
%       outstanding(Duties)         -> compliance_verdict(non_compliant, Duties, Citations)
%       simplified_framework_entity -> compliance_verdict(not_applicable, [], Citations)
%       a status compound           -> compliance_verdict(StatusCompound, [], [])
% dora_rts_continuity_testing_and_recovery_eligibility/2      (#2 eligibility, #7 justification):
%     eligibility_assessment(Decision, Checklist), Decision read from
%     rts_continuity_testing_and_recovery_duties_complete/3 (complete -> eligible,
%     incomplete -> ineligible, the Art 16(1) gate -> not_applicable, any status
%     compound -> indeterminate_eligibility), Checklist the slice's cited checklist
%     (one item per duty, each carrying its own cite(...) terms).
%
% ROOT EXPORTS: the result atoms, the duty atoms, the profile key atoms, the
% entity type atoms central_counterparty and central_securities_depository and
% the judgement value unsure are exported here as name/0 facts, so the package
% root carries each as a bare attribute. The RESULT CONSTRUCTORS are exported
% by name and arity and declared below as constructors: they are data, with
% no clauses, never called as queries.
%
% The open-textured judgements are handed to the caller (and, when unsure
% and decisive, to a lawyer through needs_legal_review/2): no crisp test is
% invented here. Every predicate yields exactly ONE solution: each mapping
% is complementary clauses on the one RESULT the slice query gives.
% =====================================================================

:- module(queries, [
    dora_rts_continuity_testing_and_recovery_profile_keys/1,
    dora_rts_continuity_testing_and_recovery_input_problems/2,
    dora_rts_continuity_testing_and_recovery_what_if/4,
    dora_rts_continuity_testing_and_recovery_compliance_check/2,
    dora_rts_continuity_testing_and_recovery_eligibility/2,
    complete/0,
    incomplete/0,
    none_outstanding/0,
    simplified_framework_entity/0,
    required/1,
    outstanding/1,
    indeterminate/1,
    needs_legal_review/2,
    open_textured/2,
    inputs_relied_on/1,
    provenance/2,
    input_problems/1,
    unknown_key/1,
    wrong_type/1,
    duplicate_key/1,
    unsure/0,
    central_counterparty/0,
    central_securities_depository/0,
    testing_informed_by_business_impact_analysis_and_ict_risk_assessment/0,
    assessment_of_continuity_of_critical_or_important_functions/0,
    testing_on_disruption_scenarios/0,
    testing_of_ict_third_party_services/0,
    testing_of_switchover_scenarios/0,
    testing_challenges_plan_assumptions/0,
    testing_verifies_ability_to_respond/0,
    involvement_of_central_counterparty_parties_in_testing/0,
    involvement_of_central_securities_depository_parties_in_testing/0,
    documentation_of_test_results/0,
    handling_of_test_deficiencies/0,
    response_and_recovery_plans_informed_by_business_impact_analysis/0,
    activation_and_deactivation_conditions/0,
    actions_for_critical_or_important_ict_systems_and_services/0,
    design_to_meet_recovery_objectives/0,
    documentation_and_availability_of_plans/0,
    short_and_long_term_recovery_options/0,
    plan_objectives_and_success_conditions/0,
    identification_of_relevant_scenarios/0,
    scenarios_based_on_threats_and_lessons_learned/0,
    listed_disruption_scenarios/0,
    alternative_recovery_options/0,
    continuity_measures_for_ict_third_party_service_provider_failures/0,
    financial_entity_is_article_16_1_entity/0,
    financial_entity_is_microenterprise/0,
    dora_entity_type/0,
    financial_entity_uses_ict_services_of_ict_third_party_service_providers/0,
    continuity_testing_takes_into_account_business_impact_analysis_and_ict_risk_assessment/0,
    continuity_testing_assesses_continuity_of_critical_or_important_functions/0,
    continuity_testing_based_on_scenarios_including_severe_but_plausible_scenarios/0,
    continuity_testing_contains_testing_of_ict_services_of_ict_third_party_service_providers/0,
    continuity_testing_contains_switchover_scenarios/0,
    continuity_testing_challenges_assumptions_of_business_continuity_plans/0,
    continuity_testing_contains_procedures_to_verify_ability_to_respond/0,
    continuity_testing_involves_clearing_members_external_providers_and_interdependent_institutions/0,
    continuity_testing_involves_users_utilities_market_infrastructures_and_interdependent_institutions/0,
    continuity_test_results_documented/0,
    continuity_test_deficiencies_analysed_addressed_and_reported_to_management_body/0,
    response_and_recovery_plans_take_into_account_business_impact_analysis/0,
    response_and_recovery_plans_specify_activation_and_deactivation_conditions_and_exceptions/0,
    response_and_recovery_plans_describe_actions_for_ict_systems_and_services_supporting_critical_or_important_functions/0,
    response_and_recovery_plans_designed_to_meet_recovery_objectives/0,
    response_and_recovery_plans_documented_available_and_accessible_with_roles_and_responsibilities/0,
    response_and_recovery_plans_provide_short_term_and_long_term_recovery_options/0,
    response_and_recovery_plans_lay_down_objectives_and_conditions_of_successful_execution/0,
    response_and_recovery_plans_identify_relevant_scenarios/0,
    response_and_recovery_plans_develop_scenarios_on_current_threat_information_and_lessons_learned/0,
    listed_disruption_scenarios_duly_taken_into_account/0,
    response_and_recovery_plans_consider_alternative_options_where_primary_recovery_measures_may_not_be_feasible/0,
    continuity_measures_for_ict_third_party_service_provider_failures_considered_and_implemented/0
]).

:- use_module(eu/dora_rts_continuity_testing_and_recovery/kernel, [dora_rts_continuity_testing_and_recovery_input_problems/2]).
:- use_module(eu/dora_rts_continuity_testing_and_recovery/dora_rts_continuity_testing_and_recovery, [
