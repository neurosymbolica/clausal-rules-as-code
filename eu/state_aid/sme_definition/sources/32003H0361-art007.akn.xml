<akomaNtoso xmlns="http://docs.oasis-open.org/legaldocml/ns/akn/3.0">
  <act name="32003H0361">
    <body>
      <hcontainer eId="annex_art7">
        <p>Article 7 Statistics</p>
        <hcontainer eId="annex_art7_t1">
          <p>The Commission will take the necessary measures to present the statistics that it produces in accordance with the following size-classes of enterprises:</p>
        </hcontainer>
        <hcontainer eId="annex_art7_t2">
          <p>(a) 0 to 1 person;</p>
        </hcontainer>
        <hcontainer eId="annex_art7_t3">
          <p>(b) 2 to 9 persons;</p>
        </hcontainer>
        <hcontainer eId="annex_art7_t4">
          <p>(c) 10 to 49 persons;</p>
        </hcontainer>
        <hcontainer eId="annex_art7_t5">
          <p>(d) 50 to 249 persons.</p>
        </hcontainer>
      </hcontainer>
    </body>
  </act>
</akomaNtoso>
