# =====================================================================
# queries.clausal -- QUERY-COVERAGE layer (Q1 wave: #4/#5/#6/#8/#13/#16/#24)
#
# PURELY ADDITIVE (no decision/computation/constants sibling edited).
# Read-only queries over the UNTOUCHED rulebase surface:
#   de_minimis_qualifying_grants/3  #4 enumeration (which grants count)
#   de_minimis_compare_refs/4       #5 comparison (two candidate grant dates)
#   de_minimis_headroom/3           #6 threshold / #24 sensitivity (margin:
#                                   remaining aid before the ceiling flips)
#   de_minimis_gap_to_ineligible/3  #8 counterfactual / #24 (smallest new
#                                   grant that flips eligible -> ineligible)
#   de_minimis_what_if/4            #16 what-if / #13 compliance (verdict
#                                   under a hypothetical new grant on REF --
#                                   reifies the NOTES.md section-5 caller
#                                   convention as a predicate)
#
# SHAPE NOTE (vs the amlr_beneficial_ownership_threshold pilot): this domain
# has NO checklist/item-3 surface (raw GRANTS list in, scalar verdict out),
# so the kit checklist combinators (diff_checklists, find_minimal_unsatisfiable_subset) do not apply;
# comparison and what-if are expressed natively over the scalar verdict.
# And unlike amlr's exact-rational aggregates, every quantity here is an
# exact INTEGER euro-cent sum, so gap/headroom are ANALYTIC (O(1) integer
# arithmetic: eligible iff TOTAL <= CEILING, hence min flipping grant =
# CEILING - TOTAL + 1) rather than empirically flip-scanned in-predicate --
# the cent-scale range (0..30,000,001) defeats the two-stage scan pattern.
# Kit flip_scan is instead used TEST-side (tests/test_queries.clausal) to
# verify empirically that the rulebase's verdict flips exactly where the
# arithmetic says, preserving the pilot's "the rulebase, not the constant,
# defines the boundary" guarantee.
#
# All inputs follow the rulebase contract: GRANTS = [[date(Y, M, D),
# AMOUNT_CENTS], ...] (prior grants to the single undertaking), REF dates =
# date(Y, M, D), amounts non-negative integer euro-cents. Every predicate here
# fails (no solution) on any input problem cumulation.seam's
# de_minimis_input_problem/3 reports -- except de_minimis_what_if/4, which
# inherits the decision layer's IC-11 'indeterminate' channel.
# =====================================================================

-module(queries, [
    de_minimis_compare_refs(GRANTS, REF_A, REF_B, RESULT),
    de_minimis_gap_to_ineligible(GRANTS, REFERENCE_DATE, GAP_CENTS),
    de_minimis_headroom(GRANTS, REFERENCE_DATE, HEADROOM_CENTS),
    de_minimis_qualifying_grants(GRANTS, REFERENCE_DATE, QUALIFYING),
    de_minimis_what_if(GRANTS, REFERENCE_DATE, NEW_AMOUNT_CENTS, VERDICT),
    # result constructor (#5): totals + verdicts at the two reference dates
    ref_comparison(TOTAL_A, VERDICT_A, TOTAL_B, VERDICT_B)
])
-double_quotes(chars)

# LEXICAL CLOSURE ONLY (determination-slices re-slice, Wave C 2026-08-07):
# the five names below are exactly the ones this file's clause bodies SPELL,
# all now owned by the single determination slice cumulation.clausal (the
# former schema + constants + computation + decision). `indeterminate` was
# imported before and is NOT spelled here -- this layer never constructs it,
# it inherits the IC-11 channel through de_minimis_verdict/3 -- so it is gone.
# ref_comparison/4 is declared in this file's own -module list above.
-import_from(european_union, [euro, eur_cent])
-import_from(eu.state_aid.de_minimis_cumulation.cumulation, [
    de_minimis_aid_in_window, de_minimis_ceiling, de_minimis_verdict,
    de_minimis_ceiling_amount, eligible, ineligible])

-strict_atoms


# =====================================================================
# de_minimis_qualifying_grants/3 -- #4 enumeration
# =====================================================================
# The sublist of GRANTS that falls inside the rolling three-year window
# ending on REF (window-start exclusive, REF-date inclusive) -- i.e. the
# grants that actually cumulate toward the Art 3(2) ceiling. Membership is
# decided by PROBING THE RULEBASE (a singleton 1-cent grant on the same
# date sums to 1 iff the date is in-window), so the window logic is never
# duplicated here -- the computation sibling stays the single source of
# truth. The leading full-list call is the well-formedness guard: an
# unresolvable REF or a malformed grant fails the whole query (no silent
# dropping). Deterministic; preserves GRANTS order.
de_minimis_qualifying_grants(GRANTS, REF, QUALIFYING) <- (
    de_minimis_aid_in_window(GRANTS, REF, _),
    include((G <- (
        G is [D, _],
        de_minimis_aid_in_window([[D, 1]], REF, 1))), GRANTS, QUALIFYING)
)


# =====================================================================
# de_minimis_compare_refs/4 -- #5 comparison (two candidate grant dates)
# =====================================================================
# Contrast two candidate reference dates for the same undertaking: because
# the three-year window ROLLS, postponing a grant lets old aid drop out of
# the cumulation. RESULT is ref_comparison(TOTAL_A, VERDICT_A, TOTAL_B,
# VERDICT_B) -- the in-window totals and verdicts at each date.
# Deterministic; fails when either REF is unresolvable.
de_minimis_compare_refs(GRANTS, REF_A, REF_B, RESULT) <- (
    de_minimis_aid_in_window(GRANTS, REF_A, TOTAL_A),
    de_minimis_verdict(GRANTS, REF_A, VERDICT_A),
    de_minimis_aid_in_window(GRANTS, REF_B, TOTAL_B),
    de_minimis_verdict(GRANTS, REF_B, VERDICT_B),
    RESULT is ref_comparison(TOTAL_A, VERDICT_A, TOTAL_B, VERDICT_B)
)


# =====================================================================
# de_minimis_headroom/3 -- #6 threshold / #24 sensitivity (the margin)
# =====================================================================
# The remaining de minimis headroom at REF: how many more euro-cents of aid
# the undertaking can receive while the cumulated in-window total stays at
# or under the EUR 300 000 ceiling (inclusive, Art 3(2)). 0 when the total
# already sits AT the ceiling (any further positive grant breaches) and 0
# when it is already over. Exact integer arithmetic -- no scan needed (see
# header). Disjoint guards (<= vs >) keep it cut-free and deterministic.
de_minimis_headroom(GRANTS, REF, HEADROOM_CENTS) <- (
    de_minimis_aid_in_window(GRANTS, REF, TOTAL),
    de_minimis_ceiling_amount(CEILING),
    TOTAL(eur_cent) <= CEILING,
    HEADROOM_CENTS == (CEILING - TOTAL(eur_cent)) / eur_cent
)

de_minimis_headroom(GRANTS, REF, HEADROOM_CENTS) <- (
    de_minimis_aid_in_window(GRANTS, REF, TOTAL),
    de_minimis_ceiling_amount(CEILING),
    TOTAL(eur_cent) > CEILING,
    HEADROOM_CENTS == 0
)


# =====================================================================
# de_minimis_gap_to_ineligible/3 -- #8 counterfactual / #24 (the flip)
# =====================================================================
# The smallest new grant (integer euro-cents, granted ON the reference
# date) that would flip the undertaking's verdict to ineligible: with the
# inclusive ceiling, that is HEADROOM + 1 for an eligible undertaking
# (headroom 0 at exactly the ceiling -> a 1-cent grant already breaches),
# and 0 when the undertaking is already ineligible (mirrors the amlr pilot's
# gap convention: 0 = "already in the flipped state"). The flip location is
# verified EMPIRICALLY against the rulebase via kit flip_scan in
# tests/test_queries.clausal. Deterministic (disjoint verdict guards);
# no solution on an indeterminate verdict.
de_minimis_gap_to_ineligible(GRANTS, REF, GAP_CENTS) <- (
    de_minimis_verdict(GRANTS, REF, V),
    V is eligible,
    de_minimis_headroom(GRANTS, REF, HEADROOM),
    GAP_CENTS == HEADROOM + 1
)

de_minimis_gap_to_ineligible(GRANTS, REF, GAP_CENTS) <- (
    de_minimis_verdict(GRANTS, REF, V),
    V is ineligible,
    GAP_CENTS == 0
)


# =====================================================================
# de_minimis_what_if/4 -- #16 what-if / #13 compliance check
# =====================================================================
# The verdict IF a new grant of NEW_AMOUNT_CENTS were made on REF: prepends
# the hypothetical grant [[REF, NEW_AMOUNT_CENTS]] to the prior GRANTS (the
# REF-date grant is in-window by the inclusive upper bound) and re-runs the
# untouched decision layer. This reifies the NOTES.md section-5 caller
# convention, and doubles as the #13 compliance reading: under Art 3(7),
# aid that would exceed the ceiling cannot benefit from the Regulation, so
# VERDICT == ineligible means the proposed grant may NOT be made as de
# minimis aid (deontic caveat: 'ineligible' speaks to de minimis cover,
# not to a free-standing prohibition of the grant). Inherits the decision
# layer's IC-11 channel: an unresolvable REF yields 'indeterminate'.
de_minimis_what_if(GRANTS, REF, NEW_AMOUNT_CENTS, VERDICT) <- (
    de_minimis_verdict([[REF, NEW_AMOUNT_CENTS], *GRANTS], REF, VERDICT)
)
