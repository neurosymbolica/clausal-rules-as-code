# citations.seam -- machine-readable citation registry for eu/state_aid/de_minimis_cumulation.
#
# Written 2026-10-18 through the propose step (_tools/propose_provisions.py --pack,
# a drafted proposal, --validate OK). Every `units` id is a unit of the pinned
# Regulation (EU) 2023/2831 Art 3 extract under sources/, and every `verbatim` is copied
# from that unit's own text (T5 checks it). Units this domain does not implement are
# deferred in manifest.yaml `deferred_set`.
#
# Owns implements/1 (the in-clause provenance marker) and citation/2 (the lookup).

-module(citations, [
    implements(C),
    citation(ATOM, META),
    eu_reg_2023_2831_art_3_1,
    eu_reg_2023_2831_art_3_2,
    eu_reg_2023_2831_art_3_4,
    eu_reg_2023_2831_art_3_7
])
-double_quotes(chars)
-private([label, ref, units, verbatim])

-strict_atoms

# implements/1 -- the in-clause provenance marker. It succeeds only for a key this
# module declares, so a clause cannot claim a provision that has no record.
implements(KEY) <- (
    citation(KEY, _)
),

citation(eu_reg_2023_2831_art_3_1, {
  label:    "Regulation (EU) 2023/2831, Art. 3(1)",
  ref:      "https://eur-lex.europa.eu/eli/reg/2023/2831/oj",
  units:    ["32023R2831#parag_003.001"],
  verbatim: """Aid measures shall be deemed not to meet all the criteria set out in Article 107(1) of the Treaty and shall therefore not be subject to the notification requirement in Article 108(3) of the Treaty if they fulfil the conditions laid down in this Regulation."""
}),

citation(eu_reg_2023_2831_art_3_2, {
  label:    "Regulation (EU) 2023/2831, Art. 3(2)",
  ref:      "https://eur-lex.europa.eu/eli/reg/2023/2831/oj",
  units:    ["32023R2831#parag_003.002"],
  verbatim: """The total amount of de minimis aid granted per Member State to a single undertaking shall not exceed EUR 300 000 over any period of 3 years."""
}),

citation(eu_reg_2023_2831_art_3_4, {
  label:    "Regulation (EU) 2023/2831, Art. 3(4)",
  ref:      "https://eur-lex.europa.eu/eli/reg/2023/2831/oj",
  units:    ["32023R2831#parag_003.004"],
  verbatim: """The ceiling laid down in paragraph 2 shall apply irrespective of the form of the de minimis aid or the objective pursued by it and irrespective of whether the aid granted by the Member State is financed entirely or partly by resources of Union origin."""
}),

citation(eu_reg_2023_2831_art_3_7, {
  label:    "Regulation (EU) 2023/2831, Art. 3(7)",
  ref:      "https://eur-lex.europa.eu/eli/reg/2023/2831/oj",
  units:    ["32023R2831#parag_003.007"],
  verbatim: """Where the ceiling laid down in paragraph 2 would be exceeded by the grant of new de minimis aid, that new aid shall not benefit from this Regulation."""
}),
