-double_quotes(chars)
-import_from(eu.state_aid.de_minimis_cumulation, [de_minimis_ceiling, de_minimis_aid_in_window, de_minimis_verdict,
    eligible, ineligible, indeterminate])
-import_from(date_time, [date])

# ── de_minimis_ceiling/1 ──────────────────────────────────────────────────

test("ceiling is 30000000 euro-cents") <- (
    de_minimis_ceiling(C),
    C == 30000000
)

test("DET ceiling") <- (
    findall(C, de_minimis_ceiling(C), L),
    length(L, 1)
)

# ── de_minimis_aid_in_window/3 ────────────────────────────────────────────

test("aid sums only grants within 3-year window") <- (
    de_minimis_aid_in_window(
        [[date(2023, 1, 1), 5000000], [date(2022, 1, 1), 10000000], [date(2020, 1, 1), 20000000]],
        date(2024, 1, 1),
        TOTAL
    ),
    TOTAL == 15000000
)

test("aid with empty grants list is zero") <- (
    de_minimis_aid_in_window([], date(2024, 1, 1), TOTAL),
    TOTAL == 0
)

test("grant on ref date itself is included") <- (
    de_minimis_aid_in_window([[date(2024, 1, 1), 7000000]], date(2024, 1, 1), TOTAL),
    TOTAL == 7000000
)

test("DET aid in window") <- (
    findall(T, de_minimis_aid_in_window([[date(2023, 1, 1), 5000000]], date(2024, 1, 1), T), L),
    length(L, 1)
)

# ── de_minimis_verdict/3 ─────────────────────────────────────────────────

test("verdict eligible when total under limit") <- (
    de_minimis_verdict(
        [[date(2023, 1, 1), 5000000], [date(2022, 1, 1), 10000000]],
        date(2024, 1, 1),
        V
    ),
    V is eligible
)

test("verdict eligible when total equals ceiling") <- (
    de_minimis_verdict(
        [[date(2023, 1, 1), 30000000]],
        date(2024, 1, 1),
        V
    ),
    V is eligible
)

test("verdict ineligible when total over ceiling") <- (
    de_minimis_verdict(
        [[date(2023, 1, 1), 20000000], [date(2022, 6, 1), 15000000]],
        date(2024, 1, 1),
        V
    ),
    V is ineligible
)

test("DET verdict") <- (
    findall(V, de_minimis_verdict([[date(2023, 1, 1), 5000000]], date(2024, 1, 1), V), L),
    length(L, 1)
)
