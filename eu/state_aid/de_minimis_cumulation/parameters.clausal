% parameters.clausal -- machine-readable provenance for this domain's
% legally-sourced parameter VALUES (Part B; docs/superpowers/specs/
% 2026-07-17-citation-partB-parameter-provenance-design.md). Purely additive:
% the value facts stay in the logic module; these rows only REFERENCE them by
% functor name. Load-on-demand -- NOT imported by the logic module.
%
% Owns parameter_source/2: parameter_source(<functor>, [label-'...', ref-'...', verbatim-'...', units-[...]]).
% The verbatim MUST state the value in the source's own units; the functor's
% unit suffix (_cents/_bps/_percent/_days) bridges to the machine value.
% Generated by _tools/scaffold_parameters.py from parameters-sources.yaml keys;
% hand-edit only label/ref/verbatim. Regenerate structure; never hand-add keys.
%
% Clausal Prolog record form: the key is the functor as an atom, and the record
% is the label, ref, verbatim pair list (then units), every value a quoted atom.

:- module(parameters, [parameter_source/2]).

parameter_source(de_minimis_ceiling, [
    label-'Reg (EU) 2023/2831 Art 3(2) — EUR 300 000 three-year de minimis aid ceiling',
    ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/PDF/?uri=CELEX:32023R2831',
    verbatim-'The total amount of de minimis aid granted per Member State to a single undertaking shall not exceed EUR 300 000 over any period of 3 years.',
    units-['32023R2831#parag_003.002']
]).

parameter_source(lookback_years, [
    label-'Reg (EU) 2023/2831 Art 3(2) — 3-year rolling lookback window',
    ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/PDF/?uri=CELEX:32023R2831',
    verbatim-'The total amount of de minimis aid granted per Member State to a single undertaking shall not exceed EUR 300 000 over any period of 3 years.',
    units-['32023R2831#parag_003.002']
]).

:- end_module(parameters).
