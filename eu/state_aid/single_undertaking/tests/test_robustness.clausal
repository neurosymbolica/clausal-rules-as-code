% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_robustness.clausal -- ROBUSTNESS of the input check single_undertaking_input_problems/2 for a
% PROFILE that is an attribute list [attribute(Key, Value), ...]: an empty list, a
% value that is not a list, an unknown key and a value outside its type each get exactly
% one answer. Written by the scaffold from the order's typed input contract
% (input_contract.types.profile: attribute_list), not by the producer;
% do not edit or delete.
% Run: python -m clausal.testing eu/state_aid/single_undertaking/tests/test_robustness.clausal
% =====================================================================
:- module(test_robustness, []).
:- use_module(eu/state_aid/single_undertaking/queries, [single_undertaking_input_problems/2]).

test(an_empty_attribute_list_gets_exactly_one_answer) :-
    findall(Problems, single_undertaking_input_problems([], Problems), Answers),
    Answers == [[]].

test(a_profile_that_is_not_a_list_gets_one_non_empty_answer) :-
    findall(Problems, single_undertaking_input_problems(not_a_profile, Problems), Answers),
    Answers = [[_|_]].

test(an_unknown_key_is_named) :-
    findall(Problems, single_undertaking_input_problems([attribute(not_a_key_of_the_contract, true)], Problems), Answers),
    Answers = [Problems],
    memberchk(unknown_key(not_a_key_of_the_contract), Problems).

test(a_value_outside_the_type_of_holder_is_an_enterprise_is_named) :-
    findall(Problems, single_undertaking_input_problems([attribute(holder_is_an_enterprise, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(holder_is_an_enterprise), Problems).

test(a_value_outside_the_type_of_voting_rights_held_is_named) :-
    findall(Problems, single_undertaking_input_problems([attribute(voting_rights_held, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(voting_rights_held), Problems).

test(a_value_outside_the_type_of_right_to_appoint_or_remove_majority_of_board_is_named) :-
    findall(Problems, single_undertaking_input_problems([attribute(right_to_appoint_or_remove_majority_of_board, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(right_to_appoint_or_remove_majority_of_board), Problems).

test(a_value_outside_the_type_of_first_enterprise_is_named) :-
    findall(Problems, single_undertaking_input_problems([attribute(first_enterprise, 7)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(first_enterprise), Problems).

test(a_value_outside_the_type_of_relationships_is_named) :-
    findall(Problems, single_undertaking_input_problems([attribute(relationships, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(relationships), Problems).

:- end_module(test_robustness).
