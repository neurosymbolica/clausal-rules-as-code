% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/nis2_scope_entity_class.
%
% Instrument: Directive (EU) 2022/2555 (NIS 2 Directive), pinned unit text of
% 32022L2555 (OJ L 333, 27.12.2022; raw sha256
% 6ee66d5c419d9a056fb98d94083cacf9b818803bd6b416435718e0d4919cb589).
% Each record names the provision down to the point; the pinned unit
% identifier is written in brackets in the label.
%
% citation/2 record form: citation(Key, [label-'...', ref-'...', verbatim-'...']).
% The verbatim pair is present only for keys whose entry in
% citations-sources.yaml is `status: verified`.
%
% citation_vocabulary/2 lists the CANONICAL citation keys (lexicon scheme,
% _lexicon/citations.yaml) that a RESULT may return, each with its pinned
% unit. They are the ONLY keys a result carries.
%
% Keys recorded for provenance markers only (NEVER returned in a result):
% eu_rec_2003_361_annex_art_2_1, eu_rec_2003_361_annex_art_2_2 and
% eu_rec_2003_361_annex_art_2_3, the size ceilings of Article 2 of the Annex
% to Commission Recommendation 2003/361/EC, quoted from the source library's
% raw pin 32003H0361 (not a pinned unit of this domain; Directive Art 2(1)
% points to it, and a settled size cites eu_dir_2022_2555_art_2_1).
%
% PROVENANCE: implements(Key) succeeds for every recorded key and fails for
% any other, so a misspelt marker fails its clause instead of lying.
% =====================================================================

:- module(citations, [
    citation/2,
    citation_vocabulary/2,
    implements/1
]).

implements(Key) :-
    citation(Key, _).

% ---- Directive (EU) 2022/2555 Article 2: scope ----

citation(eu_dir_2022_2555_art_2_1, [label-'Directive (EU) 2022/2555 Art 2(1) size rule: Annex I or II type, medium-sized or larger, services or activities in the Union; Art 3(4) of the Annex to Recommendation 2003/361/EC disapplied [32022L2555#parag_002.001]', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj', verbatim-'This Directive applies to public or private entities of a type referred to in Annex I or II which qualify as medium-sized enterprises under Article 2 of the Annex to Recommendation 2003/361/EC']).

citation(eu_dir_2022_2555_art_2_2, [label-'Directive (EU) 2022/2555 Art 2(2) chapeau: entities of an Annex I or II type regardless of their size [32022L2555#parag_002.002]', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj', verbatim-'Regardless of their size, this Directive also applies to entities of a type referred to in Annex I or II, where']).

citation(eu_dir_2022_2555_art_2_2_a_i, [label-'Directive (EU) 2022/2555 Art 2(2)(a)(i) providers of public electronic communications networks or of publicly available electronic communications services [32022L2555#point_002.002_a_i]', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj', verbatim-'providers of public electronic communications networks or of publicly available electronic communications services']).

citation(eu_dir_2022_2555_art_2_2_a_ii, [label-'Directive (EU) 2022/2555 Art 2(2)(a)(ii) trust service providers [32022L2555#point_002.002_a_ii]', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj', verbatim-'trust service providers']).

citation(eu_dir_2022_2555_art_2_2_a_iii, [label-'Directive (EU) 2022/2555 Art 2(2)(a)(iii) top-level domain name registries and domain name system service providers [32022L2555#point_002.002_a_iii]', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj', verbatim-'top-level domain name registries and domain name system service providers']).

citation(eu_dir_2022_2555_art_2_2_b, [label-'Directive (EU) 2022/2555 Art 2(2)(b) sole provider in a Member State of an essential service [32022L2555#point_002.002_b]', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj', verbatim-'the entity is the sole provider in a Member State of a service which is essential for the maintenance of critical societal or economic activities']).

citation(eu_dir_2022_2555_art_2_2_c, [label-'Directive (EU) 2022/2555 Art 2(2)(c) disruption with a significant impact on public safety, public security or public health [32022L2555#point_002.002_c]', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj', verbatim-'disruption of the service provided by the entity could have a significant impact on public safety, public security or public health']).

citation(eu_dir_2022_2555_art_2_2_d, [label-'Directive (EU) 2022/2555 Art 2(2)(d) disruption inducing a significant systemic risk [32022L2555#point_002.002_d]', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj', verbatim-'disruption of the service provided by the entity could induce a significant systemic risk']).

citation(eu_dir_2022_2555_art_2_2_e, [label-'Directive (EU) 2022/2555 Art 2(2)(e) entity critical because of its specific national or regional importance [32022L2555#point_002.002_e]', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj', verbatim-'the entity is critical because of its specific importance at national or regional level for the particular sector or type of service']).

citation(eu_dir_2022_2555_art_2_2_f_i, [label-'Directive (EU) 2022/2555 Art 2(2)(f)(i) public administration entity of central government [32022L2555#point_002.002_f_i]', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj', verbatim-'of central government as defined by a Member State in accordance with national law']).

citation(eu_dir_2022_2555_art_2_2_f_ii, [label-'Directive (EU) 2022/2555 Art 2(2)(f)(ii) public administration entity at regional level with risk-assessed services [32022L2555#point_002.002_f_ii]', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj', verbatim-'following a risk-based assessment, provides services the disruption of which could have a significant impact on critical societal or economic activities']).

citation(eu_dir_2022_2555_art_2_3, [label-'Directive (EU) 2022/2555 Art 2(3) critical entities under Directive (EU) 2022/2557 regardless of their size [32022L2555#parag_002.003]', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj', verbatim-'Regardless of their size, this Directive applies to entities identified as critical entities under Directive (EU) 2022/2557']).

citation(eu_dir_2022_2555_art_2_4, [label-'Directive (EU) 2022/2555 Art 2(4) entities providing domain name registration services regardless of their size [32022L2555#parag_002.004]', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj', verbatim-'Regardless of their size, this Directive applies to entities providing domain name registration services']).

citation(eu_dir_2022_2555_art_2_7, [label-'Directive (EU) 2022/2555 Art 2(7) exclusion of public administration entities in national security, public security, defence or law enforcement [32022L2555#parag_002.007]', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj', verbatim-'This Directive does not apply to public administration entities that carry out their activities in the areas of national security, public security, defence or law enforcement']).

citation(eu_dir_2022_2555_art_2_9, [label-'Directive (EU) 2022/2555 Art 2(9) paragraphs 7 and 8 disapplied for a trust service provider [32022L2555#parag_002.009]', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj', verbatim-'Paragraphs 7 and 8 shall not apply where an entity acts as a trust service provider']).

citation(eu_dir_2022_2555_art_2_10, [label-'Directive (EU) 2022/2555 Art 2(10) exclusion of entities exempted from the scope of Regulation (EU) 2022/2554 under its Art 2(4) [32022L2555#parag_002.010]', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj', verbatim-'This Directive does not apply to entities which Member States have exempted from the scope of Regulation (EU) 2022/2554 in accordance with Article 2(4) of that Regulation']).

% ---- Directive (EU) 2022/2555 Article 3: essential and important entities ----

citation(eu_dir_2022_2555_art_3_1_a, [label-'Directive (EU) 2022/2555 Art 3(1)(a) essential entity: Annex I type exceeding the ceilings for medium-sized enterprises [32022L2555#point_003.001_a]', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj', verbatim-'entities of a type referred to in Annex I which exceed the ceilings for medium-sized enterprises provided for in Article 2(1) of the Annex to Recommendation 2003/361/EC']).

citation(eu_dir_2022_2555_art_3_1_b, [label-'Directive (EU) 2022/2555 Art 3(1)(b) essential entity: qualified trust service providers, top-level domain name registries and DNS service providers regardless of their size [32022L2555#point_003.001_b]', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj', verbatim-'qualified trust service providers and top-level domain name registries as well as DNS service providers, regardless of their size']).

citation(eu_dir_2022_2555_art_3_1_c, [label-'Directive (EU) 2022/2555 Art 3(1)(c) essential entity: medium-sized providers of public electronic communications networks or services [32022L2555#point_003.001_c]', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj', verbatim-'publicly available electronic communications services which qualify as medium-sized enterprises']).

citation(eu_dir_2022_2555_art_3_1_d, [label-'Directive (EU) 2022/2555 Art 3(1)(d) essential entity: public administration entities of Art 2(2)(f)(i) [32022L2555#point_003.001_d]', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj', verbatim-'public administration entities referred to in Article 2(2), point (f)(i)']).

citation(eu_dir_2022_2555_art_3_1_e, [label-'Directive (EU) 2022/2555 Art 3(1)(e) essential entity: Annex I or II type identified by a Member State as essential under Art 2(2)(b) to (e) [32022L2555#point_003.001_e]', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj', verbatim-'any other entities of a type referred to in Annex I or II that are identified by a Member State as essential entities']).

citation(eu_dir_2022_2555_art_3_1_f, [label-'Directive (EU) 2022/2555 Art 3(1)(f) essential entity: critical entities under Directive (EU) 2022/2557 [32022L2555#point_003.001_f]', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj', verbatim-'entities identified as critical entities under Directive (EU) 2022/2557, referred to in Article 2(3) of this Directive']).

citation(eu_dir_2022_2555_art_3_1_g, [label-'Directive (EU) 2022/2555 Art 3(1)(g) essential entity: former operators of essential services kept essential by the Member State [32022L2555#point_003.001_g]', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj', verbatim-'entities which that Member State identified before 16 January 2023 as operators of essential services']).

citation(eu_dir_2022_2555_art_3_2, [label-'Directive (EU) 2022/2555 Art 3(2) important entity: Annex I or II type not essential under Art 3(1) [32022L2555#parag_003.002]', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj', verbatim-'which do not qualify as essential entities pursuant to paragraph 1 of this Article shall be considered to be important entities']).

% ---- Recommendation 2003/361/EC Annex Article 2 (markers only; never returned) ----

citation(eu_rec_2003_361_annex_art_2_1, [label-'Commission Recommendation 2003/361/EC Annex Art 2(1) ceilings of the SME category (medium-sized enterprise): fewer than 250 persons, turnover or balance sheet total within the ceilings (raw pin 32003H0361, not a pinned unit)', ref-'https://eur-lex.europa.eu/eli/reco/2003/361/oj']).

citation(eu_rec_2003_361_annex_art_2_2, [label-'Commission Recommendation 2003/361/EC Annex Art 2(2) definition of small enterprise (raw pin 32003H0361, not a pinned unit)', ref-'https://eur-lex.europa.eu/eli/reco/2003/361/oj']).

citation(eu_rec_2003_361_annex_art_2_3, [label-'Commission Recommendation 2003/361/EC Annex Art 2(3) definition of microenterprise (raw pin 32003H0361, not a pinned unit)', ref-'https://eur-lex.europa.eu/eli/reco/2003/361/oj']).

