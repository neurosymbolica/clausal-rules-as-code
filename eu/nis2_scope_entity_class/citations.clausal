% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/nis2_scope_entity_class.
%
% Source: Directive (EU) 2022/2555 (NIS 2 Directive), Art 2 and Art 3, pinned unit
% text of 32022L2555 (OJ L 333, 27.12.2022).
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order.
% The Recommendation 2003/361/EC Annex Art 2 has no key of its own (it is not a
% pinned unit): it is cited through eu_dir_2022_2555_art_2_1.
%
% implements(Key) succeeds for every recorded key; clauses of the logic modules
% open with it as a provenance marker.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

implements(Key) :-
    citation(Key, _).

citation(eu_dir_2022_2555_art_2_1, [label-'Directive (EU) 2022/2555 Art 2(1)', ref-'32022L2555#parag_002.001', verbatim-'This Directive applies to public or private entities of a type referred to in Annex I or II which qualify as medium-sized enterprises under Article 2 of the Annex to Recommendation 2003/361/EC, or exceed the ceilings for medium-sized enterprises provided for in paragraph 1 of that Article, and which provide their services or carry out their activities within the Union.']).

citation(eu_dir_2022_2555_art_2_2, [label-'Directive (EU) 2022/2555 Art 2(2) (chapeau)', ref-'32022L2555#parag_002.002', verbatim-'Regardless of their size, this Directive also applies to entities of a type referred to in Annex I or II, where:']).

citation(eu_dir_2022_2555_art_2_2_a_i, [label-'Directive (EU) 2022/2555 Art 2(2), point (a)(i)', ref-'32022L2555#point_002.002_a_i', verbatim-'providers of public electronic communications networks or of publicly available electronic communications services']).

citation(eu_dir_2022_2555_art_2_2_a_ii, [label-'Directive (EU) 2022/2555 Art 2(2), point (a)(ii)', ref-'32022L2555#point_002.002_a_ii', verbatim-'trust service providers']).

citation(eu_dir_2022_2555_art_2_2_a_iii, [label-'Directive (EU) 2022/2555 Art 2(2), point (a)(iii)', ref-'32022L2555#point_002.002_a_iii', verbatim-'top-level domain name registries and domain name system service providers']).

citation(eu_dir_2022_2555_art_2_2_b, [label-'Directive (EU) 2022/2555 Art 2(2), point (b)', ref-'32022L2555#point_002.002_b', verbatim-'the entity is the sole provider in a Member State of a service which is essential for the maintenance of critical societal or economic activities']).

citation(eu_dir_2022_2555_art_2_2_c, [label-'Directive (EU) 2022/2555 Art 2(2), point (c)', ref-'32022L2555#point_002.002_c', verbatim-'disruption of the service provided by the entity could have a significant impact on public safety, public security or public health']).

citation(eu_dir_2022_2555_art_2_2_d, [label-'Directive (EU) 2022/2555 Art 2(2), point (d)', ref-'32022L2555#point_002.002_d', verbatim-'disruption of the service provided by the entity could induce a significant systemic risk, in particular for sectors where such disruption could have a cross-border impact']).

citation(eu_dir_2022_2555_art_2_2_e, [label-'Directive (EU) 2022/2555 Art 2(2), point (e)', ref-'32022L2555#point_002.002_e', verbatim-'the entity is critical because of its specific importance at national or regional level for the particular sector or type of service, or for other interdependent sectors in the Member State']).

citation(eu_dir_2022_2555_art_2_2_f_i, [label-'Directive (EU) 2022/2555 Art 2(2), point (f)(i)', ref-'32022L2555#point_002.002_f_i', verbatim-'of central government as defined by a Member State in accordance with national law']).

citation(eu_dir_2022_2555_art_2_2_f_ii, [label-'Directive (EU) 2022/2555 Art 2(2), point (f)(ii)', ref-'32022L2555#point_002.002_f_ii', verbatim-'at regional level as defined by a Member State in accordance with national law that, following a risk-based assessment, provides services the disruption of which could have a significant impact on critical societal or economic activities']).

citation(eu_dir_2022_2555_art_2_3, [label-'Directive (EU) 2022/2555 Art 2(3)', ref-'32022L2555#parag_002.003', verbatim-'Regardless of their size, this Directive applies to entities identified as critical entities under Directive (EU) 2022/2557.']).

citation(eu_dir_2022_2555_art_2_4, [label-'Directive (EU) 2022/2555 Art 2(4)', ref-'32022L2555#parag_002.004', verbatim-'Regardless of their size, this Directive applies to entities providing domain name registration services.']).

citation(eu_dir_2022_2555_art_2_7, [label-'Directive (EU) 2022/2555 Art 2(7)', ref-'32022L2555#parag_002.007', verbatim-'This Directive does not apply to public administration entities that carry out their activities in the areas of national security, public security, defence or law enforcement, including the prevention, investigation, detection and prosecution of criminal offences.']).

citation(eu_dir_2022_2555_art_2_9, [label-'Directive (EU) 2022/2555 Art 2(9)', ref-'32022L2555#parag_002.009', verbatim-'Paragraphs 7 and 8 shall not apply where an entity acts as a trust service provider.']).

citation(eu_dir_2022_2555_art_2_10, [label-'Directive (EU) 2022/2555 Art 2(10)', ref-'32022L2555#parag_002.010', verbatim-'This Directive does not apply to entities which Member States have exempted from the scope of Regulation (EU) 2022/2554 in accordance with Article 2(4) of that Regulation.']).

citation(eu_dir_2022_2555_art_3_1_a, [label-'Directive (EU) 2022/2555 Art 3(1), point (a)', ref-'32022L2555#point_003.001_a', verbatim-'entities of a type referred to in Annex I which exceed the ceilings for medium-sized enterprises provided for in Article 2(1) of the Annex to Recommendation 2003/361/EC']).

citation(eu_dir_2022_2555_art_3_1_b, [label-'Directive (EU) 2022/2555 Art 3(1), point (b)', ref-'32022L2555#point_003.001_b', verbatim-'qualified trust service providers and top-level domain name registries as well as DNS service providers, regardless of their size']).

citation(eu_dir_2022_2555_art_3_1_c, [label-'Directive (EU) 2022/2555 Art 3(1), point (c)', ref-'32022L2555#point_003.001_c', verbatim-'providers of public electronic communications networks or of publicly available electronic communications services which qualify as medium-sized enterprises under Article 2 of the Annex to Recommendation 2003/361/EC']).

citation(eu_dir_2022_2555_art_3_1_d, [label-'Directive (EU) 2022/2555 Art 3(1), point (d)', ref-'32022L2555#point_003.001_d', verbatim-'public administration entities referred to in Article 2(2), point (f)(i)']).

citation(eu_dir_2022_2555_art_3_1_e, [label-'Directive (EU) 2022/2555 Art 3(1), point (e)', ref-'32022L2555#point_003.001_e', verbatim-'any other entities of a type referred to in Annex I or II that are identified by a Member State as essential entities pursuant to Article 2(2), points (b) to (e)']).

citation(eu_dir_2022_2555_art_3_1_f, [label-'Directive (EU) 2022/2555 Art 3(1), point (f)', ref-'32022L2555#point_003.001_f', verbatim-'entities identified as critical entities under Directive (EU) 2022/2557, referred to in Article 2(3) of this Directive']).

citation(eu_dir_2022_2555_art_3_1_g, [label-'Directive (EU) 2022/2555 Art 3(1), point (g)', ref-'32022L2555#point_003.001_g', verbatim-'if the Member State so provides, entities which that Member State identified before 16 January 2023 as operators of essential services in accordance with Directive (EU) 2016/1148 or national law']).

citation(eu_dir_2022_2555_art_3_2, [label-'Directive (EU) 2022/2555 Art 3(2)', ref-'32022L2555#parag_003.002', verbatim-'entities of a type referred to in Annex I or II which do not qualify as essential entities pursuant to paragraph 1 of this Article shall be considered to be important entities']).

:- end_module(citations).
