% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% kernel.clausal -- the SHARED FLOOR for eu/nis2_scope_entity_class (eligibility family).
% DAG root of the determination-slices layout. It holds ONLY the
% PREDICATES that two or more files CALL.
%
% Source: Directive (EU) 2022/2555 (NIS 2 Directive) Art 2 (scope) and
% Art 3(1) and (2) (essential and important entities), pinned unit text of
% 32022L2555 (OJ L 333, 27.12.2022; raw sha256
% 6ee66d5c419d9a056fb98d94083cacf9b818803bd6b416435718e0d4919cb589), with the
% size ceilings of Article 2 of the Annex to Commission Recommendation
% 2003/361/EC to which Art 2(1) refers (quoted from raw pin 32003H0361; not a
% pinned unit of this domain).
%
% What lives here:
% - nis2_scope_entity_class_input_problems/2: the order's INPUT CHECK, written
%   by the scaffold from the typed input contract (attribute_list) and
%   imported by the slice and by queries.clausal;
% - nis2_scope_entity_class_profile_key_order/1: the twenty-one profile keys
%   in root_exports / input_contract order. The input check reads it, the
%   slice reads it (the order of MISSING_KEYS candidates, of the unsure
%   referral and of the PAIRS of inputs_relied_on/1), and fixtures and tests
%   read it (generators).
% It decides no statutory condition, so no clause here carries a marker.
%
% Atoms and data terms need NO declaration and NO import.
%
% Result terms (spelled exactly as the order pins them). Every query yields
% exactly ONE solution (Answer, Citations):
%   size_class(Profile, Size, Citations)
%     Size: microenterprise | small_enterprise | medium_sized_enterprise
%           | large_enterprise | a status compound
%   scope_decision(Profile, Result, Citations)
%     Result: in_scope | out_of_scope | a status compound
%   entity_class(Profile, Class, Citations)
%     Class: essential_entity | important_entity | out_of_scope
%            | a status compound
%   Citations: a flat set-like list of cite(Key), Key a bare citation atom of
%     citations.clausal citation_vocabulary/2; [] for every status compound.
% Status compounds (each stands alone in the answer position, never in a
% list; the bare atom indeterminate is NEVER written):
%   input_problems(Problems)  -- Problems the non-empty list of this check
%   indeterminate([Key])      -- exactly ONE bare missing key atom
%   needs_legal_review(open_textured(Key, cite(CiteKey)),
%                      [inputs_relied_on(Pairs)])
%     -- Pairs: Key-Value pairs of the present judgement keys, in key
%        order; an unscored provenance(Clause, Citations) may follow.
% Input problem terms: duplicate_key(Key), wrong_type(Key), unknown_key(Key),
%   and wrong_type(profile) alone for a profile that is not an attribute list.
% Facade verdict term of the one determination slice:
%   nis2_scope_entity_class_verdict(Class, Citations)
%     Class the entity_class/3 answer, Citations its citation list.
% =====================================================================

:- module(kernel, [nis2_scope_entity_class_input_problems/2, nis2_scope_entity_class_profile_key_order/1]).

:- use_module(library(reif), [memberd_t/3]).

% ---- the profile keys, in root_exports and input_contract order ----
nis2_scope_entity_class_profile_key_order([
    annex_i_type,
    annex_ii_type,
    services_or_activities_in_union,
    staff_headcount,
    annual_turnover_eur,
    annual_balance_sheet_total_eur,
    public_electronic_communications_provider,
    trust_service_provider_status,
    tld_name_registry,
    dns_service_provider,
    sole_provider_of_an_essential_service_in_a_member_state,
    disruption_could_significantly_impact_public_safety_security_or_health,
    disruption_could_induce_a_significant_systemic_risk,
    critical_by_specific_national_or_regional_importance,
    public_administration_kind,
    public_administration_in_national_security_defence_or_law_enforcement,
    critical_entity_under_directive_2022_2557,
    domain_name_registration_service_entity,
    exempted_from_dora_scope_by_member_state,
    identified_by_member_state_as_essential_entity,
    former_operator_of_essential_services_kept_essential_by_member_state
]).

% ---- input checks: the problems a profile has, if any -----------
% nis2_scope_entity_class_input_problems(Profile, Problems): Problems = [] means the profile can be
% judged. Written from the order's typed input contract
% (input_contract.types.profile: attribute_list).
% Each public query calls this check first: it gives its normal answer only when
% Problems = [], and when Problems is not [] it gives the answer the order states for
% a profile with input problems.
% It gives exactly one answer for every Profile, and the answer is ground:
% - a Profile that is not an attribute list [attribute(Key, Value), ...] with a ground
%   Key in every item gives [wrong_type(profile)];
% - otherwise, for each contract key in the contract's key order, duplicate_key(Key) when
%   the key occurs more than once in Profile (whatever its values: none of them is read,
%   so it is never also wrong_type(Key)), else wrong_type(Key) when its one value is
%   outside its type; then unknown_key(Key) for each key outside the contract, in the
%   order of its first occurrence in Profile. Each key is named once. An absent key is
%   not a problem.
% Every step is complementary clauses: exactly one clause holds for each input.
nis2_scope_entity_class_input_problems(Profile, Problems) :-
    attribute_list_t(Profile, IsAttributeList),
    profile_problems(IsAttributeList, Profile, Problems).

profile_problems(false, _, [wrong_type(profile)]).
profile_problems(true, Profile, Problems) :-
    nis2_scope_entity_class_profile_key_order(Keys),
    unknown_keys(Profile, Keys, UnknownKeyProblems),
    key_problems(Keys, Profile, UnknownKeyProblems, Problems).

% The contract: each key and the type of its value.
key_type(annex_i_type, judgement).
key_type(annex_ii_type, judgement).
key_type(services_or_activities_in_union, boolean).
key_type(staff_headcount, non_negative_integer).
key_type(annual_turnover_eur, non_negative_integer).
key_type(annual_balance_sheet_total_eur, non_negative_integer).
key_type(public_electronic_communications_provider, boolean).
key_type(trust_service_provider_status, enum([not_a_trust_service_provider, non_qualified_trust_service_provider, qualified_trust_service_provider])).
key_type(tld_name_registry, boolean).
key_type(dns_service_provider, boolean).
key_type(sole_provider_of_an_essential_service_in_a_member_state, judgement).
key_type(disruption_could_significantly_impact_public_safety_security_or_health, judgement).
key_type(disruption_could_induce_a_significant_systemic_risk, judgement).
key_type(critical_by_specific_national_or_regional_importance, judgement).
key_type(public_administration_kind, enum([not_public_administration, central_government, regional_with_risk_assessed_services, other_public_administration])).
key_type(public_administration_in_national_security_defence_or_law_enforcement, boolean).
key_type(critical_entity_under_directive_2022_2557, boolean).
key_type(domain_name_registration_service_entity, boolean).
key_type(exempted_from_dora_scope_by_member_state, boolean).
key_type(identified_by_member_state_as_essential_entity, boolean).
key_type(former_operator_of_essential_services_kept_essential_by_member_state, boolean).

% attribute_list_t(Term, T): T is true when Term is a list of attribute(Key, Value)
% items, each Key ground; false for anything else, an unbound Term included.
attribute_list_t(Term, false) :-
    var(Term).
attribute_list_t(Term, true) :-
    Term == [].
attribute_list_t(Term, T) :-
    nonvar(Term),
    Term = [Element|Elements],
    attribute_t(Element, ElementIsAttribute),
    attribute_list_t(Elements, ElementsAreAttributes),
    truth_and(ElementIsAttribute, ElementsAreAttributes, T).
attribute_list_t(Term, false) :-
    nonvar(Term),
    Term \== [],
    Term \= [_|_].

attribute_t(Element, false) :-
    var(Element).
attribute_t(Element, T) :-
    nonvar(Element),
    Element = attribute(Key, _),
    term_variables(Key, Variables),
    no_variables_t(Variables, T).
attribute_t(Element, false) :-
    nonvar(Element),
    Element \= attribute(_, _).

no_variables_t([], true).
no_variables_t([_|_], false).

% Unknown keys, in profile order, each once: Known grows by each key named.
unknown_keys([], _, []).
unknown_keys([attribute(Key, _)|Elements], Known, Problems) :-
    memberd_t(Key, Known, IsKnown),
    name_unknown_key(IsKnown, Key, Known, Elements, Problems).

name_unknown_key(true, _, Known, Elements, Problems) :-
    unknown_keys(Elements, Known, Problems).
name_unknown_key(false, Key, Known, Elements, [unknown_key(Key)|Problems]) :-
    unknown_keys(Elements, [Key|Known], Problems).

% Contract keys, in contract order: duplicate_key(Key) when the key occurs more than once
% (none of its values is read), else wrong_type(Key) when its one value is outside the
% key's type. An absent key has no value to check.
key_problems([], _, Problems, Problems).
key_problems([Key|Keys], Profile, LaterProblems, Problems) :-
    key_type(Key, Type),
    key_occurrences(Profile, Key, Occurrences),
    key_problems(Keys, Profile, LaterProblems, KeyProblems),
    name_key_problem(Occurrences, Key, Type, Profile, KeyProblems, Problems).

% key_occurrences(Elements, Key, Occurrences): none, one or many items give Key.
key_occurrences([], _, none).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey == Key,
    key_occurrences(Elements, Key, RestOccurrences),
    one_more_occurrence(RestOccurrences, Occurrences).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey \== Key,
    key_occurrences(Elements, Key, Occurrences).

one_more_occurrence(none, one).
one_more_occurrence(one, many).
one_more_occurrence(many, many).

name_key_problem(none, _, _, _, Problems, Problems).
name_key_problem(many, Key, _, _, Problems, [duplicate_key(Key)|Problems]).
name_key_problem(one, Key, Type, Profile, KeyProblems, Problems) :-
    values_in_type_t(Profile, Key, Type, InType),
    name_wrong_type(InType, Key, KeyProblems, Problems).

name_wrong_type(true, _, Problems, Problems).
name_wrong_type(false, Key, Problems, [wrong_type(Key)|Problems]).

% values_in_type_t(Elements, Key, Type, T): T is true when every value Elements gives Key is
% in Type (true when Elements gives Key none).
values_in_type_t([], _, _, true).
values_in_type_t([attribute(ElementKey, Value)|Elements], Key, Type, T) :-
    ElementKey == Key,
    value_in_type_t(Type, Value, ValueInType),
    values_in_type_t(Elements, Key, Type, RestInType),
    truth_and(ValueInType, RestInType, T).
values_in_type_t([attribute(ElementKey, _)|Elements], Key, Type, T) :-
    ElementKey \== Key,
    values_in_type_t(Elements, Key, Type, T).

% A value with an unbound part is outside every type; a ground one is checked.
value_in_type_t(Type, Value, T) :-
    term_variables(Value, Variables),
    ground_value_in_type_t(Variables, Type, Value, T).

ground_value_in_type_t([_|_], _, _, false).
ground_value_in_type_t([], Type, Value, T) :-
    in_type_t(Type, Value, T).

% in_type_t(Type, Value, T): one clause per type, for a ground Value.
in_type_t(judgement, Value, T) :-
    in_type_t(one_of([boolean, enum([unsure])]), Value, T).

in_type_t(boolean, Value, T) :-
    memberd_t(Value, [true, false], T).

in_type_t(enum(Values), Value, T) :-
    memberd_t(Value, Values, T).

in_type_t(one_of(Types), Value, T) :-
    in_some_type_t(Types, Value, T).

in_type_t(non_negative_integer, Value, T) :-
    non_negative_integer_t(Value, T).

truth_and(true, T, T).
truth_and(false, _, false).

% in_some_type_t(Types, Value, T): T is true when Value is in at least one of Types.
in_some_type_t([], _, false).
in_some_type_t([Type|Types], Value, T) :-
    in_type_t(Type, Value, InType),
    in_some_type_t(Types, Value, InAnother),
    truth_or(InType, InAnother, T).

truth_or(true, _, true).
truth_or(false, T, T).

% integer_t(Value, T): for a ground Value, T is true when it is an integer and false when it is a
% float, an atom or a compound term.
integer_t(Value, true) :-
    integer(Value).
integer_t(Value, false) :-
    float(Value).
integer_t(Value, false) :-
    atom(Value).
integer_t(Value, false) :-
    compound(Value).

% non_negative_integer_t(Value, T): for a ground Value, T is true when it is an integer of 0 or
% more.
non_negative_integer_t(Value, T) :-
    integer_t(Value, IsInteger),
    not_below_zero_t(IsInteger, Value, T).

not_below_zero_t(false, _, false).
not_below_zero_t(true, Value, true) :-
    Value >= 0.
not_below_zero_t(true, Value, false) :-
    Value < 0.

test(the_key_order_holds_twenty_one_keys) :-
    nis2_scope_entity_class_profile_key_order(Keys),
    length(Keys, 21).
test(a_well_formed_profile_has_no_problem) :-
    nis2_scope_entity_class_input_problems([attribute(annex_i_type, unsure), attribute(staff_headcount, 12), attribute(public_administration_kind, central_government)], []).
test(an_empty_profile_has_no_problem) :-
    nis2_scope_entity_class_input_problems([], []).
test(a_repeated_key_is_a_duplicate_only) :-
    nis2_scope_entity_class_input_problems([attribute(tld_name_registry, true), attribute(tld_name_registry, maybe)], [duplicate_key(tld_name_registry)]).
test(problems_come_in_contract_order_then_unknown_keys) :-
    nis2_scope_entity_class_input_problems([attribute(colour, red), attribute(staff_headcount, -1), attribute(annex_i_type, yes), attribute(colour, blue)], [wrong_type(annex_i_type), wrong_type(staff_headcount), unknown_key(colour)]).
test(a_crisp_key_given_unsure_is_a_wrong_type) :-
    nis2_scope_entity_class_input_problems([attribute(dns_service_provider, unsure)], [wrong_type(dns_service_provider)]).
test(a_list_with_a_foreign_element_is_not_a_profile) :-
    nis2_scope_entity_class_input_problems([attribute(annex_i_type, true), foo], [wrong_type(profile)]).
test(a_well_formed_profile_is_not_refused, fail) :-
    nis2_scope_entity_class_input_problems([attribute(annex_i_type, true)], [wrong_type(profile)]).

:- end_module(kernel).
