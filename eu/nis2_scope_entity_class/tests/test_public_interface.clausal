% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_public_interface.clausal -- the package's PUBLIC surface, exercised
% through the generated package facade (what an external caller sees).
% Each fixture subject resolves to its EXPECTED answers of size_class/3,
% scope_decision/3 and entity_class/3 (exactly ONE solution each, citations
% compared as a set); the facade verdict agrees with entity_class/3; every
% checklist is non-empty and cited; near-miss controls get the opposite
% verdict.
% Run: python -m clausal.testing eu/nis2_scope_entity_class/tests/test_public_interface.clausal
% =====================================================================
:- module(test_public_interface, []).
:- use_module(eu/nis2_scope_entity_class, [
    size_class/3,
    scope_decision/3,
    entity_class/3,
    nis2_scope_entity_class_input_problems/2,
    decide_nis2_scope_entity_class/2,
    nis2_scope_entity_class_status/2,
    nis2_scope_entity_class_checklist/2,
    nis2_scope_entity_class_decision_resolvable/1,
    nis2_scope_entity_class_status_values/1,
    nis2_scope_entity_class_subject/1,
    nis2_scope_entity_class_profile_for/2,
    nis2_scope_entity_class_assess/2
]).

% ---- the expected answers: expected(Subject, Query, Answer, Citations) ----
negative_citations([cite(eu_dir_2022_2555_art_2_1), cite(eu_dir_2022_2555_art_2_2), cite(eu_dir_2022_2555_art_2_3), cite(eu_dir_2022_2555_art_2_4)]).

% Subjects with no ground TRUE and no exclusion: out of scope, negative cites.
negative_subject(baseline_micro_outside_annexes).
negative_subject(size_micro_at_ceilings).
negative_subject(size_micro_turnover_one_euro_over).
negative_subject(size_micro_staff_one_over).
negative_subject(size_small_at_ceiling).
negative_subject(size_small_turnover_one_euro_over).
negative_subject(size_small_staff_one_over).
negative_subject(size_medium_at_turnover_ceiling).
negative_subject(size_medium_turnover_one_euro_over).
negative_subject(size_medium_at_balance_sheet_ceiling).
negative_subject(size_medium_staff_one_over).
negative_subject(size_rule_small_annex_one).
negative_subject(size_rule_outside_union).
negative_subject(electronic_communications_outside_annexes).
negative_subject(qualified_trust_service_outside_annexes).
negative_subject(sole_provider_denied_annex_one).
negative_subject(other_public_administration_annex_one).

expected_size(baseline_micro_outside_annexes, microenterprise).
expected_size(size_micro_at_ceilings, microenterprise).
expected_size(size_micro_turnover_one_euro_over, small_enterprise).
expected_size(size_micro_staff_one_over, small_enterprise).
expected_size(size_small_at_ceiling, small_enterprise).
expected_size(size_small_turnover_one_euro_over, medium_sized_enterprise).
expected_size(size_small_staff_one_over, medium_sized_enterprise).
expected_size(size_medium_at_turnover_ceiling, medium_sized_enterprise).
expected_size(size_medium_turnover_one_euro_over, large_enterprise).
expected_size(size_medium_at_balance_sheet_ceiling, medium_sized_enterprise).
expected_size(size_medium_staff_one_over, large_enterprise).
expected_size(size_rule_medium_annex_one, medium_sized_enterprise).
expected_size(size_rule_small_annex_one, small_enterprise).
expected_size(size_rule_outside_union, medium_sized_enterprise).
expected_size(large_annex_one_essential, large_enterprise).
expected_size(medium_annex_one_at_turnover_ceiling, medium_sized_enterprise).
expected_size(large_annex_two_important, large_enterprise).
expected_size(critical_entity, microenterprise).
expected_size(electronic_communications_medium_annex_two, medium_sized_enterprise).
expected_size(electronic_communications_small_annex_two, small_enterprise).
expected_size(unsure_annex_one_communications, microenterprise).
expected_size(partial_figures_above_ceilings, large_enterprise).

expected(Subject, size, Size, [cite(eu_dir_2022_2555_art_2_1)]) :-
    expected_size(Subject, Size).
expected(Subject, scope, out_of_scope, Citations) :-
    negative_subject(Subject),
    negative_citations(Citations).
expected(Subject, class, out_of_scope, Citations) :-
    negative_subject(Subject),
    negative_citations(Citations).
expected(Subject, scope, in_scope, [cite(ScopeKey)]) :-
    expected_in_scope(Subject, ScopeKey, _, _).
expected(Subject, class, Class, [cite(ClassKey)]) :-
    expected_in_scope(Subject, _, Class, ClassKey).
expected(Subject, Query, Answer, Citations) :-
    expected_other(Subject, Query, Answer, Citations).

% expected_in_scope(Subject, ScopeCitationKey, Class, ClassCitationKey)
expected_in_scope(size_rule_medium_annex_one, eu_dir_2022_2555_art_2_1, important_entity, eu_dir_2022_2555_art_3_2).
expected_in_scope(large_annex_one_essential, eu_dir_2022_2555_art_2_1, essential_entity, eu_dir_2022_2555_art_3_1_a).
expected_in_scope(medium_annex_one_at_turnover_ceiling, eu_dir_2022_2555_art_2_1, important_entity, eu_dir_2022_2555_art_3_2).
expected_in_scope(large_annex_two_important, eu_dir_2022_2555_art_2_1, important_entity, eu_dir_2022_2555_art_3_2).
expected_in_scope(critical_entity, eu_dir_2022_2555_art_2_3, essential_entity, eu_dir_2022_2555_art_3_1_f).
expected_in_scope(domain_name_registration, eu_dir_2022_2555_art_2_4, important_entity, eu_dir_2022_2555_art_3_2).
expected_in_scope(electronic_communications_micro_annex_one, eu_dir_2022_2555_art_2_2_a_i, important_entity, eu_dir_2022_2555_art_3_2).
expected_in_scope(electronic_communications_medium_annex_two, eu_dir_2022_2555_art_2_2_a_i, essential_entity, eu_dir_2022_2555_art_3_1_c).
expected_in_scope(electronic_communications_small_annex_two, eu_dir_2022_2555_art_2_2_a_i, important_entity, eu_dir_2022_2555_art_3_2).
expected_in_scope(qualified_trust_service_annex_two, eu_dir_2022_2555_art_2_2_a_ii, essential_entity, eu_dir_2022_2555_art_3_1_b).
expected_in_scope(non_qualified_trust_service_annex_two, eu_dir_2022_2555_art_2_2_a_ii, important_entity, eu_dir_2022_2555_art_3_2).
expected_in_scope(top_level_domain_registry_annex_one, eu_dir_2022_2555_art_2_2_a_iii, essential_entity, eu_dir_2022_2555_art_3_1_b).
expected_in_scope(domain_name_system_annex_two, eu_dir_2022_2555_art_2_2_a_iii, essential_entity, eu_dir_2022_2555_art_3_1_b).
expected_in_scope(sole_provider_annex_one, eu_dir_2022_2555_art_2_2_b, important_entity, eu_dir_2022_2555_art_3_2).
expected_in_scope(public_safety_impact_annex_two, eu_dir_2022_2555_art_2_2_c, important_entity, eu_dir_2022_2555_art_3_2).
expected_in_scope(systemic_risk_annex_one, eu_dir_2022_2555_art_2_2_d, important_entity, eu_dir_2022_2555_art_3_2).
expected_in_scope(specific_importance_annex_two, eu_dir_2022_2555_art_2_2_e, important_entity, eu_dir_2022_2555_art_3_2).
expected_in_scope(central_government_annex_one, eu_dir_2022_2555_art_2_2_f_i, essential_entity, eu_dir_2022_2555_art_3_1_d).
expected_in_scope(regional_administration_annex_one, eu_dir_2022_2555_art_2_2_f_ii, important_entity, eu_dir_2022_2555_art_3_2).
expected_in_scope(national_security_trust_service_critical_entity, eu_dir_2022_2555_art_2_3, essential_entity, eu_dir_2022_2555_art_3_1_f).
expected_in_scope(member_state_identified_essential_annex_one, eu_dir_2022_2555_art_2_2_b, essential_entity, eu_dir_2022_2555_art_3_1_e).
expected_in_scope(former_operator_kept_essential_annex_one, eu_dir_2022_2555_art_2_2_b, essential_entity, eu_dir_2022_2555_art_3_1_g).
expected_in_scope(identified_outside_annexes_registration, eu_dir_2022_2555_art_2_4, important_entity, eu_dir_2022_2555_art_3_2).

unsure_annex_one_pairs([annex_i_type-unsure, annex_ii_type-false, sole_provider_of_an_essential_service_in_a_member_state-false, disruption_could_significantly_impact_public_safety_security_or_health-false, disruption_could_induce_a_significant_systemic_risk-false, critical_by_specific_national_or_regional_importance-false]).

expected_other(national_security_administration_critical_entity, scope, out_of_scope, [cite(eu_dir_2022_2555_art_2_7), cite(eu_dir_2022_2555_art_2_9)]).
expected_other(national_security_administration_critical_entity, class, out_of_scope, [cite(eu_dir_2022_2555_art_2_7), cite(eu_dir_2022_2555_art_2_9)]).
expected_other(resilience_exempted_critical_entity, scope, out_of_scope, [cite(eu_dir_2022_2555_art_2_10)]).
expected_other(resilience_exempted_critical_entity, class, out_of_scope, [cite(eu_dir_2022_2555_art_2_10)]).
expected_other(partial_exempted_only, scope, out_of_scope, [cite(eu_dir_2022_2555_art_2_10)]).
expected_other(partial_exempted_only, class, out_of_scope, [cite(eu_dir_2022_2555_art_2_10)]).
expected_other(partial_balance_sheet_only, size, indeterminate([staff_headcount]), []).
expected_other(partial_annex_one_only, scope, indeterminate([exempted_from_dora_scope_by_member_state]), []).
expected_other(unsure_annex_one_communications, scope, needs_legal_review(open_textured(annex_i_type, cite(eu_dir_2022_2555_art_2_1)), [inputs_relied_on(Pairs)]), []) :-
    unsure_annex_one_pairs(Pairs).
expected_other(unsure_annex_one_communications, class, needs_legal_review(open_textured(annex_i_type, cite(eu_dir_2022_2555_art_2_1)), [inputs_relied_on(Pairs)]), []) :-
    unsure_annex_one_pairs(Pairs).
expected_other(partial_critical_entity_without_exclusions, scope, in_scope, [cite(eu_dir_2022_2555_art_2_3)]).
expected_other(partial_critical_entity_without_exclusions, class, essential_entity, [cite(eu_dir_2022_2555_art_3_1_f)]).
expected_other(input_unknown_key, size, input_problems([unknown_key(colour)]), []).
expected_other(input_unknown_key, scope, input_problems([unknown_key(colour)]), []).
expected_other(input_unknown_key, class, input_problems([unknown_key(colour)]), []).
expected_other(input_negative_headcount, size, input_problems([wrong_type(staff_headcount)]), []).
expected_other(input_negative_headcount, scope, input_problems([wrong_type(staff_headcount)]), []).
expected_other(input_negative_headcount, class, input_problems([wrong_type(staff_headcount)]), []).

% ---- checking helpers ----
query_answers(size, Profile, Answers) :-
    findall(Answer-Citations, size_class(Profile, Answer, Citations), Answers).
query_answers(scope, Profile, Answers) :-
    findall(Answer-Citations, scope_decision(Profile, Answer, Citations), Answers).
query_answers(class, Profile, Answers) :-
    findall(Answer-Citations, entity_class(Profile, Answer, Citations), Answers).

same_citations(Actual, Expected) :-
    msort(Actual, Sorted),
    msort(Expected, Sorted).

check_expectation(expectation(Subject, Query, Answer, Citations)) :-
    nis2_scope_entity_class_profile_for(Subject, Profile),
    query_answers(Query, Profile, Answers),
    Answers = [Answer-ActualCitations],
    same_citations(ActualCitations, Citations).

check_subject(Subject) :-
    findall(expectation(Subject, Query, Answer, Citations), expected(Subject, Query, Answer, Citations), Expectations),
    Expectations = [_|_],
    maplist(check_expectation, Expectations).

check_facade(expectation(Subject, class, Class, Citations)) :-
    nis2_scope_entity_class_profile_for(Subject, Profile),
    findall(Verdict, decide_nis2_scope_entity_class(Profile, Verdict), Verdicts),
    Verdicts = [nis2_scope_entity_class_verdict(Class, ActualCitations)],
    same_citations(ActualCitations, Citations).

cited_item(item(_, _, cite(_))).

has_cited_checklist(Subject) :-
    nis2_scope_entity_class_profile_for(Subject, Profile),
    nis2_scope_entity_class_decision_resolvable(Profile),
    nis2_scope_entity_class_checklist(Profile, [FirstItem|OtherItems]),
    maplist(cited_item, [FirstItem|OtherItems]).

final_status(Subject) :-
    nis2_scope_entity_class_status_values(StatusValues),
    nis2_scope_entity_class_assess(Subject, nis2_scope_entity_class_verdict(Status, [_|_])),
    member(Status, StatusValues).

profile_of(Subject, Profile) :-
    nis2_scope_entity_class_profile_for(Subject, Profile).

% A referral CONTEXT: inputs_relied_on(PAIRS), optionally followed by one
% unscored provenance(CLAUSE, CITATIONS) element (INTERFACE - THE RESULT FORM).
referral_context([inputs_relied_on(Pairs)]) :-
    is_list(Pairs).
referral_context([inputs_relied_on(Pairs), provenance(Clause, Citations)]) :-
    is_list(Pairs),
    atom(Clause),
    is_list(Citations).

% ---- the whole fixture set ----
test(every_subject_resolves_to_its_expected_answers) :-
    findall(Subject, nis2_scope_entity_class_subject(Subject), Subjects),
    Subjects = [_|_],
    maplist(check_subject, Subjects).

test(the_facade_verdict_agrees_with_entity_class) :-
    findall(expectation(Subject, class, Class, Citations), expected(Subject, class, Class, Citations), Expectations),
    Expectations = [_|_],
    maplist(check_facade, Expectations).

test(every_subject_has_a_non_empty_cited_checklist) :-
    findall(Subject, nis2_scope_entity_class_subject(Subject), Subjects),
    maplist(has_cited_checklist, Subjects).

test(final_classes_are_status_values_with_citations) :-
    maplist(final_status, [baseline_micro_outside_annexes, critical_entity, domain_name_registration, national_security_administration_critical_entity]).

% ---- named routes (concrete status per subject) ----
test(the_baseline_is_out_of_scope) :-
    nis2_scope_entity_class_assess(baseline_micro_outside_annexes, nis2_scope_entity_class_verdict(out_of_scope, _)).
test(a_critical_entity_is_essential) :-
    nis2_scope_entity_class_assess(critical_entity, nis2_scope_entity_class_verdict(essential_entity, [cite(eu_dir_2022_2555_art_3_1_f)])).
test(a_domain_name_registrar_is_important_by_default) :-
    nis2_scope_entity_class_assess(domain_name_registration, nis2_scope_entity_class_verdict(important_entity, [cite(eu_dir_2022_2555_art_3_2)])).
test(a_large_annex_one_entity_is_essential) :-
    check_subject(large_annex_one_essential).
test(a_central_government_entity_is_essential) :-
    nis2_scope_entity_class_profile_for(central_government_annex_one, Profile),
    nis2_scope_entity_class_status(Profile, essential_entity).
test(the_national_security_exclusion_cites_paragraphs_seven_and_nine) :-
    check_subject(national_security_administration_critical_entity).
test(an_unsure_annex_type_is_referred_to_a_lawyer) :-
    check_subject(unsure_annex_one_communications).
test(the_input_check_reports_an_unknown_key) :-
    profile_of(input_unknown_key, Profile),
    nis2_scope_entity_class_input_problems(Profile, [unknown_key(colour)]).
test(a_well_formed_fixture_has_no_input_problem) :-
    profile_of(critical_entity, Profile),
    nis2_scope_entity_class_input_problems(Profile, []).

% ---- the referral context and its optional provenance element ----
test(a_referral_context_is_well_formed) :-
    profile_of(unsure_annex_one_communications, Profile),
    scope_decision(Profile, needs_legal_review(open_textured(annex_i_type, cite(eu_dir_2022_2555_art_2_1)), Context), []),
    referral_context(Context).
test(a_referral_context_may_carry_one_unscored_provenance) :-
    referral_context([inputs_relied_on([annex_i_type-unsure]), provenance(scope_public_electronic_communications, [cite(eu_dir_2022_2555_art_2_2_a_i)])]).
test(a_provenance_never_stands_first_in_a_context, fail) :-
    referral_context([provenance(scope_public_electronic_communications, [cite(eu_dir_2022_2555_art_2_2_a_i)]), inputs_relied_on([annex_i_type-unsure])]).

% ---- size boundaries: at the ceiling and one unit over ----
test(nine_persons_at_two_million_is_micro) :-
    profile_of(size_micro_at_ceilings, Profile),
    size_class(Profile, microenterprise, [cite(eu_dir_2022_2555_art_2_1)]).
test(one_euro_over_the_micro_ceiling_is_small) :-
    profile_of(size_micro_turnover_one_euro_over, Profile),
    size_class(Profile, small_enterprise, _).
test(one_euro_over_the_micro_ceiling_is_not_micro, fail) :-
    profile_of(size_micro_turnover_one_euro_over, Profile),
    size_class(Profile, microenterprise, _).
test(ten_persons_is_not_micro, fail) :-
    profile_of(size_micro_staff_one_over, Profile),
    size_class(Profile, microenterprise, _).
test(one_euro_over_the_small_ceiling_is_not_small, fail) :-
    profile_of(size_small_turnover_one_euro_over, Profile),
    size_class(Profile, small_enterprise, _).
test(fifty_persons_is_not_small, fail) :-
    profile_of(size_small_staff_one_over, Profile),
    size_class(Profile, small_enterprise, _).
test(at_the_medium_turnover_ceiling_is_not_large, fail) :-
    profile_of(size_medium_at_turnover_ceiling, Profile),
    size_class(Profile, large_enterprise, _).
test(one_euro_over_both_medium_ceilings_is_large) :-
    profile_of(size_medium_turnover_one_euro_over, Profile),
    size_class(Profile, large_enterprise, _).
test(two_hundred_and_fifty_persons_is_not_medium, fail) :-
    profile_of(size_medium_staff_one_over, Profile),
    size_class(Profile, medium_sized_enterprise, _).

% ---- near-miss controls get the opposite verdict ----
test(a_medium_annex_one_entity_is_in_scope) :-
    profile_of(size_rule_medium_annex_one, Profile),
    scope_decision(Profile, in_scope, _).
test(a_small_annex_one_control_is_not_in_scope, fail) :-
    profile_of(size_rule_small_annex_one, Profile),
    scope_decision(Profile, in_scope, _).
test(an_entity_outside_the_union_is_not_in_scope, fail) :-
    profile_of(size_rule_outside_union, Profile),
    scope_decision(Profile, in_scope, _).
test(a_medium_annex_one_entity_is_not_essential, fail) :-
    profile_of(medium_annex_one_at_turnover_ceiling, Profile),
    entity_class(Profile, essential_entity, _).
test(a_large_annex_two_entity_is_not_essential, fail) :-
    profile_of(large_annex_two_important, Profile),
    entity_class(Profile, essential_entity, _).
test(electronic_communications_outside_the_annexes_is_not_in_scope, fail) :-
    profile_of(electronic_communications_outside_annexes, Profile),
    scope_decision(Profile, in_scope, _).
test(a_small_electronic_communications_provider_is_not_essential, fail) :-
    profile_of(electronic_communications_small_annex_two, Profile),
    entity_class(Profile, essential_entity, _).
test(a_qualified_trust_service_outside_the_annexes_is_not_in_scope, fail) :-
    profile_of(qualified_trust_service_outside_annexes, Profile),
    scope_decision(Profile, in_scope, _).
test(a_non_qualified_trust_service_is_not_essential, fail) :-
    profile_of(non_qualified_trust_service_annex_two, Profile),
    entity_class(Profile, essential_entity, _).
test(an_annex_one_entity_without_a_ground_is_not_in_scope, fail) :-
    profile_of(sole_provider_denied_annex_one, Profile),
    scope_decision(Profile, in_scope, _).
test(other_public_administration_is_not_in_scope, fail) :-
    profile_of(other_public_administration_annex_one, Profile),
    scope_decision(Profile, in_scope, _).
test(the_excluded_administration_is_not_in_scope, fail) :-
    profile_of(national_security_administration_critical_entity, Profile),
    scope_decision(Profile, in_scope, _).
test(a_trust_service_administration_is_not_excluded, fail) :-
    profile_of(national_security_trust_service_critical_entity, Profile),
    scope_decision(Profile, out_of_scope, _).
test(an_exempted_critical_entity_is_not_essential, fail) :-
    profile_of(resilience_exempted_critical_entity, Profile),
    entity_class(Profile, essential_entity, _).
test(identification_without_an_annex_type_is_not_essential, fail) :-
    profile_of(identified_outside_annexes_registration, Profile),
    entity_class(Profile, essential_entity, _).
test(an_unsure_annex_type_is_not_a_final_class, fail) :-
    profile_of(unsure_annex_one_communications, Profile),
    entity_class(Profile, important_entity, _).
test(an_input_problem_profile_gets_no_final_class, fail) :-
    profile_of(input_unknown_key, Profile),
    entity_class(Profile, out_of_scope, _).

:- end_module(test_public_interface).
