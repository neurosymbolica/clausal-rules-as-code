% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% queries.clausal -- QUERY-COMBINATOR layer for eu/nis2_scope_entity_class.
% A TOP-LAYER consumer: it imports the determination slice's PUBLIC
% predicates it calls, and nothing else.
%
% Query types served by this package:
%   #2 eligibility   -- decide_nis2_scope_entity_class/2 and
%                       nis2_scope_entity_class_status/2 (slice): the class
%                       verdict (essential_entity | important_entity |
%                       out_of_scope | a status compound) with its citations;
%                       size_class/3, scope_decision/3, entity_class/3 (slice).
%   #7 justification -- nis2_scope_entity_class_checklist/2 (slice): one
%                       item(GroundId, Status, cite(Key)) per ground X1, X2,
%                       G1 to G13, E1 to E9, every item cited.
%   #16 what-if      -- nis2_scope_entity_class_what_if/4 (here): override one
%                       key of the attribute list and re-evaluate the class.
%
% nis2_scope_entity_class_profile_keys/1: top-level profile key schema
% nis2_scope_entity_class_input_problems/2: the problems a profile has ([] = none),
%   re-exported as the scaffold wrote it in kernel.clausal.
%
% ROOT EXPORTS: the twenty-one profile key atoms, the judgement value unsure,
% the seven enumeration atoms and the answer atoms are served here as
% package-root names (0-arity facts), so the scorer can read each one as a
% module attribute. The result constructors are exported as data: they have
% no clauses (declared with constructors/1 below).
%
% This layer decides no statutory condition, so it carries no provenance
% marker: every statutory step is in the slice.
% =====================================================================

:- module(queries, [
    nis2_scope_entity_class_profile_keys/1,
    nis2_scope_entity_class_input_problems/2,
    nis2_scope_entity_class_what_if/4,
    annex_i_type/0,
    annex_ii_type/0,
    services_or_activities_in_union/0,
    staff_headcount/0,
    annual_turnover_eur/0,
    annual_balance_sheet_total_eur/0,
    public_electronic_communications_provider/0,
    trust_service_provider_status/0,
    tld_name_registry/0,
    dns_service_provider/0,
    sole_provider_of_an_essential_service_in_a_member_state/0,
    disruption_could_significantly_impact_public_safety_security_or_health/0,
    disruption_could_induce_a_significant_systemic_risk/0,
    critical_by_specific_national_or_regional_importance/0,
    public_administration_kind/0,
    public_administration_in_national_security_defence_or_law_enforcement/0,
    critical_entity_under_directive_2022_2557/0,
    domain_name_registration_service_entity/0,
    exempted_from_dora_scope_by_member_state/0,
    identified_by_member_state_as_essential_entity/0,
    former_operator_of_essential_services_kept_essential_by_member_state/0,
    unsure/0,
    not_a_trust_service_provider/0,
    non_qualified_trust_service_provider/0,
    qualified_trust_service_provider/0,
    not_public_administration/0,
    central_government/0,
    regional_with_risk_assessed_services/0,
    other_public_administration/0,
    microenterprise/0,
    small_enterprise/0,
    medium_sized_enterprise/0,
    large_enterprise/0,
    in_scope/0,
    out_of_scope/0,
    essential_entity/0,
    important_entity/0,
    indeterminate/1,
    needs_legal_review/2,
    open_textured/2,
    inputs_relied_on/1,
    provenance/2,
    input_problems/1,
    unknown_key/1,
    wrong_type/1,
    duplicate_key/1
]).

:- use_module(library(reif), [if_/3]).
:- use_module(eu/nis2_scope_entity_class/kernel, [nis2_scope_entity_class_input_problems/2]).
:- use_module(eu/nis2_scope_entity_class/nis2_scope_entity_class, [nis2_scope_entity_class_status/2]).

% ---- result constructors (exported, never called as queries; data, no clauses) ----
:- constructors([
    indeterminate(missing_keys),
    needs_legal_review(reason, context),
    open_textured(key, citation),
    inputs_relied_on(pairs),
    provenance(clause, citations),
    input_problems(problems),
    unknown_key(key),
    wrong_type(key),
    duplicate_key(key)
]).

% schema of top-level profile keys: the keys of the order's typed input contract, in its order
nis2_scope_entity_class_profile_keys([annex_i_type, annex_ii_type, services_or_activities_in_union, staff_headcount, annual_turnover_eur, annual_balance_sheet_total_eur, public_electronic_communications_provider, trust_service_provider_status, tld_name_registry, dns_service_provider, sole_provider_of_an_essential_service_in_a_member_state, disruption_could_significantly_impact_public_safety_security_or_health, disruption_could_induce_a_significant_systemic_risk, critical_by_specific_national_or_regional_importance, public_administration_kind, public_administration_in_national_security_defence_or_law_enforcement, critical_entity_under_directive_2022_2557, domain_name_registration_service_entity, exempted_from_dora_scope_by_member_state, identified_by_member_state_as_essential_entity, former_operator_of_essential_services_kept_essential_by_member_state]).

% ---- root exports: the profile key atoms ----
annex_i_type.
annex_ii_type.
services_or_activities_in_union.
staff_headcount.
annual_turnover_eur.
annual_balance_sheet_total_eur.
public_electronic_communications_provider.
trust_service_provider_status.
tld_name_registry.
dns_service_provider.
sole_provider_of_an_essential_service_in_a_member_state.
disruption_could_significantly_impact_public_safety_security_or_health.
disruption_could_induce_a_significant_systemic_risk.
critical_by_specific_national_or_regional_importance.
public_administration_kind.
public_administration_in_national_security_defence_or_law_enforcement.
critical_entity_under_directive_2022_2557.
domain_name_registration_service_entity.
exempted_from_dora_scope_by_member_state.
identified_by_member_state_as_essential_entity.
former_operator_of_essential_services_kept_essential_by_member_state.

% ---- root exports: the judgement value besides true and false ----
unsure.

% ---- root exports: the enumeration atoms ----
not_a_trust_service_provider.
non_qualified_trust_service_provider.
qualified_trust_service_provider.
not_public_administration.
central_government.
regional_with_risk_assessed_services.
other_public_administration.

% ---- root exports: the answer atoms ----
microenterprise.
small_enterprise.
medium_sized_enterprise.
large_enterprise.
in_scope.
out_of_scope.
essential_entity.
important_entity.

% #16 what-if: re-evaluate with one key hypothetically set. The profile is an
% attribute list, so every item of the overridden key is dropped and the one
% new item attribute(Key, Value) is added (an absent key is thereby added).
nis2_scope_entity_class_what_if(Profile, OverriddenKey, NewValue, NewStatus) :-
    attribute_override(Profile, OverriddenKey, NewValue, Hypothesis),
    nis2_scope_entity_class_status(Hypothesis, NewStatus).

% List plumbing (no statutory content).
attribute_override(Profile, OverriddenKey, NewValue, Hypothesis) :-
    tfilter(other_key_t(OverriddenKey), Profile, OtherAttributes),
    append(OtherAttributes, [attribute(OverriddenKey, NewValue)], Hypothesis).

other_key_t(OverriddenKey, attribute(ElementKey, _), Truth) :-
    if_(ElementKey = OverriddenKey, Truth = false, Truth = true).

test(the_key_schema_holds_twenty_one_keys) :-
    nis2_scope_entity_class_profile_keys(Keys),
    length(Keys, 21).
test(a_hypothetical_exemption_takes_the_entity_out_of_scope) :-
    nis2_scope_entity_class_what_if([], exempted_from_dora_scope_by_member_state, true, out_of_scope).
test(an_override_replaces_the_present_value) :-
    nis2_scope_entity_class_what_if([attribute(exempted_from_dora_scope_by_member_state, false)], exempted_from_dora_scope_by_member_state, true, out_of_scope).
test(an_override_answers_once) :-
    findall(Status, nis2_scope_entity_class_what_if([attribute(exempted_from_dora_scope_by_member_state, false)], exempted_from_dora_scope_by_member_state, true, Status), Statuses),
    Statuses == [out_of_scope].
test(a_hypothetical_exemption_is_not_essential, fail) :-
    nis2_scope_entity_class_what_if([], exempted_from_dora_scope_by_member_state, true, essential_entity).
test(the_root_atoms_are_served) :-
    annex_i_type,
    unsure,
    qualified_trust_service_provider,
    central_government,
    large_enterprise,
    important_entity.

:- end_module(queries).
