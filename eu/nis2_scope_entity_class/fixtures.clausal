% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% fixtures.clausal -- representative profiles for eu/nis2_scope_entity_class.
% A TOP-LAYER consumer: imports the determination slice PUBLIC predicates it calls.
%
% A profile is an attribute list [attribute(Key, Value), ...]. Every subject is the
% fully negative default profile with a few keys overridden, so each route has a
% positive case and a one-unit near-miss control (at-boundary / just-below pairs for
% every size ceiling).
% =====================================================================

:- module(fixtures, [
    nis2_scope_entity_class_subject/1,
    nis2_scope_entity_class_profile_for/2,
    nis2_scope_entity_class_assess/2
]).

:- use_module(eu/nis2_scope_entity_class/nis2_scope_entity_class, [decide_nis2_scope_entity_class/2]).

% ---- Subject registry ------------------------------------------------
nis2_scope_entity_class_subject(baseline_out_of_scope).
nis2_scope_entity_class_subject(critical_entity).
nis2_scope_entity_class_subject(domain_registrar).
nis2_scope_entity_class_subject(micro_at_ceiling).
nis2_scope_entity_class_subject(small_staff_at_ten).
nis2_scope_entity_class_subject(small_one_euro_over_micro).
nis2_scope_entity_class_subject(medium_annex_at_staff_floor).
nis2_scope_entity_class_subject(small_annex_just_below).
nis2_scope_entity_class_subject(small_annex_one_figure_over).
nis2_scope_entity_class_subject(small_annex_one_euro_over_both).
nis2_scope_entity_class_subject(large_annex_by_staff).
nis2_scope_entity_class_subject(medium_annex_staff_just_below_large).
nis2_scope_entity_class_subject(large_annex_by_financials).
nis2_scope_entity_class_subject(medium_annex_one_figure_at_ceiling).
nis2_scope_entity_class_subject(annex_ii_large).
nis2_scope_entity_class_subject(electronic_communications_micro).
nis2_scope_entity_class_subject(electronic_communications_medium).
nis2_scope_entity_class_subject(electronic_communications_not_provider).
nis2_scope_entity_class_subject(qualified_trust_provider).
nis2_scope_entity_class_subject(non_qualified_trust_provider).
nis2_scope_entity_class_subject(tld_registry).
nis2_scope_entity_class_subject(dns_provider).
nis2_scope_entity_class_subject(sole_provider).
nis2_scope_entity_class_subject(sole_provider_without_annex_type).
nis2_scope_entity_class_subject(safety_disruption).
nis2_scope_entity_class_subject(systemic_risk).
nis2_scope_entity_class_subject(national_importance).
nis2_scope_entity_class_subject(central_government).
nis2_scope_entity_class_subject(regional_government).
nis2_scope_entity_class_subject(other_public_administration).
nis2_scope_entity_class_subject(national_security_exclusion).
nis2_scope_entity_class_subject(national_security_trust_provider).
nis2_scope_entity_class_subject(dora_exemption).
nis2_scope_entity_class_subject(identified_essential).
nis2_scope_entity_class_subject(former_operator_essential).
nis2_scope_entity_class_subject(unsure_sole_provider).
nis2_scope_entity_class_subject(unsure_annex_medium).
nis2_scope_entity_class_subject(unsure_annex_class).
nis2_scope_entity_class_subject(empty_profile).
nis2_scope_entity_class_subject(unknown_key_profile).
nis2_scope_entity_class_subject(duplicate_key_profile).

% ---- Profiles --------------------------------------------------------
nis2_scope_entity_class_profile_for(empty_profile, []).
nis2_scope_entity_class_profile_for(unknown_key_profile, [attribute(bogus, true)]).
nis2_scope_entity_class_profile_for(duplicate_key_profile, [attribute(staff_headcount, 1), attribute(staff_headcount, 2)]).
nis2_scope_entity_class_profile_for(Subject, Profile) :-
    subject_overrides(Subject, Overrides),
    default_profile(Default),
    apply_overrides(Overrides, Default, Profile).

% The fully negative micro entity: no Annex type, no ground, no exclusion.
default_profile([
    attribute(annex_i_type, false),
    attribute(annex_ii_type, false),
    attribute(services_or_activities_in_union, true),
    attribute(staff_headcount, 5),
    attribute(annual_turnover_eur, 1000000),
    attribute(annual_balance_sheet_total_eur, 1000000),
    attribute(public_electronic_communications_provider, false),
    attribute(trust_service_provider_status, not_a_trust_service_provider),
    attribute(tld_name_registry, false),
    attribute(dns_service_provider, false),
    attribute(sole_provider_of_an_essential_service_in_a_member_state, false),
    attribute(disruption_could_significantly_impact_public_safety_security_or_health, false),
    attribute(disruption_could_induce_a_significant_systemic_risk, false),
    attribute(critical_by_specific_national_or_regional_importance, false),
    attribute(public_administration_kind, not_public_administration),
    attribute(public_administration_in_national_security_defence_or_law_enforcement, false),
    attribute(critical_entity_under_directive_2022_2557, false),
    attribute(domain_name_registration_service_entity, false),
    attribute(exempted_from_dora_scope_by_member_state, false),
    attribute(identified_by_member_state_as_essential_entity, false),
    attribute(former_operator_of_essential_services_kept_essential_by_member_state, false)
]).

apply_overrides([], Profile, Profile).
apply_overrides([Key-Value|Overrides], ProfileIn, ProfileOut) :-
    set_attribute(ProfileIn, Key, Value, ProfileNext),
    apply_overrides(Overrides, ProfileNext, ProfileOut).

set_attribute([], _, _, []).
set_attribute([attribute(ElementKey, _)|Elements], Key, Value, [attribute(ElementKey, Value)|NewElements]) :-
    ElementKey == Key,
    set_attribute(Elements, Key, Value, NewElements).
set_attribute([attribute(ElementKey, ElementValue)|Elements], Key, Value, [attribute(ElementKey, ElementValue)|NewElements]) :-
    ElementKey \== Key,
    set_attribute(Elements, Key, Value, NewElements).

subject_overrides(baseline_out_of_scope, []).
subject_overrides(critical_entity, [critical_entity_under_directive_2022_2557-true]).
subject_overrides(domain_registrar, [domain_name_registration_service_entity-true]).
subject_overrides(micro_at_ceiling, [staff_headcount-9, annual_turnover_eur-2000000, annual_balance_sheet_total_eur-90000000]).
subject_overrides(small_staff_at_ten, [staff_headcount-10, annual_turnover_eur-2000000, annual_balance_sheet_total_eur-2000000]).
subject_overrides(small_one_euro_over_micro, [staff_headcount-9, annual_turnover_eur-2000001, annual_balance_sheet_total_eur-2000001]).
subject_overrides(medium_annex_at_staff_floor, [annex_i_type-true, staff_headcount-50, annual_turnover_eur-50000000, annual_balance_sheet_total_eur-90000000]).
subject_overrides(small_annex_just_below, [annex_i_type-true, staff_headcount-49, annual_turnover_eur-10000000, annual_balance_sheet_total_eur-10000000]).
subject_overrides(small_annex_one_figure_over, [annex_i_type-true, staff_headcount-49, annual_turnover_eur-10000001, annual_balance_sheet_total_eur-10000000]).
subject_overrides(small_annex_one_euro_over_both, [annex_i_type-true, staff_headcount-49, annual_turnover_eur-10000001, annual_balance_sheet_total_eur-10000001]).
subject_overrides(large_annex_by_staff, [annex_i_type-true, staff_headcount-250, annual_turnover_eur-1000000, annual_balance_sheet_total_eur-1000000]).
subject_overrides(medium_annex_staff_just_below_large, [annex_i_type-true, staff_headcount-249, annual_turnover_eur-50000000, annual_balance_sheet_total_eur-43000001]).
subject_overrides(large_annex_by_financials, [annex_i_type-true, staff_headcount-100, annual_turnover_eur-50000001, annual_balance_sheet_total_eur-43000001]).
subject_overrides(medium_annex_one_figure_at_ceiling, [annex_i_type-true, staff_headcount-100, annual_turnover_eur-50000001, annual_balance_sheet_total_eur-43000000]).
subject_overrides(annex_ii_large, [annex_ii_type-true, staff_headcount-250]).
subject_overrides(electronic_communications_micro, [annex_ii_type-true, public_electronic_communications_provider-true]).
subject_overrides(electronic_communications_medium, [annex_ii_type-true, public_electronic_communications_provider-true, staff_headcount-100, annual_turnover_eur-40000000, annual_balance_sheet_total_eur-90000000]).
subject_overrides(electronic_communications_not_provider, [annex_ii_type-true]).
subject_overrides(qualified_trust_provider, [annex_i_type-true, trust_service_provider_status-qualified_trust_service_provider]).
subject_overrides(non_qualified_trust_provider, [annex_i_type-true, trust_service_provider_status-non_qualified_trust_service_provider]).
subject_overrides(tld_registry, [annex_i_type-true, tld_name_registry-true]).
subject_overrides(dns_provider, [annex_i_type-true, dns_service_provider-true]).
subject_overrides(sole_provider, [annex_ii_type-true, sole_provider_of_an_essential_service_in_a_member_state-true]).
subject_overrides(sole_provider_without_annex_type, [sole_provider_of_an_essential_service_in_a_member_state-true]).
subject_overrides(safety_disruption, [annex_ii_type-true, disruption_could_significantly_impact_public_safety_security_or_health-true]).
subject_overrides(systemic_risk, [annex_ii_type-true, disruption_could_induce_a_significant_systemic_risk-true]).
subject_overrides(national_importance, [annex_ii_type-true, critical_by_specific_national_or_regional_importance-true]).
subject_overrides(central_government, [annex_i_type-true, public_administration_kind-central_government]).
subject_overrides(regional_government, [annex_i_type-true, public_administration_kind-regional_with_risk_assessed_services]).
subject_overrides(other_public_administration, [annex_i_type-true, public_administration_kind-other_public_administration]).
subject_overrides(national_security_exclusion, [public_administration_in_national_security_defence_or_law_enforcement-true, critical_entity_under_directive_2022_2557-true]).
subject_overrides(national_security_trust_provider, [public_administration_in_national_security_defence_or_law_enforcement-true, trust_service_provider_status-qualified_trust_service_provider, critical_entity_under_directive_2022_2557-true]).
subject_overrides(dora_exemption, [exempted_from_dora_scope_by_member_state-true, critical_entity_under_directive_2022_2557-true]).
subject_overrides(identified_essential, [annex_i_type-true, sole_provider_of_an_essential_service_in_a_member_state-true, identified_by_member_state_as_essential_entity-true]).
subject_overrides(former_operator_essential, [annex_ii_type-true, sole_provider_of_an_essential_service_in_a_member_state-true, former_operator_of_essential_services_kept_essential_by_member_state-true]).
subject_overrides(unsure_sole_provider, [annex_ii_type-true, sole_provider_of_an_essential_service_in_a_member_state-unsure]).
subject_overrides(unsure_annex_medium, [annex_i_type-unsure, staff_headcount-100, annual_turnover_eur-40000000, annual_balance_sheet_total_eur-90000000]).
subject_overrides(unsure_annex_class, [annex_i_type-unsure, domain_name_registration_service_entity-true, staff_headcount-300]).

% ---- Convenience wrapper ---------------------------------------------
nis2_scope_entity_class_assess(Subject, Result) :-
    nis2_scope_entity_class_profile_for(Subject, Profile),
    decide_nis2_scope_entity_class(Profile, Result).

:- end_module(fixtures).
