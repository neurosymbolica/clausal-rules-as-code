% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% queries.clausal -- QUERY layer for eu/nis2_jurisdiction_registration.
% A TOP-LAYER consumer: it imports the determination slice PUBLIC predicates
% it calls, and nothing else.
%
% Query types served (see manifest query_interface):
%   #2  eligibility    nis2_jurisdiction_registration_status/2 (slice)
%   #7  justification  nis2_jurisdiction_registration_checklist/2 (slice), cite(...) per row
%   #16 what-if        nis2_jurisdiction_registration_what_if/4
%
% nis2_jurisdiction_registration_what_if/4         override one key, re-evaluate the verdict status
% nis2_jurisdiction_registration_status_by_category/2  enumeration: the status under each entity category
% nis2_jurisdiction_registration_profile_keys/1    the profile key schema
% nis2_jurisdiction_registration_input_problems/2  the problems a profile has ([] = none)
% =====================================================================

:- module(queries, [
    nis2_jurisdiction_registration_profile_keys/1,
    nis2_jurisdiction_registration_input_problems/2,
    nis2_jurisdiction_registration_what_if/4,
    nis2_jurisdiction_registration_status_by_category/2
]).

:- use_module(eu/nis2_jurisdiction_registration/kernel, [nis2_jurisdiction_registration_input_problems/2]).
:- use_module(eu/nis2_jurisdiction_registration/nis2_jurisdiction_registration, [nis2_jurisdiction_registration_status/2]).

% schema of top-level profile keys: the keys of the order's typed input contract, in its order
nis2_jurisdiction_registration_profile_keys([entity_category, established_in_union, offers_services_in_union, representative_designated_in_union, decisions_predominantly_taken_in_one_union_member_state, cybersecurity_operations_carried_out_in_one_union_member_state, sector_and_subsector_applicable, member_states_list_applicable]).

% what-if: re-evaluate with one key hypothetically overridden
nis2_jurisdiction_registration_what_if(Profile, OverriddenKey, NewValue, NewStatus) :-
    override_attribute(Profile, OverriddenKey, NewValue, Hypothesis),
    nis2_jurisdiction_registration_status(Hypothesis, NewStatus).

% enumeration: the status of the profile under each of the four entity categories
nis2_jurisdiction_registration_status_by_category(Profile, Pairs) :-
    findall(
        Category-Status,
        (
            member(Category, [general_entity, public_electronic_communications_provider, main_establishment_provider, public_administration_entity]),
            nis2_jurisdiction_registration_what_if(Profile, entity_category, Category, Status)
        ),
        Pairs).

% override_attribute(Profile, Key, Value, NewProfile): drop every attribute of Key, then set it.
override_attribute(Profile, Key, Value, [attribute(Key, Value)|Kept]) :-
    drop_attribute(Profile, Key, Kept).

drop_attribute([], _, []).
drop_attribute([attribute(OtherKey, OtherValue)|Rest], Key, [attribute(OtherKey, OtherValue)|Kept]) :-
    dif(OtherKey, Key),
    drop_attribute(Rest, Key, Kept).
drop_attribute([attribute(Key, _)|Rest], Key, Kept) :-
    drop_attribute(Rest, Key, Kept).

:- end_module(queries).
