% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_robustness.clausal -- ROBUSTNESS of the input check nis2_jurisdiction_registration_input_problems/2 for a
% PROFILE that is an attribute list [attribute(Key, Value), ...]: an empty list, a
% value that is not a list, an unknown key and a value outside its type each get exactly
% one answer. Written by the scaffold from the order's typed input contract
% (input_contract.types.profile: attribute_list), not by the producer;
% do not edit or delete.
% Run: python -m clausal.testing eu/nis2_jurisdiction_registration/tests/test_robustness.clausal
% =====================================================================
:- module(test_robustness, []).
:- use_module(eu/nis2_jurisdiction_registration/queries, [nis2_jurisdiction_registration_input_problems/2]).

test(an_empty_attribute_list_gets_exactly_one_answer) :-
    findall(Problems, nis2_jurisdiction_registration_input_problems([], Problems), Answers),
    Answers == [[]].

test(a_profile_that_is_not_a_list_gets_one_non_empty_answer) :-
    findall(Problems, nis2_jurisdiction_registration_input_problems(not_a_profile, Problems), Answers),
    Answers = [[_|_]].

test(an_unknown_key_is_named) :-
    findall(Problems, nis2_jurisdiction_registration_input_problems([attribute(not_a_key_of_the_contract, general_entity)], Problems), Answers),
    Answers = [Problems],
    memberchk(unknown_key(not_a_key_of_the_contract), Problems).

test(a_value_outside_the_type_of_entity_category_is_named) :-
    findall(Problems, nis2_jurisdiction_registration_input_problems([attribute(entity_category, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(entity_category), Problems).

test(a_value_outside_the_type_of_established_in_union_is_named) :-
    findall(Problems, nis2_jurisdiction_registration_input_problems([attribute(established_in_union, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(established_in_union), Problems).

test(a_value_outside_the_type_of_decisions_predominantly_taken_in_one_union_member_state_is_named) :-
    findall(Problems, nis2_jurisdiction_registration_input_problems([attribute(decisions_predominantly_taken_in_one_union_member_state, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(decisions_predominantly_taken_in_one_union_member_state), Problems).

:- end_module(test_robustness).
