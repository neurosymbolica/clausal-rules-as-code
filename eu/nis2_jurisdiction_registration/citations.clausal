% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/nis2_jurisdiction_registration.
%
% Source: Directive (EU) 2022/2555 (NIS 2 Directive), OJ L 333, 27.12.2022,
% CELEX 32022L2555. Keys are the corpus lexicon's canonical atoms.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order.
% A clause cites a key with a cite(Key) term; cite(...) is data.
%
% PROVENANCE: every operative clause opens its body with implements(Key).
% implements/1 succeeds for every recorded key and fails for any other.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

implements(Key) :-
    citation(Key, _).

% The governing paragraph of the registry duty (Art 27(2) opening words); its
% points (a) to (f) are the items listed by the determination slice.
registry_governing_provision(cite(eu_dir_2022_2555_art_27_2)).

citation(eu_dir_2022_2555_art_26_1, [label-'Directive (EU) 2022/2555 Art 26(1), opening words', ref-'32022L2555#parag_026.001', verbatim-'Entities falling within the scope of this Directive shall be considered to fall under the jurisdiction of the Member State in which they are established']).

citation(eu_dir_2022_2555_art_26_1_a, [label-'Directive (EU) 2022/2555 Art 26(1)(a)', ref-'32022L2555#point_026.001_a', verbatim-'providers of public electronic communications networks or providers of publicly available electronic communications services, which shall be considered to fall under the jurisdiction of the Member State in which they provide their services']).

citation(eu_dir_2022_2555_art_26_1_b, [label-'Directive (EU) 2022/2555 Art 26(1)(b)', ref-'32022L2555#point_026.001_b', verbatim-'which shall be considered to fall under the jurisdiction of the Member State in which they have their main establishment in the Union under paragraph 2']).

citation(eu_dir_2022_2555_art_26_1_c, [label-'Directive (EU) 2022/2555 Art 26(1)(c)', ref-'32022L2555#point_026.001_c', verbatim-'public administration entities, which shall be considered to fall under the jurisdiction of the Member State which established them']).

citation(eu_dir_2022_2555_art_26_2, [label-'Directive (EU) 2022/2555 Art 26(2)', ref-'32022L2555#parag_026.002', verbatim-'shall be considered to have its main establishment in the Union in the Member State where the decisions related to the cybersecurity risk-management measures are predominantly taken']).

citation(eu_dir_2022_2555_art_26_3, [label-'Directive (EU) 2022/2555 Art 26(3)', ref-'32022L2555#parag_026.003', verbatim-'Such an entity shall be considered to fall under the jurisdiction of the Member State where the representative is established']).

citation(eu_dir_2022_2555_art_27_2, [label-'Directive (EU) 2022/2555 Art 27(2), opening words', ref-'32022L2555#parag_027.002', verbatim-'Member States shall require entities referred to in paragraph 1 to submit the following information to the competent authorities by 17 January 2025']).

citation(eu_dir_2022_2555_art_27_2_a, [label-'Directive (EU) 2022/2555 Art 27(2)(a)', ref-'32022L2555#point_027.002_a', verbatim-'the name of the entity']).

citation(eu_dir_2022_2555_art_27_2_b, [label-'Directive (EU) 2022/2555 Art 27(2)(b)', ref-'32022L2555#point_027.002_b', verbatim-'the relevant sector, subsector and type of entity referred to in Annex I or II, where applicable']).

citation(eu_dir_2022_2555_art_27_2_c, [label-'Directive (EU) 2022/2555 Art 27(2)(c)', ref-'32022L2555#point_027.002_c', verbatim-'its other legal establishments in the Union or, if not established in the Union, of its representative designated pursuant to Article 26(3)']).

citation(eu_dir_2022_2555_art_27_2_d, [label-'Directive (EU) 2022/2555 Art 27(2)(d)', ref-'32022L2555#point_027.002_d', verbatim-'up-to-date contact details, including email addresses and telephone numbers of the entity and, where applicable, its representative designated pursuant to Article 26(3)']).

citation(eu_dir_2022_2555_art_27_2_e, [label-'Directive (EU) 2022/2555 Art 27(2)(e)', ref-'32022L2555#point_027.002_e', verbatim-'the Member States where the entity provides services']).

citation(eu_dir_2022_2555_art_27_2_f, [label-'Directive (EU) 2022/2555 Art 27(2)(f)', ref-'32022L2555#point_027.002_f', verbatim-'IP ranges']).

citation(eu_dir_2022_2555_art_27_3, [label-'Directive (EU) 2022/2555 Art 27(3)', ref-'32022L2555#parag_027.003', verbatim-'notify the competent authority about any changes to the information they submitted under paragraph 2 without delay and in any event within three months of the date of the change']).

citation(eu_dir_2022_2555_art_3_4, [label-'Directive (EU) 2022/2555 Art 3(4), second subparagraph', ref-'32022L2555#parag_003.004', verbatim-'shall notify any changes to the details submitted pursuant to the first subparagraph of this paragraph without delay, and, in any event, within two weeks of the date of the change']).

citation(eu_dir_2022_2555_art_3_4_a, [label-'Directive (EU) 2022/2555 Art 3(4)(a)', ref-'32022L2555#point_003.004_a', verbatim-'the name of the entity']).

citation(eu_dir_2022_2555_art_3_4_b, [label-'Directive (EU) 2022/2555 Art 3(4)(b)', ref-'32022L2555#point_003.004_b', verbatim-'the address and up-to-date contact details, including email addresses, IP ranges and telephone numbers']).

citation(eu_dir_2022_2555_art_3_4_c, [label-'Directive (EU) 2022/2555 Art 3(4)(c)', ref-'32022L2555#point_003.004_c', verbatim-'where applicable, the relevant sector and subsector referred to in Annex I or II']).

citation(eu_dir_2022_2555_art_3_4_d, [label-'Directive (EU) 2022/2555 Art 3(4)(d)', ref-'32022L2555#point_003.004_d', verbatim-'where applicable, a list of the Member States where they provide services falling within the scope of this Directive']).

:- end_module(citations).
