% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/dora_scope_and_entity_types.
%
% Instrument: Regulation (EU) 2022/2554 of the European Parliament and of
% the Council on digital operational resilience for the financial sector
% (DORA), original OJ text as published, OJ L 333, 27.12.2022, p. 1
% (CELEX 32022R2554; pin folder eu/dora_scope_and_entity_types/sources/).
% No consolidated version is pinned.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% Each verbatim below is an exact substring of the pinned unit text named
% in its ref; each key is `status: verified` in citations-sources.yaml.
%
% Keys are the CANONICAL lexicon scheme (_lexicon/citations.yaml); the
% segments reg and art are mandated by that scheme and never shortened.
% lint: C6 reg art (canonical lexicon citation atoms)
%
% PROVENANCE: every operative clause opens its body with implements(Key),
% Key one of the atoms recorded here.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

% implements(Key): the provenance marker; succeeds exactly for a recorded key.
implements(Key) :-
    citation(Key, _).

% ---- Article 2(1): the entities to which the Regulation applies ----
citation(eu_reg_2022_2554_art_2_1, [label-'Regulation (EU) 2022/2554 (DORA) Art 2(1) lead words, scope of application', ref-'OJ L 333, 27.12.2022, p. 1; 32022R2554#parag_002.001', verbatim-'Without prejudice to paragraphs 3 and 4, this Regulation applies to the following entities:']).
citation(eu_reg_2022_2554_art_2_1_a, [label-'Regulation (EU) 2022/2554 (DORA) Art 2(1)(a) credit institutions', ref-'OJ L 333, 27.12.2022, p. 1; 32022R2554#point_002.001_a', verbatim-'credit institutions']).
citation(eu_reg_2022_2554_art_2_1_b, [label-'Regulation (EU) 2022/2554 (DORA) Art 2(1)(b) payment institutions, including exempted payment institutions', ref-'OJ L 333, 27.12.2022, p. 1; 32022R2554#point_002.001_b', verbatim-'payment institutions, including payment institutions exempted pursuant to Directive (EU) 2015/2366']).
citation(eu_reg_2022_2554_art_2_1_c, [label-'Regulation (EU) 2022/2554 (DORA) Art 2(1)(c) account information service providers', ref-'OJ L 333, 27.12.2022, p. 1; 32022R2554#point_002.001_c', verbatim-'account information service providers']).
citation(eu_reg_2022_2554_art_2_1_d, [label-'Regulation (EU) 2022/2554 (DORA) Art 2(1)(d) electronic money institutions, including exempted electronic money institutions', ref-'OJ L 333, 27.12.2022, p. 1; 32022R2554#point_002.001_d', verbatim-'electronic money institutions, including electronic money institutions exempted pursuant to Directive 2009/110/EC']).
citation(eu_reg_2022_2554_art_2_1_e, [label-'Regulation (EU) 2022/2554 (DORA) Art 2(1)(e) investment firms', ref-'OJ L 333, 27.12.2022, p. 1; 32022R2554#point_002.001_e', verbatim-'investment firms']).
citation(eu_reg_2022_2554_art_2_1_f, [label-'Regulation (EU) 2022/2554 (DORA) Art 2(1)(f) authorised crypto-asset service providers and issuers of asset-referenced tokens', ref-'OJ L 333, 27.12.2022, p. 1; 32022R2554#point_002.001_f', verbatim-'crypto-asset service providers as authorised under a Regulation of the European Parliament and of the Council on markets in crypto-assets']).
citation(eu_reg_2022_2554_art_2_1_g, [label-'Regulation (EU) 2022/2554 (DORA) Art 2(1)(g) central securities depositories', ref-'OJ L 333, 27.12.2022, p. 1; 32022R2554#point_002.001_g', verbatim-'central securities depositories']).
citation(eu_reg_2022_2554_art_2_1_h, [label-'Regulation (EU) 2022/2554 (DORA) Art 2(1)(h) central counterparties', ref-'OJ L 333, 27.12.2022, p. 1; 32022R2554#point_002.001_h', verbatim-'central counterparties']).
citation(eu_reg_2022_2554_art_2_1_i, [label-'Regulation (EU) 2022/2554 (DORA) Art 2(1)(i) trading venues', ref-'OJ L 333, 27.12.2022, p. 1; 32022R2554#point_002.001_i', verbatim-'trading venues']).
citation(eu_reg_2022_2554_art_2_1_j, [label-'Regulation (EU) 2022/2554 (DORA) Art 2(1)(j) trade repositories', ref-'OJ L 333, 27.12.2022, p. 1; 32022R2554#point_002.001_j', verbatim-'trade repositories']).
citation(eu_reg_2022_2554_art_2_1_k, [label-'Regulation (EU) 2022/2554 (DORA) Art 2(1)(k) managers of alternative investment funds', ref-'OJ L 333, 27.12.2022, p. 1; 32022R2554#point_002.001_k', verbatim-'managers of alternative investment funds']).
citation(eu_reg_2022_2554_art_2_1_l, [label-'Regulation (EU) 2022/2554 (DORA) Art 2(1)(l) management companies', ref-'OJ L 333, 27.12.2022, p. 1; 32022R2554#point_002.001_l', verbatim-'management companies']).
