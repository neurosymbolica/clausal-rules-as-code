citation(eu_reg_2022_2554_art_2_1_u, [label-'Regulation (EU) 2022/2554 (DORA) Art 2(1)(u) ICT third-party service providers', ref-'OJ L 333, 27.12.2022, p. 1; 32022R2554#point_002.001_u', verbatim-'ICT third-party service providers']).

% ---- Article 2(2): financial entities ----
citation(eu_reg_2022_2554_art_2_2, [label-'Regulation (EU) 2022/2554 (DORA) Art 2(2) collective name financial entities for Art 2(1)(a) to (t)', ref-'OJ L 333, 27.12.2022, p. 1; 32022R2554#parag_002.002', verbatim-'entities referred to in paragraph 1, points (a) to (t), shall collectively be referred to as']).

% ---- Article 2(3): the exclusions ----
citation(eu_reg_2022_2554_art_2_3, [label-'Regulation (EU) 2022/2554 (DORA) Art 2(3) lead words, the Regulation does not apply to the entities listed', ref-'OJ L 333, 27.12.2022, p. 1; 32022R2554#parag_002.003', verbatim-'This Regulation does not apply to:']).
citation(eu_reg_2022_2554_art_2_3_a, [label-'Regulation (EU) 2022/2554 (DORA) Art 2(3)(a) exclusion of managers referred to in Art 3(2) of Directive 2011/61/EU', ref-'OJ L 333, 27.12.2022, p. 1; 32022R2554#point_002.003_a', verbatim-'managers of alternative investment funds as referred to in Article 3(2) of Directive 2011/61/EU']).
citation(eu_reg_2022_2554_art_2_3_b, [label-'Regulation (EU) 2022/2554 (DORA) Art 2(3)(b) exclusion of undertakings referred to in Art 4 of Directive 2009/138/EC', ref-'OJ L 333, 27.12.2022, p. 1; 32022R2554#point_002.003_b', verbatim-'insurance and reinsurance undertakings as referred to in Article 4 of Directive 2009/138/EC']).
citation(eu_reg_2022_2554_art_2_3_c, [label-'Regulation (EU) 2022/2554 (DORA) Art 2(3)(c) exclusion of occupational retirement institutions with not more than 15 members in total', ref-'OJ L 333, 27.12.2022, p. 1; 32022R2554#point_002.003_c', verbatim-'institutions for occupational retirement provision which operate pension schemes which together do not have more than 15 members in total']).
citation(eu_reg_2022_2554_art_2_3_d, [label-'Regulation (EU) 2022/2554 (DORA) Art 2(3)(d) exclusion of persons exempted pursuant to Arts 2 and 3 of Directive 2014/65/EU', ref-'OJ L 333, 27.12.2022, p. 1; 32022R2554#point_002.003_d', verbatim-'natural or legal persons exempted pursuant to Articles 2 and 3 of Directive 2014/65/EU']).
citation(eu_reg_2022_2554_art_2_3_e, [label-'Regulation (EU) 2022/2554 (DORA) Art 2(3)(e) exclusion of intermediaries which are micro, small or medium-sized enterprises', ref-'OJ L 333, 27.12.2022, p. 1; 32022R2554#point_002.003_e', verbatim-'insurance intermediaries, reinsurance intermediaries and ancillary insurance intermediaries which are microenterprises or small or medium-sized enterprises']).
citation(eu_reg_2022_2554_art_2_3_f, [label-'Regulation (EU) 2022/2554 (DORA) Art 2(3)(f) exclusion of post office giro institutions', ref-'OJ L 333, 27.12.2022, p. 1; 32022R2554#point_002.003_f', verbatim-'post office giro institutions as referred to in Article 2(5), point (3), of Directive 2013/36/EU']).

% ---- Article 2(4): the option of the Member States (first sentence) ----
citation(eu_reg_2022_2554_art_2_4, [label-'Regulation (EU) 2022/2554 (DORA) Art 2(4) first sentence, Member State option to exclude institutions of Art 2(5)(4) to (23) of Directive 2013/36/EU', ref-'OJ L 333, 27.12.2022, p. 1; 32022R2554#parag_002.004', verbatim-'Member States may exclude from the scope of this Regulation entities referred to in Article 2(5), points (4) to (23), of Directive 2013/36/EU that are located within their respective territories.']).

% ---- Article 3: the definitions read ----
citation(eu_reg_2022_2554_art_3_19, [label-'Regulation (EU) 2022/2554 (DORA) Art 3(19) definition of ICT third-party service provider', ref-'OJ L 333, 27.12.2022, p. 1; 32022R2554#point_003_19', verbatim-'means an undertaking providing ICT services']).
citation(eu_reg_2022_2554_art_3_32, [label-'Regulation (EU) 2022/2554 (DORA) Art 3(32) definition of institution exempted pursuant to Directive 2013/36/EU', ref-'OJ L 333, 27.12.2022, p. 1; 32022R2554#point_003_32', verbatim-'means an entity as referred to in Article 2(5), points (4) to (23), of Directive 2013/36/EU']).
citation(eu_reg_2022_2554_art_3_36, [label-'Regulation (EU) 2022/2554 (DORA) Art 3(36) definition of payment institution exempted pursuant to Directive (EU) 2015/2366', ref-'OJ L 333, 27.12.2022, p. 1; 32022R2554#point_003_36', verbatim-'means a payment institution exempted pursuant to Article 32(1) of Directive (EU) 2015/2366']).
citation(eu_reg_2022_2554_art_3_39, [label-'Regulation (EU) 2022/2554 (DORA) Art 3(39) definition of electronic money institution exempted pursuant to Directive 2009/110/EC', ref-'OJ L 333, 27.12.2022, p. 1; 32022R2554#point_003_39', verbatim-'means an electronic money institution benefitting from a waiver as referred to in Article 9(1) of Directive 2009/110/EC']).
citation(eu_reg_2022_2554_art_3_60, [label-'Regulation (EU) 2022/2554 (DORA) Art 3(60) definition of microenterprise', ref-'OJ L 333, 27.12.2022, p. 1; 32022R2554#point_003_60', verbatim-'which employs fewer than 10 persons and has an annual turnover and/or annual balance sheet total that does not exceed EUR 2 million']).
citation(eu_reg_2022_2554_art_3_63, [label-'Regulation (EU) 2022/2554 (DORA) Art 3(63) definition of small enterprise', ref-'OJ L 333, 27.12.2022, p. 1; 32022R2554#point_003_63', verbatim-'means a financial entity that employs 10 or more persons, but fewer than 50 persons, and has an annual turnover and/or annual balance sheet total that exceeds EUR 2 million, but does not exceed EUR 10 million']).
citation(eu_reg_2022_2554_art_3_64, [label-'Regulation (EU) 2022/2554 (DORA) Art 3(64) definition of medium-sized enterprise', ref-'OJ L 333, 27.12.2022, p. 1; 32022R2554#point_003_64', verbatim-'means a financial entity that is not a small enterprise and employs fewer than 250 persons and has an annual turnover that does not exceed EUR 50 million and/or an annual balance sheet that does not exceed EUR 43 million']).

:- end_module(citations).
