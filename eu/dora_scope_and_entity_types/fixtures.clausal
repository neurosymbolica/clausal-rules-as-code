% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% fixtures.clausal -- representative profiles for eu/dora_scope_and_entity_types.
% A TOP-LAYER consumer: it imports the determination slice's PUBLIC
% predicate it calls -- that is the whole import list. Profile keys and
% subject ids are atoms and need no import.
%
% A profile is an ATTRIBUTE LIST [attribute(Key, Value), ...] (the order's
% typed input contract). Each route of THE LIMBS has a positive subject and
% a one-step near-miss control:
%   - every exclusion row: true (out_of_scope) / false (in_scope) / absent
%     (indeterminate) where the row has a crisp key;
%   - Art 2(3)(c) member count (integer units, a count of persons): 15 is
%     at the ceiling (out_of_scope), 16 just above it (in_scope);
%   - Art 2(3)(e) size: either fact true excludes, both false does not, the
%     first missing key is named;
%   - the type key: absent, none_of_the_listed_types, a type without a row;
%   - THE INPUT CHECK: a float count, a negative count, a duplicate key, an
%     unknown key, a crisp key given unsure, a profile that is not a list.
% Expected verdicts are asserted in tests/test_public_interface.clausal.
% lint: C6 aifm iorp ict (contract key atoms)
% =====================================================================

:- module(fixtures, [
    dora_scope_and_entity_types_subject/1,
    dora_scope_and_entity_types_profile_for/2,
    dora_scope_and_entity_types_assess/2
]).

:- use_module(eu/dora_scope_and_entity_types/dora_scope_and_entity_types, [decide_dora_scope_and_entity_types/2]).

% ---- Subject registry ------------------------------------------------
dora_scope_and_entity_types_subject(credit_institution_not_giro_in_scope).
dora_scope_and_entity_types_subject(credit_institution_giro_out_of_scope).
dora_scope_and_entity_types_subject(credit_institution_giro_absent_indeterminate).
dora_scope_and_entity_types_subject(exempted_institution_member_state_excluded).
dora_scope_and_entity_types_subject(exempted_institution_member_state_not_excluded).
dora_scope_and_entity_types_subject(payment_institution_in_scope).
dora_scope_and_entity_types_subject(exempted_payment_institution_in_scope).
dora_scope_and_entity_types_subject(exempted_electronic_money_institution_in_scope).
dora_scope_and_entity_types_subject(investment_firm_exempted_out_of_scope).
dora_scope_and_entity_types_subject(investment_firm_not_exempted_in_scope).
dora_scope_and_entity_types_subject(small_fund_manager_out_of_scope).
dora_scope_and_entity_types_subject(fund_manager_not_small_in_scope).
dora_scope_and_entity_types_subject(small_insurance_undertaking_out_of_scope).
dora_scope_and_entity_types_subject(insurance_undertaking_not_small_in_scope).
dora_scope_and_entity_types_subject(small_reinsurance_undertaking_out_of_scope).
dora_scope_and_entity_types_subject(occupational_retirement_fifteen_members_out_of_scope).
dora_scope_and_entity_types_subject(occupational_retirement_sixteen_members_in_scope).
dora_scope_and_entity_types_subject(occupational_retirement_members_absent_indeterminate).
dora_scope_and_entity_types_subject(intermediary_microenterprise_out_of_scope).
dora_scope_and_entity_types_subject(intermediary_small_or_medium_out_of_scope).
dora_scope_and_entity_types_subject(intermediary_large_in_scope).
dora_scope_and_entity_types_subject(intermediary_size_absent_indeterminate).
dora_scope_and_entity_types_subject(intermediary_not_microenterprise_size_absent_indeterminate).
dora_scope_and_entity_types_subject(third_party_service_provider_in_scope).
dora_scope_and_entity_types_subject(none_of_the_listed_types_out_of_scope).
dora_scope_and_entity_types_subject(type_absent_indeterminate).
dora_scope_and_entity_types_subject(other_type_exclusion_key_not_read).
dora_scope_and_entity_types_subject(fractional_member_count_wrong_type).
dora_scope_and_entity_types_subject(negative_member_count_wrong_type).
dora_scope_and_entity_types_subject(duplicate_type_key_problem).
dora_scope_and_entity_types_subject(unknown_key_problem).
dora_scope_and_entity_types_subject(unsure_crisp_value_wrong_type).
dora_scope_and_entity_types_subject(profile_not_an_attribute_list).

% ---- Profiles --------------------------------------------------------
% Art 2(1)(a) with Art 2(3)(f).
dora_scope_and_entity_types_profile_for(credit_institution_not_giro_in_scope, [
    attribute(dora_entity_type, credit_institution),
    attribute(post_office_giro_institution_under_article_2_5_3_of_directive_2013_36, false)
]).
dora_scope_and_entity_types_profile_for(credit_institution_giro_out_of_scope, [
    attribute(dora_entity_type, credit_institution),
    attribute(post_office_giro_institution_under_article_2_5_3_of_directive_2013_36, true)
]).
dora_scope_and_entity_types_profile_for(credit_institution_giro_absent_indeterminate, [
    attribute(dora_entity_type, credit_institution)
]).
% Art 2(1)(a), Art 3(32) with Art 2(4).
dora_scope_and_entity_types_profile_for(exempted_institution_member_state_excluded, [
    attribute(dora_entity_type, institution_exempted_pursuant_to_directive_2013_36),
    attribute(exempted_from_dora_scope_by_member_state, true)
]).
dora_scope_and_entity_types_profile_for(exempted_institution_member_state_not_excluded, [
    attribute(dora_entity_type, institution_exempted_pursuant_to_directive_2013_36),
    attribute(exempted_from_dora_scope_by_member_state, false)
]).
% Art 2(1)(b), (d) and Art 3(36), (39): no exclusion row.
dora_scope_and_entity_types_profile_for(payment_institution_in_scope, [
    attribute(dora_entity_type, payment_institution)
]).
dora_scope_and_entity_types_profile_for(exempted_payment_institution_in_scope, [
    attribute(dora_entity_type, exempted_payment_institution)
]).
dora_scope_and_entity_types_profile_for(exempted_electronic_money_institution_in_scope, [
    attribute(dora_entity_type, exempted_electronic_money_institution)
]).
% Art 2(1)(e) with Art 2(3)(d).
dora_scope_and_entity_types_profile_for(investment_firm_exempted_out_of_scope, [
    attribute(dora_entity_type, investment_firm),
    attribute(exempted_under_articles_2_and_3_of_directive_2014_65, true)
]).
dora_scope_and_entity_types_profile_for(investment_firm_not_exempted_in_scope, [
    attribute(dora_entity_type, investment_firm),
    attribute(exempted_under_articles_2_and_3_of_directive_2014_65, false)
]).
% Art 2(1)(k) with Art 2(3)(a).
dora_scope_and_entity_types_profile_for(small_fund_manager_out_of_scope, [
    attribute(dora_entity_type, manager_of_alternative_investment_funds),
    attribute(aifm_under_article_3_2_of_directive_2011_61, true)
]).
dora_scope_and_entity_types_profile_for(fund_manager_not_small_in_scope, [
    attribute(dora_entity_type, manager_of_alternative_investment_funds),
    attribute(aifm_under_article_3_2_of_directive_2011_61, false)
]).
% Art 2(1)(n) with Art 2(3)(b).
dora_scope_and_entity_types_profile_for(small_insurance_undertaking_out_of_scope, [
    attribute(dora_entity_type, insurance_undertaking),
    attribute(undertaking_under_article_4_of_directive_2009_138, true)
]).
dora_scope_and_entity_types_profile_for(insurance_undertaking_not_small_in_scope, [
    attribute(dora_entity_type, insurance_undertaking),
    attribute(undertaking_under_article_4_of_directive_2009_138, false)
]).
dora_scope_and_entity_types_profile_for(small_reinsurance_undertaking_out_of_scope, [
    attribute(dora_entity_type, reinsurance_undertaking),
    attribute(undertaking_under_article_4_of_directive_2009_138, true)
]).
% Art 2(1)(p) with Art 2(3)(c): at the ceiling / one member above it.
dora_scope_and_entity_types_profile_for(occupational_retirement_fifteen_members_out_of_scope, [
    attribute(dora_entity_type, institution_for_occupational_retirement_provision),
    attribute(iorp_pension_scheme_members_total, 15)
]).
dora_scope_and_entity_types_profile_for(occupational_retirement_sixteen_members_in_scope, [
    attribute(dora_entity_type, institution_for_occupational_retirement_provision),
    attribute(iorp_pension_scheme_members_total, 16)
]).
dora_scope_and_entity_types_profile_for(occupational_retirement_members_absent_indeterminate, [
    attribute(dora_entity_type, institution_for_occupational_retirement_provision)
]).
% Art 2(1)(o) with Art 2(3)(e) and Art 3(60), (63), (64).
dora_scope_and_entity_types_profile_for(intermediary_microenterprise_out_of_scope, [
    attribute(dora_entity_type, insurance_intermediary),
    attribute(financial_entity_is_microenterprise, true)
]).
dora_scope_and_entity_types_profile_for(intermediary_small_or_medium_out_of_scope, [
    attribute(dora_entity_type, reinsurance_intermediary),
    attribute(financial_entity_is_microenterprise, false),
    attribute(financial_entity_is_small_or_medium_sized_enterprise, true)
]).
dora_scope_and_entity_types_profile_for(intermediary_large_in_scope, [
    attribute(dora_entity_type, ancillary_insurance_intermediary),
    attribute(financial_entity_is_microenterprise, false),
    attribute(financial_entity_is_small_or_medium_sized_enterprise, false)
]).
dora_scope_and_entity_types_profile_for(intermediary_size_absent_indeterminate, [
    attribute(dora_entity_type, insurance_intermediary)
]).
dora_scope_and_entity_types_profile_for(intermediary_not_microenterprise_size_absent_indeterminate, [
    attribute(dora_entity_type, insurance_intermediary),
    attribute(financial_entity_is_microenterprise, false)
]).
% Art 2(1)(u) with Art 3(19).
dora_scope_and_entity_types_profile_for(third_party_service_provider_in_scope, [
    attribute(dora_entity_type, ict_third_party_service_provider)
]).
% Art 2(1): none of the listed types; the type key absent.
dora_scope_and_entity_types_profile_for(none_of_the_listed_types_out_of_scope, [
    attribute(dora_entity_type, none_of_the_listed_types)
]).
dora_scope_and_entity_types_profile_for(type_absent_indeterminate, []).
% A key of another type's exclusion is never read (reading (6)).
dora_scope_and_entity_types_profile_for(other_type_exclusion_key_not_read, [
    attribute(dora_entity_type, trading_venue),
    attribute(aifm_under_article_3_2_of_directive_2011_61, true)
]).
% THE INPUT CHECK. The fractional count is the float of 15, built from the
% integer (no float literal), so the profile holds 15.0.
dora_scope_and_entity_types_profile_for(fractional_member_count_wrong_type, [
    attribute(dora_entity_type, institution_for_occupational_retirement_provision),
    attribute(iorp_pension_scheme_members_total, FractionalCount)
]) :-
    FractionalCount is float(15).
dora_scope_and_entity_types_profile_for(negative_member_count_wrong_type, [
    attribute(dora_entity_type, institution_for_occupational_retirement_provision),
    attribute(iorp_pension_scheme_members_total, -1)
]).
dora_scope_and_entity_types_profile_for(duplicate_type_key_problem, [
    attribute(dora_entity_type, trading_venue),
    attribute(dora_entity_type, trading_venue)
]).
dora_scope_and_entity_types_profile_for(unknown_key_problem, [
    attribute(dora_entity_type, trading_venue),
    attribute(colour, blue)
]).
dora_scope_and_entity_types_profile_for(unsure_crisp_value_wrong_type, [
    attribute(dora_entity_type, credit_institution),
    attribute(post_office_giro_institution_under_article_2_5_3_of_directive_2013_36, unsure)
]).
dora_scope_and_entity_types_profile_for(profile_not_an_attribute_list, not_an_attribute_list).

% ---- Convenience wrapper ---------------------------------------------
dora_scope_and_entity_types_assess(Subject, Result) :-
    dora_scope_and_entity_types_profile_for(Subject, Profile),
    decide_dora_scope_and_entity_types(Profile, Result).

:- end_module(fixtures).
