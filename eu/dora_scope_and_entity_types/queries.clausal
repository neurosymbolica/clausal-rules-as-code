% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% queries.clausal -- QUERY-COMBINATOR layer for eu/dora_scope_and_entity_types.
% A TOP-LAYER consumer: it imports the determination slice's PUBLIC
% predicates it calls (and the kernel's input check it re-exports), and
% nothing else.
%
% Query types this domain serves:
%   #2 eligibility   -- dora_scope_decision/3 and dora_entity_category/3
%                       (the contract queries, defined in the slice) and
%                       decide_dora_scope_and_entity_types/2 (slice facade);
%   #7 justification -- dora_scope_and_entity_types_checklist/2 (slice): every
%                       item carries its cite(...) provenance;
%   #16 what-if      -- dora_scope_and_entity_types_what_if/4 (here).
%
% dora_scope_and_entity_types_what_if/4: override one key, re-evaluate.
%   The PROFILE of this order is an ATTRIBUTE LIST, not a dict, so the kit's
%   override_key/4 (a dict operation) does not apply; the override is a
%   local list rewrite that drops every attribute with the key (term
%   identity ==) and appends attribute(Key, Value). A profile that is not an
%   attribute list cannot be rewritten: its status is that of the profile
%   as given (input_problems([wrong_type(profile)])).
% dora_scope_and_entity_types_profile_keys/1: top-level profile key schema.
% dora_scope_and_entity_types_input_problems/2: re-exported from the kernel.
%
% RESULT CONSTRUCTORS AND ROOT ATOMS: in_scope/1, indeterminate/1,
% input_problems/1, unknown_key/1, wrong_type/1 and duplicate_key/1 are the
% result constructors of the order: data, declared below, with no clauses;
% the nine profile key atoms, the twenty-nine atoms of dora_entity_type and
% the result atoms out_of_scope and financial_entity are exported as
% package-root attributes (the order's root_exports). They are exported,
% never called as queries.
%
% No clause here decides a statutory condition (list plumbing and
% vocabulary only), so no clause carries an implements/1 marker.
% lint: C6 aifm iorp ict reg art (canonical citation and contract key atoms)
% =====================================================================

:- module(queries, [
    dora_scope_and_entity_types_profile_keys/1,
    dora_scope_and_entity_types_input_problems/2,
    dora_scope_and_entity_types_what_if/4,
    in_scope/1,
    indeterminate/1,
    input_problems/1,
    unknown_key/1,
    wrong_type/1,
    duplicate_key/1,
    out_of_scope/0,
    financial_entity/0,
    dora_entity_type/0,
    aifm_under_article_3_2_of_directive_2011_61/0,
    undertaking_under_article_4_of_directive_2009_138/0,
    iorp_pension_scheme_members_total/0,
    exempted_under_articles_2_and_3_of_directive_2014_65/0,
    financial_entity_is_microenterprise/0,
    financial_entity_is_small_or_medium_sized_enterprise/0,
    post_office_giro_institution_under_article_2_5_3_of_directive_2013_36/0,
    exempted_from_dora_scope_by_member_state/0,
    credit_institution/0,
    institution_exempted_pursuant_to_directive_2013_36/0,
    payment_institution/0,
    exempted_payment_institution/0,
    account_information_service_provider/0,
    electronic_money_institution/0,
    exempted_electronic_money_institution/0,
    investment_firm/0,
    crypto_asset_service_provider/0,
    issuer_of_asset_referenced_tokens/0,
    central_securities_depository/0,
    central_counterparty/0,
    trading_venue/0,
    trade_repository/0,
    manager_of_alternative_investment_funds/0,
    management_company/0,
    data_reporting_service_provider/0,
    insurance_undertaking/0,
    reinsurance_undertaking/0,
    insurance_intermediary/0,
    reinsurance_intermediary/0,
    ancillary_insurance_intermediary/0,
    institution_for_occupational_retirement_provision/0,
    credit_rating_agency/0,
    administrator_of_critical_benchmarks/0,
    crowdfunding_service_provider/0,
    securitisation_repository/0,
    ict_third_party_service_provider/0,
    none_of_the_listed_types/0
]).

:- use_module(eu/dora_scope_and_entity_types/kernel, [dora_scope_and_entity_types_input_problems/2]).
:- use_module(eu/dora_scope_and_entity_types/dora_scope_and_entity_types, [dora_scope_and_entity_types_status/2]).

% ---- result constructors (exported, never called as queries) ----------
% A constructor is data and has no clauses; this names its fields.
:- constructors([in_scope(type), indeterminate(missing_keys), input_problems(problems), unknown_key(key), wrong_type(key), duplicate_key(key)]).

% schema of top-level profile keys: the keys of the order's typed input contract, in its order
dora_scope_and_entity_types_profile_keys([dora_entity_type, aifm_under_article_3_2_of_directive_2011_61, undertaking_under_article_4_of_directive_2009_138, iorp_pension_scheme_members_total, exempted_under_articles_2_and_3_of_directive_2014_65, financial_entity_is_microenterprise, financial_entity_is_small_or_medium_sized_enterprise, post_office_giro_institution_under_article_2_5_3_of_directive_2013_36, exempted_from_dora_scope_by_member_state]).

% #16 what-if: re-evaluate with one key hypothetically overridden.
dora_scope_and_entity_types_what_if(Profile, OverriddenKey, NewValue, NewStatus) :-
    dora_scope_and_entity_types_input_problems(Profile, Problems),
    what_if_from_problems(Problems, Profile, OverriddenKey, NewValue, NewStatus).

% Not an attribute list: nothing to rewrite, the status of the profile as given.
what_if_from_problems([wrong_type(profile)], Profile, _, _, NewStatus) :-
    dora_scope_and_entity_types_status(Profile, NewStatus).
% An attribute list (well formed or not): rewrite the key, then re-evaluate.
what_if_from_problems(Problems, Profile, OverriddenKey, NewValue, NewStatus) :-
    dif(Problems, [wrong_type(profile)]),
    attributes_without_key(Profile, OverriddenKey, KeptAttributes),
    append(KeptAttributes, [attribute(OverriddenKey, NewValue)], Hypothesis),
    dora_scope_and_entity_types_status(Hypothesis, NewStatus).

% attributes_without_key(Attributes, Key, KeptAttributes): every attribute whose
% key is not identical (==) to Key, in order; called on attribute lists only.
attributes_without_key([], _, []).
attributes_without_key([attribute(ElementKey, ElementValue)|Elements], OverriddenKey, [attribute(ElementKey, ElementValue)|KeptAttributes]) :-
    ElementKey \== OverriddenKey,
    attributes_without_key(Elements, OverriddenKey, KeptAttributes).
attributes_without_key([attribute(ElementKey, _)|Elements], OverriddenKey, KeptAttributes) :-
    ElementKey == OverriddenKey,
    attributes_without_key(Elements, OverriddenKey, KeptAttributes).

% ---- root atoms: the result atoms --------------------------------------
out_of_scope.
financial_entity.

% ---- root atoms: the nine profile keys, in contract order -------------
dora_entity_type.
aifm_under_article_3_2_of_directive_2011_61.
undertaking_under_article_4_of_directive_2009_138.
iorp_pension_scheme_members_total.
exempted_under_articles_2_and_3_of_directive_2014_65.
financial_entity_is_microenterprise.
financial_entity_is_small_or_medium_sized_enterprise.
post_office_giro_institution_under_article_2_5_3_of_directive_2013_36.
exempted_from_dora_scope_by_member_state.

% ---- root atoms: THE SHARED TYPE SET, in the order of Art 2(1) ---------
credit_institution.
institution_exempted_pursuant_to_directive_2013_36.
payment_institution.
exempted_payment_institution.
account_information_service_provider.
electronic_money_institution.
exempted_electronic_money_institution.
investment_firm.
crypto_asset_service_provider.
issuer_of_asset_referenced_tokens.
central_securities_depository.
central_counterparty.
trading_venue.
trade_repository.
manager_of_alternative_investment_funds.
management_company.
data_reporting_service_provider.
insurance_undertaking.
reinsurance_undertaking.
insurance_intermediary.
reinsurance_intermediary.
ancillary_insurance_intermediary.
institution_for_occupational_retirement_provision.
credit_rating_agency.
administrator_of_critical_benchmarks.
crowdfunding_service_provider.
securitisation_repository.
ict_third_party_service_provider.
none_of_the_listed_types.

% ---- tests ------------------------------------------------------------
test(what_if_supplies_the_missing_giro_fact) :-
    findall(NewStatus, dora_scope_and_entity_types_what_if([attribute(dora_entity_type, credit_institution)], post_office_giro_institution_under_article_2_5_3_of_directive_2013_36, true, NewStatus), Statuses),
    Statuses == [out_of_scope].
test(what_if_replaces_a_present_value) :-
    findall(NewStatus, dora_scope_and_entity_types_what_if([attribute(dora_entity_type, institution_for_occupational_retirement_provision), attribute(iorp_pension_scheme_members_total, 16)], iorp_pension_scheme_members_total, 15, NewStatus), Statuses),
    Statuses == [out_of_scope].
test(what_if_on_a_non_list_keeps_the_input_problem) :-
    findall(NewStatus, dora_scope_and_entity_types_what_if(not_an_attribute_list, dora_entity_type, trading_venue, NewStatus), Statuses),
    Statuses == [input_problems([wrong_type(profile)])].
test(profile_keys_are_the_nine_contract_keys) :-
    dora_scope_and_entity_types_profile_keys(ContractKeys),
    length(ContractKeys, 9).
test(root_atoms_are_served) :-
    out_of_scope,
    financial_entity,
    dora_entity_type,
    none_of_the_listed_types,
    ict_third_party_service_provider.

:- end_module(queries).
