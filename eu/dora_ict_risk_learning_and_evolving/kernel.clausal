% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% kernel.clausal -- the SHARED FLOOR for eu/dora_ict_risk_learning_and_evolving (deontic family).
% DAG root of the determination-slices layout. It holds ONLY the
% PREDICATES that two or more files CALL. This package has one
% determination slice (dora_ict_risk_learning_and_evolving.clausal), so
% nothing else is shared. The one exception is the order's input check
% dora_ict_risk_learning_and_evolving_input_problems/2, which the scaffold
% writes here from the typed input contract and exports for the slice and
% the queries facade to import.
%
% Source: Regulation (EU) 2022/2554 (Digital Operational Resilience Act,
% DORA), Article 13 (learning and evolving), paragraphs (1) to (7), with
% points (a) to (d) of Article 13(2); and Article 16(1), first
% subparagraph (Articles 5 to 15 do not apply to the entities it lists).
% Pinned text: 32022R2554, original OJ text, OJ L 333, 27.12.2022, p. 1.
%
% Atoms and data terms need NO declaration and NO import: the slice writes
% them directly. Nothing vocabulary-shaped lives here; the block below
% only RECORDS the result terms so every file spells them alike.
%
% RESULT TERMS (every public query yields exactly ONE solution):
%   Query(Profile, Result, Citations), Query one of
%     ict_risk_learning_and_evolving_duties_required/3
%     ict_risk_learning_and_evolving_duties_complete/3
%     ict_risk_learning_and_evolving_duties_outstanding/3
%   Result, final answers:
%     required(Duties)             -- Duties: non-empty list of duty atoms
%                                     in DUTY ORDER (required query only)
%     complete | incomplete        -- completeness query only
%     none_outstanding
%     | outstanding(Duties)        -- outstanding query only; Duties in
%                                     DUTY ORDER, non-empty
%     simplified_framework_entity  -- every query, gate true; Citations
%                                     [cite(eu_reg_2022_2554_art_16_1)]
%   Result, status compounds (Citations always []):
%     indeterminate([Key])         -- exactly one bare key atom;
%                                     the bare atom indeterminate is never
%                                     written
%     needs_legal_review(open_textured(Key, cite(CitationKey)),
%                        [inputs_relied_on(Pairs)])
%                                  -- Pairs: every present Key-Value pair,
%                                     in root_exports order; an unscored
%                                     provenance(Clause, Citations) item may
%                                     follow inputs_relied_on(Pairs)
%     input_problems(Problems)     -- Problems from the input check below:
%                                     duplicate_key(Key), wrong_type(Key),
%                                     unknown_key(Key)
%   Citations: a set-like list of cite(Key) terms, each written once.
%
% Scaffold facade verdict term of the one slice:
%   dora_ict_risk_learning_and_evolving_verdict(Status, Citations)
%   Status is the Result of ict_risk_learning_and_evolving_duties_complete/3,
%   Citations its Citations.
%
% Duty atoms (DUTY ORDER): threat_and_incident_information_capability,
% post_incident_reviews, communication_of_post_incident_changes,
% review_of_procedures_and_actions, review_of_response_promptness,
% review_of_forensic_analysis, review_of_incident_escalation,
% review_of_internal_and_external_communication,
% lessons_incorporated_into_ict_risk_assessment,
% findings_basis_for_framework_reviews,
% monitoring_of_resilience_strategy_effectiveness,
% mapping_of_ict_risk_evolution, analysis_of_ict_related_incidents,
% enhancement_of_cyber_maturity, yearly_report_to_management_body,
% compulsory_awareness_and_training_modules,
% training_for_all_staff_commensurate_to_remit,
% third_party_providers_in_training,
% monitoring_of_technological_developments,
% up_to_date_ict_risk_management_processes.
% =====================================================================

:- module(kernel, [dora_ict_risk_learning_and_evolving_input_problems/2]).

:- use_module(library(reif), [memberd_t/3]).

% ---- input checks: the problems a profile has, if any -----------
% dora_ict_risk_learning_and_evolving_input_problems(Profile, Problems): Problems = [] means the profile can be
% judged. Written from the order's typed input contract
% (input_contract.types.profile: attribute_list).
% Each public query calls this check first: it gives its normal answer only when
% Problems = [], and when Problems is not [] it gives the answer the order states for
% a profile with input problems.
% It gives exactly one answer for every Profile, and the answer is ground except for a
% Key named as given:
% - a Profile that is not an attribute list [attribute(Key, Value), ...] gives [wrong_type(profile)]:
%   an unbound Profile, a partial list, a list holding an unbound item or an item that is
%   not attribute(_, _);
% - a Key that is not an atom (a number, a string, a compound term, an unbound variable)
%   is a key outside the contract: unknown_key(Key), Key as given;
% - otherwise, for each contract key in the contract's key order, duplicate_key(Key) when
%   the key occurs more than once in Profile (whatever its values: none of them is read,
%   so it is never also wrong_type(Key)), else wrong_type(Key) when its one value is
%   outside its type; then unknown_key(Key) for each key outside the contract, in the
%   order of its first occurrence in Profile. Each key is named once. An absent key is
%   not a problem.
% Every step is complementary clauses: exactly one clause holds for each input.
dora_ict_risk_learning_and_evolving_input_problems(Profile, Problems) :-
    attribute_list_t(Profile, IsAttributeList),
    profile_problems(IsAttributeList, Profile, Problems).

profile_problems(false, _, [wrong_type(profile)]).
profile_problems(true, Profile, Problems) :-
    Keys = [financial_entity_is_article_16_1_entity, financial_entity_is_microenterprise, major_ict_related_incident_disrupted_core_activities, competent_authority_requested_post_incident_review_changes, capabilities_and_staff_to_gather_and_analyse_threat_and_incident_information, post_ict_related_incident_reviews_put_in_place, post_incident_review_changes_communicated_to_competent_authorities, post_incident_reviews_determine_procedures_followed_and_actions_effective, post_incident_reviews_cover_promptness_of_response_and_impact_determination, post_incident_reviews_cover_quality_and_speed_of_forensic_analysis, post_incident_reviews_cover_effectiveness_of_incident_escalation, post_incident_reviews_cover_effectiveness_of_internal_and_external_communication, lessons_incorporated_into_ict_risk_assessment_process, findings_form_basis_for_reviews_of_ict_risk_management_framework, effectiveness_of_resilience_strategy_implementation_monitored, evolution_of_ict_risk_mapped_over_time, frequency_types_magnitude_and_evolution_of_incidents_analysed, cyber_maturity_and_preparedness_enhanced, senior_ict_staff_report_findings_and_recommendations_at_least_yearly, awareness_programmes_and_resilience_training_compulsory_in_staff_training, programmes_and_training_apply_to_all_staff_at_commensurate_complexity, ict_third_party_service_providers_included_in_training_where_appropriate, relevant_technological_developments_monitored_continuously, kept_up_to_date_with_latest_ict_risk_management_processes],
    unknown_keys(Profile, Keys, UnknownKeyProblems),
    key_problems(Keys, Profile, UnknownKeyProblems, Problems).

% The contract: each key and the type of its value.
key_type(financial_entity_is_article_16_1_entity, fact).
key_type(financial_entity_is_microenterprise, fact).
key_type(major_ict_related_incident_disrupted_core_activities, fact).
key_type(competent_authority_requested_post_incident_review_changes, fact).
key_type(capabilities_and_staff_to_gather_and_analyse_threat_and_incident_information, judgement).
key_type(post_ict_related_incident_reviews_put_in_place, judgement).
key_type(post_incident_review_changes_communicated_to_competent_authorities, judgement).
key_type(post_incident_reviews_determine_procedures_followed_and_actions_effective, judgement).
key_type(post_incident_reviews_cover_promptness_of_response_and_impact_determination, judgement).
key_type(post_incident_reviews_cover_quality_and_speed_of_forensic_analysis, judgement).
key_type(post_incident_reviews_cover_effectiveness_of_incident_escalation, judgement).
key_type(post_incident_reviews_cover_effectiveness_of_internal_and_external_communication, judgement).
key_type(lessons_incorporated_into_ict_risk_assessment_process, judgement).
key_type(findings_form_basis_for_reviews_of_ict_risk_management_framework, judgement).
key_type(effectiveness_of_resilience_strategy_implementation_monitored, judgement).
key_type(evolution_of_ict_risk_mapped_over_time, judgement).
key_type(frequency_types_magnitude_and_evolution_of_incidents_analysed, judgement).
key_type(cyber_maturity_and_preparedness_enhanced, judgement).
key_type(senior_ict_staff_report_findings_and_recommendations_at_least_yearly, judgement).
key_type(awareness_programmes_and_resilience_training_compulsory_in_staff_training, judgement).
key_type(programmes_and_training_apply_to_all_staff_at_commensurate_complexity, judgement).
key_type(ict_third_party_service_providers_included_in_training_where_appropriate, judgement).
key_type(relevant_technological_developments_monitored_continuously, judgement).
key_type(kept_up_to_date_with_latest_ict_risk_management_processes, judgement).

% attribute_list_t(Term, T): T is true when Term is a list of attribute(Key, Value)
% items, whatever each Key is; false for anything else, an unbound Term or item included.
attribute_list_t(Term, false) :-
    var(Term).
attribute_list_t(Term, true) :-
    Term == [].
attribute_list_t(Term, T) :-
    nonvar(Term),
    Term = [Element|Elements],
    attribute_t(Element, ElementIsAttribute),
    attribute_list_t(Elements, ElementsAreAttributes),
    truth_and(ElementIsAttribute, ElementsAreAttributes, T).
attribute_list_t(Term, false) :-
    nonvar(Term),
    Term \== [],
    Term \= [_|_].

attribute_t(Element, false) :-
    var(Element).
attribute_t(Element, true) :-
    nonvar(Element),
    Element = attribute(_, _).
attribute_t(Element, false) :-
    nonvar(Element),
    Element \= attribute(_, _).

% Unknown keys, in profile order, each once: Known grows by each key named. A key is
% known when it is identical (==) to one in Known, so an unbound Key is never bound:
% the same variable twice is one unknown key, two different variables are two.
unknown_keys([], _, []).
unknown_keys([attribute(Key, _)|Elements], Known, Problems) :-
    known_t(Key, Known, IsKnown),
    name_unknown_key(IsKnown, Key, Known, Elements, Problems).

known_t(_, [], false).
known_t(Key, [Known|_], true) :-
    Known == Key.
known_t(Key, [Known|Knowns], T) :-
    Known \== Key,
    known_t(Key, Knowns, T).

name_unknown_key(true, _, Known, Elements, Problems) :-
    unknown_keys(Elements, Known, Problems).
name_unknown_key(false, Key, Known, Elements, [unknown_key(Key)|Problems]) :-
    unknown_keys(Elements, [Key|Known], Problems).

% Contract keys, in contract order: duplicate_key(Key) when the key occurs more than once
% (none of its values is read), else wrong_type(Key) when its one value is outside the
% key's type. An absent key has no value to check.
key_problems([], _, Problems, Problems).
key_problems([Key|Keys], Profile, LaterProblems, Problems) :-
    key_type(Key, Type),
    key_occurrences(Profile, Key, Occurrences),
    key_problems(Keys, Profile, LaterProblems, KeyProblems),
    name_key_problem(Occurrences, Key, Type, Profile, KeyProblems, Problems).

% key_occurrences(Elements, Key, Occurrences): none, one or many items give Key.
key_occurrences([], _, none).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey == Key,
    key_occurrences(Elements, Key, RestOccurrences),
    one_more_occurrence(RestOccurrences, Occurrences).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey \== Key,
    key_occurrences(Elements, Key, Occurrences).

one_more_occurrence(none, one).
one_more_occurrence(one, many).
one_more_occurrence(many, many).

name_key_problem(none, _, _, _, Problems, Problems).
name_key_problem(many, Key, _, _, Problems, [duplicate_key(Key)|Problems]).
name_key_problem(one, Key, Type, Profile, KeyProblems, Problems) :-
    values_in_type_t(Profile, Key, Type, InType),
    name_wrong_type(InType, Key, KeyProblems, Problems).

name_wrong_type(true, _, Problems, Problems).
name_wrong_type(false, Key, Problems, [wrong_type(Key)|Problems]).

% values_in_type_t(Elements, Key, Type, T): T is true when every value Elements gives Key is
% in Type (true when Elements gives Key none).
values_in_type_t([], _, _, true).
values_in_type_t([attribute(ElementKey, Value)|Elements], Key, Type, T) :-
    ElementKey == Key,
    value_in_type_t(Type, Value, ValueInType),
    values_in_type_t(Elements, Key, Type, RestInType),
    truth_and(ValueInType, RestInType, T).
values_in_type_t([attribute(ElementKey, _)|Elements], Key, Type, T) :-
    ElementKey \== Key,
    values_in_type_t(Elements, Key, Type, T).

% A value with an unbound part is outside every type; a ground one is checked.
value_in_type_t(Type, Value, T) :-
    term_variables(Value, Variables),
    ground_value_in_type_t(Variables, Type, Value, T).

ground_value_in_type_t([_|_], _, _, false).
ground_value_in_type_t([], Type, Value, T) :-
    in_type_t(Type, Value, T).

% in_type_t(Type, Value, T): one clause per type, for a ground Value.
in_type_t(fact, Value, T) :-
    in_type_t(boolean, Value, T).

in_type_t(judgement, Value, T) :-
    in_type_t(one_of([boolean, enum([unsure])]), Value, T).

in_type_t(boolean, Value, T) :-
    memberd_t(Value, [true, false], T).

in_type_t(enum(Values), Value, T) :-
    memberd_t(Value, Values, T).

in_type_t(one_of(Types), Value, T) :-
    in_some_type_t(Types, Value, T).

truth_and(true, T, T).
truth_and(false, _, false).

% in_some_type_t(Types, Value, T): T is true when Value is in at least one of Types.
in_some_type_t([], _, false).
in_some_type_t([Type|Types], Value, T) :-
    in_type_t(Type, Value, InType),
    in_some_type_t(Types, Value, InAnother),
    truth_or(InType, InAnother, T).

truth_or(true, _, true).
truth_or(false, T, T).

:- end_module(kernel).
