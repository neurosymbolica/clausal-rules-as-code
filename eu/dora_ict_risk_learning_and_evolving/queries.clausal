% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% queries.clausal -- QUERY-COMBINATOR layer for eu/dora_ict_risk_learning_and_evolving.
% A TOP-LAYER consumer: it imports the determination slice's PUBLIC
% predicates it calls (and the kit profile readers), nothing else.
%
% Source: Regulation (EU) 2022/2554 (DORA), Article 13 and Article 16(1),
% first subparagraph. The decisions themselves are the slice's; this layer
% only projects them.
%
% dora_ict_risk_learning_and_evolving_profile_keys/1: top-level profile key schema
% dora_ict_risk_learning_and_evolving_input_problems/2: the problems a profile has ([] = none),
%     re-exported from the kernel as the scaffold wrote it
% dora_ict_risk_learning_and_evolving_what_if/4 (#16 what-if): override one key, re-decide
% dora_ict_risk_learning_and_evolving_compliance_check/3 (#13 compliance check):
%     is the entity's present position on ONE duty compliant?
%
% Query types served:
%   #2 eligibility  -- dora_ict_risk_learning_and_evolving_status/2 of the slice:
%                      complete (eligible), incomplete (ineligible),
%                      indeterminate([Key]) (indeterminate)
%   #7 justification -- dora_ict_risk_learning_and_evolving_checklist/2 of the
%                      slice: one item per duty, each with its own cite(...)
%   #13 compliance_check -- below, projected from that checklist
%   #16 what_if -- below
%
% The what-if does not use kit override_key/4: that combinator rewrites a
% DICT, and this order's profile is an ATTRIBUTE LIST, so the override is
% list plumbing written here (no statutory content).
%
% RESULT CONSTRUCTORS AND ROOT ATOMS: the order's result constructors
% (required/1, outstanding/1, indeterminate/1, needs_legal_review/2,
% open_textured/2, inputs_relied_on/1, provenance/2, input_problems/1,
% unknown_key/1, wrong_type/1, duplicate_key/1) are data: they are
% exported and named by the constructors/1 directive below, and have no
% clauses. The root_exports atoms (the four final answer atoms, the
% twenty-four profile keys, the twenty duty atoms and the judgement value
% unsure) are declared at the foot of this file so the package root
% exposes them. They are never called as queries and decide nothing.
% =====================================================================

:- module(queries, [
    dora_ict_risk_learning_and_evolving_profile_keys/1,
    dora_ict_risk_learning_and_evolving_input_problems/2,
    dora_ict_risk_learning_and_evolving_what_if/4,
    dora_ict_risk_learning_and_evolving_compliance_check/3,
    complete/0,
    incomplete/0,
    none_outstanding/0,
    simplified_framework_entity/0,
    required/1,
    outstanding/1,
    indeterminate/1,
    needs_legal_review/2,
    open_textured/2,
    inputs_relied_on/1,
    provenance/2,
    input_problems/1,
    unknown_key/1,
    wrong_type/1,
    duplicate_key/1,
    unsure/0,
    financial_entity_is_article_16_1_entity/0,
    financial_entity_is_microenterprise/0,
    major_ict_related_incident_disrupted_core_activities/0,
    competent_authority_requested_post_incident_review_changes/0,
    capabilities_and_staff_to_gather_and_analyse_threat_and_incident_information/0,
    post_ict_related_incident_reviews_put_in_place/0,
    post_incident_review_changes_communicated_to_competent_authorities/0,
    post_incident_reviews_determine_procedures_followed_and_actions_effective/0,
    post_incident_reviews_cover_promptness_of_response_and_impact_determination/0,
    post_incident_reviews_cover_quality_and_speed_of_forensic_analysis/0,
    post_incident_reviews_cover_effectiveness_of_incident_escalation/0,
    post_incident_reviews_cover_effectiveness_of_internal_and_external_communication/0,
    lessons_incorporated_into_ict_risk_assessment_process/0,
    findings_form_basis_for_reviews_of_ict_risk_management_framework/0,
    effectiveness_of_resilience_strategy_implementation_monitored/0,
    evolution_of_ict_risk_mapped_over_time/0,
    frequency_types_magnitude_and_evolution_of_incidents_analysed/0,
    cyber_maturity_and_preparedness_enhanced/0,
    senior_ict_staff_report_findings_and_recommendations_at_least_yearly/0,
    awareness_programmes_and_resilience_training_compulsory_in_staff_training/0,
    programmes_and_training_apply_to_all_staff_at_commensurate_complexity/0,
    ict_third_party_service_providers_included_in_training_where_appropriate/0,
    relevant_technological_developments_monitored_continuously/0,
    kept_up_to_date_with_latest_ict_risk_management_processes/0,
    threat_and_incident_information_capability/0,
    post_incident_reviews/0,
    communication_of_post_incident_changes/0,
    review_of_procedures_and_actions/0,
    review_of_response_promptness/0,
    review_of_forensic_analysis/0,
    review_of_incident_escalation/0,
    review_of_internal_and_external_communication/0,
    lessons_incorporated_into_ict_risk_assessment/0,
    findings_basis_for_framework_reviews/0,
    monitoring_of_resilience_strategy_effectiveness/0,
    mapping_of_ict_risk_evolution/0,
    analysis_of_ict_related_incidents/0,
    enhancement_of_cyber_maturity/0,
    yearly_report_to_management_body/0,
    compulsory_awareness_and_training_modules/0,
    training_for_all_staff_commensurate_to_remit/0,
