% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_robustness.clausal -- ROBUSTNESS of the input check de_minimis_input_problems/2 for a
% PROFILE that is an attribute list [attribute(Key, Value), ...]: an empty list, a
% value that is not a list, an unknown key and a value outside its type each get exactly
% one answer. Written by the scaffold from the order's typed input contract
% (input_contract.types.profile: attribute_list), not by the producer;
% do not edit or delete.
% Run: python -m clausal.testing eu/cbam/de_minimis/tests/test_robustness.clausal
% =====================================================================
:- module(test_robustness, []).
:- use_module(eu/cbam/de_minimis/queries, [de_minimis_input_problems/2]).

test(an_empty_attribute_list_gets_exactly_one_answer) :-
    findall(Problems, de_minimis_input_problems([], Problems), Answers),
    Answers == [[]].

test(a_profile_that_is_not_a_list_gets_one_non_empty_answer) :-
    findall(Problems, de_minimis_input_problems(not_a_profile, Problems), Answers),
    Answers = [[_|_]].

test(an_unknown_key_is_named) :-
    findall(Problems, de_minimis_input_problems([attribute(not_a_key_of_the_contract, 5)], Problems), Answers),
    Answers = [Problems],
    memberchk(unknown_key(not_a_key_of_the_contract), Problems).

test(a_value_outside_the_type_of_single_mass_based_threshold_tonnes_is_named) :-
    findall(Problems, de_minimis_input_problems([attribute(single_mass_based_threshold_tonnes, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(single_mass_based_threshold_tonnes), Problems).

test(a_value_outside_the_type_of_year_date_basis_is_named) :-
    findall(Problems, de_minimis_input_problems([attribute(year_date_basis, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(year_date_basis), Problems).

:- end_module(test_robustness).
