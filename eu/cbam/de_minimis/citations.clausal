% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/cbam/de_minimis.
%
% Instrument: Regulation (EU) 2023/956 of the European Parliament and of
% the Council establishing a carbon border adjustment mechanism (CBAM),
% consolidated as amended to 2025-10-20 (CELEX 02023R0956-20251020;
% Formex CL2023R0956EN0010010.0001.xml, sha256
% f5e08d041849ae9025dc60958d93595225d6d8de1dcdc2275656f98b2f132617).
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% Each verbatim is an exact substring of the pinned unit text named in
% its ref (status: verified in citations-sources.yaml).
%
% A clause cites a key with a cite(Key) term; cite(...) is data and
% needs no import.
%
% PROVENANCE: every operative clause opens its body with implements(Key).
% implements/1 succeeds for every key recorded here and fails for any
% other key, so a misspelt key never lies.
%
% Keys the queries may return (the citation vocabulary):
%   eu_reg_2023_956_art_2_1, eu_reg_2023_956_art_2a_1,
%   eu_reg_2023_956_art_2a_2, eu_reg_2023_956_art_2a_4,
%   eu_reg_2023_956_art_3_15, eu_reg_2023_956_annex_i_1,
%   eu_reg_2023_956_annex_i_electricity, eu_reg_2023_956_annex_vii_1.
% Keys recorded for the deferred set, NEVER returned in a result:
%   eu_reg_2023_956_art_2a_3, eu_reg_2023_956_annex_i_chemicals.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

citation(eu_reg_2023_956_art_2_1, [label-'Regulation (EU) 2023/956 (CBAM) Art 2(1) (scope: goods listed in Annex I imported into the customs territory of the Union)', ref-'02023R0956-20251020#parag_002.001', verbatim-'This Regulation applies to goods listed in Annex I originating in a third country, where those goods, or processed products from those goods resulting from the inward processing procedure referred to in Article 256 of Regulation (EU) No 952/2013, are imported into the customs territory of the Union.']).

citation(eu_reg_2023_956_art_2a_1, [label-'Regulation (EU) 2023/956 (CBAM) Art 2a(1) (exemption of an importer under the single mass-based threshold)', ref-'02023R0956-20251020#parag_002A.001', verbatim-'An importer, including any importer with the status of an authorised CBAM declarant, shall be exempted from the obligations under this Regulation, where the net mass of the imported goods in a given calendar year does not cumulatively exceed the single mass-based threshold laid down in point 1 of Annex VII (the single mass-based threshold). That threshold shall apply to the total net mass of goods under all CN codes aggregated per importer and per calendar year.']).

citation(eu_reg_2023_956_art_2a_2, [label-'Regulation (EU) 2023/956 (CBAM) Art 2a(2) (an importer exceeding the single mass-based threshold within the calendar year)', ref-'02023R0956-20251020#parag_002A.002', verbatim-'Where, within the relevant calendar year, an importer, including any importer with the status of an authorised CBAM declarant, exceeds the single mass-based threshold, the importer or the authorised CBAM declarant shall be subject to all obligations under this Regulation in respect of all emissions embedded in all goods imported in that calendar year.']).

citation(eu_reg_2023_956_art_2a_3, [label-'Regulation (EU) 2023/956 (CBAM) Art 2a(3) (Commission assessment and amendment of the single mass-based threshold; deferred)', ref-'02023R0956-20251020#parag_002A.003', verbatim-'The amended single mass-based threshold shall apply from 1 January of the following calendar year.']).

citation(eu_reg_2023_956_art_2a_4, [label-'Regulation (EU) 2023/956 (CBAM) Art 2a(4) (Art 2a does not apply to imports of electricity or hydrogen)', ref-'02023R0956-20251020#parag_002A.004', verbatim-'This Article shall not apply to imports of electricity or hydrogen.']).

citation(eu_reg_2023_956_art_3_15, [label-'Regulation (EU) 2023/956 (CBAM) Art 3, point (15), definition of importer', ref-'02023R0956-20251020#point_003_15', verbatim-'the person lodging a customs declaration for release for free circulation of goods or a bill of discharge in accordance with Article 175(5) of Delegated Regulation (EU) 2015/2446 in its own name and on its own behalf or, where the customs declaration is lodged by an indirect customs representative in accordance with Article 18 of Regulation (EU) No 952/2013, the person on whose behalf such a declaration is lodged']).

citation(eu_reg_2023_956_annex_i_1, [label-'Regulation (EU) 2023/956 (CBAM) Annex I, point 1 (goods identified by the CN codes of the Annex I table)', ref-'02023R0956-20251020#point_annex_i_1', verbatim-'For the purpose of the identification of goods, this Regulation shall apply to goods falling under the Combined Nomenclature (CN) codes set out in the following table.']).

citation(eu_reg_2023_956_annex_i_electricity, [label-'Regulation (EU) 2023/956 (CBAM) Annex I, Electricity division of the table (CN 2716 00 00, electrical energy)', ref-'02023R0956-20251020#division_annex_i-electricity', verbatim-'Electrical energy']).

citation(eu_reg_2023_956_annex_i_chemicals, [label-'Regulation (EU) 2023/956 (CBAM) Annex I, Chemicals division of the table (CN 2804 10 00, hydrogen; deferred)', ref-'02023R0956-20251020#division_annex_i-chemicals', verbatim-'Hydrogen']).

citation(eu_reg_2023_956_annex_vii_1, [label-'Regulation (EU) 2023/956 (CBAM) Annex VII, point 1 (the single mass-based threshold of 50 tonnes of net mass)', ref-'02023R0956-20251020#point_annex_vii_1', verbatim-'The single mass-based threshold referred to in Article 2a shall be set at 50 tonnes of net mass.']).

% implements(Key): the provenance marker an operative clause opens with.
% It succeeds once for each recorded key and fails for any other.
implements(Key) :-
    citation(Key, _).

test(every_vocabulary_key_is_recorded) :-
    implements(eu_reg_2023_956_art_2_1),
    implements(eu_reg_2023_956_art_2a_1),
    implements(eu_reg_2023_956_art_2a_2),
    implements(eu_reg_2023_956_art_2a_4),
    implements(eu_reg_2023_956_art_3_15),
    implements(eu_reg_2023_956_annex_i_1),
    implements(eu_reg_2023_956_annex_i_electricity),
    implements(eu_reg_2023_956_annex_vii_1).
test(the_deferred_keys_are_recorded) :-
    implements(eu_reg_2023_956_art_2a_3),
    implements(eu_reg_2023_956_annex_i_chemicals).
test(an_unrecorded_key_is_not_implemented, fail) :-
    implements(eu_reg_2023_956_art_5).

:- end_module(citations).
