% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/cbam/origin_exclusions.
%
% Instrument: Regulation (EU) 2023/956 of the European Parliament and of the
% Council establishing a carbon border adjustment mechanism (CBAM), read in
% the pinned consolidation 02023R0956-20251020 (as amended to 2025-10-20;
% Formex source CL2023R0956EN0010010.0001.xml, sha256
% f5e08d041849ae9025dc60958d93595225d6d8de1dcdc2275656f98b2f132617).
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% Each verbatim is an exact substring of the pinned unit text named in ref.
%
% The keys are the CANONICAL lexicon keys (_lexicon/citations.yaml), the
% only citation atoms origin_exclusion/3 may return. The segment reg in
% each key is imposed by the canonical lexicon, not an abbreviation chosen
% here.
% lint: allow-segment reg (canonical lexicon citation keys)
%
% Deferred units (Art 2(2), 2(6), 2(7), 2(8), 2(11), Art 3 point (6),
% Annex III title and point 2) decide no answer in this order and get no
% key: no rule applies them (NOTES S3).
%
% PROVENANCE: every operative clause opens its body with implements(Key);
% implements/1 succeeds exactly for a key recorded here.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

citation(eu_reg_2023_956_art_2_1, [label-'Regulation (EU) 2023/956 Art 2(1) (goods originating in a third country)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02023R0956-20251020 (unit 02023R0956-20251020#parag_002.001)', verbatim-'This Regulation applies to goods listed in Annex I originating in a third country, where those goods, or processed products from those goods resulting from the inward processing procedure referred to in Article 256 of Regulation (EU) No 952/2013, are imported into the customs territory of the Union.']).

citation(eu_reg_2023_956_art_2_3, [label-'Regulation (EU) 2023/956 Art 2(3) (goods for military activities)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02023R0956-20251020 (unit 02023R0956-20251020#parag_002.003)', verbatim-'By way of derogation from paragraphs 1 and 2, this Regulation shall not apply to goods to be moved or used in the context of military activities pursuant to Article 1, point (49), of Commission Delegated Regulation (EU) 2015/2446.']).

citation(eu_reg_2023_956_art_2_3a, [label-'Regulation (EU) 2023/956 Art 2(3a), lead (continental shelf and exclusive economic zone exclusions)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02023R0956-20251020 (unit 02023R0956-20251020#parag_002.003A)', verbatim-'This Regulation shall not apply to:']).

citation(eu_reg_2023_956_art_2_3a_a, [label-'Regulation (EU) 2023/956 Art 2(3a), point (a) (electricity generated on the continental shelf or in the exclusive economic zone)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02023R0956-20251020 (unit 02023R0956-20251020#point_002.003A_a)', verbatim-'electricity generated on the continental shelf or in the exclusive economic zone of a Member State or of a country or territory listed in points 1 and 2 of Annex III;']).

citation(eu_reg_2023_956_art_2_3a_b, [label-'Regulation (EU) 2023/956 Art 2(3a), point (b) (hydrogen originating on the continental shelf or in the exclusive economic zone)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02023R0956-20251020 (unit 02023R0956-20251020#point_002.003A_b)', verbatim-'hydrogen originating on the continental shelf or in the exclusive economic zone of a Member State or of a country or territory listed in point 1 of Annex III.']).

citation(eu_reg_2023_956_art_2_4, [label-'Regulation (EU) 2023/956 Art 2(4) (goods originating in Annex III point 1 countries and territories)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02023R0956-20251020 (unit 02023R0956-20251020#parag_002.004)', verbatim-'By way of derogation from paragraphs 1 and 2, this Regulation shall not apply to goods originating in the third countries and territories listed in point 1 of Annex III.']).

citation(eu_reg_2023_956_art_2_5, [label-'Regulation (EU) 2023/956 Art 2(5) (origin by the rules for non-preferential origin)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02023R0956-20251020 (unit 02023R0956-20251020#parag_002.005)', verbatim-'Imported goods shall be considered as originating in third countries in accordance with the rules for non-preferential origin as referred to in Article 59 of Regulation (EU) No 952/2013.']).

citation(eu_reg_2023_956_art_3_7, [label-'Regulation (EU) 2023/956 Art 3, point (7), definition of third country', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02023R0956-20251020 (unit 02023R0956-20251020#point_003_7)', verbatim-'a country or territory outside the customs territory of the Union;']).

citation(eu_reg_2023_956_art_3_8, [label-'Regulation (EU) 2023/956 Art 3, point (8), definition of continental shelf', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02023R0956-20251020 (unit 02023R0956-20251020#point_003_8)', verbatim-'a continental shelf as defined in Article 76 of the United Nations Convention on the Law of the Sea;']).

citation(eu_reg_2023_956_art_3_9, [label-'Regulation (EU) 2023/956 Art 3, point (9), definition of exclusive economic zone', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02023R0956-20251020 (unit 02023R0956-20251020#point_003_9)', verbatim-'an exclusive economic zone as defined in Article 55 of the United Nations Convention on the Law of the Sea and which has been declared as an exclusive economic zone by a Member State pursuant to that convention;']).

citation(eu_reg_2023_956_annex_3_1, [label-'Regulation (EU) 2023/956 Annex III, point 1 (third countries and territories outside the scope of this Regulation)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02023R0956-20251020 (unit 02023R0956-20251020#division_annex_iii-1_third_countries_and_territories_outside_the_scope_of_this_regulation)', verbatim-'This Regulation shall not apply to goods originating in the following countries: Iceland Liechtenstein Norway Switzerland This Regulation shall not apply to goods originating in the following territories: Büsingen Heligoland Livigno Ceuta Melilla']).

% implements(Key): the provenance marker. It succeeds exactly for a recorded
% key, so a misspelt key fails instead of lying. It never changes an answer.
implements(Key) :-
    citation(Key, _).

:- end_module(citations).
