origin_exclusions_profile_for(not_an_attribute_list_profile, colour).

% ---- Convenience wrapper ---------------------------------------------
origin_exclusions_assess(Subject, Result) :-
    origin_exclusions_profile_for(Subject, Profile),
    decide_origin_exclusions(Profile, Result).

:- end_module(fixtures).
