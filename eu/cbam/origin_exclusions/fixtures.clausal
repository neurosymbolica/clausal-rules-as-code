% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% fixtures.clausal -- representative profiles for eu/cbam/origin_exclusions.
% A TOP-LAYER consumer: import the determination slice's PUBLIC predicates
% you call -- that is the whole import list. Profile keys and subject ids
% are atoms and need no import.
%
% A profile is an ATTRIBUTE LIST [attribute(Key, Value), ...] (the order's typed
% input contract). This order has no threshold: its near-miss controls are
% ONE-KEY changes. Every route (THE LIMBS steps 0 to 12) has a positive
% subject and a control that differs from it in one key (or one entry) and
% gets the opposite eligibility:
%   step 1  military_activities_yes            / military_activities_no_control
%   step 2  origin_norway                      / origin_other_third_country_control
%   step 3  electricity_member_state_shelf     / electricity_other_third_country_shelf_control
%   step 4  electricity_iceland_shelf (Q1)     / electricity_not_on_shelf_control
%   step 5  hydrogen_member_state_zone         / hydrogen_other_third_country_zone_control
%   step 6  hydrogen_liechtenstein_shelf       / other_goods_liechtenstein_shelf_control
%   step 7  member_state_origin                / origin_other_third_country_control
%   step 8  military_activities_absent, military_activities_unsure (ruling 11)
%                                              / military_activities_no_control
%   step 9  origin_absent                      / origin_other_third_country_control
%   step 10 goods_kind_absent_member_state_shelf / goods_kind_absent_not_on_shelf_control
%   step 11 electricity_shelf_absent           / other_goods_shelf_absent_control
%   step 0  unknown_key_profile, duplicate_key_profile, wrong_type_profile,
%           not_an_attribute_list_profile      / military_activities_no_control
%   Q4      norway_origin_military_absent, norway_hydrogen_norway_shelf
% =====================================================================

:- module(fixtures, [
    origin_exclusions_subject/1,
    origin_exclusions_profile_for/2,
    origin_exclusions_assess/2
]).

:- use_module(eu/cbam/origin_exclusions/origin_exclusions, [decide_origin_exclusions/2]).

% ---- Subject registry ------------------------------------------------
origin_exclusions_subject(military_activities_yes).
origin_exclusions_subject(military_activities_no_control).
origin_exclusions_subject(origin_norway).
origin_exclusions_subject(origin_switzerland).
origin_exclusions_subject(origin_busingen).
origin_exclusions_subject(origin_other_third_country_control).
origin_exclusions_subject(electricity_member_state_shelf).
origin_exclusions_subject(electricity_other_third_country_shelf_control).
origin_exclusions_subject(electricity_iceland_shelf).
origin_exclusions_subject(electricity_not_on_shelf_control).
origin_exclusions_subject(hydrogen_member_state_zone).
origin_exclusions_subject(hydrogen_other_third_country_zone_control).
origin_exclusions_subject(hydrogen_liechtenstein_shelf).
origin_exclusions_subject(other_goods_liechtenstein_shelf_control).
origin_exclusions_subject(member_state_origin).
origin_exclusions_subject(military_activities_absent).
origin_exclusions_subject(military_activities_unsure).
origin_exclusions_subject(origin_absent).
origin_exclusions_subject(goods_kind_absent_member_state_shelf).
origin_exclusions_subject(goods_kind_absent_not_on_shelf_control).
origin_exclusions_subject(electricity_shelf_absent).
origin_exclusions_subject(other_goods_shelf_absent_control).
origin_exclusions_subject(norway_origin_military_absent).
origin_exclusions_subject(norway_hydrogen_norway_shelf).
origin_exclusions_subject(unknown_key_profile).
origin_exclusions_subject(duplicate_key_profile).
origin_exclusions_subject(wrong_type_profile).
origin_exclusions_subject(not_an_attribute_list_profile).

% ---- Profiles --------------------------------------------------------
origin_exclusions_profile_for(military_activities_yes, [
    attribute(military_activities, yes),
    attribute(non_preferential_origin, other_third_country),
    attribute(goods_kind, other_annex_i_goods),
    attribute(continental_shelf_or_eez_of, not_on_continental_shelf_or_eez)
]).
origin_exclusions_profile_for(military_activities_no_control, [
    attribute(military_activities, no),
    attribute(non_preferential_origin, other_third_country),
    attribute(goods_kind, other_annex_i_goods),
    attribute(continental_shelf_or_eez_of, not_on_continental_shelf_or_eez)
]).
origin_exclusions_profile_for(origin_norway, [
    attribute(military_activities, no),
    attribute(non_preferential_origin, norway),
