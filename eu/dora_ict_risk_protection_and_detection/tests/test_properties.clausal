% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_properties.clausal -- structural PROPERTIES over the subject set.
% Totality: every registered subject classifies.
% Determinism: every query yields exactly one answer for every subject.
% Citation discipline: final answers cite, statuses cite nothing, and only
% the order's citation vocabulary is returned.
% Duty order: every list of duties is in duty order.
% Domain invariants: each always-duty decides incomplete alone; the gate of
% Art 16(1), when true, decides every query.
% Each property has a falsifier in test_negative_controls.clausal or a
% positive pair here, so none is vacuous.
% Run: python -m clausal.testing eu/dora_ict_risk_protection_and_detection/tests/test_properties.clausal
% =====================================================================
:- module(test_properties, []).
:- use_module(library(reif), [memberd_t/3]).
:- use_module(eu/dora_ict_risk_protection_and_detection/dora_ict_risk_protection_and_detection, [
    ict_risk_protection_and_detection_duties_required/3,
    ict_risk_protection_and_detection_duties_complete/3,
    ict_risk_protection_and_detection_duties_outstanding/3,
    decide_dora_ict_risk_protection_and_detection/2
]).
:- use_module(eu/dora_ict_risk_protection_and_detection/kernel, [dora_ict_risk_protection_and_detection_input_problems/2]).
:- use_module(eu/dora_ict_risk_protection_and_detection/queries, [dora_ict_risk_protection_and_detection_profile_keys/1]).
:- use_module(eu/dora_ict_risk_protection_and_detection/fixtures, [
    dora_ict_risk_protection_and_detection_subject/1,
    dora_ict_risk_protection_and_detection_profile_for/2
]).

subject_classifies(Subject) :-
    dora_ict_risk_protection_and_detection_subject(Subject),
    dora_ict_risk_protection_and_detection_profile_for(Subject, Profile),
    decide_dora_ict_risk_protection_and_detection(Profile, _Verdict).

answer_counts(Subject, [RequiredCount, CompleteCount, OutstandingCount]) :-
    dora_ict_risk_protection_and_detection_profile_for(Subject, Profile),
    findall(Result-Citations, ict_risk_protection_and_detection_duties_required(Profile, Result, Citations), RequiredAnswers),
    length(RequiredAnswers, RequiredCount),
    findall(Result-Citations, ict_risk_protection_and_detection_duties_complete(Profile, Result, Citations), CompleteAnswers),
    length(CompleteAnswers, CompleteCount),
    findall(Result-Citations, ict_risk_protection_and_detection_duties_outstanding(Profile, Result, Citations), OutstandingAnswers),
    length(OutstandingAnswers, OutstandingCount).

% any_answer(Profile, Result, Citations): an answer of any of the three queries.
any_answer(Profile, Result, Citations) :-
    ict_risk_protection_and_detection_duties_required(Profile, Result, Citations).
any_answer(Profile, Result, Citations) :-
    ict_risk_protection_and_detection_duties_complete(Profile, Result, Citations).
any_answer(Profile, Result, Citations) :-
    ict_risk_protection_and_detection_duties_outstanding(Profile, Result, Citations).

subject_answer(Result, Citations) :-
    dora_ict_risk_protection_and_detection_subject(Subject),
    dora_ict_risk_protection_and_detection_profile_for(Subject, Profile),
    any_answer(Profile, Result, Citations).

result_shape(complete, final).
result_shape(incomplete, final).
result_shape(none_outstanding, final).
result_shape(simplified_framework_entity, final).
result_shape(required(_), final).
result_shape(outstanding(_), final).
result_shape(indeterminate(_), status).
result_shape(needs_legal_review(_, _), status).
result_shape(input_problems(_), status).

citations_disagree(final, []).
citations_disagree(status, [_|_]).

citation_vocabulary([eu_reg_2022_2554_art_9_1, eu_reg_2022_2554_art_9_2, eu_reg_2022_2554_art_9_3, eu_reg_2022_2554_art_9_4, eu_reg_2022_2554_art_10_1, eu_reg_2022_2554_art_10_2, eu_reg_2022_2554_art_10_3, eu_reg_2022_2554_art_10_4, eu_reg_2022_2554_art_9_3_a, eu_reg_2022_2554_art_9_3_b, eu_reg_2022_2554_art_9_3_c, eu_reg_2022_2554_art_9_3_d, eu_reg_2022_2554_art_9_4_a, eu_reg_2022_2554_art_9_4_b, eu_reg_2022_2554_art_9_4_c, eu_reg_2022_2554_art_9_4_d, eu_reg_2022_2554_art_9_4_e, eu_reg_2022_2554_art_9_4_f, eu_reg_2022_2554_art_16_1]).

duty_order([monitoring_and_control_of_ict_systems, ict_security_tools_policies_and_procedures, ict_security_policies_procedures_protocols_and_tools, appropriate_ict_solutions_and_processes, security_of_data_transfer, minimised_data_corruption_loss_and_unauthorised_access, prevention_of_unavailability_impairment_breaches_and_loss, protection_from_data_management_risks, information_security_policy, network_and_infrastructure_management, access_control_policies, strong_authentication_and_cryptographic_key_protection, ict_change_management, patch_and_update_policies, severable_network_connection_infrastructure, approved_ict_change_management_process, anomaly_detection_mechanisms, single_point_of_failure_identification, regular_testing_of_detection_mechanisms, detection_control_layers_alert_thresholds_and_automatic_alerts, resources_to_monitor_user_activity_anomalies_and_incidents, trade_report_checking_systems]).

% ordered_subsequence(Duties, All): Duties appear in All, in All's order.
ordered_subsequence([], _).
ordered_subsequence([Duty|Duties], [Duty|Rest]) :-
    ordered_subsequence(Duties, Rest).
ordered_subsequence([Duty|Duties], [Other|Rest]) :-
    dif(Duty, Other),
    ordered_subsequence([Duty|Duties], Rest).

duty_list_of(required(Duties), Duties).
duty_list_of(outstanding(Duties), Duties).

listed_subject(Subject) :-
    dora_ict_risk_protection_and_detection_subject(Subject),
    dora_ict_risk_protection_and_detection_profile_for(Subject, Profile),
    any_answer(Profile, Result, _),
    duty_list_of(Result, _).

ordered_subject(Subject) :-
    dora_ict_risk_protection_and_detection_subject(Subject),
    dora_ict_risk_protection_and_detection_profile_for(Subject, Profile),
    any_answer(Profile, Result, _),
    duty_list_of(Result, Duties),
    duty_order(All),
    ordered_subsequence(Duties, All).

replace_value(Key, Value, Profile, [attribute(Key, Value)|Rest]) :-
    select(attribute(Key, _), Profile, Rest).

falsified_is_incomplete(Key) :-
    dora_ict_risk_protection_and_detection_profile_for(credit_institution_all_duties_performed, Base),
    replace_value(Key, false, Base, Profile),
    ict_risk_protection_and_detection_duties_complete(Profile, incomplete, _).

override_gate(Profile, [attribute(financial_entity_is_article_16_1_entity, true)|Kept]) :-
    drop_gate(Profile, Kept).

drop_gate([], []).
drop_gate([attribute(financial_entity_is_article_16_1_entity, _)|Elements], Kept) :-
    drop_gate(Elements, Kept).
drop_gate([attribute(Key, Value)|Elements], [attribute(Key, Value)|Kept]) :-
    dif(Key, financial_entity_is_article_16_1_entity),
    drop_gate(Elements, Kept).

well_formed_subject(Subject) :-
    dora_ict_risk_protection_and_detection_subject(Subject),
    dora_ict_risk_protection_and_detection_profile_for(Subject, Profile),
    dora_ict_risk_protection_and_detection_input_problems(Profile, []).

gate_decides(Subject) :-
    well_formed_subject(Subject),
    dora_ict_risk_protection_and_detection_profile_for(Subject, Profile),
    override_gate(Profile, GateProfile),
    ict_risk_protection_and_detection_duties_required(GateProfile, simplified_framework_entity, [cite(eu_reg_2022_2554_art_16_1)]),
    ict_risk_protection_and_detection_duties_complete(GateProfile, simplified_framework_entity, [cite(eu_reg_2022_2554_art_16_1)]),
    ict_risk_protection_and_detection_duties_outstanding(GateProfile, simplified_framework_entity, [cite(eu_reg_2022_2554_art_16_1)]).

% sort/2 collapses a subject that classifies more than once.
test(totality_every_subject_classifies) :-
    findall(Subject, dora_ict_risk_protection_and_detection_subject(Subject), Subjects),
    sort(Subjects, SubjectSet),
    findall(Subject, subject_classifies(Subject), ClassifiedSubjects),
    sort(ClassifiedSubjects, SubjectSet).

test(determinism_every_query_gives_exactly_one_answer) :-
    findall(Subject-Counts, (dora_ict_risk_protection_and_detection_subject(Subject), answer_counts(Subject, Counts)), Rows),
    findall(Subject-[1, 1, 1], dora_ict_risk_protection_and_detection_subject(Subject), Expected),
    Rows == Expected.

test(every_answer_has_a_known_shape) :-
    findall(Result, subject_answer(Result, _), Results),
    findall(Result, (subject_answer(Result, _), result_shape(Result, _)), Shaped),
    length(Results, Count),
    length(Shaped, Count),
    Results = [_|_].

test(final_answers_cite_and_statuses_cite_nothing, fail) :-
    subject_answer(Result, Citations),
    result_shape(Result, Shape),
    citations_disagree(Shape, Citations).

test(only_the_citation_vocabulary_is_returned, fail) :-
    subject_answer(_, Citations),
    member(cite(Key), Citations),
    citation_vocabulary(Vocabulary),
    memberd_t(Key, Vocabulary, false).

test(the_citation_vocabulary_is_returned) :-
    subject_answer(complete, Citations),
    member(cite(eu_reg_2022_2554_art_10_4), Citations).

test(every_duty_list_is_in_duty_order) :-
    findall(Subject, listed_subject(Subject), Listed),
    findall(Subject, ordered_subject(Subject), Ordered),
    Ordered == Listed,
    Listed = [_|_].

test(every_always_duty_decides_incomplete_alone) :-
    dora_ict_risk_protection_and_detection_profile_keys([_, _|DutyKeys]),
    append(AlwaysKeys, [trade_report_checking_systems_in_place], DutyKeys),
    length(AlwaysKeys, 21),
    findall(Key, (member(Key, AlwaysKeys), falsified_is_incomplete(Key)), Incomplete),
    Incomplete == AlwaysKeys.

test(the_trade_report_duty_alone_does_not_decide_for_a_credit_institution, fail) :-
    falsified_is_incomplete(trade_report_checking_systems_in_place).

test(the_gate_true_decides_every_query_for_every_well_formed_subject) :-
    findall(Subject, well_formed_subject(Subject), WellFormed),
    findall(Subject, gate_decides(Subject), Decided),
    Decided == WellFormed,
    WellFormed = [_|_].

:- end_module(test_properties).
