% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/dora_ict_risk_protection_and_detection.
%
% Instrument: Regulation (EU) 2022/2554 of the European Parliament and of the
% Council of 14 December 2022 on digital operational resilience for the
% financial sector (DORA), CELEX 32022R2554, the original OJ text as published,
% OJ L 333, 27.12.2022, p. 1 (no consolidated version is pinned; pin folder
% eu/dora_ict_risk_protection_and_detection/sources/).
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% Each verbatim is an exact substring of the pinned unit text.
%
% A clause cites a key with a cite(Key) term; cite(...) is data and
% needs no import.
%
% PROVENANCE: every operative clause opens its body with implements(Key),
% Key the provision for THAT condition or value. implements(Key) succeeds
% for every key recorded here and fails for any other.
%
% Keys are the canonical lexicon keys of citation_vocabulary. Art 9(4) is
% recorded as a paragraph key because its pinned unit holds the two closing
% subparagraphs (for points (b) and (e)) the order reads as duties.
% Provisions not read (Art 2, Art 4, Art 16(1) second subparagraph, (2), (3),
% Art 17, Art 25, Art 64, Delegated Regulation (EU) 2024/1774) are in the
% excluded or deferred sets and get no key: no clause decides or applies them.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

implements(Key) :-
    citation(Key, _).

citation(eu_reg_2022_2554_art_9_1, [label-'Regulation (EU) 2022/2554 (DORA) Art 9(1), continuous monitoring and control of ICT systems and deployment of ICT security tools, policies and procedures', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (unit 32022R2554#parag_009.001)', verbatim-'financial entities shall continuously monitor and control the security and functioning of ICT systems and tools']).

citation(eu_reg_2022_2554_art_9_2, [label-'Regulation (EU) 2022/2554 (DORA) Art 9(2), ICT security policies, procedures, protocols and tools', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (unit 32022R2554#parag_009.002)', verbatim-'Financial entities shall design, procure and implement ICT security policies, procedures, protocols and tools']).

citation(eu_reg_2022_2554_art_9_3, [label-'Regulation (EU) 2022/2554 (DORA) Art 9(3), lead words, use of appropriate ICT solutions and processes', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (unit 32022R2554#parag_009.003)', verbatim-'financial entities shall use ICT solutions and processes that are appropriate in accordance with Article 4']).

citation(eu_reg_2022_2554_art_9_3_a, [label-'Regulation (EU) 2022/2554 (DORA) Art 9(3)(a), security of the means of transfer of data', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (unit 32022R2554#point_009.003_a)', verbatim-'ensure the security of the means of transfer of data']).

citation(eu_reg_2022_2554_art_9_3_b, [label-'Regulation (EU) 2022/2554 (DORA) Art 9(3)(b), minimising corruption or loss of data, unauthorised access and technical flaws', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (unit 32022R2554#point_009.003_b)', verbatim-'minimise the risk of corruption or loss of data, unauthorised access and technical flaws that may hinder business activity']).

citation(eu_reg_2022_2554_art_9_3_c, [label-'Regulation (EU) 2022/2554 (DORA) Art 9(3)(c), preventing unavailability, impairment, breaches of confidentiality and loss of data', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (unit 32022R2554#point_009.003_c)', verbatim-'prevent the lack of availability, the impairment of the authenticity and integrity, the breaches of confidentiality and the loss of data']).

citation(eu_reg_2022_2554_art_9_3_d, [label-'Regulation (EU) 2022/2554 (DORA) Art 9(3)(d), protection of data from data management risks', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (unit 32022R2554#point_009.003_d)', verbatim-'ensure that data is protected from risks arising from data management']).

citation(eu_reg_2022_2554_art_9_4, [label-'Regulation (EU) 2022/2554 (DORA) Art 9(4), the closing subparagraphs for points (b) and (e): severable network connection infrastructure and approved ICT change management process', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (unit 32022R2554#parag_009.004)', verbatim-'design the network connection infrastructure in a way that allows it to be instantaneously severed or segmented']).

citation(eu_reg_2022_2554_art_9_4_a, [label-'Regulation (EU) 2022/2554 (DORA) Art 9(4)(a), information security policy', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (unit 32022R2554#point_009.004_a)', verbatim-'develop and document an information security policy']).

citation(eu_reg_2022_2554_art_9_4_b, [label-'Regulation (EU) 2022/2554 (DORA) Art 9(4)(b), network and infrastructure management structure', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (unit 32022R2554#point_009.004_b)', verbatim-'establish a sound network and infrastructure management structure']).

citation(eu_reg_2022_2554_art_9_4_c, [label-'Regulation (EU) 2022/2554 (DORA) Art 9(4)(c), access limiting policies and access rights controls', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (unit 32022R2554#point_009.004_c)', verbatim-'implement policies that limit the physical or logical access to information assets and ICT assets']).

citation(eu_reg_2022_2554_art_9_4_d, [label-'Regulation (EU) 2022/2554 (DORA) Art 9(4)(d), strong authentication and protection of cryptographic keys', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (unit 32022R2554#point_009.004_d)', verbatim-'implement policies and protocols for strong authentication mechanisms']).

citation(eu_reg_2022_2554_art_9_4_e, [label-'Regulation (EU) 2022/2554 (DORA) Art 9(4)(e), ICT change management policies, procedures and controls', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (unit 32022R2554#point_009.004_e)', verbatim-'implement documented policies, procedures and controls for ICT change management']).

citation(eu_reg_2022_2554_art_9_4_f, [label-'Regulation (EU) 2022/2554 (DORA) Art 9(4)(f), documented policies for patches and updates', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (unit 32022R2554#point_009.004_f)', verbatim-'have appropriate and comprehensive documented policies for patches and updates']).

citation(eu_reg_2022_2554_art_10_1, [label-'Regulation (EU) 2022/2554 (DORA) Art 10(1), mechanisms to detect anomalous activities and identify single points of failure, and their regular testing', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (unit 32022R2554#parag_010.001)', verbatim-'Financial entities shall have in place mechanisms to promptly detect anomalous activities']).

citation(eu_reg_2022_2554_art_10_2, [label-'Regulation (EU) 2022/2554 (DORA) Art 10(2), control layers, alert thresholds and automatic alert mechanisms of the detection mechanisms', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (unit 32022R2554#parag_010.002)', verbatim-'The detection mechanisms referred to in paragraph 1 shall enable multiple layers of control']).

citation(eu_reg_2022_2554_art_10_3, [label-'Regulation (EU) 2022/2554 (DORA) Art 10(3), sufficient resources and capabilities to monitor user activity, ICT anomalies and ICT-related incidents', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (unit 32022R2554#parag_010.003)', verbatim-'Financial entities shall devote sufficient resources and capabilities to monitor user activity']).

citation(eu_reg_2022_2554_art_10_4, [label-'Regulation (EU) 2022/2554 (DORA) Art 10(4), trade report checking systems of data reporting service providers', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (unit 32022R2554#parag_010.004)', verbatim-'Data reporting service providers shall, in addition, have in place systems that can effectively check trade reports for completeness']).

citation(eu_reg_2022_2554_art_16_1, [label-'Regulation (EU) 2022/2554 (DORA) Art 16(1), first subparagraph, Articles 5 to 15 do not apply to the entities listed', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (unit 32022R2554#parag_016.001)', verbatim-'Articles 5 to 15 of this Regulation shall not apply to']).

:- end_module(citations).
