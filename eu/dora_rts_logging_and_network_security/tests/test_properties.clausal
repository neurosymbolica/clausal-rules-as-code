% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_properties.clausal -- structural PROPERTIES over the subject set.
% Totality: every registered subject yields a verdict.
% Determinism: every subject yields exactly ONE answer from each query.
% Well-formedness: each answer has one of the contract's forms; a final
% answer cites a non-empty set of vocabulary keys, each once; a status
% compound cites []; indeterminate names exactly one key.
% Domain invariants: complete agrees with none_outstanding; the Art 16(1)
% gate answers every query alike; every applying duty judged false makes
% the duties incomplete, and the outstanding lists follow duty order.
% Run: python -m clausal.testing eu/dora_rts_logging_and_network_security/tests/test_properties.clausal
% =====================================================================
:- module(test_properties, []).
:- use_module(library(clpz)).
:- use_module(eu/dora_rts_logging_and_network_security/dora_rts_logging_and_network_security, [
    decide_dora_rts_logging_and_network_security/2,
    rts_logging_and_network_security_duties_required/3,
    rts_logging_and_network_security_duties_complete/3,
    rts_logging_and_network_security_duties_outstanding/3
]).
:- use_module(eu/dora_rts_logging_and_network_security/queries, [dora_rts_logging_and_network_security_profile_keys/1]).
:- use_module(eu/dora_rts_logging_and_network_security/fixtures, [
    dora_rts_logging_and_network_security_subject/1,
    dora_rts_logging_and_network_security_profile_for/2
]).

subject_profile(Subject, Profile) :-
    dora_rts_logging_and_network_security_subject(Subject),
    dora_rts_logging_and_network_security_profile_for(Subject, Profile).

subject_classifies(Subject) :-
    subject_profile(Subject, Profile),
    decide_dora_rts_logging_and_network_security(Profile, _Verdict).

query_name(required).
query_name(complete).
query_name(outstanding).

query_answer(required, Profile, Result, Citations) :-
    rts_logging_and_network_security_duties_required(Profile, Result, Citations).
query_answer(complete, Profile, Result, Citations) :-
    rts_logging_and_network_security_duties_complete(Profile, Result, Citations).
query_answer(outstanding, Profile, Result, Citations) :-
    rts_logging_and_network_security_duties_outstanding(Profile, Result, Citations).

subject_query_answer_count(Subject, QueryName, AnswerCount) :-
    subject_profile(Subject, Profile),
    query_name(QueryName),
    findall(Result-Citations, query_answer(QueryName, Profile, Result, Citations), Answers),
    length(Answers, AnswerCount).

% ---- the forms of an answer ----------------------------------------------
result_kind(complete, final).
result_kind(incomplete, final).
result_kind(none_outstanding, final).
result_kind(simplified_framework_entity, final).
result_kind(required([DutyAtom|DutyAtoms]), final) :-
    maplist(atom, [DutyAtom|DutyAtoms]).
result_kind(outstanding([DutyAtom|DutyAtoms]), final) :-
    maplist(atom, [DutyAtom|DutyAtoms]).
result_kind(indeterminate([MissingKey]), status) :-
    atom(MissingKey).
result_kind(needs_legal_review(open_textured(ProfileKey, cite(CitationKey)), [inputs_relied_on(Pairs)]), status) :-
    atom(ProfileKey),
    atom(CitationKey),
    is_list(Pairs).
result_kind(input_problems([Problem|Problems]), status) :-
    is_list([Problem|Problems]).

citation_vocabulary([eu_reg_2024_1774_art_12_1, eu_reg_2024_1774_art_12_2_a, eu_reg_2024_1774_art_12_2_b, eu_reg_2024_1774_art_12_2_c_i, eu_reg_2024_1774_art_12_2_c_ii, eu_reg_2024_1774_art_12_2_c_iii, eu_reg_2024_1774_art_12_2_c_iv, eu_reg_2024_1774_art_12_2_c_v, eu_reg_2024_1774_art_12_2_d, eu_reg_2024_1774_art_12_2_e, eu_reg_2024_1774_art_12_2_f, eu_reg_2024_1774_art_12_2, eu_reg_2024_1774_art_13, eu_reg_2024_1774_art_13_a, eu_reg_2024_1774_art_13_a_i, eu_reg_2024_1774_art_13_a_ii, eu_reg_2024_1774_art_13_a_iii, eu_reg_2024_1774_art_13_b, eu_reg_2024_1774_art_13_c, eu_reg_2024_1774_art_13_d, eu_reg_2024_1774_art_13_e, eu_reg_2024_1774_art_13_f, eu_reg_2024_1774_art_13_g, eu_reg_2024_1774_art_13_h, eu_reg_2024_1774_art_13_i, eu_reg_2024_1774_art_13_j, eu_reg_2024_1774_art_13_k, eu_reg_2024_1774_art_13_l, eu_reg_2024_1774_art_13_m_i, eu_reg_2024_1774_art_13_m_ii, eu_reg_2024_1774_art_14_1, eu_reg_2024_1774_art_14_1_a, eu_reg_2024_1774_art_14_1_b, eu_reg_2024_1774_art_14_1_c, eu_reg_2024_1774_art_14_2, eu_reg_2022_2554_art_16_1]).

vocabulary_citation(cite(CitationKey)) :-
    citation_vocabulary(CitationKeys),
    member(CitationKey, CitationKeys).

citations_fit(final, [Citation|Citations]) :-
    maplist(vocabulary_citation, [Citation|Citations]),
    length([Citation|Citations], CitationCount),
    sort([Citation|Citations], Distinct),
    length(Distinct, CitationCount).
citations_fit(status, []).

answer_well_formed(Subject, QueryName) :-
    subject_profile(Subject, Profile),
    query_name(QueryName),
    query_answer(QueryName, Profile, Result, Citations),
    result_kind(Result, ResultKind),
    citations_fit(ResultKind, Citations).

% ---- profile plumbing ----------------------------------------------------
replace_value([], _, _, []).
replace_value([attribute(ProfileKey, _)|Remaining], Target, Value, [attribute(ProfileKey, Value)|NewRemaining]) :-
    ProfileKey == Target,
    replace_value(Remaining, Target, Value, NewRemaining).
replace_value([attribute(ProfileKey, OldValue)|Remaining], Target, Value, [attribute(ProfileKey, OldValue)|NewRemaining]) :-
    ProfileKey \== Target,
    replace_value(Remaining, Target, Value, NewRemaining).

single_false_answer(QueryName, ProfileKey, Result) :-
    dora_rts_logging_and_network_security_profile_for(all_performed_larger_entity_with_critical_systems, Profile),
    dora_rts_logging_and_network_security_profile_keys([_, _, _|DutyKeys]),
    member(ProfileKey, DutyKeys),
    replace_value(Profile, ProfileKey, false, Changed),
    query_answer(QueryName, Changed, Result, _).

complete_subject_outstanding(Subject, OutstandingResult) :-
    subject_profile(Subject, Profile),
    rts_logging_and_network_security_duties_complete(Profile, complete, _),
    rts_logging_and_network_security_duties_outstanding(Profile, OutstandingResult, _).

subsequence([], _).
subsequence([Element|Elements], [Element|Remaining]) :-
    subsequence(Elements, Remaining).
subsequence([Element|Elements], [Other|Remaining]) :-
    dif(Element, Other),
    subsequence([Element|Elements], Remaining).

% ---- properties ----------------------------------------------------------
% sort/2 collapses a subject that classifies more than once.
test(totality_every_subject_classifies) :-
    findall(Subject, dora_rts_logging_and_network_security_subject(Subject), Subjects),
    sort(Subjects, SubjectSet),
    findall(Subject, subject_classifies(Subject), ClassifiedSubjects),
    sort(ClassifiedSubjects, SubjectSet).

test(determinism_every_subject_answers_each_query_exactly_once) :-
    findall(Subject, dora_rts_logging_and_network_security_subject(Subject), Subjects),
    length(Subjects, SubjectCount),
    findall(AnswerCount, subject_query_answer_count(_, _, AnswerCount), AnswerCounts),
    length(AnswerCounts, PairCount),
    PairCount #= 3 * SubjectCount,
    sort(AnswerCounts, [1]).

test(every_answer_has_a_contract_form_and_its_citations) :-
    findall(Subject, dora_rts_logging_and_network_security_subject(Subject), Subjects),
    length(Subjects, SubjectCount),
    findall(Subject-QueryName, answer_well_formed(Subject, QueryName), Fitting),
    length(Fitting, FittingCount),
    FittingCount #= 3 * SubjectCount.

test(complete_agrees_with_none_outstanding) :-
    findall(OutstandingResult, complete_subject_outstanding(_, OutstandingResult), OutstandingResults),
    OutstandingResults = [_|_],
    sort(OutstandingResults, [none_outstanding]).

test(the_gate_answers_every_query_alike) :-
    dora_rts_logging_and_network_security_profile_for(article_16_1_entity, Profile),
    findall(QueryName-Result-Citations, (query_name(QueryName), query_answer(QueryName, Profile, Result, Citations)), Answers),
    Answers == [required-simplified_framework_entity-[cite(eu_reg_2022_2554_art_16_1)], complete-simplified_framework_entity-[cite(eu_reg_2022_2554_art_16_1)], outstanding-simplified_framework_entity-[cite(eu_reg_2022_2554_art_16_1)]].

test(every_applying_duty_judged_false_is_incomplete) :-
    findall(ProfileKey-Result, single_false_answer(complete, ProfileKey, Result), Results),
    length(Results, 35),
    findall(ProfileKey, member(ProfileKey-complete, Results), CompleteKeys),
    CompleteKeys == [network_architecture_and_security_design_reviewed_periodically],
    findall(ProfileKey, member(ProfileKey-incomplete, Results), IncompleteKeys),
    length(IncompleteKeys, 34).

test(single_failures_are_outstanding_in_duty_order) :-
    findall(Result, single_false_answer(outstanding, _, Result), Results),
    findall(DutyAtom, member(outstanding([DutyAtom]), Results), SingleDuties),
    length(SingleDuties, 34),
    member(none_outstanding, Results),
    dora_rts_logging_and_network_security_profile_for(all_performed_larger_entity_with_critical_systems, Profile),
    rts_logging_and_network_security_duties_required(Profile, required(Duties), _),
    SingleDuties == Duties.

test(an_outstanding_list_is_a_subsequence_of_the_required_list) :-
    dora_rts_logging_and_network_security_profile_for(several_duties_not_performed, Profile),
    rts_logging_and_network_security_duties_required(Profile, required(Duties), _),
    rts_logging_and_network_security_duties_outstanding(Profile, outstanding(Outstanding), _),
    subsequence(Outstanding, Duties).

:- end_module(test_properties).
