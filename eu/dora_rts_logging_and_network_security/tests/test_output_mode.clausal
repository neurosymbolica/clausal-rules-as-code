% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_output_mode.clausal -- OUTPUT MODE: the result arguments UNBOUND and
% read out (each query enumerates exactly one answer), with the duty
% lists in DUTY ORDER and the citations each written once.
% Run: python -m clausal.testing eu/dora_rts_logging_and_network_security/tests/test_output_mode.clausal
% =====================================================================
:- module(test_output_mode, []).
:- use_module(eu/dora_rts_logging_and_network_security/dora_rts_logging_and_network_security, [
    decide_dora_rts_logging_and_network_security/2,
    dora_rts_logging_and_network_security_status/2,
    dora_rts_logging_and_network_security_checklist/2,
    rts_logging_and_network_security_duties_required/3,
    rts_logging_and_network_security_duties_complete/3,
    rts_logging_and_network_security_duties_outstanding/3
]).
:- use_module(eu/dora_rts_logging_and_network_security/queries, [dora_rts_logging_and_network_security_profile_keys/1]).
:- use_module(eu/dora_rts_logging_and_network_security/fixtures, [dora_rts_logging_and_network_security_profile_for/2]).

test(the_baseline_profile_yields_exactly_one_status) :-
    dora_rts_logging_and_network_security_profile_for(all_performed_larger_entity_with_critical_systems, Profile),
    findall(Status, dora_rts_logging_and_network_security_status(Profile, Status), Statuses),
    Statuses == [complete].

test(the_verdict_carries_a_citation) :-
    dora_rts_logging_and_network_security_profile_for(all_performed_larger_entity_with_critical_systems, Profile),
    decide_dora_rts_logging_and_network_security(Profile, dora_rts_logging_and_network_security_verdict(complete, [_FirstCitation|_OtherCitations])).

test(complete_cites_the_thirty_five_keys_each_once) :-
    dora_rts_logging_and_network_security_profile_for(all_performed_larger_entity_with_critical_systems, Profile),
    findall(Result-Citations, rts_logging_and_network_security_duties_complete(Profile, Result, Citations), Answers),
    Answers = [complete-Citations],
    length(Citations, 35),
    sort(Citations, Distinct),
    length(Distinct, 35),
    member(cite(eu_reg_2024_1774_art_13_a_iii), Citations),
    member(cite(eu_reg_2024_1774_art_14_2), Citations).

test(incomplete_cites_the_same_thirty_five_keys) :-
    dora_rts_logging_and_network_security_profile_for(several_duties_not_performed, Profile),
    rts_logging_and_network_security_duties_complete(Profile, incomplete, Citations),
    dora_rts_logging_and_network_security_profile_for(all_performed_larger_entity_with_critical_systems, CompleteProfile),
    rts_logging_and_network_security_duties_complete(CompleteProfile, complete, CompleteCitations),
    msort(Citations, SortedCitations),
    msort(CompleteCitations, SortedCompleteCitations),
    SortedCitations == SortedCompleteCitations.

test(required_for_a_larger_entity_with_critical_systems) :-
    dora_rts_logging_and_network_security_profile_for(all_performed_larger_entity_with_critical_systems, Profile),
    findall(Result, rts_logging_and_network_security_duties_required(Profile, Result, _), [required(Duties)]),
    length(Duties, 34),
    Duties = [logging_procedures_protocols_and_tools|_],
    last(Duties, information_in_transit_design_basis),
    append(_, [firewall_rule_roles_responsibilities_and_steps, yearly_network_architecture_review, network_isolation_measures|_], Duties),
    append(_, [regular_firewall_rule_review, six_monthly_firewall_rule_verification, information_in_transit_policies_procedures_protocols_and_tools|_], Duties).

test(required_for_a_microenterprise_without_critical_systems) :-
    dora_rts_logging_and_network_security_profile_for(all_performed_microenterprise_without_critical_systems, Profile),
    rts_logging_and_network_security_duties_required(Profile, required(Duties), Citations),
    length(Duties, 33),
    append(_, [firewall_rule_roles_responsibilities_and_steps, periodic_network_architecture_review, network_isolation_measures|_], Duties),
    append(_, [regular_firewall_rule_review, information_in_transit_policies_procedures_protocols_and_tools|_], Duties),
    length(Citations, 35).

test(required_closing_subparagraph_of_article_12_follows_point_f) :-
    dora_rts_logging_and_network_security_profile_for(all_performed_larger_entity_with_critical_systems, Profile),
    rts_logging_and_network_security_duties_required(Profile, required(Duties), _),
    append(_, [clock_synchronisation, log_retention_period, network_security_management_policies_procedures_protocols_and_tools|_], Duties).

test(required_asks_the_size_class_then_the_critical_question) :-
    rts_logging_and_network_security_duties_required([attribute(financial_entity_is_article_16_1_entity, false)], FirstResult, FirstCitations),
    FirstResult == indeterminate([financial_entity_is_microenterprise]),
    FirstCitations == [],
    rts_logging_and_network_security_duties_required([attribute(financial_entity_is_article_16_1_entity, false), attribute(financial_entity_is_microenterprise, false)], SecondResult, SecondCitations),
    SecondResult == indeterminate([financial_entity_has_ict_systems_supporting_critical_or_important_functions]),
    SecondCitations == [].

test(outstanding_lists_failing_duties_in_duty_order) :-
    dora_rts_logging_and_network_security_profile_for(several_duties_not_performed, Profile),
    findall(Result-Citations, rts_logging_and_network_security_duties_outstanding(Profile, Result, Citations), [Result-Citations]),
    Result == outstanding([log_retention_period, encryption_of_network_connections, six_monthly_firewall_rule_verification]),
    msort(Citations, SortedCitations),
    SortedCitations == [cite(eu_reg_2024_1774_art_12_2), cite(eu_reg_2024_1774_art_13), cite(eu_reg_2024_1774_art_13_e)].

test(outstanding_asks_the_first_absent_key_that_can_change_the_list) :-
    dora_rts_logging_and_network_security_profile_for(gate_only_stated, Profile),
    rts_logging_and_network_security_duties_outstanding(Profile, Result, Citations),
    Result == indeterminate([financial_entity_is_microenterprise]),
    Citations == [].

test(a_referral_relies_on_every_present_pair_in_key_order) :-
    dora_rts_logging_and_network_security_profile_for(encryption_unsure, Profile),
    rts_logging_and_network_security_duties_complete(Profile, needs_legal_review(Reason, [inputs_relied_on(Pairs)]), Citations),
    Reason == open_textured(network_connections_encrypted, cite(eu_reg_2024_1774_art_13_e)),
    Citations == [],
    pairs_keys(Pairs, PairKeys),
    dora_rts_logging_and_network_security_profile_keys(ProfileKeys),
    PairKeys == ProfileKeys,
    member(network_connections_encrypted-unsure, Pairs).

test(the_outstanding_query_refers_the_same_unsure_key) :-
    dora_rts_logging_and_network_security_profile_for(encryption_unsure, Profile),
    rts_logging_and_network_security_duties_outstanding(Profile, needs_legal_review(open_textured(network_connections_encrypted, cite(eu_reg_2024_1774_art_13_e)), [inputs_relied_on(_)]), []).

test(the_checklist_has_one_cited_row_per_duty) :-
    dora_rts_logging_and_network_security_profile_for(encryption_not_performed_larger_entity, Profile),
    dora_rts_logging_and_network_security_checklist(Profile, Items),
    length(Items, 35),
    member(item(encryption_of_network_connections, unmet(not_performed), [cite(eu_reg_2024_1774_art_13_e)]), Items),
    member(item(periodic_network_architecture_review, inapplicable, [cite(eu_reg_2024_1774_art_13_i)]), Items),
    member(item(logging_procedures_protocols_and_tools, met, [cite(eu_reg_2024_1774_art_12_1)]), Items).

test(the_checklist_of_an_article_16_1_entity_is_one_row) :-
    dora_rts_logging_and_network_security_profile_for(article_16_1_entity, Profile),
    dora_rts_logging_and_network_security_checklist(Profile, Items),
    Items == [item(simplified_framework_entity, inapplicable, [cite(eu_reg_2022_2554_art_16_1)])].

:- end_module(test_output_mode).
