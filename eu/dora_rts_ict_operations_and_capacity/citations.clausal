% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/dora_rts_ict_operations_and_capacity.
%
% Instruments (pinned texts in eu/dora_rts_ict_operations_and_capacity/sources/):
%   - Commission Delegated Regulation (EU) 2024/1774 (RTS on the ICT risk
%     management framework), CELEX 32024R1774, original OJ text: Articles 8
%     and 9 (keys eu_reg_2024_1774_art_...);
%   - Regulation (EU) 2022/2554 (DORA), CELEX 32022R2554, OJ L 333,
%     27.12.2022, p. 1: Article 16(1), first subparagraph (key
%     eu_reg_2022_2554_art_16_1).
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order. The
% verbatim is an exact substring of the pinned unit text; each key's entry
% in citations-sources.yaml is `status: verified`.
%
% Keys follow the canonical lexicon scheme (_lexicon/citations.yaml). The
% lead words of Art 8(2) and of its points (a), (b) and (c), and the lead
% words of Art 9(1)(c), set no duty of their own and are cited through their
% points (readings (7) and (10)); the second subparagraph of Art 8(2) is
% cited by the paragraph key eu_reg_2024_1774_art_8_2 (reading (8)). The
% headings of RTS Articles 8 and 9 and of DORA Article 16 carry no rule and
% get no key.
%
% PROVENANCE: every operative clause opens its body with implements(Key),
% Key a key recorded here. implements/1 succeeds for every recorded key and
% fails for any other.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

implements(Key) :-
    citation(Key, _).

% ---- DORA Article 16(1), first subparagraph: the gate (reading (2)) ----
citation(eu_reg_2022_2554_art_16_1, [label-'Regulation (EU) 2022/2554 (DORA) Art 16(1), first subparagraph (entities to which Articles 5 to 15 do not apply)', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj', verbatim-'Articles 5 to 15 of this Regulation shall not apply to small and non-interconnected investment firms']).

% ---- RTS 2024/1774 Article 8(1): duties 1 and 2 (readings (4) to (6)) ----
citation(eu_reg_2024_1774_art_8_1, [label-'Commission Delegated Regulation (EU) 2024/1774 Art 8(1) (policies and procedures for ICT operations)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'financial entities shall develop, document, and implement policies and procedures to manage the ICT operations']).

% ---- RTS 2024/1774 Article 8(2): lead words and second subparagraph (duties 16 to 18) ----
citation(eu_reg_2024_1774_art_8_2, [label-'Commission Delegated Regulation (EU) 2024/1774 Art 8(2), lead words and second subparagraph (contents of the policies for ICT operations; separation, production testing)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'The policies and procedures for ICT operations referred to in paragraph 1 shall contain all of the following']).

% ---- RTS 2024/1774 Article 8(2)(a): the ICT assets description (duties 3 to 5) ----
citation(eu_reg_2024_1774_art_8_2_a_i, [label-'Commission Delegated Regulation (EU) 2024/1774 Art 8(2)(a)(i) (secure installation, maintenance, configuration and deinstallation)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'requirements regarding secure installation, maintenance, configuration, and deinstallation of an ICT system']).
citation(eu_reg_2024_1774_art_8_2_a_ii, [label-'Commission Delegated Regulation (EU) 2024/1774 Art 8(2)(a)(ii) (management of information assets used by ICT assets)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'requirements regarding the management of information assets used by ICT assets, including their processing and handling, both automated and manual']).
citation(eu_reg_2024_1774_art_8_2_a_iii, [label-'Commission Delegated Regulation (EU) 2024/1774 Art 8(2)(a)(iii) (identification and control of legacy ICT systems)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'requirements regarding the identification and control of legacy ICT systems']).

% ---- RTS 2024/1774 Article 8(2)(b): controls and monitoring of ICT systems (duties 6 to 12) ----
citation(eu_reg_2024_1774_art_8_2_b_i, [label-'Commission Delegated Regulation (EU) 2024/1774 Art 8(2)(b)(i) (backup and restore requirements)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'backup and restore requirements of ICT systems']).
citation(eu_reg_2024_1774_art_8_2_b_ii, [label-'Commission Delegated Regulation (EU) 2024/1774 Art 8(2)(b)(ii) (scheduling requirements considering interdependencies)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'scheduling requirements, taking into consideration interdependencies among the ICT systems']).
citation(eu_reg_2024_1774_art_8_2_b_iii, [label-'Commission Delegated Regulation (EU) 2024/1774 Art 8(2)(b)(iii) (audit-trail and system log protocols)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'protocols for audit-trail and system log information']).
citation(eu_reg_2024_1774_art_8_2_b_iv, [label-'Commission Delegated Regulation (EU) 2024/1774 Art 8(2)(b)(iv) (internal audit and testing minimising disruption)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'requirements to ensure that the performance of internal audit and other testing minimises disruptions to business operations']).
citation(eu_reg_2024_1774_art_8_2_b_v, [label-'Commission Delegated Regulation (EU) 2024/1774 Art 8(2)(b)(v) (separation of production from non-production environments)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'requirements on the separation of ICT production environments from the development, testing, and other non-production environments']).
citation(eu_reg_2024_1774_art_8_2_b_vi, [label-'Commission Delegated Regulation (EU) 2024/1774 Art 8(2)(b)(vi) (development and testing in separated environments)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'requirements to conduct the development and testing in environments which are separated from the production environment']).
citation(eu_reg_2024_1774_art_8_2_b_vii, [label-'Commission Delegated Regulation (EU) 2024/1774 Art 8(2)(b)(vii) (development and testing in production environments)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'requirements to conduct the development and testing in production environments']).

% ---- RTS 2024/1774 Article 8(2)(c): error handling concerning ICT systems (duties 13 to 15) ----
citation(eu_reg_2024_1774_art_8_2_c_i, [label-'Commission Delegated Regulation (EU) 2024/1774 Art 8(2)(c)(i) (procedures and protocols for handling errors)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'procedures and protocols for handling errors']).
citation(eu_reg_2024_1774_art_8_2_c_ii, [label-'Commission Delegated Regulation (EU) 2024/1774 Art 8(2)(c)(ii) (support and escalation contacts)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'support and escalation contacts, including external support contacts in case of unexpected operational or technical issues']).
citation(eu_reg_2024_1774_art_8_2_c_iii, [label-'Commission Delegated Regulation (EU) 2024/1774 Art 8(2)(c)(iii) (restart, rollback and recovery procedures)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'ICT system restart, rollback, and recovery procedures for use in the event of ICT system disruption']).

% ---- RTS 2024/1774 Article 9(1): capacity and performance management (duties 19 to 24) ----
citation(eu_reg_2024_1774_art_9_1, [label-'Commission Delegated Regulation (EU) 2024/1774 Art 9(1), lead words (capacity and performance management procedures)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'financial entities shall develop, document, and implement capacity and performance management procedures for the following']).
citation(eu_reg_2024_1774_art_9_1_a, [label-'Commission Delegated Regulation (EU) 2024/1774 Art 9(1)(a) (identification of capacity requirements)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'the identification of capacity requirements of their ICT systems']).
citation(eu_reg_2024_1774_art_9_1_b, [label-'Commission Delegated Regulation (EU) 2024/1774 Art 9(1)(b) (application of resource optimisation)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'the application of resource optimisation']).
citation(eu_reg_2024_1774_art_9_1_c_i, [label-'Commission Delegated Regulation (EU) 2024/1774 Art 9(1)(c)(i) (monitoring: availability of data and ICT systems)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'the availability of data and ICT systems']).
citation(eu_reg_2024_1774_art_9_1_c_ii, [label-'Commission Delegated Regulation (EU) 2024/1774 Art 9(1)(c)(ii) (monitoring: efficiency of ICT systems)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'the efficiency of ICT systems']).
citation(eu_reg_2024_1774_art_9_1_c_iii, [label-'Commission Delegated Regulation (EU) 2024/1774 Art 9(1)(c)(iii) (monitoring: prevention of ICT capacity shortages)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'the prevention of ICT capacity shortages']).

% ---- RTS 2024/1774 Article 9(2): long procurement or resource-intensive systems (duty 25) ----
citation(eu_reg_2024_1774_art_9_2, [label-'Commission Delegated Regulation (EU) 2024/1774 Art 9(2) (measures for ICT systems with long or complex procurement or approval processes or that are resource-intensive)', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'shall ensure that financial entities take measures that are appropriate to cater for the specificities of ICT systems with long or complex procurement or approval processes or ICT systems that are resource-intensive']).

:- end_module(citations).
