% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_public_interface.clausal -- the package's PUBLIC surface, exercised
% through the generated package facade (what an external caller sees).
% Each fixture subject resolves to its expected status (the concrete
% atom or compound); near-miss controls get the opposite verdict.
% Run: python -m clausal.testing eu/dora_rts_ict_operations_and_capacity/tests/test_public_interface.clausal
% =====================================================================
:- module(test_public_interface, []).
:- use_module(eu/dora_rts_ict_operations_and_capacity, [
    rts_ict_operations_and_capacity_duties_required/3,
    rts_ict_operations_and_capacity_duties_complete/3,
    rts_ict_operations_and_capacity_duties_outstanding/3,
    decide_dora_rts_ict_operations_and_capacity/2,
    dora_rts_ict_operations_and_capacity_status/2,
    dora_rts_ict_operations_and_capacity_checklist/2,
    dora_rts_ict_operations_and_capacity_decision_resolvable/1,
    dora_rts_ict_operations_and_capacity_status_values/1,
    dora_rts_ict_operations_and_capacity_subject/1,
    dora_rts_ict_operations_and_capacity_profile_for/2,
    dora_rts_ict_operations_and_capacity_assess/2
]).

% ---- helpers (plumbing) ----------------------------------------------
fixed_four([
    cite(eu_reg_2024_1774_art_8_1),
    cite(eu_reg_2024_1774_art_8_2),
    cite(eu_reg_2024_1774_art_9_1),
    cite(eu_reg_2024_1774_art_9_2)
]).

same_citations(Citations, Expected) :-
    msort(Citations, Sorted),
    msort(Expected, Sorted).

subject_status(Subject, Status, Citations) :-
    dora_rts_ict_operations_and_capacity_assess(Subject, dora_rts_ict_operations_and_capacity_verdict(Status, Citations)).

one_verdict(Subject) :-
    findall(Verdict, dora_rts_ict_operations_and_capacity_assess(Subject, Verdict), Verdicts),
    length(Verdicts, 1).

has_checklist(Subject) :-
    dora_rts_ict_operations_and_capacity_profile_for(Subject, Profile),
    dora_rts_ict_operations_and_capacity_checklist(Profile, [_FirstItem|_OtherItems]).

is_final(Subject) :-
    subject_status(Subject, Status, _),
    dora_rts_ict_operations_and_capacity_status_values(StatusValues),
    member(Status, StatusValues).

required_of(Subject, Result, Citations) :-
    dora_rts_ict_operations_and_capacity_profile_for(Subject, Profile),
    rts_ict_operations_and_capacity_duties_required(Profile, Result, Citations).

complete_of(Subject, Result, Citations) :-
    dora_rts_ict_operations_and_capacity_profile_for(Subject, Profile),
    rts_ict_operations_and_capacity_duties_complete(Profile, Result, Citations).

outstanding_of(Subject, Result, Citations) :-
    dora_rts_ict_operations_and_capacity_profile_for(Subject, Profile),
    rts_ict_operations_and_capacity_duties_outstanding(Profile, Result, Citations).

one_answer_each(Subject) :-
    dora_rts_ict_operations_and_capacity_profile_for(Subject, Profile),
    findall(Result-Citations, rts_ict_operations_and_capacity_duties_required(Profile, Result, Citations), Required),
    findall(Result-Citations, rts_ict_operations_and_capacity_duties_complete(Profile, Result, Citations), Complete),
    findall(Result-Citations, rts_ict_operations_and_capacity_duties_outstanding(Profile, Result, Citations), Outstanding),
    length(Required, 1),
    length(Complete, 1),
    length(Outstanding, 1).

% ---- registry ----------------------------------------------------------
test(every_subject_has_exactly_one_verdict) :-
    findall(Subject, dora_rts_ict_operations_and_capacity_subject(Subject), Subjects),
    length(Subjects, 15),
    maplist(one_verdict, Subjects).
test(every_subject_has_exactly_one_answer_per_contract_query) :-
    findall(Subject, dora_rts_ict_operations_and_capacity_subject(Subject), Subjects),
    maplist(one_answer_each, Subjects).

% ---- the gate: DORA Art 16(1) ----------------------------------------
test(an_article_16_1_entity_is_a_simplified_framework_entity) :-
    subject_status(article_16_1_entity, Status, Citations),
    Status == simplified_framework_entity,
    Citations == [cite(eu_reg_2022_2554_art_16_1)].
test(an_article_16_1_entity_is_not_complete, fail) :-
    subject_status(article_16_1_entity, complete, _).
test(the_control_outside_article_16_1_is_complete) :-
    subject_status(every_duty_performed_without_production, Status, Citations),
    Status == complete,
    fixed_four(Fixed),
    same_citations(Citations, Fixed).
test(the_control_outside_article_16_1_is_not_simplified, fail) :-
    subject_status(every_duty_performed_without_production, simplified_framework_entity, _).
test(the_gate_not_stated_is_asked_first) :-
    subject_status(gate_not_stated, Status, Citations),
    Status == indeterminate([financial_entity_is_article_16_1_entity]),
    Citations == [].
test(the_gate_not_stated_is_not_complete, fail) :-
    subject_status(gate_not_stated, complete, _).

% ---- duties that always apply ----------------------------------------
test(one_duty_not_performed_is_incomplete) :-
    subject_status(one_duty_not_performed, Status, Citations),
    Status == incomplete,
    fixed_four(Fixed),
    same_citations(Citations, Fixed).
test(one_duty_not_performed_is_not_complete, fail) :-
    subject_status(one_duty_not_performed, complete, _).
test(a_false_key_decides_before_absent_keys) :-
    subject_status(failing_duty_with_others_unstated, Status, _),
    Status == incomplete.
test(a_false_key_with_absent_keys_is_not_indeterminate, fail) :-
    subject_status(failing_duty_with_others_unstated, indeterminate(_), _).
test(one_duty_unstated_names_its_key) :-
    subject_status(one_duty_unstated, Status, Citations),
    Status == indeterminate([capacity_procedures_apply_resource_optimisation]),
    Citations == [].
test(one_duty_unstated_is_not_complete, fail) :-
    subject_status(one_duty_unstated, complete, _).
test(one_duty_unsure_is_referred_with_its_citation) :-
    subject_status(one_duty_unsure, needs_legal_review(open_textured(Key, Citation), [inputs_relied_on(Pairs)]), Citations),
    Key == capacity_procedures_apply_resource_optimisation,
    Citation == cite(eu_reg_2024_1774_art_9_1_b),
    Citations == [],
    length(Pairs, 27),
    Pairs = [financial_entity_is_article_16_1_entity-false, development_or_testing_performed_in_production_environment-false | _],
    member(capacity_procedures_apply_resource_optimisation-unsure, Pairs).
test(one_duty_unsure_is_not_complete, fail) :-
    subject_status(one_duty_unsure, complete, _).

% ---- the PRODUCTION condition (Art 8(2), second subparagraph, third sentence)
test(every_duty_performed_with_production_is_complete) :-
    subject_status(every_duty_performed_with_production, Status, Citations),
    Status == complete,
    fixed_four(Fixed),
    same_citations(Citations, Fixed).
test(production_security_not_ensured_is_incomplete) :-
    subject_status(production_security_not_ensured, Status, Citations),
    Status == incomplete,
    fixed_four(Fixed),
    same_citations(Citations, Fixed).
test(production_security_not_ensured_is_not_complete, fail) :-
    subject_status(production_security_not_ensured, complete, _).
test(without_production_the_security_duty_does_not_apply) :-
    subject_status(no_production_security_not_ensured, Status, _),
    Status == complete.
test(without_production_the_security_duty_is_not_incomplete, fail) :-
    subject_status(no_production_security_not_ensured, incomplete, _).
test(the_trigger_decides_alone_when_the_security_duty_is_false) :-
    subject_status(production_unstated_security_not_ensured, Status, Citations),
    Status == indeterminate([development_or_testing_performed_in_production_environment]),
    Citations == [].
test(the_trigger_unstated_with_security_false_is_not_complete, fail) :-
    subject_status(production_unstated_security_not_ensured, complete, _).
test(the_trigger_is_not_needed_when_the_security_duty_is_true) :-
    subject_status(production_unstated_security_ensured, Status, _),
    Status == complete.
test(the_trigger_unstated_with_security_true_is_not_indeterminate, fail) :-
    subject_status(production_unstated_security_ensured, indeterminate(_), _).

% ---- (A) rts_ict_operations_and_capacity_duties_required/3 ------------
test(required_of_an_article_16_1_entity_is_simplified) :-
    required_of(article_16_1_entity, Result, Citations),
    Result == simplified_framework_entity,
    Citations == [cite(eu_reg_2022_2554_art_16_1)].
test(required_with_the_gate_not_stated_asks_the_gate) :-
    required_of(gate_not_stated, Result, Citations),
    Result == indeterminate([financial_entity_is_article_16_1_entity]),
    Citations == [].
test(required_with_the_trigger_not_stated_asks_the_trigger) :-
    required_of(production_unstated_security_ensured, Result, Citations),
    Result == indeterminate([development_or_testing_performed_in_production_environment]),
    Citations == [].
test(required_without_production_lists_twenty_four_duties) :-
    required_of(every_duty_performed_without_production, required(Duties), Citations),
    length(Duties, 24),
    Duties = [ict_operations_policies_and_procedures, ict_operations_policies_specify_management_of_ict_assets | _],
    last(Duties, measures_for_long_procurement_or_resource_intensive_systems),
    fixed_four(Fixed),
    same_citations(Citations, Fixed).
test(required_without_production_omits_the_security_duty, fail) :-
    required_of(every_duty_performed_without_production, required(Duties), _),
    member(security_during_production_testing, Duties).
test(required_with_production_lists_the_security_duty_in_duty_order) :-
    required_of(every_duty_performed_with_production, required(Duties), Citations),
    length(Duties, 25),
    nth1(17, Duties, production_testing_instances_identified_and_approved),
    nth1(18, Duties, security_during_production_testing),
    nth1(19, Duties, capacity_and_performance_management_procedures),
    fixed_four(Fixed),
    same_citations(Citations, Fixed).
test(required_reads_no_judgement) :-
    required_of(one_duty_unsure, required(Duties), _),
    length(Duties, 24).
test(required_with_input_problems_refuses) :-
    required_of(unknown_key_given, Result, Citations),
    Result == input_problems([unknown_key(office_colour)]),
    Citations == [].

% ---- (B) rts_ict_operations_and_capacity_duties_complete/3 ------------
test(complete_query_complete) :-
    complete_of(every_duty_performed_with_production, Result, Citations),
    Result == complete,
    fixed_four(Fixed),
    same_citations(Citations, Fixed).
test(complete_query_incomplete) :-
    complete_of(one_duty_not_performed, Result, Citations),
    Result == incomplete,
    fixed_four(Fixed),
    same_citations(Citations, Fixed).
test(complete_query_incomplete_is_not_complete, fail) :-
    complete_of(one_duty_not_performed, complete, _).
test(complete_query_simplified) :-
    complete_of(article_16_1_entity, Result, Citations),
    Result == simplified_framework_entity,
    Citations == [cite(eu_reg_2022_2554_art_16_1)].
test(complete_query_indeterminate) :-
    complete_of(one_duty_unstated, Result, Citations),
    Result == indeterminate([capacity_procedures_apply_resource_optimisation]),
    Citations == [].
test(complete_query_referral) :-
    complete_of(one_duty_unsure, needs_legal_review(Reason, _), Citations),
    Reason == open_textured(capacity_procedures_apply_resource_optimisation, cite(eu_reg_2024_1774_art_9_1_b)),
    Citations == [].
test(complete_query_input_problems) :-
    complete_of(gate_given_unsure, Result, Citations),
    Result == input_problems([wrong_type(financial_entity_is_article_16_1_entity)]),
    Citations == [].

% ---- (C) rts_ict_operations_and_capacity_duties_outstanding/3 ---------
test(outstanding_query_none_outstanding) :-
    outstanding_of(every_duty_performed_without_production, Result, Citations),
    Result == none_outstanding,
    fixed_four(Fixed),
    same_citations(Citations, Fixed).
test(outstanding_query_lists_the_failing_duty_with_its_own_key) :-
    outstanding_of(one_duty_not_performed, Result, Citations),
    Result == outstanding([backup_and_restore_requirements]),
    Citations == [cite(eu_reg_2024_1774_art_8_2_b_i)].
test(outstanding_query_with_a_failing_duty_is_not_none_outstanding, fail) :-
    outstanding_of(one_duty_not_performed, none_outstanding, _).
test(outstanding_query_lists_the_security_duty_under_production) :-
    outstanding_of(production_security_not_ensured, Result, Citations),
    Result == outstanding([security_during_production_testing]),
    Citations == [cite(eu_reg_2024_1774_art_8_2)].
test(outstanding_query_excludes_the_security_duty_without_production) :-
    outstanding_of(no_production_security_not_ensured, Result, _),
    Result == none_outstanding.
test(outstanding_query_a_false_key_does_not_end_it) :-
    outstanding_of(failing_duty_with_others_unstated, Result, Citations),
    Result == indeterminate([development_or_testing_performed_in_production_environment]),
    Citations == [].
test(outstanding_query_asks_the_trigger) :-
    outstanding_of(production_unstated_security_not_ensured, Result, Citations),
    Result == indeterminate([development_or_testing_performed_in_production_environment]),
    Citations == [].
% (b) THE TEST IS WRONG: per (M2) the rule correctly refers the unsure key; the
% assertion now reads the reason from the Result instead of a rigid head pattern.
test(outstanding_query_referral) :-
    outstanding_of(one_duty_unsure, Result, Citations),
    Result = needs_legal_review(Reason, _),
    Reason == open_textured(capacity_procedures_apply_resource_optimisation, cite(eu_reg_2024_1774_art_9_1_b)),
    Citations == [].
test(outstanding_query_simplified) :-
    outstanding_of(article_16_1_entity, Result, Citations),
    Result == simplified_framework_entity,
    Citations == [cite(eu_reg_2022_2554_art_16_1)].
test(outstanding_query_gate_not_stated) :-
    outstanding_of(gate_not_stated, Result, Citations),
    Result == indeterminate([financial_entity_is_article_16_1_entity]),
    Citations == [].
test(outstanding_query_input_problems) :-
    outstanding_of(repeated_gate, Result, Citations),
    Result == input_problems([duplicate_key(financial_entity_is_article_16_1_entity)]),
    Citations == [].

% ---- the referral CONTEXT: provenance(CLAUSE, CITATIONS) is optional ----
test(the_referral_context_is_the_inputs_relied_on_item) :-
    complete_of(one_duty_unsure, needs_legal_review(_, Context), _),
    Context = [inputs_relied_on(_)].
test(the_referral_context_carries_no_provenance_item, fail) :-
    complete_of(one_duty_unsure, needs_legal_review(_, Context), _),
    member(provenance(_, _), Context).

% ---- the input check ---------------------------------------------------
test(a_repeated_gate_is_a_duplicate_key) :-
    subject_status(repeated_gate, Status, Citations),
    Status == input_problems([duplicate_key(financial_entity_is_article_16_1_entity)]),
    Citations == [].
test(a_repeated_gate_is_not_complete, fail) :-
    subject_status(repeated_gate, complete, _).
test(an_unsure_gate_is_a_wrong_type) :-
    subject_status(gate_given_unsure, Status, Citations),
    Status == input_problems([wrong_type(financial_entity_is_article_16_1_entity)]),
    Citations == [].
test(an_unsure_gate_is_not_simplified, fail) :-
    subject_status(gate_given_unsure, simplified_framework_entity, _).
test(an_unknown_key_is_named) :-
    subject_status(unknown_key_given, Status, Citations),
    Status == input_problems([unknown_key(office_colour)]),
    Citations == [].
test(an_unknown_key_is_not_complete, fail) :-
    subject_status(unknown_key_given, complete, _).
test(a_profile_with_input_problems_has_no_checklist, fail) :-
    has_checklist(unknown_key_given).

% ---- facade projection, resolvability and status values ---------------
test(the_status_projection_matches_the_verdict) :-
    dora_rts_ict_operations_and_capacity_profile_for(production_security_not_ensured, Profile),
    dora_rts_ict_operations_and_capacity_status(Profile, Status),
    Status == incomplete,
    dora_rts_ict_operations_and_capacity_decision_resolvable(Profile).
test(the_facade_verdict_is_the_complete_query) :-
    dora_rts_ict_operations_and_capacity_profile_for(one_duty_not_performed, Profile),
    decide_dora_rts_ict_operations_and_capacity(Profile, dora_rts_ict_operations_and_capacity_verdict(Status, Citations)),
    rts_ict_operations_and_capacity_duties_complete(Profile, Status, Citations).
test(final_subjects_give_a_declared_status_value) :-
    maplist(is_final, [article_16_1_entity, every_duty_performed_without_production, one_duty_not_performed, every_duty_performed_with_production, production_security_not_ensured, no_production_security_not_ensured, production_unstated_security_ensured, failing_duty_with_others_unstated]).
test(a_status_compound_is_not_a_final_status_value, fail) :-
    is_final(one_duty_unstated).

% ---- justification: the checklist -------------------------------------
test(valid_subjects_have_a_non_empty_checklist) :-
    maplist(has_checklist, [article_16_1_entity, every_duty_performed_without_production, gate_not_stated, one_duty_not_performed, every_duty_performed_with_production, production_security_not_ensured, no_production_security_not_ensured, production_unstated_security_not_ensured, production_unstated_security_ensured, one_duty_unstated, one_duty_unsure, failing_duty_with_others_unstated]).
test(the_checklist_has_the_gate_row_and_a_row_per_duty) :-
    dora_rts_ict_operations_and_capacity_profile_for(every_duty_performed_without_production, Profile),
    dora_rts_ict_operations_and_capacity_checklist(Profile, [item(article_16_1_entity, unmet(not_article_16_1_entity), cite(eu_reg_2022_2554_art_16_1)) | Items]),
    length(Items, 25),
    member(item(security_during_production_testing, inapplicable, cite(eu_reg_2024_1774_art_8_2)), Items),
    member(item(backup_and_restore_requirements, met, cite(eu_reg_2024_1774_art_8_2_b_i)), Items).
test(the_checklist_marks_the_failing_duty) :-
    dora_rts_ict_operations_and_capacity_profile_for(one_duty_not_performed, Profile),
    dora_rts_ict_operations_and_capacity_checklist(Profile, [_GateItem | Items]),
    member(item(backup_and_restore_requirements, unmet(not_performed), cite(eu_reg_2024_1774_art_8_2_b_i)), Items).
test(the_checklist_of_a_performed_duty_is_not_unmet, fail) :-
    dora_rts_ict_operations_and_capacity_profile_for(every_duty_performed_without_production, Profile),
    dora_rts_ict_operations_and_capacity_checklist(Profile, [_GateItem | Items]),
    member(item(backup_and_restore_requirements, unmet(_), _), Items).
test(the_checklist_of_an_article_16_1_entity_is_the_gate_row) :-
    dora_rts_ict_operations_and_capacity_profile_for(article_16_1_entity, Profile),
    dora_rts_ict_operations_and_capacity_checklist(Profile, Items),
    Items == [item(article_16_1_entity, met, cite(eu_reg_2022_2554_art_16_1))].

:- end_module(test_public_interface).
