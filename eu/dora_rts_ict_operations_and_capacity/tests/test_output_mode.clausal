% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_output_mode.clausal -- OUTPUT MODE: results READ OUT of the three
% contract queries, the facade verdict and the checklist; each call yields
% exactly one solution, and lists of duties come in DUTY ORDER.
% Run: python -m clausal.testing eu/dora_rts_ict_operations_and_capacity/tests/test_output_mode.clausal
% =====================================================================
:- module(test_output_mode, []).
:- use_module(eu/dora_rts_ict_operations_and_capacity/dora_rts_ict_operations_and_capacity, [
    rts_ict_operations_and_capacity_duties_required/3,
    rts_ict_operations_and_capacity_duties_complete/3,
    rts_ict_operations_and_capacity_duties_outstanding/3,
    decide_dora_rts_ict_operations_and_capacity/2,
    dora_rts_ict_operations_and_capacity_status/2,
    dora_rts_ict_operations_and_capacity_checklist/2
]).
:- use_module(eu/dora_rts_ict_operations_and_capacity/fixtures, [dora_rts_ict_operations_and_capacity_profile_for/2]).

fixed_citations([
    cite(eu_reg_2024_1774_art_8_1),
    cite(eu_reg_2024_1774_art_8_2),
    cite(eu_reg_2024_1774_art_9_1),
    cite(eu_reg_2024_1774_art_9_2)
]).

same_citations(Citations, Expected) :-
    msort(Citations, Sorted),
    msort(Expected, Sorted).

duties_in_duty_order([
    ict_operations_policies_and_procedures,
    ict_operations_policies_specify_management_of_ict_assets,
    secure_installation_maintenance_configuration_and_deinstallation,
    management_of_information_assets,
    identification_and_control_of_legacy_ict_systems,
    backup_and_restore_requirements,
    scheduling_requirements,
    audit_trail_and_system_log_protocols,
    audit_and_testing_with_minimal_disruption,
    separation_of_production_environments,
    development_and_testing_in_separated_environments,
    development_and_testing_in_production_environments,
    error_handling_procedures_and_protocols,
    support_and_escalation_contacts,
    restart_rollback_and_recovery_procedures,
    separation_considers_all_environment_components,
    production_testing_instances_identified_and_approved,
    security_during_production_testing,
    capacity_and_performance_management_procedures,
    identification_of_capacity_requirements,
    application_of_resource_optimisation,
    monitoring_of_availability,
    monitoring_of_efficiency,
    prevention_of_capacity_shortages,
    measures_for_long_procurement_or_resource_intensive_systems
]).

replace_value([], _, _, []).
replace_value([attribute(Key, _)|Rest], Key, Value, [attribute(Key, Value)|Changed]) :-
    replace_value(Rest, Key, Value, Changed).
replace_value([attribute(Other, OldValue)|Rest], Key, Value, [attribute(Other, OldValue)|Changed]) :-
    dif(Other, Key),
    replace_value(Rest, Key, Value, Changed).

cited_item(item(_, _, cite(Key))) :-
    atom(Key).

test(the_baseline_profile_yields_exactly_one_status) :-
    dora_rts_ict_operations_and_capacity_profile_for(todo_baseline_subject, Profile),
    findall(Status, dora_rts_ict_operations_and_capacity_status(Profile, Status), Statuses),
    Statuses = [_].

test(the_verdict_carries_a_citation) :-
    dora_rts_ict_operations_and_capacity_profile_for(todo_baseline_subject, Profile),
    decide_dora_rts_ict_operations_and_capacity(Profile, dora_rts_ict_operations_and_capacity_verdict(_Status, [_FirstCitation|_OtherCitations])).

test(required_with_production_lists_every_duty_in_duty_order) :-
    dora_rts_ict_operations_and_capacity_profile_for(every_duty_performed_with_production, Profile),
    findall(Result-Citations, rts_ict_operations_and_capacity_duties_required(Profile, Result, Citations), [required(Duties)-Citations]),
    duties_in_duty_order(Expected),
    Duties == Expected,
    fixed_citations(Fixed),
    same_citations(Citations, Fixed).

test(required_without_production_lists_every_duty_but_the_security_duty) :-
    dora_rts_ict_operations_and_capacity_profile_for(every_duty_performed_without_production, Profile),
    findall(Result-Citations, rts_ict_operations_and_capacity_duties_required(Profile, Result, Citations), [required(Duties)-Citations]),
    duties_in_duty_order(All),
    select(security_during_production_testing, All, Expected),
    Duties == Expected,
    fixed_citations(Fixed),
    same_citations(Citations, Fixed).

test(required_does_not_read_the_judgements) :-
    dora_rts_ict_operations_and_capacity_profile_for(one_duty_unsure, Profile),
    findall(Result, rts_ict_operations_and_capacity_duties_required(Profile, Result, _), [required(Duties)]),
    length(Duties, 24).

test(the_complete_query_reads_out_complete_for_the_baseline) :-
    dora_rts_ict_operations_and_capacity_profile_for(every_duty_performed_without_production, Profile),
    findall(Result-Citations, rts_ict_operations_and_capacity_duties_complete(Profile, Result, Citations), [complete-Citations]),
    fixed_citations(Fixed),
    same_citations(Citations, Fixed).

test(the_complete_query_reads_out_incomplete_for_a_failing_duty) :-
    dora_rts_ict_operations_and_capacity_profile_for(one_duty_not_performed, Profile),
    findall(Result, rts_ict_operations_and_capacity_duties_complete(Profile, Result, _), [incomplete]).

test(outstanding_reads_out_one_duty) :-
    dora_rts_ict_operations_and_capacity_profile_for(one_duty_not_performed, Profile),
    findall(Result-Citations, rts_ict_operations_and_capacity_duties_outstanding(Profile, Result, Citations), [outstanding(Duties)-Citations]),
    Duties == [backup_and_restore_requirements],
    Citations == [cite(eu_reg_2024_1774_art_8_2_b_i)].

test(outstanding_reads_out_two_duties_in_duty_order) :-
    dora_rts_ict_operations_and_capacity_profile_for(every_duty_performed_with_production, Start),
    replace_value(Start, security_of_ict_systems_and_production_data_ensured_during_production_testing, false, WithSecurity),
    replace_value(WithSecurity, ict_operations_policies_cover_error_handling_procedures_and_protocols, false, Profile),
    findall(Result-Citations, rts_ict_operations_and_capacity_duties_outstanding(Profile, Result, Citations), [outstanding(Duties)-Citations]),
    Duties == [error_handling_procedures_and_protocols, security_during_production_testing],
    same_citations(Citations, [cite(eu_reg_2024_1774_art_8_2), cite(eu_reg_2024_1774_art_8_2_c_i)]).

test(outstanding_reads_out_none_for_the_baseline) :-
    dora_rts_ict_operations_and_capacity_profile_for(every_duty_performed_without_production, Profile),
    findall(Result-Citations, rts_ict_operations_and_capacity_duties_outstanding(Profile, Result, Citations), [none_outstanding-Citations]),
    fixed_citations(Fixed),
    same_citations(Citations, Fixed).

test(the_outstanding_query_asks_the_trigger_before_the_duty_under_it) :-
    dora_rts_ict_operations_and_capacity_profile_for(production_unstated_security_not_ensured, Profile),
    findall(Result-Citations, rts_ict_operations_and_capacity_duties_outstanding(Profile, Result, Citations), [indeterminate([development_or_testing_performed_in_production_environment])-[]]).

test(the_outstanding_query_does_not_stop_at_a_false_key) :-
    dora_rts_ict_operations_and_capacity_profile_for(failing_duty_with_others_unstated, Profile),
    findall(Result, rts_ict_operations_and_capacity_duties_outstanding(Profile, Result, _), [indeterminate([development_or_testing_performed_in_production_environment])]).

test(the_referral_relies_on_every_present_pair_in_key_order) :-
    dora_rts_ict_operations_and_capacity_profile_for(one_duty_unsure, Profile),
    findall(Result-Citations, rts_ict_operations_and_capacity_duties_complete(Profile, Result, Citations), [needs_legal_review(open_textured(Key, Citation), [inputs_relied_on(Pairs)])-[]]),
    Key == capacity_procedures_apply_resource_optimisation,
    Citation == cite(eu_reg_2024_1774_art_9_1_b),
    length(Pairs, 27),
    Pairs = [financial_entity_is_article_16_1_entity-false, development_or_testing_performed_in_production_environment-false|_],
    nth1(23, Pairs, capacity_procedures_apply_resource_optimisation-unsure).

test(the_checklist_cites_every_item) :-
    dora_rts_ict_operations_and_capacity_profile_for(every_duty_performed_without_production, Profile),
    findall(Items, dora_rts_ict_operations_and_capacity_checklist(Profile, Items), [Items]),
    length(Items, 26),
    maplist(cited_item, Items).

test(the_checklist_of_an_article_16_1_entity_has_one_row) :-
    dora_rts_ict_operations_and_capacity_profile_for(article_16_1_entity, Profile),
    findall(Items, dora_rts_ict_operations_and_capacity_checklist(Profile, Items), [[item(article_16_1_entity, met, cite(eu_reg_2022_2554_art_16_1))]]).

test(the_checklist_marks_a_failing_duty_unmet) :-
    dora_rts_ict_operations_and_capacity_profile_for(one_duty_not_performed, Profile),
    dora_rts_ict_operations_and_capacity_checklist(Profile, Items),
    member(item(backup_and_restore_requirements, unmet(not_performed), cite(eu_reg_2024_1774_art_8_2_b_i)), Items).

:- end_module(test_output_mode).
