% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% kernel.clausal -- the SHARED FLOOR for eu/dora_rts_ict_operations_and_capacity (deontic family).
% DAG root of the determination-slices layout. It holds ONLY the
% PREDICATES that two or more files CALL. This order has ONE determination
% slice (dora_rts_ict_operations_and_capacity.clausal), so the only shared
% predicate is the order's input check, which the scaffold writes here from
% the typed input contract and which the slice and queries.clausal import:
%   :- use_module(eu/dora_rts_ict_operations_and_capacity/kernel,
%                 [dora_rts_ict_operations_and_capacity_input_problems/2]).
% deontic family: each duty of RTS Articles 8 and 9 is an obligation; the
% rule of DORA Article 16(1), first subparagraph, defeats every one of them.
%
% Source: Commission Delegated Regulation (EU) 2024/1774 (RTS on the ICT
% risk management framework) Articles 8(1), 8(2), 9(1) and 9(2), and
% Regulation (EU) 2022/2554 (DORA) Article 16(1), first subparagraph
% (pinned texts 32024R1774 and 32022R2554, original OJ texts). The input
% check below rests on the order's typed input contract, not on a provision.
%
% Atoms and data terms need NO declaration and NO import. Nothing
% vocabulary-shaped lives here; this block only RECORDS the result terms so
% every file spells them alike.
%
% Result terms of the three contract queries (Query(Profile, Result, Citations)):
%   required(Duties)            final; Duties a non-empty list of duty atoms in
%                               DUTY ORDER (rts_ict_operations_and_capacity_duties_required)
%   complete | incomplete       final atoms (rts_ict_operations_and_capacity_duties_complete)
%   none_outstanding            final atom (rts_ict_operations_and_capacity_duties_outstanding)
%   outstanding(Duties)         final; Duties the failing duties in DUTY ORDER
%   simplified_framework_entity final atom of every query when the gate
%                               financial_entity_is_article_16_1_entity is true;
%                               Citations [cite(eu_reg_2022_2554_art_16_1)]
%   indeterminate([Key])        status; exactly one bare key atom (the bare atom
%                               indeterminate is NEVER written)
%   needs_legal_review(open_textured(Key, cite(CitationKey)),
%                      [inputs_relied_on(Pairs)])
%                               status; Pairs the Key-Value pairs present in the
%                               profile, in root_exports order
%   input_problems(Problems)    status; Problems as this check gives them
% Every status compound carries Citations []. Final answers carry cite(Key)
% lists as THE LIMBS fix them.
% Facade verdict term of the slice:
%   dora_rts_ict_operations_and_capacity_verdict(Status, Citations)
%   Status the complete-query Result, Citations its list of cite(Key) terms.
% =====================================================================

:- module(kernel, [dora_rts_ict_operations_and_capacity_input_problems/2]).

:- use_module(library(reif), [memberd_t/3]).

% ---- input checks: the problems a profile has, if any -----------
% dora_rts_ict_operations_and_capacity_input_problems(Profile, Problems): Problems = [] means the profile can be
% judged. Written from the order's typed input contract
% (input_contract.types.profile: attribute_list).
% Each public query calls this check first: it gives its normal answer only when
% Problems = [], and when Problems is not [] it gives the answer the order states for
% a profile with input problems.
% It gives exactly one answer for every Profile, and the answer is ground except for a
% Key named as given:
% - a Profile that is not an attribute list [attribute(Key, Value), ...] gives [wrong_type(profile)]:
%   an unbound Profile, a partial list, a list holding an unbound item or an item that is
%   not attribute(_, _);
% - a Key that is not an atom (a number, a string, a compound term, an unbound variable)
%   is a key outside the contract: unknown_key(Key), Key as given;
% - otherwise, for each contract key in the contract's key order, duplicate_key(Key) when
%   the key occurs more than once in Profile (whatever its values: none of them is read,
%   so it is never also wrong_type(Key)), else wrong_type(Key) when its one value is
%   outside its type; then unknown_key(Key) for each key outside the contract, in the
%   order of its first occurrence in Profile. Each key is named once. An absent key is
%   not a problem.
% Every step is complementary clauses: exactly one clause holds for each input.
dora_rts_ict_operations_and_capacity_input_problems(Profile, Problems) :-
    attribute_list_t(Profile, IsAttributeList),
    profile_problems(IsAttributeList, Profile, Problems).

profile_problems(false, _, [wrong_type(profile)]).
profile_problems(true, Profile, Problems) :-
    Keys = [financial_entity_is_article_16_1_entity, development_or_testing_performed_in_production_environment, ict_operations_policies_and_procedures_developed_documented_and_implemented, ict_operations_policies_specify_operation_monitoring_control_and_restoration_of_ict_assets, ict_operations_policies_cover_secure_installation_to_deinstallation_of_ict_systems, ict_operations_policies_cover_management_of_information_assets_used_by_ict_assets, ict_operations_policies_cover_identification_and_control_of_legacy_ict_systems, ict_operations_policies_cover_backup_and_restore_requirements, ict_operations_policies_cover_scheduling_requirements_considering_interdependencies, ict_operations_policies_cover_audit_trail_and_system_log_protocols, ict_operations_policies_cover_internal_audit_and_testing_minimising_disruption, ict_operations_policies_cover_separation_of_production_from_non_production_environments, ict_operations_policies_cover_development_and_testing_in_separated_environments, ict_operations_policies_cover_development_and_testing_in_production_environments, ict_operations_policies_cover_error_handling_procedures_and_protocols, ict_operations_policies_cover_support_and_escalation_contacts, ict_operations_policies_cover_restart_rollback_and_recovery_procedures, environment_separation_considers_all_components_of_the_environment, production_testing_instances_identified_reasoned_time_limited_and_approved, security_of_ict_systems_and_production_data_ensured_during_production_testing, capacity_and_performance_management_procedures_developed_documented_and_implemented, capacity_procedures_identify_capacity_requirements_of_ict_systems, capacity_procedures_apply_resource_optimisation, capacity_monitoring_maintains_and_improves_availability_of_data_and_ict_systems, capacity_monitoring_maintains_and_improves_efficiency_of_ict_systems, capacity_monitoring_maintains_and_improves_prevention_of_ict_capacity_shortages, capacity_procedures_ensure_measures_for_long_procurement_or_resource_intensive_systems],
    unknown_keys(Profile, Keys, UnknownKeyProblems),
    key_problems(Keys, Profile, UnknownKeyProblems, Problems).

% The contract: each key and the type of its value.
key_type(financial_entity_is_article_16_1_entity, fact).
key_type(development_or_testing_performed_in_production_environment, fact).
key_type(ict_operations_policies_and_procedures_developed_documented_and_implemented, judgement).
key_type(ict_operations_policies_specify_operation_monitoring_control_and_restoration_of_ict_assets, judgement).
key_type(ict_operations_policies_cover_secure_installation_to_deinstallation_of_ict_systems, judgement).
key_type(ict_operations_policies_cover_management_of_information_assets_used_by_ict_assets, judgement).
key_type(ict_operations_policies_cover_identification_and_control_of_legacy_ict_systems, judgement).
key_type(ict_operations_policies_cover_backup_and_restore_requirements, judgement).
key_type(ict_operations_policies_cover_scheduling_requirements_considering_interdependencies, judgement).
key_type(ict_operations_policies_cover_audit_trail_and_system_log_protocols, judgement).
key_type(ict_operations_policies_cover_internal_audit_and_testing_minimising_disruption, judgement).
key_type(ict_operations_policies_cover_separation_of_production_from_non_production_environments, judgement).
key_type(ict_operations_policies_cover_development_and_testing_in_separated_environments, judgement).
key_type(ict_operations_policies_cover_development_and_testing_in_production_environments, judgement).
key_type(ict_operations_policies_cover_error_handling_procedures_and_protocols, judgement).
key_type(ict_operations_policies_cover_support_and_escalation_contacts, judgement).
key_type(ict_operations_policies_cover_restart_rollback_and_recovery_procedures, judgement).
key_type(environment_separation_considers_all_components_of_the_environment, judgement).
key_type(production_testing_instances_identified_reasoned_time_limited_and_approved, judgement).
key_type(security_of_ict_systems_and_production_data_ensured_during_production_testing, judgement).
key_type(capacity_and_performance_management_procedures_developed_documented_and_implemented, judgement).
key_type(capacity_procedures_identify_capacity_requirements_of_ict_systems, judgement).
key_type(capacity_procedures_apply_resource_optimisation, judgement).
key_type(capacity_monitoring_maintains_and_improves_availability_of_data_and_ict_systems, judgement).
key_type(capacity_monitoring_maintains_and_improves_efficiency_of_ict_systems, judgement).
key_type(capacity_monitoring_maintains_and_improves_prevention_of_ict_capacity_shortages, judgement).
key_type(capacity_procedures_ensure_measures_for_long_procurement_or_resource_intensive_systems, judgement).

% attribute_list_t(Term, T): T is true when Term is a list of attribute(Key, Value)
% items, whatever each Key is; false for anything else, an unbound Term or item included.
attribute_list_t(Term, false) :-
    var(Term).
attribute_list_t(Term, true) :-
    Term == [].
attribute_list_t(Term, T) :-
    nonvar(Term),
    Term = [Element|Elements],
    attribute_t(Element, ElementIsAttribute),
    attribute_list_t(Elements, ElementsAreAttributes),
    truth_and(ElementIsAttribute, ElementsAreAttributes, T).
attribute_list_t(Term, false) :-
    nonvar(Term),
    Term \== [],
    Term \= [_|_].

attribute_t(Element, false) :-
    var(Element).
attribute_t(Element, true) :-
    nonvar(Element),
    Element = attribute(_, _).
attribute_t(Element, false) :-
    nonvar(Element),
    Element \= attribute(_, _).

% Unknown keys, in profile order, each once: Known grows by each key named. A key is
% known when it is identical (==) to one in Known, so an unbound Key is never bound:
% the same variable twice is one unknown key, two different variables are two.
unknown_keys([], _, []).
unknown_keys([attribute(Key, _)|Elements], Known, Problems) :-
    known_t(Key, Known, IsKnown),
    name_unknown_key(IsKnown, Key, Known, Elements, Problems).

known_t(_, [], false).
known_t(Key, [Known|_], true) :-
    Known == Key.
known_t(Key, [Known|Knowns], T) :-
    Known \== Key,
    known_t(Key, Knowns, T).

name_unknown_key(true, _, Known, Elements, Problems) :-
    unknown_keys(Elements, Known, Problems).
name_unknown_key(false, Key, Known, Elements, [unknown_key(Key)|Problems]) :-
    unknown_keys(Elements, [Key|Known], Problems).

% Contract keys, in contract order: duplicate_key(Key) when the key occurs more than once
% (none of its values is read), else wrong_type(Key) when its one value is outside the
% key's type. An absent key has no value to check.
key_problems([], _, Problems, Problems).
key_problems([Key|Keys], Profile, LaterProblems, Problems) :-
    key_type(Key, Type),
    key_occurrences(Profile, Key, Occurrences),
    key_problems(Keys, Profile, LaterProblems, KeyProblems),
    name_key_problem(Occurrences, Key, Type, Profile, KeyProblems, Problems).

% key_occurrences(Elements, Key, Occurrences): none, one or many items give Key.
key_occurrences([], _, none).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey == Key,
    key_occurrences(Elements, Key, RestOccurrences),
    one_more_occurrence(RestOccurrences, Occurrences).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey \== Key,
    key_occurrences(Elements, Key, Occurrences).

one_more_occurrence(none, one).
one_more_occurrence(one, many).
one_more_occurrence(many, many).

name_key_problem(none, _, _, _, Problems, Problems).
name_key_problem(many, Key, _, _, Problems, [duplicate_key(Key)|Problems]).
name_key_problem(one, Key, Type, Profile, KeyProblems, Problems) :-
    values_in_type_t(Profile, Key, Type, InType),
    name_wrong_type(InType, Key, KeyProblems, Problems).

name_wrong_type(true, _, Problems, Problems).
name_wrong_type(false, Key, Problems, [wrong_type(Key)|Problems]).

% values_in_type_t(Elements, Key, Type, T): T is true when every value Elements gives Key is
% in Type (true when Elements gives Key none).
values_in_type_t([], _, _, true).
values_in_type_t([attribute(ElementKey, Value)|Elements], Key, Type, T) :-
    ElementKey == Key,
    value_in_type_t(Type, Value, ValueInType),
    values_in_type_t(Elements, Key, Type, RestInType),
    truth_and(ValueInType, RestInType, T).
values_in_type_t([attribute(ElementKey, _)|Elements], Key, Type, T) :-
    ElementKey \== Key,
    values_in_type_t(Elements, Key, Type, T).

% A value with an unbound part is outside every type; a ground one is checked.
value_in_type_t(Type, Value, T) :-
    term_variables(Value, Variables),
    ground_value_in_type_t(Variables, Type, Value, T).

ground_value_in_type_t([_|_], _, _, false).
ground_value_in_type_t([], Type, Value, T) :-
    in_type_t(Type, Value, T).

% in_type_t(Type, Value, T): one clause per type, for a ground Value.
in_type_t(fact, Value, T) :-
    in_type_t(boolean, Value, T).

in_type_t(judgement, Value, T) :-
    in_type_t(one_of([boolean, enum([unsure])]), Value, T).

in_type_t(boolean, Value, T) :-
    memberd_t(Value, [true, false], T).

in_type_t(enum(Values), Value, T) :-
    memberd_t(Value, Values, T).

in_type_t(one_of(Types), Value, T) :-
    in_some_type_t(Types, Value, T).

truth_and(true, T, T).
truth_and(false, _, false).

% in_some_type_t(Types, Value, T): T is true when Value is in at least one of Types.
in_some_type_t([], _, false).
in_some_type_t([Type|Types], Value, T) :-
    in_type_t(Type, Value, InType),
    in_some_type_t(Types, Value, InAnother),
    truth_or(InType, InAnother, T).

truth_or(true, _, true).
truth_or(false, T, T).

:- end_module(kernel).
