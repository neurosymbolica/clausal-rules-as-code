% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% queries.clausal -- QUERY-COMBINATOR layer for eu/dora_rts_ict_operations_and_capacity.
% A TOP-LAYER consumer: it imports the determination slice's PUBLIC
% predicates it calls, and nothing else.
%
% The declared query types are served as follows.
%   #13 compliance_check: rts_ict_operations_and_capacity_duties_complete/3
%       and the facade verdict decide_dora_rts_ict_operations_and_capacity/2
%       (slice). Is the entity's current state compliant with RTS 2024/1774
%       Articles 8 and 9, as the caller judges each duty?
%   #2 eligibility: the facade verdict and its status projection
%       dora_rts_ict_operations_and_capacity_status/2 (slice).
%   #7 justification: dora_rts_ict_operations_and_capacity_checklist/2
%       (slice). Every item carries its cite(Key).
%   #16 what-if, here: dora_rts_ict_operations_and_capacity_what_if/4.
%       Override one key, then re-evaluate the complete-query status.
%
% The profile is an ATTRIBUTE LIST, not a dict, so the what-if override is
% the local attribute-list plumbing override_attribute/4 (it replaces the
% key's first item, or adds the key when it is absent).
%
% dora_rts_ict_operations_and_capacity_profile_keys/1: the top-level
%   profile key schema, in root_exports / input_contract order.
% dora_rts_ict_operations_and_capacity_input_problems/2: the problems a
%   profile has ([] = none), re-exported from the kernel as the scaffold
%   wrote it.
%
% RESULT ATOMS AND CONSTRUCTORS (root_exports): the result atoms, the
% judgement value unsure, the twenty-seven profile key atoms and the
% twenty-five duty atoms are exported as zero-arity facts so that each is a
% package-root attribute; the result constructors are exported as data,
% with no clauses (their fields are named by the constructors directive
% below). None decides anything statutory.
% =====================================================================

:- module(queries, [
    dora_rts_ict_operations_and_capacity_profile_keys/1,
    dora_rts_ict_operations_and_capacity_input_problems/2,
    dora_rts_ict_operations_and_capacity_what_if/4,
    complete/0,
    incomplete/0,
    none_outstanding/0,
    simplified_framework_entity/0,
    unsure/0,
    required/1,
    outstanding/1,
    indeterminate/1,
    needs_legal_review/2,
    open_textured/2,
    inputs_relied_on/1,
    provenance/2,
    input_problems/1,
    unknown_key/1,
    wrong_type/1,
    duplicate_key/1,
    financial_entity_is_article_16_1_entity/0,
    development_or_testing_performed_in_production_environment/0,
    ict_operations_policies_and_procedures_developed_documented_and_implemented/0,
    ict_operations_policies_specify_operation_monitoring_control_and_restoration_of_ict_assets/0,
    ict_operations_policies_cover_secure_installation_to_deinstallation_of_ict_systems/0,
    ict_operations_policies_cover_management_of_information_assets_used_by_ict_assets/0,
    ict_operations_policies_cover_identification_and_control_of_legacy_ict_systems/0,
    ict_operations_policies_cover_backup_and_restore_requirements/0,
    ict_operations_policies_cover_scheduling_requirements_considering_interdependencies/0,
    ict_operations_policies_cover_audit_trail_and_system_log_protocols/0,
    ict_operations_policies_cover_internal_audit_and_testing_minimising_disruption/0,
    ict_operations_policies_cover_separation_of_production_from_non_production_environments/0,
    ict_operations_policies_cover_development_and_testing_in_separated_environments/0,
    ict_operations_policies_cover_development_and_testing_in_production_environments/0,
    ict_operations_policies_cover_error_handling_procedures_and_protocols/0,
    ict_operations_policies_cover_support_and_escalation_contacts/0,
    ict_operations_policies_cover_restart_rollback_and_recovery_procedures/0,
    environment_separation_considers_all_components_of_the_environment/0,
    production_testing_instances_identified_reasoned_time_limited_and_approved/0,
    security_of_ict_systems_and_production_data_ensured_during_production_testing/0,
    capacity_and_performance_management_procedures_developed_documented_and_implemented/0,
    capacity_procedures_identify_capacity_requirements_of_ict_systems/0,
    capacity_procedures_apply_resource_optimisation/0,
    capacity_monitoring_maintains_and_improves_availability_of_data_and_ict_systems/0,
    capacity_monitoring_maintains_and_improves_efficiency_of_ict_systems/0,
    capacity_monitoring_maintains_and_improves_prevention_of_ict_capacity_shortages/0,
    capacity_procedures_ensure_measures_for_long_procurement_or_resource_intensive_systems/0,
    ict_operations_policies_and_procedures/0,
    ict_operations_policies_specify_management_of_ict_assets/0,
    secure_installation_maintenance_configuration_and_deinstallation/0,
    management_of_information_assets/0,
    identification_and_control_of_legacy_ict_systems/0,
    backup_and_restore_requirements/0,
    scheduling_requirements/0,
    audit_trail_and_system_log_protocols/0,
    audit_and_testing_with_minimal_disruption/0,
    separation_of_production_environments/0,
    development_and_testing_in_separated_environments/0,
    development_and_testing_in_production_environments/0,
    error_handling_procedures_and_protocols/0,
    support_and_escalation_contacts/0,
    restart_rollback_and_recovery_procedures/0,
    separation_considers_all_environment_components/0,
    production_testing_instances_identified_and_approved/0,
    security_during_production_testing/0,
    capacity_and_performance_management_procedures/0,
    identification_of_capacity_requirements/0,
    application_of_resource_optimisation/0,
    monitoring_of_availability/0,
    monitoring_of_efficiency/0,
    prevention_of_capacity_shortages/0,
    measures_for_long_procurement_or_resource_intensive_systems/0
]).

:- use_module(eu/dora_rts_ict_operations_and_capacity/kernel, [dora_rts_ict_operations_and_capacity_input_problems/2]).
:- use_module(eu/dora_rts_ict_operations_and_capacity/dora_rts_ict_operations_and_capacity, [dora_rts_ict_operations_and_capacity_status/2]).

% ---- result constructors (exported as data, no clauses) --------------
:- constructors([
    required(duties),
    outstanding(duties),
    indeterminate(missing_keys),
    needs_legal_review(reason, context),
    open_textured(key, citation),
    inputs_relied_on(pairs),
    provenance(clause, citations),
    input_problems(problems),
    unknown_key(key),
    wrong_type(key),
    duplicate_key(key)
]).

% The schema of top-level profile keys: the keys of the order's typed input
% contract, in its order (the gate, the trigger, then the twenty-five duty keys).
dora_rts_ict_operations_and_capacity_profile_keys([financial_entity_is_article_16_1_entity, development_or_testing_performed_in_production_environment, ict_operations_policies_and_procedures_developed_documented_and_implemented, ict_operations_policies_specify_operation_monitoring_control_and_restoration_of_ict_assets, ict_operations_policies_cover_secure_installation_to_deinstallation_of_ict_systems, ict_operations_policies_cover_management_of_information_assets_used_by_ict_assets, ict_operations_policies_cover_identification_and_control_of_legacy_ict_systems, ict_operations_policies_cover_backup_and_restore_requirements, ict_operations_policies_cover_scheduling_requirements_considering_interdependencies, ict_operations_policies_cover_audit_trail_and_system_log_protocols, ict_operations_policies_cover_internal_audit_and_testing_minimising_disruption, ict_operations_policies_cover_separation_of_production_from_non_production_environments, ict_operations_policies_cover_development_and_testing_in_separated_environments, ict_operations_policies_cover_development_and_testing_in_production_environments, ict_operations_policies_cover_error_handling_procedures_and_protocols, ict_operations_policies_cover_support_and_escalation_contacts, ict_operations_policies_cover_restart_rollback_and_recovery_procedures, environment_separation_considers_all_components_of_the_environment, production_testing_instances_identified_reasoned_time_limited_and_approved, security_of_ict_systems_and_production_data_ensured_during_production_testing, capacity_and_performance_management_procedures_developed_documented_and_implemented, capacity_procedures_identify_capacity_requirements_of_ict_systems, capacity_procedures_apply_resource_optimisation, capacity_monitoring_maintains_and_improves_availability_of_data_and_ict_systems, capacity_monitoring_maintains_and_improves_efficiency_of_ict_systems, capacity_monitoring_maintains_and_improves_prevention_of_ict_capacity_shortages, capacity_procedures_ensure_measures_for_long_procurement_or_resource_intensive_systems]).

% #16 what-if: re-evaluate the complete-query status with one key
% hypothetically overridden (replaced, or added when absent).
dora_rts_ict_operations_and_capacity_what_if(Profile, OverriddenKey, NewValue, NewStatus) :-
    override_attribute(Profile, OverriddenKey, NewValue, Hypothesis),
    dora_rts_ict_operations_and_capacity_status(Hypothesis, NewStatus).

% ---- attribute-list plumbing (no statutory content) ------------------
override_attribute([], Key, Value, [attribute(Key, Value)]).
override_attribute([attribute(Key, _)|Rest], Key, Value, [attribute(Key, Value)|Rest]).
override_attribute([attribute(Other, OldValue)|Rest], Key, Value, [attribute(Other, OldValue)|Changed]) :-
    dif(Other, Key),
    override_attribute(Rest, Key, Value, Changed).

