    verbatim-'a description of the reason for the review of the ICT risk management framework in accordance with Article 6(5) of Regulation (EU) 2022/2554'
]).

citation(eu_reg_2024_1774_art_27_2_d, [
    label-'Commission Delegated Regulation (EU) 2024/1774 Art 27(2)(d) (start and end dates of the review period)',
