citation(eu_reg_2024_1774_art_27_2_f, [
    label-'Commission Delegated Regulation (EU) 2024/1774 Art 27(2)(f) (major changes and improvements since the previous review)',
    ref-'32024R1774#point_027.002_f',
    verbatim-'a description of the major changes and improvements to the ICT risk management framework since the previous review'
