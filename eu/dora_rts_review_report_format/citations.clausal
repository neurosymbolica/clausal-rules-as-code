citation(eu_reg_2024_1774_art_27_2_g, [
    label-'Commission Delegated Regulation (EU) 2024/1774 Art 27(2)(g) (findings and severity of weaknesses, deficiencies and gaps)',
    ref-'32024R1774#point_027.002_g',
    verbatim-'a summary of the findings of the review and detailed analysis and assessment of the severity of the weaknesses, deficiencies, and gaps in the ICT risk management framework during the review period'
