% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/dora_rts_review_report_format.
%
% Instruments (pinned texts, original OJ text as published; pin folder
% eu/dora_rts_review_report_format/sources/):
%   - Commission Delegated Regulation (EU) 2024/1774 (CELEX 32024R1774), the
%     RTS on ICT risk management tools, methods, processes and policies:
%     Article 27, paragraphs 1 and 2 and the points of paragraph 2.
%   - Regulation (EU) 2022/2554 (CELEX 32022R2554), the Digital Operational
%     Resilience Act (DORA): Article 16(1), first subparagraph (the gate) and
%     Article 6(5), third sentence (the request).
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% Every key below is `status: verified` in citations-sources.yaml: each
% verbatim is an exact substring of the pinned unit text named in its ref.
%
% The keys are the canonical lexicon keys of citation_vocabulary. One key
% is recorded beyond that vocabulary, for a provision a rule applies but no
% result ever returns: eu_reg_2022_2554_art_6_5 (DORA Art 6(5), third
% sentence, the ground of the request step; reading (3)). It marks the
% request clauses with implements/1 and is NEVER returned in a CITATIONS list.
%
% PROVENANCE: every operative clause opens its body with implements(Key);
% implements/1 succeeds for every recorded key and fails for any other.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

% ---- Regulation (EU) 2022/2554 (DORA) -------------------------------

citation(eu_reg_2022_2554_art_16_1, [
    label-'Regulation (EU) 2022/2554 (DORA) Art 16(1), first subparagraph (entities to which Articles 5 to 15 do not apply)',
    ref-'32022R2554#parag_016.001',
    verbatim-'Articles 5 to 15 of this Regulation shall not apply to small and non-interconnected investment firms'
]).

citation(eu_reg_2022_2554_art_6_5, [
    label-'Regulation (EU) 2022/2554 (DORA) Art 6(5), third sentence (submission of the report on the review upon the request of the competent authority)',
    ref-'32022R2554#parag_006.005',
    verbatim-'A report on the review of the ICT risk management framework shall be submitted to the competent authority upon its request'
]).

% ---- Commission Delegated Regulation (EU) 2024/1774 (RTS) Art 27 ----

citation(eu_reg_2024_1774_art_27_1, [
    label-'Commission Delegated Regulation (EU) 2024/1774 Art 27(1) (searchable electronic format of the report)',
    ref-'32024R1774#parag_027.001',
    verbatim-'Financial entities shall submit the report on the review of the ICT risk management framework referred to in Article 6(5) of Regulation (EU) 2022/2554 in a searchable electronic format'
]).

citation(eu_reg_2024_1774_art_27_2, [
    label-'Commission Delegated Regulation (EU) 2024/1774 Art 27(2), lead words and second subparagraph (all of the following information; the sentences for points (c) and (f))',
    ref-'32024R1774#parag_027.002',
    verbatim-'Financial entities shall include all of the following information in the report referred to in paragraph 1'
]).

citation(eu_reg_2024_1774_art_27_2_a_i, [
    label-'Commission Delegated Regulation (EU) 2024/1774 Art 27(2)(a)(i) (identification of the entity and its group structure)',
    ref-'32024R1774#point_027.002_a_i',
    verbatim-'clearly identifies the financial entity that is the subject of the report, and describes its group structure, where relevant'
]).

citation(eu_reg_2024_1774_art_27_2_a_ii, [
    label-'Commission Delegated Regulation (EU) 2024/1774 Art 27(2)(a)(ii) (context of the report)',
    ref-'32024R1774#point_027.002_a_ii',
    verbatim-'describes the context of the report in terms of the nature, scale, and complexity of the financial entity'
]).

citation(eu_reg_2024_1774_art_27_2_a_iii, [
    label-'Commission Delegated Regulation (EU) 2024/1774 Art 27(2)(a)(iii) (major changes since the previous report submitted)',
    ref-'32024R1774#point_027.002_a_iii',
    verbatim-'summarises the major changes in the ICT risk management framework since the previous report submitted'
]).

citation(eu_reg_2024_1774_art_27_2_a_iv, [
    label-'Commission Delegated Regulation (EU) 2024/1774 Art 27(2)(a)(iv) (executive level summary of the ICT risk profile)',
    ref-'32024R1774#point_027.002_a_iv',
    verbatim-'provides an executive level summary of the current and near-term ICT risk profile, threat landscape, the assessed effectiveness of its controls, and the security posture of the financial entity'
]).

citation(eu_reg_2024_1774_art_27_2_b, [
    label-'Commission Delegated Regulation (EU) 2024/1774 Art 27(2)(b) (date of approval by the management body)',
