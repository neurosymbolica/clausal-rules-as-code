% ---- provenance marker ----------------------------------------------
% implements(Key): succeeds for every recorded key, fails for any other.
implements(Key) :-
    citation(Key, _).

test(the_format_key_is_recorded) :-
    implements(eu_reg_2024_1774_art_27_1).
test(the_gate_key_is_recorded) :-
    implements(eu_reg_2022_2554_art_16_1).
test(the_request_key_is_recorded) :-
    implements(eu_reg_2022_2554_art_6_5).
test(a_shortened_key_is_not_recorded, fail) :-
    implements(art_27_1).

:- end_module(citations).
