    indeterminate/1,
    needs_legal_review/2,
    open_textured/2,
    inputs_relied_on/1,
    provenance/2,
    input_problems/1,
    unknown_key/1,
    wrong_type/1,
    duplicate_key/1,
    financial_entity_is_article_16_1_entity/0,
    authority_requested_framework_review_report/0,
    financial_entity_is_microenterprise/0,
    review_initiated_following_supervisory_instructions_or_testing_or_audit_conclusions/0,
