    past_corrective_measures_proved_ineffective_or_created_unexpected_challenges/0,
    review_report_in_searchable_electronic_format/0,
    review_report_identifies_entity_and_group_structure/0,
    review_report_describes_context/0,
    review_report_summarises_changes_since_previous_report/0,
    review_report_gives_executive_summary/0,
    review_report_states_approval_date/0,
    review_report_describes_reason_for_review/0,
    review_report_references_initiating_instructions_or_conclusions/0,
    review_report_lists_incidents_with_root_cause_analysis/0,
    review_report_states_review_period_dates/0,
    review_report_indicates_responsible_function/0,
    review_report_describes_major_changes_and_improvements/0,
    review_report_analyses_impact_of_changes/0,
    review_report_summarises_findings_and_severity/0,
    review_report_summarises_remediation_measures/0,
    review_report_gives_measure_dates_and_progress/0,
    review_report_gives_measure_tools_and_functions/0,
    review_report_describes_resource_impact/0,
    review_report_informs_on_authority_information_process/0,
    review_report_explains_residual_risk_acceptance/0,
    review_report_informs_on_planned_developments/0,
    review_report_states_conclusions/0,
    review_report_lists_past_reviews/0,
    review_report_states_corrective_measure_implementation/0,
    review_report_describes_corrective_measure_improvements/0,
    review_report_uses_internal_audit_results/0,
    review_report_uses_compliance_assessments/0,
    review_report_uses_resilience_testing_results/0,
    review_report_uses_external_sources/0,
    report_in_searchable_electronic_format/0,
    report_identifies_entity_and_group_structure/0,
    report_describes_context/0,
    report_summarises_changes_since_previous_report/0,
    report_gives_executive_summary/0,
    report_states_approval_date/0,
    report_describes_reason_for_review/0,
    report_references_initiating_instructions_or_conclusions/0,
    report_lists_incidents_with_root_cause_analysis/0,
    report_states_review_period_dates/0,
    report_indicates_responsible_function/0,
    report_describes_major_changes_and_improvements/0,
    report_analyses_impact_of_changes/0,
    report_summarises_findings_and_severity/0,
    report_summarises_remediation_measures/0,
    report_gives_measure_dates_and_progress/0,
    report_gives_measure_tools_and_functions/0,
    report_describes_resource_impact/0,
    report_informs_on_authority_information_process/0,
    report_explains_residual_risk_acceptance/0,
    report_informs_on_planned_developments/0,
    report_states_conclusions/0,
    report_lists_past_reviews/0,
    report_states_corrective_measure_implementation/0,
    report_describes_corrective_measure_improvements/0,
