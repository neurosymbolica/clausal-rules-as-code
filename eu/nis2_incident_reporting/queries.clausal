% SPDX-License-Identifier: EUPL-1.2
:- module(queries, [
    nis2_incident_reporting_profile_keys/1,
    nis2_incident_reporting_input_problems/2,
    nis2_incident_reporting_what_if/4,
    severe_operational_disruption_or_financial_loss/0,
    considerable_damage_to_other_persons/0,
    trust_service_provider_incident_affects_trust_services/0,
    incident_ongoing_at_final_report_due/0,
    early_warning_without_undue_delay/0,
    incident_notification_without_undue_delay/0,
    early_warning/0,
    incident_notification/0,
    unsure/0
]).

:- use_module(eu/nis2_incident_reporting/kernel, [nis2_incident_reporting_input_problems/2]).
:- use_module(eu/nis2_incident_reporting/nis2_incident_reporting, [nis2_incident_reporting_status/2]).

% Root atoms: the six profile keys, the two step atoms and the judgement value unsure.
severe_operational_disruption_or_financial_loss.
considerable_damage_to_other_persons.
trust_service_provider_incident_affects_trust_services.
incident_ongoing_at_final_report_due.
early_warning_without_undue_delay.
incident_notification_without_undue_delay.
early_warning.
incident_notification.
unsure.

% schema of top-level profile keys, in the order of the typed input contract
nis2_incident_reporting_profile_keys([severe_operational_disruption_or_financial_loss, considerable_damage_to_other_persons, trust_service_provider_incident_affects_trust_services, incident_ongoing_at_final_report_due, early_warning_without_undue_delay, incident_notification_without_undue_delay]).

% what-if: re-evaluate the significance status with one key hypothetically overridden.
nis2_incident_reporting_what_if(Profile, OverriddenKey, NewValue, NewStatus) :-
    override_attributes(Profile, OverriddenKey, NewValue, Hypothesis),
    nis2_incident_reporting_status(Hypothesis, NewStatus).

% override_attributes(Attributes, Key, Value, NewAttributes): every attribute for Key is
% dropped and one attribute(Key, Value) is added at the end.
override_attributes([], Key, Value, [attribute(Key, Value)]).
override_attributes([attribute(Key, _)|Rest], Key, Value, NewAttributes) :-
    override_attributes(Rest, Key, Value, NewAttributes).
override_attributes([attribute(OtherKey, OtherValue)|Rest], Key, Value, [attribute(OtherKey, OtherValue)|NewRest]) :-
    dif(OtherKey, Key),
    override_attributes(Rest, Key, Value, NewRest).

:- end_module(queries).
