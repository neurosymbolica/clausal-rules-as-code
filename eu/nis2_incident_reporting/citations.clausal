% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/nis2_incident_reporting.
%
% Instrument: Directive (EU) 2022/2555 of the European Parliament and of the
% Council of 14 December 2022 (NIS 2 Directive), CELEX 32022L2555, original
% OJ text, OJ L 333, 27.12.2022 (raw sha256
% 6ee66d5c419d9a056fb98d94083cacf9b818803bd6b416435718e0d4919cb589).
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% Every record below is `status: verified` in citations-sources.yaml: its
% verbatim is an exact substring of the pinned unit text.
%
% Keys are the corpus lexicon's canonical atoms (_lexicon/citations.yaml).
% lint: C6 allow segment dir -- canonical lexicon citation key, not coined here.
%
% Answer keys (may enter a result as cite(Key)):
%   eu_dir_2022_2555_art_23_3_a, eu_dir_2022_2555_art_23_3_b,
%   eu_dir_2022_2555_art_23_4, eu_dir_2022_2555_art_23_4_a .. _4_e.
% Paragraph markers (implements/1 only; NEVER in an answer):
%   eu_dir_2022_2555_art_23_1, eu_dir_2022_2555_art_23_3.
%
% PROVENANCE: every operative clause opens its body with implements(Key);
% implements/1 succeeds for every recorded key and fails for any other.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

implements(Key) :-
    citation(Key, _).

citation(eu_dir_2022_2555_art_23_1, [label-'Directive (EU) 2022/2555 (NIS 2 Directive) Art 23(1), first subparagraph, duty of essential and important entities to notify significant incidents', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj', verbatim-'Each Member State shall ensure that essential and important entities notify, without undue delay, its CSIRT or, where applicable, its competent authority in accordance with paragraph 4 of any incident that has a significant impact on the provision of their services as referred to in paragraph 3 (significant incident)']).

citation(eu_dir_2022_2555_art_23_3, [label-'Directive (EU) 2022/2555 (NIS 2 Directive) Art 23(3), definition of significant incident (chapeau)', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj', verbatim-'An incident shall be considered to be significant if']).

citation(eu_dir_2022_2555_art_23_3_a, [label-'Directive (EU) 2022/2555 (NIS 2 Directive) Art 23(3)(a), significance limb: severe operational disruption or financial loss for the entity', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj', verbatim-'it has caused or is capable of causing severe operational disruption of the services or financial loss for the entity concerned']).

citation(eu_dir_2022_2555_art_23_3_b, [label-'Directive (EU) 2022/2555 (NIS 2 Directive) Art 23(3)(b), significance limb: considerable material or non-material damage to other persons', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj', verbatim-'it has affected or is capable of affecting other natural or legal persons by causing considerable material or non-material damage']).

citation(eu_dir_2022_2555_art_23_4, [label-'Directive (EU) 2022/2555 (NIS 2 Directive) Art 23(4), second subparagraph, trust service provider derogation from point (b): notification within 24 hours', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj', verbatim-'a trust service provider shall, with regard to significant incidents that have an impact on the provision of its trust services, notify the CSIRT or, where applicable, the competent authority, without undue delay and in any event within 24 hours of becoming aware of the significant incident']).

citation(eu_dir_2022_2555_art_23_4_a, [label-'Directive (EU) 2022/2555 (NIS 2 Directive) Art 23(4)(a), early warning within 24 hours of becoming aware', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj', verbatim-'without undue delay and in any event within 24 hours of becoming aware of the significant incident, an early warning']).

citation(eu_dir_2022_2555_art_23_4_b, [label-'Directive (EU) 2022/2555 (NIS 2 Directive) Art 23(4)(b), incident notification within 72 hours of becoming aware', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj', verbatim-'without undue delay and in any event within 72 hours of becoming aware of the significant incident, an incident notification']).

citation(eu_dir_2022_2555_art_23_4_c, [label-'Directive (EU) 2022/2555 (NIS 2 Directive) Art 23(4)(c), intermediate report upon request of the CSIRT or competent authority', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj', verbatim-'upon the request of a CSIRT or, where applicable, the competent authority, an intermediate report on relevant status updates']).

citation(eu_dir_2022_2555_art_23_4_d, [label-'Directive (EU) 2022/2555 (NIS 2 Directive) Art 23(4)(d), final report not later than one month after the incident notification', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj', verbatim-'a final report not later than one month after the submission of the incident notification under point (b)']).

citation(eu_dir_2022_2555_art_23_4_e, [label-'Directive (EU) 2022/2555 (NIS 2 Directive) Art 23(4)(e), ongoing incident: progress report and final report within one month of handling', ref-'https://eur-lex.europa.eu/eli/dir/2022/2555/oj', verbatim-'in the event of an ongoing incident at the time of the submission of the final report referred to in point (d), Member States shall ensure that entities concerned provide a progress report at that time and a final report within one month of their handling of the incident']).

:- end_module(citations).
