% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/nis2_incident_reporting.
% Source: Directive (EU) 2022/2555 (NIS 2 Directive) Art 23, OJ L 333, 27.12.2022.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order.
% A clause cites a key with a cite(Key) term; cite(...) is data.
%
% PROVENANCE: every operative clause opens its body with implements(Key),
% Key a key recorded here. implements/1 succeeds for every recorded key.
% The paragraph keys eu_dir_2022_2555_art_23_1 and eu_dir_2022_2555_art_23_3
% are implements/1 markers only; they never enter an answer.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

implements(Key) :-
    citation(Key, _).

citation(eu_dir_2022_2555_art_23_1, [label-'Directive (EU) 2022/2555 Art 23(1)', ref-'32022L2555#parag_023.001', verbatim-'essential and important entities notify, without undue delay, its CSIRT or, where applicable, its competent authority']).

citation(eu_dir_2022_2555_art_23_3, [label-'Directive (EU) 2022/2555 Art 23(3)', ref-'32022L2555#parag_023.003', verbatim-'An incident shall be considered to be significant if']).

citation(eu_dir_2022_2555_art_23_3_a, [label-'Directive (EU) 2022/2555 Art 23(3)(a)', ref-'32022L2555#point_023.003_a', verbatim-'it has caused or is capable of causing severe operational disruption of the services or financial loss for the entity concerned']).

citation(eu_dir_2022_2555_art_23_3_b, [label-'Directive (EU) 2022/2555 Art 23(3)(b)', ref-'32022L2555#point_023.003_b', verbatim-'it has affected or is capable of affecting other natural or legal persons by causing considerable material or non-material damage']).

citation(eu_dir_2022_2555_art_23_4, [label-'Directive (EU) 2022/2555 Art 23(4), last sentence (trust service providers)', ref-'32022L2555#parag_023.004', verbatim-'a trust service provider shall, with regard to significant incidents that have an impact on the provision of its trust services, notify the CSIRT or, where applicable, the competent authority, without undue delay and in any event within 24 hours of becoming aware of the significant incident']).

citation(eu_dir_2022_2555_art_23_4_a, [label-'Directive (EU) 2022/2555 Art 23(4)(a)', ref-'32022L2555#point_023.004_a', verbatim-'without undue delay and in any event within 24 hours of becoming aware of the significant incident, an early warning']).

citation(eu_dir_2022_2555_art_23_4_b, [label-'Directive (EU) 2022/2555 Art 23(4)(b)', ref-'32022L2555#point_023.004_b', verbatim-'without undue delay and in any event within 72 hours of becoming aware of the significant incident, an incident notification']).

citation(eu_dir_2022_2555_art_23_4_c, [label-'Directive (EU) 2022/2555 Art 23(4)(c)', ref-'32022L2555#point_023.004_c', verbatim-'upon the request of a CSIRT or, where applicable, the competent authority, an intermediate report on relevant status updates']).

citation(eu_dir_2022_2555_art_23_4_d, [label-'Directive (EU) 2022/2555 Art 23(4)(d)', ref-'32022L2555#point_023.004_d', verbatim-'a final report not later than one month after the submission of the incident notification under point (b)']).

citation(eu_dir_2022_2555_art_23_4_e, [label-'Directive (EU) 2022/2555 Art 23(4)(e)', ref-'32022L2555#point_023.004_e', verbatim-'provide a progress report at that time and a final report within one month of their handling of the incident']).

:- end_module(citations).
