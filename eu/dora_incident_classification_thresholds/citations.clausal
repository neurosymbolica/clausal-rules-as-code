% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/dora_incident_classification_thresholds.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% Every verbatim below is an exact substring of the pinned unit text
% (the original OJ text as published; pin folder
% eu/dora_incident_classification_thresholds/sources/), so every entry
% of citations-sources.yaml is `status: verified`.
%
% Keys are the canonical lexicon keys (_lexicon/citations.yaml), the
% citation_vocabulary of the order. A clause cites a key with a
% `cite(Key)` term; cite(...) is data and needs no import.
%
% PROVENANCE: every operative clause opens its body with implements(Key),
% Key one recorded below:
%   :- use_module(eu/dora_incident_classification_thresholds/citations, [implements/1]).
%
% Instruments:
%   32022R2554 Regulation (EU) 2022/2554 (DORA), OJ L 333, 27.12.2022, p. 1.
%   32024R1772 Commission Delegated Regulation (EU) 2024/1772 (RTS on the
%              classification of ICT-related incidents and cyber threats).
%   32025R0301 Commission Delegated Regulation (EU) 2025/301 (RTS on the
%              content and time limits of major ICT-related incident reports).
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

% ---- Regulation (EU) 2022/2554 (DORA) -------------------------------

% Art 18(1), points (a) to (f): the criteria for classifying ICT-related incidents
% (unit 32022R2554#parag_018.001). Cited in every final answer of the threshold query.
citation(eu_reg_2022_2554_art_18_1, [label-'Regulation (EU) 2022/2554 (DORA) Art 18(1), points (a) to (f), classification criteria of ICT-related incidents', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj', verbatim-'Financial entities shall classify ICT-related incidents and shall determine their impact based on the following criteria']).

% ---- Commission Delegated Regulation (EU) 2024/1772 -----------------

% Art 1(1) to (5): clients, financial counterparts and transactions counted.
citation(eu_reg_2024_1772_art_1, [label-'Commission Delegated Regulation (EU) 2024/1772 Art 1(1) to (5), clients, financial counterparts and transactions', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1772/oj', verbatim-'shall reflect the number of all affected clients, whether natural or legal persons, that are or were unable to make use of the service provided by the financial entity during the incident or that were adversely impacted by the incident']).

% Art 2(1), points (a) to (d), and Art 2(2): reputational impact.
citation(eu_reg_2024_1772_art_2, [label-'Commission Delegated Regulation (EU) 2024/1772 Art 2(1), points (a) to (d), and Art 2(2), reputational impact', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1772/oj', verbatim-'financial entities shall consider that a reputational impact has occurred where at least one of the following criteria is met']).

% Art 3(1) and (2): how duration and service downtime are measured.
citation(eu_reg_2024_1772_art_3, [label-'Commission Delegated Regulation (EU) 2024/1772 Art 3(1) and (2), duration and service downtime', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1772/oj', verbatim-'from the moment the incident occurs until the moment when it is resolved']).

% Art 4, points (a) to (c): geographical spread.
citation(eu_reg_2024_1772_art_4, [label-'Commission Delegated Regulation (EU) 2024/1772 Art 4, points (a) to (c), geographical spread', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1772/oj', verbatim-'financial entities shall assess whether the incident has or had an impact in other Member States']).

% Art 5, points (a) to (d): data losses (availability, authenticity, integrity, confidentiality).
citation(eu_reg_2024_1772_art_5, [label-'Commission Delegated Regulation (EU) 2024/1772 Art 5, points (a) to (d), data losses', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1772/oj', verbatim-'For the purpose of determining the data losses that the incident entails as referred to in Article 18(1), point (d), of Regulation (EU) 2022/2554, financial entities shall take into account the following']).

% Art 6, points (a) to (c): criticality of services affected.
citation(eu_reg_2024_1772_art_6, [label-'Commission Delegated Regulation (EU) 2024/1772 Art 6, points (a) to (c), criticality of services affected', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1772/oj', verbatim-'affects or has affected ICT services or network and information systems that support critical or important functions of the financial entity']).

% Art 7(1) to (4): economic impact, the costs and losses summed.
citation(eu_reg_2024_1772_art_7, [label-'Commission Delegated Regulation (EU) 2024/1772 Art 7(1) to (4), economic impact', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1772/oj', verbatim-'financial entities shall sum up the costs and losses referred to in paragraph 1']).

% Art 8(1), points (a) and (b): major incidents. Quoted as the reason for the
% critical-services condition and for keeping Art 9(5)(b) apart; never applied here.
citation(eu_reg_2024_1772_art_8_1, [label-'Commission Delegated Regulation (EU) 2024/1772 Art 8(1), points (a) and (b), major incidents', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1772/oj', verbatim-'where it has affected critical services as referred to in Article 6 and where either of the following conditions is fulfilled']).

% Art 9(1), points (a) to (f): materiality threshold, clients, financial counterparts and transactions.
citation(eu_reg_2024_1772_art_9_1, [label-'Commission Delegated Regulation (EU) 2024/1772 Art 9(1), points (a) to (f), materiality threshold for clients, financial counterparts and transactions', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1772/oj', verbatim-'clients or financial counterparts which have been identified as relevant in accordance with Article 1(3) have been affected']).

% Art 9(2): materiality threshold, reputational impact.
citation(eu_reg_2024_1772_art_9_2, [label-'Commission Delegated Regulation (EU) 2024/1772 Art 9(2), materiality threshold for reputational impact', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1772/oj', verbatim-'is met where any of the conditions set out in Article 2, points (a) to (d), are fulfilled']).

% Art 9(3), points (a) and (b): materiality threshold, duration and service downtime.
citation(eu_reg_2024_1772_art_9_3, [label-'Commission Delegated Regulation (EU) 2024/1772 Art 9(3), points (a) and (b), materiality threshold for duration and service downtime', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1772/oj', verbatim-'the duration of the incident is longer than 24 hours']).

% Art 9(4): materiality threshold, geographical spread.
citation(eu_reg_2024_1772_art_9_4, [label-'Commission Delegated Regulation (EU) 2024/1772 Art 9(4), materiality threshold for geographical spread', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1772/oj', verbatim-'is met where the incident has an impact in two or more Member States in accordance with Article 4']).

% Art 9(5), point (a): materiality threshold, data losses through an impact on data.
citation(eu_reg_2024_1772_art_9_5_a, [label-'Commission Delegated Regulation (EU) 2024/1772 Art 9(5), point (a), materiality threshold for data losses through an impact on data', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1772/oj', verbatim-'has or will have an adverse impact on the implementation of the business objectives of the financial entity or on its ability to meet regulatory requirements']).

% Art 9(5), point (b): materiality threshold, data losses through a malicious access.
citation(eu_reg_2024_1772_art_9_5_b, [label-'Commission Delegated Regulation (EU) 2024/1772 Art 9(5), point (b), materiality threshold for data losses through a successful, malicious and unauthorised access', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1772/oj', verbatim-'any successful, malicious and unauthorised access not covered by point (a) occurs to network and information systems, where such access may result in data losses']).

% Art 9(6): materiality threshold, economic impact.
citation(eu_reg_2024_1772_art_9_6, [label-'Commission Delegated Regulation (EU) 2024/1772 Art 9(6), materiality threshold for economic impact', ref-'https://eur-lex.europa.eu/eli/reg_del/2024/1772/oj', verbatim-'the costs and losses incurred by the financial entity due to the incident have exceeded or are likely to exceed']).

% ---- Commission Delegated Regulation (EU) 2025/301 ------------------

% Art 5(1), point (c), read with the lead words of Art 5(1) for the final report only.
citation(eu_reg_2025_301_art_5_1_c, [label-'Commission Delegated Regulation (EU) 2025/301 Art 5(1), point (c), time limit of the final report', ref-'https://eur-lex.europa.eu/eli/reg_del/2025/301/oj', verbatim-'for the final report: no later than one month after either the submission of the intermediate report, or, where applicable, after the latest updated intermediate report']).

% Art 5(4): the weekend and bank holiday rule.
citation(eu_reg_2025_301_art_5_4, [label-'Commission Delegated Regulation (EU) 2025/301 Art 5(4), weekend day or bank holiday rule', ref-'https://eur-lex.europa.eu/eli/reg_del/2025/301/oj', verbatim-'the financial entity may submit the initial notification, intermediate or final reports by noon of the next working day']).

% Art 5(5): Art 5(4) switched off for the initial notification and intermediate report of listed entities.
citation(eu_reg_2025_301_art_5_5, [label-'Commission Delegated Regulation (EU) 2025/301 Art 5(5), limit of the weekend rule for initial notifications and intermediate reports', ref-'https://eur-lex.europa.eu/eli/reg_del/2025/301/oj', verbatim-'Paragraph 4 shall not apply for the submission of an initial notification or an intermediate report by credit institutions']).

% Art 5(6): competent authorities may switch Art 5(4) off for the initial notification and intermediate report.
citation(eu_reg_2025_301_art_5_6, [label-'Commission Delegated Regulation (EU) 2025/301 Art 5(6), decision of competent authorities limiting the weekend rule', ref-'https://eur-lex.europa.eu/eli/reg_del/2025/301/oj', verbatim-'Competent authorities may decide that paragraph 4 shall not apply for the submission of an initial notification or an intermediate report']).

% ---- provenance marker ----------------------------------------------
% implements(Key): succeeds for every recorded key, fails for any other.
implements(Key) :-
    citation(Key, _).

:- end_module(citations).
