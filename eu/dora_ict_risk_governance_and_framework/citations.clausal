% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/dora_ict_risk_governance_and_framework.
%
% Source: Regulation (EU) 2022/2554 (the Digital Operational Resilience Act,
% DORA), pinned text of 32022R2554 (the original OJ text as published,
% OJ L 333, 27.12.2022, p. 1; pin folder
% eu/dora_ict_risk_governance_and_framework/sources/).
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order. The
% verbatim pair is OMITTED while the key's entry in citations-sources.yaml
% is `status: unverified`.
%
% Keys use the canonical lexicon scheme of _lexicon/citations.yaml
% (eu_reg_2022_2554_art_...). They are never shortened.
%
% PROVENANCE: every operative clause opens its body with implements(Key),
% Key a key recorded here. implements/1 succeeds for every recorded key and
% fails for any other.
%
% eu_reg_2022_2554_art_3_60 (the definition of microenterprise) is recorded
% as a marker only: the caller states the microenterprise fact, and the key
% is never returned in a result.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

implements(Key) :-
    citation(Key, _).

citation(eu_reg_2022_2554_art_5_1, [label-'Regulation (EU) 2022/2554 (DORA) Art 5(1): internal governance and control framework', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#parag_005.001)', verbatim-'Financial entities shall have in place an internal governance and control framework that ensures an effective and prudent management of ICT risk']).
citation(eu_reg_2022_2554_art_5_2, [label-'Regulation (EU) 2022/2554 (DORA) Art 5(2), first subparagraph: responsibility of the management body for the ICT risk management framework', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#parag_005.002)', verbatim-'The management body of the financial entity shall define, approve, oversee and be responsible for the implementation of all arrangements related to the ICT risk management framework referred to in Article 6(1).']).
citation(eu_reg_2022_2554_art_5_2_a, [label-'Regulation (EU) 2022/2554 (DORA) Art 5(2), second subparagraph, point (a): ultimate responsibility for ICT risk', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#point_005.002_a)', verbatim-'bear the ultimate responsibility for managing the financial entity']).
citation(eu_reg_2022_2554_art_5_2_b, [label-'Regulation (EU) 2022/2554 (DORA) Art 5(2), second subparagraph, point (b): data security policies', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#point_005.002_b)', verbatim-'put in place policies that aim to ensure the maintenance of high standards of availability, authenticity, integrity and confidentiality, of data']).
citation(eu_reg_2022_2554_art_5_2_c, [label-'Regulation (EU) 2022/2554 (DORA) Art 5(2), second subparagraph, point (c): roles, responsibilities and governance arrangements for ICT-related functions', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#point_005.002_c)', verbatim-'set clear roles and responsibilities for all ICT-related functions']).
citation(eu_reg_2022_2554_art_5_2_d, [label-'Regulation (EU) 2022/2554 (DORA) Art 5(2), second subparagraph, point (d): digital operational resilience strategy and risk tolerance level', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#point_005.002_d)', verbatim-'bear the overall responsibility for setting and approving the digital operational resilience strategy']).
citation(eu_reg_2022_2554_art_5_2_e, [label-'Regulation (EU) 2022/2554 (DORA) Art 5(2), second subparagraph, point (e): ICT business continuity policy and response and recovery plans', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#point_005.002_e)', verbatim-'approve, oversee and periodically review the implementation of the financial entity']).
citation(eu_reg_2022_2554_art_5_2_f, [label-'Regulation (EU) 2022/2554 (DORA) Art 5(2), second subparagraph, point (f): ICT internal audit plans and ICT audits', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#point_005.002_f)', verbatim-'ICT internal audit plans, ICT audits and material modifications to them']).
citation(eu_reg_2022_2554_art_5_2_g, [label-'Regulation (EU) 2022/2554 (DORA) Art 5(2), second subparagraph, point (g): budget for digital operational resilience needs', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#point_005.002_g)', verbatim-'allocate and periodically review the appropriate budget to fulfil the financial entity']).
citation(eu_reg_2022_2554_art_5_2_h, [label-'Regulation (EU) 2022/2554 (DORA) Art 5(2), second subparagraph, point (h): policy on the use of ICT services provided by ICT third-party service providers', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#point_005.002_h)', verbatim-'policy on arrangements regarding the use of ICT services provided by ICT third-party service providers']).
citation(eu_reg_2022_2554_art_5_2_i, [label-'Regulation (EU) 2022/2554 (DORA) Art 5(2), second subparagraph, point (i): reporting channels to the management body', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#point_005.002_i)', verbatim-'put in place, at corporate level, reporting channels enabling it to be duly informed of the following']).
citation(eu_reg_2022_2554_art_5_2_i_i, [label-'Regulation (EU) 2022/2554 (DORA) Art 5(2), second subparagraph, point (i)(i): arrangements concluded with ICT third-party service providers', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#point_005.002_i_i)', verbatim-'arrangements concluded with ICT third-party service providers on the use of ICT services']).
citation(eu_reg_2022_2554_art_5_2_i_ii, [label-'Regulation (EU) 2022/2554 (DORA) Art 5(2), second subparagraph, point (i)(ii): planned material changes regarding ICT third-party service providers', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#point_005.002_i_ii)', verbatim-'any relevant planned material changes regarding the ICT third-party service providers']).
citation(eu_reg_2022_2554_art_5_2_i_iii, [label-'Regulation (EU) 2022/2554 (DORA) Art 5(2), second subparagraph, point (i)(iii), with the closing words of point (i): impact of changes on critical or important functions, and major ICT-related incidents', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#point_005.002_i_iii)', verbatim-'the potential impact of such changes on the critical or important functions subject to those arrangements']).
citation(eu_reg_2022_2554_art_5_3, [label-'Regulation (EU) 2022/2554 (DORA) Art 5(3): role monitoring arrangements with ICT third-party service providers (other than microenterprises)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#parag_005.003)', verbatim-'Financial entities, other than microenterprises, shall establish a role in order to monitor the arrangements concluded with ICT third-party service providers on the use of ICT services']).
citation(eu_reg_2022_2554_art_5_4, [label-'Regulation (EU) 2022/2554 (DORA) Art 5(4): knowledge and skills of the members of the management body', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#parag_005.004)', verbatim-'Members of the management body of the financial entity shall actively keep up to date with sufficient knowledge and skills to understand and assess ICT risk']).
citation(eu_reg_2022_2554_art_6_1, [label-'Regulation (EU) 2022/2554 (DORA) Art 6(1): sound, comprehensive and well-documented ICT risk management framework', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#parag_006.001)', verbatim-'Financial entities shall have a sound, comprehensive and well-documented ICT risk management framework as part of their overall risk management system']).
citation(eu_reg_2022_2554_art_6_2, [label-'Regulation (EU) 2022/2554 (DORA) Art 6(2): protection of information assets, ICT assets and physical infrastructure', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#parag_006.002)', verbatim-'The ICT risk management framework shall include at least strategies, policies, procedures, ICT protocols and tools that are necessary to duly and adequately protect all information assets and ICT assets']).
citation(eu_reg_2022_2554_art_6_3, [label-'Regulation (EU) 2022/2554 (DORA) Art 6(3): minimisation of the impact of ICT risk (first sentence) and information to the competent authorities upon request (second sentence)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#parag_006.003)', verbatim-'They shall provide complete and updated information on ICT risk and on their ICT risk management framework to the competent authorities upon their request.']).
citation(eu_reg_2022_2554_art_6_4, [label-'Regulation (EU) 2022/2554 (DORA) Art 6(4): ICT risk control function (first sentence, other than microenterprises) and segregation of functions (second sentence)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#parag_006.004)', verbatim-'Financial entities, other than microenterprises, shall assign the responsibility for managing and overseeing ICT risk to a control function']).
citation(eu_reg_2022_2554_art_6_5, [label-'Regulation (EU) 2022/2554 (DORA) Art 6(5): review of the ICT risk management framework (yearly, or periodically for microenterprises; upon events), continuous improvement and report on the review upon request', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#parag_006.005)', verbatim-'The ICT risk management framework shall be documented and reviewed at least once a year, or periodically in the case of microenterprises']).
citation(eu_reg_2022_2554_art_6_6, [label-'Regulation (EU) 2022/2554 (DORA) Art 6(6): internal audit of the ICT risk management framework (other than microenterprises)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#parag_006.006)', verbatim-'The ICT risk management framework of financial entities, other than microenterprises, shall be subject to internal audit by auditors on a regular basis']).
citation(eu_reg_2022_2554_art_6_7, [label-'Regulation (EU) 2022/2554 (DORA) Art 6(7): formal follow-up process for internal audit findings', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#parag_006.007)', verbatim-'Based on the conclusions from the internal audit review, financial entities shall establish a formal follow-up process']).
citation(eu_reg_2022_2554_art_6_8, [label-'Regulation (EU) 2022/2554 (DORA) Art 6(8): digital operational resilience strategy', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#parag_006.008)', verbatim-'The ICT risk management framework shall include a digital operational resilience strategy setting out how the framework shall be implemented.']).
citation(eu_reg_2022_2554_art_6_8_a, [label-'Regulation (EU) 2022/2554 (DORA) Art 6(8), point (a): support of the business strategy and objectives', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#point_006.008_a)', verbatim-'explaining how the ICT risk management framework supports the financial entity']).
citation(eu_reg_2022_2554_art_6_8_b, [label-'Regulation (EU) 2022/2554 (DORA) Art 6(8), point (b): risk tolerance level for ICT risk and impact tolerance', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#point_006.008_b)', verbatim-'establishing the risk tolerance level for ICT risk, in accordance with the risk appetite of the financial entity']).
citation(eu_reg_2022_2554_art_6_8_c, [label-'Regulation (EU) 2022/2554 (DORA) Art 6(8), point (c): information security objectives', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#point_006.008_c)', verbatim-'setting out clear information security objectives, including key performance indicators and key risk metrics']).
citation(eu_reg_2022_2554_art_6_8_d, [label-'Regulation (EU) 2022/2554 (DORA) Art 6(8), point (d): ICT reference architecture', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#point_006.008_d)', verbatim-'explaining the ICT reference architecture and any changes needed to reach specific business objectives']).
citation(eu_reg_2022_2554_art_6_8_e, [label-'Regulation (EU) 2022/2554 (DORA) Art 6(8), point (e): mechanisms to detect, prevent and protect from ICT-related incidents', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#point_006.008_e)', verbatim-'outlining the different mechanisms put in place to detect ICT-related incidents, prevent their impact and provide protection from it']).
citation(eu_reg_2022_2554_art_6_8_f, [label-'Regulation (EU) 2022/2554 (DORA) Art 6(8), point (f): current digital operational resilience situation', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#point_006.008_f)', verbatim-'evidencing the current digital operational resilience situation on the basis of the number of major ICT-related incidents reported']).
citation(eu_reg_2022_2554_art_6_8_g, [label-'Regulation (EU) 2022/2554 (DORA) Art 6(8), point (g): digital operational resilience testing as an element of the strategy', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#point_006.008_g)', verbatim-'implementing digital operational resilience testing, in accordance with Chapter IV of this Regulation']).
citation(eu_reg_2022_2554_art_6_8_h, [label-'Regulation (EU) 2022/2554 (DORA) Art 6(8), point (h): communication strategy for ICT-related incidents', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#point_006.008_h)', verbatim-'outlining a communication strategy in the event of ICT-related incidents the disclosure of which is required in accordance with Article 14']).
citation(eu_reg_2022_2554_art_7, [label-'Regulation (EU) 2022/2554 (DORA) Art 7: updated ICT systems, protocols and tools, with the qualities of points (a) to (d)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#point_007_a to point_007_d)', verbatim-'appropriate to the magnitude of operations supporting the conduct of their activities']).
citation(eu_reg_2022_2554_art_7_a, [label-'Regulation (EU) 2022/2554 (DORA) Art 7, point (a): appropriate to the magnitude of operations', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#point_007_a)', verbatim-'appropriate to the magnitude of operations supporting the conduct of their activities']).
citation(eu_reg_2022_2554_art_7_b, [label-'Regulation (EU) 2022/2554 (DORA) Art 7, point (b): reliable', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#point_007_b)', verbatim-'reliable']).
citation(eu_reg_2022_2554_art_7_c, [label-'Regulation (EU) 2022/2554 (DORA) Art 7, point (c): sufficient capacity', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#point_007_c)', verbatim-'equipped with sufficient capacity to accurately process the data necessary for the performance of activities']).
citation(eu_reg_2022_2554_art_7_d, [label-'Regulation (EU) 2022/2554 (DORA) Art 7, point (d): technologically resilient', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#point_007_d)', verbatim-'technologically resilient in order to adequately deal with additional information processing needs']).
citation(eu_reg_2022_2554_art_8_1, [label-'Regulation (EU) 2022/2554 (DORA) Art 8(1): identification, classification and documentation of ICT supported business functions and assets', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#parag_008.001)', verbatim-'financial entities shall identify, classify and adequately document all ICT supported business functions, roles and responsibilities']).
citation(eu_reg_2022_2554_art_8_2, [label-'Regulation (EU) 2022/2554 (DORA) Art 8(2): identification of sources of ICT risk and review of risk scenarios', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#parag_008.002)', verbatim-'Financial entities shall, on a continuous basis, identify all sources of ICT risk']).
citation(eu_reg_2022_2554_art_8_3, [label-'Regulation (EU) 2022/2554 (DORA) Art 8(3): risk assessment upon each major change (other than microenterprises)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#parag_008.003)', verbatim-'Financial entities, other than microenterprises, shall perform a risk assessment upon each major change in the network and information system infrastructure']).
citation(eu_reg_2022_2554_art_8_4, [label-'Regulation (EU) 2022/2554 (DORA) Art 8(4): identification and mapping of information assets and ICT assets', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#parag_008.004)', verbatim-'Financial entities shall identify all information assets and ICT assets, including those on remote sites, network resources and hardware equipment, and shall map those considered critical.']).
citation(eu_reg_2022_2554_art_8_5, [label-'Regulation (EU) 2022/2554 (DORA) Art 8(5): processes dependent on ICT third-party service providers', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#parag_008.005)', verbatim-'Financial entities shall identify and document all processes that are dependent on ICT third-party service providers']).
citation(eu_reg_2022_2554_art_8_6, [label-'Regulation (EU) 2022/2554 (DORA) Art 8(6): inventories maintained and updated', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#parag_008.006)', verbatim-'financial entities shall maintain relevant inventories and update them periodically']).
citation(eu_reg_2022_2554_art_8_7, [label-'Regulation (EU) 2022/2554 (DORA) Art 8(7): specific ICT risk assessment on legacy ICT systems (other than microenterprises)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#parag_008.007)', verbatim-'Financial entities, other than microenterprises, shall on a regular basis, and at least yearly, conduct a specific ICT risk assessment on all legacy ICT systems']).
citation(eu_reg_2022_2554_art_16_1, [label-'Regulation (EU) 2022/2554 (DORA) Art 16(1), first subparagraph: Articles 5 to 15 do not apply to the entities listed', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (32022R2554#parag_016.001)', verbatim-'Articles 5 to 15 of this Regulation shall not apply to small and non-interconnected investment firms']).
citation(eu_reg_2022_2554_art_3_60, [label-'Regulation (EU) 2022/2554 (DORA) Art 3, point (60): definition of microenterprise (stated by the caller; marker only, never returned)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2554 (Art 3, point (60); not pinned)']).

test(a_recorded_key_is_implemented) :-
    implements(eu_reg_2022_2554_art_5_1).
test(the_article_16_key_is_implemented) :-
    implements(eu_reg_2022_2554_art_16_1).
test(an_unrecorded_key_is_not_implemented, fail) :-
    implements(eu_reg_2022_2554_art_99).

:- end_module(citations).
