% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% kernel.clausal -- the SHARED FLOOR for eu/dora_ict_risk_governance_and_framework (deontic family).
% DAG root of the determination-slices layout. It holds ONLY the
% PREDICATES that two or more files CALL.
%
% Source: Regulation (EU) 2022/2554 (the Digital Operational Resilience
% Act, DORA), pinned text of 32022R2554 (the original OJ text, OJ L 333,
% 27.12.2022, p. 1): Article 5 (ICT risk governance), Article 6 (ICT risk
% management framework), Article 7 (ICT systems, protocols and tools),
% Article 8 (identification) and Article 16(1), first subparagraph (Articles
% 5 to 15 do not apply to the entities it lists).
%
% This domain has ONE determination slice,
% dora_ict_risk_governance_and_framework.clausal, so no domain predicate is
% shared between slices and none lives here. The one exception is the
% scaffold's input check dora_ict_risk_governance_and_framework_input_problems/2
% (INTERFACE - THE INPUT CHECK of the order), written from the order's typed
% input contract, exported here for the slice and the queries to import:
%   :- use_module(eu/dora_ict_risk_governance_and_framework/kernel,
%                 [dora_ict_risk_governance_and_framework_input_problems/2]).
% deontic family: each duty is an obligation of the entity, switched on by
% crisp conditions (the Article 16(1) status, the microenterprise status and
% four triggers) and judged performed by the caller.
%
% Atoms and data terms need NO declaration and NO import. The block below
% only RECORDS the result terms so every file spells them alike.
%
% Result terms built by the slice (one solution per call):
%   ict_risk_governance_duties_required(Profile, Result, Citations)
%     Result: required(Duties) -- Duties the applying duty atoms in duty order;
%             simplified_framework_entity -- an Article 16(1) entity;
%             indeterminate([Key]) -- exactly one absent key;
%             input_problems(Problems).
%   ict_risk_governance_duties_complete(Profile, Result, Citations)
%     Result: complete | incomplete | simplified_framework_entity;
%             indeterminate([Key]);
%             needs_legal_review(open_textured(Key, cite(CitationKey)),
%                                [inputs_relied_on(Pairs)]) -- Pairs the
%                                Key-Value pairs present, in key order;
%             input_problems(Problems).
%   ict_risk_governance_duties_outstanding(Profile, Result, Citations)
%     Result: none_outstanding | outstanding(Duties) |
%             simplified_framework_entity; or a status compound as above.
%   Citations: a set-like list of cite(CitationKey) terms for a final Result,
%     [] for every status compound (indeterminate/1, needs_legal_review/2,
%     input_problems/1). The bare atom indeterminate is never written.
%   Problems: duplicate_key(Key), wrong_type(Key), unknown_key(Key) terms in
%     input-check order, or [wrong_type(profile)].
%   Facade verdict: dora_ict_risk_governance_and_framework_verdict(Status, Citations),
%     Status the Result of the complete query.
%   Judgement value besides true and false: unsure.
% =====================================================================

:- module(kernel, [dora_ict_risk_governance_and_framework_input_problems/2]).

:- use_module(library(reif), [memberd_t/3]).

% ---- input checks: the problems a profile has, if any -----------
% dora_ict_risk_governance_and_framework_input_problems(Profile, Problems): Problems = [] means the profile can be
% judged. Written from the order's typed input contract
% (input_contract.types.profile: attribute_list).
% Each public query calls this check first: it gives its normal answer only when
% Problems = [], and when Problems is not [] it gives the answer the order states for
% a profile with input problems.
% It gives exactly one answer for every Profile, and the answer is ground except for a
% Key named as given:
% - a Profile that is not an attribute list [attribute(Key, Value), ...] gives [wrong_type(profile)]:
%   an unbound Profile, a partial list, a list holding an unbound item or an item that is
%   not attribute(_, _);
% - a Key that is not an atom (a number, a string, a compound term, an unbound variable)
%   is a key outside the contract: unknown_key(Key), Key as given;
% - otherwise, for each contract key in the contract's key order, duplicate_key(Key) when
%   the key occurs more than once in Profile (whatever its values: none of them is read,
%   so it is never also wrong_type(Key)), else wrong_type(Key) when its one value is
%   outside its type; then unknown_key(Key) for each key outside the contract, in the
%   order of its first occurrence in Profile. Each key is named once. An absent key is
%   not a problem.
% Every step is complementary clauses: exactly one clause holds for each input.
dora_ict_risk_governance_and_framework_input_problems(Profile, Problems) :-
    attribute_list_t(Profile, IsAttributeList),
    profile_problems(IsAttributeList, Profile, Problems).

profile_problems(false, _, [wrong_type(profile)]).
profile_problems(true, Profile, Problems) :-
    Keys = [financial_entity_is_article_16_1_entity, financial_entity_is_microenterprise, authority_requested_ict_risk_information, authority_requested_framework_review_report, major_change_occurred, entity_operates_legacy_ict_systems, has_internal_governance_and_control_framework, management_body_defines_approves_and_oversees_framework, management_body_bears_ultimate_ict_risk_responsibility, management_body_put_in_place_data_security_policies, ict_roles_and_governance_arrangements_set, management_body_approved_strategy_and_risk_tolerance, management_body_oversees_continuity_policy_and_plans, management_body_approves_ict_audit_plans, management_body_allocates_resilience_budget, management_body_approves_third_party_policy, reporting_channels_to_management_body_in_place, third_party_monitoring_role_established, management_body_keeps_ict_knowledge_up_to_date, has_sound_documented_ict_risk_management_framework, framework_protects_information_and_ict_assets, minimises_ict_risk_impact, provided_ict_risk_information_on_request, independent_ict_risk_control_function_assigned, risk_control_and_audit_functions_segregated, framework_reviewed_at_least_yearly, framework_reviewed_periodically, framework_reviewed_upon_events_and_improved, review_report_submitted_on_request, framework_internally_audited, formal_audit_follow_up_process_established, resilience_strategy_in_framework, uses_updated_appropriate_ict_systems, functions_and_assets_identified_and_classified, ict_risk_sources_identified_and_assessed, risk_assessed_upon_major_change, assets_identified_and_mapped, third_party_dependencies_identified, inventories_maintained_and_updated, legacy_systems_risk_assessed],
    unknown_keys(Profile, Keys, UnknownKeyProblems),
    key_problems(Keys, Profile, UnknownKeyProblems, Problems).

% The contract: each key and the type of its value.
key_type(financial_entity_is_article_16_1_entity, fact).
key_type(financial_entity_is_microenterprise, fact).
key_type(authority_requested_ict_risk_information, fact).
key_type(authority_requested_framework_review_report, fact).
key_type(major_change_occurred, fact).
key_type(entity_operates_legacy_ict_systems, fact).
key_type(has_internal_governance_and_control_framework, judgement).
key_type(management_body_defines_approves_and_oversees_framework, judgement).
key_type(management_body_bears_ultimate_ict_risk_responsibility, judgement).
key_type(management_body_put_in_place_data_security_policies, judgement).
key_type(ict_roles_and_governance_arrangements_set, judgement).
key_type(management_body_approved_strategy_and_risk_tolerance, judgement).
key_type(management_body_oversees_continuity_policy_and_plans, judgement).
key_type(management_body_approves_ict_audit_plans, judgement).
key_type(management_body_allocates_resilience_budget, judgement).
key_type(management_body_approves_third_party_policy, judgement).
key_type(reporting_channels_to_management_body_in_place, judgement).
key_type(third_party_monitoring_role_established, judgement).
key_type(management_body_keeps_ict_knowledge_up_to_date, judgement).
key_type(has_sound_documented_ict_risk_management_framework, judgement).
key_type(framework_protects_information_and_ict_assets, judgement).
key_type(minimises_ict_risk_impact, judgement).
key_type(provided_ict_risk_information_on_request, judgement).
key_type(independent_ict_risk_control_function_assigned, judgement).
key_type(risk_control_and_audit_functions_segregated, judgement).
key_type(framework_reviewed_at_least_yearly, fact).
key_type(framework_reviewed_periodically, judgement).
key_type(framework_reviewed_upon_events_and_improved, judgement).
key_type(review_report_submitted_on_request, judgement).
key_type(framework_internally_audited, judgement).
key_type(formal_audit_follow_up_process_established, judgement).
key_type(resilience_strategy_in_framework, judgement).
key_type(uses_updated_appropriate_ict_systems, judgement).
key_type(functions_and_assets_identified_and_classified, judgement).
key_type(ict_risk_sources_identified_and_assessed, judgement).
key_type(risk_assessed_upon_major_change, judgement).
key_type(assets_identified_and_mapped, judgement).
key_type(third_party_dependencies_identified, judgement).
key_type(inventories_maintained_and_updated, judgement).
key_type(legacy_systems_risk_assessed, judgement).

% attribute_list_t(Term, T): T is true when Term is a list of attribute(Key, Value)
% items, whatever each Key is; false for anything else, an unbound Term or item included.
attribute_list_t(Term, false) :-
    var(Term).
attribute_list_t(Term, true) :-
    Term == [].
attribute_list_t(Term, T) :-
    nonvar(Term),
    Term = [Element|Elements],
    attribute_t(Element, ElementIsAttribute),
    attribute_list_t(Elements, ElementsAreAttributes),
    truth_and(ElementIsAttribute, ElementsAreAttributes, T).
attribute_list_t(Term, false) :-
    nonvar(Term),
    Term \== [],
    Term \= [_|_].

attribute_t(Element, false) :-
    var(Element).
attribute_t(Element, true) :-
    nonvar(Element),
    Element = attribute(_, _).
attribute_t(Element, false) :-
    nonvar(Element),
    Element \= attribute(_, _).

% Unknown keys, in profile order, each once: Known grows by each key named. A key is
% known when it is identical (==) to one in Known, so an unbound Key is never bound:
% the same variable twice is one unknown key, two different variables are two.
unknown_keys([], _, []).
unknown_keys([attribute(Key, _)|Elements], Known, Problems) :-
    known_t(Key, Known, IsKnown),
    name_unknown_key(IsKnown, Key, Known, Elements, Problems).

known_t(_, [], false).
known_t(Key, [Known|_], true) :-
    Known == Key.
known_t(Key, [Known|Knowns], T) :-
    Known \== Key,
    known_t(Key, Knowns, T).

name_unknown_key(true, _, Known, Elements, Problems) :-
    unknown_keys(Elements, Known, Problems).
name_unknown_key(false, Key, Known, Elements, [unknown_key(Key)|Problems]) :-
    unknown_keys(Elements, [Key|Known], Problems).

% Contract keys, in contract order: duplicate_key(Key) when the key occurs more than once
% (none of its values is read), else wrong_type(Key) when its one value is outside the
% key's type. An absent key has no value to check.
key_problems([], _, Problems, Problems).
key_problems([Key|Keys], Profile, LaterProblems, Problems) :-
    key_type(Key, Type),
    key_occurrences(Profile, Key, Occurrences),
    key_problems(Keys, Profile, LaterProblems, KeyProblems),
    name_key_problem(Occurrences, Key, Type, Profile, KeyProblems, Problems).

% key_occurrences(Elements, Key, Occurrences): none, one or many items give Key.
key_occurrences([], _, none).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey == Key,
    key_occurrences(Elements, Key, RestOccurrences),
    one_more_occurrence(RestOccurrences, Occurrences).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey \== Key,
    key_occurrences(Elements, Key, Occurrences).

one_more_occurrence(none, one).
one_more_occurrence(one, many).
one_more_occurrence(many, many).

name_key_problem(none, _, _, _, Problems, Problems).
name_key_problem(many, Key, _, _, Problems, [duplicate_key(Key)|Problems]).
name_key_problem(one, Key, Type, Profile, KeyProblems, Problems) :-
    values_in_type_t(Profile, Key, Type, InType),
    name_wrong_type(InType, Key, KeyProblems, Problems).

name_wrong_type(true, _, Problems, Problems).
name_wrong_type(false, Key, Problems, [wrong_type(Key)|Problems]).

% values_in_type_t(Elements, Key, Type, T): T is true when every value Elements gives Key is
% in Type (true when Elements gives Key none).
values_in_type_t([], _, _, true).
values_in_type_t([attribute(ElementKey, Value)|Elements], Key, Type, T) :-
    ElementKey == Key,
    value_in_type_t(Type, Value, ValueInType),
    values_in_type_t(Elements, Key, Type, RestInType),
    truth_and(ValueInType, RestInType, T).
values_in_type_t([attribute(ElementKey, _)|Elements], Key, Type, T) :-
    ElementKey \== Key,
    values_in_type_t(Elements, Key, Type, T).

% A value with an unbound part is outside every type; a ground one is checked.
value_in_type_t(Type, Value, T) :-
    term_variables(Value, Variables),
    ground_value_in_type_t(Variables, Type, Value, T).

ground_value_in_type_t([_|_], _, _, false).
ground_value_in_type_t([], Type, Value, T) :-
    in_type_t(Type, Value, T).

% in_type_t(Type, Value, T): one clause per type, for a ground Value.
in_type_t(fact, Value, T) :-
    in_type_t(boolean, Value, T).

in_type_t(judgement, Value, T) :-
    in_type_t(one_of([boolean, enum([unsure])]), Value, T).

in_type_t(boolean, Value, T) :-
    memberd_t(Value, [true, false], T).

in_type_t(enum(Values), Value, T) :-
    memberd_t(Value, Values, T).

in_type_t(one_of(Types), Value, T) :-
    in_some_type_t(Types, Value, T).

truth_and(true, T, T).
truth_and(false, _, false).

% in_some_type_t(Types, Value, T): T is true when Value is in at least one of Types.
in_some_type_t([], _, false).
in_some_type_t([Type|Types], Value, T) :-
    in_type_t(Type, Value, InType),
    in_some_type_t(Types, Value, InAnother),
    truth_or(InType, InAnother, T).

truth_or(true, _, true).
truth_or(false, T, T).

:- end_module(kernel).
