% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/dora_rts_physical_hr_identity_and_access.
%
% Instruments:
%   Commission Delegated Regulation (EU) 2024/1774 (the RTS on ICT risk
%   management tools, methods, processes and policies and the simplified
%   ICT risk management framework), CELEX 32024R1774, original OJ text;
%   Regulation (EU) 2022/2554 (DORA), CELEX 32022R2554, OJ L 333,
%   27.12.2022, p. 1, original OJ text.
% Pin folder: eu/dora_rts_physical_hr_identity_and_access/sources/.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order. Every
% key below is `status: verified` in citations-sources.yaml: the verbatim
% is an exact substring of the pinned unit text.
%
% Keys are the canonical lexicon keys (_lexicon/citations.yaml). The
% deferred units (DORA Art 16(1), second subparagraph, points (a) to (h);
% Art 16(2); Art 16(3); the headings of RTS Articles 18 and 20 and of DORA
% Article 16) carry no key: no limb reads them.
%
% PROVENANCE: every operative clause opens its body with implements(Key),
% Key one recorded below.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

% ---- DORA Article 16(1), first subparagraph: the gate ---------------
citation(eu_reg_2022_2554_art_16_1, [label-'Regulation (EU) 2022/2554 (DORA) Art 16(1), first subparagraph (entities to which Articles 5 to 15 do not apply)', ref-'CELEX 32022R2554, unit 32022R2554#parag_016.001; https://eur-lex.europa.eu/eli/reg/2022/2554/oj', verbatim-'Articles 5 to 15 of this Regulation shall not apply to small and non-interconnected investment firms']).

% ---- RTS Article 18: physical and environmental security -------------
citation(eu_reg_2024_1774_art_18_1, [label-'Delegated Regulation (EU) 2024/1774 Art 18(1) (physical and environmental security policy; its design)', ref-'CELEX 32024R1774, unit 32024R1774#parag_018.001; https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'financial entities shall specify, document, and implement a physical and environmental security policy']).
citation(eu_reg_2024_1774_art_18_2, [label-'Delegated Regulation (EU) 2024/1774 Art 18(2) (contents of the policy; closing words for points (b) and (c))', ref-'CELEX 32024R1774, unit 32024R1774#parag_018.002; https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'shall contain measures to provide appropriate protection to unattended ICT assets']).
citation(eu_reg_2024_1774_art_18_2_a, [label-'Delegated Regulation (EU) 2024/1774 Art 18(2)(a) (reference to the section on physical access controls)', ref-'CELEX 32024R1774, unit 32024R1774#point_018.002_a; https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'a reference to the section of the policy on control of access management rights referred to in Article 21, first paragraph, point (g)']).
citation(eu_reg_2024_1774_art_18_2_b, [label-'Delegated Regulation (EU) 2024/1774 Art 18(2)(b) (protection of premises, data centres and sensitive designated areas)', ref-'CELEX 32024R1774, unit 32024R1774#point_018.002_b; https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'measures to protect from attacks, accidents, and environmental threats and hazards']).
citation(eu_reg_2024_1774_art_18_2_c, [label-'Delegated Regulation (EU) 2024/1774 Art 18(2)(c) (securing ICT assets within and outside the premises)', ref-'CELEX 32024R1774, unit 32024R1774#point_018.002_c; https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'measures to secure ICT assets, both within and outside the premises of the financial entity']).
citation(eu_reg_2024_1774_art_18_2_d, [label-'Delegated Regulation (EU) 2024/1774 Art 18(2)(d) (appropriate maintenance of assets and physical access control devices)', ref-'CELEX 32024R1774, unit 32024R1774#point_018.002_d; https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'through the appropriate maintenance']).
citation(eu_reg_2024_1774_art_18_2_e_i, [label-'Delegated Regulation (EU) 2024/1774 Art 18(2)(e)(i) (clear desk policy for papers)', ref-'CELEX 32024R1774, unit 32024R1774#point_018.002_e_i; https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'a clear desk policy for papers']).
citation(eu_reg_2024_1774_art_18_2_e_ii, [label-'Delegated Regulation (EU) 2024/1774 Art 18(2)(e)(ii) (clear screen policy for information processing facilities)', ref-'CELEX 32024R1774, unit 32024R1774#point_018.002_e_ii; https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'a clear screen policy for information processing facilities']).

% ---- RTS Article 19: human resources policy -----------------------------
citation(eu_reg_2024_1774_art_19, [label-'Delegated Regulation (EU) 2024/1774 Art 19 (human resources policy; lead words, whole article)', ref-'CELEX 32024R1774, unit 32024R1774#art_019 with its point units; https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'Financial entities shall include in their human resource policy or other relevant policies all of the following ICT security related elements']).
citation(eu_reg_2024_1774_art_19_a, [label-'Delegated Regulation (EU) 2024/1774 Art 19(a) (specific ICT security responsibilities)', ref-'CELEX 32024R1774, unit 32024R1774#point_019_a; https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'the identification and assignment of any specific ICT security responsibilities']).
citation(eu_reg_2024_1774_art_19_b_i, [label-'Delegated Regulation (EU) 2024/1774 Art 19(b)(i) (staff informed about and adhering to ICT security policies)', ref-'CELEX 32024R1774, unit 32024R1774#point_019_b_i; https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'be informed about, and adhere to']).
citation(eu_reg_2024_1774_art_19_b_ii, [label-'Delegated Regulation (EU) 2024/1774 Art 19(b)(ii) (staff aware of the reporting channels)', ref-'CELEX 32024R1774, unit 32024R1774#point_019_b_ii; https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'be aware of the reporting channels put in place by the financial entity for the detection of anomalous behaviour']).
citation(eu_reg_2024_1774_art_19_b_iii, [label-'Delegated Regulation (EU) 2024/1774 Art 19(b)(iii) (return of assets upon termination of employment)', ref-'CELEX 32024R1774, unit 32024R1774#point_019_b_iii; https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'upon termination of employment, all ICT assets and tangible information assets in their possession that belong to the financial entity']).

% ---- RTS Article 20: identity management --------------------------------
citation(eu_reg_2024_1774_art_20_1, [label-'Delegated Regulation (EU) 2024/1774 Art 20(1) (identity management policies and procedures)', ref-'CELEX 32024R1774, unit 32024R1774#parag_020.001; https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'financial entities shall develop, document, and implement identity management policies and procedures']).
citation(eu_reg_2024_1774_art_20_2, [label-'Delegated Regulation (EU) 2024/1774 Art 20(2) (contents; closing words for points (a) and (b))', ref-'CELEX 32024R1774, unit 32024R1774#parag_020.002; https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'financial entities shall maintain records of all identity assignments']).
citation(eu_reg_2024_1774_art_20_2_a, [label-'Delegated Regulation (EU) 2024/1774 Art 20(2)(a) (unique identity corresponding to a unique user account)', ref-'CELEX 32024R1774, unit 32024R1774#point_020.002_a; https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'a unique identity corresponding to a unique user account shall be assigned to each staff member']).
citation(eu_reg_2024_1774_art_20_2_b, [label-'Delegated Regulation (EU) 2024/1774 Art 20(2)(b) (lifecycle management process for identities and accounts)', ref-'CELEX 32024R1774, unit 32024R1774#point_020.002_b; https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'a lifecycle management process for identities and accounts']).

% ---- RTS Article 21: access control -------------------------------------
citation(eu_reg_2024_1774_art_21, [label-'Delegated Regulation (EU) 2024/1774 Art 21 (access control policy; lead words and closing words for points (e)(i), (e)(ii), (g)(i) and (g)(iii), whole article)', ref-'CELEX 32024R1774, unit 32024R1774#art_021 with its point units; https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'financial entities shall develop, document, and implement a policy that contains all of the following']).
citation(eu_reg_2024_1774_art_21_a, [label-'Delegated Regulation (EU) 2024/1774 Art 21(a) (need-to-know, need-to-use and least privilege)', ref-'CELEX 32024R1774, unit 32024R1774#point_021_a; https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'based on need-to-know, need-to-use and least privilege principles']).
citation(eu_reg_2024_1774_art_21_b, [label-'Delegated Regulation (EU) 2024/1774 Art 21(b) (segregation of duties)', ref-'CELEX 32024R1774, unit 32024R1774#point_021_b; https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'the segregation of duties designed to prevent unjustified access to critical data']).
citation(eu_reg_2024_1774_art_21_c, [label-'Delegated Regulation (EU) 2024/1774 Art 21(c) (user accountability)', ref-'CELEX 32024R1774, unit 32024R1774#point_021_c; https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'a provision on user accountability']).
citation(eu_reg_2024_1774_art_21_d, [label-'Delegated Regulation (EU) 2024/1774 Art 21(d) (restrictions of access to ICT assets)', ref-'CELEX 32024R1774, unit 32024R1774#point_021_d; https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'a provision on restrictions of access to ICT assets']).
citation(eu_reg_2024_1774_art_21_e_i, [label-'Delegated Regulation (EU) 2024/1774 Art 21(e)(i) (roles for granting, reviewing and revoking access rights)', ref-'CELEX 32024R1774, unit 32024R1774#point_021_e_i; https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'assignment of roles and responsibilities for granting, reviewing, and revoking access rights']).
citation(eu_reg_2024_1774_art_21_e_ii, [label-'Delegated Regulation (EU) 2024/1774 Art 21(e)(ii) (privileged, emergency and administrator access)', ref-'CELEX 32024R1774, unit 32024R1774#point_021_e_ii; https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'assignment of privileged, emergency, and administrator access on a need-to-use or an ad-hoc basis for all ICT systems']).
citation(eu_reg_2024_1774_art_21_e_iii, [label-'Delegated Regulation (EU) 2024/1774 Art 21(e)(iii) (withdrawal of access rights without undue delay)', ref-'CELEX 32024R1774, unit 32024R1774#point_021_e_iii; https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'withdrawal of access rights without undue delay upon termination of the employment']).
citation(eu_reg_2024_1774_art_21_e_iv, [label-'Delegated Regulation (EU) 2024/1774 Art 21(e)(iv) (update of access rights where necessary and at the required intervals)', ref-'CELEX 32024R1774, unit 32024R1774#point_021_e_iv; https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'at least every 6 months for ICT systems supporting critical or important functions']).
citation(eu_reg_2024_1774_art_21_f_i, [label-'Delegated Regulation (EU) 2024/1774 Art 21(f)(i) (authentication methods commensurate to classification and risk profile)', ref-'CELEX 32024R1774, unit 32024R1774#point_021_f_i; https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'the use of authentication methods commensurate to the classification']).
citation(eu_reg_2024_1774_art_21_f_ii, [label-'Delegated Regulation (EU) 2024/1774 Art 21(f)(ii) (strong authentication methods)', ref-'CELEX 32024R1774, unit 32024R1774#point_021_f_ii; https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'the use of strong authentication methods in accordance with leading practices and techniques']).
citation(eu_reg_2024_1774_art_21_g_i, [label-'Delegated Regulation (EU) 2024/1774 Art 21(g)(i) (identification and logging of authorised persons)', ref-'CELEX 32024R1774, unit 32024R1774#point_021_g_i; https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'the identification and logging of natural persons that are authorised to access premises']).
citation(eu_reg_2024_1774_art_21_g_ii, [label-'Delegated Regulation (EU) 2024/1774 Art 21(g)(ii) (physical access rights to critical ICT assets)', ref-'CELEX 32024R1774, unit 32024R1774#point_021_g_ii; https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'the granting of physical access rights to critical ICT assets to authorised persons only']).
citation(eu_reg_2024_1774_art_21_g_iii, [label-'Delegated Regulation (EU) 2024/1774 Art 21(g)(iii) (monitoring of physical access)', ref-'CELEX 32024R1774, unit 32024R1774#point_021_g_iii; https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'the monitoring of physical access to premises, data centres, and sensitive designated areas']).
citation(eu_reg_2024_1774_art_21_g_iv, [label-'Delegated Regulation (EU) 2024/1774 Art 21(g)(iv) (review of physical access rights)', ref-'CELEX 32024R1774, unit 32024R1774#point_021_g_iv; https://eur-lex.europa.eu/eli/reg_del/2024/1774/oj', verbatim-'the review of physical access rights to ensure that unnecessary access rights are promptly revoked']).

% ---- provenance marker ---------------------------------------------------
% implements(Key): succeeds for every recorded key, fails for any other.
implements(Key) :-
    citation(Key, _).

test(a_recorded_key_is_implemented) :-
    implements(eu_reg_2024_1774_art_21).
test(the_gate_key_is_implemented) :-
    implements(eu_reg_2022_2554_art_16_1).
test(an_unrecorded_key_is_not_implemented, fail) :-
    implements(eu_reg_2024_1774_art_21_h).
test(the_placeholder_is_gone, fail) :-
    citation(eu_todo_primary_source, _).

:- end_module(citations).
