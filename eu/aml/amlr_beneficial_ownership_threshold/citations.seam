# citations.clausal -- machine-readable citation registry for this domain.
# Generated by _tools/scaffold_citations.py; ref/verbatim populated by the
# citation sourcing pass (verified against authoritative sources; see
# citations-sources.yaml). Regenerate structure; hand-edit only ref/verbatim.
#
# Owns cite/1 (the in-clause citation wrapper) and citation/2 (the
# explainability lookup: cite(C) in a decision resolves to citation(C, Meta)).
# English verbatim is the default-language rendition; other languages go in a
# per-domain translation/<lang>.clausal subpackage -- the translation/2 functor
# carries {verbatim, ref}, namespace-derived, load-on-demand -- NOT here.


-module(citations, [cite(C), implements(C), citation(ATOM, META),
    eu_reg_2024_1624_art_52_1, eu_reg_2024_1624_art_51_chapeau, eu_reg_2024_1624_art_51_a])
-double_quotes(chars)
-private([label, ref, units, verbatim])

-strict_atoms

# implements/1 -- the in-clause provenance marker (provision tracking, 2026-10-18). It
# succeeds only for a key this module declares, so a clause cannot claim a provision that
# has no record. cite/1 stays the head-term form requirement/4 already uses.
implements(KEY) <- (
    citation(KEY, _)
),

citation(eu_reg_2024_1624_art_52_1, {
  label:    "AMLR (Reg (EU) 2024/1624) Art. 52(1)",
  ref:      "https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202401624",
  units:    ["32024R1624#parag_052.001"],
  verbatim: """1.   For the purpose of Article 51, first paragraph, point (a), ‘an ownership interest in the corporate entity’ shall mean direct or indirect ownership of 25 % or more of the shares or voting rights or other ownership interest in the corporate entity, including rights to a share of profits, other internal resources or liquidation balance. The indirect ownership shall be calculated by multiplying the shares or voting rights or other ownership interests held by the intermediate entities in the chain of entities in which the beneficial owner holds shares or voting rights and by adding together the results from those various chains, unless Article 54 applies.
For the purposes of assessing whether an ownership interest exists in the corporate entity, all shareholdings on every level of ownership shall be taken into account."""
}),

citation(eu_reg_2024_1624_art_51_chapeau, {
  label:    "AMLR (Reg (EU) 2024/1624) Art. 51, first paragraph",
  ref:      "https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202401624",
  units:    ["32024R1624#art_051/1"],
  verbatim: """Beneficial owners of legal entities shall be the natural persons who:"""
}),

citation(eu_reg_2024_1624_art_51_a, {
  label:    "AMLR (Reg (EU) 2024/1624) Art. 51, first paragraph, point (a)",
  ref:      "https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202401624",
  units:    ["32024R1624#point_051_a"],
  verbatim: """have, directly or indirectly, an ownership interest in the corporate entity"""
}),
