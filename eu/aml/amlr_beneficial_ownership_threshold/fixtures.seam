# =====================================================================
# fixtures.clausal -- (Wave B decomposition; clause bodies byte-identical
# to the pre-split monolith; decision-preserving).
# =====================================================================

-module(fixtures, [
    amlr_bo_subject(S),
    amlr_bo_profile_for(S, P),
    amlr_bo_assess(SUBJECT, RESULT)
])
-double_quotes(chars)

-import_from(eu.aml.amlr_beneficial_ownership_threshold.beneficial_ownership, [
    ownership_chains, assess_amlr_bo])

-strict_atoms

amlr_bo_subject("person_direct_30pct"),

amlr_bo_subject("person_chain_50x49pct_below"),

amlr_bo_subject("person_missing_chains"),

amlr_bo_profile_for("person_direct_30pct", {ownership_chains: [[3000]]}),

amlr_bo_profile_for("person_chain_50x49pct_below", {ownership_chains: [[5000, 4999]]}),

amlr_bo_profile_for("person_missing_chains", {}),

amlr_bo_assess(SUBJECT, RESULT) <- (
    amlr_bo_profile_for(SUBJECT, PROFILE),
    assess_amlr_bo(SUBJECT, PROFILE, RESULT)
)
