# eu.aml.amlr_beneficial_ownership_threshold/__init__.clausal -- thin package init.
# Re-exports the domain's PUBLIC surface from its named submodules so a consumer
# writes -import_from(eu.aml.amlr_beneficial_ownership_threshold, [...]) while the
# logic lives in the well-named submodules. Direct submodule imports remain valid.
# Regenerate; do not hand-edit.
#
# Wave C re-slice (2026-08-07): the NAME SET below is UNCHANGED (28 names, the
# compat contract); only the source modules moved. schema / constants /
# computation / requirements / decision collapsed into the single determination
# slice beneficial_ownership.clausal.
#
# NOT regenerated by auto/pkginit.py, deliberately: `pkginit.surface` narrows the
# facade to manifest.yaml's `public_interface`, which does NOT list the eight bare
# atoms below (eligible, ineligible, indeterminate, met,
# effective_holding_below_25_percent_threshold, required_ownership_threshold,
# ownership_chains, eu_reg_2024_1624_art_52_1). tests/test_l1_interface.clausal and
# tests/test_queries.clausal import those atoms from THIS facade, and
# eval/score_harness.py resolves `ownership_chains` and
# `required_ownership_threshold` by name off it, so a narrowing regeneration would
# break the battery and the oracle. That narrowing is PRE-EXISTING (it drops the
# same names from the layer layout too) and is reported, not fixed here.
-double_quotes(chars)
-import_from(eu.aml.amlr_beneficial_ownership_threshold.beneficial_ownership, [
    eligible, ineligible, indeterminate, met, effective_holding_below_25_percent_threshold,
    required_ownership_threshold, ownership_chains,
    amlr_bo_requirement_ids,
    amlr_bo_minimum_holding_bps, amlr_bo_effective_holding_bps, amlr_bo_threshold,
    amlr_bo_effective_holding, amlr_bo_status,
    requirement,
    assess_amlr_bo, amlr_bo_decision, amlr_bo_checklist])
-import_from(eu.aml.amlr_beneficial_ownership_threshold.fixtures, [
    amlr_bo_assess, amlr_bo_subject, amlr_bo_profile_for])
-import_from(eu.aml.amlr_beneficial_ownership_threshold.queries, [
    amlr_bo_diff, amlr_bo_what_if, amlr_bo_direct_boundary,
    amlr_bo_gap_to_threshold])
-import_from(eu.aml.amlr_beneficial_ownership_threshold.citations, [
    cite, citation, eu_reg_2024_1624_art_52_1])
