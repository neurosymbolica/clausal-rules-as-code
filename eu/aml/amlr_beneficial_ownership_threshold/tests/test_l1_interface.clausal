% =====================================================================
% test_l1_interface.clausal -- AMLR Art 52 beneficial-ownership L1 public
% interface. Exercises amlr_bo_decision/2, assess_amlr_bo/3, requirement/4,
% the checklist and the numeric projections, asserting DETERMINISM (exactly one
% decision per profile). Imports the module's exported BARE ATOMS (a cross-module
% module-scoping check). Additive to test_public_interface.clausal (raw surface).
% Run:  python -m clausal.testing test_l1_interface.clausal
% =====================================================================
% (Clausal Prolog: the seam imports of the module's bare ATOMS -- eligible,
% ineligible, indeterminate, met, effective_holding_below_25_percent_threshold,
% required_ownership_threshold, the eu_reg_2024_1624_art_52_1 key and the
% ownership_chains profile KEY atom -- and of the data constructors cite/1,
% item/3, unmet/1, unknown/1 and assessment/3 have no counterpart: atoms and
% compound terms are global by spelling and need no import. Only predicates
% are imported. A profile dict is built with dict_pairs/2.)
:- module(test_l1_interface, []).
:- use_module(library(clpz)).
:- use_module(eu/aml/amlr_beneficial_ownership_threshold, [
    assess_amlr_bo/3, amlr_bo_decision/2, requirement/4, amlr_bo_checklist/2,
    amlr_bo_requirement_ids/1, amlr_bo_minimum_holding_bps/1,
    amlr_bo_effective_holding_bps/2]).

% Direct 30% holding -> eligible (a beneficial owner).
q_bo(Profile) :- dict_pairs(Profile, [ownership_chains-[[3000]]]).
% Chain 50% x 49.99% = 24.995% -> below the 25% threshold.
q_below(Profile) :- dict_pairs(Profile, [ownership_chains-[[5000, 4999]]]).
% ownership_chains key absent -> unknown / indeterminate (fail-closed).
q_missing(Profile) :- dict_pairs(Profile, []).
% Boundary: product 50% x 50% = exactly 25% -> beneficial owner (inclusive).
q_boundary(Profile) :- dict_pairs(Profile, [ownership_chains-[[5000, 5000]]]).

% ---- headline decisions --------------------------------------------
test('PI direct 30pct -> eligible (beneficial owner)') :-
    q_bo(P), amlr_bo_decision(P, eligible).
test('PI product 50x50 = 25pct boundary -> eligible (beneficial owner)') :-
    q_boundary(P), amlr_bo_decision(P, eligible).
test('PI 50x49.99 below -> ineligible (not a beneficial owner)') :-
    q_below(P), amlr_bo_decision(P, ineligible).
test('PI missing chains -> indeterminate') :-
    q_missing(P), amlr_bo_decision(P, indeterminate).

% ---- DETERMINISM: exactly one decision per profile -----------------
test('DET eligible') :-
    q_bo(P), findall(X, amlr_bo_decision(P, X), L), length(L, 1).
test('DET ineligible') :-
    q_below(P), findall(X, amlr_bo_decision(P, X), L), length(L, 1).
test('DET indeterminate') :-
    q_missing(P), findall(X, amlr_bo_decision(P, X), L), length(L, 1).

% ---- checklist provenance: 1 item, cited to Art 52(1) --------------
test('checklist has 1 item') :-
    q_bo(P), amlr_bo_checklist(P, Checklist), length(Checklist, 1).
test('threshold item met + cited to Art 52(1)') :-
    q_bo(P), requirement(required_ownership_threshold, P, met, cite(eu_reg_2024_1624_art_52_1)).
test('item unmet(REASON) when below threshold') :-
    q_below(P), requirement(required_ownership_threshold, P, unmet(effective_holding_below_25_percent_threshold), _).
test('item unknown(KEYS) names the missing chains key') :-
    q_missing(P), requirement(required_ownership_threshold, P, unknown([ownership_chains]), cite(eu_reg_2024_1624_art_52_1)).

% ---- numeric projections -------------------------------------------
test('Art 52 minimum is 2500 basis points') :-
    amlr_bo_minimum_holding_bps(B), B #= 2500.
test('effective holding of 50x50 chain is 2500 basis points') :-
    amlr_bo_effective_holding_bps([[5000, 5000]], B), B #= 2500.
test('requirement ids is the singleton threshold set') :-
    amlr_bo_requirement_ids([required_ownership_threshold]).

% ---- full verdict term ---------------------------------------------
test('assess yields assessment(subject, eligible, checklist)') :-
    q_bo(P),
    assess_amlr_bo("s", P, assessment("s", eligible, Checklist)),
    length(Checklist, 1).

:- end_module(test_l1_interface).
