# citations.seam -- machine-readable citation registry for eu/aml/amlr_bo_chain.
#
# Written 2026-10-18 through the propose step (_tools/propose_provisions.py --pack,
# a drafted proposal, --validate OK). Every `units` id is a unit of the pinned AMLR
# Arts 51-52 extract under sources/, and every `verbatim` is copied from that unit's
# own text (T5 checks it). Units this domain does not implement are deferred in
# manifest.yaml `deferred_set`.
#
# Owns implements/1 (the in-clause provenance marker) and citation/2 (the lookup).

-module(citations, [
    implements(C),
    citation(ATOM, META),
    eu_reg_2024_1624_art_51_chapeau,
    eu_reg_2024_1624_art_51_a,
    eu_reg_2024_1624_art_52_1,
    eu_reg_2024_1624_art_52_1_indirect,
    eu_reg_2024_1624_art_52_1_every_level
])
-double_quotes(chars)
-private([label, ref, units, verbatim])

-strict_atoms

# implements/1 -- the in-clause provenance marker. It succeeds only for a key this
# module declares, so a clause cannot claim a provision that has no record.
implements(KEY) <- (
    citation(KEY, _)
),

citation(eu_reg_2024_1624_art_51_chapeau, {
  label:    "AMLR (Reg (EU) 2024/1624) Art. 51, first paragraph",
  ref:      "https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202401624",
  units:    ["32024R1624#art_051/1"],
  verbatim: """Beneficial owners of legal entities shall be the natural persons who:"""
}),

citation(eu_reg_2024_1624_art_51_a, {
  label:    "AMLR (Reg (EU) 2024/1624) Art. 51, first paragraph, point (a)",
  ref:      "https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202401624",
  units:    ["32024R1624#point_051_a"],
  verbatim: """have, directly or indirectly, an ownership interest in the corporate entity"""
}),

citation(eu_reg_2024_1624_art_52_1, {
  label:    "AMLR (Reg (EU) 2024/1624) Art. 52(1), first sentence",
  ref:      "https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202401624",
  units:    ["32024R1624#parag_052.001"],
  verbatim: """shall mean direct or indirect ownership of 25 % or more of the shares or voting rights or other ownership interest in the corporate entity, including rights to a share of profits, other internal resources or liquidation balance"""
}),

citation(eu_reg_2024_1624_art_52_1_indirect, {
  label:    "AMLR (Reg (EU) 2024/1624) Art. 52(1), indirect ownership",
  ref:      "https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202401624",
  units:    ["32024R1624#parag_052.001"],
  verbatim: """The indirect ownership shall be calculated by multiplying the shares or voting rights or other ownership interests held by the intermediate entities in the chain of entities in which the beneficial owner holds shares or voting rights and by adding together the results from those various chains"""
}),

citation(eu_reg_2024_1624_art_52_1_every_level, {
  label:    "AMLR (Reg (EU) 2024/1624) Art. 52(1), every level of ownership",
  ref:      "https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202401624",
  units:    ["32024R1624#parag_052.001"],
  verbatim: """all shareholdings on every level of ownership shall be taken into account"""
}),
