% ---- input problems ----------------------------------------------------
scenario(input_unsure_boolean, input_check, [
    attribute(location_consent_withdrawn, unsure)
]).
scenario(input_unknown_key, input_check, [
    attribute(favourite_colour, blue)
]).
scenario(input_duplicate_key, input_check, [
    attribute(marketing_communication_means, fax),
    attribute(marketing_communication_means, electronic_mail)
]).

% ---- Convenience wrapper ---------------------------------------------
eprivacy_breach_traffic_location_marketing_assess(Subject, Result) :-
    eprivacy_breach_traffic_location_marketing_profile_for(Subject, Profile),
    decide_eprivacy_breach_traffic_location_marketing(Profile, Result).

:- end_module(fixtures).
