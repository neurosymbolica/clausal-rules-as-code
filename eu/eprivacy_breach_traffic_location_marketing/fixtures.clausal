% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% fixtures.clausal -- representative profiles for eu/eprivacy_breach_traffic_location_marketing.
% A TOP-LAYER consumer: it imports only the slice predicate it calls.
%
% A profile is an ATTRIBUTE LIST [attribute(Key, Value), ...] (the order's
% typed input contract). Each subject is a SCENARIO for one determination
% (its focus); every other determination gets one out-of-scope attribute
% (the provider of Art 4(3) false, the provider of Art 6 false, the
% location scope of Art 9 false, direct marketing of Art 13 false), so its
% row is settled not_applicable and the facade verdict turns on the focus.
% The domain has no number, date or threshold (reading (4)): the near-miss
% controls flip ONE key of the positive case.
% =====================================================================

:- module(fixtures, [
    eprivacy_breach_traffic_location_marketing_subject/1,
    eprivacy_breach_traffic_location_marketing_profile_for/2,
    eprivacy_breach_traffic_location_marketing_assess/2
]).

:- use_module(eu/eprivacy_breach_traffic_location_marketing/eprivacy_breach_traffic_location_marketing, [decide_eprivacy_breach_traffic_location_marketing/2]).

% ---- Subject registry ------------------------------------------------
eprivacy_breach_traffic_location_marketing_subject(Subject) :-
    scenario(Subject, _, _).

% ---- Profiles --------------------------------------------------------
eprivacy_breach_traffic_location_marketing_profile_for(Subject, Profile) :-
    scenario(Subject, Focus, Attributes),
    findall(Background,
            ( background(Determination, Background),
              dif(Determination, Focus)
            ),
            Backgrounds),
    append(Attributes, Backgrounds, Profile).

% The out-of-scope attribute of each determination.
background(personal_data_breach_notification, attribute(breach_provider_of_publicly_available_service, false)).
background(traffic_data_processing, attribute(traffic_provider_of_public_network_or_service, false)).
background(location_data_processing, attribute(location_data_other_than_traffic_data_in_scope, false)).
background(direct_marketing, attribute(marketing_communication_for_direct_marketing, false)).

% ---- Article 4(3) ------------------------------------------------------
scenario(breach_individual_notification_due, personal_data_breach_notification, [
    attribute(breach_provider_of_publicly_available_service, true),
    attribute(personal_data_breach_occurred, true),
    attribute(authority_required_individual_notification, false),
    attribute(breach_likely_to_adversely_affect_subscriber_or_individual, true),
    attribute(protection_measures_demonstrated_to_authority, false)
]).
scenario(breach_protection_demonstrated_control, personal_data_breach_notification, [
    attribute(breach_provider_of_publicly_available_service, true),
    attribute(personal_data_breach_occurred, true),
    attribute(authority_required_individual_notification, false),
    attribute(breach_likely_to_adversely_affect_subscriber_or_individual, true),
    attribute(protection_measures_demonstrated_to_authority, true)
]).
