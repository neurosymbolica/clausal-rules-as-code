    attribute(personal_data_breach_occurred, true),
    attribute(authority_required_individual_notification, true),
    attribute(breach_likely_to_adversely_affect_subscriber_or_individual, false),
    attribute(protection_measures_demonstrated_to_authority, true)
]).
scenario(breach_authority_not_required_control, personal_data_breach_notification, [
    attribute(breach_provider_of_publicly_available_service, true),
    attribute(personal_data_breach_occurred, true),
    attribute(authority_required_individual_notification, false),
    attribute(breach_likely_to_adversely_affect_subscriber_or_individual, false),
    attribute(protection_measures_demonstrated_to_authority, true)
]).
scenario(breach_not_a_personal_data_breach, personal_data_breach_notification, [
    attribute(breach_provider_of_publicly_available_service, true),
    attribute(personal_data_breach_occurred, false)
]).
scenario(breach_personal_data_breach_control, personal_data_breach_notification, [
    attribute(breach_provider_of_publicly_available_service, true),
    attribute(personal_data_breach_occurred, true),
    attribute(authority_required_individual_notification, false),
    attribute(breach_likely_to_adversely_affect_subscriber_or_individual, false),
    attribute(protection_measures_demonstrated_to_authority, false)
]).
scenario(breach_not_a_provider, personal_data_breach_notification, [
    attribute(breach_provider_of_publicly_available_service, false)
]).
scenario(breach_missing_likelihood, personal_data_breach_notification, [
    attribute(breach_provider_of_publicly_available_service, true),
    attribute(personal_data_breach_occurred, true),
    attribute(authority_required_individual_notification, false)
]).
scenario(breach_unsure_likelihood, personal_data_breach_notification, [
    attribute(breach_provider_of_publicly_available_service, true),
    attribute(personal_data_breach_occurred, true),
    attribute(authority_required_individual_notification, false),
    attribute(breach_likely_to_adversely_affect_subscriber_or_individual, unsure),
    attribute(protection_measures_demonstrated_to_authority, false)
]).

