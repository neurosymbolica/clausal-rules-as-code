% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% queries.clausal -- QUERY-COMBINATOR layer for eu/nis2_lex_specialis_and_definitions.
% A TOP-LAYER consumer: it imports the determination slice's PUBLIC
% predicates it calls, and nothing else.
%
% Query types this domain serves, and where each lives:
%   #2 eligibility   -- decide_nis2_lex_specialis_and_definitions/2 and
%                       nis2_lex_specialis_and_definitions_status/2 (slice),
%                       over the two called-contract queries
%                       nis2_risk_management_provisions_status/3 and
%                       nis2_incident_notification_provisions_status/3;
%   #7 justification -- nis2_lex_specialis_and_definitions_checklist/2
%                       (slice): one item per group, each carrying its
%                       group's cite(...) list;
%   #16 what-if      -- nis2_lex_specialis_and_definitions_what_if/4 (here):
%                       override one key, re-evaluate both groups.
% nis2_lex_specialis_and_definitions_profile_keys/1: the profile key schema
% nis2_lex_specialis_and_definitions_input_problems/2: the problems a profile
%   has ([] = none), re-exported from the kernel as the scaffold wrote it.
%
% The open-textured judgements ('at least equivalent in effect', Art 4(2))
% are never decided here: a what-if only re-asks the slice with the
% caller's hypothetical judgement in place.
%
% The profile is an ATTRIBUTE LIST, not a dict, so the kit's override_key
% (which works on a dict) does not apply; the what-if override is a small
% attribute-list replacement (profile plumbing, no statutory content):
% every attribute of the overridden key (compared with ==) is dropped and
% one attribute(Key, Value) is appended.
% =====================================================================

:- module(queries, [
    nis2_lex_specialis_and_definitions_profile_keys/1,
    nis2_lex_specialis_and_definitions_input_problems/2,
    nis2_lex_specialis_and_definitions_what_if/4
]).

:- use_module(eu/nis2_lex_specialis_and_definitions/kernel, [nis2_lex_specialis_and_definitions_input_problems/2]).
:- use_module(eu/nis2_lex_specialis_and_definitions/nis2_lex_specialis_and_definitions, [nis2_lex_specialis_and_definitions_status/2]).

% schema of top-level profile keys: the keys of the order's typed input contract, in its order
nis2_lex_specialis_and_definitions_profile_keys([entity_class, dora_risk_management_measures_at_least_equivalent_in_effect, dora_gives_immediate_access_to_incident_notifications, dora_incident_notification_requirements_at_least_equivalent_in_effect]).

% #16 what-if: re-evaluate both groups with one key hypothetically overridden.
% NewStatus is nis2_groups(RiskResult, NotificationResult), as the slice gives it.
nis2_lex_specialis_and_definitions_what_if(Profile, OverriddenKey, NewValue, NewStatus) :-
    profile_with_override(Profile, OverriddenKey, NewValue, Hypothesis),
    nis2_lex_specialis_and_definitions_status(Hypothesis, NewStatus).

% ---- profile plumbing (no statutory content) --------------------------
% profile_with_override(Profile, Key, Value, Hypothesis): Profile without
% any attribute of Key (compared with ==), then attribute(Key, Value).
% Complementary clauses on ==, so exactly one Hypothesis per Profile.
profile_with_override([], OverriddenKey, NewValue, [attribute(OverriddenKey, NewValue)]).
profile_with_override([attribute(ElementKey, _ElementValue)|Elements], OverriddenKey, NewValue, Hypothesis) :-
    ElementKey == OverriddenKey,
    profile_with_override(Elements, OverriddenKey, NewValue, Hypothesis).
profile_with_override([attribute(ElementKey, ElementValue)|Elements], OverriddenKey, NewValue, [attribute(ElementKey, ElementValue)|Hypothesis]) :-
    ElementKey \== OverriddenKey,
    profile_with_override(Elements, OverriddenKey, NewValue, Hypothesis).

% ---- tests -------------------------------------------------------------
test(profile_keys_follow_the_contract_order) :-
    nis2_lex_specialis_and_definitions_profile_keys(ProfileKeys),
    ProfileKeys == [entity_class, dora_risk_management_measures_at_least_equivalent_in_effect, dora_gives_immediate_access_to_incident_notifications, dora_incident_notification_requirements_at_least_equivalent_in_effect].

test(override_replaces_the_existing_attribute) :-
    profile_with_override([attribute(entity_class, essential_entity), attribute(dora_risk_management_measures_at_least_equivalent_in_effect, false)], dora_risk_management_measures_at_least_equivalent_in_effect, true, Hypothesis),
    Hypothesis == [attribute(entity_class, essential_entity), attribute(dora_risk_management_measures_at_least_equivalent_in_effect, true)].

test(override_appends_an_absent_key) :-
    profile_with_override([attribute(entity_class, essential_entity)], dora_gives_immediate_access_to_incident_notifications, false, Hypothesis),
    Hypothesis == [attribute(entity_class, essential_entity), attribute(dora_gives_immediate_access_to_incident_notifications, false)].

test(what_if_flips_the_risk_group_to_disapplied) :-
    findall(Status,
            nis2_lex_specialis_and_definitions_what_if([attribute(entity_class, essential_entity), attribute(dora_risk_management_measures_at_least_equivalent_in_effect, false)], dora_risk_management_measures_at_least_equivalent_in_effect, true, Status),
            Statuses),
    Statuses == [nis2_groups(nis2_provisions_disapplied, indeterminate([dora_gives_immediate_access_to_incident_notifications]))].

test(what_if_out_of_scope_decides_both_groups) :-
    findall(Status,
            nis2_lex_specialis_and_definitions_what_if([attribute(entity_class, essential_entity), attribute(dora_risk_management_measures_at_least_equivalent_in_effect, true)], entity_class, out_of_scope, Status),
            Statuses),
    Statuses == [nis2_groups(out_of_scope, out_of_scope)].

test(what_if_out_of_scope_is_not_disapplied, fail) :-
    nis2_lex_specialis_and_definitions_what_if([attribute(entity_class, essential_entity), attribute(dora_risk_management_measures_at_least_equivalent_in_effect, true)], entity_class, out_of_scope, nis2_groups(nis2_provisions_disapplied, _)).

:- end_module(queries).
