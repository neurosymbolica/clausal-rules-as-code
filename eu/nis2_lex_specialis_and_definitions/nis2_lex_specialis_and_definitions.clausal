% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% nis2_lex_specialis_and_definitions.clausal -- the nis2_lex_specialis_and_definitions
% DETERMINATION for eu/nis2_lex_specialis_and_definitions, self-contained
% top to bottom: its statutory value facts (the designated classes, the
% fixed citation lists, the referral rows), its decision routes, its
% per-rule tests, its checklist and its verdict assembly.
%
% Source (the law this slice formalises):
%   Directive (EU) 2022/2555 (NIS 2 Directive) Art 4(1), first sentence;
%   Art 4(2), lead words, points (a) and (b)
%     [32022L2555, OJ L 333, 27.12.2022, p. 80];
%   Regulation (EU) 2022/2554 (DORA) Art 1(2)
%     [32022R2554, OJ L 333, 27.12.2022, p. 1].
% Deferred (not formalised): Art 4(1) second sentence, Art 4(3),
% Articles 6 and 25 of the Directive, DORA Article 1 except paragraph 2.
% The entity is presupposed to be a financial entity to which DORA
% applies (Q5). Every reading is the drafter's reading, not a lawyer's.
%
% Readings applied here:
%   (1) two questions, one per group of requirements of Art 4(1);
%   (2) DORA Art 1(2) makes DORA the sector-specific act for an
%       essential or important entity and settles nothing more (Q2, Q4);
%   (3) point (a) is the test for the risk-management group, point (b)
%       for the notification group (Q1);
%   (4) the three judgements are the caller's, true | false | unsure;
%       point (b) needs both of its conditions (and where);
%   (5) the answers name the group only (Q3).
% The open-textured term 'at least equivalent in effect' is never decided
% here: an unsure judgement that decides is referred to a lawyer.
%
% lint: canonical-citation-key (the segments dir, art, reg are lexicon
% atoms, not authored abbreviations; dora and nis2 are instrument names).
% =====================================================================

:- module(nis2_lex_specialis_and_definitions, [
    nis2_risk_management_provisions_status/3,
    nis2_incident_notification_provisions_status/3,
    decide_nis2_lex_specialis_and_definitions/2,
    nis2_lex_specialis_and_definitions_status/2,
    nis2_lex_specialis_and_definitions_checklist/2,
    nis2_lex_specialis_and_definitions_decision_resolvable/1,
    nis2_lex_specialis_and_definitions_status_values/1,
    nis2_provisions_disapplied/0,
    nis2_provisions_apply/0,
    out_of_scope/0,
    essential_entity/0,
    important_entity/0,
    indeterminate/1,
    needs_legal_review/2,
    open_textured/2,
    inputs_relied_on/1,
    provenance/2,
    input_problems/1,
    unknown_key/1,
    wrong_type/1,
    duplicate_key/1
]).

:- use_module(eu/nis2_lex_specialis_and_definitions/kernel, [nis2_lex_specialis_and_definitions_input_problems/2]).
:- use_module(eu/nis2_lex_specialis_and_definitions/citations, [implements/1]).
:- use_module(formalize_lib, [profile_get/3, profile_lacks/2]).

% ---- result constructors ----------------------------------------------
% Data, not predicates: exported so the package root names them, and
% given no clauses. The answers below build the terms directly.
:- constructors([indeterminate(missing_keys), needs_legal_review(reason, context), open_textured(input, citation), inputs_relied_on(pairs), provenance(clause, citations), input_problems(problems), unknown_key(key), wrong_type(key), duplicate_key(key)]).

% ---- result atoms -----------------------------------------------------
% Declared so the package root can export them as bare names.
nis2_provisions_disapplied.
nis2_provisions_apply.
out_of_scope.
essential_entity.
important_entity.

% ---- statutory value facts owned by this determination ---------------
% The verdict vocabulary of both queries (final answer atoms).
nis2_lex_specialis_and_definitions_status_values([nis2_provisions_disapplied, nis2_provisions_apply, out_of_scope]).

% DORA Art 1(2), reading (2): the classes for which DORA is the
% sector-specific Union legal act of Art 4 of the Directive.
designated_class(essential_entity, cite(eu_reg_2022_2554_art_1_2)).
designated_class(important_entity, cite(eu_reg_2022_2554_art_1_2)).

% Reading (8): the fixed citation list of every final answer of each group.
group_citations(risk_management, [cite(eu_dir_2022_2555_art_4_1), cite(eu_dir_2022_2555_art_4_2), cite(eu_dir_2022_2555_art_4_2_a), cite(eu_reg_2022_2554_art_1_2)]).
group_citations(incident_notification, [cite(eu_dir_2022_2555_art_4_1), cite(eu_dir_2022_2555_art_4_2), cite(eu_dir_2022_2555_art_4_2_b), cite(eu_reg_2022_2554_art_1_2)]).

% The order's referral rows: situation, reason, query, input, citation,
% inputs (in root_exports order).
referral_row(risk_management_equivalence_unclear,
             open_textured,
             nis2_risk_management_provisions_status,
             dora_risk_management_measures_at_least_equivalent_in_effect,
             cite(eu_dir_2022_2555_art_4_2_a),
             [entity_class, dora_risk_management_measures_at_least_equivalent_in_effect]).
referral_row(immediate_access_to_incident_notifications_unclear,
             open_textured,
             nis2_incident_notification_provisions_status,
             dora_gives_immediate_access_to_incident_notifications,
             cite(eu_dir_2022_2555_art_4_2_b),
             [entity_class, dora_gives_immediate_access_to_incident_notifications, dora_incident_notification_requirements_at_least_equivalent_in_effect]).
referral_row(incident_notification_equivalence_unclear,
             open_textured,
             nis2_incident_notification_provisions_status,
             dora_incident_notification_requirements_at_least_equivalent_in_effect,
             cite(eu_dir_2022_2555_art_4_2_b),
             [entity_class, dora_gives_immediate_access_to_incident_notifications, dora_incident_notification_requirements_at_least_equivalent_in_effect]).

% ---- profile plumbing (no statutory content) --------------------------
% key_state(Profile, ProfileKey, State): absent, or the value as given.
% Reached only for a profile without input problems, so the value is one
% of the key's atoms (never the atom absent) and occurs once.
key_state(Profile, ProfileKey, absent) :-
    profile_lacks(Profile, ProfileKey).
key_state(Profile, ProfileKey, Value) :-
    profile_get(Profile, ProfileKey, Value).

% present_pairs(Profile, Keys, Pairs): ProfileKey-Value for each of Keys
% present in Profile, in the order of Keys, values exactly as given.
present_pairs(_, [], []).
present_pairs(Profile, [ProfileKey|Keys], [ProfileKey-Value|Pairs]) :-
    profile_get(Profile, ProfileKey, Value),
    present_pairs(Profile, Keys, Pairs).
present_pairs(Profile, [ProfileKey|Keys], Pairs) :-
    profile_lacks(Profile, ProfileKey),
    present_pairs(Profile, Keys, Pairs).

% referral(Situation, Profile, Reason, Context): the reason and context of
% the firing referral row.
referral(Situation, Profile, open_textured(Input, Citation), [inputs_relied_on(Pairs)]) :-
    referral_row(Situation, open_textured, _Query, Input, Citation, Inputs),
    present_pairs(Profile, Inputs, Pairs).

% ---- query A: nis2_risk_management_provisions_status/3 ----------------
% (A0) input problems first.
nis2_risk_management_provisions_status(Profile, Result, Citations) :-
    nis2_lex_specialis_and_definitions_input_problems(Profile, Problems),
    risk_management_answer(Problems, Profile, Result, Citations).

risk_management_answer([Problem|Problems], _, input_problems([Problem|Problems]), []).
risk_management_answer([], Profile, Result, Citations) :-
    key_state(Profile, entity_class, ClassState),
    risk_management_by_class(ClassState, Profile, Result, Citations).

% (A1) entity_class absent: named whatever the judgement is.
risk_management_by_class(absent, _, indeterminate([entity_class]), []).
% (A2) out_of_scope decides alone: neither Art 4(1) nor DORA Art 1(2)
% reaches an entity that is not essential or important.
risk_management_by_class(out_of_scope, _, out_of_scope, Citations) :-
    implements(eu_dir_2022_2555_art_4_1),
    group_citations(risk_management, Citations).
% (A3)-(A5) an essential or important entity: DORA is the sector-specific act.
risk_management_by_class(Class, Profile, Result, Citations) :-
    implements(eu_reg_2022_2554_art_1_2),
    designated_class(Class, _),
    key_state(Profile, dora_risk_management_measures_at_least_equivalent_in_effect, JudgementState),
    risk_management_by_judgement(JudgementState, Profile, Result, Citations).

% (A3) Art 4(1) with Art 4(2)(a): the point (a) test met.
risk_management_by_judgement(true, _, nis2_provisions_disapplied, Citations) :-
    implements(eu_dir_2022_2555_art_4_2_a),
    group_citations(risk_management, Citations).
% (A3) the point (a) test not met: Article 4 does not take the group away.
risk_management_by_judgement(false, _, nis2_provisions_apply, Citations) :-
    implements(eu_dir_2022_2555_art_4_2_a),
    group_citations(risk_management, Citations).
% (A4) the judgement absent.
risk_management_by_judgement(absent, _, indeterminate([dora_risk_management_measures_at_least_equivalent_in_effect]), []).
% (A5) the judgement unsure: open-textured, referred.
risk_management_by_judgement(unsure, Profile, needs_legal_review(Reason, Context), []) :-
    implements(eu_dir_2022_2555_art_4_2_a),
    referral(risk_management_equivalence_unclear, Profile, Reason, Context).

% ---- query B: nis2_incident_notification_provisions_status/3 ----------
% (B0) input problems first.
nis2_incident_notification_provisions_status(Profile, Result, Citations) :-
    nis2_lex_specialis_and_definitions_input_problems(Profile, Problems),
    incident_notification_answer(Problems, Profile, Result, Citations).

incident_notification_answer([Problem|Problems], _, input_problems([Problem|Problems]), []).
incident_notification_answer([], Profile, Result, Citations) :-
    key_state(Profile, entity_class, ClassState),
    incident_notification_by_class(ClassState, Profile, Result, Citations).

% (B1) entity_class absent: named whatever the judgements are.
incident_notification_by_class(absent, _, indeterminate([entity_class]), []).
% (B2) out_of_scope decides alone.
incident_notification_by_class(out_of_scope, _, out_of_scope, Citations) :-
    implements(eu_dir_2022_2555_art_4_1),
    group_citations(incident_notification, Citations).
% (B3)-(B6) an essential or important entity: DORA is the sector-specific act.
incident_notification_by_class(Class, Profile, Result, Citations) :-
    implements(eu_reg_2022_2554_art_1_2),
    designated_class(Class, _),
    key_state(Profile, dora_gives_immediate_access_to_incident_notifications, AccessState),
    key_state(Profile, dora_incident_notification_requirements_at_least_equivalent_in_effect, EquivalenceState),
    incident_notification_by_judgements(AccessState, EquivalenceState, Profile, Result, Citations).

% A judgement state that is not false.
not_false_state(true).
not_false_state(unsure).
not_false_state(absent).

% A judgement state that is answered and not false.
answered_not_false_state(true).
answered_not_false_state(unsure).

% (B3) point (b) joins its conditions with 'and where': a false
% condition decides alone.
incident_notification_by_judgements(false, _, _, nis2_provisions_apply, Citations) :-
    implements(eu_dir_2022_2555_art_4_2_b),
    group_citations(incident_notification, Citations).
incident_notification_by_judgements(AccessState, false, _, nis2_provisions_apply, Citations) :-
    implements(eu_dir_2022_2555_art_4_2_b),
    not_false_state(AccessState),
    group_citations(incident_notification, Citations).
% (B4) neither false: the first absent one, in root_exports order (Q8).
incident_notification_by_judgements(absent, EquivalenceState, _, indeterminate([dora_gives_immediate_access_to_incident_notifications]), []) :-
    not_false_state(EquivalenceState).
incident_notification_by_judgements(AccessState, absent, _, indeterminate([dora_incident_notification_requirements_at_least_equivalent_in_effect]), []) :-
    answered_not_false_state(AccessState).
% (B5) neither false nor absent: the first unsure one is referred.
incident_notification_by_judgements(unsure, EquivalenceState, Profile, needs_legal_review(Reason, Context), []) :-
    implements(eu_dir_2022_2555_art_4_2_b),
    answered_not_false_state(EquivalenceState),
    referral(immediate_access_to_incident_notifications_unclear, Profile, Reason, Context).
incident_notification_by_judgements(true, unsure, Profile, needs_legal_review(Reason, Context), []) :-
    implements(eu_dir_2022_2555_art_4_2_b),
    referral(incident_notification_equivalence_unclear, Profile, Reason, Context).
% (B6) both conditions of point (b) met.
incident_notification_by_judgements(true, true, _, nis2_provisions_disapplied, Citations) :-
    implements(eu_dir_2022_2555_art_4_2_b),
    group_citations(incident_notification, Citations).

% ---- facade verdict ----------------------------------------------------
% Status nis2_groups(RiskResult, NotificationResult); Citations the
% duplicate-free union of both citation lists.
decide_nis2_lex_specialis_and_definitions(Profile, nis2_lex_specialis_and_definitions_verdict(nis2_groups(RiskResult, NotificationResult), Citations)) :-
    nis2_risk_management_provisions_status(Profile, RiskResult, RiskCitations),
    nis2_incident_notification_provisions_status(Profile, NotificationResult, NotificationCitations),
    append(RiskCitations, NotificationCitations, AllCitations),
    sort(AllCitations, Citations).

% ---- projection: Status only ------------------------------------------
nis2_lex_specialis_and_definitions_status(Profile, Status) :-
    decide_nis2_lex_specialis_and_definitions(Profile, nis2_lex_specialis_and_definitions_verdict(Status, _Citations)).

% ---- checklist: one row per group of requirements ---------------------
% Each item carries its group's citation list as provenance (query #7).
nis2_lex_specialis_and_definitions_checklist(Profile, [item(risk_management_provisions, RiskResult, RiskCitations), item(incident_notification_provisions, NotificationResult, NotificationCitations)]) :-
    nis2_risk_management_provisions_status(Profile, RiskResult, _),
    nis2_incident_notification_provisions_status(Profile, NotificationResult, _),
    group_citations(risk_management, RiskCitations),
    group_citations(incident_notification, NotificationCitations).

nis2_lex_specialis_and_definitions_decision_resolvable(Profile) :-
    decide_nis2_lex_specialis_and_definitions(Profile, _Verdict).

% ---- tests -------------------------------------------------------------
test(risk_essential_true_is_disapplied) :-
    findall(Result-Citations,
            nis2_risk_management_provisions_status([attribute(entity_class, essential_entity), attribute(dora_risk_management_measures_at_least_equivalent_in_effect, true)], Result, Citations),
            Answers),
    Answers == [nis2_provisions_disapplied-[cite(eu_dir_2022_2555_art_4_1), cite(eu_dir_2022_2555_art_4_2), cite(eu_dir_2022_2555_art_4_2_a), cite(eu_reg_2022_2554_art_1_2)]].
test(risk_essential_true_is_not_apply, fail) :-
    nis2_risk_management_provisions_status([attribute(entity_class, essential_entity), attribute(dora_risk_management_measures_at_least_equivalent_in_effect, true)], nis2_provisions_apply, _).
test(risk_important_false_applies) :-
    findall(Result,
            nis2_risk_management_provisions_status([attribute(entity_class, important_entity), attribute(dora_risk_management_measures_at_least_equivalent_in_effect, false)], Result, _),
            Results),
    Results == [nis2_provisions_apply].
test(risk_class_absent_named_first) :-
    findall(Result-Citations,
            nis2_risk_management_provisions_status([attribute(dora_risk_management_measures_at_least_equivalent_in_effect, unsure)], Result, Citations),
            Answers),
    Answers == [indeterminate([entity_class])-[]].
test(risk_out_of_scope_decides_alone) :-
    findall(Result,
            nis2_risk_management_provisions_status([attribute(entity_class, out_of_scope), attribute(dora_risk_management_measures_at_least_equivalent_in_effect, unsure)], Result, _),
            Results),
    Results == [out_of_scope].
test(risk_judgement_absent) :-
    findall(Result,
            nis2_risk_management_provisions_status([attribute(entity_class, essential_entity)], Result, _),
            Results),
    Results == [indeterminate([dora_risk_management_measures_at_least_equivalent_in_effect])].
test(risk_unsure_is_referred) :-
    findall(Result-Citations,
            nis2_risk_management_provisions_status([attribute(entity_class, essential_entity), attribute(dora_gives_immediate_access_to_incident_notifications, true), attribute(dora_risk_management_measures_at_least_equivalent_in_effect, unsure)], Result, Citations),
            Answers),
    Answers == [needs_legal_review(open_textured(dora_risk_management_measures_at_least_equivalent_in_effect, cite(eu_dir_2022_2555_art_4_2_a)), [inputs_relied_on([entity_class-essential_entity, dora_risk_management_measures_at_least_equivalent_in_effect-unsure])])-[]].
test(incident_both_true_is_disapplied) :-
    findall(Result-Citations,
            nis2_incident_notification_provisions_status([attribute(entity_class, important_entity), attribute(dora_gives_immediate_access_to_incident_notifications, true), attribute(dora_incident_notification_requirements_at_least_equivalent_in_effect, true)], Result, Citations),
            Answers),
    Answers == [nis2_provisions_disapplied-[cite(eu_dir_2022_2555_art_4_1), cite(eu_dir_2022_2555_art_4_2), cite(eu_dir_2022_2555_art_4_2_b), cite(eu_reg_2022_2554_art_1_2)]].
test(incident_one_false_decides_alone) :-
    findall(Result,
            nis2_incident_notification_provisions_status([attribute(entity_class, essential_entity), attribute(dora_incident_notification_requirements_at_least_equivalent_in_effect, false)], Result, _),
            Results),
    Results == [nis2_provisions_apply].
test(incident_access_false_beside_unsure_applies) :-
    findall(Result,
            nis2_incident_notification_provisions_status([attribute(entity_class, essential_entity), attribute(dora_gives_immediate_access_to_incident_notifications, false), attribute(dora_incident_notification_requirements_at_least_equivalent_in_effect, unsure)], Result, _),
            Results),
    Results == [nis2_provisions_apply].
test(incident_both_absent_names_access) :-
    findall(Result,
            nis2_incident_notification_provisions_status([attribute(entity_class, essential_entity)], Result, _),
            Results),
    Results == [indeterminate([dora_gives_immediate_access_to_incident_notifications])].
test(incident_absent_named_before_unsure) :-
    findall(Result,
            nis2_incident_notification_provisions_status([attribute(entity_class, essential_entity), attribute(dora_gives_immediate_access_to_incident_notifications, unsure)], Result, _),
            Results),
    Results == [indeterminate([dora_incident_notification_requirements_at_least_equivalent_in_effect])].
test(incident_second_unsure_is_referred) :-
    findall(Result,
            nis2_incident_notification_provisions_status([attribute(entity_class, essential_entity), attribute(dora_gives_immediate_access_to_incident_notifications, true), attribute(dora_incident_notification_requirements_at_least_equivalent_in_effect, unsure)], Result, _),
            Results),
    Results == [needs_legal_review(open_textured(dora_incident_notification_requirements_at_least_equivalent_in_effect, cite(eu_dir_2022_2555_art_4_2_b)), [inputs_relied_on([entity_class-essential_entity, dora_gives_immediate_access_to_incident_notifications-true, dora_incident_notification_requirements_at_least_equivalent_in_effect-unsure])])].
test(incident_first_unsure_is_referred) :-
    findall(Result,
            nis2_incident_notification_provisions_status([attribute(entity_class, important_entity), attribute(dora_gives_immediate_access_to_incident_notifications, unsure), attribute(dora_incident_notification_requirements_at_least_equivalent_in_effect, unsure)], Result, _),
            Results),
    Results == [needs_legal_review(open_textured(dora_gives_immediate_access_to_incident_notifications, cite(eu_dir_2022_2555_art_4_2_b)), [inputs_relied_on([entity_class-important_entity, dora_gives_immediate_access_to_incident_notifications-unsure, dora_incident_notification_requirements_at_least_equivalent_in_effect-unsure])])].
test(incident_out_of_scope) :-
    findall(Result,
            nis2_incident_notification_provisions_status([attribute(entity_class, out_of_scope)], Result, _),
            Results),
    Results == [out_of_scope].
test(unknown_key_is_an_input_problem) :-
    findall(Result-Citations,
            nis2_risk_management_provisions_status([attribute(entity_class, essential_entity), attribute(colour, blue)], Result, Citations),
            Answers),
    Answers == [input_problems([unknown_key(colour)])-[]].
test(wrong_value_is_an_input_problem) :-
    findall(Result,
            nis2_incident_notification_provisions_status([attribute(entity_class, large)], Result, _),
            Results),
    Results == [input_problems([wrong_type(entity_class)])].
test(not_a_profile_is_an_input_problem) :-
    findall(Result,
            nis2_incident_notification_provisions_status(not_a_list, Result, _),
            Results),
    Results == [input_problems([wrong_type(profile)])].
test(facade_verdict_unions_citations) :-
    findall(Status,
            nis2_lex_specialis_and_definitions_status([attribute(entity_class, essential_entity), attribute(dora_risk_management_measures_at_least_equivalent_in_effect, true), attribute(dora_gives_immediate_access_to_incident_notifications, false)], Status),
            Statuses),
    Statuses == [nis2_groups(nis2_provisions_disapplied, nis2_provisions_apply)].
test(checklist_has_one_row_per_group) :-
    nis2_lex_specialis_and_definitions_checklist([attribute(entity_class, out_of_scope)], Items),
    Items = [item(risk_management_provisions, out_of_scope, [_|_]), item(incident_notification_provisions, out_of_scope, [_|_])].

:- end_module(nis2_lex_specialis_and_definitions).
