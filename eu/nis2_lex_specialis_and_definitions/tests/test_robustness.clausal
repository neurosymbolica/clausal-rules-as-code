% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_robustness.clausal -- ROBUSTNESS of the input check nis2_lex_specialis_and_definitions_input_problems/2 for a
% PROFILE that is an attribute list [attribute(Key, Value), ...]: an empty list, a
% value that is not a list, an unknown key and a value outside its type each get exactly
% one answer. Written by the scaffold from the order's typed input contract
% (input_contract.types.profile: attribute_list), not by the producer;
% do not edit or delete.
% Run: python -m clausal.testing eu/nis2_lex_specialis_and_definitions/tests/test_robustness.clausal
% =====================================================================
:- module(test_robustness, []).
:- use_module(eu/nis2_lex_specialis_and_definitions/queries, [nis2_lex_specialis_and_definitions_input_problems/2]).

test(an_empty_attribute_list_gets_exactly_one_answer) :-
    findall(Problems, nis2_lex_specialis_and_definitions_input_problems([], Problems), Answers),
    Answers == [[]].

test(a_profile_that_is_not_a_list_gets_one_non_empty_answer) :-
    findall(Problems, nis2_lex_specialis_and_definitions_input_problems(not_a_profile, Problems), Answers),
    Answers = [[_|_]].

test(an_unknown_key_is_named) :-
    findall(Problems, nis2_lex_specialis_and_definitions_input_problems([attribute(not_a_key_of_the_contract, essential_entity)], Problems), Answers),
    Answers = [Problems],
    memberchk(unknown_key(not_a_key_of_the_contract), Problems).

test(a_value_outside_the_type_of_entity_class_is_named) :-
    findall(Problems, nis2_lex_specialis_and_definitions_input_problems([attribute(entity_class, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(entity_class), Problems).

test(a_value_outside_the_type_of_dora_risk_management_measures_at_least_equivalent_in_effect_is_named) :-
    findall(Problems, nis2_lex_specialis_and_definitions_input_problems([attribute(dora_risk_management_measures_at_least_equivalent_in_effect, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(dora_risk_management_measures_at_least_equivalent_in_effect), Problems).

:- end_module(test_robustness).
