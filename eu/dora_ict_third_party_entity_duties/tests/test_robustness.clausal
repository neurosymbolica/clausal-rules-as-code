% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_robustness.clausal -- ROBUSTNESS of the input check dora_ict_third_party_entity_duties_input_problems/2 for a
% PROFILE that is an attribute list [attribute(Key, Value), ...]: an empty list, a
% value that is not a list, an unknown key and a value outside its type each get exactly
% one answer. Written by the scaffold from the order's typed input contract
% (input_contract.types.profile: attribute_list), not by the producer;
% do not edit or delete.
% Run: python -m clausal.testing eu/dora_ict_third_party_entity_duties/tests/test_robustness.clausal
% =====================================================================
:- module(test_robustness, []).
:- use_module(eu/dora_ict_third_party_entity_duties/queries, [dora_ict_third_party_entity_duties_input_problems/2]).

test(an_empty_attribute_list_gets_exactly_one_answer) :-
    findall(Problems, dora_ict_third_party_entity_duties_input_problems([], Problems), Answers),
    Answers == [[]].

test(a_profile_that_is_not_a_list_gets_one_non_empty_answer) :-
    findall(Problems, dora_ict_third_party_entity_duties_input_problems(not_a_profile, Problems), Answers),
    Answers = [[_|_]].

test(an_unknown_key_is_named) :-
    findall(Problems, dora_ict_third_party_entity_duties_input_problems([attribute(not_a_key_of_the_contract, true)], Problems), Answers),
    Answers = [Problems],
    memberchk(unknown_key(not_a_key_of_the_contract), Problems).

test(a_value_outside_the_type_of_assessed_whether_arrangement_supports_critical_or_important_function_is_named) :-
    findall(Problems, dora_ict_third_party_entity_duties_input_problems([attribute(assessed_whether_arrangement_supports_critical_or_important_function, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(assessed_whether_arrangement_supports_critical_or_important_function), Problems).

test(a_value_outside_the_type_of_entity_exercises_access_inspection_and_audit_rights_is_named) :-
    findall(Problems, dora_ict_third_party_entity_duties_input_problems([attribute(entity_exercises_access_inspection_and_audit_rights, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(entity_exercises_access_inspection_and_audit_rights), Problems).

:- end_module(test_robustness).
