% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% kernel.clausal -- the SHARED FLOOR for eu/dora_ict_third_party_entity_duties (deontic family).
% DAG root of the determination-slices layout. It holds ONLY the
% PREDICATES that two or more files CALL.
% Exception: the scaffold writes the order's input check
% dora_ict_third_party_entity_duties_input_problems/2 here, exported, for
% every slice (and queries.clausal) to import.
%
% Source: Regulation (EU) 2022/2554 (Digital Operational Resilience Act,
% DORA), 32022R2554, OJ L 333, 27.12.2022, p. 1 (original OJ text, pinned in
% sources/): Art 28(2), first sentence; Art 28(4), (5), (6) and (8);
% Art 29(1) and (2). The input check itself decides no statutory condition:
% it checks the PROFILE against the order's typed input contract only, so its
% clauses carry no implements/1 marker.
%
% There is ONE determination slice (dora_ict_third_party_entity_duties.clausal).
% It owns its duty table, trigger table, referral rows, citation sets and
% every private helper (the key-state classifier, the applies / open / fails
% predicates, the can-change and behind searches). Nothing single-caller
% lives here; a predicate moves here only when a SECOND file calls it.
%
% The input check walks the raw attribute list structurally (shape and type
% checking, never reading a value for the law): that is why it does not use
% formalize_lib:profile_get/3, which the slice uses for every legal read.
%
% Atoms and data terms need NO declaration and NO import. The result terms,
% recorded here so every file spells them alike:
%
%   Slice verdict (the scaffold facade, built on entity_duties_complete/3):
%     dora_ict_third_party_entity_duties_verdict(Status, Citations)
%       Status    -- complete | incomplete | indeterminate([Key])
%                    | needs_legal_review(Reason, Context) | input_problems(Problems)
%       Citations -- a list of cite(Key) terms; [] for every status compound.
%
%   Contract query RESULTs (each query yields exactly one solution):
%     entity_duties_required/3      -- required(Duties)            (final)
%     entity_duties_complete/3      -- complete | incomplete       (final)
%     entity_duties_outstanding/3   -- none_outstanding | outstanding(Duties) (final)
%     ict_third_party_strategy_required/3
%                                   -- strategy_required | strategy_not_required (final)
%     every query, not final        -- indeterminate([Key])
%                                    | needs_legal_review(open_textured(Key, cite(Citation)),
%                                                         [inputs_relied_on(Pairs)])
%                                    | input_problems(Problems)
%       Duties   -- a non-empty list of duty atoms in DUTY ORDER
%                   (assessment_of_critical_or_important_function ...
%                   assessment_of_subcontracting_chains).
%       Pairs    -- Key-Value terms, present keys the query reads, root_exports order.
%       Problems -- duplicate_key(Key) | wrong_type(Key) | unknown_key(Key) terms;
%                   [wrong_type(profile)] alone for a profile that is not an attribute list.
%   The bare atom indeterminate is NEVER written.
%
%   Checklist row (justification query #7): item(Duty, ItemStatus, cite(Key)),
%     ItemStatus met | unmet(not_performed) | unknown([Key]).
% =====================================================================

:- module(kernel, [dora_ict_third_party_entity_duties_input_problems/2]).

:- use_module(library(reif), [memberd_t/3]).

% ---- input checks: the problems a profile has, if any -----------
% dora_ict_third_party_entity_duties_input_problems(Profile, Problems): Problems = [] means the profile can be
% judged. Written from the order's typed input contract
% (input_contract.types.profile: attribute_list).
% Each public query calls this check first: it gives its normal answer only when
% Problems = [], and when Problems is not [] it gives the answer the order states for
% a profile with input problems.
% It gives exactly one answer for every Profile, and the answer is ground except for a
% Key named as given:
% - a Profile that is not an attribute list [attribute(Key, Value), ...] gives [wrong_type(profile)]:
%   an unbound Profile, a partial list, a list holding an unbound item or an item that is
%   not attribute(_, _);
% - a Key that is not an atom (a number, a string, a compound term, an unbound variable)
%   is a key outside the contract: unknown_key(Key), Key as given;
% - otherwise, for each contract key in the contract's key order, duplicate_key(Key) when
%   the key occurs more than once in Profile (whatever its values: none of them is read,
%   so it is never also wrong_type(Key)), else wrong_type(Key) when its one value is
%   outside its type; then unknown_key(Key) for each key outside the contract, in the
%   order of its first occurrence in Profile. Each key is named once. An absent key is
%   not a problem.
% Every step is complementary clauses: exactly one clause holds for each input.
dora_ict_third_party_entity_duties_input_problems(Profile, Problems) :-
    attribute_list_t(Profile, IsAttributeList),
    profile_problems(IsAttributeList, Profile, Problems).

profile_problems(false, _, [wrong_type(profile)]).
profile_problems(true, Profile, Problems) :-
    Keys = [assessed_whether_arrangement_supports_critical_or_important_function, assessed_supervisory_conditions_for_contracting, identified_and_assessed_relevant_risks, undertook_due_diligence_on_provider, identified_and_assessed_conflicts_of_interest, provider_complies_with_appropriate_information_security_standards, entity_exercises_access_inspection_and_audit_rights, audit_frequency_and_areas_predetermined, arrangement_entails_high_technical_complexity, auditor_skills_and_knowledge_verified, supports_critical_or_important_function, considered_most_up_to_date_information_security_standards, exit_strategy_in_place, able_to_exit_without_business_disruption, able_to_exit_without_limiting_regulatory_compliance, able_to_exit_without_detriment_to_client_services, exit_plans_comprehensive_documented_tested_and_reviewed, alternative_solutions_and_transition_plans_in_place, contingency_measures_in_place, considered_concentration_risk, weighed_alternative_solutions, considered_insolvency_law_and_data_recovery_constraints, arrangement_allows_further_subcontracting, weighed_subcontracting_benefits_and_risks, assessed_impact_of_subcontracting_chains, provider_established_in_third_country, considered_third_country_data_protection_and_enforcement, financial_entity_is_article_16_1_entity, financial_entity_is_microenterprise],
    unknown_keys(Profile, Keys, UnknownKeyProblems),
    key_problems(Keys, Profile, UnknownKeyProblems, Problems).

% The contract: each key and the type of its value.
key_type(assessed_whether_arrangement_supports_critical_or_important_function, judgement).
key_type(assessed_supervisory_conditions_for_contracting, judgement).
key_type(identified_and_assessed_relevant_risks, judgement).
key_type(undertook_due_diligence_on_provider, judgement).
key_type(identified_and_assessed_conflicts_of_interest, judgement).
key_type(provider_complies_with_appropriate_information_security_standards, judgement).
key_type(entity_exercises_access_inspection_and_audit_rights, fact).
key_type(audit_frequency_and_areas_predetermined, judgement).
key_type(arrangement_entails_high_technical_complexity, judgement).
key_type(auditor_skills_and_knowledge_verified, judgement).
key_type(supports_critical_or_important_function, judgement).
key_type(considered_most_up_to_date_information_security_standards, judgement).
key_type(exit_strategy_in_place, judgement).
key_type(able_to_exit_without_business_disruption, judgement).
key_type(able_to_exit_without_limiting_regulatory_compliance, judgement).
key_type(able_to_exit_without_detriment_to_client_services, judgement).
key_type(exit_plans_comprehensive_documented_tested_and_reviewed, judgement).
key_type(alternative_solutions_and_transition_plans_in_place, judgement).
key_type(contingency_measures_in_place, judgement).
key_type(considered_concentration_risk, judgement).
key_type(weighed_alternative_solutions, judgement).
key_type(considered_insolvency_law_and_data_recovery_constraints, judgement).
key_type(arrangement_allows_further_subcontracting, fact).
key_type(weighed_subcontracting_benefits_and_risks, judgement).
key_type(assessed_impact_of_subcontracting_chains, judgement).
key_type(provider_established_in_third_country, fact).
key_type(considered_third_country_data_protection_and_enforcement, judgement).
key_type(financial_entity_is_article_16_1_entity, fact).
key_type(financial_entity_is_microenterprise, fact).

% attribute_list_t(Term, T): T is true when Term is a list of attribute(Key, Value)
% items, whatever each Key is; false for anything else, an unbound Term or item included.
attribute_list_t(Term, false) :-
    var(Term).
attribute_list_t(Term, true) :-
    Term == [].
attribute_list_t(Term, T) :-
    nonvar(Term),
    Term = [Element|Elements],
    attribute_t(Element, ElementIsAttribute),
    attribute_list_t(Elements, ElementsAreAttributes),
    truth_and(ElementIsAttribute, ElementsAreAttributes, T).
attribute_list_t(Term, false) :-
    nonvar(Term),
    Term \== [],
    Term \= [_|_].

attribute_t(Element, false) :-
    var(Element).
attribute_t(Element, true) :-
    nonvar(Element),
    Element = attribute(_, _).
attribute_t(Element, false) :-
    nonvar(Element),
    Element \= attribute(_, _).

% Unknown keys, in profile order, each once: Known grows by each key named. A key is
% known when it is identical (==) to one in Known, so an unbound Key is never bound:
% the same variable twice is one unknown key, two different variables are two.
unknown_keys([], _, []).
unknown_keys([attribute(Key, _)|Elements], Known, Problems) :-
    known_t(Key, Known, IsKnown),
    name_unknown_key(IsKnown, Key, Known, Elements, Problems).

known_t(_, [], false).
known_t(Key, [Known|_], true) :-
    Known == Key.
known_t(Key, [Known|Knowns], T) :-
    Known \== Key,
    known_t(Key, Knowns, T).

name_unknown_key(true, _, Known, Elements, Problems) :-
    unknown_keys(Elements, Known, Problems).
name_unknown_key(false, Key, Known, Elements, [unknown_key(Key)|Problems]) :-
    unknown_keys(Elements, [Key|Known], Problems).

% Contract keys, in contract order: duplicate_key(Key) when the key occurs more than once
% (none of its values is read), else wrong_type(Key) when its one value is outside the
% key's type. An absent key has no value to check.
key_problems([], _, Problems, Problems).
key_problems([Key|Keys], Profile, LaterProblems, Problems) :-
    key_type(Key, Type),
    key_occurrences(Profile, Key, Occurrences),
    key_problems(Keys, Profile, LaterProblems, KeyProblems),
    name_key_problem(Occurrences, Key, Type, Profile, KeyProblems, Problems).

% key_occurrences(Elements, Key, Occurrences): none, one or many items give Key.
key_occurrences([], _, none).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey == Key,
    key_occurrences(Elements, Key, RestOccurrences),
    one_more_occurrence(RestOccurrences, Occurrences).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey \== Key,
    key_occurrences(Elements, Key, Occurrences).

one_more_occurrence(none, one).
one_more_occurrence(one, many).
one_more_occurrence(many, many).

name_key_problem(none, _, _, _, Problems, Problems).
name_key_problem(many, Key, _, _, Problems, [duplicate_key(Key)|Problems]).
name_key_problem(one, Key, Type, Profile, KeyProblems, Problems) :-
    values_in_type_t(Profile, Key, Type, InType),
    name_wrong_type(InType, Key, KeyProblems, Problems).

name_wrong_type(true, _, Problems, Problems).
name_wrong_type(false, Key, Problems, [wrong_type(Key)|Problems]).

% values_in_type_t(Elements, Key, Type, T): T is true when every value Elements gives Key is
% in Type (true when Elements gives Key none).
values_in_type_t([], _, _, true).
values_in_type_t([attribute(ElementKey, Value)|Elements], Key, Type, T) :-
    ElementKey == Key,
    value_in_type_t(Type, Value, ValueInType),
    values_in_type_t(Elements, Key, Type, RestInType),
    truth_and(ValueInType, RestInType, T).
values_in_type_t([attribute(ElementKey, _)|Elements], Key, Type, T) :-
    ElementKey \== Key,
    values_in_type_t(Elements, Key, Type, T).

% A value with an unbound part is outside every type; a ground one is checked.
value_in_type_t(Type, Value, T) :-
    term_variables(Value, Variables),
    ground_value_in_type_t(Variables, Type, Value, T).

ground_value_in_type_t([_|_], _, _, false).
ground_value_in_type_t([], Type, Value, T) :-
    in_type_t(Type, Value, T).

% in_type_t(Type, Value, T): one clause per type, for a ground Value.
in_type_t(judgement, Value, T) :-
    in_type_t(one_of([boolean, enum([unsure])]), Value, T).

in_type_t(fact, Value, T) :-
    in_type_t(boolean, Value, T).

in_type_t(boolean, Value, T) :-
    memberd_t(Value, [true, false], T).

in_type_t(enum(Values), Value, T) :-
    memberd_t(Value, Values, T).

in_type_t(one_of(Types), Value, T) :-
    in_some_type_t(Types, Value, T).

truth_and(true, T, T).
truth_and(false, _, false).

% in_some_type_t(Types, Value, T): T is true when Value is in at least one of Types.
in_some_type_t([], _, false).
in_some_type_t([Type|Types], Value, T) :-
    in_type_t(Type, Value, InType),
    in_some_type_t(Types, Value, InAnother),
    truth_or(InType, InAnother, T).

truth_or(true, _, true).
truth_or(false, T, T).

:- end_module(kernel).
