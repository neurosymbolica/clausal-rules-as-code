% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for eu/dora_ict_third_party_entity_duties.
%
% Instrument: Regulation (EU) 2022/2554 of the European Parliament and of
% the Council of 14 December 2022 on digital operational resilience for the
% financial sector (DORA), CELEX 32022R2554, OJ L 333, 27.12.2022, p. 1.
% The original OJ text as published is pinned in sources/; no consolidated
% version is pinned. Each verbatim below is an exact substring of the
% pinned unit named in its ref.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
%
% Key scheme: the CANONICAL lexicon keys (_lexicon/citations.yaml),
% eu_reg_2022_2554_art_<article>_<paragraph>[_<point>]. The segments reg and
% art are lexicon-mandated and are never renamed.
% lint: C6 segments reg and art are fixed by the canonical citation lexicon
%
% Keys returned in results (citation_vocabulary): Art 28(2), Art 28(4) and
% points (a) to (e), Art 28(5), Art 28(6), Art 28(8) and points (a) to (c),
% Art 29(1) and points (a) and (b), Art 29(2).
% Recorded but never returned in a result: Art 28(1)(b) (proportionality,
% reading (9): governs how a duty is performed, removes none).
%
% PROVENANCE: every operative clause opens its body with implements(Key),
% Key one recorded here. implements/1 succeeds for every recorded key and
% fails for any other, so a misspelt key never lies.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

implements(Key) :-
    citation(Key, _).

citation(eu_reg_2022_2554_art_28_1_b, [label-'Regulation (EU) 2022/2554 (DORA) Art 28(1)(b) (principle of proportionality in the management of ICT third-party risk)', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj (32022R2554, OJ L 333, 27.12.2022, p. 1), unit 32022R2554#point_028.001_b', verbatim-'shall be implemented in light of the principle of proportionality']).

citation(eu_reg_2022_2554_art_28_2, [label-'Regulation (EU) 2022/2554 (DORA) Art 28(2), first sentence (strategy on ICT third-party risk; exemptions for Article 16(1) entities and microenterprises)', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj (32022R2554, OJ L 333, 27.12.2022, p. 1), unit 32022R2554#parag_028.002', verbatim-'financial entities, other than entities referred to in Article 16(1), first subparagraph, and other than microenterprises, shall adopt, and regularly review, a strategy on ICT third-party risk']).

citation(eu_reg_2022_2554_art_28_4, [label-'Regulation (EU) 2022/2554 (DORA) Art 28(4), lead words (assessments before entering into a contractual arrangement on the use of ICT services)', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj (32022R2554, OJ L 333, 27.12.2022, p. 1), unit 32022R2554#parag_028.004', verbatim-'Before entering into a contractual arrangement on the use of ICT services, financial entities shall:']).

citation(eu_reg_2022_2554_art_28_4_a, [label-'Regulation (EU) 2022/2554 (DORA) Art 28(4)(a) (assess whether the arrangement covers ICT services supporting a critical or important function)', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj (32022R2554, OJ L 333, 27.12.2022, p. 1), unit 32022R2554#point_028.004_a', verbatim-'assess whether the contractual arrangement covers the use of ICT services supporting a critical or important function']).

citation(eu_reg_2022_2554_art_28_4_b, [label-'Regulation (EU) 2022/2554 (DORA) Art 28(4)(b) (assess if supervisory conditions for contracting are met)', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj (32022R2554, OJ L 333, 27.12.2022, p. 1), unit 32022R2554#point_028.004_b', verbatim-'assess if supervisory conditions for contracting are met']).

citation(eu_reg_2022_2554_art_28_4_c, [label-'Regulation (EU) 2022/2554 (DORA) Art 28(4)(c) (identify and assess all relevant risks, including ICT concentration risk)', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj (32022R2554, OJ L 333, 27.12.2022, p. 1), unit 32022R2554#point_028.004_c', verbatim-'identify and assess all relevant risks in relation to the contractual arrangement, including the possibility that such contractual arrangement may contribute to reinforcing ICT concentration risk as referred to in Article 29']).

citation(eu_reg_2022_2554_art_28_4_d, [label-'Regulation (EU) 2022/2554 (DORA) Art 28(4)(d) (due diligence on prospective ICT third-party service providers)', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj (32022R2554, OJ L 333, 27.12.2022, p. 1), unit 32022R2554#point_028.004_d', verbatim-'undertake all due diligence on prospective ICT third-party service providers and ensure throughout the selection and assessment processes that the ICT third-party service provider is suitable']).

citation(eu_reg_2022_2554_art_28_4_e, [label-'Regulation (EU) 2022/2554 (DORA) Art 28(4)(e) (identify and assess conflicts of interest)', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj (32022R2554, OJ L 333, 27.12.2022, p. 1), unit 32022R2554#point_028.004_e', verbatim-'identify and assess conflicts of interest that the contractual arrangement may cause']).

citation(eu_reg_2022_2554_art_28_5, [label-'Regulation (EU) 2022/2554 (DORA) Art 28(5) (information security standards of the ICT third-party service provider; first and second sentences)', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj (32022R2554, OJ L 333, 27.12.2022, p. 1), unit 32022R2554#parag_028.005', verbatim-'Financial entities may only enter into contractual arrangements with ICT third-party service providers that comply with appropriate information security standards.']).

citation(eu_reg_2022_2554_art_28_6, [label-'Regulation (EU) 2022/2554 (DORA) Art 28(6) (exercise of access, inspection and audit rights; auditor skills where high technical complexity)', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj (32022R2554, OJ L 333, 27.12.2022, p. 1), unit 32022R2554#parag_028.006', verbatim-'In exercising access, inspection and audit rights over the ICT third-party service provider, financial entities shall, on the basis of a risk-based approach, pre-determine the frequency of audits and inspections as well as the areas to be audited']).

citation(eu_reg_2022_2554_art_28_8, [label-'Regulation (EU) 2022/2554 (DORA) Art 28(8) (exit strategies, exit plans, alternative solutions, transition plans and contingency measures for ICT services supporting critical or important functions)', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj (32022R2554, OJ L 333, 27.12.2022, p. 1), unit 32022R2554#parag_028.008', verbatim-'For ICT services supporting critical or important functions, financial entities shall put in place exit strategies.']).

citation(eu_reg_2022_2554_art_28_8_a, [label-'Regulation (EU) 2022/2554 (DORA) Art 28(8), third sentence with point (a) (exit without disruption to business activities)', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj (32022R2554, OJ L 333, 27.12.2022, p. 1), unit 32022R2554#point_028.008_a', verbatim-'disruption to their business activities']).

citation(eu_reg_2022_2554_art_28_8_b, [label-'Regulation (EU) 2022/2554 (DORA) Art 28(8), third sentence with point (b) (exit without limiting compliance with regulatory requirements)', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj (32022R2554, OJ L 333, 27.12.2022, p. 1), unit 32022R2554#point_028.008_b', verbatim-'limiting compliance with regulatory requirements']).

citation(eu_reg_2022_2554_art_28_8_c, [label-'Regulation (EU) 2022/2554 (DORA) Art 28(8), third sentence with point (c) (exit without detriment to the continuity and quality of services provided to clients)', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj (32022R2554, OJ L 333, 27.12.2022, p. 1), unit 32022R2554#point_028.008_c', verbatim-'detriment to the continuity and quality of services provided to clients']).

citation(eu_reg_2022_2554_art_29_1, [label-'Regulation (EU) 2022/2554 (DORA) Art 29(1) (preliminary assessment of ICT concentration risk; weighing of alternative solutions)', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj (32022R2554, OJ L 333, 27.12.2022, p. 1), unit 32022R2554#parag_029.001', verbatim-'When performing the identification and assessment of risks referred to in Article 28(4), point (c), financial entities shall also take into account whether the envisaged conclusion of a contractual arrangement in relation to ICT services supporting critical or important functions would lead to any of the following:']).

citation(eu_reg_2022_2554_art_29_1_a, [label-'Regulation (EU) 2022/2554 (DORA) Art 29(1)(a) (ICT third-party service provider that is not easily substitutable)', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj (32022R2554, OJ L 333, 27.12.2022, p. 1), unit 32022R2554#point_029.001_a', verbatim-'contracting an ICT third-party service provider that is not easily substitutable']).

citation(eu_reg_2022_2554_art_29_1_b, [label-'Regulation (EU) 2022/2554 (DORA) Art 29(1)(b) (multiple arrangements with the same or closely connected ICT third-party service providers)', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj (32022R2554, OJ L 333, 27.12.2022, p. 1), unit 32022R2554#point_029.001_b', verbatim-'having in place multiple contractual arrangements in relation to the provision of ICT services supporting critical or important functions with the same ICT third-party service provider or with closely connected ICT third-party service providers']).

citation(eu_reg_2022_2554_art_29_2, [label-'Regulation (EU) 2022/2554 (DORA) Art 29(2) (subcontracting, insolvency law and data recovery, third-country providers, chains of subcontracting)', ref-'https://eur-lex.europa.eu/eli/reg/2022/2554/oj (32022R2554, OJ L 333, 27.12.2022, p. 1), unit 32022R2554#parag_029.002', verbatim-'financial entities shall weigh benefits and risks that may arise in connection with such subcontracting, in particular in the case of an ICT subcontractor established in a third-country']).

:- end_module(citations).
