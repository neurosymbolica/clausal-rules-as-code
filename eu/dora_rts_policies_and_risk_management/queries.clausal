    inputs_relied_on/1,
    provenance/2,
    input_problems/1,
    unknown_key/1,
    wrong_type/1,
    duplicate_key/1,
    risk_profile_and_complexity_consideration/0,
    embedding_of_security_policies/0,
    network_security/0,
    intrusion_and_data_misuse_safeguards/0,
    data_availability_authenticity_integrity_and_confidentiality/0,
    accurate_and_prompt_data_transmission/0,
    alignment_to_information_security_objectives/0,
    indication_of_approval_date/0,
    implementation_and_exception_indicators/0,
    staff_security_responsibilities/0,
    consequences_of_non_compliance/0,
    documentation_list/0,
    segregation_of_duties/0,
    leading_practices_and_standards/0,
    roles_for_security_policies/0,
    review_of_security_policies/0,
    material_changes/0,
    ict_risk_management_policies_and_procedures/0,
    risk_tolerance_approval/0,
    risk_assessment_procedure_and_methodology/0,
    risk_treatment_procedure/0,
    residual_risk_provisions/0,
    risk_monitoring_provisions/0,
    strategy_change_process/0,
    monitoring_of_treatment_effectiveness/0,
    assessment_of_risk_tolerance_attainment/0,
    assessment_of_corrective_actions/0,
    financial_entity_is_article_16_1_entity/0,
    size_risk_profile_and_complexity_taken_into_account/0,
    ict_security_policies_embedded_in_ict_risk_management_framework/0,
    security_policies_ensure_security_of_networks/0,
    security_policies_contain_safeguards_against_intrusions_and_data_misuse/0,
    security_policies_preserve_availability_authenticity_integrity_and_confidentiality_of_data/0,
    security_policies_guarantee_accurate_and_prompt_data_transmission/0,
    security_policies_aligned_to_information_security_objectives/0,
    security_policies_indicate_date_of_management_body_approval/0,
    security_policies_contain_indicators_and_measures_for_implementation_and_exceptions/0,
    security_policies_specify_staff_responsibilities_for_ict_security/0,
    security_policies_specify_consequences_of_staff_non_compliance/0,
    security_policies_list_documentation_to_be_maintained/0,
    security_policies_specify_segregation_of_duties_arrangements/0,
    security_policies_consider_leading_practices_and_standards/0,
    security_policies_identify_roles_for_development_implementation_and_maintenance/0,
    security_policies_reviewed_in_accordance_with_article_6_5/0,
    security_policies_take_material_changes_into_account/0,
    ict_risk_management_policies_and_procedures_developed_documented_and_implemented/0,
    risk_management_policies_indicate_approval_of_risk_tolerance_level/0,
    risk_management_policies_contain_risk_assessment_procedure_and_methodology/0,
    risk_management_policies_contain_risk_treatment_procedure/0,
    risk_management_policies_contain_residual_risk_provisions/0,
    risk_management_policies_contain_risk_monitoring_provisions/0,
    risk_management_policies_contain_process_for_strategy_changes/0,
    risk_treatment_procedure_ensures_monitoring_of_treatment_effectiveness/0,
    risk_treatment_procedure_ensures_assessment_of_risk_tolerance_attainment/0,
    risk_treatment_procedure_ensures_assessment_of_corrective_actions/0
]).

:- use_module(formalize_lib, [profile_get/3, profile_lacks/2]).
:- use_module(library(reif), [if_/3]).
:- use_module(eu/dora_rts_policies_and_risk_management/kernel, [dora_rts_policies_and_risk_management_input_problems/2]).
:- use_module(eu/dora_rts_policies_and_risk_management/dora_rts_policies_and_risk_management, [
    dora_rts_policies_and_risk_management_status/2,
    dora_rts_policies_and_risk_management_checklist/2,
    rts_policies_and_risk_management_duties_required/3,
    rts_policies_and_risk_management_duties_complete/3
]).

% ---- root exports: result constructors (data: no clauses) ------------
:- constructors([
    required(duties),
    outstanding(duties),
    indeterminate(missing_keys),
    needs_legal_review(reason, context),
    open_textured(key, citation),
    inputs_relied_on(pairs),
    provenance(clause, citations),
    input_problems(problems),
    unknown_key(key),
    wrong_type(key),
    duplicate_key(key)
]).

