# Shared VALUE vocabulary — ISO-3166-1 alpha-3 country codes as language-neutral atoms.
# The atom is the lowercase alpha-3 code (the international standard identifier); human/
# multilingual names live in the translation layer. AND (Andorra) -> and_ (Python/Clausal keyword).
# Data source: pycountry 26.2.16 (Debian iso-codes database). 249 assigned codes.
# Generated 2026-07-06 by /tmp/gen_country.py — do NOT hand-edit; regenerate from pycountry.
# eu_member_state/1 — 27 EU members as of 2026-07-06 (EU membership is time-varying; update with
# pycountry regen when membership changes). Added because 3+ domains need EU membership checks.
# Use: -import_from(country, [usa, gbr, deu, ...]) + -import_module(country); ref country.usa.
-module(country, [
    # Derived predicate (import via -import_from(country, [eu_member_state])):
    eu_member_state(COUNTRY),
    abw, afg, ago, aia, ala, alb, and_, are, arg, arm,
    asm, ata, atf, atg, aus, aut, aze, bdi, bel, ben,
    bes, bfa, bgd, bgr, bhr, bhs, bih, blm, blr, blz,
    bmu, bol, bra, brb, brn, btn, bvt, bwa, caf, can,
    cck, che, chl, chn, civ, cmr, cod, cog, cok, col,
    com, cpv, cri, cub, cuw, cxr, cym, cyp, cze, deu,
    dji, dma, dnk, dom, dza, ecu, egy, eri, esh, esp,
    est, eth, fin, fji, flk, fra, fro, fsm, gab, gbr,
    geo, ggy, gha, gib, gin, glp, gmb, gnb, gnq, grc,
    grd, grl, gtm, guf, gum, guy, hkg, hmd, hnd, hrv,
    hti, hun, idn, imn, ind, iot, irl, irn, irq, isl,
    isr, ita, jam, jey, jor, jpn, kaz, ken, kgz, khm,
    kir, kna, kor, kwt, lao, lbn, lbr, lby, lca, lie,
    lka, lso, ltu, lux, lva, mac, maf, mar, mco, mda,
    mdg, mdv, mex, mhl, mkd, mli, mlt, mmr, mne, mng,
    mnp, moz, mrt, msr, mtq, mus, mwi, mys, myt, nam,
    ncl, ner, nfk, nga, nic, niu, nld, nor, npl, nru,
    nzl, omn, pak, pan, pcn, per, phl, plw, png, pol,
    pri, prk, prt, pry, pse, pyf, qat, reu, rou, rus,
    rwa, sau, sdn, sen, sgp, sgs, shn, sjm, slb, sle,
    slv, smr, som, spm, srb, ssd, stp, sur, svk, svn,
    swe, swz, sxm, syc, syr, tca, tcd, tgo, tha, tjk,
    tkl, tkm, tls, ton, tto, tun, tur, tuv, twn, tza,
    uga, ukr, umi, ury, usa, uzb, vat, vct, ven, vgb,
    vir, vnm, vut, wlf, wsm, yem, zaf, zmb, zwe
])
-double_quotes(chars)

# Derived value-set predicates — trailing-comma form is Clausal's fact-assertion syntax.
# (only where 3+ domains need them — see kit/MODULES.yaml rationale)
eu_member_state(aut),
eu_member_state(bel),
eu_member_state(bgr),
eu_member_state(cyp),
eu_member_state(cze),
eu_member_state(deu),
eu_member_state(dnk),
eu_member_state(esp),
eu_member_state(est),
eu_member_state(fin),
eu_member_state(fra),
eu_member_state(grc),
eu_member_state(hrv),
eu_member_state(hun),
eu_member_state(irl),
eu_member_state(ita),
eu_member_state(ltu),
eu_member_state(lux),
eu_member_state(lva),
eu_member_state(mlt),
eu_member_state(nld),
eu_member_state(pol),
