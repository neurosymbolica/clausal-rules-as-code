# Shared VALUE vocabulary — EN 16931 / UBL VAT category codes as language-neutral atoms.
# Domains: -import_from(vat_category, [standard, ...]) + -import_module(vat_category), then
# reference vat_category.standard (qualified). Verbatim/translated labels live in translation.
-module(vat_category, [standard, zero_rated, exempt, reverse_charge, intra_community, export, out_of_scope])
-double_quotes(chars)
