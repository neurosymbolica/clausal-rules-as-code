% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for ch/swiss_fadp_s2_information_duties_and_dpia.
%
% Sources (pinned units, cut on 2026-11-15):
%   - DSG (Bundesgesetz ueber den Datenschutz), SR 235.1, German text,
%     fedlex consolidation Stand 7 July 2025, Akoma Ntoso, units
%     ch-fadp-sr-235-1-2025-07-07#art_19 .. #art_22. The German text is
%     authoritative.
%   - Regulation (EU) 2016/679 (GDPR), Formex consolidation
%     02016R0679-20160504, extracts of Articles 13, 14, 22 and 35.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order. Every
% verbatim below is an exact substring of the pinned unit text; where a
% unit contains a cross-reference to another article (which the Akoma
% Ntoso source may mark up), the verbatim stops before the reference.
%
% Keys are the canonical lexicon keys (_lexicon/citations.yaml). Lead-in
% keys (for example ch_fadp_art_19_2, ch_fadp_art_20_1) anchor the list
% introduction of their paragraph.
%
% Deferred units, recorded here only as a note and NEVER cited by an
% answer: DSG art_19/para_5 (timing), DSG art_22/para_3 (content of the
% impact assessment), GDPR Art 22(2)-(4). Provisions referred to but not
% pinned (DSG Arts 5, 11, 13, 16, 17, 27; Art 30(2) VwVG; GDPR Arts 4, 6,
% 9, 10, 23) are judged by the caller through the profile keys; no rule
% of this order decides them, so they carry no key.
%
% PROVENANCE: every operative clause opens its body with implements(Key).
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

implements(Key) :-
    citation(Key, _).

% ---- DSG Art 19: duty to inform on collection -----------------------

citation(ch_fadp_art_19_1, [label-'DSG (SR 235.1) Art 19 Abs 1 (duty to inform the data subject of the collection of personal data)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_19 (unit ch-fadp-sr-235-1-2025-07-07#art_19/para_1)', verbatim-'Der Verantwortliche informiert die betroffene Person angemessen über die Beschaffung von Personendaten; diese Informationspflicht gilt auch, wenn die Daten nicht bei der betroffenen Person beschafft werden.']).

citation(ch_fadp_art_19_2, [label-'DSG (SR 235.1) Art 19 Abs 2 lead-in (information needed, at least the minimum items)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_19 (unit ch-fadp-sr-235-1-2025-07-07#art_19/para_2/listintro)', verbatim-'Er teilt der betroffenen Person bei der Beschaffung diejenigen Informationen mit, die erforderlich sind, damit sie ihre Rechte nach diesem Gesetz geltend machen kann und eine transparente Datenbearbeitung gewährleistet ist; er teilt ihr mindestens mit:']).

citation(ch_fadp_art_19_2_a, [label-'DSG (SR 235.1) Art 19 Abs 2 Bst a (identity and contact details of the controller)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_19 (unit ch-fadp-sr-235-1-2025-07-07#art_19/para_2/lbl_a)', verbatim-'die Identität und die Kontaktdaten des Verantwortlichen;']).

citation(ch_fadp_art_19_2_b, [label-'DSG (SR 235.1) Art 19 Abs 2 Bst b (purpose of the processing)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_19 (unit ch-fadp-sr-235-1-2025-07-07#art_19/para_2/lbl_b)', verbatim-'den Bearbeitungszweck;']).

citation(ch_fadp_art_19_2_c, [label-'DSG (SR 235.1) Art 19 Abs 2 Bst c (recipients or categories of recipients, where applicable)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_19 (unit ch-fadp-sr-235-1-2025-07-07#art_19/para_2/lbl_c)', verbatim-'gegebenenfalls die Empfängerinnen und Empfänger oder die Kategorien von Empfängerinnen und Empfängern, denen Personendaten bekanntgegeben werden.']).

citation(ch_fadp_art_19_3, [label-'DSG (SR 235.1) Art 19 Abs 3 (categories of personal data where not collected from the data subject)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_19 (unit ch-fadp-sr-235-1-2025-07-07#art_19/para_3)', verbatim-'Werden die Daten nicht bei der betroffenen Person beschafft, so teilt er ihr zudem die Kategorien der bearbeiteten Personendaten mit.']).

citation(ch_fadp_art_19_4, [label-'DSG (SR 235.1) Art 19 Abs 4 (State or international body, and safeguards or exception, on disclosure abroad)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_19 (unit ch-fadp-sr-235-1-2025-07-07#art_19/para_4)', verbatim-'Werden die Personendaten ins Ausland bekanntgegeben, so teilt er der betroffenen Person auch den Staat oder das internationale Organ und gegebenenfalls die Garantien nach']).

% ---- DSG Art 20: exceptions and restrictions ------------------------

citation(ch_fadp_art_20_1, [label-'DSG (SR 235.1) Art 20 Abs 1 lead-in (the duty to inform falls away)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_20 (unit ch-fadp-sr-235-1-2025-07-07#art_20/para_1/listintro)', verbatim-'entfällt, wenn eine der folgenden Voraussetzungen erfüllt ist:']).

citation(ch_fadp_art_20_1_a, [label-'DSG (SR 235.1) Art 20 Abs 1 Bst a (data subject already has the information)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_20 (unit ch-fadp-sr-235-1-2025-07-07#art_20/para_1/lbl_a)', verbatim-'Die betroffene Person verfügt bereits über die entsprechenden Informationen.']).

citation(ch_fadp_art_20_1_b, [label-'DSG (SR 235.1) Art 20 Abs 1 Bst b (processing provided for by law)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_20 (unit ch-fadp-sr-235-1-2025-07-07#art_20/para_1/lbl_b)', verbatim-'Die Bearbeitung ist gesetzlich vorgesehen.']).

citation(ch_fadp_art_20_1_c, [label-'DSG (SR 235.1) Art 20 Abs 1 Bst c (private controller bound by law to secrecy)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_20 (unit ch-fadp-sr-235-1-2025-07-07#art_20/para_1/lbl_c)', verbatim-'Es handelt sich beim Verantwortlichen um eine private Person, die gesetzlich zur Geheimhaltung verpflichtet ist.']).

citation(ch_fadp_art_20_1_d, [label-'DSG (SR 235.1) Art 20 Abs 1 Bst d (conditions of Art 27 met)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_20 (unit ch-fadp-sr-235-1-2025-07-07#art_20/para_1/lbl_d)', verbatim-'Die Voraussetzungen nach']).

citation(ch_fadp_art_20_2, [label-'DSG (SR 235.1) Art 20 Abs 2 lead-in (further exceptions where data not collected from the data subject)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_20 (unit ch-fadp-sr-235-1-2025-07-07#art_20/para_2/listintro)', verbatim-'Werden die Personendaten nicht bei der betroffenen Person beschafft, so entfällt die Informationspflicht zudem, wenn eine der folgenden Voraussetzungen erfüllt ist:']).

citation(ch_fadp_art_20_2_a, [label-'DSG (SR 235.1) Art 20 Abs 2 Bst a (informing not possible)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_20 (unit ch-fadp-sr-235-1-2025-07-07#art_20/para_2/lbl_a)', verbatim-'Die Information ist nicht möglich.']).

citation(ch_fadp_art_20_2_b, [label-'DSG (SR 235.1) Art 20 Abs 2 Bst b (informing requires disproportionate effort)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_20 (unit ch-fadp-sr-235-1-2025-07-07#art_20/para_2/lbl_b)', verbatim-'Die Information erfordert einen unverhältnismässigen Aufwand.']).

citation(ch_fadp_art_20_3, [label-'DSG (SR 235.1) Art 20 Abs 3 lead-in (controller may restrict, defer or dispense with the information)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_20 (unit ch-fadp-sr-235-1-2025-07-07#art_20/para_3/listintro)', verbatim-'Der Verantwortliche kann die Mitteilung der Informationen in den folgenden Fällen einschränken, aufschieben oder darauf verzichten:']).

citation(ch_fadp_art_20_3_a, [label-'DSG (SR 235.1) Art 20 Abs 3 Bst a (overriding interests of third parties)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_20 (unit ch-fadp-sr-235-1-2025-07-07#art_20/para_3/lbl_a)', verbatim-'Überwiegende Interessen Dritter erfordern die Massnahme.']).

citation(ch_fadp_art_20_3_b, [label-'DSG (SR 235.1) Art 20 Abs 3 Bst b (information defeats the purpose of the processing)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_20 (unit ch-fadp-sr-235-1-2025-07-07#art_20/para_3/lbl_b)', verbatim-'Die Information vereitelt den Zweck der Bearbeitung.']).

citation(ch_fadp_art_20_3_c, [label-'DSG (SR 235.1) Art 20 Abs 3 Bst c lead-in (private controller, both conditions met)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_20 (unit ch-fadp-sr-235-1-2025-07-07#art_20/para_3/lbl_c/listintro)', verbatim-'Der Verantwortliche ist eine private Person und die folgenden Voraussetzungen sind erfüllt:']).

citation(ch_fadp_art_20_3_c_1, [label-'DSG (SR 235.1) Art 20 Abs 3 Bst c Ziff 1 (overriding interests of the controller)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_20 (unit ch-fadp-sr-235-1-2025-07-07#art_20/para_3/lbl_c/lbl_1)', verbatim-'Überwiegende Interessen des Verantwortlichen erfordern die Massnahme.']).

citation(ch_fadp_art_20_3_c_2, [label-'DSG (SR 235.1) Art 20 Abs 3 Bst c Ziff 2 (controller does not disclose to third parties)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_20 (unit ch-fadp-sr-235-1-2025-07-07#art_20/para_3/lbl_c/lbl_2)', verbatim-'Der Verantwortliche gibt die Personendaten nicht Dritten bekannt.']).

citation(ch_fadp_art_20_3_d, [label-'DSG (SR 235.1) Art 20 Abs 3 Bst d lead-in (federal body, one condition met)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_20 (unit ch-fadp-sr-235-1-2025-07-07#art_20/para_3/lbl_d/listintro)', verbatim-'Der Verantwortliche ist ein Bundesorgan und eine der folgenden Voraussetzungen ist erfüllt:']).

citation(ch_fadp_art_20_3_d_1, [label-'DSG (SR 235.1) Art 20 Abs 3 Bst d Ziff 1 (overriding public interests)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_20 (unit ch-fadp-sr-235-1-2025-07-07#art_20/para_3/lbl_d/lbl_1)', verbatim-'Die Massnahme ist wegen überwiegender öffentlicher Interessen, insbesondere der inneren oder der äusseren Sicherheit der Schweiz, erforderlich.']).

citation(ch_fadp_art_20_3_d_2, [label-'DSG (SR 235.1) Art 20 Abs 3 Bst d Ziff 2 (information may endanger an inquiry, investigation or proceedings)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_20 (unit ch-fadp-sr-235-1-2025-07-07#art_20/para_3/lbl_d/lbl_2)', verbatim-'Die Mitteilung der Information kann eine Ermittlung, eine Untersuchung oder ein behördliches oder gerichtliches Verfahren gefährden.']).

citation(ch_fadp_art_20_4, [label-'DSG (SR 235.1) Art 20 Abs 4 (undertakings of the same group are not third parties)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_20 (unit ch-fadp-sr-235-1-2025-07-07#art_20/para_4)', verbatim-'Unternehmen, die zum selben Konzern gehören, gelten nicht als Dritte im Sinne von']).

% ---- DSG Art 21: automated individual decision ----------------------

citation(ch_fadp_art_21_1, [label-'DSG (SR 235.1) Art 21 Abs 1 (duty to inform of an automated individual decision; definition)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_21 (unit ch-fadp-sr-235-1-2025-07-07#art_21/para_1)', verbatim-'Der Verantwortliche informiert die betroffene Person über eine Entscheidung, die ausschliesslich auf einer automatisierten Bearbeitung beruht und die für sie mit einer Rechtsfolge verbunden ist oder sie erheblich beeinträchtigt (automatisierte Einzelentscheidung).']).

citation(ch_fadp_art_21_2, [label-'DSG (SR 235.1) Art 21 Abs 2 (stating a point of view and review by a natural person)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_21 (unit ch-fadp-sr-235-1-2025-07-07#art_21/para_2)', verbatim-'Er gibt der betroffenen Person auf Antrag die Möglichkeit, ihren Standpunkt darzulegen. Die betroffene Person kann verlangen, dass die automatisierte Einzelentscheidung von einer natürlichen Person überprüft wird.']).

citation(ch_fadp_art_21_3, [label-'DSG (SR 235.1) Art 21 Abs 3 lead-in (paragraphs 1 and 2 do not apply)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_21 (unit ch-fadp-sr-235-1-2025-07-07#art_21/para_3/listintro)', verbatim-'gelten nicht, wenn:']).

citation(ch_fadp_art_21_3_a, [label-'DSG (SR 235.1) Art 21 Abs 3 Bst a (contract-related decision granting the data subject''s request)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_21 (unit ch-fadp-sr-235-1-2025-07-07#art_21/para_3/lbl_a)', verbatim-'die automatisierte Einzelentscheidung in unmittelbarem Zusammenhang mit dem Abschluss oder der Abwicklung eines Vertrags zwischen dem Verantwortlichen und der betroffenen Person steht und ihrem Begehren stattgegeben wird; oder']).

citation(ch_fadp_art_21_3_b, [label-'DSG (SR 235.1) Art 21 Abs 3 Bst b (express consent to the automated decision)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_21 (unit ch-fadp-sr-235-1-2025-07-07#art_21/para_3/lbl_b)', verbatim-'die betroffene Person ausdrücklich eingewilligt hat, dass die Entscheidung automatisiert erfolgt.']).

citation(ch_fadp_art_21_4, [label-'DSG (SR 235.1) Art 21 Abs 4 (marking by a federal body; no hearing required)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_21 (unit ch-fadp-sr-235-1-2025-07-07#art_21/para_4)', verbatim-'Ergeht die automatisierte Einzelentscheidung durch ein Bundesorgan, so muss es die Entscheidung entsprechend kennzeichnen.']).

% ---- DSG Art 22: data protection impact assessment ------------------

citation(ch_fadp_art_22_1, [label-'DSG (SR 235.1) Art 22 Abs 1 (impact assessment where processing may entail a high risk)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_22 (unit ch-fadp-sr-235-1-2025-07-07#art_22/para_1)', verbatim-'Der Verantwortliche erstellt vorgängig eine Datenschutz-Folgenabschätzung, wenn eine Bearbeitung ein hohes Risiko für die Persönlichkeit oder die Grundrechte der betroffenen Person mit sich bringen kann.']).

citation(ch_fadp_art_22_2, [label-'DSG (SR 235.1) Art 22 Abs 2 lead-in (where the high risk results from; cases in particular)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_22 (unit ch-fadp-sr-235-1-2025-07-07#art_22/para_2/listintro)', verbatim-'Das hohe Risiko ergibt sich, insbesondere bei Verwendung neuer Technologien, aus der Art, dem Umfang, den Umständen und dem Zweck der Bearbeitung. Es liegt namentlich vor:']).

citation(ch_fadp_art_22_2_a, [label-'DSG (SR 235.1) Art 22 Abs 2 Bst a (large-scale processing of sensitive personal data)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_22 (unit ch-fadp-sr-235-1-2025-07-07#art_22/para_2/lbl_a)', verbatim-'bei der umfangreichen Bearbeitung besonders schützenswerter Personendaten;']).

citation(ch_fadp_art_22_2_b, [label-'DSG (SR 235.1) Art 22 Abs 2 Bst b (systematic monitoring of large public areas)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_22 (unit ch-fadp-sr-235-1-2025-07-07#art_22/para_2/lbl_b)', verbatim-'wenn systematisch umfangreiche öffentliche Bereiche überwacht werden.']).

citation(ch_fadp_art_22_4, [label-'DSG (SR 235.1) Art 22 Abs 4 (private controller obliged by law to process is exempt)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_22 (unit ch-fadp-sr-235-1-2025-07-07#art_22/para_4)', verbatim-'Von der Erstellung einer Datenschutz-Folgenabschätzung ausgenommen sind private Verantwortliche, wenn sie gesetzlich zur Bearbeitung der Daten verpflichtet sind.']).

citation(ch_fadp_art_22_5, [label-'DSG (SR 235.1) Art 22 Abs 5 lead-in (private controller may dispense: certification or code of conduct)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_22 (unit ch-fadp-sr-235-1-2025-07-07#art_22/para_5/listintro)', verbatim-'Der private Verantwortliche kann von der Erstellung einer Datenschutz-Folgenabschätzung absehen, wenn er ein System, ein Produkt oder eine Dienstleistung einsetzt, das oder die für die vorgesehene Verwendung nach']).

citation(ch_fadp_art_22_5_a, [label-'DSG (SR 235.1) Art 22 Abs 5 Bst a (code of conduct based on an impact assessment)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_22 (unit ch-fadp-sr-235-1-2025-07-07#art_22/para_5/lbl_a)', verbatim-'Der Verhaltenskodex beruht auf einer Datenschutz-Folgenabschätzung.']).

citation(ch_fadp_art_22_5_b, [label-'DSG (SR 235.1) Art 22 Abs 5 Bst b (code of conduct provides protective measures)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_22 (unit ch-fadp-sr-235-1-2025-07-07#art_22/para_5/lbl_b)', verbatim-'Er sieht Massnahmen zum Schutz der Persönlichkeit und der Grundrechte der betroffenen Person vor.']).

citation(ch_fadp_art_22_5_c, [label-'DSG (SR 235.1) Art 22 Abs 5 Bst c (code of conduct submitted to the Commissioner)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_22 (unit ch-fadp-sr-235-1-2025-07-07#art_22/para_5/lbl_c)', verbatim-'Er wurde dem EDÖB vorgelegt.']).

% ---- GDPR Arts 13 and 14: duty to inform ----------------------------

citation(eu_reg_2016_679_art_13_1, [label-'Regulation (EU) 2016/679 Art 13(1) lead-in (data collected from the data subject)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit 02016R0679-20160504#parag_013.001)', verbatim-'Where personal data relating to a data subject are collected from the data subject, the controller shall, at the time when personal data are obtained, provide the data subject with all of the following information:']).

citation(eu_reg_2016_679_art_13_2, [label-'Regulation (EU) 2016/679 Art 13(2) lead-in (further information for fair and transparent processing)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit 02016R0679-20160504#parag_013.002)', verbatim-'In addition to the information referred to in paragraph 1, the controller shall, at the time when personal data are obtained, provide the data subject with the following further information necessary to ensure fair and transparent processing:']).

citation(eu_reg_2016_679_art_13_2_f, [label-'Regulation (EU) 2016/679 Art 13(2)(f) (existence of automated decision-making)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit 02016R0679-20160504#point_013.002_f)', verbatim-'the existence of automated decision-making, including profiling, referred to in Article 22(1) and (4) and, at least in those cases, meaningful information about the logic involved, as well as the significance and the envisaged consequences of such processing for the data subject.']).

citation(eu_reg_2016_679_art_13_4, [label-'Regulation (EU) 2016/679 Art 13(4) (data subject already has the information)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit 02016R0679-20160504#parag_013.004)', verbatim-'Paragraphs 1, 2 and 3 shall not apply where and insofar as the data subject already has the information.']).

citation(eu_reg_2016_679_art_14_1, [label-'Regulation (EU) 2016/679 Art 14(1) lead-in (data not obtained from the data subject)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit 02016R0679-20160504#parag_014.001)', verbatim-'Where personal data have not been obtained from the data subject, the controller shall provide the data subject with the following information:']).

citation(eu_reg_2016_679_art_14_2, [label-'Regulation (EU) 2016/679 Art 14(2) lead-in (further information for fair and transparent processing)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit 02016R0679-20160504#parag_014.002)', verbatim-'In addition to the information referred to in paragraph 1, the controller shall provide the data subject with the following information necessary to ensure fair and transparent processing in respect of the data subject:']).

citation(eu_reg_2016_679_art_14_2_g, [label-'Regulation (EU) 2016/679 Art 14(2)(g) (existence of automated decision-making)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit 02016R0679-20160504#point_014.002_g)', verbatim-'the existence of automated decision-making, including profiling, referred to in Article 22(1) and (4) and, at least in those cases, meaningful information about the logic involved, as well as the significance and the envisaged consequences of such processing for the data subject.']).

citation(eu_reg_2016_679_art_14_5, [label-'Regulation (EU) 2016/679 Art 14(5) lead-in (paragraphs 1 to 4 shall not apply)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit 02016R0679-20160504#parag_014.005)', verbatim-'Paragraphs 1 to 4 shall not apply where and insofar as:']).

citation(eu_reg_2016_679_art_14_5_a, [label-'Regulation (EU) 2016/679 Art 14(5)(a) (data subject already has the information)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit 02016R0679-20160504#point_014.005_a)', verbatim-'the data subject already has the information;']).

citation(eu_reg_2016_679_art_14_5_b, [label-'Regulation (EU) 2016/679 Art 14(5)(b) (impossible, disproportionate effort or seriously impairing the objectives)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit 02016R0679-20160504#point_014.005_b)', verbatim-'the provision of such information proves impossible or would involve a disproportionate effort']).

citation(eu_reg_2016_679_art_14_5_c, [label-'Regulation (EU) 2016/679 Art 14(5)(c) (obtaining or disclosure expressly laid down by law)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit 02016R0679-20160504#point_014.005_c)', verbatim-'obtaining or disclosure is expressly laid down by Union or Member State law to which the controller is subject and which provides appropriate measures to protect the']).

citation(eu_reg_2016_679_art_14_5_d, [label-'Regulation (EU) 2016/679 Art 14(5)(d) (confidentiality under professional secrecy)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit 02016R0679-20160504#point_014.005_d)', verbatim-'where the personal data must remain confidential subject to an obligation of professional secrecy regulated by Union or Member State law, including a statutory obligation of secrecy.']).

% ---- GDPR Art 22(1): the automated decision -------------------------

citation(eu_reg_2016_679_art_22_1, [label-'Regulation (EU) 2016/679 Art 22(1) (decision based solely on automated processing with legal or similarly significant effects)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit 02016R0679-20160504#parag_022.001)', verbatim-'The data subject shall have the right not to be subject to a decision based solely on automated processing, including profiling, which produces legal effects concerning him or her or similarly significantly affects him or her.']).

% ---- GDPR Art 35: impact assessment ---------------------------------

citation(eu_reg_2016_679_art_35_1, [label-'Regulation (EU) 2016/679 Art 35(1) (impact assessment where likely high risk)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit 02016R0679-20160504#parag_035.001)', verbatim-'Where a type of processing in particular using new technologies, and taking into account the nature, scope, context and purposes of the processing, is likely to result in a high risk to the rights and freedoms of natural persons, the controller shall, prior to the processing, carry out an assessment of the impact of the envisaged processing operations on the protection of personal data.']).

citation(eu_reg_2016_679_art_35_3, [label-'Regulation (EU) 2016/679 Art 35(3) lead-in (cases in which an assessment is in particular required)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit 02016R0679-20160504#parag_035.003)', verbatim-'A data protection impact assessment referred to in paragraph 1 shall in particular be required in the case of:']).

citation(eu_reg_2016_679_art_35_3_a, [label-'Regulation (EU) 2016/679 Art 35(3)(a) (systematic and extensive evaluation with significant automated decisions)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit 02016R0679-20160504#point_035.003_a)', verbatim-'a systematic and extensive evaluation of personal aspects relating to natural persons which is based on automated processing, including profiling, and on which decisions are based that produce legal effects concerning the natural person or similarly significantly affect the natural person;']).

citation(eu_reg_2016_679_art_35_3_b, [label-'Regulation (EU) 2016/679 Art 35(3)(b) (large-scale processing of special categories or criminal data)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit 02016R0679-20160504#point_035.003_b)', verbatim-'processing on a large scale of special categories of data referred to in']).

citation(eu_reg_2016_679_art_35_3_c, [label-'Regulation (EU) 2016/679 Art 35(3)(c) (systematic large-scale monitoring of a publicly accessible area)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit 02016R0679-20160504#point_035.003_c)', verbatim-'a systematic monitoring of a publicly accessible area on a large scale.']).

citation(eu_reg_2016_679_art_35_10, [label-'Regulation (EU) 2016/679 Art 35(10) (legal-basis exemption from the impact assessment)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (unit 02016R0679-20160504#parag_035.010)', verbatim-'paragraphs 1 to 7 shall not apply unless Member States deem it to be necessary to carry out such an assessment prior to processing activities.']).

:- end_module(citations).
