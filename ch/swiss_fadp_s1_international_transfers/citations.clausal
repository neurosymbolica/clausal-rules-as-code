% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for ch/swiss_fadp_s1_international_transfers.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% The verbatim pair is OMITTED while the key's entry in
% citations-sources.yaml is `status: unverified`.
%
% Sources (pinned units; the German text of the DSG and the DSV is
% authoritative, glosses are unofficial and live in NOTES.md):
%   DSG, SR 235.1, fedlex consolidation Stand 7 July 2025, unit ids
%     ch-fadp-sr-235-1-2025-07-07#art_16/..., #art_17/...
%   DSV, SR 235.11, fedlex consolidation Stand 1 December 2025, unit ids
%     ch-fadp-ord-sr-235-11-2025-12-01#art_8/para_1, #annex_1/lvl_u1, #art_12/...
%   Regulation (EU) 2016/679, Formex consolidation 02016R0679-20160504,
%     #parag_045.001 and #parag_046.001.
% Every verbatim below is an exact substring of the pinned unit text.
%
% The four referral TARGET keys (the statements of an authority that stand
% for an absent outside fact) are recorded too, unverified: they name no
% pinned text, only the statement the caller attests.
%
% Deferred units (DSV Art 8(2)-(6), the Annex 1 notes, DSV Art 9(3),
% DSV Art 10(2), GDPR Art 46(2)-(5)) are NOT applied by any rule and get no
% key; see NOTES.md S3.
%
% PROVENANCE: implements(Key) succeeds exactly for a recorded key.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

implements(Key) :-
    citation(Key, _).

% ---- DSG Art 16 ----------------------------------------------------
citation(ch_fadp_art_16_1, [label-'DSG (SR 235.1) Art 16 Abs 1 (disclosure abroad on a finding of the Federal Council)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_16 (pinned unit ch-fadp-sr-235-1-2025-07-07#art_16/para_1)', verbatim-'Personendaten dürfen ins Ausland bekanntgegeben werden, wenn der Bundesrat festgestellt hat, dass die Gesetzgebung des betreffenden Staates oder das internationale Organ einen angemessenen Schutz gewährleistet.']).
citation(ch_fadp_art_16_2, [label-'DSG (SR 235.1) Art 16 Abs 2 lead-in (suitable data protection without a decision of the Federal Council)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_16 (pinned unit ch-fadp-sr-235-1-2025-07-07#art_16/para_2/listintro)', verbatim-'Liegt kein Entscheid des Bundesrates nach Absatz 1 vor, so dürfen Personendaten ins Ausland bekanntgegeben werden, wenn ein geeigneter Datenschutz gewährleistet wird durch:']).
citation(ch_fadp_art_16_2_a, [label-'DSG (SR 235.1) Art 16 Abs 2 Bst a (international treaty)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_16 (pinned unit ch-fadp-sr-235-1-2025-07-07#art_16/para_2/lbl_a)', verbatim-'einen völkerrechtlichen Vertrag;']).
citation(ch_fadp_art_16_2_b, [label-'DSG (SR 235.1) Art 16 Abs 2 Bst b (contract data protection clauses notified to the EDÖB beforehand)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_16 (pinned unit ch-fadp-sr-235-1-2025-07-07#art_16/para_2/lbl_b)', verbatim-'Datenschutzklauseln in einem Vertrag zwischen dem Verantwortlichen oder dem Auftragsbearbeiter und seiner Vertragspartnerin oder seinem Vertragspartner, die dem EDÖB vorgängig mitgeteilt wurden;']).
citation(ch_fadp_art_16_2_c, [label-'DSG (SR 235.1) Art 16 Abs 2 Bst c (specific guarantees of the competent federal body notified to the EDÖB beforehand)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_16 (pinned unit ch-fadp-sr-235-1-2025-07-07#art_16/para_2/lbl_c)', verbatim-'spezifische Garantien, die das zuständige Bundesorgan erarbeitet und dem EDÖB vorgängig mitgeteilt hat;']).
citation(ch_fadp_art_16_2_d, [label-'DSG (SR 235.1) Art 16 Abs 2 Bst d (standard data protection clauses approved, issued or recognised by the EDÖB beforehand)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_16 (pinned unit ch-fadp-sr-235-1-2025-07-07#art_16/para_2/lbl_d)', verbatim-'Standarddatenschutzklauseln, die der EDÖB vorgängig genehmigt, ausgestellt oder anerkannt hat;']).
citation(ch_fadp_art_16_2_e, [label-'DSG (SR 235.1) Art 16 Abs 2 Bst e (binding corporate data protection rules approved beforehand)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_16 (pinned unit ch-fadp-sr-235-1-2025-07-07#art_16/para_2/lbl_e)', verbatim-'verbindliche unternehmensinterne Datenschutzvorschriften, die vorgängig vom EDÖB oder von einer für den Datenschutz zuständigen Behörde eines Staates, der einen angemessenen Schutz gewährleistet, genehmigt wurden.']).
citation(ch_fadp_art_16_3, [label-'DSG (SR 235.1) Art 16 Abs 3 (other suitable guarantees provided by the Federal Council)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_16 (pinned unit ch-fadp-sr-235-1-2025-07-07#art_16/para_3)', verbatim-'Der Bundesrat kann andere geeignete Garantien im Sinne von Absatz 2 vorsehen.']).

% ---- DSG Art 17 ----------------------------------------------------
citation(ch_fadp_art_17_1, [label-'DSG (SR 235.1) Art 17 Abs 1 lead-in (derogations from Art 16 Abs 1 and 2)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_17 (pinned unit ch-fadp-sr-235-1-2025-07-07#art_17/para_1/listintro)', verbatim-'Abweichend von Artikel 16 Absätze 1 und 2 dürfen in den folgenden Fällen Personendaten ins Ausland bekanntgegeben werden:']).
citation(ch_fadp_art_17_1_a, [label-'DSG (SR 235.1) Art 17 Abs 1 Bst a (express consent of the data subject)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_17 (pinned unit ch-fadp-sr-235-1-2025-07-07#art_17/para_1/lbl_a)', verbatim-'Die betroffene Person hat ausdrücklich in die Bekanntgabe eingewilligt.']).
citation(ch_fadp_art_17_1_b, [label-'DSG (SR 235.1) Art 17 Abs 1 Bst b lead-in (disclosure directly connected with a contract)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_17 (pinned unit ch-fadp-sr-235-1-2025-07-07#art_17/para_1/lbl_b/listintro)', verbatim-'Die Bekanntgabe steht in unmittelbarem Zusammenhang mit dem Abschluss oder der Abwicklung eines Vertrags:']).
citation(ch_fadp_art_17_1_b_1, [label-'DSG (SR 235.1) Art 17 Abs 1 Bst b Ziff 1 (contract between the controller and the data subject)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_17 (pinned unit ch-fadp-sr-235-1-2025-07-07#art_17/para_1/lbl_b/lbl_1)', verbatim-'zwischen dem Verantwortlichen und der betroffenen Person; oder']).
citation(ch_fadp_art_17_1_b_2, [label-'DSG (SR 235.1) Art 17 Abs 1 Bst b Ziff 2 (contract with a contracting party in the interest of the data subject)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_17 (pinned unit ch-fadp-sr-235-1-2025-07-07#art_17/para_1/lbl_b/lbl_2)', verbatim-'zwischen dem Verantwortlichen und seiner Vertragspartnerin oder seinem Vertragspartner im Interesse der betroffenen Person.']).
citation(ch_fadp_art_17_1_c, [label-'DSG (SR 235.1) Art 17 Abs 1 Bst c lead-in (disclosure necessary)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_17 (pinned unit ch-fadp-sr-235-1-2025-07-07#art_17/para_1/lbl_c/listintro)', verbatim-'Die Bekanntgabe ist notwendig für:']).
citation(ch_fadp_art_17_1_c_1, [label-'DSG (SR 235.1) Art 17 Abs 1 Bst c Ziff 1 (overriding public interest)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_17 (pinned unit ch-fadp-sr-235-1-2025-07-07#art_17/para_1/lbl_c/lbl_1)', verbatim-'die Wahrung eines überwiegenden öffentlichen Interesses; oder']).
citation(ch_fadp_art_17_1_c_2, [label-'DSG (SR 235.1) Art 17 Abs 1 Bst c Ziff 2 (legal claims before a court or a competent foreign authority)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_17 (pinned unit ch-fadp-sr-235-1-2025-07-07#art_17/para_1/lbl_c/lbl_2)', verbatim-'die Feststellung, Ausübung oder Durchsetzung von Rechtsansprüchen vor einem Gericht oder einer anderen zuständigen ausländischen Behörde.']).
citation(ch_fadp_art_17_1_d, [label-'DSG (SR 235.1) Art 17 Abs 1 Bst d (life or physical integrity, consent not obtainable in a reasonable period)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_17 (pinned unit ch-fadp-sr-235-1-2025-07-07#art_17/para_1/lbl_d)', verbatim-'Die Bekanntgabe ist notwendig, um das Leben oder die körperliche Unversehrtheit der betroffenen Person oder eines Dritten zu schützen, und es ist nicht möglich, innerhalb einer angemessenen Frist die Einwilligung der betroffenen Person einzuholen.']).
citation(ch_fadp_art_17_1_e, [label-'DSG (SR 235.1) Art 17 Abs 1 Bst e (data made generally accessible, processing not expressly prohibited)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_17 (pinned unit ch-fadp-sr-235-1-2025-07-07#art_17/para_1/lbl_e)', verbatim-'Die betroffene Person hat die Daten allgemein zugänglich gemacht und eine Bearbeitung nicht ausdrücklich untersagt.']).
citation(ch_fadp_art_17_1_f, [label-'DSG (SR 235.1) Art 17 Abs 1 Bst f (data from a statutory register, inspection conditions met)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_17 (pinned unit ch-fadp-sr-235-1-2025-07-07#art_17/para_1/lbl_f)', verbatim-'Die Daten stammen aus einem gesetzlich vorgesehenen Register, das öffentlich oder Personen mit einem schutzwürdigen Interesse zugänglich ist, soweit im Einzelfall die gesetzlichen Voraussetzungen der Einsichtnahme erfüllt sind.']).
citation(ch_fadp_art_17_2, [label-'DSG (SR 235.1) Art 17 Abs 2 (information of the EDÖB on request)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_17 (pinned unit ch-fadp-sr-235-1-2025-07-07#art_17/para_2)', verbatim-'Der Verantwortliche oder der Auftragsbearbeiter informiert den EDÖB auf Anfrage über die Bekanntgabe von Personendaten nach Absatz 1 Buchstaben b Ziffer 2, c und d.']).

% ---- DSV Art 8(1), Annex 1, Art 12 ---------------------------------
citation(ch_fadp_ord_art_8_1, [label-'DSV (SR 235.11) Art 8 Abs 1 (the list of Annex 1)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/568/de#art_8 (pinned unit ch-fadp-ord-sr-235-11-2025-12-01#art_8/para_1)', verbatim-'Die Staaten, Gebiete, spezifischen Sektoren in einem Staat und internationalen Organe mit einem angemessenen Datenschutz werden in Anhang 1 aufgeführt.']).
citation(ch_fadp_ord_annex_1, [label-'DSV (SR 235.11) Anhang 1 (States, territories, specific sectors and international bodies with adequate data protection)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/568/de#annex_1 (pinned unit ch-fadp-ord-sr-235-11-2025-12-01#annex_1/lvl_u1)', verbatim-'Staaten, Gebiete, spezifische Sektoren in einem Staat und internationale Organe mit einem angemessenen Datenschutz']).
citation(ch_fadp_ord_art_12_1, [label-'DSV (SR 235.11) Art 12 Abs 1 (code of conduct or certification ensuring suitable data protection)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/568/de#art_12 (pinned unit ch-fadp-ord-sr-235-11-2025-12-01#art_12/para_1)', verbatim-'Personendaten dürfen ins Ausland bekanntgegeben werden, wenn ein Verhaltenskodex oder eine Zertifizierung einen geeigneten Datenschutz gewährleistet.']).
citation(ch_fadp_ord_art_12_2, [label-'DSV (SR 235.11) Art 12 Abs 2 (code of conduct submitted to the EDÖB for approval beforehand)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/568/de#art_12 (pinned unit ch-fadp-ord-sr-235-11-2025-12-01#art_12/para_2)', verbatim-'Der Verhaltenskodex muss vorgängig dem EDÖB zur Genehmigung unterbreitet werden.']).
citation(ch_fadp_ord_art_12_3, [label-'DSV (SR 235.11) Art 12 Abs 3 (binding and enforceable commitment of the recipient in the third State)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/568/de#art_12 (pinned unit ch-fadp-ord-sr-235-11-2025-12-01#art_12/para_3)', verbatim-'Der Verhaltenskodex oder die Zertifizierung muss mit einer verbindlichen und durchsetzbaren Verpflichtung des Verantwortlichen oder des Auftragsbearbeiters im Drittstaat verbunden werden, die darin enthaltenen Massnahmen anzuwenden.']).

% ---- Regulation (EU) 2016/679 --------------------------------------
citation(eu_reg_2016_679_art_45_1, [label-'Regulation (EU) 2016/679 Art 45(1) (transfer on the basis of an adequacy decision)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (pinned unit 02016R0679-20160504#parag_045.001)', verbatim-'A transfer of personal data to a third country or an international organisation may take place where the Commission has decided that the third country, a territory or one or more specified sectors within that third country, or the international organisation in question ensures an adequate level of protection. Such a transfer shall not require any specific authorisation.']).
citation(eu_reg_2016_679_art_46_1, [label-'Regulation (EU) 2016/679 Art 46(1) (transfer subject to appropriate safeguards)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504 (pinned unit 02016R0679-20160504#parag_046.001)', verbatim-'In the absence of a decision pursuant to Article 45(3), a controller or processor may transfer personal data to a third country or an international organisation only if the controller or processor has provided appropriate safeguards, and on condition that enforceable data subject rights and effective legal remedies for data subjects are available.']).

% ---- referral targets (statements of an authority; not pinned) -----
citation(federal_council_adequacy_listing_statement, [label-'Statement that an entry of DSV Anhang 1 (DSV Art 8 Abs 1), with its printed condition and note, covers this disclosure (outside fact for DSG Art 16 Abs 1)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/568/de#annex_1']).
citation(commissioner_standard_clauses_statement, [label-'Statement that the EDÖB approved, issued or recognised the standard data protection clauses beforehand (outside fact for DSG Art 16 Abs 2 Bst d; the EDÖB list of DSV Art 10 Abs 2 is not pinned)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_16']).
citation(swiss_binding_corporate_rules_approval_statement, [label-'Statement that the binding corporate rules were approved beforehand by the EDÖB or by a data protection authority of an adequate State (outside fact for DSG Art 16 Abs 2 Bst e)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_16']).
citation(commission_adequacy_decision_statement, [label-'Statement that a European Commission adequacy decision covers this transfer (outside fact for Regulation (EU) 2016/679 Art 45(1); the decisions are not pinned)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504']).

test(every_contract_citation_is_recorded) :-
    implements(ch_fadp_art_16_1),
    implements(ch_fadp_art_17_2),
    implements(ch_fadp_ord_annex_1),
    implements(eu_reg_2016_679_art_46_1).
test(an_unrecorded_key_fails, fail) :-
    implements(ch_todo_primary_source).

:- end_module(citations).
