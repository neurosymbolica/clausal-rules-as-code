% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for ch/swiss_fadp_s4_criminal_provisions.
%
% Swiss source: Bundesgesetz ueber den Datenschutz (DSG), SR 235.1, German
% text (authoritative), fedlex consolidation Stand 7 July 2025, Akoma Ntoso,
% fetched 2026-11-14, cut by article into sources/.
% EU source: Regulation (EU) 2016/679 (GDPR), Formex consolidation
% 02016R0679-20160504, Article 83 extract (sha256 6a2a99fb...d555).
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order. The
% verbatim pair is omitted for a key whose citations-sources.yaml entry is
% `status: unverified` (here only the grouped key ch_fadp_art_60_to_63,
% which names no single unit of text).
%
% Deferred keys (recorded for provenance, never returned in a result):
% ch_fadp_art_64_1 and eu_reg_2016_679_art_83_2_b.
% The grouped key ch_fadp_art_60_to_63 is returned ONLY as the CITE of a
% comparison referral on a Swiss judgement (reading (10)).
%
% PROVENANCE MARKERS: implements(Key) succeeds for every recorded key and
% fails for any other, so a misspelt marker makes its clause fail.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

implements(Key) :-
    citation(Key, _).

% ---- DSG Art 60: breach of duties to inform, to give access, to cooperate ----
citation(ch_fadp_art_60_1, [label-'DSG (SR 235.1) Art 60 para 1, lead-in (fine up to 250 000 francs, on complaint, for private persons)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_60', verbatim-'werden private Personen auf Antrag bestraft']).
citation(ch_fadp_art_60_1_a, [label-'DSG (SR 235.1) Art 60 para 1 let a (wilfully giving false or incomplete information in breach of Arts 19, 21 and 25 to 27)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_60', verbatim-'indem sie vorsätzlich eine falsche oder unvollständige Auskunft erteilen']).
citation(ch_fadp_art_60_1_b, [label-'DSG (SR 235.1) Art 60 para 1 let b, lead-in (wilful failure)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_60', verbatim-'die es vorsätzlich unterlassen']).
citation(ch_fadp_art_60_1_b_1, [label-'DSG (SR 235.1) Art 60 para 1 let b no 1 (failing to inform the data subject under Arts 19(1) and 21(1))', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_60', verbatim-'die betroffene Person nach den Artikeln 19 Absatz 1 und 21 Absatz 1 zu informieren']).
citation(ch_fadp_art_60_1_b_2, [label-'DSG (SR 235.1) Art 60 para 1 let b no 2 (failing to give the data subject the information under Art 19(2))', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_60', verbatim-'ihr die Angaben nach Artikel 19 Absatz 2 zu liefern']).
citation(ch_fadp_art_60_2, [label-'DSG (SR 235.1) Art 60 para 2 (false information to the Commissioner or refusal to cooperate in an investigation, in breach of Art 49(3); no complaint required)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_60', verbatim-'dem EDÖB im Rahmen einer Untersuchung vorsätzlich falsche Auskünfte erteilen oder vorsätzlich die Mitwirkung verweigern']).

% ---- DSG Art 61: breach of duties of care ----
citation(ch_fadp_art_61, [label-'DSG (SR 235.1) Art 61, lead-in (fine up to 250 000 francs, on complaint, for private persons acting wilfully)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_61', verbatim-'werden private Personen auf Antrag bestraft, die vorsätzlich']).
citation(ch_fadp_art_61_a, [label-'DSG (SR 235.1) Art 61 let a (disclosing personal data abroad in breach of Art 16(1) and (2) without the conditions of Art 17)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_61', verbatim-'Personendaten ins Ausland bekanntgeben']).
citation(ch_fadp_art_61_b, [label-'DSG (SR 235.1) Art 61 let b (handing over processing to a processor without the conditions of Art 9(1) and (2))', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_61', verbatim-'die Datenbearbeitung einem Auftragsbearbeiter übergeben']).
citation(ch_fadp_art_61_c, [label-'DSG (SR 235.1) Art 61 let c (not complying with the minimum data-security requirements under Art 8(3))', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_61', verbatim-'die Mindestanforderungen an die Datensicherheit, die der Bundesrat nach Artikel 8 Absatz 3 erlassen hat, nicht einhalten']).

% ---- DSG Art 62: breach of professional secrecy ----
citation(ch_fadp_art_62_1, [label-'DSG (SR 235.1) Art 62 para 1 (wilful disclosure of secret personal data learned in the exercise of a profession; on complaint)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_62', verbatim-'Wer geheime Personendaten vorsätzlich offenbart']).
citation(ch_fadp_art_62_2, [label-'DSG (SR 235.1) Art 62 para 2 (the same penalty for disclosure learned in activity for, or training with, a person bound by secrecy)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_62', verbatim-'Gleich wird bestraft, wer vorsätzlich geheime Personendaten offenbart']).
citation(ch_fadp_art_62_3, [label-'DSG (SR 235.1) Art 62 para 3 (disclosure punishable also after the end of the professional activity or training)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_62', verbatim-'Das Offenbaren geheimer Personendaten ist auch nach Beendigung der Berufsausübung oder der Ausbildung strafbar.']).

% ---- DSG Art 63: disregard of decisions ----
citation(ch_fadp_art_63, [label-'DSG (SR 235.1) Art 63 (wilful non-compliance with a decision issued with reference to the penalty of Art 63; no complaint required)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_63', verbatim-'die einer Verfügung des EDÖB oder einem Entscheid der Rechtsmittelinstanzen']).

% ---- DSG Arts 60 to 63 together (comparison referral citation only) ----
citation(ch_fadp_art_60_to_63, [label-'DSG (SR 235.1) Arts 60 to 63 together (the offence provisions; fixed citation of a comparison referral on a Swiss judgement)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_60']).

% ---- DSG Art 64: offences in businesses ----
citation(ch_fadp_art_64_1, [label-'DSG (SR 235.1) Art 64 para 1 (VStrR Arts 6 and 7 apply to offences in businesses; deferred)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_64', verbatim-'Für Widerhandlungen in Geschäftsbetrieben']).
citation(ch_fadp_art_64_2, [label-'DSG (SR 235.1) Art 64 para 2 (authority may order the business to pay a fine of at most 50 000 francs instead of the persons punishable)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_64', verbatim-'so kann die Behörde von einer Verfolgung dieser Personen absehen']).

% ---- DSG Art 66: limitation of prosecution ----
citation(ch_fadp_art_66, [label-'DSG (SR 235.1) Art 66 (prosecution time-barred after five years)', ref-'https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_66', verbatim-'Die Strafverfolgung verjährt nach fünf Jahren.']).

% ---- GDPR Art 83 ----
citation(eu_reg_2016_679_art_83_2_b, [label-'Regulation (EU) 2016/679 Art 83(2)(b) (intentional or negligent character of the infringement; quoted for reading (9) only, deferred)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'the intentional or negligent character of the infringement']).
citation(eu_reg_2016_679_art_83_4, [label-'Regulation (EU) 2016/679 Art 83(4), lead-in (ceiling 10 000 000 EUR or 2 % of total worldwide annual turnover, whichever is higher)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'administrative fines up to 10000000 EUR']).
citation(eu_reg_2016_679_art_83_4_a, [label-'Regulation (EU) 2016/679 Art 83(4)(a) (obligations of controller and processor under Arts 8, 11, 25 to 39, 42 and 43)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'the obligations of the controller and the processor pursuant to Articles 8, 11, 25 to 39 and 42 and 43']).
citation(eu_reg_2016_679_art_83_4_b, [label-'Regulation (EU) 2016/679 Art 83(4)(b) (obligations of the certification body under Arts 42 and 43)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'the obligations of the certification body pursuant to Articles 42 and 43']).
citation(eu_reg_2016_679_art_83_4_c, [label-'Regulation (EU) 2016/679 Art 83(4)(c) (obligations of the monitoring body under Art 41(4))', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'the obligations of the monitoring body pursuant to Article 41(4)']).
citation(eu_reg_2016_679_art_83_5, [label-'Regulation (EU) 2016/679 Art 83(5), lead-in (ceiling 20 000 000 EUR or 4 % of total worldwide annual turnover, whichever is higher)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'administrative fines up to 20000000 EUR']).
citation(eu_reg_2016_679_art_83_5_a, [label-'Regulation (EU) 2016/679 Art 83(5)(a) (basic principles and consent under Arts 5, 6, 7 and 9)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'the basic principles for processing, including conditions for consent, pursuant to Articles 5, 6, 7 and 9']).
citation(eu_reg_2016_679_art_83_5_b, [label-'Regulation (EU) 2016/679 Art 83(5)(b) (data subjects rights under Arts 12 to 22)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'rights pursuant to Articles 12 to 22']).
citation(eu_reg_2016_679_art_83_5_c, [label-'Regulation (EU) 2016/679 Art 83(5)(c) (transfers to a third country or international organisation under Arts 44 to 49)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'the transfers of personal data to a recipient in a third country or an international organisation pursuant to Articles 44 to 49']).
citation(eu_reg_2016_679_art_83_5_d, [label-'Regulation (EU) 2016/679 Art 83(5)(d) (obligations under Member State law adopted under Chapter IX)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'any obligations pursuant to Member State law adopted under Chapter IX']).
citation(eu_reg_2016_679_art_83_5_e, [label-'Regulation (EU) 2016/679 Art 83(5)(e) (non-compliance with an order, limitation or suspension under Art 58(2), or failure to provide access under Art 58(1))', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'non-compliance with an order or a temporary or definitive limitation on processing or the suspension of data flows by the supervisory authority pursuant to Article 58(2)']).
citation(eu_reg_2016_679_art_83_6, [label-'Regulation (EU) 2016/679 Art 83(6) (non-compliance with an Art 58(2) order: ceiling 20 000 000 EUR or 4 %)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'Non-compliance with an order by the supervisory authority as referred to in Article 58(2)']).

:- end_module(citations).
