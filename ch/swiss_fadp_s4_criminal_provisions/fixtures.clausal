% ---- Convenience wrapper ---------------------------------------------
swiss_fadp_s4_criminal_provisions_assess(Subject, Result) :-
    swiss_fadp_s4_criminal_provisions_profile_for(Subject, Profile),
    decide_swiss_fadp_s4_criminal_provisions(Profile, Result).

:- end_module(fixtures).
