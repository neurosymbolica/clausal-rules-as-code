swiss_fadp_s4_criminal_provisions_subject(unsure_conduct_article_61_b).
swiss_fadp_s4_criminal_provisions_subject(conduct_met_article_61_b).
swiss_fadp_s4_criminal_provisions_subject(empty_profile).
swiss_fadp_s4_criminal_provisions_subject(malformed_duplicate_key).
swiss_fadp_s4_criminal_provisions_subject(single_key_control).

% ---- Profiles --------------------------------------------------------
swiss_fadp_s4_criminal_provisions_profile_for(punishable_article_63, [
    attribute(conduct_meets_offence_description, true),
    attribute(acted_wilfully, true),
    attribute(examined_offence, article_63),
    attribute(offender_is_private_person, true)
]).
swiss_fadp_s4_criminal_provisions_profile_for(private_person_false_article_63, [
    attribute(conduct_meets_offence_description, true),
