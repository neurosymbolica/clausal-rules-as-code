% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% queries.clausal -- QUERY-COMBINATOR layer for ch/swiss_fadp_art24_breach_notification.
% A TOP-LAYER consumer: it imports the determination slice's PUBLIC
% predicates it calls, and nothing else.
%
% a reading, not a lawyer's; the German text of the DSG is
% authoritative (reading (1)).
%
% swiss_fadp_art24_breach_notification_profile_keys/1: the nine profile keys, in
%   root_exports / input_contract order.
% swiss_fadp_art24_breach_notification_input_problems/2: THE INPUT CHECK,
%   re-exported exactly as the scaffold wrote it in kernel.clausal.
% swiss_fadp_art24_breach_notification_what_if/4 (#16 what-if): the headline
%   status after one key of the attribute list is hypothetically set.
%   The profile is an ATTRIBUTE LIST, not a dict, so the dict-based
%   override_key/4 of kit/query_combinators does not apply: the override
%   below drops every attribute(Key, _) of the key and appends the new one;
%   a malformed profile is passed through unchanged, so the input check of
%   the hypothesis answers it.
% swiss_fadp_art24_breach_notification_obligations/2 (#14 obligation
%   surfacing): each duty with its bearer, its single answer and its
%   citations, copied from the slice's own query.
%
% Served elsewhere (the slice): #5 comparison
% compare_swiss_eu_authority_notification/5 and #7 justification
% swiss_fadp_art24_breach_notification_checklist/2.
%
% root_exports: the nine profile key atoms and the judgement value unsure
% are read by the test cases as package-root attributes; the answer atoms
% and the result constructors of the contract are exported here as well.
% They are vocabulary: they decide nothing and carry no marker.
% =====================================================================

:- module(queries, [
    swiss_fadp_art24_breach_notification_profile_keys/1,
    swiss_fadp_art24_breach_notification_input_problems/2,
    swiss_fadp_art24_breach_notification_what_if/4,
    swiss_fadp_art24_breach_notification_obligations/2,
    breach_of_data_security/0,
    breach_likely_to_lead_to_high_risk_to_personality_or_fundamental_rights/0,
    information_necessary_for_protection_of_data_subject/0,
    commissioner_requested_information_of_data_subject/0,
    article_26_ground_or_statutory_secrecy_obligation_applies/0,
    information_impossible_or_requires_disproportionate_effort/0,
    information_ensured_comparably_by_public_announcement/0,
    personal_data_breach/0,
    breach_unlikely_to_result_in_risk/0,
    unsure/0,
    authority_notification_required/0,
    authority_notification_not_required/0,
    report_to_controller_required/0,
    report_to_controller_not_required/0,
    information_of_data_subject_required/0,
    information_of_data_subject_not_required/0,
    information_of_data_subject_may_be_restricted_deferred_or_omitted/0,
    same/0,
    differs/0,
    not_comparable/0,
    indeterminate/1,
    needs_legal_review/2,
    open_textured/2,
    inputs_relied_on/1,
    provenance/2,
    input_problems/1,
    unknown_key/1,
    wrong_type/1,
    duplicate_key/1
]).

:- constructors([
    open_textured(input, citation),
    provenance(source, detail),
    unknown_key(key),
    wrong_type(key),
    duplicate_key(key)
]).

:- use_module(ch/swiss_fadp_art24_breach_notification/kernel, [swiss_fadp_art24_breach_notification_input_problems/2]).
:- use_module(ch/swiss_fadp_art24_breach_notification/swiss_fadp_art24_breach_notification, [
    swiss_fadp_art24_breach_notification_status/2,
    swiss_controller_report_to_commissioner/3,
    swiss_processor_report_to_controller/3,
    swiss_information_of_data_subject/3,
    eu_controller_notification_to_supervisory_authority/3
]).

% schema of top-level profile keys: the keys of the order's typed input contract, in its order
swiss_fadp_art24_breach_notification_profile_keys([
    breach_of_data_security,
    breach_likely_to_lead_to_high_risk_to_personality_or_fundamental_rights,
    information_necessary_for_protection_of_data_subject,
    commissioner_requested_information_of_data_subject,
    article_26_ground_or_statutory_secrecy_obligation_applies,
    information_impossible_or_requires_disproportionate_effort,
    information_ensured_comparably_by_public_announcement,
    personal_data_breach,
    breach_unlikely_to_result_in_risk
]).

% ---- root_exports: the nine profile keys and the value unsure ---------
breach_of_data_security.
breach_likely_to_lead_to_high_risk_to_personality_or_fundamental_rights.
information_necessary_for_protection_of_data_subject.
commissioner_requested_information_of_data_subject.
article_26_ground_or_statutory_secrecy_obligation_applies.
information_impossible_or_requires_disproportionate_effort.
information_ensured_comparably_by_public_announcement.
personal_data_breach.
breach_unlikely_to_result_in_risk.
unsure.

% ---- the answer atoms of the contract ---------------------------------
authority_notification_required.
authority_notification_not_required.
report_to_controller_required.
report_to_controller_not_required.
information_of_data_subject_required.
information_of_data_subject_not_required.
information_of_data_subject_may_be_restricted_deferred_or_omitted.
same.
differs.
not_comparable.

% ---- the result constructors (exported, never called as queries) -------
% open_textured/2, provenance/2, unknown_key/1, wrong_type/1 and
% duplicate_key/1 are data (declared above with constructors/1): no clauses.
indeterminate(MissingKeys) :-
    is_list(MissingKeys).
needs_legal_review(_Reason, Context) :-
    is_list(Context).
inputs_relied_on(Pairs) :-
    is_list(Pairs).
input_problems(Problems) :-
    is_list(Problems).

% ---- #16 what-if: re-evaluate with one key hypothetically set ---------
swiss_fadp_art24_breach_notification_what_if(Profile, OverriddenKey, NewValue, NewStatus) :-
    override_attribute(Profile, OverriddenKey, NewValue, Hypothesis),
    swiss_fadp_art24_breach_notification_status(Hypothesis, NewStatus).

% override_attribute(Profile, OverriddenKey, NewValue, Hypothesis): list
% plumbing, no marker. Exactly one clause holds for every Profile term; an
% unbound or partial or non-list profile stays malformed.
override_attribute(RemainingProfile, _, _, RemainingProfile) :-
    var(RemainingProfile).
override_attribute(RemainingProfile, OverriddenKey, NewValue, [attribute(OverriddenKey, NewValue)]) :-
    RemainingProfile == [].
override_attribute(RemainingProfile, OverriddenKey, NewValue, Hypothesis) :-
    nonvar(RemainingProfile),
    RemainingProfile = [Element|Elements],
    element_kept(Element, OverriddenKey, KeptElements),
    override_attribute(Elements, OverriddenKey, NewValue, LaterElements),
    append(KeptElements, LaterElements, Hypothesis).
override_attribute(RemainingProfile, _, _, RemainingProfile) :-
    nonvar(RemainingProfile),
    RemainingProfile \== [],
    RemainingProfile \= [_|_].

element_kept(Element, _, [Element]) :-
    var(Element).
element_kept(Element, OverriddenKey, []) :-
    nonvar(Element),
    Element = attribute(ElementKey, _),
    ElementKey == OverriddenKey.
element_kept(Element, OverriddenKey, [Element]) :-
    nonvar(Element),
    Element = attribute(ElementKey, _),
    ElementKey \== OverriddenKey.
element_kept(Element, _, [Element]) :-
    nonvar(Element),
    Element \= attribute(_, _).

% ---- #14 obligation surfacing: what must each bearer do -------------
% One duty row per obligation of the order, in a fixed order; each copies
% the single answer of its query (input_problems(...) and [] included).
swiss_fadp_art24_breach_notification_obligations(Profile, [
    duty(controller, report_to_commissioner, ControllerResult, ControllerCitations),
    duty(processor, report_to_controller, ProcessorResult, ProcessorCitations),
    duty(controller, inform_data_subject, InformationResult, InformationCitations),
    duty(controller, notify_eu_supervisory_authority, EuropeanResult, EuropeanCitations)
]) :-
    swiss_controller_report_to_commissioner(Profile, ControllerResult, ControllerCitations),
    swiss_processor_report_to_controller(Profile, ProcessorResult, ProcessorCitations),
    swiss_information_of_data_subject(Profile, InformationResult, InformationCitations),
    eu_controller_notification_to_supervisory_authority(Profile, EuropeanResult, EuropeanCitations).

:- end_module(queries).
