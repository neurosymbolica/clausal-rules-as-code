% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% fixtures.clausal -- representative profiles for ch/swiss_fadp_art24_breach_notification.
% A TOP-LAYER consumer: it imports the determination slice's PUBLIC
% predicate it calls -- that is the whole import list. Profile keys and
% subject ids are atoms and need no import.
%
% A profile is an ATTRIBUTE LIST [attribute(Key, Value), ...] (the order's
% typed input contract). The domain has no numeric threshold, so each
% route's positive case is paired with a ONE-KEY near-miss control: the
% same profile with one judgement or fact changed, which gets the other
% answer. The expected answers are asserted in
% tests/test_public_interface.clausal.
% =====================================================================

:- module(fixtures, [
    swiss_fadp_art24_breach_notification_subject/1,
    swiss_fadp_art24_breach_notification_profile_for/2,
    swiss_fadp_art24_breach_notification_assess/2
]).

:- use_module(ch/swiss_fadp_art24_breach_notification/swiss_fadp_art24_breach_notification, [decide_swiss_fadp_art24_breach_notification/2]).

% ---- Subject registry ------------------------------------------------
% Art 24(1) and Art 33(1): both duties owed / high risk false (control).
swiss_fadp_art24_breach_notification_subject(all_duties_owed).
swiss_fadp_art24_breach_notification_subject(high_risk_false_control).
% Art 5 letter h: no breach decides every Swiss duty.
swiss_fadp_art24_breach_notification_subject(no_breach).
% Art 24(5)(c): announcement exception / announcement false (control).
swiss_fadp_art24_breach_notification_subject(public_announcement_exception).
swiss_fadp_art24_breach_notification_subject(public_announcement_false_control).
% Art 24(4) request ground with an exception (Q1) / without (control).
swiss_fadp_art24_breach_notification_subject(commissioner_request_with_exception).
swiss_fadp_art24_breach_notification_subject(commissioner_request_only).
% Art 24(4): ground failed (control of commissioner_request_only).
swiss_fadp_art24_breach_notification_subject(ground_failed).
% Not-final answers: missing keys before unsure judgements.
swiss_fadp_art24_breach_notification_subject(high_risk_absent).
swiss_fadp_art24_breach_notification_subject(breach_unsure_high_risk_absent).
swiss_fadp_art24_breach_notification_subject(breach_unsure).
swiss_fadp_art24_breach_notification_subject(necessity_unsure).
swiss_fadp_art24_breach_notification_subject(necessity_unsure_request_met).
swiss_fadp_art24_breach_notification_subject(exception_partly_open).
% GDPR Art 33(1) referral, and the two risk judgements both true (Q4).
swiss_fadp_art24_breach_notification_subject(eu_unsure).
swiss_fadp_art24_breach_notification_subject(both_risk_judgements_true).
% THE INPUT CHECK: crisp key unsure / crisp key true (control).
swiss_fadp_art24_breach_notification_subject(crisp_unsure).
swiss_fadp_art24_breach_notification_subject(crisp_true_control).
swiss_fadp_art24_breach_notification_subject(duplicate_and_unknown).
swiss_fadp_art24_breach_notification_subject(not_attribute_list).

% ---- Profiles --------------------------------------------------------
swiss_fadp_art24_breach_notification_profile_for(all_duties_owed, [
    attribute(breach_of_data_security, true),
    attribute(breach_likely_to_lead_to_high_risk_to_personality_or_fundamental_rights, true),
    attribute(information_necessary_for_protection_of_data_subject, true),
    attribute(commissioner_requested_information_of_data_subject, false),
    attribute(article_26_ground_or_statutory_secrecy_obligation_applies, false),
    attribute(information_impossible_or_requires_disproportionate_effort, false),
    attribute(information_ensured_comparably_by_public_announcement, false),
    attribute(personal_data_breach, true),
    attribute(breach_unlikely_to_result_in_risk, false)
]).
swiss_fadp_art24_breach_notification_profile_for(high_risk_false_control, [
    attribute(breach_of_data_security, true),
    attribute(breach_likely_to_lead_to_high_risk_to_personality_or_fundamental_rights, false),
    attribute(information_necessary_for_protection_of_data_subject, true),
    attribute(commissioner_requested_information_of_data_subject, false),
    attribute(article_26_ground_or_statutory_secrecy_obligation_applies, false),
    attribute(information_impossible_or_requires_disproportionate_effort, false),
    attribute(information_ensured_comparably_by_public_announcement, false),
    attribute(personal_data_breach, true),
    attribute(breach_unlikely_to_result_in_risk, false)
]).
swiss_fadp_art24_breach_notification_profile_for(no_breach, [
    attribute(breach_of_data_security, false)
]).
swiss_fadp_art24_breach_notification_profile_for(public_announcement_exception, [
    attribute(breach_of_data_security, true),
    attribute(breach_likely_to_lead_to_high_risk_to_personality_or_fundamental_rights, true),
    attribute(information_necessary_for_protection_of_data_subject, true),
    attribute(commissioner_requested_information_of_data_subject, false),
    attribute(information_ensured_comparably_by_public_announcement, true)
]).
swiss_fadp_art24_breach_notification_profile_for(public_announcement_false_control, [
    attribute(breach_of_data_security, true),
    attribute(breach_likely_to_lead_to_high_risk_to_personality_or_fundamental_rights, true),
    attribute(information_necessary_for_protection_of_data_subject, true),
    attribute(commissioner_requested_information_of_data_subject, false),
    attribute(article_26_ground_or_statutory_secrecy_obligation_applies, false),
    attribute(information_impossible_or_requires_disproportionate_effort, false),
    attribute(information_ensured_comparably_by_public_announcement, false)
]).
swiss_fadp_art24_breach_notification_profile_for(commissioner_request_with_exception, [
    attribute(breach_of_data_security, true),
    attribute(information_necessary_for_protection_of_data_subject, false),
    attribute(commissioner_requested_information_of_data_subject, true),
    attribute(information_impossible_or_requires_disproportionate_effort, true)
]).
swiss_fadp_art24_breach_notification_profile_for(commissioner_request_only, [
    attribute(breach_of_data_security, true),
    attribute(information_necessary_for_protection_of_data_subject, false),
    attribute(commissioner_requested_information_of_data_subject, true),
    attribute(article_26_ground_or_statutory_secrecy_obligation_applies, false),
    attribute(information_impossible_or_requires_disproportionate_effort, false),
    attribute(information_ensured_comparably_by_public_announcement, false)
]).
swiss_fadp_art24_breach_notification_profile_for(ground_failed, [
    attribute(breach_of_data_security, true),
    attribute(information_necessary_for_protection_of_data_subject, false),
    attribute(commissioner_requested_information_of_data_subject, false)
]).
swiss_fadp_art24_breach_notification_profile_for(high_risk_absent, [
    attribute(breach_of_data_security, true)
]).
swiss_fadp_art24_breach_notification_profile_for(breach_unsure_high_risk_absent, [
    attribute(breach_of_data_security, unsure)
]).
swiss_fadp_art24_breach_notification_profile_for(breach_unsure, [
    attribute(breach_of_data_security, unsure),
    attribute(breach_likely_to_lead_to_high_risk_to_personality_or_fundamental_rights, true)
]).
swiss_fadp_art24_breach_notification_profile_for(necessity_unsure, [
    attribute(breach_of_data_security, true),
    attribute(information_necessary_for_protection_of_data_subject, unsure),
    attribute(commissioner_requested_information_of_data_subject, false),
    attribute(article_26_ground_or_statutory_secrecy_obligation_applies, false),
    attribute(information_impossible_or_requires_disproportionate_effort, false),
    attribute(information_ensured_comparably_by_public_announcement, false)
]).
swiss_fadp_art24_breach_notification_profile_for(necessity_unsure_request_met, [
    attribute(breach_of_data_security, true),
    attribute(information_necessary_for_protection_of_data_subject, unsure),
    attribute(commissioner_requested_information_of_data_subject, true),
    attribute(article_26_ground_or_statutory_secrecy_obligation_applies, false),
    attribute(information_impossible_or_requires_disproportionate_effort, false),
    attribute(information_ensured_comparably_by_public_announcement, false)
]).
swiss_fadp_art24_breach_notification_profile_for(exception_partly_open, [
    attribute(breach_of_data_security, true),
    attribute(information_necessary_for_protection_of_data_subject, true),
    attribute(article_26_ground_or_statutory_secrecy_obligation_applies, unsure),
    attribute(information_impossible_or_requires_disproportionate_effort, false)
]).
swiss_fadp_art24_breach_notification_profile_for(eu_unsure, [
    attribute(breach_of_data_security, true),
    attribute(breach_likely_to_lead_to_high_risk_to_personality_or_fundamental_rights, true),
    attribute(personal_data_breach, unsure),
    attribute(breach_unlikely_to_result_in_risk, false)
]).
swiss_fadp_art24_breach_notification_profile_for(both_risk_judgements_true, [
    attribute(breach_of_data_security, true),
    attribute(breach_likely_to_lead_to_high_risk_to_personality_or_fundamental_rights, true),
    attribute(personal_data_breach, true),
    attribute(breach_unlikely_to_result_in_risk, true)
]).
swiss_fadp_art24_breach_notification_profile_for(crisp_unsure, [
    attribute(commissioner_requested_information_of_data_subject, unsure)
]).
swiss_fadp_art24_breach_notification_profile_for(crisp_true_control, [
    attribute(commissioner_requested_information_of_data_subject, true)
]).
swiss_fadp_art24_breach_notification_profile_for(duplicate_and_unknown, [
    attribute(breach_of_data_security, true),
    attribute(breach_of_data_security, false),
    attribute(breach_unlikely_to_result_in_risk, maybe),
    attribute(severity, high),
    attribute(severity, high)
]).
swiss_fadp_art24_breach_notification_profile_for(not_attribute_list, [
    attribute(breach_of_data_security, true),
    foo
]).

% ---- Convenience wrapper ---------------------------------------------
swiss_fadp_art24_breach_notification_assess(Subject, Result) :-
    swiss_fadp_art24_breach_notification_profile_for(Subject, Profile),
    decide_swiss_fadp_art24_breach_notification(Profile, Result).

:- end_module(fixtures).
