% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_queries.clausal -- tests for the query layer: one per query type in
% manifest query_interface (#2 status, #5 comparison, #7 justification,
% #14 obligation surfacing, #16 what-if), the re-exported input check, the
% profile key schema, and the served answer atoms.
% Run: python -m clausal.testing ch/swiss_fadp_art24_breach_notification/tests/test_queries.clausal
% =====================================================================
:- module(test_queries, []).
:- use_module(ch/swiss_fadp_art24_breach_notification/queries, [
    swiss_fadp_art24_breach_notification_profile_keys/1,
    swiss_fadp_art24_breach_notification_input_problems/2,
    swiss_fadp_art24_breach_notification_what_if/4,
    swiss_controller_report_to_commissioner/3,
    swiss_processor_report_to_controller/3,
    swiss_information_of_data_subject/3,
    eu_controller_notification_to_supervisory_authority/3,
    compare_swiss_eu_authority_notification/5,
    authority_notification_required/0,
    report_to_controller_not_required/0,
    information_of_data_subject_required/0,
    same/0,
    differs/0,
    not_comparable/0,
    breach_of_data_security/0,
    breach_unlikely_to_result_in_risk/0,
    unsure/0
]).
:- use_module(ch/swiss_fadp_art24_breach_notification/swiss_fadp_art24_breach_notification, [
    swiss_fadp_art24_breach_notification_checklist/2,
    swiss_fadp_art24_breach_notification_status/2
]).
:- use_module(ch/swiss_fadp_art24_breach_notification/fixtures, [
    swiss_fadp_art24_breach_notification_profile_for/2,
    swiss_fadp_art24_breach_notification_assess/2
]).

test(profile_keys_are_the_contract_keys) :-
    swiss_fadp_art24_breach_notification_profile_keys(ProfileKeys),
    ProfileKeys == [breach_of_data_security, breach_likely_to_lead_to_high_risk_to_personality_or_fundamental_rights, information_necessary_for_protection_of_data_subject, commissioner_requested_information_of_data_subject, article_26_ground_or_statutory_secrecy_obligation_applies, information_impossible_or_requires_disproportionate_effort, information_ensured_comparably_by_public_announcement, personal_data_breach, breach_unlikely_to_result_in_risk].

% #2 status
test(status_query_reads_the_controller_report) :-
    swiss_fadp_art24_breach_notification_profile_for(no_breach, Profile),
    findall(Status, swiss_fadp_art24_breach_notification_status(Profile, Status), Statuses),
    Statuses == [authority_notification_not_required].

test(assess_wraps_the_verdict) :-
    swiss_fadp_art24_breach_notification_assess(all_duties_owed, swiss_fadp_art24_breach_notification_verdict(authority_notification_required, [cite(ch_fadp_art_5_h), cite(ch_fadp_art_24_1)])).

% #5 comparison
test(comparison_contrasts_the_two_thresholds) :-
    swiss_fadp_art24_breach_notification_profile_for(both_risk_judgements_true, Profile),
    findall(answer(Swiss, Union, Difference, Changed), compare_swiss_eu_authority_notification(Profile, Swiss, Union, Difference, Changed), Answers),
    Answers == [answer(authority_notification_required, authority_notification_not_required, differs, [cite(ch_fadp_art_24_1), cite(eu_reg_2016_679_art_33_1)])].

% #7 justification: one checklist row per duty, each with its cite(...)
test(checklist_justifies_every_duty) :-
    swiss_fadp_art24_breach_notification_profile_for(all_duties_owed, Profile),
    findall(Items, swiss_fadp_art24_breach_notification_checklist(Profile, Items), Answers),
    Answers == [[item(controller_report_to_commissioner, authority_notification_required, cite(ch_fadp_art_24_1)), item(processor_report_to_controller, report_to_controller_required, cite(ch_fadp_art_24_3)), item(information_of_data_subject, information_of_data_subject_required, cite(ch_fadp_art_24_4)), item(eu_notification_to_supervisory_authority, authority_notification_required, cite(eu_reg_2016_679_art_33_1))]].

% #14 obligation surfacing: what must the controller and processor do
test(obligations_surface_for_a_high_risk_breach) :-
    swiss_fadp_art24_breach_notification_profile_for(all_duties_owed, Profile),
    swiss_controller_report_to_commissioner(Profile, authority_notification_required, [cite(ch_fadp_art_5_h), cite(ch_fadp_art_24_1)]),
    swiss_processor_report_to_controller(Profile, report_to_controller_required, [cite(ch_fadp_art_5_h), cite(ch_fadp_art_24_3)]),
    swiss_information_of_data_subject(Profile, information_of_data_subject_required, [cite(ch_fadp_art_5_h), cite(ch_fadp_art_24_4), cite(ch_fadp_art_24_5)]),
    eu_controller_notification_to_supervisory_authority(Profile, authority_notification_required, [cite(eu_reg_2016_679_art_33_1)]).

% #16 what-if
test(what_if_flips_the_controller_report) :-
    swiss_fadp_art24_breach_notification_profile_for(high_risk_false_control, Profile),
    findall(Status, swiss_fadp_art24_breach_notification_what_if(Profile, breach_likely_to_lead_to_high_risk_to_personality_or_fundamental_rights, true, Status), Statuses),
    Statuses == [authority_notification_required].

test(what_if_replaces_every_entry_of_the_key) :-
    swiss_fadp_art24_breach_notification_profile_for(duplicate_and_unknown, Profile),
    findall(Status, swiss_fadp_art24_breach_notification_what_if(Profile, breach_of_data_security, true, Status), Statuses),
    Statuses == [input_problems([wrong_type(breach_unlikely_to_result_in_risk), unknown_key(severity)])].

test(what_if_passes_a_non_list_to_the_input_check) :-
    findall(Status, swiss_fadp_art24_breach_notification_what_if(not_a_profile, breach_of_data_security, true, Status), Statuses),
    Statuses == [input_problems([wrong_type(profile)])].

% the input check, re-exported
test(input_check_is_served_by_the_query_layer) :-
    swiss_fadp_art24_breach_notification_profile_for(crisp_unsure, Profile),
    findall(Problems, swiss_fadp_art24_breach_notification_input_problems(Profile, Problems), Answers),
    Answers == [[wrong_type(commissioner_requested_information_of_data_subject)]].

% the served answer atoms and root exports
test(answer_atoms_are_served) :-
    authority_notification_required,
    report_to_controller_not_required,
    information_of_data_subject_required,
    same,
    differs,
    not_comparable,
    breach_of_data_security,
    breach_unlikely_to_result_in_risk,
    unsure.

% the result constructors are data: their terms build and destructure
test(result_constructor_terms_destructure) :-
    Result = needs_legal_review(open_textured(breach_of_data_security, cite(ch_fadp_art_5_h)), [inputs_relied_on([])]),
    Result = needs_legal_review(open_textured(Key, _), _),
    Key == breach_of_data_security.

:- end_module(test_queries).
