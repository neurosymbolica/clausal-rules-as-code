% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_queries.clausal -- PROPERTY tests for the query layer: one or more
% tests per query-taxonomy predicate registered in manifest.yaml
% query_interface (#2 status, #5 comparison, #7 justification, #14
% obligation surfacing, #16 what-if), plus the exported vocabulary.
% Run: python -m clausal.testing ch/swiss_fadp_art24_breach_notification/tests/test_queries.clausal
% =====================================================================
:- module(test_queries, []).
:- use_module(ch/swiss_fadp_art24_breach_notification/queries, [
    swiss_fadp_art24_breach_notification_profile_keys/1,
    swiss_fadp_art24_breach_notification_input_problems/2,
    swiss_fadp_art24_breach_notification_what_if/4,
    swiss_fadp_art24_breach_notification_obligations/2,
    breach_of_data_security/0,
    breach_likely_to_lead_to_high_risk_to_personality_or_fundamental_rights/0,
    information_necessary_for_protection_of_data_subject/0,
    commissioner_requested_information_of_data_subject/0,
    article_26_ground_or_statutory_secrecy_obligation_applies/0,
    information_impossible_or_requires_disproportionate_effort/0,
    information_ensured_comparably_by_public_announcement/0,
    personal_data_breach/0,
    breach_unlikely_to_result_in_risk/0,
    unsure/0,
    authority_notification_required/0,
    same/0,
    differs/0,
    not_comparable/0,
    indeterminate/1,
    needs_legal_review/2,
    inputs_relied_on/1,
    input_problems/1
]).
:- use_module(ch/swiss_fadp_art24_breach_notification/swiss_fadp_art24_breach_notification, [
    swiss_fadp_art24_breach_notification_status/2,
    swiss_fadp_art24_breach_notification_checklist/2,
    compare_swiss_eu_authority_notification/5
]).
:- use_module(ch/swiss_fadp_art24_breach_notification/fixtures, [swiss_fadp_art24_breach_notification_profile_for/2]).

test(profile_keys_are_the_contract_keys) :-
    swiss_fadp_art24_breach_notification_profile_keys(ProfileKeys),
    ProfileKeys == [breach_of_data_security, breach_likely_to_lead_to_high_risk_to_personality_or_fundamental_rights, information_necessary_for_protection_of_data_subject, commissioner_requested_information_of_data_subject, article_26_ground_or_statutory_secrecy_obligation_applies, information_impossible_or_requires_disproportionate_effort, information_ensured_comparably_by_public_announcement, personal_data_breach, breach_unlikely_to_result_in_risk].

% ---- #2 status --------------------------------------------------------------
test(status_is_the_controller_report) :-
    swiss_fadp_art24_breach_notification_profile_for(no_breach, Profile),
    findall(Status, swiss_fadp_art24_breach_notification_status(Profile, Status), Statuses),
    Statuses == [authority_notification_not_required].

% ---- #16 what-if --------------------------------------------------------------
test(what_if_raising_the_risk_requires_the_report) :-
    swiss_fadp_art24_breach_notification_profile_for(breach_without_high_risk, Profile),
    findall(Status, swiss_fadp_art24_breach_notification_what_if(Profile, breach_likely_to_lead_to_high_risk_to_personality_or_fundamental_rights, true, Status), Statuses),
    Statuses == [authority_notification_required].
test(what_if_lowering_the_risk_drops_the_report) :-
    swiss_fadp_art24_breach_notification_profile_for(high_risk_breach_all_duties, Profile),
    findall(Status, swiss_fadp_art24_breach_notification_what_if(Profile, breach_likely_to_lead_to_high_risk_to_personality_or_fundamental_rights, false, Status), Statuses),
    Statuses == [authority_notification_not_required].
test(what_if_adds_an_absent_key) :-
    swiss_fadp_art24_breach_notification_profile_for(breach_only, Profile),
    findall(Status, swiss_fadp_art24_breach_notification_what_if(Profile, breach_likely_to_lead_to_high_risk_to_personality_or_fundamental_rights, true, Status), Statuses),
    Statuses == [authority_notification_required].
test(what_if_unsure_value_refers) :-
    swiss_fadp_art24_breach_notification_profile_for(high_risk_breach_all_duties, Profile),
    findall(Status, swiss_fadp_art24_breach_notification_what_if(Profile, breach_of_data_security, unsure, Status), Statuses),
    Statuses = [needs_legal_review(open_textured(breach_of_data_security, cite(ch_fadp_art_5_h)), _)].
test(what_if_replaces_a_duplicated_key) :-
    swiss_fadp_art24_breach_notification_profile_for(duplicate_and_unknown_keys, Profile),
    findall(Status, swiss_fadp_art24_breach_notification_what_if(Profile, breach_of_data_security, true, Status), Statuses),
    Statuses == [input_problems([unknown_key(colour)])].
test(what_if_passes_a_malformed_profile) :-
    swiss_fadp_art24_breach_notification_profile_for(not_an_attribute_list, Profile),
    findall(Status, swiss_fadp_art24_breach_notification_what_if(Profile, breach_of_data_security, true, Status), Statuses),
    Statuses == [input_problems([wrong_type(profile)])].
test(what_if_on_an_empty_profile) :-
    findall(Status, swiss_fadp_art24_breach_notification_what_if([], breach_of_data_security, false, Status), Statuses),
    Statuses == [authority_notification_not_required].

% ---- #14 obligation surfacing --------------------------------------------
test(obligations_surface_every_duty) :-
    swiss_fadp_art24_breach_notification_profile_for(high_risk_breach_all_duties, Profile),
    findall(Duties, swiss_fadp_art24_breach_notification_obligations(Profile, Duties), DutyLists),
    DutyLists == [[
        duty(controller, report_to_commissioner, authority_notification_required, [cite(ch_fadp_art_5_h), cite(ch_fadp_art_24_1)]),
        duty(processor, report_to_controller, report_to_controller_required, [cite(ch_fadp_art_5_h), cite(ch_fadp_art_24_3)]),
        duty(controller, inform_data_subject, information_of_data_subject_required, [cite(ch_fadp_art_5_h), cite(ch_fadp_art_24_4), cite(ch_fadp_art_24_5)]),
        duty(controller, notify_eu_supervisory_authority, authority_notification_required, [cite(eu_reg_2016_679_art_33_1)])
    ]].
test(obligations_carry_input_problems) :-
    swiss_fadp_art24_breach_notification_profile_for(not_an_attribute_list, Profile),
    findall(Duties, swiss_fadp_art24_breach_notification_obligations(Profile, Duties), DutyLists),
    DutyLists == [[
        duty(controller, report_to_commissioner, input_problems([wrong_type(profile)]), []),
        duty(processor, report_to_controller, input_problems([wrong_type(profile)]), []),
        duty(controller, inform_data_subject, input_problems([wrong_type(profile)]), []),
        duty(controller, notify_eu_supervisory_authority, input_problems([wrong_type(profile)]), [])
    ]].

% ---- #5 comparison -------------------------------------------------------------
test(comparison_names_the_threshold_provisions) :-
    swiss_fadp_art24_breach_notification_profile_for(breach_without_high_risk, Profile),
    findall(Difference-ChangedBy, compare_swiss_eu_authority_notification(Profile, _, _, Difference, ChangedBy), Answers),
    Answers == [differs-[cite(ch_fadp_art_24_1), cite(eu_reg_2016_679_art_33_1)]].

% ---- #7 justification: one item per obligation with provenance -------------
test(checklist_carries_citations_per_item) :-
    swiss_fadp_art24_breach_notification_profile_for(high_risk_breach_all_duties, Profile),
    findall(Items, swiss_fadp_art24_breach_notification_checklist(Profile, Items), ItemLists),
    ItemLists == [[
        item(controller_report_to_commissioner, authority_notification_required, [cite(ch_fadp_art_5_h), cite(ch_fadp_art_24_1)]),
        item(processor_report_to_controller, report_to_controller_required, [cite(ch_fadp_art_5_h), cite(ch_fadp_art_24_3)]),
        item(information_of_data_subject, information_of_data_subject_required, [cite(ch_fadp_art_5_h), cite(ch_fadp_art_24_4), cite(ch_fadp_art_24_5)]),
        item(eu_notification_to_supervisory_authority, authority_notification_required, [cite(eu_reg_2016_679_art_33_1)])
    ]].

% ---- the input check is re-exported -----------------------------------------
test(input_check_is_reexported) :-
    swiss_fadp_art24_breach_notification_profile_for(crisp_key_unsure, Profile),
    findall(Problems, swiss_fadp_art24_breach_notification_input_problems(Profile, Problems), ProblemLists),
    ProblemLists == [[wrong_type(commissioner_requested_information_of_data_subject)]].

% ---- exported vocabulary ---------------------------------------------------
test(root_export_atoms_are_served) :-
    breach_of_data_security,
    breach_likely_to_lead_to_high_risk_to_personality_or_fundamental_rights,
    information_necessary_for_protection_of_data_subject,
    commissioner_requested_information_of_data_subject,
    article_26_ground_or_statutory_secrecy_obligation_applies,
    information_impossible_or_requires_disproportionate_effort,
    information_ensured_comparably_by_public_announcement,
    personal_data_breach,
    breach_unlikely_to_result_in_risk,
    unsure.
test(answer_atoms_are_served) :-
    authority_notification_required,
    same,
    differs,
    not_comparable.
test(result_constructors_accept_their_shapes) :-
    indeterminate([breach_of_data_security]),
    needs_legal_review(open_textured(breach_of_data_security, cite(ch_fadp_art_5_h)), [inputs_relied_on([breach_of_data_security-unsure])]),
    inputs_relied_on([breach_of_data_security-unsure]),
    input_problems([wrong_type(profile)]).
test(data_constructors_build_and_destructure) :-
    Reason = open_textured(breach_of_data_security, cite(ch_fadp_art_5_h)),
    Reason = open_textured(InputKey, cite(CitationKey)),
    InputKey == breach_of_data_security,
    CitationKey == ch_fadp_art_5_h,
    Trailing = provenance(ch_fadp_art_5_h, pinned_text),
    functor(Trailing, provenance, 2),
    Problems = [duplicate_key(breach_of_data_security), wrong_type(commissioner_requested_information_of_data_subject), unknown_key(colour)],
    Problems = [duplicate_key(DuplicateKey), wrong_type(WrongKey), unknown_key(UnknownKey)],
    DuplicateKey == breach_of_data_security,
    WrongKey == commissioner_requested_information_of_data_subject,
    UnknownKey == colour.

:- end_module(test_queries).
