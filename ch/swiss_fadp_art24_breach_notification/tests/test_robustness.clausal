% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_robustness.clausal -- ROBUSTNESS of the input check swiss_fadp_art24_breach_notification_input_problems/2 for a
% PROFILE that is an attribute list [attribute(Key, Value), ...]: an empty list, a
% value that is not a list, an unknown key and a value outside its type each get exactly
% one answer. Written by the scaffold from the order's typed input contract
% (input_contract.types.profile: attribute_list), not by the producer;
% do not edit or delete.
% Run: python -m clausal.testing ch/swiss_fadp_art24_breach_notification/tests/test_robustness.clausal
% =====================================================================
:- module(test_robustness, []).
:- use_module(ch/swiss_fadp_art24_breach_notification/queries, [swiss_fadp_art24_breach_notification_input_problems/2]).

test(an_empty_attribute_list_gets_exactly_one_answer) :-
    findall(Problems, swiss_fadp_art24_breach_notification_input_problems([], Problems), Answers),
    Answers == [[]].

test(a_profile_that_is_not_a_list_gets_one_non_empty_answer) :-
    findall(Problems, swiss_fadp_art24_breach_notification_input_problems(not_a_profile, Problems), Answers),
    Answers = [[_|_]].

test(an_unknown_key_is_named) :-
    findall(Problems, swiss_fadp_art24_breach_notification_input_problems([attribute(not_a_key_of_the_contract, true)], Problems), Answers),
    Answers = [Problems],
    memberchk(unknown_key(not_a_key_of_the_contract), Problems).

test(a_value_outside_the_type_of_breach_of_data_security_is_named) :-
    findall(Problems, swiss_fadp_art24_breach_notification_input_problems([attribute(breach_of_data_security, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(breach_of_data_security), Problems).

test(a_value_outside_the_type_of_commissioner_requested_information_of_data_subject_is_named) :-
    findall(Problems, swiss_fadp_art24_breach_notification_input_problems([attribute(commissioner_requested_information_of_data_subject, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(commissioner_requested_information_of_data_subject), Problems).

:- end_module(test_robustness).
