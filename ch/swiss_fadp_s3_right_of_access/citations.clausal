% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for ch/swiss_fadp_s3_right_of_access.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% Every key below is `status: verified` in citations-sources.yaml: the
% verbatim is the pinned unit text (German for the Swiss texts, which is
% authoritative; English for the EU texts), quoted without its paragraph
% number or letter label.
%
% The keys are the CANONICAL lexicon keys (_lexicon/citations.yaml); the
% segments ch, fadp, ord, eu, reg, art are lexicon scheme tokens. No other
% or shortened citation atom is used.
%
% PROVENANCE: every clause that decides a statutory condition or computes a
% statutory value opens its body with implements(Key), Key the provision
% for THAT condition or value.
%
% Pinned sources:
%   ch-fadp-sr-235-1-2025-07-07 (DSG, SR 235.1, Stand 7 July 2025, German,
%     Akoma Ntoso, fetched 2026-11-14).
%   ch-fadp-ord-sr-235-11-2025-12-01 (DSV, SR 235.11, Stand 1 December
%     2025, German, Akoma Ntoso, fetched 2026-11-14).
%   02016R0679-20160504 (Regulation (EU) 2016/679, Article 12 extract).
%   31971R1182 (Regulation (EEC, Euratom) No 1182/71, Article 3 extract).
% Deferred units (DSG Art 25(2)-(5); DSV Art 16(2), (4), (5); DSV Art 17;
% DSV Art 18(2)) are pinned but decided by no rule and cited by no answer,
% so they carry no record here.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

% ---- DSG Art 25: the right of access --------------------------------
citation(ch_fadp_art_25_1, [label-'DSG (SR 235.1) Art 25 Abs 1 (right of access)', ref-'ch-fadp-sr-235-1-2025-07-07#art_25/para_1', verbatim-'Jede Person kann vom Verantwortlichen Auskunft darüber verlangen, ob Personendaten über sie bearbeitet werden.']).
citation(ch_fadp_art_25_6, [label-'DSG (SR 235.1) Art 25 Abs 6 (access free of charge; exceptions by the Federal Council)', ref-'ch-fadp-sr-235-1-2025-07-07#art_25/para_6', verbatim-'Der Verantwortliche muss kostenlos Auskunft erteilen. Der Bundesrat kann Ausnahmen vorsehen, namentlich wenn der Aufwand unverhältnismässig ist.']).
citation(ch_fadp_art_25_7, [label-'DSG (SR 235.1) Art 25 Abs 7 (as a rule within 30 days)', ref-'ch-fadp-sr-235-1-2025-07-07#art_25/para_7', verbatim-'Die Auskunft wird in der Regel innerhalb von 30 Tagen erteilt.']).

% ---- DSG Art 26: restrictions of the right of access ----------------
citation(ch_fadp_art_26_1, [label-'DSG (SR 235.1) Art 26 Abs 1, lead-in (controller may refuse, restrict or defer)', ref-'ch-fadp-sr-235-1-2025-07-07#art_26/para_1/listintro', verbatim-'Der Verantwortliche kann die Auskunft verweigern, einschränken oder aufschieben, wenn:']).
citation(ch_fadp_art_26_1_a, [label-'DSG (SR 235.1) Art 26 Abs 1 Bst a (a law in the formal sense provides for it)', ref-'ch-fadp-sr-235-1-2025-07-07#art_26/para_1/lbl_a', verbatim-'ein Gesetz im formellen Sinn dies vorsieht, namentlich um ein Berufsgeheimnis zu schützen;']).
citation(ch_fadp_art_26_1_b, [label-'DSG (SR 235.1) Art 26 Abs 1 Bst b (overriding interests of third parties)', ref-'ch-fadp-sr-235-1-2025-07-07#art_26/para_1/lbl_b', verbatim-'dies aufgrund überwiegender Interessen Dritter erforderlich ist; oder']).
citation(ch_fadp_art_26_1_c, [label-'DSG (SR 235.1) Art 26 Abs 1 Bst c (request manifestly unfounded or manifestly querulous)', ref-'ch-fadp-sr-235-1-2025-07-07#art_26/para_1/lbl_c', verbatim-'das Auskunftsgesuch offensichtlich unbegründet ist, namentlich wenn es einen datenschutzwidrigen Zweck verfolgt, oder offensichtlich querulatorisch ist.']).
citation(ch_fadp_art_26_2, [label-'DSG (SR 235.1) Art 26 Abs 2, lead-in (further cases, in addition)', ref-'ch-fadp-sr-235-1-2025-07-07#art_26/para_2/listintro', verbatim-'Darüber hinaus ist es in den folgenden Fällen möglich, die Auskunft zu verweigern, einzuschränken oder aufzuschieben:']).
citation(ch_fadp_art_26_2_a, [label-'DSG (SR 235.1) Art 26 Abs 2 Bst a, lead-in (controller a private person, both conditions met)', ref-'ch-fadp-sr-235-1-2025-07-07#art_26/para_2/lbl_a/listintro', verbatim-'Der Verantwortliche ist eine private Person und die folgenden Voraussetzungen sind erfüllt:']).
citation(ch_fadp_art_26_2_a_1, [label-'DSG (SR 235.1) Art 26 Abs 2 Bst a Ziff 1 (overriding interests of the controller)', ref-'ch-fadp-sr-235-1-2025-07-07#art_26/para_2/lbl_a/lbl_1', verbatim-'Überwiegende Interessen des Verantwortlichen erfordern die Massnahme.']).
citation(ch_fadp_art_26_2_a_2, [label-'DSG (SR 235.1) Art 26 Abs 2 Bst a Ziff 2 (no disclosure to third parties)', ref-'ch-fadp-sr-235-1-2025-07-07#art_26/para_2/lbl_a/lbl_2', verbatim-'Der Verantwortliche gibt die Personendaten nicht Dritten bekannt.']).
citation(ch_fadp_art_26_2_b, [label-'DSG (SR 235.1) Art 26 Abs 2 Bst b, lead-in (controller a federal body, one condition met)', ref-'ch-fadp-sr-235-1-2025-07-07#art_26/para_2/lbl_b/listintro', verbatim-'Der Verantwortliche ist ein Bundesorgan, und eine der folgenden Voraussetzungen ist erfüllt:']).
citation(ch_fadp_art_26_2_b_1, [label-'DSG (SR 235.1) Art 26 Abs 2 Bst b Ziff 1 (overriding public interests)', ref-'ch-fadp-sr-235-1-2025-07-07#art_26/para_2/lbl_b/lbl_1', verbatim-'Die Massnahme ist wegen überwiegender öffentlicher Interessen, insbesondere der inneren oder der äusseren Sicherheit der Schweiz, erforderlich.']).
citation(ch_fadp_art_26_2_b_2, [label-'DSG (SR 235.1) Art 26 Abs 2 Bst b Ziff 2 (danger to an investigation, inquiry or proceedings)', ref-'ch-fadp-sr-235-1-2025-07-07#art_26/para_2/lbl_b/lbl_2', verbatim-'Die Mitteilung der Information kann eine Ermittlung, eine Untersuchung oder ein behördliches oder gerichtliches Verfahren gefährden.']).
citation(ch_fadp_art_26_3, [label-'DSG (SR 235.1) Art 26 Abs 3 (undertakings of the same group are not third parties)', ref-'ch-fadp-sr-235-1-2025-07-07#art_26/para_3', verbatim-'Unternehmen, die zum selben Konzern gehören, gelten nicht als Dritte im Sinne von Absatz 2 Buchstabe a Ziffer 2.']).
citation(ch_fadp_art_26_4, [label-'DSG (SR 235.1) Art 26 Abs 4 (controller must state reasons)', ref-'ch-fadp-sr-235-1-2025-07-07#art_26/para_4', verbatim-'Der Verantwortliche muss angeben, weshalb er die Auskunft verweigert, einschränkt oder aufschiebt.']).

% ---- DSG Art 27: restrictions for the media -------------------------
citation(ch_fadp_art_27_1, [label-'DSG (SR 235.1) Art 27 Abs 1, lead-in (data processed exclusively for the editorial part of a periodical medium)', ref-'ch-fadp-sr-235-1-2025-07-07#art_27/para_1/listintro', verbatim-'Werden Personendaten ausschliesslich zur Veröffentlichung im redaktionellen Teil eines periodisch erscheinenden Mediums bearbeitet, so kann der Verantwortliche aus einem der folgenden Gründe die Auskunft verweigern, einschränken oder aufschieben:']).
citation(ch_fadp_art_27_1_a, [label-'DSG (SR 235.1) Art 27 Abs 1 Bst a (data reveal the sources of information)', ref-'ch-fadp-sr-235-1-2025-07-07#art_27/para_1/lbl_a', verbatim-'Die Daten geben Aufschluss über die Informationsquellen.']).
citation(ch_fadp_art_27_1_b, [label-'DSG (SR 235.1) Art 27 Abs 1 Bst b (insight into drafts for publications)', ref-'ch-fadp-sr-235-1-2025-07-07#art_27/para_1/lbl_b', verbatim-'Durch die Auskunft würde Einsicht in Entwürfe für Publikationen gewährt.']).
citation(ch_fadp_art_27_1_c, [label-'DSG (SR 235.1) Art 27 Abs 1 Bst c (free formation of public opinion endangered)', ref-'ch-fadp-sr-235-1-2025-07-07#art_27/para_1/lbl_c', verbatim-'Die Veröffentlichung würde die freie Meinungsbildung des Publikums gefährden.']).
citation(ch_fadp_art_27_2, [label-'DSG (SR 235.1) Art 27 Abs 2 (media professionals: personal working instrument)', ref-'ch-fadp-sr-235-1-2025-07-07#art_27/para_2', verbatim-'Medienschaffende können die Auskunft zudem verweigern, einschränken oder aufschieben, wenn ihnen die Personendaten ausschliesslich als persönliches Arbeitsinstrument dienen.']).

% ---- DSV Art 16: form of the request --------------------------------
citation(ch_fadp_ord_art_16_1, [label-'DSV (SR 235.11) Art 16 Abs 1 (request in writing; orally if the controller agrees)', ref-'ch-fadp-ord-sr-235-11-2025-12-01#art_16/para_1', verbatim-'Wer vom Verantwortlichen Auskunft darüber verlangt, ob Personendaten über sie oder ihn bearbeitet werden, muss dies schriftlich tun. Ist der Verantwortliche einverstanden, so kann das Begehren auch mündlich mitgeteilt werden.']).
citation(ch_fadp_ord_art_16_3, [label-'DSV (SR 235.11) Art 16 Abs 3 (electronic means)', ref-'ch-fadp-ord-sr-235-11-2025-12-01#art_16/para_3', verbatim-'Das Auskunftsbegehren und die Auskunftserteilung können auf elektronischem Weg erfolgen.']).

% ---- DSV Art 18: time limit -----------------------------------------
citation(ch_fadp_ord_art_18_1, [label-'DSV (SR 235.11) Art 18 Abs 1 (30 days of receipt of the request)', ref-'ch-fadp-ord-sr-235-11-2025-12-01#art_18/para_1', verbatim-'Die Auskunft muss innerhalb von 30 Tagen seit dem Eingang des Begehrens erteilt werden.']).
citation(ch_fadp_ord_art_18_3, [label-'DSV (SR 235.11) Art 18 Abs 3 (refusal, restriction or deferral within the same period)', ref-'ch-fadp-ord-sr-235-11-2025-12-01#art_18/para_3', verbatim-'Verweigert der Verantwortliche die Auskunft, schränkt er sie ein oder schiebt er sie auf, so muss er dies innerhalb derselben Frist mitteilen.']).

% ---- DSV Art 19: exception from the free-of-charge rule -------------
citation(ch_fadp_ord_art_19_1, [label-'DSV (SR 235.11) Art 19 Abs 1 (disproportionate effort: appropriate cost contribution)', ref-'ch-fadp-ord-sr-235-11-2025-12-01#art_19/para_1', verbatim-'Ist die Erteilung der Auskunft mit einem unverhältnismässigen Aufwand verbunden, so kann der Verantwortliche von der betroffenen Person verlangen, dass sie sich an den Kosten angemessen beteiligt.']).
citation(ch_fadp_ord_art_19_2, [label-'DSV (SR 235.11) Art 19 Abs 2 (contribution at most 300 francs)', ref-'ch-fadp-ord-sr-235-11-2025-12-01#art_19/para_2', verbatim-'Die Beteiligung beträgt maximal 300 Franken.']).
citation(ch_fadp_ord_art_19_3, [label-'DSV (SR 235.11) Art 19 Abs 3 (notice of the amount; ten-day period for reflection; time limit runs after it)', ref-'ch-fadp-ord-sr-235-11-2025-12-01#art_19/para_3', verbatim-'Die Frist nach Artikel 18 Absatz 1 beginnt nach Ablauf der zehntägigen Bedenkzeit zu laufen.']).

% ---- EU comparison limb ---------------------------------------------
citation(eu_reg_2016_679_art_12_3, [label-'Regulation (EU) 2016/679 Art 12(3) (information on action taken within one month of receipt)', ref-'02016R0679-20160504#parag_012.003', verbatim-'The controller shall provide information on action taken on a request under Articles 15 to 22 to the data subject without undue delay and in any event within one month of receipt of the request.']).
citation(eu_reg_1971_1182_art_3_1, [label-'Regulation (EEC, Euratom) No 1182/71 Art 3(1), second sentence (day of the event not counted)', ref-'31971R1182#parag_003.001', verbatim-'Where a period expressed in days, weeks, months or years is to be calculated from the moment at which an event occurs or an action takes place, the day during which that event occurs or that action takes place shall not be considered as falling within the period in question.']).
citation(eu_reg_1971_1182_art_3_2_c, [label-'Regulation (EEC, Euratom) No 1182/71 Art 3(2)(c) (end of a period expressed in months)', ref-'31971R1182#point_003.002_c', verbatim-'If, in a period expressed in months or in years, the day on which it should expire does not occur in the last month, the period shall end with the expiry of the last hour of the last day of that month;']).
citation(eu_reg_1971_1182_art_3_4, [label-'Regulation (EEC, Euratom) No 1182/71 Art 3(4) (last day a Saturday, Sunday or public holiday)', ref-'31971R1182#parag_003.004', verbatim-'Where the last day of a period expressed otherwise than in hours is a public holiday, Sunday or Saturday, the period shall end with the expiry of the last hour of the following working day.']).

% implements(Key): the provenance marker. It succeeds for every recorded
% key and fails for a key this module does not record.
implements(Key) :-
    citation(Key, _).

:- end_module(citations).
