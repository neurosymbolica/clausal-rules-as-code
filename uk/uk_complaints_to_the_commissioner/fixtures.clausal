% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% fixtures.clausal -- representative profiles for uk/uk_complaints_to_the_commissioner.
% A TOP-LAYER consumer: import the determination slice's PUBLIC predicates
% you call -- that is the whole import list. Profile keys and subject ids
% are atoms and need no import.
%
% A profile is an ATTRIBUTE LIST [attribute(Key, Value), ...] (the order's typed
% input contract). Every route has a positive case and a one-key near-miss
% control:
%   gdpr_complaint_to_controller      -> complaint_under_section_164a (positive)
%   part_3_complaint_to_controller    -> complaint_under_section_164a (positive)
%   part_4_complaint_to_controller    -> not_a_complaint_under_section_164a
%                                        (near miss: infringement Part 4 only)
%   complaint_to_processor            -> not_a_complaint_under_section_164a
%                                        (near miss: not made to the controller)
%   third_party_complaint             -> not_a_complaint_under_section_164a
%                                        (near miss: not a data subject about own data)
%   no_infringement_considered        -> not_a_complaint_under_section_164a
%                                        (near miss: no infringement considered)
%   recipient_not_stated              -> indeterminate([complaint_made_to_the_controller])
%   empty_profile                     -> indeterminate([complaint_by_data_subject_about_own_personal_data])
%   badly_typed_profile               -> input_problems([wrong_type(infringement_considered), unknown_key(colour)])
%   duplicated_key_profile            -> input_problems([duplicate_key(infringement_considered)])
% The receipt-date boundary pairs of the deadline query (2026-06-18 /
% 2026-06-19, month, year and leap carries) take no profile and are
% asserted directly in tests/test_public_interface.clausal.
% =====================================================================

:- module(fixtures, [
    uk_complaints_to_the_commissioner_subject/1,
    uk_complaints_to_the_commissioner_profile_for/2,
    uk_complaints_to_the_commissioner_assess/2
]).

:- use_module(uk/uk_complaints_to_the_commissioner/uk_complaints_to_the_commissioner, [decide_uk_complaints_to_the_commissioner/2]).

% ---- Subject registry ------------------------------------------------
uk_complaints_to_the_commissioner_subject(gdpr_complaint_to_controller).
uk_complaints_to_the_commissioner_subject(part_3_complaint_to_controller).
uk_complaints_to_the_commissioner_subject(part_4_complaint_to_controller).
uk_complaints_to_the_commissioner_subject(complaint_to_processor).
uk_complaints_to_the_commissioner_subject(third_party_complaint).
uk_complaints_to_the_commissioner_subject(no_infringement_considered).
uk_complaints_to_the_commissioner_subject(recipient_not_stated).
uk_complaints_to_the_commissioner_subject(empty_profile).
uk_complaints_to_the_commissioner_subject(badly_typed_profile).
uk_complaints_to_the_commissioner_subject(duplicated_key_profile).

% ---- Profiles --------------------------------------------------------
% Positive: a data subject complains to the controller of a UK GDPR infringement.
uk_complaints_to_the_commissioner_profile_for(gdpr_complaint_to_controller, [
    attribute(complaint_by_data_subject_about_own_personal_data, true),
    attribute(infringement_considered, uk_gdpr),
    attribute(complaint_made_to_the_controller, true)
]).

% Positive: the same, of a Part 3 infringement.
uk_complaints_to_the_commissioner_profile_for(part_3_complaint_to_controller, [
    attribute(complaint_by_data_subject_about_own_personal_data, true),
    attribute(infringement_considered, dpa_2018_part_3),
    attribute(complaint_made_to_the_controller, true)
]).

% Near miss: Part 4 is not named in s 164A(1) (still a s 165(2) complaint).
uk_complaints_to_the_commissioner_profile_for(part_4_complaint_to_controller, [
    attribute(complaint_by_data_subject_about_own_personal_data, true),
    attribute(infringement_considered, dpa_2018_part_4),
    attribute(complaint_made_to_the_controller, true)
]).

% Near miss: the complaint is made to a processor, not the controller.
uk_complaints_to_the_commissioner_profile_for(complaint_to_processor, [
    attribute(complaint_by_data_subject_about_own_personal_data, true),
    attribute(infringement_considered, uk_gdpr),
    attribute(complaint_made_to_the_controller, false)
]).

% Near miss: the complainant is not a data subject complaining about own data.
uk_complaints_to_the_commissioner_profile_for(third_party_complaint, [
    attribute(complaint_by_data_subject_about_own_personal_data, false),
    attribute(infringement_considered, uk_gdpr),
    attribute(complaint_made_to_the_controller, true)
]).

% Near miss: the data subject considers no infringement of any of the three.
uk_complaints_to_the_commissioner_profile_for(no_infringement_considered, [
    attribute(complaint_by_data_subject_about_own_personal_data, true),
    attribute(infringement_considered, none_of_the_three),
    attribute(complaint_made_to_the_controller, true)
]).

% Not final: the recipient of the complaint is not stated.
uk_complaints_to_the_commissioner_profile_for(recipient_not_stated, [
    attribute(complaint_by_data_subject_about_own_personal_data, true),
    attribute(infringement_considered, uk_gdpr)
]).

% Not final: nothing is stated.
uk_complaints_to_the_commissioner_profile_for(empty_profile, []).

% Input problems: a value outside its type and a key outside the contract.
uk_complaints_to_the_commissioner_profile_for(badly_typed_profile, [
    attribute(infringement_considered, gdpr),
    attribute(colour, red)
]).

% Input problems: a contract key given twice.
uk_complaints_to_the_commissioner_profile_for(duplicated_key_profile, [
    attribute(complaint_by_data_subject_about_own_personal_data, true),
    attribute(infringement_considered, uk_gdpr),
    attribute(infringement_considered, dpa_2018_part_3),
    attribute(complaint_made_to_the_controller, true)
]).

% ---- Convenience wrapper ---------------------------------------------
uk_complaints_to_the_commissioner_assess(Subject, Result) :-
    uk_complaints_to_the_commissioner_profile_for(Subject, Profile),
    decide_uk_complaints_to_the_commissioner(Profile, Result).

:- end_module(fixtures).
