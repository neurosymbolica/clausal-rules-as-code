% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_robustness.clausal -- ROBUSTNESS of the input check uk_complaints_to_the_commissioner_input_problems/2 for a
% PROFILE that is an attribute list [attribute(Key, Value), ...]: an empty list, a
% value that is not a list, an unknown key and a value outside its type each get exactly
% one answer. Written by the scaffold from the order's typed input contract
% (input_contract.types.profile: attribute_list), not by the producer;
% do not edit or delete.
% Run: python -m clausal.testing uk/uk_complaints_to_the_commissioner/tests/test_robustness.clausal
% =====================================================================
:- module(test_robustness, []).
:- use_module(uk/uk_complaints_to_the_commissioner/queries, [uk_complaints_to_the_commissioner_input_problems/2]).

test(an_empty_attribute_list_gets_exactly_one_answer) :-
    findall(Problems, uk_complaints_to_the_commissioner_input_problems([], Problems), Answers),
    Answers == [[]].

test(a_profile_that_is_not_a_list_gets_one_non_empty_answer) :-
    findall(Problems, uk_complaints_to_the_commissioner_input_problems(not_a_profile, Problems), Answers),
    Answers = [[_|_]].

test(an_unknown_key_is_named) :-
    findall(Problems, uk_complaints_to_the_commissioner_input_problems([attribute(not_a_key_of_the_contract, true)], Problems), Answers),
    Answers = [Problems],
    memberchk(unknown_key(not_a_key_of_the_contract), Problems).

test(a_value_outside_the_type_of_complaint_by_data_subject_about_own_personal_data_is_named) :-
    findall(Problems, uk_complaints_to_the_commissioner_input_problems([attribute(complaint_by_data_subject_about_own_personal_data, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(complaint_by_data_subject_about_own_personal_data), Problems).

test(a_value_outside_the_type_of_infringement_considered_is_named) :-
    findall(Problems, uk_complaints_to_the_commissioner_input_problems([attribute(infringement_considered, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(infringement_considered), Problems).

:- end_module(test_robustness).
