% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for uk/uk_subject_access_requests.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% Every record here is `status: verified` in citations-sources.yaml: its
% verbatim is an exact substring of the pinned unit text named in ref.
%
% Pins (drafter's reading, not a lawyer's):
%   uk-eur-2016-679-revised-2026-09-30 -- UK GDPR, legislation.gov.uk
%     Latest available (Revised) text, Akoma Ntoso, fetched 2026-11-15
%     (no up to date as at date on the page; open question Q10).
%   uksi-2026-82-made -- S.I. 2026/82 (C. 10), as made.
%   ukpga-2025-18-enacted -- Data (Use and Access) Act 2025, as enacted.
%   02016R0679-20160504 -- Regulation (EU) 2016/679, Formex consolidation.
%   31971R1182 -- Regulation (EEC, Euratom) No 1182/71, as published.
%
% The keys returned in answers are the canonical lexicon keys of the
% order's citation vocabulary. Four further keys are RECORDED for
% provisions the rules name or read but never return in a result:
%   uk_gdpr_art_12_5, uk_gdpr_art_12_6 (named by Art 12A(2)(b), (c);
%   deferred), uk_data_use_and_access_act_2025_section_78_5 and
%   uk_data_use_and_access_act_2025_section_142_2_b (reading (3); deferred).
%
% PROVENANCE: every operative clause opens its body with implements(Key).
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

implements(Key) :-
    citation(Key, _).

% ---- UK GDPR Art 15: right of access and the search limit ----------

citation(uk_gdpr_art_15_1, [
    label-'UK GDPR Art 15(1) (right of access by the data subject)',
    ref-'uk-eur-2016-679-revised-2026-09-30#article-15-1',
    verbatim-'The data subject shall have the right to obtain from the controller confirmation as to whether or not personal data concerning him or her are being processed, and, where that is the case, access to the personal data and the following information'
]).

citation(uk_gdpr_art_15_1a, [
    label-'UK GDPR Art 15(1A) (reasonable and proportionate search limit)',
    ref-'uk-eur-2016-679-revised-2026-09-30#article-15-1A',
    verbatim-'Under paragraph 1, the data subject is only entitled to such confirmation, personal data and other information as the controller is able to provide based on a reasonable and proportionate search for the personal data and other information described in that paragraph.'
]).

% ---- UK GDPR Art 12: time for acting on a request ------------------

citation(uk_gdpr_art_12_3, [
    label-'UK GDPR Art 12(3) (information on action taken before the end of the applicable time period)',
    ref-'uk-eur-2016-679-revised-2026-09-30#article-12-3',
    verbatim-'The controller shall provide information on action taken on a request made under or by virtue of Articles 15 to 22D to the data subject without undue delay and in any event before the end of the applicable time period (see Article 12A).'
]).

citation(uk_gdpr_art_12_4, [
    label-'UK GDPR Art 12(4) (reasons for not taking action, within the applicable time period)',
    ref-'uk-eur-2016-679-revised-2026-09-30#article-12-4',
    verbatim-'If the controller does not take action on the request of the data subject, the controller shall inform the data subject without undue delay, and in any event before the end of the applicable time period (see Article 12A), of the reasons for not taking action'
]).

citation(uk_gdpr_art_12_5, [
    label-'UK GDPR Art 12(5) (free of charge; fee for manifestly unfounded or excessive requests; deferred, named by Art 12A(2)(c))',
    ref-'uk-eur-2016-679-revised-2026-09-30#article-12-5',
    verbatim-'information provided under Articles 13 and 14 and any communication and any actions taken under or by virtue of Articles 15 to 22D and 34 shall be provided free of charge.'
]).

citation(uk_gdpr_art_12_6, [
    label-'UK GDPR Art 12(6) (additional information to confirm identity; deferred, named by Art 12A(2)(b))',
    ref-'uk-eur-2016-679-revised-2026-09-30#article-12-6',
    verbatim-'where the controller has reasonable doubts concerning the identity of the natural person making the request made under or by virtue of Articles 15 to 22D, the controller may'
]).

% ---- UK GDPR Art 12A: the applicable time period -------------------

citation(uk_gdpr_art_12a_1, [
    label-'UK GDPR Art 12A(1) (definition of the applicable time period: one month beginning with the relevant time)',
    ref-'uk-eur-2016-679-revised-2026-09-30#article-12A.-1',
    verbatim-'means the period of one month beginning with the relevant time, subject to paragraph 3.'
]).

citation(uk_gdpr_art_12a_2, [
    label-'UK GDPR Art 12A(2) (definition of the relevant time: the latest of points (a) to (c))',
    ref-'uk-eur-2016-679-revised-2026-09-30#article-12A.-2',
    verbatim-'means the latest of the following'
]).

citation(uk_gdpr_art_12a_2_a, [
    label-'UK GDPR Art 12A(2)(a) (relevant time: receipt of the request)',
    ref-'uk-eur-2016-679-revised-2026-09-30#article-12A.-2-a',
    verbatim-'when the controller receives the request in question;'
]).

citation(uk_gdpr_art_12a_2_b, [
    label-'UK GDPR Art 12A(2)(b) (relevant time: receipt of information requested under Art 12(6))',
    ref-'uk-eur-2016-679-revised-2026-09-30#article-12A.-2-b',
    verbatim-'when the controller receives the information (if any) requested in connection with a request under Article 12(6);'
]).

citation(uk_gdpr_art_12a_2_c, [
    label-'UK GDPR Art 12A(2)(c) (relevant time: payment of the fee charged under Art 12(5))',
    ref-'uk-eur-2016-679-revised-2026-09-30#article-12A.-2-c',
    verbatim-'when the fee (if any) charged in connection with the request under Article 12(5) is paid.'
]).

citation(uk_gdpr_art_12a_3, [
    label-'UK GDPR Art 12A(3) (extension by notice by two further months)',
    ref-'uk-eur-2016-679-revised-2026-09-30#article-12A.-3',
    verbatim-'The controller may, by giving notice to the data subject, extend the applicable time period by two further months where that is necessary by reason of'
]).

citation(uk_gdpr_art_12a_3_a, [
    label-'UK GDPR Art 12A(3)(a) (extension ground: complexity of requests)',
    ref-'uk-eur-2016-679-revised-2026-09-30#article-12A.-3-a',
    verbatim-'the complexity of requests made by the data subject, or'
]).

citation(uk_gdpr_art_12a_3_b, [
    label-'UK GDPR Art 12A(3)(b) (extension ground: number of requests)',
    ref-'uk-eur-2016-679-revised-2026-09-30#article-12A.-3-b',
    verbatim-'the number of such requests.'
]).

citation(uk_gdpr_art_12a_4, [
    label-'UK GDPR Art 12A(4) (requirements of a notice of extension)',
    ref-'uk-eur-2016-679-revised-2026-09-30#article-12A.-4',
    verbatim-'A notice under paragraph 3 must'
]).

citation(uk_gdpr_art_12a_4_a, [
    label-'UK GDPR Art 12A(4)(a) (notice given before the end of the first month)',
    ref-'uk-eur-2016-679-revised-2026-09-30#article-12A.-4-a',
    verbatim-'be given before the end of the period of one month beginning with the relevant time, and'
]).

citation(uk_gdpr_art_12a_4_b, [
    label-'UK GDPR Art 12A(4)(b) (notice states the reasons for the delay)',
    ref-'uk-eur-2016-679-revised-2026-09-30#article-12A.-4-b',
    verbatim-'state the reasons for the delay.'
]).

citation(uk_gdpr_art_12a_5, [
    label-'UK GDPR Art 12A(5) (stop the clock: further information reasonably required for a request under Art 15)',
    ref-'uk-eur-2016-679-revised-2026-09-30#article-12A.-5',
    verbatim-'Where the controller reasonably requires further information in order to identify the information or processing activities to which a request under Article 15 relates'
]).

citation(uk_gdpr_art_12a_5_a, [
    label-'UK GDPR Art 12A(5)(a) (controller may ask for the further information)',
    ref-'uk-eur-2016-679-revised-2026-09-30#article-12A.-5-a',
    verbatim-'the controller may ask the data subject to provide the further information, and'
]).

citation(uk_gdpr_art_12a_5_b, [
    label-'UK GDPR Art 12A(5)(b) (days from asking to receiving do not count)',
    ref-'uk-eur-2016-679-revised-2026-09-30#article-12A.-5-b',
    verbatim-'the period beginning with the day on which the controller makes the request and ending with the day on which the controller receives the information does not count towards'
]).

citation(uk_gdpr_art_12a_5_b_i, [
    label-'UK GDPR Art 12A(5)(b)(i) (paused days do not count towards the applicable time period)',
    ref-'uk-eur-2016-679-revised-2026-09-30#article-12A.-5-b-i',
    verbatim-'the applicable time period, or'
]).

citation(uk_gdpr_art_12a_5_b_ii, [
    label-'UK GDPR Art 12A(5)(b)(ii) (paused days do not count towards the notice window of Art 12A(4)(a))',
    ref-'uk-eur-2016-679-revised-2026-09-30#article-12A.-5-b-ii',
    verbatim-'the period described in paragraph 4(a).'
]).

% ---- S.I. 2026/82: commencement and saving of s.76 -----------------

citation(uk_si_2026_82_reg_2, [
    label-'S.I. 2026/82 reg 2 (provisions of the 2025 Act coming into force on 5 February 2026)',
    ref-'uksi-2026-82-made#regulation-2',
    verbatim-'The following provisions of the 2025 Act, so far as not already in force, come into force on 5th February 2026'
]).

citation(uk_si_2026_82_reg_2_h, [
    label-'S.I. 2026/82 reg 2(h) (commencement of section 76, time limits for responding)',
    ref-'uksi-2026-82-made#regulation-2-h',
    verbatim-'section 76 (time limits for responding to data subjects'
]).

citation(uk_si_2026_82_reg_4, [
    label-'S.I. 2026/82 reg 4 (savings provisions relating to section 76)',
    ref-'uksi-2026-82-made#regulation-4',
    verbatim-'The amendments made by section 76 of the 2025 Act do not apply in relation to'
]).

citation(uk_si_2026_82_reg_4_a, [
    label-'S.I. 2026/82 reg 4(a) (saving for a request received before 5 February 2026)',
    ref-'uksi-2026-82-made#regulation-4-a',
    verbatim-'a case in which the controller received a request from a data subject under Chapter III of the UK GDPR (rights of the data subject) before 5th February 2026;'
]).

% ---- Data (Use and Access) Act 2025: when the search limit applies --

citation(uk_data_use_and_access_act_2025_section_78_5, [
    label-'Data (Use and Access) Act 2025 s.78(5) (search amendments treated as in force from 1 January 2024; deferred)',
    ref-'ukpga-2025-18-enacted#section-78-5',
    verbatim-'The amendments made by this section are to be treated as having come into force on 1 January 2024.'
]).

citation(uk_data_use_and_access_act_2025_section_142_2_b, [
    label-'Data (Use and Access) Act 2025 s.142(2)(b) (section 78 in force on the day the Act is passed; deferred)',
    ref-'ukpga-2025-18-enacted#section-142-2-b',
    verbatim-'section 78 (searches in response to data subjects'
]).

% ---- EU comparison limb ---------------------------------------------

citation(eu_reg_2016_679_art_12_3, [
    label-'Regulation (EU) 2016/679 (EU GDPR) Art 12(3) (one month of receipt, extendable by two further months)',
    ref-'02016R0679-20160504#parag_012.003',
    verbatim-'without undue delay and in any event within one month of receipt of the request. That period may be extended by two further months where necessary, taking into account the complexity and number of the requests.'
]).

citation(eu_reg_1971_1182_art_3_1, [
    label-'Regulation (EEC, Euratom) No 1182/71 Art 3(1) (day of the event not counted)',
    ref-'31971R1182#parag_003.001',
    verbatim-'the day during which that event occurs or that action takes place shall not be considered as falling within the period in question.'
]).

citation(eu_reg_1971_1182_art_3_2_c, [
    label-'Regulation (EEC, Euratom) No 1182/71 Art 3(2)(c) (end of a period expressed in months)',
    ref-'31971R1182#point_003.002_c',
    verbatim-'a period expressed in weeks, months or years shall start at the beginning of the first hour of the first day of the period, and shall end with the expiry of the last hour of whichever day in the last week, month or year is the same day of the week, or falls on the same date, as the day from which the period runs.'
]).

citation(eu_reg_1971_1182_art_3_4, [
    label-'Regulation (EEC, Euratom) No 1182/71 Art 3(4) (last day on a Saturday, Sunday or public holiday moves to the following working day)',
    ref-'31971R1182#parag_003.004',
    verbatim-'Where the last day of a period expressed otherwise than in hours is a public holiday, Sunday or Saturday, the period shall end with the expiry of the last hour of the following working day.'
]).

:- end_module(citations).
