% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_robustness.clausal -- ROBUSTNESS of the input check uk_subject_access_requests_input_problems/2 for a
% PROFILE that is an attribute list [attribute(Key, Value), ...]: an empty list, a
% value that is not a list, an unknown key and a value outside its type each get exactly
% one answer. Written by the scaffold from the order's typed input contract
% (input_contract.types.profile: attribute_list), not by the producer;
% do not edit or delete.
% Run: python -m clausal.testing uk/uk_subject_access_requests/tests/test_robustness.clausal
% =====================================================================
:- module(test_robustness, []).
:- use_module(uk/uk_subject_access_requests/queries, [uk_subject_access_requests_input_problems/2]).

test(an_empty_attribute_list_gets_exactly_one_answer) :-
    findall(Problems, uk_subject_access_requests_input_problems([], Problems), Answers),
    Answers == [[]].

test(a_profile_that_is_not_a_list_gets_one_non_empty_answer) :-
    findall(Problems, uk_subject_access_requests_input_problems(not_a_profile, Problems), Answers),
    Answers = [[_|_]].

test(an_unknown_key_is_named) :-
    findall(Problems, uk_subject_access_requests_input_problems([attribute(not_a_key_of_the_contract, true)], Problems), Answers),
    Answers = [Problems],
    memberchk(unknown_key(not_a_key_of_the_contract), Problems).

test(a_value_outside_the_type_of_item_described_in_article_15_1_is_named) :-
    findall(Problems, uk_subject_access_requests_input_problems([attribute(item_described_in_article_15_1, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(item_described_in_article_15_1), Problems).

test(a_value_outside_the_type_of_item_within_reasonable_and_proportionate_search_is_named) :-
    findall(Problems, uk_subject_access_requests_input_problems([attribute(item_within_reasonable_and_proportionate_search, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(item_within_reasonable_and_proportionate_search), Problems).

:- end_module(test_robustness).
