% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% uk_automated_decision_making.clausal -- the "uk_automated_decision_making" DETERMINATION for
% uk/uk_automated_decision_making, self-contained top to bottom.
%
% Source (drafter's reading, not a lawyer's):
%   UK GDPR Arts 22A, 22B and 22C (as substituted by s 80(1) Data (Use and
%   Access) Act 2025; in force for a decision taken on or after 5 February
%   2026), legislation.gov.uk 'Latest available (Revised)' text fetched
%   2026-11-15; comparison limb Regulation (EU) 2016/679 Art 22(1), (2)(a)
%   to (c) and (4), Formex consolidation 02016R0679-20160504.
%
% HOW THE ANSWERS ARE COMPUTED
%   Each query is a DECISION TREE over the keys it reads (the route
%   predicates below), one clause per route with the ground outcome in the
%   head. A key the caller gave as true or false is read as given; a key
%   that is absent, or a judgement given as unsure, is OPEN: the tree
%   branches on it only when a route actually reads it, and each branch is
%   one COMPLETION of the order's STATUS RULE. The answer is final when every
%   completion gives the same RESULT (the order: the final steps of each
%   query are exactly those cases), with the citation list FIXED for that
%   RESULT. Otherwise THE STATUS RULE names the first missing
%   key that can still change RESULT and is not behind another,
%   else refers the first unsure judgement that can still
%   change it.
% =====================================================================

:- module(uk_automated_decision_making, [
    decide_uk_automated_decision_making/2,
    uk_automated_decision_making_status/2,
    uk_automated_decision_making_checklist/2,
    uk_automated_decision_making_decision_resolvable/1,
    uk_automated_decision_making_status_values/1,
    uk_significant_automated_decision/3,
    uk_automated_decision_restriction/3,
    uk_automated_decision_safeguards/3,
    eu_automated_decision/3,
    compare_uk_eu_automated_decision/5,
    significant_decision_based_solely_on_automated_processing/0,
    not_a_significant_decision_based_solely_on_automated_processing/0,
    restrictions_not_engaged/0,
    decision_permitted/0,
    decision_prohibited/0,
    safeguards_not_required/0,
    required_safeguards_in_place/0,
    required_safeguards_not_in_place/0,
    same/0,
    differs/0,
    indeterminate/1,
    needs_legal_review/2,
    open_textured/2,
    inputs_relied_on/1,
    provenance/2,
    input_problems/1,
    unknown_key/1,
    wrong_type/1,
    duplicate_key/1
]).

:- use_module(library(reif), [if_/3]).
:- use_module(formalize_lib, [profile_get/3, profile_has/2, profile_lacks/2]).
:- use_module(uk/uk_automated_decision_making/kernel, [uk_automated_decision_making_input_problems/2]).
:- use_module(uk/uk_automated_decision_making/citations, [implements/1, citation/2]).

% ---- result constructors (exported data, no clauses) ------------------
:- constructors([indeterminate(missing_keys), needs_legal_review(reason, context), open_textured(input, citation), inputs_relied_on(pairs), input_problems(problems), unknown_key(key), wrong_type(key), duplicate_key(key)]).

% ---- result atoms (exported, never called as queries) ----------------
significant_decision_based_solely_on_automated_processing.
not_a_significant_decision_based_solely_on_automated_processing.
restrictions_not_engaged.
decision_permitted.
decision_prohibited.
safeguards_not_required.
required_safeguards_in_place.
required_safeguards_not_in_place.
same.
differs.

% ---- statutory VALUE facts owned by this determination ---------------
% The verdict vocabulary of the slice verdict (the UK Art 22B answer).
uk_automated_decision_making_status_values([restrictions_not_engaged, decision_permitted, decision_prohibited]).

% The deferred provisions: quoted and recorded for provenance, NEVER
% returned in a result (UK GDPR Art 22D, reading (9); EU Art 22(3);
% S.I. 2026/82 regs 2 and 5 and DUAA 2025 s 142, reading (10)).
deferred_provision(uk_secretary_of_state_powers, cite(uk_gdpr_art_22d_1)).
deferred_provision(uk_secretary_of_state_powers, cite(uk_gdpr_art_22d_2)).
deferred_provision(uk_secretary_of_state_powers, cite(uk_gdpr_art_22d_3)).
deferred_provision(uk_secretary_of_state_powers, cite(uk_gdpr_art_22d_3_a)).
deferred_provision(uk_secretary_of_state_powers, cite(uk_gdpr_art_22d_3_b)).
deferred_provision(uk_secretary_of_state_powers, cite(uk_gdpr_art_22d_3_c)).
deferred_provision(uk_secretary_of_state_powers, cite(uk_gdpr_art_22d_4)).
deferred_provision(uk_secretary_of_state_powers, cite(uk_gdpr_art_22d_5)).
deferred_provision(eu_safeguard_duty, cite(eu_reg_2016_679_art_22_3)).
deferred_provision(commencement, cite(uk_si_2026_82_regulation_2)).
deferred_provision(commencement, cite(uk_si_2026_82_regulation_2_j)).
deferred_provision(commencement, cite(uk_si_2026_82_regulation_2_z8)).
deferred_provision(commencement, cite(uk_si_2026_82_regulation_5)).
deferred_provision(commencement, cite(uk_data_use_and_access_act_2025_section_142_1)).
deferred_provision(commencement, cite(uk_data_use_and_access_act_2025_section_142_2)).
deferred_provision(commencement, cite(uk_data_use_and_access_act_2025_section_142_2_h)).

% The keys each query reads, in root_exports order.
query_keys(uk_significant_automated_decision, [
    meaningful_human_involvement_in_the_decision,
    decision_produces_a_legal_effect_for_the_data_subject,
    decision_has_a_similarly_significant_effect_for_the_data_subject
