    attribute(safeguards_enable_contesting, true)
]).
uk_automated_decision_making_profile_for(unsure_human_involvement_without_effect, [
    attribute(decision_based_entirely_or_partly_on_personal_data, true),
    attribute(meaningful_human_involvement_in_the_decision, unsure),
    attribute(decision_produces_a_legal_effect_for_the_data_subject, false),
    attribute(decision_has_a_similarly_significant_effect_for_the_data_subject, false),
    attribute(processing_for_the_decision_relies_on_article_6_1_ea, false),
    attribute(decision_based_entirely_or_partly_on_special_category_data, false),
    attribute(decision_based_entirely_on_processing_with_explicit_consent, false),
    attribute(uk_article_9_2_g_applies, false),
    attribute(decision_necessary_for_a_contract_with_the_data_subject, true),
    attribute(decision_required_or_authorised_by_law, false),
    attribute(decision_authorised_by_union_or_member_state_law_laying_down_suitable_measures, false),
    attribute(decision_based_on_explicit_consent, false),
    attribute(article_9_2_a_applies, false),
    attribute(eu_article_9_2_g_applies, false),
    attribute(suitable_measures_for_special_category_data_in_place, false),
    attribute(safeguards_provide_information_about_decisions, true),
    attribute(safeguards_enable_representations, true),
    attribute(safeguards_enable_human_intervention, true),
    attribute(safeguards_enable_contesting, true)
]).
uk_automated_decision_making_profile_for(badly_formed_profile, [
    attribute(meaningful_human_involvement_in_the_decision, maybe),
    attribute(colour, true)
]).
uk_automated_decision_making_profile_for(duplicated_key_profile, [
    attribute(meaningful_human_involvement_in_the_decision, false),
    attribute(meaningful_human_involvement_in_the_decision, true)
]).

% ---- Convenience wrapper ---------------------------------------------
uk_automated_decision_making_assess(Subject, Result) :-
    uk_automated_decision_making_profile_for(Subject, Profile),
    decide_uk_automated_decision_making(Profile, Result).

:- end_module(fixtures).
