% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% fixtures.clausal -- representative profiles for uk/uk_automated_decision_making.
% A TOP-LAYER consumer: it imports the determination slice's PUBLIC
% predicates it calls -- that is the whole import list. Profile keys and
% subject ids are atoms and need no import.
%
% A profile is an ATTRIBUTE LIST [attribute(Key, Value), ...] (the order's
% typed input contract). There is no numeric threshold in this domain, so
% each route has a positive subject and a ONE-KEY near-miss control: the
% control differs from its positive subject in exactly one key and gets
% the opposite (or another) verdict.
%
% The partial and unsure subjects state every key except the ones they
% exercise. A sparse profile leaves many keys open for the comparison, and
% its status rule then searches many completions.
%
% Expected answers (UK Art 22B restriction | EU Art 22 | DIFFERENCE):
%   ordinary_decision_permitted_with_safeguards_in_place
%       permitted | permitted | same; safeguards in place
%   ordinary_decision_missing_contesting_safeguard (one key: contesting)
%       safeguards not in place
%   ordinary_decision_without_personal_data (one key: personal data)
%       safeguards not required
%   human_involved_decision (one key: human involvement)
%       restrictions_not_engaged | restrictions_not_engaged | same
%   decision_without_legal_or_similar_effect (legal effect false)
%       not significant; restrictions_not_engaged
%   decision_with_similarly_significant_effect_only
%       significant via Art 22A(1)(b)(ii); permitted
%   recognised_legitimate_interest_prohibited (one key: Art 6(1)(ea))
%       prohibited | permitted | differs
%   special_category_without_condition_prohibited
%       prohibited | prohibited | same
%   special_category_with_explicit_consent_permitted (one key: consent)
%       permitted | prohibited | differs
%   special_category_contract_and_point_g_permitted
%       permitted | permitted | same
%   special_category_contract_without_point_g_prohibited (one key: UK 9(2)(g))
%       prohibited | permitted | differs
%   decision_without_european_exception (one key: contract)
%       permitted | prohibited | differs
%   partial_profile_missing_effect_keys (both effect keys absent)
%       -> indeterminate (Art 22A)
%   partial_profile_with_legal_effect (one key: legal effect true)
%       -> significant (its control)
%   unsure_human_involvement_referred -> needs_legal_review (Art 22A)
%   unsure_human_involvement_without_effect (one key: legal effect false)
%       -> not significant (control)
%   badly_formed_profile -> input_problems
%   duplicated_key_profile -> input_problems([duplicate_key(...)])
% =====================================================================

:- module(fixtures, [
    uk_automated_decision_making_subject/1,
    uk_automated_decision_making_profile_for/2,
    uk_automated_decision_making_assess/2
]).

:- use_module(uk/uk_automated_decision_making/uk_automated_decision_making, [decide_uk_automated_decision_making/2]).

% ---- Subject registry ------------------------------------------------
uk_automated_decision_making_subject(ordinary_decision_permitted_with_safeguards_in_place).
uk_automated_decision_making_subject(ordinary_decision_missing_contesting_safeguard).
uk_automated_decision_making_subject(ordinary_decision_without_personal_data).
uk_automated_decision_making_subject(human_involved_decision).
uk_automated_decision_making_subject(decision_without_legal_or_similar_effect).
uk_automated_decision_making_subject(decision_with_similarly_significant_effect_only).
uk_automated_decision_making_subject(recognised_legitimate_interest_prohibited).
uk_automated_decision_making_subject(special_category_without_condition_prohibited).
uk_automated_decision_making_subject(special_category_with_explicit_consent_permitted).
uk_automated_decision_making_subject(special_category_contract_and_point_g_permitted).
uk_automated_decision_making_subject(special_category_contract_without_point_g_prohibited).
uk_automated_decision_making_subject(decision_without_european_exception).
uk_automated_decision_making_subject(partial_profile_missing_effect_keys).
uk_automated_decision_making_subject(partial_profile_with_legal_effect).
uk_automated_decision_making_subject(unsure_human_involvement_referred).
uk_automated_decision_making_subject(unsure_human_involvement_without_effect).
uk_automated_decision_making_subject(badly_formed_profile).
uk_automated_decision_making_subject(duplicated_key_profile).

% ---- Profiles --------------------------------------------------------
uk_automated_decision_making_profile_for(ordinary_decision_permitted_with_safeguards_in_place, [
    attribute(decision_based_entirely_or_partly_on_personal_data, true),
    attribute(meaningful_human_involvement_in_the_decision, false),
    attribute(decision_produces_a_legal_effect_for_the_data_subject, true),
    attribute(decision_has_a_similarly_significant_effect_for_the_data_subject, false),
    attribute(processing_for_the_decision_relies_on_article_6_1_ea, false),
    attribute(decision_based_entirely_or_partly_on_special_category_data, false),
    attribute(decision_based_entirely_on_processing_with_explicit_consent, false),
    attribute(uk_article_9_2_g_applies, false),
    attribute(decision_necessary_for_a_contract_with_the_data_subject, true),
    attribute(decision_required_or_authorised_by_law, false),
    attribute(decision_authorised_by_union_or_member_state_law_laying_down_suitable_measures, false),
    attribute(decision_based_on_explicit_consent, false),
    attribute(article_9_2_a_applies, false),
    attribute(eu_article_9_2_g_applies, false),
    attribute(suitable_measures_for_special_category_data_in_place, false),
    attribute(safeguards_provide_information_about_decisions, true),
    attribute(safeguards_enable_representations, true),
    attribute(safeguards_enable_human_intervention, true),
    attribute(safeguards_enable_contesting, true)
]).
