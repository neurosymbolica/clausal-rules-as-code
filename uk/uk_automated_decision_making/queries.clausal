% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% queries.clausal -- QUERY-COMBINATOR layer for uk/uk_automated_decision_making.
% A TOP-LAYER consumer: it imports the determination slice's PUBLIC
% predicates it calls, and nothing else.
%
% Query-type coverage (the order's declared query types):
%   #3 status_determination -- uk_significant_automated_decision/3,
%        uk_automated_decision_restriction/3,
%        uk_automated_decision_safeguards/3 and eu_automated_decision/3,
%        defined in the determination slice uk_automated_decision_making
%        and re-exported by the package facade (one solution each; the
%        RESULT is one atom or the status compound itself).
%   #5 comparison -- compare_uk_eu_automated_decision/5, defined in the
%        slice: the UK Art 22B answer beside the EU Art 22 answer on ONE
%        profile, DIFFERENCE settled over every completion, CHANGED_BY the
%        fixed UK Art 22B citations when the answers differ and the UK
%        answer is final.
%   #7 justification -- uk_automated_decision_making_checklist/2 in the
%        slice: one formalize_lib item(Identifier, Status, cite(Key)) per
%        ground (Art 22A, Art 22B, Art 22C, EU Art 22), met items
%        included.
%   #16 what-if -- uk_automated_decision_making_what_if/4 below: one key
%        hypothetically overridden, the facade status re-evaluated.
%
% This file adds no rule: every answer comes from the slice. Open-textured
% judgements stay with the caller (unsure -> needs_legal_review).
%
% ROOT EXPORTS: the nineteen profile key atoms and the judgement value
% unsure are read by the test cases as package-root module attributes, so
% each is a bare atom defined and exported here (plumbing, no rule).
%
% uk_automated_decision_making_what_if/4      (#16 what-if): override one key -> re-evaluate
% uk_automated_decision_making_profile_keys/1: top-level profile key schema
% uk_automated_decision_making_input_problems/2: the problems a profile has ([] = none)
% =====================================================================

:- module(queries, [
    uk_automated_decision_making_profile_keys/1,
    uk_automated_decision_making_input_problems/2,
    uk_automated_decision_making_what_if/4,
    decision_based_entirely_or_partly_on_personal_data/0,
    meaningful_human_involvement_in_the_decision/0,
    decision_produces_a_legal_effect_for_the_data_subject/0,
    decision_has_a_similarly_significant_effect_for_the_data_subject/0,
    processing_for_the_decision_relies_on_article_6_1_ea/0,
    decision_based_entirely_or_partly_on_special_category_data/0,
    decision_based_entirely_on_processing_with_explicit_consent/0,
    uk_article_9_2_g_applies/0,
    decision_necessary_for_a_contract_with_the_data_subject/0,
    decision_required_or_authorised_by_law/0,
    decision_authorised_by_union_or_member_state_law_laying_down_suitable_measures/0,
    decision_based_on_explicit_consent/0,
    article_9_2_a_applies/0,
    eu_article_9_2_g_applies/0,
    suitable_measures_for_special_category_data_in_place/0,
    safeguards_provide_information_about_decisions/0,
    safeguards_enable_representations/0,
    safeguards_enable_human_intervention/0,
    safeguards_enable_contesting/0,
    unsure/0
]).

:- use_module(formalize_lib, [profile_has/2, profile_lacks/2]).
:- use_module(uk/uk_automated_decision_making/kernel, [uk_automated_decision_making_input_problems/2]).
:- use_module(uk/uk_automated_decision_making/uk_automated_decision_making, [uk_automated_decision_making_status/2]).

% ---- root exports: the profile key atoms and the judgement value -------
decision_based_entirely_or_partly_on_personal_data.
meaningful_human_involvement_in_the_decision.
decision_produces_a_legal_effect_for_the_data_subject.
decision_has_a_similarly_significant_effect_for_the_data_subject.
processing_for_the_decision_relies_on_article_6_1_ea.
decision_based_entirely_or_partly_on_special_category_data.
decision_based_entirely_on_processing_with_explicit_consent.
uk_article_9_2_g_applies.
decision_necessary_for_a_contract_with_the_data_subject.
decision_required_or_authorised_by_law.
decision_authorised_by_union_or_member_state_law_laying_down_suitable_measures.
decision_based_on_explicit_consent.
article_9_2_a_applies.
eu_article_9_2_g_applies.
suitable_measures_for_special_category_data_in_place.
safeguards_provide_information_about_decisions.
safeguards_enable_representations.
safeguards_enable_human_intervention.
safeguards_enable_contesting.
unsure.

% schema of top-level profile keys: the keys of the order's typed input contract, in its order
uk_automated_decision_making_profile_keys([decision_based_entirely_or_partly_on_personal_data, meaningful_human_involvement_in_the_decision, decision_produces_a_legal_effect_for_the_data_subject, decision_has_a_similarly_significant_effect_for_the_data_subject, processing_for_the_decision_relies_on_article_6_1_ea, decision_based_entirely_or_partly_on_special_category_data, decision_based_entirely_on_processing_with_explicit_consent, uk_article_9_2_g_applies, decision_necessary_for_a_contract_with_the_data_subject, decision_required_or_authorised_by_law, decision_authorised_by_union_or_member_state_law_laying_down_suitable_measures, decision_based_on_explicit_consent, article_9_2_a_applies, eu_article_9_2_g_applies, suitable_measures_for_special_category_data_in_place, safeguards_provide_information_about_decisions, safeguards_enable_representations, safeguards_enable_human_intervention, safeguards_enable_contesting]).

% #16 what-if: re-evaluate with one key hypothetically overridden.
% (a) THE LOGIC WAS WRONG: kit override_key/4 works on dicts, but this
% order's PROFILE is an attribute list, so the override is done here on
% the attribute list itself (plumbing, no rule).
uk_automated_decision_making_what_if(Profile, OverriddenKey, NewValue, NewStatus) :-
    attribute_override(Profile, OverriddenKey, NewValue, Hypothesis),
    uk_automated_decision_making_status(Hypothesis, NewStatus).

% attribute_override(Profile, Key, Value, Hypothesis): Key present -> its
% value replaced; Key absent -> attribute(Key, Value) appended.
attribute_override(Profile, Key, Value, Hypothesis) :-
    profile_has(Profile, Key),
    replace_attribute(Profile, Key, Value, Hypothesis).
attribute_override(Profile, Key, Value, Hypothesis) :-
    profile_lacks(Profile, Key),
    append(Profile, [attribute(Key, Value)], Hypothesis).

replace_attribute([], _, _, []).
replace_attribute([attribute(Key, _)|Attributes], Key, Value, [attribute(Key, Value)|NewAttributes]) :-
    replace_attribute(Attributes, Key, Value, NewAttributes).
replace_attribute([attribute(Other, OldValue)|Attributes], Key, Value, [attribute(Other, OldValue)|NewAttributes]) :-
    dif(Other, Key),
    replace_attribute(Attributes, Key, Value, NewAttributes).

:- end_module(queries).
