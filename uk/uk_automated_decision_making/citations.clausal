% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for uk/uk_automated_decision_making.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% Every record here is `status: verified` in citations-sources.yaml: its
% verbatim is copied from the pinned unit text named in the order
% (UK GDPR revised text fetched 2026-11-15; EU GDPR Formex consolidation
% 02016R0679-20160504, Article 22 extract; S.I. 2026/82 as made; Data
% (Use and Access) Act 2025 as enacted), without the paragraph or point
% number. In a quoted atom an apostrophe is written twice ('').
%
% A clause cites a key with a `cite(Key)` term; cite(...) is data and
% needs no import. Every operative clause opens its body with
% implements(Key), Key the provision for THAT condition.
%
% The keys of UK GDPR Arts 22A to 22C and EU GDPR Art 22(1), (2), (4)
% are the canonical lexicon keys (citation_vocabulary) and the ONLY keys
% an answer returns. The keys of the deferred provisions (UK GDPR Art
% 22D, EU GDPR Art 22(3), S.I. 2026/82 regs 2 and 5, Data (Use and
% Access) Act 2025 s 142) are recorded for provenance and markers only:
% they are NEVER returned in a result.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

% implements(Key): the provenance marker; succeeds exactly for a recorded key.
implements(Key) :-
    citation(Key, _).

% ---- UK GDPR Art 22A: solely automated, significant decision ----------
citation(uk_gdpr_art_22a_1, [label-'UK GDPR Art 22A(1) (definitions for the purposes of Articles 22B and 22C)', ref-'https://www.legislation.gov.uk/eur/2016/679/article/22A', verbatim-'For the purposes of Articles 22B and 22C—']).
citation(uk_gdpr_art_22a_1_a, [label-'UK GDPR Art 22A(1)(a) (definition of decision based solely on automated processing)', ref-'https://www.legislation.gov.uk/eur/2016/679/article/22A', verbatim-'a decision is based solely on automated processing if there is no meaningful human involvement in the taking of the decision']).
citation(uk_gdpr_art_22a_1_b, [label-'UK GDPR Art 22A(1)(b) (definition of significant decision)', ref-'https://www.legislation.gov.uk/eur/2016/679/article/22A', verbatim-'a decision is a significant decision, in relation to a data subject, if—']).
citation(uk_gdpr_art_22a_1_b_i, [label-'UK GDPR Art 22A(1)(b)(i) (significant decision: legal effect)', ref-'https://www.legislation.gov.uk/eur/2016/679/article/22A', verbatim-'it produces a legal effect for the data subject']).
citation(uk_gdpr_art_22a_1_b_ii, [label-'UK GDPR Art 22A(1)(b)(ii) (significant decision: similarly significant effect)', ref-'https://www.legislation.gov.uk/eur/2016/679/article/22A', verbatim-'it has a similarly significant effect for the data subject']).
citation(uk_gdpr_art_22a_2, [label-'UK GDPR Art 22A(2) (meaningful human involvement: extent of profiling to be considered)', ref-'https://www.legislation.gov.uk/eur/2016/679/article/22A', verbatim-'When considering whether there is meaningful human involvement in the taking of a decision, a person must consider, among other things, the extent to which the decision is reached by means of profiling.']).

% ---- UK GDPR Art 22B: restrictions ------------------------------------
citation(uk_gdpr_art_22b_1, [label-'UK GDPR Art 22B(1) (restriction: special categories of personal data)', ref-'https://www.legislation.gov.uk/eur/2016/679/article/22B', verbatim-'A significant decision based entirely or partly on processing described in Article 9(1) (processing of special categories of personal data) may not be taken based solely on automated processing, unless one of the following conditions is met.']).
citation(uk_gdpr_art_22b_2, [label-'UK GDPR Art 22B(2) (first condition: explicit consent)', ref-'https://www.legislation.gov.uk/eur/2016/679/article/22B', verbatim-'The first condition is that the decision is based entirely on processing of personal data to which the data subject has given explicit consent.']).
citation(uk_gdpr_art_22b_3, [label-'UK GDPR Art 22B(3) (second condition)', ref-'https://www.legislation.gov.uk/eur/2016/679/article/22B', verbatim-'The second condition is that—']).
citation(uk_gdpr_art_22b_3_a, [label-'UK GDPR Art 22B(3)(a) (second condition: contract or law)', ref-'https://www.legislation.gov.uk/eur/2016/679/article/22B', verbatim-'the decision is—']).
citation(uk_gdpr_art_22b_3_a_i, [label-'UK GDPR Art 22B(3)(a)(i) (second condition: necessary for a contract with the data subject)', ref-'https://www.legislation.gov.uk/eur/2016/679/article/22B', verbatim-'necessary for entering into, or performing, a contract between the data subject and a controller']).
citation(uk_gdpr_art_22b_3_a_ii, [label-'UK GDPR Art 22B(3)(a)(ii) (second condition: required or authorised by law)', ref-'https://www.legislation.gov.uk/eur/2016/679/article/22B', verbatim-'required or authorised by law']).
citation(uk_gdpr_art_22b_3_b, [label-'UK GDPR Art 22B(3)(b) (second condition: point (g) of Article 9(2) applies)', ref-'https://www.legislation.gov.uk/eur/2016/679/article/22B', verbatim-'point (g) of Article 9(2) applies.']).
citation(uk_gdpr_art_22b_4, [label-'UK GDPR Art 22B(4) (restriction: reliance on Article 6(1)(ea))', ref-'https://www.legislation.gov.uk/eur/2016/679/article/22B', verbatim-'A significant decision may not be taken based solely on automated processing if the processing of personal data carried out by, or on behalf of, the decision-maker for the purposes of the decision is carried out entirely or partly in reliance on Article 6(1)(ea).']).

% ---- UK GDPR Art 22C: safeguards --------------------------------------
citation(uk_gdpr_art_22c_1, [label-'UK GDPR Art 22C(1) (duty of the controller to ensure safeguards)', ref-'https://www.legislation.gov.uk/eur/2016/679/article/22C', verbatim-'Where a significant decision taken by or on behalf of a controller in relation to a data subject is—']).
citation(uk_gdpr_art_22c_1_a, [label-'UK GDPR Art 22C(1)(a) (decision based entirely or partly on personal data)', ref-'https://www.legislation.gov.uk/eur/2016/679/article/22C', verbatim-'based entirely or partly on personal data']).
citation(uk_gdpr_art_22c_1_b, [label-'UK GDPR Art 22C(1)(b) (decision based solely on automated processing)', ref-'https://www.legislation.gov.uk/eur/2016/679/article/22C', verbatim-'based solely on automated processing']).
citation(uk_gdpr_art_22c_2, [label-'UK GDPR Art 22C(2) (content of the safeguards)', ref-'https://www.legislation.gov.uk/eur/2016/679/article/22C', verbatim-'The safeguards must consist of or include measures which—']).
citation(uk_gdpr_art_22c_2_a, [label-'UK GDPR Art 22C(2)(a) (safeguard: information about decisions)', ref-'https://www.legislation.gov.uk/eur/2016/679/article/22C', verbatim-'provide the data subject with information about decisions described in paragraph 1 taken in relation to the data subject']).
citation(uk_gdpr_art_22c_2_b, [label-'UK GDPR Art 22C(2)(b) (safeguard: representations)', ref-'https://www.legislation.gov.uk/eur/2016/679/article/22C', verbatim-'enable the data subject to make representations about such decisions']).
citation(uk_gdpr_art_22c_2_c, [label-'UK GDPR Art 22C(2)(c) (safeguard: human intervention on the part of the controller)', ref-'https://www.legislation.gov.uk/eur/2016/679/article/22C', verbatim-'enable the data subject to obtain human intervention on the part of the controller in relation to such decisions']).
citation(uk_gdpr_art_22c_2_d, [label-'UK GDPR Art 22C(2)(d) (safeguard: contesting decisions)', ref-'https://www.legislation.gov.uk/eur/2016/679/article/22C', verbatim-'enable the data subject to contest such decisions']).

% ---- UK GDPR Art 22D: powers of the Secretary of State (deferred) -----
citation(uk_gdpr_art_22d_1, [label-'UK GDPR Art 22D(1) (regulations on meaningful human involvement; deferred)', ref-'https://www.legislation.gov.uk/eur/2016/679/article/22D', verbatim-'The Secretary of State may by regulations provide that, for the purposes of Article 22A(1)(a), there is, or is not, to be taken to be meaningful human involvement in the taking of a decision in cases described in the regulations.']).
citation(uk_gdpr_art_22d_2, [label-'UK GDPR Art 22D(2) (regulations on similarly significant effect; deferred)', ref-'https://www.legislation.gov.uk/eur/2016/679/article/22D', verbatim-'The Secretary of State may by regulations provide that, for the purposes of Article 22A(1)(b)(ii), a description of decision is, or is not, to be taken to have a similarly significant effect for the data subject.']).
citation(uk_gdpr_art_22d_3, [label-'UK GDPR Art 22D(3) (regulations about the Article 22C(1) safeguards; deferred)', ref-'https://www.legislation.gov.uk/eur/2016/679/article/22D', verbatim-'The Secretary of State may by regulations make the following types of provision about the safeguards required under Article 22C(1)—']).
citation(uk_gdpr_art_22d_3_a, [label-'UK GDPR Art 22D(3)(a) (additional safeguard measures; deferred)', ref-'https://www.legislation.gov.uk/eur/2016/679/article/22D', verbatim-'provision requiring the safeguards to include measures in addition to those described in Article 22C(2),']).
citation(uk_gdpr_art_22d_3_b, [label-'UK GDPR Art 22D(3)(b) (supplementary safeguard requirements; deferred)', ref-'https://www.legislation.gov.uk/eur/2016/679/article/22D', verbatim-'provision imposing requirements which supplement what Article 22C(2) requires the safeguards to consist of or include (including, for example, provision about how and when things described in Article 22C(2) must be done or be capable of being done), and']).
citation(uk_gdpr_art_22d_3_c, [label-'UK GDPR Art 22D(3)(c) (measures not to satisfy Article 22C(2); deferred)', ref-'https://www.legislation.gov.uk/eur/2016/679/article/22D', verbatim-'provision about measures which are not to be taken to satisfy one or more of points (a) to (d) of Article 22C(2).']).
citation(uk_gdpr_art_22d_4, [label-'UK GDPR Art 22D(4) (regulations may not amend Article 22C; deferred)', ref-'https://www.legislation.gov.uk/eur/2016/679/article/22D', verbatim-'Regulations under paragraph 3 may not amend Article 22C.']).
citation(uk_gdpr_art_22d_5, [label-'UK GDPR Art 22D(5) (affirmative resolution procedure; deferred)', ref-'https://www.legislation.gov.uk/eur/2016/679/article/22D', verbatim-'Regulations under this Article are subject to the affirmative resolution procedure.']).

% ---- EU GDPR Art 22: comparison limb ----------------------------------
citation(eu_reg_2016_679_art_22_1, [label-'Regulation (EU) 2016/679 Art 22(1) (right not to be subject to a decision based solely on automated processing)', ref-'https://eur-lex.europa.eu/eli/reg/2016/679/2016-05-04', verbatim-'The data subject shall have the right not to be subject to a decision based solely on automated processing, including profiling, which produces legal effects concerning him or her or similarly significantly affects him or her.']).
citation(eu_reg_2016_679_art_22_2, [label-'Regulation (EU) 2016/679 Art 22(2) (exceptions to paragraph 1)', ref-'https://eur-lex.europa.eu/eli/reg/2016/679/2016-05-04', verbatim-'Paragraph 1 shall not apply if the decision:']).
citation(eu_reg_2016_679_art_22_2_a, [label-'Regulation (EU) 2016/679 Art 22(2)(a) (exception: necessary for a contract)', ref-'https://eur-lex.europa.eu/eli/reg/2016/679/2016-05-04', verbatim-'is necessary for entering into, or performance of, a contract between the data subject and a data controller']).
citation(eu_reg_2016_679_art_22_2_b, [label-'Regulation (EU) 2016/679 Art 22(2)(b) (exception: authorised by Union or Member State law laying down suitable measures)', ref-'https://eur-lex.europa.eu/eli/reg/2016/679/2016-05-04', verbatim-'is authorised by Union or Member State law to which the controller is subject and which also lays down suitable measures to safeguard the data subject''s rights and freedoms and legitimate interests']).
citation(eu_reg_2016_679_art_22_2_c, [label-'Regulation (EU) 2016/679 Art 22(2)(c) (exception: explicit consent)', ref-'https://eur-lex.europa.eu/eli/reg/2016/679/2016-05-04', verbatim-'is based on the data subject''s explicit consent']).
citation(eu_reg_2016_679_art_22_3, [label-'Regulation (EU) 2016/679 Art 22(3) (controller safeguard duty; deferred)', ref-'https://eur-lex.europa.eu/eli/reg/2016/679/2016-05-04', verbatim-'In the cases referred to in points (a) and (c) of paragraph 2, the data controller shall implement suitable measures to safeguard the data subject''s rights and freedoms and legitimate interests, at least the right to obtain human intervention on the part of the controller, to express his or her point of view and to contest the decision.']).
citation(eu_reg_2016_679_art_22_4, [label-'Regulation (EU) 2016/679 Art 22(4) (special categories of personal data)', ref-'https://eur-lex.europa.eu/eli/reg/2016/679/2016-05-04', verbatim-'Decisions referred to in paragraph 2 shall not be based on special categories of personal data referred to in Article 9(1), unless point (a) or (g) of Article 9(2) applies and suitable measures to safeguard the data subject''s rights and freedoms and legitimate interests are in place.']).

% ---- S.I. 2026/82: commencement and saving (deferred; time scope) -----
citation(uk_si_2026_82_regulation_2, [label-'S.I. 2026/82 reg 2 (provisions of the 2025 Act coming into force on 5th February 2026; deferred)', ref-'https://www.legislation.gov.uk/uksi/2026/82/regulation/2/made', verbatim-'The following provisions of the 2025 Act, so far as not already in force, come into force on 5th February 2026—']).
citation(uk_si_2026_82_regulation_2_j, [label-'S.I. 2026/82 reg 2(j) (commencement of section 80, automated decision-making; deferred)', ref-'https://www.legislation.gov.uk/uksi/2026/82/regulation/2/made', verbatim-'section 80 (automated decision-making);']).
citation(uk_si_2026_82_regulation_2_z8, [label-'S.I. 2026/82 reg 2(z8) (commencement of Schedule 6; deferred)', ref-'https://www.legislation.gov.uk/uksi/2026/82/regulation/2/made', verbatim-'Schedule 6 (automated decision-making: minor and consequential amendments);']).
citation(uk_si_2026_82_regulation_5, [label-'S.I. 2026/82 reg 5 (saving provision relating to section 80 and Schedule 6; deferred)', ref-'https://www.legislation.gov.uk/uksi/2026/82/regulation/5/made', verbatim-'The amendments made by section 80 of, and Schedule 6 to, the 2025 Act do not apply in relation to any decision taken before 5th February 2026 to which Article 22(3) of the UK GDPR (automated individual decision-making, including profiling) or section 14 or 50(2) of the 2018 Act (automated decision-making authorised by law: safeguards) applied.']).

% ---- Data (Use and Access) Act 2025 s 142: commencement (deferred) ----
citation(uk_data_use_and_access_act_2025_section_142_1, [label-'Data (Use and Access) Act 2025 s 142(1) (commencement by regulations; deferred)', ref-'https://www.legislation.gov.uk/ukpga/2025/18/section/142/enacted', verbatim-'Except as provided by subsections (2) to (4), this Act comes into force on such day as the Secretary of State may by regulations appoint.']).
citation(uk_data_use_and_access_act_2025_section_142_2, [label-'Data (Use and Access) Act 2025 s 142(2) (provisions in force on the day the Act is passed; deferred)', ref-'https://www.legislation.gov.uk/ukpga/2025/18/section/142/enacted', verbatim-'The following provisions come into force on the day on which this Act is passed—']).
citation(uk_data_use_and_access_act_2025_section_142_2_h, [label-'Data (Use and Access) Act 2025 s 142(2)(h) (regulation-making powers in force on passing; deferred)', ref-'https://www.legislation.gov.uk/ukpga/2025/18/section/142/enacted', verbatim-'any other provision of this Act (including provision modifying other legislation) so far as it confers power to make regulations or is otherwise necessary for enabling the exercise of such a power on or after the day on which this Act is passed.']).

:- end_module(citations).
