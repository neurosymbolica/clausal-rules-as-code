% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% uk_pecr_cookie_exemptions_and_fines.clausal -- the uk_pecr_cookie_exemptions_and_fines DETERMINATION
% for uk/uk_pecr_cookie_exemptions_and_fines, self-contained top to bottom.
%
% Source (the drafter's reading, not a lawyer's): PECR (S.I. 2003/2426) as
% amended by the Data (Use and Access) Act 2025, revised text fetched
% 2026-11-15: reg 6(1), (2) and Schedule A1 paras 1 to 7 (cookies);
% reg 5(1), reg 5A(1), (2), (3A) with Reg 611/2013 Art 2(2) and Reg 1182/71
% Art 3 (breach notification time); Schedule 1 paras 1 and 18 with DPA 2018
% s.157(2), (4), (5), (6) (maximum penalty); S.I. 2025/904 reg 2(p) and
% S.I. 2026/82 reg 11 (versions). Own EU limb: Directive 2002/58/EC Art 5(3)
% and Art 2(f), for comparison only.
%
% THE STATUS RULE is applied through a STATE: each own key of a query maps
% to true, false or unknown (absent or unsure). A query is SETTLED when the
% set of answers its completions can give has one member. An unknown key
% MATTERS when two completions differing only in it give different answers;
% for the cookie limbs this is decided exactly by a witness completion
% (the decision function is a gate plus a monotone set of ways). The breach
% and penalty queries follow their ladders (B-1..B-5, T-1..T-3, M-1..M-9).
% =====================================================================

:- module(uk_pecr_cookie_exemptions_and_fines, [
    decide_uk_pecr_cookie_exemptions_and_fines/2,
    uk_pecr_cookie_exemptions_and_fines_status/2,
    uk_pecr_cookie_exemptions_and_fines_checklist/2,
    uk_pecr_cookie_exemptions_and_fines_decision_resolvable/1,
    uk_pecr_cookie_exemptions_and_fines_status_values/1,
    uk_terminal_equipment_storage_or_access/3,
    eu_terminal_equipment_storage_or_access/3,
    compare_uk_eu_terminal_equipment_storage_or_access/5,
    uk_breach_notification_timing/3,
    uk_penalty_maximum_tier/3,
    uk_penalty_maximum_amount_in_pence/3
]).

:- use_module(library(clpz)).
:- use_module(library(reif), [memberd_t/3]).
:- use_module(formalize_lib, [profile_get/3, profile_has/2, profile_lacks/2]).
:- use_module(uk/uk_pecr_cookie_exemptions_and_fines/kernel, [uk_pecr_cookie_exemptions_and_fines_input_problems/2]).
:- use_module(uk/uk_pecr_cookie_exemptions_and_fines/citations, [implements/1]).

% ---- statutory VALUE facts owned by this determination ---------------
% reg 5A(2): 72 hours, counted under Reg 611/2013 Art 2(2) and Reg 1182/71 Art 3.
:- constant_value(breach_notification_period_hours, 72).
% DPA 2018 s.157(5) and (6), in pence and whole per cent.
:- constant_value(higher_maximum_fixed_pence, 1750000000).
:- constant_value(higher_maximum_turnover_percent, 4).
:- constant_value(standard_maximum_fixed_pence, 870000000).
:- constant_value(standard_maximum_turnover_percent, 2).

uk_pecr_cookie_exemptions_and_fines_status_values([permitted, not_permitted, not_applicable]).

% The gate of each cookie side (reg 6(1) with reg 6(2); Art 5(3) first sentence).
side_gate(uk, storage_or_access_within_regulation_6).
side_gate(eu, storage_or_access_in_terminal_equipment).

other_side(uk, eu).
other_side(eu, uk).

% The role of each cookie key on its side.
side_key_role(uk, storage_or_access_within_regulation_6, gate).
side_key_role(uk, clear_and_comprehensive_information_about_the_purpose_provided, way).
side_key_role(uk, consent_to_the_storage_or_access_given, way).
side_key_role(uk, technical_storage_or_access_solely_for_transmission_of_a_communication, way).
side_key_role(uk, information_society_service_requested_by_the_subscriber_or_user, way).
side_key_role(uk, storage_or_access_strictly_necessary_for_the_requested_service, way).
side_key_role(uk, person_provides_an_information_society_service, way).
side_key_role(uk, sole_purpose_is_statistical_information_to_improve_the_service_or_website, way).
side_key_role(uk, collected_information_shared_only_to_assist_with_improvements, way).
side_key_role(uk, access_does_not_collect_or_monitor_automatically_emitted_information, way).
side_key_role(uk, simple_free_means_of_objecting_given, way).
side_key_role(uk, subscriber_or_user_has_not_objected, way).
side_key_role(uk, person_provides_an_information_society_service_by_means_of_a_website, way).
side_key_role(uk, sole_purpose_is_adapting_or_enhancing_website_appearance_or_functionality, way).
side_key_role(uk, communication_received_requests_or_indicates_need_of_emergency_assistance, way).
side_key_role(uk, sole_purpose_is_ascertaining_geographical_position_for_emergency_assistance, way).
side_key_role(eu, storage_or_access_in_terminal_equipment, gate).
side_key_role(eu, storage_or_access_solely_for_transmission, way).
side_key_role(eu, service_explicitly_requested_by_user, way).
side_key_role(eu, strictly_necessary_to_provide_requested_service, way).
side_key_role(eu, user_consent_given, way).
side_key_role(eu, clear_and_comprehensive_information_provided, way).

% THE WAYS (readings C2 to C8 and E1): any one way whose keys are all true lifts the prohibition.
side_way(uk, consent,
    [clear_and_comprehensive_information_about_the_purpose_provided,
     consent_to_the_storage_or_access_given],
    cite(uk_si_2003_2426_sch_a1_para_2_1)).
side_way(uk, transmission,
    [technical_storage_or_access_solely_for_transmission_of_a_communication],
    cite(uk_si_2003_2426_sch_a1_para_3)).
side_way(uk, strictly_necessary,
    [information_society_service_requested_by_the_subscriber_or_user,
     storage_or_access_strictly_necessary_for_the_requested_service],
    cite(uk_si_2003_2426_sch_a1_para_4_1)).
side_way(uk, statistical_purposes,
    [clear_and_comprehensive_information_about_the_purpose_provided,
     person_provides_an_information_society_service,
     sole_purpose_is_statistical_information_to_improve_the_service_or_website,
     collected_information_shared_only_to_assist_with_improvements,
     access_does_not_collect_or_monitor_automatically_emitted_information,
     simple_free_means_of_objecting_given,
     subscriber_or_user_has_not_objected],
    cite(uk_si_2003_2426_sch_a1_para_5_1)).
side_way(uk, website_appearance_or_functionality,
    [clear_and_comprehensive_information_about_the_purpose_provided,
     simple_free_means_of_objecting_given,
     subscriber_or_user_has_not_objected,
     person_provides_an_information_society_service_by_means_of_a_website,
     sole_purpose_is_adapting_or_enhancing_website_appearance_or_functionality],
    cite(uk_si_2003_2426_sch_a1_para_6_1)).
side_way(uk, emergency_assistance,
    [communication_received_requests_or_indicates_need_of_emergency_assistance,
     sole_purpose_is_ascertaining_geographical_position_for_emergency_assistance],
    cite(uk_si_2003_2426_sch_a1_para_7)).
side_way(eu, transmission,
    [storage_or_access_solely_for_transmission],
    cite(eu_dir_2002_58_art_5_3_s2)).
side_way(eu, strictly_necessary,
    [service_explicitly_requested_by_user,
     strictly_necessary_to_provide_requested_service],
    cite(eu_dir_2002_58_art_5_3_s2)).
side_way(eu, consent,
    [user_consent_given,
     clear_and_comprehensive_information_provided],
    cite(eu_dir_2002_58_art_5_3_s1)).

