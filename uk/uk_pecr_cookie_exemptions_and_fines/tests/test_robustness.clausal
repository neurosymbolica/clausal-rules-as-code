% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_robustness.clausal -- ROBUSTNESS of the input check uk_pecr_cookie_exemptions_and_fines_input_problems/2 for a
% PROFILE that is an attribute list [attribute(Key, Value), ...]: an empty list, a
% value that is not a list, an unknown key and a value outside its type each get exactly
% one answer. Written by the scaffold from the order's typed input contract
% (input_contract.types.profile: attribute_list), not by the producer;
% do not edit or delete.
% Run: python -m clausal.testing uk/uk_pecr_cookie_exemptions_and_fines/tests/test_robustness.clausal
% =====================================================================
:- module(test_robustness, []).
:- use_module(uk/uk_pecr_cookie_exemptions_and_fines/queries, [uk_pecr_cookie_exemptions_and_fines_input_problems/2]).

test(an_empty_attribute_list_gets_exactly_one_answer) :-
    findall(Problems, uk_pecr_cookie_exemptions_and_fines_input_problems([], Problems), Answers),
    Answers == [[]].

test(a_profile_that_is_not_a_list_gets_one_non_empty_answer) :-
    findall(Problems, uk_pecr_cookie_exemptions_and_fines_input_problems(not_a_profile, Problems), Answers),
    Answers = [[_|_]].

test(an_unknown_key_is_named) :-
    findall(Problems, uk_pecr_cookie_exemptions_and_fines_input_problems([attribute(not_a_key_of_the_contract, true)], Problems), Answers),
    Answers = [Problems],
    memberchk(unknown_key(not_a_key_of_the_contract), Problems).

test(a_value_outside_the_type_of_storage_or_access_within_regulation_6_is_named) :-
    findall(Problems, uk_pecr_cookie_exemptions_and_fines_input_problems([attribute(storage_or_access_within_regulation_6, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(storage_or_access_within_regulation_6), Problems).

test(a_value_outside_the_type_of_subscriber_or_user_has_not_objected_is_named) :-
    findall(Problems, uk_pecr_cookie_exemptions_and_fines_input_problems([attribute(subscriber_or_user_has_not_objected, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(subscriber_or_user_has_not_objected), Problems).

test(a_value_outside_the_type_of_hours_elapsed_at_notification_is_named) :-
    findall(Problems, uk_pecr_cookie_exemptions_and_fines_input_problems([attribute(hours_elapsed_at_notification, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(hours_elapsed_at_notification), Problems).

test(a_value_outside_the_type_of_provision_infringed_is_named) :-
    findall(Problems, uk_pecr_cookie_exemptions_and_fines_input_problems([attribute(provision_infringed, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(provision_infringed), Problems).

:- end_module(test_robustness).
