]).

% Result constructors: data, no clauses.
:- constructors([indeterminate(missing_keys), needs_legal_review(reason, context), open_textured(input, citation), cross_reference_unresolved(citation, target), resolution(target, outcome), inputs_relied_on(pairs), provenance(source, detail), input_problems(problems), unknown_key(key), wrong_type(key), duplicate_key(key)]).

:- use_module(formalize_lib, [profile_get/3]).
:- use_module(uk/uk_pecr_cookie_exemptions_and_fines/kernel, [uk_pecr_cookie_exemptions_and_fines_input_problems/2]).
:- use_module(uk/uk_pecr_cookie_exemptions_and_fines/citations, [implements/1]).
:- use_module(uk/uk_pecr_cookie_exemptions_and_fines/uk_pecr_cookie_exemptions_and_fines, [
