<akomaNtoso xmlns="http://docs.oasis-open.org/legaldocml/ns/akn/3.0" xmlns:uk="https://www.legislation.gov.uk/namespaces/UK-AKN" xmlns:ukl="http://www.legislation.gov.uk/namespaces/legislation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://docs.oasis-open.org/legaldocml/ns/akn/3.0 http://docs.oasis-open.org/legaldocml/akn-core/v1.0/cos01/part2-specs/schemas/akomantoso30.xsd"><act name="uksi"><meta><identification source="#"><FRBRWork><FRBRthis value="http://www.legislation.gov.uk/id/uksi/2003/2426" /><FRBRuri value="http://www.legislation.gov.uk/id/uksi/2003/2426" /><FRBRdate date="2003-09-18" name="made" /><FRBRauthor href="http://www.legislation.gov.uk/id/government/uk" /><FRBRcountry value="GB-UKM" /><FRBRsubtype value="regulation" /><FRBRnumber value="2426" /><FRBRname value="S.I. 2003/2426" /><FRBRprescriptive value="true" /></FRBRWork><FRBRExpression><FRBRthis value="http://www.legislation.gov.uk/uksi/2003/2426/2026-09-30" /><FRBRuri value="http://www.legislation.gov.uk/uksi/2003/2426/2026-09-30" /><FRBRdate date="2026-09-30" name="validFrom" /><FRBRauthor href="#" /><FRBRlanguage language="eng" /></FRBRExpression><FRBRManifestation><FRBRthis value="http://www.legislation.gov.uk/uksi/2003/2426/2026-09-30/data.akn" /><FRBRuri value="http://www.legislation.gov.uk/uksi/2003/2426/2026-09-30/data.akn" /><FRBRdate date="2026-11-15Z" name="transform" /><FRBRauthor href="http://www.legislation.gov.uk" /><FRBRformat value="application/akn+xml" /></FRBRManifestation></identification></meta><body><hcontainer name="regulation" eId="regulation-6A"><heading><ins class="first" ukl:ChangeId="key-056820daafcc3aad9384cf1d7366c6d6-1750934194257" ukl:CommentaryRef="key-056820daafcc3aad9384cf1d7366c6d6"><noteRef uk:name="commentary" href="#key-056820daafcc3aad9384cf1d7366c6d6" class="commentary" />Power to provide exceptions to regulation 6(1)</ins></heading><num><ins ukl:ChangeId="key-056820daafcc3aad9384cf1d7366c6d6-1750934194257" ukl:CommentaryRef="key-056820daafcc3aad9384cf1d7366c6d6">6A.</ins></num><paragraph eId="regulation-6A-1"><num><ins ukl:ChangeId="key-056820daafcc3aad9384cf1d7366c6d6-1750934194257" ukl:CommentaryRef="key-056820daafcc3aad9384cf1d7366c6d6">(1)</ins></num><intro><p><ins ukl:ChangeId="key-056820daafcc3aad9384cf1d7366c6d6-1750934194257" ukl:CommentaryRef="key-056820daafcc3aad9384cf1d7366c6d6">The Secretary of State may by regulations made by statutory instrument—</ins></p></intro><level class="para1" eId="regulation-6A-1-a"><num><ins ukl:ChangeId="key-056820daafcc3aad9384cf1d7366c6d6-1750934194257" ukl:CommentaryRef="key-056820daafcc3aad9384cf1d7366c6d6">(a)</ins></num><intro><p><ins ukl:ChangeId="key-056820daafcc3aad9384cf1d7366c6d6-1750934194257" ukl:CommentaryRef="key-056820daafcc3aad9384cf1d7366c6d6">amend these Regulations—</ins></p></intro><level class="para2" eId="regulation-6A-1-a-i"><num><ins ukl:ChangeId="key-056820daafcc3aad9384cf1d7366c6d6-1750934194257" ukl:CommentaryRef="key-056820daafcc3aad9384cf1d7366c6d6">(i)</ins></num><content><p><ins ukl:ChangeId="key-056820daafcc3aad9384cf1d7366c6d6-1750934194257" ukl:CommentaryRef="key-056820daafcc3aad9384cf1d7366c6d6">by adding an exception to the prohibition in regulation 6(1), or</ins></p></content></level><level class="para2" eId="regulation-6A-1-a-ii"><num><ins ukl:ChangeId="key-056820daafcc3aad9384cf1d7366c6d6-1750934194257" ukl:CommentaryRef="key-056820daafcc3aad9384cf1d7366c6d6">(ii)</ins></num><content><p><ins ukl:ChangeId="key-056820daafcc3aad9384cf1d7366c6d6-1750934194257" ukl:CommentaryRef="key-056820daafcc3aad9384cf1d7366c6d6">by omitting or varying an exception to that prohibition, and</ins></p></content></level></level><level class="para1" eId="regulation-6A-1-b"><num><ins ukl:ChangeId="key-056820daafcc3aad9384cf1d7366c6d6-1750934194257" ukl:CommentaryRef="key-056820daafcc3aad9384cf1d7366c6d6">(b)</ins></num><content><p><ins ukl:ChangeId="key-056820daafcc3aad9384cf1d7366c6d6-1750934194257" ukl:CommentaryRef="key-056820daafcc3aad9384cf1d7366c6d6">make consequential, supplementary, incidental, transitional, transitory or saving provision, including provision amending these Regulations.</ins></p></content></level></paragraph><paragraph eId="regulation-6A-2"><num><ins ukl:ChangeId="key-056820daafcc3aad9384cf1d7366c6d6-1750934194257" ukl:CommentaryRef="key-056820daafcc3aad9384cf1d7366c6d6">(2)</ins></num><content><p><ins ukl:ChangeId="key-056820daafcc3aad9384cf1d7366c6d6-1750934194257" ukl:CommentaryRef="key-056820daafcc3aad9384cf1d7366c6d6">Regulations under paragraph (1) may make different provision for different purposes.</ins></p></content></paragraph><paragraph eId="regulation-6A-3"><num><ins ukl:ChangeId="key-056820daafcc3aad9384cf1d7366c6d6-1750934194257" ukl:CommentaryRef="key-056820daafcc3aad9384cf1d7366c6d6">(3)</ins></num><intro><p><ins ukl:ChangeId="key-056820daafcc3aad9384cf1d7366c6d6-1750934194257" ukl:CommentaryRef="key-056820daafcc3aad9384cf1d7366c6d6">Before making regulations under paragraph (1), the Secretary of State must consult—</ins></p></intro><level class="para1" eId="regulation-6A-3-a"><num><ins ukl:ChangeId="key-056820daafcc3aad9384cf1d7366c6d6-1750934194257" ukl:CommentaryRef="key-056820daafcc3aad9384cf1d7366c6d6">(a)</ins></num><content><p><ins ukl:ChangeId="key-056820daafcc3aad9384cf1d7366c6d6-1750934194257" ukl:CommentaryRef="key-056820daafcc3aad9384cf1d7366c6d6">the Information  </ins><ins ukl:ChangeId="key-056820daafcc3aad9384cf1d7366c6d6-1750934194257" ukl:CommentaryRef="key-056820daafcc3aad9384cf1d7366c6d6"><ins class="substitution first last" ukl:ChangeId="key-6a217b2824b4678530c04674f2a4e73e-1790696476910" ukl:CommentaryRef="key-6a217b2824b4678530c04674f2a4e73e"><noteRef uk:name="commentary" href="#key-6a217b2824b4678530c04674f2a4e73e" class="commentary" />Commission</ins></ins><ins ukl:ChangeId="key-056820daafcc3aad9384cf1d7366c6d6-1750934194257" ukl:CommentaryRef="key-056820daafcc3aad9384cf1d7366c6d6">, and</ins></p></content></level><level class="para1" eId="regulation-6A-3-b"><num><ins ukl:ChangeId="key-056820daafcc3aad9384cf1d7366c6d6-1750934194257" ukl:CommentaryRef="key-056820daafcc3aad9384cf1d7366c6d6">(b)</ins></num><content><p><ins ukl:ChangeId="key-056820daafcc3aad9384cf1d7366c6d6-1750934194257" ukl:CommentaryRef="key-056820daafcc3aad9384cf1d7366c6d6">such other persons as the Secretary of State considers appropriate.</ins></p></content></level></paragraph><paragraph eId="regulation-6A-4"><num><ins ukl:ChangeId="key-056820daafcc3aad9384cf1d7366c6d6-1750934194257" ukl:CommentaryRef="key-056820daafcc3aad9384cf1d7366c6d6">(4)</ins></num><content><p><ins class="last" ukl:ChangeId="key-056820daafcc3aad9384cf1d7366c6d6-1750934194257" ukl:CommentaryRef="key-056820daafcc3aad9384cf1d7366c6d6">A statutory instrument containing regulations under paragraph (1) may not be made unless a draft of the instrument has been laid before, and approved by a resolution of, each House of Parliament.</ins></p></content></paragraph></hcontainer></body></act></akomaNtoso>