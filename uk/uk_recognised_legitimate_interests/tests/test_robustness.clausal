% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_robustness.clausal -- ROBUSTNESS of the input check uk_recognised_legitimate_interests_input_problems/2 for a
% PROFILE that is an attribute list [attribute(Key, Value), ...]: an empty list, a
% value that is not a list, an unknown key and a value outside its type each get exactly
% one answer. Written by the scaffold from the order's typed input contract
% (input_contract.types.profile: attribute_list), not by the producer;
% do not edit or delete.
% Run: python -m clausal.testing uk/uk_recognised_legitimate_interests/tests/test_robustness.clausal
% =====================================================================
:- module(test_robustness, []).
:- use_module(uk/uk_recognised_legitimate_interests/queries, [uk_recognised_legitimate_interests_input_problems/2]).

test(an_empty_attribute_list_gets_exactly_one_answer) :-
    findall(Problems, uk_recognised_legitimate_interests_input_problems([], Problems), Answers),
    Answers == [[]].

test(a_profile_that_is_not_a_list_gets_one_non_empty_answer) :-
    findall(Problems, uk_recognised_legitimate_interests_input_problems(not_a_profile, Problems), Answers),
    Answers = [[_|_]].

test(an_unknown_key_is_named) :-
    findall(Problems, uk_recognised_legitimate_interests_input_problems([attribute(not_a_key_of_the_contract, true)], Problems), Answers),
    Answers = [Problems],
    memberchk(unknown_key(not_a_key_of_the_contract), Problems).

test(a_value_outside_the_type_of_processing_by_a_public_authority_in_the_performance_of_its_tasks_is_named) :-
    findall(Problems, uk_recognised_legitimate_interests_input_problems([attribute(processing_by_a_public_authority_in_the_performance_of_its_tasks, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(processing_by_a_public_authority_in_the_performance_of_its_tasks), Problems).

test(a_value_outside_the_type_of_request_states_need_for_article_6_1_e_processing_with_article_6_3_basis_is_named) :-
    findall(Problems, uk_recognised_legitimate_interests_input_problems([attribute(request_states_need_for_article_6_1_e_processing_with_article_6_3_basis, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(request_states_need_for_article_6_1_e_processing_with_article_6_3_basis), Problems).

test(a_value_outside_the_type_of_basis_relied_on_is_named) :-
    findall(Problems, uk_recognised_legitimate_interests_input_problems([attribute(basis_relied_on, outside_the_type)], Problems), Answers),
    Answers = [Problems],
    memberchk(wrong_type(basis_relied_on), Problems).

:- end_module(test_robustness).
