% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for uk/uk_recognised_legitimate_interests.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order:
%   citation(Key, [label-'...', ref-'...', verbatim-'...']).
% Every record below is `status: verified` in citations-sources.yaml: its
% verbatim is an exact substring of the pinned unit text named there.
%
% Pins (author's reading, not a lawyer's):
%   UK: uk-eur-2016-679-revised-2026-09-30, legislation.gov.uk 'Latest
%       available (Revised)' text, Akoma Ntoso, fetched 2026-11-13; no 'up
%       to date as at' date on the page, so the pin date is the fetch date.
%       Art 6 sha256 e540f3487fd07c70c3ed47f41c81363d09c60565b49434bde2166370501d7778;
%       Annex 1 sha256 5f3cead09f2a385cb3f3a28a3ffc72081f1cba1cd3540226f9c40a953c140e45;
%       Art 21 sha256 aa6605432e6180f3cc26cacff6eb8fc4768a048e3d473ef259b7b51b7aadb82f.
%   EU: 02016R0679-20160504, Formex consolidation, Article 6 extract,
%       sha256 9ff4f05a60ab2f27b3ba7c105ee7d803dd8cf4276cf3535cf2e682effbb4ebaa.
%
% The Art 6(1) second subparagraph (the public-authority bar) has no unit of
% its own in either pin: its words are part of the paragraph unit, so
% uk_gdpr_art_6_1 and eu_reg_2016_679_art_6_1 name it.
%
% Deferred (reading (9)): S.I. 2026/82 reg 2(c) and (z6) and Data (Use and
% Access) Act 2025 s.142(1), (2), (2)(h) are pinned but no rule decides or
% applies them (the order has no date argument), so no key is minted.
%
% lint: the citation keys are the canonical lexicon atoms (_lexicon/citations.yaml),
% mandated verbatim by the order's CITATION VOCABULARY; never shorten or re-spell them.
%
% PROVENANCE: every operative clause opens its body with implements(Key).
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

% implements(Key): the provenance marker; succeeds for every recorded key and
% fails for a key not recorded here.
implements(Key) :-
    citation(Key, _).

% ---- UK GDPR Article 6 -------------------------------------------------

citation(uk_gdpr_art_6_1, [label-'UK GDPR Art 6(1), including the second subparagraph (public authorities: points (ea) and (f) shall not apply)', ref-'https://www.legislation.gov.uk/eur/2016/679/article/6', verbatim-'Points (ea) and (f) of the first subparagraph shall not apply to processing carried out by public authorities in the performance of their tasks.']).

citation(uk_gdpr_art_6_1_ea, [label-'UK GDPR Art 6(1) point (ea) (recognised legitimate interest)', ref-'https://www.legislation.gov.uk/eur/2016/679/article/6', verbatim-'processing is necessary for the purposes of a recognised legitimate interest;']).

citation(uk_gdpr_art_6_1_f, [label-'UK GDPR Art 6(1) point (f) (legitimate interests)', ref-'https://www.legislation.gov.uk/eur/2016/679/article/6', verbatim-'processing is necessary for the purposes of the legitimate interests pursued by the controller or by a third party, except where such interests are overridden by the interests or fundamental rights and freedoms of the data subject which require protection of personal data, in particular where the data subject is a child.']).

citation(uk_gdpr_art_6_5, [label-'UK GDPR Art 6(5) (recognised legitimate interest only if a condition in Annex 1 is met)', ref-'https://www.legislation.gov.uk/eur/2016/679/article/6', verbatim-'For the purposes of paragraph 1(ea), processing is necessary for the purposes of a recognised legitimate interest only if it meets a condition in Annex 1.']).

% ---- UK GDPR Annex 1 (recognised legitimate interests) -----------------

citation(uk_gdpr_annex_1_para_1, [label-'UK GDPR Annex 1 paragraph 1(a) and (b) (condition 1: disclosure in response to a request for Art 6(1)(e) processing)', ref-'https://www.legislation.gov.uk/eur/2016/679/annex/1', verbatim-'the processing is necessary for the purposes of making a disclosure of personal data to another person in response to a request from the other person']).

citation(uk_gdpr_annex_1_para_2, [label-'UK GDPR Annex 1 paragraph 2(a) to (c) (condition 2: national security, public security or defence)', ref-'https://www.legislation.gov.uk/eur/2016/679/annex/1', verbatim-'for the purposes of safeguarding national security']).

citation(uk_gdpr_annex_1_para_3, [label-'UK GDPR Annex 1 paragraph 3 (condition 3: responding to an emergency)', ref-'https://www.legislation.gov.uk/eur/2016/679/annex/1', verbatim-'This condition is met where the processing is necessary for the purposes of responding to an emergency.']).

citation(uk_gdpr_annex_1_para_4, [label-'UK GDPR Annex 1 paragraph 4 (definition of emergency: Part 2 of the Civil Contingencies Act 2004)', ref-'https://www.legislation.gov.uk/eur/2016/679/annex/1', verbatim-'has the same meaning as in Part 2 of the Civil Contingencies Act 2004']).

citation(uk_gdpr_annex_1_para_5, [label-'UK GDPR Annex 1 paragraph 5(a) and (b) (condition 4: crime and offenders)', ref-'https://www.legislation.gov.uk/eur/2016/679/annex/1', verbatim-'detecting, investigating or preventing crime']).

citation(uk_gdpr_annex_1_para_6, [label-'UK GDPR Annex 1 paragraph 6 (condition 5: safeguarding a vulnerable individual)', ref-'https://www.legislation.gov.uk/eur/2016/679/annex/1', verbatim-'This condition is met where the processing is necessary for the purposes of safeguarding a vulnerable individual.']).

citation(uk_gdpr_annex_1_para_7, [label-'UK GDPR Annex 1 paragraph 7 (definitions of safeguarding and vulnerable individual)', ref-'https://www.legislation.gov.uk/eur/2016/679/annex/1', verbatim-'protecting a vulnerable individual from neglect or physical, mental or emotional harm']).

citation(uk_gdpr_annex_1_para_8, [label-'UK GDPR Annex 1 paragraph 8(a) and 8(b)(i) to (iii) (protection of a type of individual; definition of at risk)', ref-'https://www.legislation.gov.uk/eur/2016/679/annex/1', verbatim-'includes both protection relating to a particular individual and protection relating to a type of individual']).

% ---- UK GDPR Article 21 ------------------------------------------------

citation(uk_gdpr_art_21_1, [label-'UK GDPR Art 21(1) (right to object to processing based on point (e), (ea) or (f) of Art 6(1))', ref-'https://www.legislation.gov.uk/eur/2016/679/article/21', verbatim-'The controller shall no longer process the personal data unless the controller demonstrates compelling legitimate grounds for the processing which override the interests, rights and freedoms of the data subject or for the establishment, exercise or defence of legal claims.']).

% ---- Regulation (EU) 2016/679 Article 6 (comparison limb) --------------

citation(eu_reg_2016_679_art_6_1, [label-'Regulation (EU) 2016/679 Art 6(1), including the second subparagraph (public authorities: point (f) shall not apply)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'Point (f) of the first subparagraph shall not apply to processing carried out by public authorities in the performance of their tasks.']).

citation(eu_reg_2016_679_art_6_1_f, [label-'Regulation (EU) 2016/679 Art 6(1) point (f) (legitimate interests)', ref-'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02016R0679-20160504', verbatim-'processing is necessary for the purposes of the legitimate interests pursued by the controller or by a third party, except where such interests are overridden by the interests or fundamental rights and freedoms of the data subject which require protection of personal data, in particular where the data subject is a child.']).

:- end_module(citations).
