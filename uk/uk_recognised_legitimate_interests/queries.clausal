% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% queries.clausal -- QUERY-COMBINATOR layer for uk/uk_recognised_legitimate_interests.
% A TOP-LAYER consumer: it imports the determination slice's PUBLIC
% predicates it calls, and nothing else.
%
% Query types this domain serves (author's reading, not a lawyer's):
%   #3 status_determination -- recognised_legitimate_interest/3 and the
%      facade decide_uk_recognised_legitimate_interests/2 and
%      uk_recognised_legitimate_interests_status/2 (in the slice);
%   #5 comparison -- compare_uk_eu_legitimate_interest_basis/5 (in the
%      slice: the UK answer beside the EU answer on ONE profile);
%   #7 justification -- uk_recognised_legitimate_interests_checklist/2 (in
%      the slice: one item(RequirementId, Status, cite(Key)) per row);
%   #16 what-if -- uk_recognised_legitimate_interests_what_if/4 below.
%
% uk_recognised_legitimate_interests_what_if/4      (#16 what-if): override one key -> re-evaluate
% uk_recognised_legitimate_interests_profile_keys/1: top-level profile key schema
% uk_recognised_legitimate_interests_input_problems/2: the problems a profile has ([] = none)
%
% ROOT EXPORTS: the seventeen profile key atoms and the judgement value
% unsure are read by callers as package-root attributes, so each is a bare
% atom (a 0-arity fact) exported here. The four enumeration atoms of
% basis_relied_on are exported by the determination slice.
%
% The profile is an ATTRIBUTE LIST [attribute(Key, Value), ...] (the
% order's typed input contract), so the what-if replaces every attribute of
% the overridden key with one new attribute; it reads no value itself.
% =====================================================================

:- module(queries, [
    uk_recognised_legitimate_interests_profile_keys/1,
    uk_recognised_legitimate_interests_input_problems/2,
    uk_recognised_legitimate_interests_what_if/4,
    processing_by_a_public_authority_in_the_performance_of_its_tasks/0,
    processing_necessary_for_a_disclosure_in_response_to_a_request/0,
    request_states_need_for_article_6_1_e_processing_with_article_6_3_basis/0,
    processing_necessary_for_national_security_public_security_or_defence/0,
    event_is_an_emergency_within_part_2_of_the_civil_contingencies_act_2004/0,
    processing_necessary_for_responding_to_the_emergency/0,
    processing_necessary_for_detecting_investigating_or_preventing_crime_or_apprehending_or_prosecuting_offenders/0,
    processing_necessary_for_safeguarding_an_individual/0,
    individual_aged_under_18/0,
    controller_has_reasonable_cause_to_suspect_the_individual_is_at_risk/0,
    legitimate_interest_pursued_by_the_controller_or_a_third_party/0,
    processing_necessary_for_that_legitimate_interest/0,
    interests_overridden_by_data_subject_interests_or_fundamental_rights/0,
    basis_relied_on/0,
    objection_on_grounds_relating_to_particular_situation/0,
    controller_demonstrates_compelling_legitimate_grounds_that_override/0,
    processing_for_establishment_exercise_or_defence_of_legal_claims/0,
    unsure/0
]).

:- use_module(uk/uk_recognised_legitimate_interests/kernel, [uk_recognised_legitimate_interests_input_problems/2]).
:- use_module(uk/uk_recognised_legitimate_interests/uk_recognised_legitimate_interests, [uk_recognised_legitimate_interests_status/2]).

% schema of top-level profile keys: the keys of the order's typed input contract, in its order
uk_recognised_legitimate_interests_profile_keys([processing_by_a_public_authority_in_the_performance_of_its_tasks, processing_necessary_for_a_disclosure_in_response_to_a_request, request_states_need_for_article_6_1_e_processing_with_article_6_3_basis, processing_necessary_for_national_security_public_security_or_defence, event_is_an_emergency_within_part_2_of_the_civil_contingencies_act_2004, processing_necessary_for_responding_to_the_emergency, processing_necessary_for_detecting_investigating_or_preventing_crime_or_apprehending_or_prosecuting_offenders, processing_necessary_for_safeguarding_an_individual, individual_aged_under_18, controller_has_reasonable_cause_to_suspect_the_individual_is_at_risk, legitimate_interest_pursued_by_the_controller_or_a_third_party, processing_necessary_for_that_legitimate_interest, interests_overridden_by_data_subject_interests_or_fundamental_rights, basis_relied_on, objection_on_grounds_relating_to_particular_situation, controller_demonstrates_compelling_legitimate_grounds_that_override, processing_for_establishment_exercise_or_defence_of_legal_claims]).

% ---- root exports: the profile key atoms and the judgement value -------
processing_by_a_public_authority_in_the_performance_of_its_tasks.
processing_necessary_for_a_disclosure_in_response_to_a_request.
request_states_need_for_article_6_1_e_processing_with_article_6_3_basis.
processing_necessary_for_national_security_public_security_or_defence.
event_is_an_emergency_within_part_2_of_the_civil_contingencies_act_2004.
processing_necessary_for_responding_to_the_emergency.
processing_necessary_for_detecting_investigating_or_preventing_crime_or_apprehending_or_prosecuting_offenders.
processing_necessary_for_safeguarding_an_individual.
individual_aged_under_18.
controller_has_reasonable_cause_to_suspect_the_individual_is_at_risk.
legitimate_interest_pursued_by_the_controller_or_a_third_party.
processing_necessary_for_that_legitimate_interest.
interests_overridden_by_data_subject_interests_or_fundamental_rights.
basis_relied_on.
objection_on_grounds_relating_to_particular_situation.
controller_demonstrates_compelling_legitimate_grounds_that_override.
processing_for_establishment_exercise_or_defence_of_legal_claims.
unsure.

% #16 what-if: re-evaluate with one key hypothetically overridden.
% The hypothesis is the profile without any attribute of the key, plus one
% attribute(Key, Value): list plumbing only, no statutory decision.
uk_recognised_legitimate_interests_what_if(Profile, OverriddenKey, NewValue, NewStatus) :-
    is_list(Profile),
    profile_without_key(Profile, OverriddenKey, OtherAttributes),
    append(OtherAttributes, [attribute(OverriddenKey, NewValue)], Hypothesis),
    uk_recognised_legitimate_interests_status(Hypothesis, NewStatus).

profile_without_key([], _, []).
profile_without_key([attribute(Key, _)|Attributes], OverriddenKey, Remaining) :-
    Key == OverriddenKey,
    profile_without_key(Attributes, OverriddenKey, Remaining).
profile_without_key([attribute(Key, Value)|Attributes], OverriddenKey, [attribute(Key, Value)|Remaining]) :-
    Key \== OverriddenKey,
    profile_without_key(Attributes, OverriddenKey, Remaining).

% ---- tests -----------------------------------------------------------
test(what_if_public_authority_turns_applies_into_does_not_apply) :-
    findall(Status,
            uk_recognised_legitimate_interests_what_if(
                [attribute(processing_by_a_public_authority_in_the_performance_of_its_tasks, false),
                 attribute(processing_necessary_for_national_security_public_security_or_defence, true)],
                processing_by_a_public_authority_in_the_performance_of_its_tasks,
                true,
                Status),
            Statuses),
    Statuses == [recognised_legitimate_interest_does_not_apply].
test(what_if_not_a_public_authority_applies) :-
    findall(Status,
            uk_recognised_legitimate_interests_what_if(
                [attribute(processing_necessary_for_national_security_public_security_or_defence, true)],
                processing_by_a_public_authority_in_the_performance_of_its_tasks,
                false,
                Status),
            Statuses),
    Statuses == [recognised_legitimate_interest_applies].
test(what_if_not_a_public_authority_is_not_does_not_apply, fail) :-
    uk_recognised_legitimate_interests_what_if(
        [attribute(processing_necessary_for_national_security_public_security_or_defence, true)],
        processing_by_a_public_authority_in_the_performance_of_its_tasks,
        false,
        recognised_legitimate_interest_does_not_apply).
test(profile_keys_are_seventeen) :-
    uk_recognised_legitimate_interests_profile_keys(Keys),
    length(Keys, 17).
test(root_export_atoms_hold) :-
    unsure,
    basis_relied_on,
    individual_aged_under_18.

:- end_module(queries).
