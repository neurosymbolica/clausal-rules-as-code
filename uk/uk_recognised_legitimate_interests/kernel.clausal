% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% kernel.clausal -- the SHARED FLOOR for uk/uk_recognised_legitimate_interests (deontic family).
% DAG root of the determination-slices layout. It holds ONLY the
% PREDICATES that two or more files CALL. The one predicate here is the
% order's input check uk_recognised_legitimate_interests_input_problems/2,
% which the scaffold writes here, exported, for the slice and the query
% layer to import.
%
% Sources (author's reading, not a lawyer's):
%   UK GDPR Art 6(1) points (ea) and (f) and the second subparagraph,
%   Art 6(5), Annex 1 paragraphs 1 to 8, and Art 21(1), pinned unit text
%   of uk-eur-2016-679-revised-2026-09-30 (legislation.gov.uk 'Latest
%   available (Revised)', Akoma Ntoso, fetched 2026-11-13);
%   Regulation (EU) 2016/679 Art 6(1) point (f) and the second
%   subparagraph, Formex consolidation 02016R0679-20160504, Article 6
%   extract.
% The law is stated as it applies from 5 February 2026 (S.I. 2026/82
% reg 2(c) and (z6)); no rule here reads a date.
%
% deontic family: STATUS is a modal vocabulary (cf.
% eu/procurement/exclusion_grounds must_exclude/may_exclude/not_excluded).
%
% Atoms and data terms need NO declaration and NO import. The comment
% block below only RECORDS the result terms so every file spells them
% alike.
%
% RESULT TERMS.
%   uk_recognised_legitimate_interests_verdict(Status, Citations)
%     the slice's verdict term (decide_* facade). Status is the RESULT of
%     recognised_legitimate_interest/3: recognised_legitimate_interest_applies,
%     recognised_legitimate_interest_does_not_apply, or a status compound
%     itself. Citations is a set-like list of cite(Key) terms ([] when the
%     answer is not final).
%   Final answer atoms by query:
%     recognised_legitimate_interest/3: recognised_legitimate_interest_applies |
%       recognised_legitimate_interest_does_not_apply
%     uk_legitimate_interests/3 and eu_legitimate_interests/3:
%       legitimate_interests_applies | legitimate_interests_does_not_apply
%     uk_legitimate_interest_basis/3 and both sides of
%     compare_uk_eu_legitimate_interest_basis/5:
%       legitimate_interest_basis_available | legitimate_interest_basis_not_available
%     compare_uk_eu_legitimate_interest_basis/5 DIFFERENCE:
%       same | differs | not_comparable
%     uk_right_to_object/3: objection_right_not_engaged |
%       controller_must_no_longer_process | controller_may_continue_processing
%   Not-final status compounds (written as the answer itself, never in a list):
%     indeterminate([Key])  -- one bare key atom, the first missing key in
%       root_exports order;
%     needs_legal_review(open_textured(Key, cite(CitationKey)), [inputs_relied_on(Pairs)])
%       -- Pairs a flat list of Key-Value terms of the present keys of the
%       firing referral row, in root_exports order;
%     input_problems(Problems) -- Problems the non-empty list this check gives.
%   Problem terms of the input check: duplicate_key(Key), wrong_type(Key),
%     unknown_key(Key), and wrong_type(profile) alone for a profile that is
%     not an attribute list.
%   Checklist rows: item(RequirementId, Status, cite(Key)) from formalize_lib.
%
% NOTHING SINGLE-CALLER LIVES HERE. A predicate only ONE file calls is
% defined in THAT file.
% =====================================================================

:- module(kernel, [uk_recognised_legitimate_interests_input_problems/2]).

:- use_module(library(reif), [memberd_t/3]).

% ---- input checks: the problems a profile has, if any -----------
% uk_recognised_legitimate_interests_input_problems(Profile, Problems): Problems = [] means the profile can be
% judged. Written from the order's typed input contract
% (input_contract.types.profile: attribute_list) and INTERFACE - THE INPUT CHECK.
% Each public query calls this check first: it gives its normal answer only when
% Problems = [], and when Problems is not [] it gives the answer the order states for
% a profile with input problems.
% It gives exactly one answer for every Profile:
% - a Profile that is not an attribute list [attribute(Key, Value), ...] (an unbound
%   Profile, a partial list, an unbound element, or any element that is not
%   attribute(Key, Value)) gives [wrong_type(profile)];
% - otherwise, for each contract key in the contract's key order, duplicate_key(Key) when
%   the key occurs more than once in Profile (whatever its values: none of them is read,
%   so it is never also wrong_type(Key)), else wrong_type(Key) when its one value is
%   outside its type (an unbound value included); then unknown_key(Key) for each key
%   outside the contract, in the order of its first occurrence in Profile. A Key that is
%   not an atom (a number, a string, a compound, an unbound variable) is a key outside
%   the contract and is named as given (the order's rule: INTERFACE - THE INPUT CHECK).
%   Each key is named once. An absent key is not a problem.
% Every step is complementary clauses: exactly one clause holds for each input.
uk_recognised_legitimate_interests_input_problems(Profile, Problems) :-
    attribute_list_t(Profile, IsAttributeList),
    profile_problems(IsAttributeList, Profile, Problems).

profile_problems(false, _, [wrong_type(profile)]).
profile_problems(true, Profile, Problems) :-
    Keys = [processing_by_a_public_authority_in_the_performance_of_its_tasks, processing_necessary_for_a_disclosure_in_response_to_a_request, request_states_need_for_article_6_1_e_processing_with_article_6_3_basis, processing_necessary_for_national_security_public_security_or_defence, event_is_an_emergency_within_part_2_of_the_civil_contingencies_act_2004, processing_necessary_for_responding_to_the_emergency, processing_necessary_for_detecting_investigating_or_preventing_crime_or_apprehending_or_prosecuting_offenders, processing_necessary_for_safeguarding_an_individual, individual_aged_under_18, controller_has_reasonable_cause_to_suspect_the_individual_is_at_risk, legitimate_interest_pursued_by_the_controller_or_a_third_party, processing_necessary_for_that_legitimate_interest, interests_overridden_by_data_subject_interests_or_fundamental_rights, basis_relied_on, objection_on_grounds_relating_to_particular_situation, controller_demonstrates_compelling_legitimate_grounds_that_override, processing_for_establishment_exercise_or_defence_of_legal_claims],
    unknown_keys(Profile, Keys, UnknownKeyProblems),
    key_problems(Keys, Profile, UnknownKeyProblems, Problems).

% The contract: each key and the type of its value.
key_type(processing_by_a_public_authority_in_the_performance_of_its_tasks, judgement).
key_type(processing_necessary_for_a_disclosure_in_response_to_a_request, judgement).
key_type(request_states_need_for_article_6_1_e_processing_with_article_6_3_basis, boolean).
key_type(processing_necessary_for_national_security_public_security_or_defence, judgement).
key_type(event_is_an_emergency_within_part_2_of_the_civil_contingencies_act_2004, judgement).
key_type(processing_necessary_for_responding_to_the_emergency, judgement).
key_type(processing_necessary_for_detecting_investigating_or_preventing_crime_or_apprehending_or_prosecuting_offenders, judgement).
key_type(processing_necessary_for_safeguarding_an_individual, judgement).
key_type(individual_aged_under_18, boolean).
key_type(controller_has_reasonable_cause_to_suspect_the_individual_is_at_risk, judgement).
key_type(legitimate_interest_pursued_by_the_controller_or_a_third_party, judgement).
key_type(processing_necessary_for_that_legitimate_interest, judgement).
key_type(interests_overridden_by_data_subject_interests_or_fundamental_rights, judgement).
key_type(basis_relied_on, enum([public_task, recognised_legitimate_interest, legitimate_interests, other_basis])).
key_type(objection_on_grounds_relating_to_particular_situation, judgement).
key_type(controller_demonstrates_compelling_legitimate_grounds_that_override, judgement).
key_type(processing_for_establishment_exercise_or_defence_of_legal_claims, judgement).

% attribute_list_t(Term, T): T is true when Term is a proper list of attribute(Key, Value)
% items; false for anything else, an unbound Term, a partial list or an unbound element
% included. The Key of an item may be any term: a Key that is not a contract atom is an
% unknown key, not a malformed profile.
attribute_list_t(Term, false) :-
    var(Term).
attribute_list_t(Term, true) :-
    Term == [].
attribute_list_t(Term, T) :-
    nonvar(Term),
    Term = [Element|Elements],
    attribute_t(Element, ElementIsAttribute),
    attribute_list_t(Elements, ElementsAreAttributes),
    truth_and(ElementIsAttribute, ElementsAreAttributes, T).
attribute_list_t(Term, false) :-
    nonvar(Term),
    Term \== [],
    Term \= [_|_].

attribute_t(Element, false) :-
    var(Element).
attribute_t(Element, true) :-
    nonvar(Element),
    Element = attribute(_, _).
attribute_t(Element, false) :-
    nonvar(Element),
    Element \= attribute(_, _).

% Unknown keys, in profile order, each once: Known grows by each key named. Keys are
% compared by identity (==), so an unbound or compound key never unifies with another.
unknown_keys([], _, []).
unknown_keys([attribute(Key, _)|Elements], Known, Problems) :-
    identical_member_t(Key, Known, IsKnown),
    name_unknown_key(IsKnown, Key, Known, Elements, Problems).

name_unknown_key(true, _, Known, Elements, Problems) :-
    unknown_keys(Elements, Known, Problems).
name_unknown_key(false, Key, Known, Elements, [unknown_key(Key)|Problems]) :-
    unknown_keys(Elements, [Key|Known], Problems).

% identical_member_t(Item, List, Truth): Truth is true when a member of List is
% identical (==) to Item, false otherwise. Exactly one clause holds per step.
identical_member_t(_, [], false).
identical_member_t(Item, [Candidate|_], true) :-
    Item == Candidate.
identical_member_t(Item, [Candidate|Candidates], Truth) :-
    Item \== Candidate,
    identical_member_t(Item, Candidates, Truth).

% Contract keys, in contract order: duplicate_key(Key) when the key occurs more than once
% (none of its values is read), else wrong_type(Key) when its one value is outside the
% key's type. An absent key has no value to check.
key_problems([], _, Problems, Problems).
key_problems([Key|Keys], Profile, LaterProblems, Problems) :-
    key_type(Key, Type),
    key_occurrences(Profile, Key, Occurrences),
    key_problems(Keys, Profile, LaterProblems, KeyProblems),
    name_key_problem(Occurrences, Key, Type, Profile, KeyProblems, Problems).

% key_occurrences(Elements, Key, Occurrences): none, one or many items give Key.
key_occurrences([], _, none).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey == Key,
    key_occurrences(Elements, Key, RestOccurrences),
    one_more_occurrence(RestOccurrences, Occurrences).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey \== Key,
    key_occurrences(Elements, Key, Occurrences).

one_more_occurrence(none, one).
one_more_occurrence(one, many).
one_more_occurrence(many, many).

name_key_problem(none, _, _, _, Problems, Problems).
name_key_problem(many, Key, _, _, Problems, [duplicate_key(Key)|Problems]).
name_key_problem(one, Key, Type, Profile, KeyProblems, Problems) :-
    values_in_type_t(Profile, Key, Type, InType),
    name_wrong_type(InType, Key, KeyProblems, Problems).

name_wrong_type(true, _, Problems, Problems).
name_wrong_type(false, Key, Problems, [wrong_type(Key)|Problems]).

% values_in_type_t(Elements, Key, Type, T): T is true when every value Elements gives Key is
% in Type (true when Elements gives Key none).
values_in_type_t([], _, _, true).
values_in_type_t([attribute(ElementKey, Value)|Elements], Key, Type, T) :-
    ElementKey == Key,
    value_in_type_t(Type, Value, ValueInType),
    values_in_type_t(Elements, Key, Type, RestInType),
    truth_and(ValueInType, RestInType, T).
values_in_type_t([attribute(ElementKey, _)|Elements], Key, Type, T) :-
    ElementKey \== Key,
    values_in_type_t(Elements, Key, Type, T).

% A value with an unbound part is outside every type; a ground one is checked.
value_in_type_t(Type, Value, T) :-
    term_variables(Value, Variables),
    ground_value_in_type_t(Variables, Type, Value, T).

ground_value_in_type_t([_|_], _, _, false).
ground_value_in_type_t([], Type, Value, T) :-
    in_type_t(Type, Value, T).

% in_type_t(Type, Value, T): one clause per type, for a ground Value.
in_type_t(judgement, Value, T) :-
    in_type_t(one_of([boolean, enum([unsure])]), Value, T).

in_type_t(boolean, Value, T) :-
    memberd_t(Value, [true, false], T).

in_type_t(enum(Values), Value, T) :-
    memberd_t(Value, Values, T).

in_type_t(one_of(Types), Value, T) :-
    in_some_type_t(Types, Value, T).

truth_and(true, T, T).
truth_and(false, _, false).

% in_some_type_t(Types, Value, T): T is true when Value is in at least one of Types.
in_some_type_t([], _, false).
in_some_type_t([Type|Types], Value, T) :-
    in_type_t(Type, Value, InType),
    in_some_type_t(Types, Value, InAnother),
    truth_or(InType, InAnother, T).

truth_or(true, _, true).
truth_or(false, T, T).

:- end_module(kernel).
