% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for cn/pipl_handler_duties.
%
% Instrument: 中华人民共和国个人信息保护法 (Personal Information Protection
% Law of the People's Republic of China), 2021 adoption text, pinned unit
% text cn-pipl-2021 taken from the npc.gov.cn page (source label: compared
% on 2026-11-15 with the People's Daily copy and the CAC
% full-text copy, article by article for Arts 3, 51-59, 73-74: identical,
% whitespace-insensitive; not a gazette; later amendments not established).
% The CHINESE text governs; every English label is the drafter's own gloss
% and is not authoritative (Q18).
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys exactly label, ref, verbatim, in that order. Each
% verbatim is an exact substring of the pinned unit text (the item numbers
% （一） etc. are left out, so the quoted words stand alone).
%
% Keys are the canonical lexicon keys (_lexicon/citations.yaml) of the
% order's citation_vocabulary, and only those: the units no limb reads
% (Art 3(1), Art 73 items (3) and (4)) are deferred and get no record.
%
% PROVENANCE: every operative clause opens its body with implements(Key),
% Key a key recorded here; implements/1 succeeds for every recorded key and
% fails for any other.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1,
    citation_vocabulary/1,
    duty_primary_citation/2
]).

% ---- Article 3 paragraph 2 (territorial scope; read only by Article 53) ----
citation(cn_pipl_art_3_p2, [label-'PIPL (2021) Art 3 para 2 (processing outside the territory of the personal information of natural persons within the territory)', ref-'cn-pipl-2021#art_3_p2', verbatim-'在中华人民共和国境外处理中华人民共和国境内自然人个人信息的活动，有下列情形之一的，也适用本法：']).
citation(cn_pipl_art_3_p2_i1, [label-'PIPL (2021) Art 3 para 2 item (1) (purpose of providing products or services to natural persons within the territory)', ref-'cn-pipl-2021#art_3_p2_i1', verbatim-'以向境内自然人提供产品或者服务为目的；']).
citation(cn_pipl_art_3_p2_i2, [label-'PIPL (2021) Art 3 para 2 item (2) (analysing or evaluating the conduct of natural persons within the territory)', ref-'cn-pipl-2021#art_3_p2_i2', verbatim-'分析、评估境内自然人的行为；']).
citation(cn_pipl_art_3_p2_i3, [label-'PIPL (2021) Art 3 para 2 item (3) (other cases prescribed by laws or administrative regulations)', ref-'cn-pipl-2021#art_3_p2_i3', verbatim-'法律、行政法规规定的其他情形。']).

% ---- Article 51 (compliance measures) ----
citation(cn_pipl_art_51_p1, [label-'PIPL (2021) Art 51 (duty of a personal information handler to take compliance measures)', ref-'cn-pipl-2021#art_51_p1', verbatim-'个人信息处理者应当根据个人信息的处理目的、处理方式、个人信息的种类以及对个人权益的影响、可能存在的安全风险等，采取下列措施确保个人信息处理活动符合法律、行政法规的规定，并防止未经授权的访问以及个人信息泄露、篡改、丢失：']).
citation(cn_pipl_art_51_p1_i1, [label-'PIPL (2021) Art 51 item (1) (internal management rules and operating procedures)', ref-'cn-pipl-2021#art_51_p1_i1', verbatim-'制定内部管理制度和操作规程；']).
citation(cn_pipl_art_51_p1_i2, [label-'PIPL (2021) Art 51 item (2) (classified management of personal information)', ref-'cn-pipl-2021#art_51_p1_i2', verbatim-'对个人信息实行分类管理；']).
citation(cn_pipl_art_51_p1_i3, [label-'PIPL (2021) Art 51 item (3) (encryption, de-identification and other security technical measures)', ref-'cn-pipl-2021#art_51_p1_i3', verbatim-'采取相应的加密、去标识化等安全技术措施；']).
citation(cn_pipl_art_51_p1_i4, [label-'PIPL (2021) Art 51 item (4) (operating permissions and staff security education and training)', ref-'cn-pipl-2021#art_51_p1_i4', verbatim-'合理确定个人信息处理的操作权限，并定期对从业人员进行安全教育和培训；']).
citation(cn_pipl_art_51_p1_i5, [label-'PIPL (2021) Art 51 item (5) (emergency plan for personal information security incidents)', ref-'cn-pipl-2021#art_51_p1_i5', verbatim-'制定并组织实施个人信息安全事件应急预案；']).
citation(cn_pipl_art_51_p1_i6, [label-'PIPL (2021) Art 51 item (6) (other measures prescribed by laws or administrative regulations)', ref-'cn-pipl-2021#art_51_p1_i6', verbatim-'法律、行政法规规定的其他措施。']).

% ---- Article 52 (person in charge of personal information protection) ----
citation(cn_pipl_art_52_p1, [label-'PIPL (2021) Art 52 para 1 (designating a person in charge of personal information protection on reaching the prescribed quantity)', ref-'cn-pipl-2021#art_52_p1', verbatim-'处理个人信息达到国家网信部门规定数量的个人信息处理者应当指定个人信息保护负责人，负责对个人信息处理活动以及采取的保护措施等进行监督。']).
citation(cn_pipl_art_52_p2, [label-'PIPL (2021) Art 52 para 2 (publishing and reporting the contact details of the person in charge)', ref-'cn-pipl-2021#art_52_p2', verbatim-'个人信息处理者应当公开个人信息保护负责人的联系方式，并将个人信息保护负责人的姓名、联系方式等报送履行个人信息保护职责的部门。']).

% ---- Article 53 (dedicated body or representative within the territory) ----
citation(cn_pipl_art_53_p1, [label-'PIPL (2021) Art 53 (dedicated body or representative within the territory of a handler outside the territory)', ref-'cn-pipl-2021#art_53_p1', verbatim-'本法第三条第二款规定的中华人民共和国境外的个人信息处理者，应当在中华人民共和国境内设立专门机构或者指定代表，负责处理个人信息保护相关事务，并将有关机构的名称或者代表的姓名、联系方式等报送履行个人信息保护职责的部门。']).

% ---- Article 54 (compliance audit) ----
citation(cn_pipl_art_54_p1, [label-'PIPL (2021) Art 54 (regular compliance audit)', ref-'cn-pipl-2021#art_54_p1', verbatim-'个人信息处理者应当定期对其处理个人信息遵守法律、行政法规的情况进行合规审计。']).

% ---- Article 55 (personal information protection impact assessment) ----
citation(cn_pipl_art_55_p1, [label-'PIPL (2021) Art 55 (impact assessment in advance and record of processing, on the listed occasions)', ref-'cn-pipl-2021#art_55_p1', verbatim-'有下列情形之一的，个人信息处理者应当事前进行个人信息保护影响评估，并对处理情况进行记录：']).
citation(cn_pipl_art_55_p1_i1, [label-'PIPL (2021) Art 55 item (1) (processing sensitive personal information)', ref-'cn-pipl-2021#art_55_p1_i1', verbatim-'处理敏感个人信息；']).
citation(cn_pipl_art_55_p1_i2, [label-'PIPL (2021) Art 55 item (2) (using personal information for automated decision-making)', ref-'cn-pipl-2021#art_55_p1_i2', verbatim-'利用个人信息进行自动化决策；']).
citation(cn_pipl_art_55_p1_i3, [label-'PIPL (2021) Art 55 item (3) (entrusting processing, providing to another handler, making public)', ref-'cn-pipl-2021#art_55_p1_i3', verbatim-'委托处理个人信息、向其他个人信息处理者提供个人信息、公开个人信息；']).
citation(cn_pipl_art_55_p1_i4, [label-'PIPL (2021) Art 55 item (4) (providing personal information outside the territory)', ref-'cn-pipl-2021#art_55_p1_i4', verbatim-'向境外提供个人信息；']).
citation(cn_pipl_art_55_p1_i5, [label-'PIPL (2021) Art 55 item (5) (other processing with a significant impact on personal rights and interests)', ref-'cn-pipl-2021#art_55_p1_i5', verbatim-'其他对个人权益有重大影响的个人信息处理活动。']).

% ---- Article 56 (contents of the assessment; keeping the report) ----
citation(cn_pipl_art_56_p1, [label-'PIPL (2021) Art 56 para 1 (contents an impact assessment shall include)', ref-'cn-pipl-2021#art_56_p1', verbatim-'个人信息保护影响评估应当包括下列内容：']).
citation(cn_pipl_art_56_p1_i1, [label-'PIPL (2021) Art 56 para 1 item (1) (lawfulness, legitimacy and necessity of purpose and method)', ref-'cn-pipl-2021#art_56_p1_i1', verbatim-'个人信息的处理目的、处理方式等是否合法、正当、必要；']).
citation(cn_pipl_art_56_p1_i2, [label-'PIPL (2021) Art 56 para 1 item (2) (impact on personal rights and interests and security risks)', ref-'cn-pipl-2021#art_56_p1_i2', verbatim-'对个人权益的影响及安全风险；']).
citation(cn_pipl_art_56_p1_i3, [label-'PIPL (2021) Art 56 para 1 item (3) (lawfulness, effectiveness and proportionality of protection measures)', ref-'cn-pipl-2021#art_56_p1_i3', verbatim-'所采取的保护措施是否合法、有效并与风险程度相适应。']).
citation(cn_pipl_art_56_p2, [label-'PIPL (2021) Art 56 para 2 (report and records kept for at least three years)', ref-'cn-pipl-2021#art_56_p2', verbatim-'个人信息保护影响评估报告和处理情况记录应当至少保存三年。']).

% ---- Article 57 (leakage, tampering or loss) ----
citation(cn_pipl_art_57_p1, [label-'PIPL (2021) Art 57 para 1 (remedial measures immediately; notice to the departments and the individuals)', ref-'cn-pipl-2021#art_57_p1', verbatim-'发生或者可能发生个人信息泄露、篡改、丢失的，个人信息处理者应当立即采取补救措施，并通知履行个人信息保护职责的部门和个人。通知应当包括下列事项：']).
citation(cn_pipl_art_57_p1_i1, [label-'PIPL (2021) Art 57 para 1 item (1) (categories of information, causes and possible harm)', ref-'cn-pipl-2021#art_57_p1_i1', verbatim-'发生或者可能发生个人信息泄露、篡改、丢失的信息种类、原因和可能造成的危害；']).
citation(cn_pipl_art_57_p1_i2, [label-'PIPL (2021) Art 57 para 1 item (2) (remedial measures taken and measures individuals can take)', ref-'cn-pipl-2021#art_57_p1_i2', verbatim-'个人信息处理者采取的补救措施和个人可以采取的减轻危害的措施；']).
citation(cn_pipl_art_57_p1_i3, [label-'PIPL (2021) Art 57 para 1 item (3) (contact details of the handler)', ref-'cn-pipl-2021#art_57_p1_i3', verbatim-'个人信息处理者的联系方式。']).
citation(cn_pipl_art_57_p2, [label-'PIPL (2021) Art 57 para 2 (notice to individuals may be omitted where harm is effectively avoided; departments may require notice)', ref-'cn-pipl-2021#art_57_p2', verbatim-'个人信息处理者采取措施能够有效避免信息泄露、篡改、丢失造成危害的，个人信息处理者可以不通知个人；履行个人信息保护职责的部门认为可能造成危害的，有权要求个人信息处理者通知个人。']).

% ---- Article 58 (large platform handlers) ----
citation(cn_pipl_art_58_p1, [label-'PIPL (2021) Art 58 (obligations of a handler providing important internet platform services with a huge number of users and complex types of business)', ref-'cn-pipl-2021#art_58_p1', verbatim-'提供重要互联网平台服务、用户数量巨大、业务类型复杂的个人信息处理者，应当履行下列义务：']).
citation(cn_pipl_art_58_p1_i1, [label-'PIPL (2021) Art 58 item (1) (compliance system and independent supervisory body mainly of external members)', ref-'cn-pipl-2021#art_58_p1_i1', verbatim-'按照国家规定建立健全个人信息保护合规制度体系，成立主要由外部成员组成的独立机构对个人信息保护情况进行监督；']).
citation(cn_pipl_art_58_p1_i2, [label-'PIPL (2021) Art 58 item (2) (platform rules for providers on the platform)', ref-'cn-pipl-2021#art_58_p1_i2', verbatim-'遵循公开、公平、公正的原则，制定平台规则，明确平台内产品或者服务提供者处理个人信息的规范和保护个人信息的义务；']).
citation(cn_pipl_art_58_p1_i3, [label-'PIPL (2021) Art 58 item (3) (stopping services to providers in serious violation)', ref-'cn-pipl-2021#art_58_p1_i3', verbatim-'对严重违反法律、行政法规处理个人信息的平台内的产品或者服务提供者，停止提供服务；']).
citation(cn_pipl_art_58_p1_i4, [label-'PIPL (2021) Art 58 item (4) (regular social responsibility report)', ref-'cn-pipl-2021#art_58_p1_i4', verbatim-'定期发布个人信息保护社会责任报告，接受社会监督。']).

% ---- Article 59 (entrusted party) ----
citation(cn_pipl_art_59_p1, [label-'PIPL (2021) Art 59 (security safeguards and assistance by a party entrusted with processing)', ref-'cn-pipl-2021#art_59_p1', verbatim-'接受委托处理个人信息的受托人，应当依照本法和有关法律、行政法规的规定，采取必要措施保障所处理的个人信息的安全，并协助个人信息处理者履行本法规定的义务。']).

% ---- Article 73 (meaning of terms) ----
citation(cn_pipl_art_73_p1_i1, [label-'PIPL (2021) Art 73 item (1) definition of personal information handler', ref-'cn-pipl-2021#art_73_p1_i1', verbatim-'个人信息处理者，是指在个人信息处理活动中自主决定处理目的、处理方式的组织、个人。']).
citation(cn_pipl_art_73_p1_i2, [label-'PIPL (2021) Art 73 item (2) definition of automated decision-making', ref-'cn-pipl-2021#art_73_p1_i2', verbatim-'自动化决策，是指通过计算机程序自动分析、评估个人的行为习惯、兴趣爱好或者经济、健康、信用状况等，并进行决策的活动。']).

% ---- Article 74 (entry into force) ----
citation(cn_pipl_art_74_p1, [label-'PIPL (2021) Art 74 (entry into force on 1 November 2021)', ref-'cn-pipl-2021#art_74_p1', verbatim-'本法自2021年11月1日起施行。']).

% Provenance marker: succeeds for every recorded key, fails for any other.
implements(Key) :-
    citation(Key, _).

% The order's citation_vocabulary: the only citation atoms a result returns.
citation_vocabulary([
    cn_pipl_art_3_p2,
    cn_pipl_art_3_p2_i1,
    cn_pipl_art_3_p2_i2,
    cn_pipl_art_3_p2_i3,
    cn_pipl_art_51_p1,
    cn_pipl_art_51_p1_i1,
    cn_pipl_art_51_p1_i2,
    cn_pipl_art_51_p1_i3,
    cn_pipl_art_51_p1_i4,
    cn_pipl_art_51_p1_i5,
    cn_pipl_art_51_p1_i6,
    cn_pipl_art_52_p1,
    cn_pipl_art_52_p2,
    cn_pipl_art_53_p1,
    cn_pipl_art_54_p1,
    cn_pipl_art_55_p1,
    cn_pipl_art_55_p1_i1,
    cn_pipl_art_55_p1_i2,
    cn_pipl_art_55_p1_i3,
    cn_pipl_art_55_p1_i4,
    cn_pipl_art_55_p1_i5,
    cn_pipl_art_56_p1,
    cn_pipl_art_56_p1_i1,
    cn_pipl_art_56_p1_i2,
    cn_pipl_art_56_p1_i3,
    cn_pipl_art_56_p2,
    cn_pipl_art_57_p1,
    cn_pipl_art_57_p1_i1,
    cn_pipl_art_57_p1_i2,
    cn_pipl_art_57_p1_i3,
    cn_pipl_art_57_p2,
    cn_pipl_art_58_p1,
    cn_pipl_art_58_p1_i1,
    cn_pipl_art_58_p1_i2,
    cn_pipl_art_58_p1_i3,
    cn_pipl_art_58_p1_i4,
    cn_pipl_art_59_p1,
    cn_pipl_art_73_p1_i1,
    cn_pipl_art_73_p1_i2,
    cn_pipl_art_74_p1
]).

% The governing unit of each duty, for the facade checklist (query type #7).
% Each row carries a ready-made cite(Key) term.
duty_primary_citation(compliance_measures, cite(cn_pipl_art_51_p1)).
duty_primary_citation(protection_officer, cite(cn_pipl_art_52_p1)).
duty_primary_citation(officer_contact_details, cite(cn_pipl_art_52_p2)).
duty_primary_citation(china_representative, cite(cn_pipl_art_53_p1)).
duty_primary_citation(compliance_audit, cite(cn_pipl_art_54_p1)).
duty_primary_citation(impact_assessment, cite(cn_pipl_art_55_p1)).
duty_primary_citation(assessment_record_retention, cite(cn_pipl_art_56_p2)).
duty_primary_citation(breach_remedial_measures, cite(cn_pipl_art_57_p1)).
duty_primary_citation(breach_notice_to_department, cite(cn_pipl_art_57_p1)).
duty_primary_citation(breach_notice_to_individuals, cite(cn_pipl_art_57_p2)).
duty_primary_citation(large_platform_obligations, cite(cn_pipl_art_58_p1)).
duty_primary_citation(entrusted_party_safeguards, cite(cn_pipl_art_59_p1)).

test(every_vocabulary_key_is_recorded) :-
    citation_vocabulary(Keys),
    length(Keys, 40),
    maplist(implements, Keys).
test(the_entry_into_force_key_is_recorded) :-
    implements(cn_pipl_art_74_p1).
test(a_shortened_key_is_not_recorded, fail) :-
    implements(pipl_art_74).
test(every_duty_has_one_primary_citation) :-
    findall(Duty, duty_primary_citation(Duty, _), Duties),
    length(Duties, 12).

:- end_module(citations).
