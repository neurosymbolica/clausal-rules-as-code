% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% kernel.clausal -- the SHARED FLOOR for cn/pipl_individual_rights (deontic family).
% Source: 中华人民共和国个人信息保护法 (Personal Information Protection Law of
% the People's Republic of China, PIPL), 2021 adoption text, Chapter IV,
% Articles 44 to 50 (pinned units cn-pipl-2021#art_44 ... #art_50, npc.gov.cn
% page text). The input check below is written from the order's typed input
% contract (INTERFACE - THE INPUT CHECK); it decides no statutory condition.
%
% DAG root of the determination-slices layout. It holds ONLY the
% PREDICATES that two or more files CALL:
%   - pipl_individual_rights_input_problems/2: the order's input check
%     (scaffold-written; called by the slice and by queries.clausal);
%   - pipl_individual_rights_key_state/3: the single state of one key in a
%     well-formed profile (absent, or its value), read with profile_get/3
%     (called by the slice ladders and by the facade checklist rows);
%   - pipl_individual_rights_relied_pairs/3: THE PAIRS RULE, the Key-Value
%     pairs of the present judgement keys of a pairs list, in the order
%     given (called by the slice referral steps and the facade).
% deontic family: STATUS is a modal vocabulary (cf. eu/procurement/exclusion_grounds
% must_exclude/may_exclude/not_excluded).
%
% Atoms and data terms need NO declaration and NO import. The comment
% block below only RECORDS the result terms so every file spells them alike.
%
% RESULT TERMS.
% Each of the nine queries of the slice pipl_individual_rights.clausal is
%   QUERY(Profile, Result, Citations)
% - Profile: [attribute(Key, Value), ...], the twenty contract keys;
% - Result: one final atom of the query (for example right_available,
%   provide_in_time, delete_personal_information, refused_without_reasons),
%   or pinned_text_not_applicable, or one status compound, never bare:
%     indeterminate([Key])  -- exactly one missing key, the first named;
%     needs_legal_review(open_textured(Key, cite(Unit)), [inputs_relied_on(Pairs)])
%       -- an unsure judgement handed to a lawyer; Pairs from
%          pipl_individual_rights_relied_pairs/3;
%     input_problems(Problems) -- Problems from the input check, non-empty;
% - Citations: a set-like list of cite(Key) terms; [] for every non-final
%   Result and for pinned_text_not_applicable; otherwise the one fixed list
%   of that final answer.
% Facade result term (query types #2 and #7, queries.clausal):
%   pipl_individual_rights_verdict(status, checklist)
% - status: eligible | ineligible | undetermined | referred_for_legal_review
%   | text_not_in_force | input_rejected (the bare atom indeterminate is
%   never written);
% - checklist: a list of item(RequirementId, ItemStatus, cite(Unit)).
% Problem terms: duplicate_key(Key), wrong_type(Key), wrong_type(profile),
% unknown_key(Key). Key states: absent, true, false, unsure.
% =====================================================================

:- module(kernel, [
    pipl_individual_rights_input_problems/2,
    pipl_individual_rights_key_state/3,
    pipl_individual_rights_relied_pairs/3
]).

:- use_module(library(reif), [memberd_t/3]).
:- use_module(formalize_lib, [profile_get/3, profile_has/2, profile_lacks/2]).

% ---- input checks: the problems a profile has, if any -----------
% pipl_individual_rights_input_problems(Profile, Problems): Problems = [] means the profile can be
% judged. Written from the order's typed input contract
% (input_contract.types.profile: attribute_list).
% Each public query calls this check first: it gives its normal answer only when
% Problems = [], and when Problems is not [] it gives the answer the order states for
% a profile with input problems.
% It gives exactly one answer for every Profile, and the answer is ground except for a
% Key named as given:
% - a Profile that is not an attribute list [attribute(Key, Value), ...] gives [wrong_type(profile)]:
%   an unbound Profile, a partial list, a list holding an unbound item or an item that is
%   not attribute(_, _);
% - a Key that is not an atom (a number, a string, a compound term, an unbound variable)
%   is a key outside the contract: unknown_key(Key), Key as given;
% - otherwise, for each contract key in the contract's key order, duplicate_key(Key) when
%   the key occurs more than once in Profile (whatever its values: none of them is read,
%   so it is never also wrong_type(Key)), else wrong_type(Key) when its one value is
%   outside its type; then unknown_key(Key) for each key outside the contract, in the
%   order of its first occurrence in Profile. Each key is named once. An absent key is
%   not a problem.
% Every step is complementary clauses: exactly one clause holds for each input.
pipl_individual_rights_input_problems(Profile, Problems) :-
    attribute_list_t(Profile, IsAttributeList),
    profile_problems(IsAttributeList, Profile, Problems).

profile_problems(false, _, [wrong_type(profile)]).
profile_problems(true, Profile, Problems) :-
    Keys = [pinned_text_in_force_on_reference_day, laws_or_regulations_provide_otherwise, article_18_1_case, article_35_case, cyberspace_department_transfer_conditions_met, verification_confirms_inaccurate_or_incomplete, purpose_achieved_impossible_or_unnecessary, service_stopped_or_retention_period_expired, consent_withdrawn, processing_violates_law_or_agreement, other_deletion_case_prescribed_by_law, legal_retention_period_unexpired, deletion_technically_difficult, person_deceased, requester_is_near_relative, for_requester_own_lawful_and_legitimate_interests, deceased_arranged_otherwise, convenient_mechanism_established, request_refused, refusal_reasons_given],
    unknown_keys(Profile, Keys, UnknownKeyProblems),
    key_problems(Keys, Profile, UnknownKeyProblems, Problems).

% The contract: each key and the type of its value.
key_type(pinned_text_in_force_on_reference_day, boolean).
key_type(laws_or_regulations_provide_otherwise, boolean).
key_type(article_18_1_case, boolean).
key_type(article_35_case, boolean).
key_type(cyberspace_department_transfer_conditions_met, boolean).
key_type(verification_confirms_inaccurate_or_incomplete, judgement).
key_type(purpose_achieved_impossible_or_unnecessary, judgement).
key_type(service_stopped_or_retention_period_expired, boolean).
key_type(consent_withdrawn, boolean).
key_type(processing_violates_law_or_agreement, judgement).
key_type(other_deletion_case_prescribed_by_law, boolean).
key_type(legal_retention_period_unexpired, boolean).
key_type(deletion_technically_difficult, judgement).
key_type(person_deceased, boolean).
key_type(requester_is_near_relative, boolean).
key_type(for_requester_own_lawful_and_legitimate_interests, judgement).
key_type(deceased_arranged_otherwise, boolean).
key_type(convenient_mechanism_established, judgement).
key_type(request_refused, boolean).
key_type(refusal_reasons_given, boolean).

% attribute_list_t(Term, T): T is true when Term is a list of attribute(Key, Value)
% items, whatever each Key is; false for anything else, an unbound Term or item included.
attribute_list_t(Term, false) :-
    var(Term).
attribute_list_t(Term, true) :-
    Term == [].
attribute_list_t(Term, T) :-
    nonvar(Term),
    Term = [Element|Elements],
    attribute_t(Element, ElementIsAttribute),
    attribute_list_t(Elements, ElementsAreAttributes),
    truth_and(ElementIsAttribute, ElementsAreAttributes, T).
attribute_list_t(Term, false) :-
    nonvar(Term),
    Term \== [],
    Term \= [_|_].

attribute_t(Element, false) :-
    var(Element).
attribute_t(Element, true) :-
    nonvar(Element),
    Element = attribute(_, _).
attribute_t(Element, false) :-
    nonvar(Element),
    Element \= attribute(_, _).

% Unknown keys, in profile order, each once: Known grows by each key named. A key is
% known when it is identical (==) to one in Known, so an unbound Key is never bound:
% the same variable twice is one unknown key, two different variables are two.
unknown_keys([], _, []).
unknown_keys([attribute(Key, _)|Elements], Known, Problems) :-
    known_t(Key, Known, IsKnown),
    name_unknown_key(IsKnown, Key, Known, Elements, Problems).

known_t(_, [], false).
known_t(Key, [Known|_], true) :-
    Known == Key.
known_t(Key, [Known|Knowns], T) :-
    Known \== Key,
    known_t(Key, Knowns, T).

name_unknown_key(true, _, Known, Elements, Problems) :-
    unknown_keys(Elements, Known, Problems).
name_unknown_key(false, Key, Known, Elements, [unknown_key(Key)|Problems]) :-
    unknown_keys(Elements, [Key|Known], Problems).

% Contract keys, in contract order: duplicate_key(Key) when the key occurs more than once
% (none of its values is read), else wrong_type(Key) when its one value is outside the
% key's type. An absent key has no value to check.
key_problems([], _, Problems, Problems).
key_problems([Key|Keys], Profile, LaterProblems, Problems) :-
    key_type(Key, Type),
    key_occurrences(Profile, Key, Occurrences),
    key_problems(Keys, Profile, LaterProblems, KeyProblems),
    name_key_problem(Occurrences, Key, Type, Profile, KeyProblems, Problems).

% key_occurrences(Elements, Key, Occurrences): none, one or many items give Key.
key_occurrences([], _, none).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey == Key,
    key_occurrences(Elements, Key, RestOccurrences),
    one_more_occurrence(RestOccurrences, Occurrences).
key_occurrences([attribute(ElementKey, _)|Elements], Key, Occurrences) :-
    ElementKey \== Key,
    key_occurrences(Elements, Key, Occurrences).

one_more_occurrence(none, one).
one_more_occurrence(one, many).
one_more_occurrence(many, many).

name_key_problem(none, _, _, _, Problems, Problems).
name_key_problem(many, Key, _, _, Problems, [duplicate_key(Key)|Problems]).
name_key_problem(one, Key, Type, Profile, KeyProblems, Problems) :-
    values_in_type_t(Profile, Key, Type, InType),
    name_wrong_type(InType, Key, KeyProblems, Problems).

name_wrong_type(true, _, Problems, Problems).
name_wrong_type(false, Key, Problems, [wrong_type(Key)|Problems]).

% values_in_type_t(Elements, Key, Type, T): T is true when every value Elements gives Key is
% in Type (true when Elements gives Key none).
values_in_type_t([], _, _, true).
values_in_type_t([attribute(ElementKey, Value)|Elements], Key, Type, T) :-
    ElementKey == Key,
    value_in_type_t(Type, Value, ValueInType),
    values_in_type_t(Elements, Key, Type, RestInType),
    truth_and(ValueInType, RestInType, T).
values_in_type_t([attribute(ElementKey, _)|Elements], Key, Type, T) :-
    ElementKey \== Key,
    values_in_type_t(Elements, Key, Type, T).

% A value with an unbound part is outside every type; a ground one is checked.
value_in_type_t(Type, Value, T) :-
    term_variables(Value, Variables),
    ground_value_in_type_t(Variables, Type, Value, T).

ground_value_in_type_t([_|_], _, _, false).
ground_value_in_type_t([], Type, Value, T) :-
    in_type_t(Type, Value, T).

% in_type_t(Type, Value, T): one clause per type, for a ground Value.
in_type_t(judgement, Value, T) :-
    in_type_t(one_of([boolean, enum([unsure])]), Value, T).

in_type_t(boolean, Value, T) :-
    memberd_t(Value, [true, false], T).

in_type_t(enum(Values), Value, T) :-
    memberd_t(Value, Values, T).

in_type_t(one_of(Types), Value, T) :-
    in_some_type_t(Types, Value, T).

truth_and(true, T, T).
truth_and(false, _, false).

% in_some_type_t(Types, Value, T): T is true when Value is in at least one of Types.
in_some_type_t([], _, false).
in_some_type_t([Type|Types], Value, T) :-
    in_type_t(Type, Value, InType),
    in_some_type_t(Types, Value, InAnother),
    truth_or(InType, InAnother, T).

truth_or(true, _, true).
truth_or(false, T, T).

% ---- key state: one state per key in a well-formed profile ----------
% pipl_individual_rights_key_state(Profile, Key, State): State is the atom
% absent when Key is not in Profile, else the one value Profile gives Key
% (true, false or unsure once the input check gives []). Read by presence
% first, then by value, with profile_get/3 only. Call it only on a profile
% whose input check is []: a duplicate key is excluded there, so the read
% is single-valued. Plumbing: decides no statutory condition.
pipl_individual_rights_key_state(Profile, Key, absent) :-
    profile_lacks(Profile, Key).
pipl_individual_rights_key_state(Profile, Key, Value) :-
    profile_has(Profile, Key),
    profile_get(Profile, Key, Value).

% ---- THE PAIRS RULE --------------------------------------------------
% pipl_individual_rights_relied_pairs(Profile, PairsKeys, Pairs): Pairs are
% the Key-Value pairs of the keys of PairsKeys that are PRESENT in Profile,
% in the order of PairsKeys (each query's pairs list is written in
% root_exports order), unsure values included. Plumbing: decides no
% statutory condition.
pipl_individual_rights_relied_pairs(Profile, PairsKeys, Pairs) :-
    findall(
        Key-Value,
        (   member(Key, PairsKeys),
            profile_get(Profile, Key, Value)
        ),
        Pairs
    ).

% ---- tests -------------------------------------------------------------
test(an_empty_profile_has_no_problem) :-
    pipl_individual_rights_input_problems([], []).
test(an_unbound_profile_is_not_an_attribute_list) :-
    pipl_individual_rights_input_problems(_, [wrong_type(profile)]).
test(a_partial_list_is_not_an_attribute_list) :-
    pipl_individual_rights_input_problems([attribute(consent_withdrawn, true)|_], [wrong_type(profile)]).
test(a_duplicate_key_is_named_once_and_never_wrong_type) :-
    pipl_individual_rights_input_problems(
        [attribute(consent_withdrawn, true), attribute(consent_withdrawn, maybe)],
        [duplicate_key(consent_withdrawn)]
    ).
test(a_crisp_key_given_unsure_is_wrong_type_and_an_unknown_key_follows) :-
    pipl_individual_rights_input_problems(
        [attribute(colour, red), attribute(article_35_case, unsure)],
        [wrong_type(article_35_case), unknown_key(colour)]
    ).
test(a_judgement_key_given_unsure_is_well_formed) :-
    pipl_individual_rights_input_problems(
        [attribute(convenient_mechanism_established, unsure)],
        []
    ).
test(the_input_check_has_exactly_one_answer) :-
    findall(
        Problems,
        pipl_individual_rights_input_problems([attribute(person_deceased, true)], Problems),
        Answers
    ),
    Answers == [[]].
test(an_absent_key_has_state_absent) :-
    findall(
        State,
        pipl_individual_rights_key_state([attribute(person_deceased, true)], request_refused, State),
        States
    ),
    States == [absent].
test(a_present_key_has_its_value_as_state) :-
    findall(
        State,
        pipl_individual_rights_key_state([attribute(person_deceased, true)], person_deceased, State),
        States
    ),
    States == [true].
test(a_present_key_is_not_absent, fail) :-
    pipl_individual_rights_key_state([attribute(person_deceased, true)], person_deceased, absent).
test(relied_pairs_keep_the_present_keys_in_list_order) :-
    pipl_individual_rights_relied_pairs(
        [attribute(deletion_technically_difficult, false), attribute(purpose_achieved_impossible_or_unnecessary, unsure)],
        [purpose_achieved_impossible_or_unnecessary, processing_violates_law_or_agreement, deletion_technically_difficult],
        Pairs
    ),
    Pairs == [purpose_achieved_impossible_or_unnecessary-unsure, deletion_technically_difficult-false].

:- end_module(kernel).
