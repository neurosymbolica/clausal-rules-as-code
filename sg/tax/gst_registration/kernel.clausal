% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% kernel.clausal -- the SHARED FLOOR for sg/tax/gst_registration (temporal family).
% DAG root of the determination-slices layout. It holds ONLY the
% PREDICATES that two or more files CALL -- possibly none, which is why
% the export list below starts empty.
%
% Result terms -- one per determination slice:
%
%   gst_retrospective(Decision, ValueCents, NotifyBy, RegisteredFrom, Citations)
%     Decision: already_registered | not_liable | not_liable_comptroller_satisfied
%               | exempted_zero_rated | liable | indeterminate
%     ValueCents: integer cents (S$1 million = 100000000), or n_a when indeterminate
%     NotifyBy: date(Y, M, D) when liable, else n_a
%     RegisteredFrom: date(Y, M, D) when liable, else n_a
%     Citations: list of bare citation atoms in statutory order
%
%   gst_prospective(Decision, ValueCents, NotifyBy, RegisteredFrom, Citations)
%     Decision: already_registered | not_liable | exempted_zero_rated
%               | liable | indeterminate
%     (same shapes as above)
%
% Source: Goods and Services Tax Act 1993 (Singapore, 2020 Rev Ed), First Schedule.
% =====================================================================

:- module(kernel, []).

:- end_module(kernel).
