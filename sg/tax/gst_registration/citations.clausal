% --- Interpretation Act 1965 (day-counting convention) ---

citation(sg_interpretation_act_1965_s_50_a, [
    label-'Interpretation Act 1965, section 50(a)',
    ref-'https://sso.agc.gov.sg/Act/IA1965'
]).

% --- S 443/2025 (cutover for prospective registration effective date) ---

citation(sg_gsta_1993_s443_2025, [
    label-'Statutory Instrument 443/2025, amending First Schedule paragraph 5(2)(a)',
    ref-'https://sso.agc.gov.sg/Act/GSTA1993'
]).

% --- Provenance marker ---

implements(Key) :-
    citation(Key, _).

:- end_module(citations).
