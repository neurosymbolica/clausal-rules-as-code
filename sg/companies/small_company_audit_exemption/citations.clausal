% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for sg/companies/small_company_audit_exemption.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys label and ref only:
%   citation(Key, [label-'...', ref-'...']).
% Records carry a label and a link; quotations of the statute are omitted,
% see the linked Singapore Statutes Online (SSO) page for the text.
%
% A clause cites a key with a `cite(Key)` term; cite(...) is data and
% needs no import.
%
% PROVENANCE: every clause that decides a statutory condition (a threshold,
% a test, an exception), helpers included, opens its body with
% implements(Key), Key the provision for THAT condition, recorded here; the
% verdict clause's umbrella section does not cover the conditions below it.
% Define implements(Key) :- citation(Key, _). in
% this module and add implements/1 to its export list (the PROVENANCE
% MARKERS convention in your instructions).
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

% --- s 205C(1): small company exempt from audit ---
citation(ca1967_s205c_1, [
    label-'Companies Act 1967 s 205C(1) -- small company exempt from audit requirements',
    ref-'https://sso.agc.gov.sg/Act/CoA1967?ProvIds=pr205C-'
]).

% --- s 205C(3): parent company condition ---
citation(ca1967_s205c_3, [
    label-'Companies Act 1967 s 205C(3) -- parent company must be small company and part of small group',
    ref-'https://sso.agc.gov.sg/Act/CoA1967?ProvIds=pr205C-'
]).

% --- s 205C(4): subsidiary company condition ---
citation(ca1967_s205c_4, [
    label-'Companies Act 1967 s 205C(4) -- subsidiary company must be small company and part of small group',
    ref-'https://sso.agc.gov.sg/Act/CoA1967?ProvIds=pr205C-'
]).

% --- s 205C(6): temporal carve-out before 1 July 2015 ---
citation(ca1967_s205c_6, [
    label-'Companies Act 1967 s 205C(6) -- exemption does not apply to financial years commencing before 1 July 2015',
    ref-'https://sso.agc.gov.sg/Act/CoA1967?ProvIds=pr205C-'
]).

