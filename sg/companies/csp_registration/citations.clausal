% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for sg/companies/csp_registration.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys label and ref only:
%   citation(Key, [label-'...', ref-'...']).
% Records carry a label and a link; quotations of the statute are omitted,
% see the linked Singapore Statutes Online (SSO) page for the text.
%
% A clause cites a key with a `cite(Key)` term; cite(...) is data and
% needs no import.
%
% PROVENANCE: every clause that decides a statutory condition or computes a
% statutory value (a threshold, a test, an exception, a classification, a
% list it filters by, a date or amount, a definition or interpretation rule
% it applies), helpers included, opens its body with implements(Key), Key
% the provision for THAT condition or value; the verdict clause's umbrella
% section does not cover the conditions below it. RECORD a key here for
% every such provision.
%
% LABEL: name the provision down to the sub-paragraph or defined term, e.g.
% 'Corporate Service Providers Act 2024 s 2(1) definition of corporate service'.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

% s 2(1): definition of 'corporate service' in six limbs (a)-(f).
citation(sg_cspa_2024_s2_1_corporate_service, [
    label-'Corporate Service Providers Act 2024 s 2(1) definition of corporate service',
    ref-'https://sso.agc.gov.sg/Act/CSPA2024?ProvIds=pr2-'
]).

% s 2(1): definition of 'nominee director'.
citation(sg_cspa_2024_s2_1_nominee_director, [
    label-'Corporate Service Providers Act 2024 s 2(1) definition of nominee director',
    ref-'https://sso.agc.gov.sg/Act/CSPA2024?ProvIds=pr2-'
]).

% s 7([quotation omitted]
% [quotation omitted] it is a registered CSP for that type.
citation(sg_cspa_2024_s7_1, [
    label-'Corporate Service Providers Act 2024 s 7(1) registration requirement',
    ref-'https://sso.agc.gov.sg/Act/CSPA2024?ProvIds=pr7-'
]).

% s 7(2): an accounting entity carrying out designated activities in relation
% to its own accounting services is treated as registered for that type.
citation(sg_cspa_2024_s7_2, [
    label-'Corporate Service Providers Act 2024 s 7(2) deemed registration for accounting entities',
    ref-'https://sso.agc.gov.sg/Act/CSPA2024?ProvIds=pr7-'
]).

% s 16(1): a registered CSP for the director/secretary service [quotation omitted]
% [quotation omitted] unless satisfied the
% person is fit and proper.
citation(sg_cspa_2024_s16_1, [
    label-'Corporate Service Providers Act 2024 s 16(1) nominee director fit-and-proper duty',
    ref-'https://sso.agc.gov.sg/Act/CSPA2024?ProvIds=pr16-'
]).

% s 16(2): in determining fit-and-proper, the CSP must take all reasonable
% steps to check disqualification and consider prescribed factors.
citation(sg_cspa_2024_s16_2, [
    label-'Corporate Service Providers Act 2024 s 16(2) reasonable steps and prescribed factors',
    ref-'https://sso.agc.gov.sg/Act/CSPA2024?ProvIds=pr16-'
]).

implements(Key) :-
    citation(Key, _).

:- end_module(citations).
