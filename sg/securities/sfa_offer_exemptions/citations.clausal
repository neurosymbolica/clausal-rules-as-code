% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for sg/securities/sfa_offer_exemptions.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys label and ref only:
%   citation(Key, [label-'...', ref-'...']).
% Records carry a label and a link; quotations of the statute are omitted,
% see the linked Singapore Statutes Online (SSO) page for the text.
%
% A clause cites a key with a `cite(Key)` term; cite(...) is data and
% needs no import.
%
% PROVENANCE: every clause that decides a statutory condition (a threshold,
% a test, an exception), helpers included, opens its body with
% implements(Key), Key the provision for THAT condition, recorded here; the
% verdict clause's umbrella section does not cover the conditions below it.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

citation(sg_sfa_2001_s274, [
    label-'SFA 2001 s 274 -- institutional investor exemption',
    ref-'https://sso.agc.gov.sg/Act/SFA2001?ProvIds=pr274-'
]).

citation(sg_sfa_2001_s275_1, [
    label-'SFA 2001 s 275(1) -- relevant person exemption',
    ref-'https://sso.agc.gov.sg/Act/SFA2001?ProvIds=pr275-'
]).

citation(sg_sfa_2001_s275_1a, [
    label-'SFA 2001 s 275(1A) -- principal acquisition exemption',
    ref-'https://sso.agc.gov.sg/Act/SFA2001?ProvIds=pr275-'
]).

citation(sg_sfa_2001_s272a_1, [
    label-'SFA 2001 s 272A(1) -- small personal offer exemption',
    ref-'https://sso.agc.gov.sg/Act/SFA2001?ProvIds=pr272A-'
]).

citation(sg_sfa_2001_s272b_1, [
    label-'SFA 2001 s 272B(1) -- private placement exemption',
    ref-'https://sso.agc.gov.sg/Act/SFA2001?ProvIds=pr272B-'
]).

citation(sg_sfa_2001_s240, [
    label-'SFA 2001 s 240 -- prospectus requirement',
    ref-'https://sso.agc.gov.sg/Act/SFA2001?ProvIds=pr240-'
]).

implements(Key) :-
    citation(Key, _).

:- end_module(citations).
