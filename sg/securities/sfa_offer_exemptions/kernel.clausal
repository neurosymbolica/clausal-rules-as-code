% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% kernel.clausal -- the SHARED FLOOR for sg/securities/sfa_offer_exemptions (eligibility family).
% DAG root of the determination-slices layout. It holds ONLY the
% PREDICATES that two or more files CALL -- possibly none, which is why
% the export list below starts empty.
%
% Result term built by the sole determination slice (sfa_offer_exemptions.clausal):
%   offer_exemption(Decision, CoveredBy, WindowAmountCents, WindowPersons, Citations)
%     Decision          -- exempt | prospectus_required | indeterminate
%     CoveredBy         -- list, subset of [s274, s275_1, s275_1a, s272a, s272b] in that order
%     WindowAmountCents -- integer (cents) or n_a (indeterminate)
%     WindowPersons     -- integer (count) or n_a (indeterminate)
%     Citations         -- list of bare citation atoms, one per CoveredBy entry
%
% Data term used in profile lists:
%   prior(Date, Value)
%     Date  -- date(Year, Month, Day)
%     Value -- integer (amount in cents for prior_small_offers;
%              person count for prior_private_placement_offerees)
%
% Source: Securities and Futures Act 2001 (Singapore), ss 272A, 272B, 274, 275.
% =====================================================================

:- module(kernel, []).

:- end_module(kernel).
