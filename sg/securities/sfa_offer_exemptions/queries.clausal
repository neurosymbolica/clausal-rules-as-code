% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% queries.clausal -- QUERY-COMBINATOR layer for sg/securities/sfa_offer_exemptions.
% A TOP-LAYER consumer: it imports the determination slices' PUBLIC
% predicates it calls, and nothing else.
%
% sfa_offer_exemptions_profile_keys/1  -- schema of top-level profile keys
% sfa_offer_exemptions_what_if/4       -- override one key and re-evaluate
% sfa_offer_exemptions_threshold/5     -- flip-point boundary for a key
% =====================================================================

:- module(queries, [
    sfa_offer_exemptions_profile_keys/1,
    sfa_offer_exemptions_what_if/4,
    sfa_offer_exemptions_threshold/5
]).

:- use_module(kit/query_combinators, [override_key/4, flip_scan/4]).
:- use_module(sg/securities/sfa_offer_exemptions/sfa_offer_exemptions, [
    decide_sfa_offer_exemptions/2,
    sfa_offer_exemptions_status/2
]).

% schema of top-level profile keys
sfa_offer_exemptions_profile_keys([
    offer_date,
    institutional_offerees,
    relevant_person_offerees,
    other_offerees,
    amount_raised_cents,
    advertisement,
    non_permitted_selling_expenses,
    prospectus_state,
    personal_offer,
    statement_and_resale_notification_given,
    acquires_as_principal,
    minimum_consideration_per_transaction_cents,
    prior_small_offers,
    prior_private_placement_offerees
]).

% what-if: override one profile key with a new value, re-evaluate
sfa_offer_exemptions_what_if(ProfileKey, NewValue, Profile, Result) :-
    override_key(Profile, ProfileKey, NewValue, Hypothesis),
    decide_sfa_offer_exemptions(Hypothesis, Result).

% threshold probe: called by flip_scan with (ProbeValue, ProbeVerdict)
threshold_verdict_at(Profile, ProfileKey, ProbeValue, ProbeVerdict) :-
    override_key(Profile, ProfileKey, ProbeValue, NewProfile),
    sfa_offer_exemptions_status(NewProfile, ProbeVerdict).

% threshold: find the flip-point boundary for a given key within [LowerBound, UpperBound].
% The boundary is the largest value in [LowerBound, UpperBound] whose verdict equals
% the verdict at LowerBound (the last value before the flip).
sfa_offer_exemptions_threshold(Profile, ProfileKey, LowerBound, UpperBound, Boundary) :-
    integer(LowerBound),
    integer(UpperBound),
    LowerBound < UpperBound,
    threshold_verdict_at(Profile, ProfileKey, LowerBound, LowerVerdict),
    threshold_verdict_at(Profile, ProfileKey, UpperBound, UpperVerdict),
    dif(LowerVerdict, UpperVerdict),
    flip_scan(LowerBound, UpperBound, threshold_verdict_at(Profile, ProfileKey), FlipPoint),
    threshold_verdict_at(Profile, ProfileKey, FlipPoint, FlipVerdict),
    boundary_from_flip(FlipPoint, FlipVerdict, LowerVerdict, UpperVerdict, Boundary).

boundary_from_flip(FlipPoint, FlipVerdict, LowerVerdict, _UpperVerdict, Boundary) :-
    FlipVerdict == LowerVerdict,
    Boundary is FlipPoint.
boundary_from_flip(FlipPoint, FlipVerdict, _LowerVerdict, UpperVerdict, Boundary) :-
    FlipVerdict == UpperVerdict,
    Boundary is FlipPoint - 1.

:- end_module(queries).
