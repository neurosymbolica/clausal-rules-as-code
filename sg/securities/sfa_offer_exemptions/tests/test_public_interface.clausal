% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% test_public_interface.clausal -- the package's PUBLIC surface, exercised
% through the generated package facade (what an external caller sees).
% Run: python -m clausal.testing sg/securities/sfa_offer_exemptions/tests/test_public_interface.clausal
% =====================================================================
:- module(test_public_interface, []).
:- use_module(sg/securities/sfa_offer_exemptions, [
    sfa_offer_exemption/2,
    offer_exemption/5,
    prior/2,
    decide_sfa_offer_exemptions/2,
    sfa_offer_exemptions_status/2,
    sfa_offer_exemptions_checklist/2,
    sfa_offer_exemptions_decision_resolvable/1,
    sfa_offer_exemptions_status_values/1,
    sfa_offer_exemptions_what_if/4,
    sfa_offer_exemptions_profile_keys/1,
    sfa_offer_exemptions_subject/1,
    sfa_offer_exemptions_profile_for/2,
    sfa_offer_exemptions_assess/2
]).

% ---- s274 institutional investor ------------------------------------

test(s274_institutional_is_exempt) :-
    sfa_offer_exemptions_assess(s274_institutional_positive,
        offer_exemption(exempt, [s274], 1000000, 0, [sg_sfa_2001_s274])).

% s274 near-miss: no institutional, advertisement blocks all residual routes
% the positive counterpart is the s274_institutional_positive test above

% ---- s275_1 relevant person ------------------------------------------

test(s275_1_relevant_is_exempt) :-
    sfa_offer_exemptions_assess(s275_1_relevant_positive,
        offer_exemption(exempt, [s275_1], 1000000, 0, [sg_sfa_2001_s275_1])).

% s275_1 near-miss: advertisement present, residual not covered

test(s275_1_relevant_near_miss_requires_prospectus) :-
    sfa_offer_exemptions_assess(s275_1_relevant_near_miss,
        offer_exemption(prospectus_required, [], 1000000, 2, [sg_sfa_2001_s240])).

% ---- s275_1a principal acquisition -----------------------------------

test(s275_1a_at_minimum_is_exempt) :-
    sfa_offer_exemptions_assess(s275_1a_principal_at_minimum,
        offer_exemption(exempt, [s275_1a], 1000000, 51, [sg_sfa_2001_s275_1a])).

test(s275_1a_below_minimum_requires_prospectus) :-
    sfa_offer_exemptions_assess(s275_1a_principal_below_minimum,
        offer_exemption(prospectus_required, [], 1000000, 51, [sg_sfa_2001_s240])).

% ---- s272a small personal offer --------------------------------------

test(s272a_at_amount_limit_is_exempt) :-
    sfa_offer_exemptions_assess(s272a_small_at_amount_limit,
        offer_exemption(exempt, [s272a], 500000000, 51, [sg_sfa_2001_s272a_1])).

test(s272a_over_amount_limit_requires_prospectus) :-
    sfa_offer_exemptions_assess(s272a_small_over_amount_limit,
        offer_exemption(prospectus_required, [], 500000001, 51, [sg_sfa_2001_s240])).

% ---- s272b private placement -----------------------------------------

test(s272b_at_person_limit_is_exempt) :-
    sfa_offer_exemptions_assess(s272b_placement_at_person_limit,
        offer_exemption(exempt, [s272b], 1000000, 50, [sg_sfa_2001_s272b_1])).

test(s272b_over_person_limit_requires_prospectus) :-
    sfa_offer_exemptions_assess(s272b_placement_over_person_limit,
        offer_exemption(prospectus_required, [], 1000000, 51, [sg_sfa_2001_s240])).

% ---- combined s274 + s275_1 -----------------------------------------

test(combined_institutional_and_relevant_is_exempt) :-
    sfa_offer_exemptions_assess(s274_and_s275_combined,
        offer_exemption(exempt, [s274, s275_1], 1000000, 0,
            [sg_sfa_2001_s274, sg_sfa_2001_s275_1])).

% ---- indeterminate routes -------------------------------------------

test(missing_prospectus_state_is_indeterminate) :-
    sfa_offer_exemptions_assess(indeterminate_missing_prospectus_state,
        offer_exemption(indeterminate, [], n_a, n_a, [])).

test(zero_offerees_is_indeterminate) :-
    sfa_offer_exemptions_assess(indeterminate_zero_offerees,
        offer_exemption(indeterminate, [], n_a, n_a, [])).

% ---- status predicate (query type #2) -------------------------------

test(status_predicate_gives_exempt) :-
    sfa_offer_exemptions_profile_for(s274_institutional_positive, Profile),
    sfa_offer_exemptions_status(Profile, exempt).

test(status_predicate_gives_prospectus_required) :-
    sfa_offer_exemptions_profile_for(s275_1_relevant_near_miss, Profile),
    sfa_offer_exemptions_status(Profile, prospectus_required).

test(status_predicate_gives_indeterminate) :-
    sfa_offer_exemptions_profile_for(indeterminate_zero_offerees, Profile),
    sfa_offer_exemptions_status(Profile, indeterminate).

% ---- checklist (query type #2) --------------------------------------

test(checklist_is_nonempty_on_exempt) :-
    sfa_offer_exemptions_profile_for(s274_institutional_positive, Profile),
    sfa_offer_exemptions_checklist(Profile, [_FirstItem|_OtherItems]).

test(checklist_is_nonempty_on_prospectus_required) :-
    sfa_offer_exemptions_profile_for(s275_1_relevant_near_miss, Profile),
    sfa_offer_exemptions_checklist(Profile, [_FirstItem|_OtherItems]).

test(checklist_is_nonempty_on_indeterminate) :-
    sfa_offer_exemptions_profile_for(indeterminate_zero_offerees, Profile),
    sfa_offer_exemptions_checklist(Profile, [_FirstItem|_OtherItems]).

% ---- decision_resolvable --------------------------------------------

test(decision_resolvable_on_all_fixtures) :-
    sfa_offer_exemptions_subject(Subject),
    sfa_offer_exemptions_profile_for(Subject, Profile),
    sfa_offer_exemptions_decision_resolvable(Profile).

% ---- status_values --------------------------------------------------

test(status_values_are_the_three_verdicts) :-
    sfa_offer_exemptions_status_values(StatusValues),
    sort(StatusValues, [exempt, indeterminate, prospectus_required]).

% ---- what-if (query type #6) ----------------------------------------

test(what_if_overriding_prospectus_state_flips_to_prospectus_required) :-
    sfa_offer_exemptions_profile_for(s274_institutional_positive, Profile),
    sfa_offer_exemptions_what_if(advertisement, true, Profile,
        offer_exemption(exempt, [s274], 1000000, 0, [sg_sfa_2001_s274])).

test(what_if_overriding_advertisement_on_relevant_flips_verdict) :-
    sfa_offer_exemptions_profile_for(s275_1_relevant_positive, Profile),
    sfa_offer_exemptions_what_if(advertisement, true, Profile,
        offer_exemption(prospectus_required, [], 1000000, 2, [sg_sfa_2001_s240])).

% ---- profile_keys schema --------------------------------------------

test(profile_keys_contains_all_required) :-
    sfa_offer_exemptions_profile_keys(Keys),
    member(offer_date, Keys),
    member(institutional_offerees, Keys),
    member(relevant_person_offerees, Keys),
    member(other_offerees, Keys),
    member(amount_raised_cents, Keys),
    member(advertisement, Keys),
    member(non_permitted_selling_expenses, Keys),
    member(prospectus_state, Keys).

% ---- called contract (sfa_offer_exemption/2) -------------------------

test(called_contract_gives_exempt_on_s274) :-
    sfa_offer_exemptions_profile_for(s274_institutional_positive, Profile),
    sfa_offer_exemption(Profile,
        offer_exemption(exempt, [s274], 1000000, 0, [sg_sfa_2001_s274])).

test(called_contract_gives_prospectus_required_on_near_miss) :-
    sfa_offer_exemptions_profile_for(s272b_placement_over_person_limit, Profile),
    sfa_offer_exemption(Profile,
        offer_exemption(prospectus_required, [], 1000000, 51, [sg_sfa_2001_s240])).

:- end_module(test_public_interface).
