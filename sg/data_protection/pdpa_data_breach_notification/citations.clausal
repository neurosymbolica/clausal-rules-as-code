test(a_recorded_key_is_implemented) :-
    implements(sg_pdpa_2012_s26d_1).
test(the_schedule_item_six_a_key_is_implemented) :-
    implements(sg_pdpa_2012_s64_2021_sched_1_item_6a).
test(an_unrecorded_key_is_not_implemented, fail) :-
    implements(sg_pdpa_2012_s26d_3).
test(each_key_is_recorded_once) :-
    findall(Key, citation(Key, _), Keys),
    sort(Keys, DistinctKeys),
    length(Keys, Count),
    length(DistinctKeys, DistinctCount),
    Count =:= DistinctCount.

:- end_module(citations).
