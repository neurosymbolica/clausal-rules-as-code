% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for sg/data_protection/pdpa_data_breach_notification.
%
% Instruments (SSO pages read on
% 2026-11-12, each stating 'Current version as at 13 Nov 2026'):
%   - Personal Data Protection Act 2012 (Singapore), Part 6A, ss 26A to 26E
%     https://sso.agc.gov.sg/Act/PDPA2012?ProvIds=P16A-
%   - Personal Data Protection (Notification of Data Breaches) Regulations
%     2021, S 64/2021, regs 3 to 6
%     https://sso.agc.gov.sg/SL/S64-2021
%   - the same Regulations, Schedule Parts 1 and 2
%     https://sso.agc.gov.sg/SL/S64-2021?ProvIds=Sc-
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys label and ref only:
%   citation(Key, [label-'...', ref-'...']).
% Records carry a label and a link; quotations of the statute are omitted,
% see the linked Singapore Statutes Online (SSO) page for the text.
%
% The keys are the canonical lexicon keys of the order's citation
% vocabulary (_lexicon/citations.yaml); no other spelling is used.
% Provisions with no limb (s 26C(4), s 26D(3), (4), (8), (9), reg 1, reg 2,
% Schedule Part 2 paragraph 3, Interpretation Act 1965 s 50) are not
% applied by any rule and get no key (NOTES S3).
%
% PROVENANCE: every operative clause opens its body with implements(Key).
% implements/1 succeeds exactly for a recorded key.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

implements(Key) :-
    citation(Key, _).

% ---- PDPA 2012 s 26A ----------------------------------------------
citation(sg_pdpa_2012_s26a_def_databreach, [label-'Personal Data Protection Act 2012 s 26A definition of data breach', ref-'https://sso.agc.gov.sg/Act/PDPA2012?ProvIds=pr26A-']).

