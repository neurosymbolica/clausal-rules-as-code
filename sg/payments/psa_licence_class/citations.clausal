citation(sg_psa_2019_s5_1_a, [
    label-'Payment Services Act 2019 s 5(1)(a)',
    ref-'https://sso.agc.gov.sg/Act/PSA2019?ProvIds=pr5-'
]).

citation(sg_psa_2019_s6_2, [
