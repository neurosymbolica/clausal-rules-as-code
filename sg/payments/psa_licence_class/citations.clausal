    ref-'https://sso.agc.gov.sg/Act/PSA2019?ProvIds=pr6-'
]).

citation(sg_psa_2019_s6_5_a_ii_b, [
    label-'Payment Services Act 2019 s 6(5)(a)(ii)',
    ref-'https://sso.agc.gov.sg/Act/PSA2019?ProvIds=pr6-'
]).

citation(sg_psa_2019_s6_5_b, [
    label-'Payment Services Act 2019 s 6(5)(b)',
