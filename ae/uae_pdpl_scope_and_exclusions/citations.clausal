% SPDX-License-Identifier: EUPL-1.2
% =====================================================================
% citations.clausal -- statutory citation records for ae/uae_pdpl_scope_and_exclusions.
%
% Source of every record: Federal Decree by Law No. (45) of 2021 Concerning the
% Protection of Personal Data (UAE PDPL), English translation from the UAE
% legislation portal https://uaelegislation.gov.ae/en/legislations/1972/download,
% saved 2026-11-25, cut by _tools/provisions/uae_to_akn.py, not compared with the
% Official Gazette print. The portal says the Arabic text prevails; it is not read
% (a MISSING FACT, <<DNUM>>, Q11). Each verbatim is copied from the pinned unit text.
%
% citation/2 record form: a FACT, the key an atom, the second argument a
% pair list with keys label and ref only:
%   citation(Key, [label-'...', ref-'...']).
% Records carry a label and a link; quotations of the statute are omitted,
% see the linked UAE Legislation portal (uaelegislation.gov.ae) page for the text.
%
% LOAD-BEARING keys (the canonical lexicon keys; the ONLY keys a RESULT returns):
%   uae_pdpl_art_1_personal_data, uae_pdpl_art_1_processing,
%   uae_pdpl_art_2_1, uae_pdpl_art_2_1_a, uae_pdpl_art_2_1_b, uae_pdpl_art_2_1_c,
%   uae_pdpl_art_2_2, uae_pdpl_art_2_2_a ... uae_pdpl_art_2_2_g, uae_pdpl_art_31.
% RECORDED, NEVER RETURNED: the Art 1 glosses that readings (5), (6), (8) and
% (11) rely on (State, Data Subject, Controller, Processor, Establishment); the
% clauses that rely on them mark it with implements/1. The other deferred units
% (Art 1 lead-in and other definitions, Art 2 heading, and the NAMED GAPS of
% Arts 3, 28, 29, 30) are in the manifest's deferred set and no clause relies on
% them, so they carry no record here.
%
% PROVENANCE: operative clauses open their body with implements(Key).
% implements/1 succeeds for every recorded key and fails for any other, so a
% misspelt key makes its clause fail instead of lying.
% =====================================================================

:- module(citations, [
    citation/2,
    implements/1
]).

implements(Key) :-
    citation(Key, _).

% ---- load-bearing: Art 1 definitions read by pdpl_applies ----

citation(uae_pdpl_art_1_personal_data, [
    label-'UAE PDPL (Federal Decree by Law No. (45) of 2021) Art 1 definition of Personal Data',
    ref-'https://uaelegislation.gov.ae/en/legislations/1972/download'
]).

citation(uae_pdpl_art_1_processing, [
    label-'UAE PDPL (Federal Decree by Law No. (45) of 2021) Art 1 definition of Processing',
    ref-'https://uaelegislation.gov.ae/en/legislations/1972/download'
]).

