]).

citation(uae_pdpl_art_2_2_g, [
    label-'UAE PDPL (Federal Decree by Law No. (45) of 2021) Art 2(2)(g) exclusion of free-zone companies and establishments with special data protection legislation',
    ref-'https://uaelegislation.gov.ae/en/legislations/1972/download'
]).

% ---- load-bearing: Art 31, commencement ----

citation(uae_pdpl_art_31, [
    label-'UAE PDPL (Federal Decree by Law No. (45) of 2021) Art 31 publication and enforcement (in force as of 02 January 2022)',
    ref-'https://uaelegislation.gov.ae/en/legislations/1972/download'
]).

% ---- glosses relied on by readings, marked with implements/1, never returned ----

citation(uae_pdpl_art_1_state, [
    label-'UAE PDPL (Federal Decree by Law No. (45) of 2021) Art 1 definition of State (gloss of readings (5) and (6))',
    ref-'https://uaelegislation.gov.ae/en/legislations/1972/download'
]).

citation(uae_pdpl_art_1_data_subject, [
    label-'UAE PDPL (Federal Decree by Law No. (45) of 2021) Art 1 definition of Data Subject (gloss of readings (5) and (6))',
    ref-'https://uaelegislation.gov.ae/en/legislations/1972/download'
