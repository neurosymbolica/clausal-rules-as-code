citation(uae_pdpl_art_2_1, [
    label-'UAE PDPL (Federal Decree by Law No. (45) of 2021) Art 2(1) scope of application (lead-in)',
    ref-'https://uaelegislation.gov.ae/en/legislations/1972/download'
]).

citation(uae_pdpl_art_2_1_a, [
    label-'UAE PDPL (Federal Decree by Law No. (45) of 2021) Art 2(1)(a) data subject residing or having a place of business in the State (printed as item 2.)',
    ref-'https://uaelegislation.gov.ae/en/legislations/1972/download'
]).

citation(uae_pdpl_art_2_1_b, [
    label-'UAE PDPL (Federal Decree by Law No. (45) of 2021) Art 2(1)(b) controller or processor residing in the State',
    ref-'https://uaelegislation.gov.ae/en/legislations/1972/download'
]).

citation(uae_pdpl_art_2_1_c, [
    label-'UAE PDPL (Federal Decree by Law No. (45) of 2021) Art 2(1)(c) controller or processor residing outside the State',
    ref-'https://uaelegislation.gov.ae/en/legislations/1972/download'
]).

% ---- load-bearing: Art 2(2), the seven exclusions ----

citation(uae_pdpl_art_2_2, [
    label-'UAE PDPL (Federal Decree by Law No. (45) of 2021) Art 2(2) exclusions (lead-in)',
    ref-'https://uaelegislation.gov.ae/en/legislations/1972/download'
]).

citation(uae_pdpl_art_2_2_a, [
    label-'UAE PDPL (Federal Decree by Law No. (45) of 2021) Art 2(2)(a) exclusion of Government Data',
    ref-'https://uaelegislation.gov.ae/en/legislations/1972/download'
]).

citation(uae_pdpl_art_2_2_b, [
    label-'UAE PDPL (Federal Decree by Law No. (45) of 2021) Art 2(2)(b) exclusion of [quotation omitted]',
    ref-'https://uaelegislation.gov.ae/en/legislations/1972/download'
]).

citation(uae_pdpl_art_2_2_c, [
    label-'UAE PDPL (Federal Decree by Law No. (45) of 2021) Art 2(2)(c) exclusion of [quotation omitted]',
    ref-'https://uaelegislation.gov.ae/en/legislations/1972/download'
]).

citation(uae_pdpl_art_2_2_d, [
    label-'UAE PDPL (Federal Decree by Law No. (45) of 2021) Art 2(2)(d) exclusion of a Data Subject processing his or her data for personal purposes',
    ref-'https://uaelegislation.gov.ae/en/legislations/1972/download'
]).

citation(uae_pdpl_art_2_2_e, [
    label-'UAE PDPL (Federal Decree by Law No. (45) of 2021) Art 2(2)(e) exclusion of Personal Health Data that has its own protection legislation',
