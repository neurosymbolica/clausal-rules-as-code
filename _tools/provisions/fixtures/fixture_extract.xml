<?xml version="1.0" encoding="UTF-8"?>
<!-- ONE document-native subtree, which is what an EXTRACT is (spec 13.15):
     a single chapter lifted out of a larger act and re-parented under a
     fresh act/body wrapper. fixture_statute.xml beside it is deliberately
     NOT one (it holds four top-level articles), so the two fixtures between
     them cover both sides of units.extract_roots. -->
<akomaNtoso xmlns="http://docs.oasis-open.org/legaldocml/ns/akn/3.0">
  <act name="fixture-extract">
    <body>
      <chapter eId="chp_2">
        <heading><p>CHAPTER 2 Proportional deduction</p></heading>
        <article eId="chp_2__art_9">
          <paragraph eId="chp_2__art_9__para_1">
            <content><p>The deductible proportion shall be a percentage.</p></content>
          </paragraph>
        </article>
        <article eId="chp_2__art_10">
          <paragraph eId="chp_2__art_10__para_1">
            <content><p>Member States may round the percentage up.</p></content>
          </paragraph>
        </article>
      </chapter>
    </body>
  </act>
</akomaNtoso>
